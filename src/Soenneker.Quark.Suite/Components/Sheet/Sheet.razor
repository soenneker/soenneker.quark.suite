@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.DialogOverlayElement
@implements ISheet

<BradixDialog Open="@Visible"
              OpenChanged="(_cachedHandleOpenChangedDelegate ??= HandleOpenChanged)"
              Modal="@TrapFocus">
    <CascadingValue Name="ParentSheet" Value="@this">
        <CascadingValue Value="_context" IsFixed="true"
                        ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />
    </CascadingValue>
</BradixDialog>

@code {
    private Func<bool, Task>? _cachedHandleOpenChangedDelegate;

    public Sheet() : base("sheet") { }

}
