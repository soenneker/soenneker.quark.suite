@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ISheetClose

@if (AsChild)
{
    <Span @onclick="(_cachedHandleWrapperClickDelegate ??= HandleWrapperClick)" @attributes="BuildWrapperAttributes()">
        @ChildContent
    </Span>
}
else
{
    <button type="button" @onclick="(_cachedHandleDefaultClickDelegate ??= HandleDefaultClick)" @attributes="BuildAttributes()">
        @if (ChildContent is null)
        {
            <Svg Size="_renderCss0" NativeWidth="16" NativeHeight="16" ViewBox="0 0 24 24" Fill="_renderCss1" Stroke='_renderCss2' StrokeWidth="_renderCss3" StrokeLineCap="_renderCss4" StrokeLineJoin="_renderCss5" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></Svg>
            <Span ScreenReader="_renderCss6">Close</Span>
        }
        else
        {
            @ChildContent
        }
    </button>
}

@code {
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<FillBuilder> _renderCss1 = Quark.Fill.None;
    private static readonly CssValue<StrokeBuilder> _renderCss2 = Quark.Stroke.Current;
    private static readonly CssValue<StrokeWidthBuilder> _renderCss3 = Quark.StrokeWidth.Is2;
    private static readonly CssValue<StrokeLineCapBuilder> _renderCss4 = Quark.StrokeLineCap.Round;
    private static readonly CssValue<StrokeLineJoinBuilder> _renderCss5 = Quark.StrokeLineJoin.Round;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss6 = Quark.ScreenReader.Only;
    private string? _lastPrependedClass;

    private System.Func<MouseEventArgs, Task>? _cachedHandleWrapperClickDelegate;
    private System.Func<MouseEventArgs, Task>? _cachedHandleDefaultClickDelegate;

    private QuarkAttributeDictionary _wrapperAttributesBuffer;
    [CascadingParameter(Name = nameof(ParentSheet))]
    public Sheet? ParentSheet { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    [Parameter]
    public bool AutoClose { get; set; } = true;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sheet-close";
        Cursor ??= _defaultCursor;
    }

    private Dictionary<string, object> BuildWrapperAttributes()
    {
        var attributes = _wrapperAttributesBuffer.Create(2);
        attributes["data-slot"] = "sheet-close-wrapper";

        PrependClassAttribute(attributes, "contents", ref _lastPrependedClass);

        return attributes;
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeIfHasDelegate();

        if (AutoClose && ParentSheet is not null)
            await ParentSheet.Hide();
    }

    private Task HandleWrapperClick(MouseEventArgs _) => HandleClose();

    private async Task HandleDefaultClick(MouseEventArgs e)
    {
        await HandleClose();
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AsChild);
        hc.Add(AutoClose);
        hc.Add(OnClick.HasDelegate);
    }
}
