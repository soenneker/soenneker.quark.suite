@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.InteractiveElement
@implements ISheetContent

<BradixDialogPortal>
    @if (ParentSheet?.ShowBackdrop == true)
    {
        <BradixDialogOverlay AdditionalAttributes="@OverlayAttributes" />
    }

    <BradixDialogContent Id="@Context?.ContentId"
                         ForceMount="@ShouldKeepMounted"
                         PreventMountAutoFocus="@IsMountedClosed"
                         CloseOnEscapeKeyDown="@(!IsMountedClosed && (ParentSheet?.CloseOnEscape ?? true))"
                         CloseOnPointerDownOutside="@ShouldCloseOnOutsideInteraction"
                         CloseOnFocusOutside="@ShouldCloseOnOutsideInteraction"
                         OnPointerDownOutside="(_cachedHandleBackdropPointerDownOutsideDelegate ??= HandleBackdropPointerDownOutside)"
                         OnElementReferenceCaptured="(_cachedHandleElementReferenceCapturedDelegate ??= HandleElementReferenceCaptured)"
                         AdditionalAttributes="@ContentAttributes">
        @ChildContent
        @if (ShowCloseButton)
        {
            <BradixDialogClose AriaLabel="@null" AdditionalAttributes="@CloseButtonAttributes">
                <Svg Size="_renderCss0" NativeWidth="16" NativeHeight="16" ViewBox="0 0 24 24" Fill="_renderCss1" Stroke='_renderCss2' StrokeWidth="_renderCss3" StrokeLineCap="_renderCss4" StrokeLineJoin="_renderCss5" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></Svg>
                <Span ScreenReader="_renderCss6">Close</Span>
            </BradixDialogClose>
        }
    </BradixDialogContent>
</BradixDialogPortal>

@code {
    private string? _closedStyle;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Fixed;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is50;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is4;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Lg;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<FillBuilder> _renderCss1 = Fill.None;
    private static readonly CssValue<StrokeBuilder> _renderCss2 = Stroke.Current;
    private static readonly CssValue<StrokeWidthBuilder> _renderCss3 = StrokeWidth.Is2;
    private static readonly CssValue<StrokeLineCapBuilder> _renderCss4 = StrokeLineCap.Round;
    private static readonly CssValue<StrokeLineJoinBuilder> _renderCss5 = StrokeLineJoin.Round;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss6 = Quark.ScreenReader.Only;
    private Func<Task>? _cachedHandleBackdropPointerDownOutsideDelegate;
    private Func<ElementReference, Task>? _cachedHandleElementReferenceCapturedDelegate;

    private string? _lastPrependedClass;
    private string? _lastBuiltClass;

    private QuarkAttributeDictionary _overlayAttributesBuffer;
    private static readonly IReadOnlyDictionary<string, object> StaticCloseButtonAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "sheet-close",
        ["data-size"] = "icon-sm",
        ["data-variant"] = "ghost",
        ["class"] = "group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 rounded-[min(var(--radius-md),12px)] in-data-[slot=button-group]:rounded-lg absolute end-3 top-3"
    };

    [CascadingParameter(Name = nameof(ParentSheet))]
    public Sheet? ParentSheet { get; set; }

    [CascadingParameter]
    private OverlayLabelContext? Context { get; set; }

    /// <summary>
    /// Gets or sets which side the sheet slides from.
    /// </summary>
    [Parameter]
    public Side Side { get; set; } = Side.Right;

    /// <summary>
    /// Gets or sets whether a close button should be rendered in the sheet.
    /// </summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    [Parameter]
    public bool KeepMounted { get; set; }

    private bool ShouldKeepMounted => KeepMounted && ParentSheet?.TrapFocus == false;

    private bool IsMountedClosed => ShouldKeepMounted && ParentSheet?.Visible != true;

    [Parameter]
    public string? ContainerClass { get; set; }

    [Parameter]
    public string? ContainerStyle { get; set; }

    [Parameter]
    public string? OverlayClass { get; set; }

    [Parameter]
    public string? OverlayStyle { get; set; }

    private bool ShouldCloseOnOutsideInteraction =>
        ParentSheet is not null &&
        !IsMountedClosed &&
        !ParentSheet.Static &&
        ParentSheet.CloseOnBackdropClick;

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildAttributes();

    private IReadOnlyDictionary<string, object> OverlayAttributes => BuildOverlayAttributes();

    private IReadOnlyDictionary<string, object> CloseButtonAttributes => StaticCloseButtonAttributes;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        DataSlot ??= "sheet-content";
        Position ??= _defaultPosition;
        ZIndex ??= _defaultZIndex;
        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Gap ??= _defaultGap;
        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;
        TextSize ??= _defaultTextSize;
        Shadow ??= _defaultShadow;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "bg-clip-padding transition duration-200 ease-in-out data-[side=bottom]:inset-x-0 data-[side=bottom]:bottom-0 data-[side=bottom]:h-auto data-[side=bottom]:max-h-[50vh] data-[side=bottom]:border-t data-[side=left]:inset-y-0 data-[side=left]:left-0 data-[side=left]:h-full data-[side=left]:w-3/4 data-[side=left]:border-r data-[side=right]:inset-y-0 data-[side=right]:right-0 data-[side=right]:h-full data-[side=right]:w-3/4 data-[side=right]:border-l data-[side=top]:inset-x-0 data-[side=top]:top-0 data-[side=top]:h-auto data-[side=top]:max-h-[50vh] data-[side=top]:border-b data-[side=left]:sm:max-w-sm data-[side=right]:sm:max-w-sm data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[side=bottom]:data-[state=open]:slide-in-from-bottom-10 data-[side=left]:data-[state=open]:slide-in-from-left-10 data-[side=right]:data-[state=open]:slide-in-from-right-10 data-[side=top]:data-[state=open]:slide-in-from-top-10 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[side=bottom]:data-[state=closed]:slide-out-to-bottom-10 data-[side=left]:data-[state=closed]:slide-out-to-left-10 data-[side=right]:data-[state=closed]:slide-out-to-right-10 data-[side=top]:data-[state=closed]:slide-out-to-top-10", ref _lastPrependedClass);

        if (!attributes.ContainsKey("data-side"))
            attributes["data-side"] = GetSideValue(Side);

        if (IsMountedClosed)
        {
            attributes["hidden"] = QuarkAttributeValues.True;
            attributes["inert"] = QuarkAttributeValues.True;
            attributes.TryGetValue("style", out var style);
            attributes["style"] = QuarkStringCache.Concat(style?.ToString() ?? "", "; ", "display: none !important;", ref _closedStyle);
        }

    }

    private static string GetSideValue(Side side)
    {
        if (ReferenceEquals(side, Side.Top))
            return "top";

        if (ReferenceEquals(side, Side.Bottom))
            return "bottom";

        if (ReferenceEquals(side, Side.Left))
            return "left";

        return "right";
    }

    private Dictionary<string, object> BuildOverlayAttributes()
    {
        var attributes = _overlayAttributesBuffer.Create(3);

        const string baseClass = "fixed inset-0 z-50 bg-black/10 duration-100 supports-backdrop-filter:backdrop-blur-xs data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0";
        var prefix = ParentSheet?.BlurBackdrop == true ? baseClass + " backdrop-blur" : baseClass;
        attributes["class"] = string.IsNullOrWhiteSpace(OverlayClass)
            ? prefix
            : QuarkStringCache.Concat(prefix, " ", OverlayClass, ref _lastBuiltClass);
        if (!string.IsNullOrWhiteSpace(OverlayStyle)) attributes["style"] = OverlayStyle;

        attributes["data-state"] = ParentSheet?.Visible == true ? "open" : "closed";
        attributes["data-slot"] = "sheet-overlay";
        attributes["aria-hidden"] = "true";

        return attributes;
    }

    private Task HandleBackdropPointerDownOutside()
    {
        return ParentSheet?.OnBackdropClick.InvokeIfHasDelegate() ?? Task.CompletedTask;
    }

    private Task HandleElementReferenceCaptured(ElementReference element) =>
        ParentSheet?.SetOverlayContentElement(element) ?? Task.CompletedTask;

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Side);
        hc.Add(ShowCloseButton);
        hc.Add(KeepMounted);
        hc.Add(ContainerClass);
        hc.Add(ContainerStyle);
        hc.Add(OverlayClass);
        hc.Add(OverlayStyle);
        hc.Add(ParentSheet?.Visible ?? false);
        hc.Add(ParentSheet?.ShowBackdrop ?? true);
        hc.Add(ParentSheet?.BlurBackdrop ?? false);
        hc.Add(ParentSheet?.TrapFocus ?? true);
        hc.Add(ParentSheet?.CloseOnEscape ?? true);
        hc.Add(ParentSheet?.CloseOnBackdropClick ?? true);
        hc.Add(ParentSheet?.Static ?? false);
        hc.Add(Context?.ContentId);
    }
}
