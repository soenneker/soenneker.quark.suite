@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements INodeEditorBackground

<div @attributes="BuildAttributes()"></div>

@code {
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _defaultInset = Quark.Inset.Is0;
    private string? _lastPrependedClass;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "node-editor-background";
        PointerEvents ??= _defaultPointerEvents;
        Position ??= _defaultPosition;
        Inset ??= _defaultInset;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        {
            const string @class = "quark-node-editor-background bg-[radial-gradient(circle_at_center,hsl(var(--border))_1px,transparent_1px)] bg-[length:20px_20px] [mask-image:linear-gradient(to_bottom,black,rgba(0,0,0,0.72))]";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }
}
