@using System.Globalization

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements INodeEditorPort

<button type="button" @attributes="BuildAttributes()">
    @ChildContent
    <Span ScreenReader="_renderCss0">@AccessibleLabel</Span>
</button>

@code {
    private InvariantDoubleTextCache _offsetText;
    private InvariantDoubleTextCache _positionText;
    private int? _maxConnections;
    private string _maxConnectionsText = "";
    private string? _accessibleLabel;
    private string? _positionStyle;
    private string? _position;
    private bool _horizontal;

    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Grid;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is3;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Quark.Items.Center;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Is2;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Background;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Xs;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss0 = Quark.ScreenReader.Only;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;

    [CascadingParameter]
    public NodeEditorNodeContext? NodeContext { get; set; }

    [Parameter, EditorRequired]
    public string PortId { get; set; } = "";

    [Parameter]
    public NodeEditorPortType Type { get; set; } = NodeEditorPortType.Source;

    [Parameter]
    public NodeEditorPortPlacement? Placement { get; set; }

    [Parameter]
    public double Offset { get; set; } = 0.5;

    [Parameter]
    public int? MaxConnections { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private NodeEditorPortPlacement EffectivePlacement =>
        Placement ?? (Type == NodeEditorPortType.Target ? NodeEditorPortPlacement.Top : NodeEditorPortPlacement.Bottom);

    private string AccessibleLabel => Label ?? QuarkStringCache.Concat(Type.Value, " ", "connection", ref _accessibleLabel);

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(PortId))
            throw new InvalidOperationException($"{nameof(NodeEditorPort)} requires a non-empty {nameof(PortId)}.");

        if (Type is null)
            throw new InvalidOperationException($"{nameof(NodeEditorPort)} requires a non-null {nameof(Type)}.");

        if (!double.IsFinite(Offset) || Offset is < 0 or > 1)
            throw new InvalidOperationException($"{nameof(NodeEditorPort.Offset)} must be a finite value between zero and one.");

        if (MaxConnections <= 0)
            throw new InvalidOperationException($"{nameof(NodeEditorPort.MaxConnections)} must be greater than zero when specified.");

        base.OnParametersSet();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "node-editor-port";
        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        Size ??= _defaultSize;
        ItemsAlign ??= _defaultItemsAlign;
        Justify ??= _defaultJustify;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BackgroundColor ??= _defaultBackgroundColor;
        Shadow ??= _defaultShadow;
        OutlineStyle ??= _defaultOutlineStyle;
        Cursor ??= _defaultCursor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (NodeContext is null)
            throw new InvalidOperationException($"{nameof(NodeEditorPort)} must be used inside a node template.");

        attributes["data-node-id"] = NodeContext.NodeId;
        attributes["data-port-id"] = PortId;
        attributes["data-port-type"] = Type.Value;
        attributes["data-placement"] = EffectivePlacement.Value;
        attributes["data-position"] = _offsetText.Get(Offset, "0.###");
        if (_maxConnections != MaxConnections)
        {
            _maxConnections = MaxConnections;
            _maxConnectionsText = MaxConnections?.ToString(CultureInfo.InvariantCulture) ?? "";
        }
        attributes["data-max-connections"] = _maxConnectionsText;
        attributes["data-at-capacity"] = "false";
        attributes["data-disabled"] = Disabled ? "true" : "false";
        attributes["aria-label"] = AccessibleLabel;
        attributes["title"] = AccessibleLabel;
        attributes["disabled"] = Disabled ? QuarkAttributeValues.True : QuarkAttributeValues.False;
        attributes["aria-disabled"] = Disabled ? "true" : "false";

        const string prefix = "quark-node-editor-port z-20 touch-none border-muted-foreground/70 transition-[transform,background-color,border-color,box-shadow] duration-150 hover:scale-125 hover:border-primary hover:bg-primary focus-visible:scale-125 focus-visible:border-primary focus-visible:bg-primary focus-visible:ring-2 focus-visible:ring-ring aria-pressed:scale-125 aria-pressed:border-primary aria-pressed:bg-primary data-[connection-target=true]:scale-125 data-[connection-target=true]:border-primary data-[connection-target=true]:bg-primary/15 data-[connection-target=true]:ring-4 data-[connection-target=true]:ring-primary/10 data-[at-capacity=true]:border-muted-foreground/35 data-[at-capacity=true]:bg-muted data-[at-capacity=true]:opacity-60 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-40 ";
        PrependClassAttribute(attributes, EffectivePlacement.Value switch
        {
            "top" => prefix + "top-0 -translate-x-1/2 -translate-y-1/2",
            "right" => prefix + "right-0 translate-x-1/2 -translate-y-1/2",
            "bottom" => prefix + "bottom-0 -translate-x-1/2 translate-y-1/2",
            _ => prefix + "left-0 -translate-x-1/2 -translate-y-1/2",
        }, ref _lastBuiltClass);

        var position = _positionText.Get(Offset * 100, "0.###");
        var horizontal = EffectivePlacement.Value is "top" or "bottom";
        if (_positionStyle is null || _position != position || _horizontal != horizontal)
        {
            _position = position;
            _horizontal = horizontal;
            _positionStyle = horizontal ? $"left: {position}%" : $"top: {position}%";
        }
        PrependStyleAttribute(attributes, _positionStyle, ref _lastBuiltStyle);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hashCode)
    {
        base.ComputeRenderKeyCore(ref hashCode);
        hashCode.Add(NodeContext?.NodeId);
        hashCode.Add(PortId);
        hashCode.Add(Type.Value);
        hashCode.Add(Placement?.Value);
        hashCode.Add(Offset);
        hashCode.Add(MaxConnections);
        hashCode.Add(Label);
        hashCode.Add(Disabled);
    }
}
