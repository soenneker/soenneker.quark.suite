@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements INodeEditorControls

<div @attributes="BuildAttributes()">
    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Ghost" ButtonSize="_staticCss1" Disabled="@(!CanUndo)" AriaLabel="Undo" Title="Undo" OnClick="(_cachedUndoDelegate ??= Undo)">
        <Icon Name="LucideIcon.Undo2" Size="_renderCss0" />
    </Button>
    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Ghost" ButtonSize="_staticCss1" Disabled="@(!CanRedo)" AriaLabel="Redo" Title="Redo" OnClick="(_cachedRedoDelegate ??= Redo)">
        <Icon Name="LucideIcon.Redo2" Size="_renderCss0" />
    </Button>
    <Div Width="_renderCss1" Height="_renderCss2" BackgroundColor="_renderCss3" aria-hidden="true" />
    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Ghost" ButtonSize="_staticCss1" AriaLabel="Zoom out" Title="Zoom out" OnClick="(_cachedZoomOutDelegate ??= ZoomOut)">
        <Icon Name="LucideIcon.Minus" Size="_renderCss0" />
    </Button>
    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Ghost" ButtonSize="_staticCss1" AriaLabel="Reset view" Title="Reset view" OnClick="(_cachedResetViewDelegate ??= ResetView)">
        <Icon Name="LucideIcon.Scan" Size="_renderCss0" />
    </Button>
    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Ghost" ButtonSize="_staticCss1" AriaLabel="Fit to view" Title="Fit to view" OnClick="(_cachedFitViewDelegate ??= FitView)">
        <Icon Name="LucideIcon.Maximize" Size="_renderCss0" />
    </Button>
    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Ghost" ButtonSize="_staticCss1" AriaLabel="Zoom in" Title="Zoom in" OnClick="(_cachedZoomInDelegate ??= ZoomIn)">
        <Icon Name="LucideIcon.Plus" Size="_renderCss0" />
    </Button>
</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss1 = ButtonSize.IconSm;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<BottomBuilder> _defaultBottom = Quark.Bottom.Is4;
    private static readonly CssValue<LeftBuilder> _defaultLeft = Quark.Left.Is4;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is0_5;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Token("border/80");
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Token("background/90");
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is1;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Sm;
    private static readonly CssValue<BackdropBlurBuilder> _defaultBackdropBlur = Quark.BackdropBlur.Sm;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<WidthBuilder> _renderCss1 = Quark.Width.IsPx;
    private static readonly CssValue<HeightBuilder> _renderCss2 = Quark.Height.Is5;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss3 = Quark.BackgroundColor.Border;
    private Func<Task>? _cachedUndoDelegate;
    private Func<Task>? _cachedRedoDelegate;
    private Func<Task>? _cachedZoomOutDelegate;
    private Func<Task>? _cachedResetViewDelegate;
    private Func<Task>? _cachedFitViewDelegate;
    private Func<Task>? _cachedZoomInDelegate;

    private string? _lastBuiltClass;

    [CascadingParameter]
    public NodeEditorContext? EditorContext { get; set; }

    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public bool CanRedo { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "node-editor-controls";
        Position ??= _defaultPosition;
        Bottom ??= _defaultBottom;
        Left ??= _defaultLeft;
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BorderColor ??= _defaultBorderColor;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        Shadow ??= _defaultShadow;
        BackdropBlur ??= _defaultBackdropBlur;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["role"] = "toolbar";
        attributes["aria-label"] = "View controls";
        {
            const string @class = "z-30";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }

    }

    private Task ZoomIn() => EditorContext?.ZoomIn().AsTask() ?? Task.CompletedTask;

    private Task ZoomOut() => EditorContext?.ZoomOut().AsTask() ?? Task.CompletedTask;

    private Task FitView() => EditorContext?.FitView().AsTask() ?? Task.CompletedTask;

    private Task ResetView() => EditorContext?.ResetView().AsTask() ?? Task.CompletedTask;

    private Task Undo() => EditorContext?.Undo() ?? Task.CompletedTask;

    private Task Redo() => EditorContext?.Redo() ?? Task.CompletedTask;

    protected override void ComputeRenderKeyCore(ref HashCode hashCode)
    {
        base.ComputeRenderKeyCore(ref hashCode);
        hashCode.Add(CanUndo);
        hashCode.Add(CanRedo);
    }
}
