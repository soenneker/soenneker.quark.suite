@using System.Globalization

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements INodeEditorNode

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private InvariantDoubleTextCache _xText;
    private InvariantDoubleTextCache _yText;
    private string? _transform;
    private string? _transformX;
    private string? _transformY;

    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<LeftBuilder> _defaultLeft = Quark.Left.Is0;
    private static readonly CssValue<TopBuilder> _defaultTop = Quark.Top.Is0;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Xl;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Grab;
    private string? _lastPrependedClass;
    private string? _lastBuiltStyle;

    [Parameter, EditorRequired]
    public NodeEditorNodeModel Node { get; set; } = null!;

    [Parameter]
    public bool Selected { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "node-editor-node";
        Position ??= _defaultPosition;
        Left ??= _defaultLeft;
        Top ??= _defaultTop;
        UserSelect ??= _defaultUserSelect;
        Rounded ??= _defaultRounded;
        OutlineStyle ??= _defaultOutlineStyle;
        Cursor ??= _defaultCursor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-node-id"] = Node.Id;
        attributes["data-node-x"] = _xText.Get(Node.X, "0.###");
        attributes["data-node-y"] = _yText.Get(Node.Y, "0.###");
        attributes["data-disabled"] = Node.Disabled ? "true" : "false";
        attributes["data-selectable"] = Node.Selectable ? "true" : "false";
        attributes["data-selected"] = Selected ? "true" : "false";
        attributes["aria-selected"] = Selected ? "true" : "false";
        attributes["aria-keyshortcuts"] = "Enter Space ArrowUp ArrowRight ArrowDown ArrowLeft Delete Backspace";
        attributes["tabindex"] = Node.Selectable && !Node.Disabled ? "0" : "-1";

        PrependClassAttribute(attributes, "quark-node-editor-node touch-none transition-[box-shadow,border-color,opacity] duration-150 data-[dragging=true]:cursor-grabbing data-[selected=true]:ring-2 data-[selected=true]:ring-primary data-[selected=true]:ring-offset-2 data-[selected=true]:ring-offset-background focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background data-[selected=true]:z-10 data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50", ref _lastPrependedClass);

        var x = _xText.Get(Node.X, "0.###");
        var y = _yText.Get(Node.Y, "0.###");
        if (_transform is null || _transformX != x || _transformY != y)
        {
            _transformX = x;
            _transformY = y;
            _transform = $"transform: translate3d({x}px, {y}px, 0)";
        }
        PrependStyleAttribute(attributes, _transform, ref _lastBuiltStyle);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hashCode)
    {
        base.ComputeRenderKeyCore(ref hashCode);
        hashCode.Add(Node.Id);
        hashCode.Add(Node.X);
        hashCode.Add(Node.Y);
        hashCode.Add(Node.Disabled);
        hashCode.Add(Node.Selectable);
        hashCode.Add(Node.Tag);
        hashCode.Add(Node.RenderKey);
        hashCode.Add(Selected);
    }
}
