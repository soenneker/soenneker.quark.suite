@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@using Soenneker.Bradix

<PopoverContent Side="@Side"
                SideOffset="@SideOffset"
                Align="@Align"
                AlignOffset="@AlignOffset"
                AvoidCollisions="@AvoidCollisions"
                Slot="combobox-content"
                Id="@ResolvedContentId"
                Width='_renderCss0'
                MaxWidth='_staticCss1'
                Rounded="_renderCss1"
                Border="_renderCss2"
                Padding="_renderCss3"
                Display="_renderCss4"
                UseDefaultLayout="false"
                UseDefaultMotion="false"
                OnOpenAutoFocusDetailed="HandleOpenAutoFocus"
                @attributes="ContentAttributes">
    @ChildContent
</PopoverContent>

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Token("[calc(var(--anchor-width)+--spacing(7))]");
    private static readonly CssValue<MaxWidthBuilder> _staticCss1 = Quark.MaxWidth.Token("(--available-width)");
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Md;
    private static readonly CssValue<RingBuilder> _defaultRing = Quark.Ring.Is1;
    private static readonly CssValue<WidthBuilder> _renderCss0 = Quark.Width.Token("(--anchor-width)");
    private static readonly CssValue<RoundedBuilder> _renderCss1 = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _renderCss2 = Quark.Border.Is0;
    private static readonly CssValue<PaddingBuilder> _renderCss3 = Quark.Padding.Is0;
    private static readonly CssValue<DisplayBuilder> _renderCss4 = Quark.Display.Block;
    private string? _lastPrependedClass;

    private (bool Multiple, bool Reserve, int Offset, System.Globalization.CultureInfo Culture)? _styleInputs;
    private string? _contentStyle;
    private QuarkAttributeDictionary _contentAttributes;
    [CascadingParameter(Name = "ParentCombobox")]
    private Combobox? ParentCombobox { get; set; }

    [Parameter]
    public Side Side { get; set; } = Side.Bottom;

    [Parameter]
    public int SideOffset { get; set; } = 6;

    [Parameter]
    public Alignment Align { get; set; } = Alignment.Start;

    [Parameter]
    public int AlignOffset { get; set; }

    [Parameter]
    public bool AvoidCollisions { get; set; } = true;

    private string? ResolvedContentId => ParentCombobox?.ContentId;

    private static Task HandleOpenAutoFocus(BradixAutoFocusEventArgs args)
    {
        args.PreventDefault();
        return Task.CompletedTask;
    }

    private IReadOnlyDictionary<string, object> ContentAttributes
    {
        get
        {
            var attributes = _contentAttributes.Create(BuildAttributes(), 7);
            attributes["data-slot"] = "combobox-content";
            attributes["data-chips"] = ParentCombobox?.Multiple == true ? "true" : "false";
            attributes["role"] = "presentation";
            attributes["tabindex"] = QuarkAttributeValues.MinusOne;

            if (ParentCombobox?.HasVisibleItems != true)
                attributes["data-empty"] = string.Empty;

            var styleInputs = (ParentCombobox?.Multiple == true, ParentCombobox?.TriggerReservesInlineEndAction == true,
                AlignOffset, System.Globalization.CultureInfo.CurrentCulture);
            if (_contentStyle is null || _styleInputs != styleInputs || !styleInputs.Item4.IsReadOnly ||
                !ReferenceEquals(_styleInputs?.Culture, styleInputs.Item4))
            {
                _styleInputs = styleInputs;
            var anchorWidth = ParentCombobox?.Multiple == true
                ? "var(--radix-popper-anchor-width)"
                : ParentCombobox?.TriggerReservesInlineEndAction == true
                    ? "calc(var(--radix-popper-anchor-width) - 1.75rem)"
                    : "var(--radix-popper-anchor-width)";
            var minWidth = ParentCombobox?.Multiple == true
                ? "var(--anchor-width)"
                : "calc(var(--anchor-width) + 1.75rem)";

            _contentStyle =
                $"--anchor-width: {anchorWidth}; --available-width: var(--radix-popper-available-width); --available-height: var(--radix-popper-available-height); --transform-origin: var(--radix-popover-content-transform-origin); width: var(--anchor-width); min-width: {minWidth}; max-width: var(--available-width); max-height: var(--available-height);" +
                (AlignOffset == 0 ? string.Empty : $" margin-left: {AlignOffset}px;");

            }
            attributes["style"] = _contentStyle;

            if (ParentCombobox?.Multiple == true)
                attributes["aria-multiselectable"] = "true";

            return attributes;
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        Position ??= _defaultPosition;
        MinWidth ??= _staticCss0;
        Overflow ??= _defaultOverflow;
        Rounded ??= _renderCss1;
        Border ??= _renderCss2;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _renderCss3;
        TextColor ??= _defaultTextColor;
        Shadow ??= _defaultShadow;
        Ring ??= _defaultRing;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        {
            const string @class = "cn-menu-target cn-menu-translucent group/combobox-content origin-(--transform-origin) ring-foreground/10 duration-100 data-[chips=true]:min-w-(--anchor-width) data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 *:data-[slot=input-group]:m-1 *:data-[slot=input-group]:mb-0 *:data-[slot=input-group]:h-8 *:data-[slot=input-group]:border-input/30 *:data-[slot=input-group]:bg-input/30 *:data-[slot=input-group]:shadow-none data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 [&:has([data-slot=combobox-item]:not([hidden]))>[data-slot=combobox-empty]]:hidden";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Side);
        hc.Add(SideOffset);
        hc.Add(Align);
        hc.Add(AlignOffset);
        hc.Add(AvoidCollisions);
        hc.Add(ParentCombobox?.Open ?? false);
        hc.Add(ParentCombobox?.TriggerReservesInlineEndAction ?? false);
        hc.Add(ParentCombobox?.HasVisibleItems ?? false);
    }

}
