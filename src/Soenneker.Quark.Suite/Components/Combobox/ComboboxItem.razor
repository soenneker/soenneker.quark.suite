@namespace Soenneker.Quark
@using Soenneker.Blazor.Utils.Ids
@inherits Soenneker.Quark.FormControlElement

<Div @onclick="(_cachedHandleItemClickDelegate ??= HandleItemClick)" @onmouseenter="(_cachedHandleMouseEnterDelegate ??= HandleMouseEnter)" @attributes="BuildAttributes()" role="option">
    @ChildContent
    @if (IsSelected)
    {
        <Span DataSlot="combobox-item-indicator" PointerEvents="_renderCss0" Position="_renderCss1" Right="_renderCss2" Display="_renderCss3" Size="_renderCss4" ItemsAlign="_renderCss5" Justify="_renderCss6">
            <Icon Name="LucideIcon.Check" PointerEvents="_renderCss0" />
        </Span>
    }
</Div>

@implements IHandleEvent

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Default;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.FromRight.Is8.FromLeft.Token("1.5").OnY.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<PointerEventsBuilder> _renderCss0 = Quark.PointerEvents.None;
    private static readonly CssValue<PositionBuilder> _renderCss1 = Quark.Position.Absolute;
    private static readonly CssValue<RightBuilder> _renderCss2 = Quark.Right.Is2;
    private static readonly CssValue<DisplayBuilder> _renderCss3 = Quark.Display.Flex;
    private static readonly CssValue<SizeBuilder> _renderCss4 = Quark.Size.Is4;
    private static readonly CssValue<ItemsBuilder> _renderCss5 = Quark.Items.Center;
    private static readonly CssValue<JustifyBuilder> _renderCss6 = Quark.Justify.Center;
    private string? _lastPrependedClass;

    private System.Func<MouseEventArgs, Task>? _cachedHandleItemClickDelegate;
    private System.Func<MouseEventArgs, Task>? _cachedHandleMouseEnterDelegate;

    // Selection renders through the parent; active-state changes explicitly refresh this item.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);
    private string? _itemId;
    private string? _itemIdSource;

    [CascadingParameter(Name = "ParentCombobox")]
    private Combobox? ParentCombobox { get; set; }

    private bool IsSelected => ParentCombobox?.IsSelected(Value) == true;
    internal bool IsActiveItem { get; private set; }
    internal string ItemId
    {
        get
        {
            if (_itemId is null || !string.Equals(_itemIdSource, Id, StringComparison.Ordinal))
            {
                _itemIdSource = Id;
                _itemId = BlazorIdGenerator.Child(Id!, "option");
            }
            return _itemId;
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "combobox-item";
        Position ??= _defaultPosition;
        Display ??= _renderCss3;
        Width ??= _defaultWidth;
        Cursor ??= _defaultCursor;
        UserSelect ??= _defaultUserSelect;
        ItemsAlign ??= _renderCss5;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        OutlineStyle ??= _defaultOutlineStyle;

    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (Id.IsNullOrEmpty())
            Id = BlazorIdGenerator.New("quark-combobox-item");
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
            ParentCombobox?.RegisterItem(this);
    }

    private async Task HandleItemClick(MouseEventArgs _)
    {
        if (!Disabled && ParentCombobox != null)
            await ParentCombobox.Select(Value);
    }

    private Task HandleMouseEnter(MouseEventArgs _)
    {
        ParentCombobox?.SetActiveItem(this);
        return Task.CompletedTask;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-value"] = Value ?? "";
        attributes["aria-selected"] = IsSelected ? "true" : "false";
        attributes["id"] = ItemId;
        attributes["tabindex"] = QuarkAttributeValues.MinusOne;

        if (IsSelected)
            attributes["data-selected"] = string.Empty;

        if (IsActiveItem)
            attributes["data-highlighted"] = string.Empty;

        if (Disabled)
        {
            attributes["aria-disabled"] = "true";
            attributes["data-disabled"] = "true";
        }

        PrependClassAttribute(attributes, "data-highlighted:bg-accent data-highlighted:text-accent-foreground not-data-[variant=destructive]:data-highlighted:**:text-accent-foreground data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(Disabled);
        hc.Add(IsSelected);
        hc.Add(IsActiveItem);
    }

    internal void SetActive(bool active)
    {
        if (IsActiveItem != active)
        {
            IsActiveItem = active;
            Refresh();
        }
    }

    public override async ValueTask DisposeAsync()
    {
        ParentCombobox?.UnregisterItem(this);
        await base.DisposeAsync();
    }
}
