@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IComboboxList
@implements IDisposable

<div @attributes="BuildAttributes()">
    @if (Virtualize && Options is not null)
    {
        <VirtualItems @ref="_virtualItems" ParentScroll="true" ItemKeys="@_keys">
            <ItemTemplate Context="index">
                @{ var option = _filtered[index]; }
                <ComboboxItem @key="option.Value" Value="@option.Value" Disabled="@option.Disabled" aria-posinset="@(index + 1)" aria-setsize="@_filtered.Count">
                    @if (OptionTemplate is not null) { @OptionTemplate(option) } else { @option.Label }
                </ComboboxItem>
            </ItemTemplate>
        </VirtualItems>
    }
    else if (Options is not null)
    {
        @foreach (var option in _filtered)
        {
            <ComboboxItem @key="option.Value" Value="@option.Value" Disabled="@option.Disabled">
                @if (OptionTemplate is not null) { @OptionTemplate(option) } else { @option.Label }
            </ComboboxItem>
        }
    }
    else { @ChildContent }
</div>

@code {
    [Parameter] public bool FilterOptions { get; set; } = true;
    [Parameter] public bool Virtualize { get; set; }
    [Parameter] public IReadOnlyList<SelectOption>? Options { get; set; }
    [Parameter] public RenderFragment<SelectOption>? OptionTemplate { get; set; }
    private List<SelectOption> _filtered = [];
    private string[] _keys = [];
    private VirtualItems? _virtualItems;
    private string? _lastSearch;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _filtered = Options?.Where(option => !FilterOptions || string.IsNullOrWhiteSpace(ParentCombobox?.Search) ||
            OptionNavigation.Matches(option.Label, option.Value, ParentCombobox.Search)).ToList() ?? [];
        _keys = _filtered.Select(option => option.Value).ToArray();
        if (Virtualize && Options is not null) ParentCombobox?.SetVirtualOptions(this, _filtered);
        else ParentCombobox?.ClearVirtualOptions(this);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_lastSearch != ParentCombobox?.Search)
        {
            _lastSearch = ParentCombobox?.Search;
            if (_virtualItems is not null && _filtered.Count > 0) await _virtualItems.ScrollToIndex(0);
        }
    }
    internal ValueTask Reveal(int index) => _virtualItems?.ScrollToIndex(index) ?? ValueTask.CompletedTask;
    public void Dispose() => ParentCombobox?.ClearVirtualOptions(this);
    public override async ValueTask DisposeAsync() { Dispose(); await base.DisposeAsync(); }

    private static readonly CssValue<OverflowBuilder> _defaultOverflowY = Quark.Overflow.Y.Auto;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is1;
    private static readonly CssValue<ScrollPaddingBuilder> _defaultScrollPadding = Quark.ScrollPadding.OnY.Is1;
    private string? _lastPrependedClass;
    private string? _previousStyle;
    private string? _paddedStyle;

    [CascadingParameter(Name = "ParentCombobox")]
    private Combobox? ParentCombobox { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "combobox-list";

        MaxHeight ??= "max-h-[min(calc(--spacing(72)---spacing(9)),calc(var(--available-height)---spacing(9)))]";
        OverflowY ??= _defaultOverflowY;
        Padding ??= _defaultPadding;
        ScrollPadding ??= _defaultScrollPadding;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var empty = ParentCombobox?.HasVisibleItems != true;

        if (empty)
            attributes["data-empty"] = string.Empty;

        if (!empty)
        {
            string? style = attributes.TryGetValue("style", out var value) ? value?.ToString() : null;
            if (_paddedStyle is null || _previousStyle != style)
            {
                _previousStyle = style;
                _paddedStyle = style is not null ? $"{style}; padding: 0.25rem;" : "padding: 0.25rem;";
            }
            attributes["style"] = _paddedStyle;
        }

        PrependClassAttribute(attributes, "no-scrollbar overscroll-contain data-empty:p-0", ref _lastPrependedClass);
    }
    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentCombobox?.HasVisibleItems); hc.Add(Options); hc.Add(Virtualize); hc.Add(ParentCombobox?.Search);
    }

}
