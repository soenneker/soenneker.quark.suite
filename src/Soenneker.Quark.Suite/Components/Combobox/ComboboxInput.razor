                <Svg DataSlot="combobox-trigger-icon" PointerEvents="_renderCss0" Size="_renderCss1" TextColor="_renderCss5" NativeWidth="16" NativeHeight="16" ViewBox="0 0 24 24" Fill="_renderCss2" Stroke='_renderCss3' StrokeWidth="_renderCss4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></Svg>
