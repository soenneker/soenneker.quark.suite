    {
        base.BuildAttributesCore(attributes);
        attributes["type"] = "text";
        attributes["data-combobox-slot"] = "combobox-input";
        attributes["role"] = "combobox";
        attributes["autocomplete"] = "off";
        attributes["aria-autocomplete"] = "list";
        attributes["aria-expanded"] = ParentCombobox?.Open == true ? "true" : "false";
        attributes["aria-activedescendant"] = ParentCombobox?.ActiveItemId ?? string.Empty;

        if (ParentCombobox is not null)
        {
            attributes["id"] = Id ?? ParentCombobox.InputId;
            attributes["aria-controls"] = ParentCombobox.ContentId;
        }

        if (ParentCombobox?.Disabled == true)
            attributes["disabled"] = QuarkAttributeValues.True;

        PrependClassAttribute(attributes, "file:h-6 file:border-0 file:bg-transparent file:text-sm file:text-foreground aria-invalid:border-destructive aria-invalid:ring-destructive/20 md:text-sm dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 aria-invalid:ring-0", ref _lastPrependedClass);
    }

