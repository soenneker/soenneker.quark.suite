               @onclick="(_cachedHandleClickOpenDelegate ??= HandleClickOpen)"
               @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
               @onkeydown:preventDefault="_preventDefaultKeys"
               @attributes="BuildAttributes()" />
        @if (ParentCombobox?.ShowClear == true && ParentCombobox.HasClearValue)
        {
            <button type="button" @onclick="(_cachedClearDelegate ??= Clear)" @onmousedown:preventDefault="true" @attributes="BuildClearButtonAttributes()">
                <Svg DataSlot="combobox-clear-icon" PointerEvents="_renderCss0" Size="_renderCss1" NativeWidth="16" NativeHeight="16" ViewBox="0 0 24 24" Fill="_renderCss2" Stroke='_renderCss3' StrokeWidth="_renderCss4" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></Svg>
