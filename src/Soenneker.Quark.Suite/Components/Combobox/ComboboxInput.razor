    private Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private Func<MouseEventArgs, Task>? _cachedHandleClickOpenDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;
    private Func<MouseEventArgs, Task>? _cachedClearDelegate;
