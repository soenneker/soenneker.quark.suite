@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@inject IInputInterop InputInterop

<input @ref="_inputElement" value="@GetDisplayValue()"
       @oninput="(_cachedHandleInputDelegate ??= HandleInput)"
       @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
       @onclick="(_cachedHandleClickOpenDelegate ??= HandleClickOpen)"
       @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
       @attributes="BuildAttributes()" />

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is16;
    private static readonly CssValue<FlexBuilder> _defaultFlex = Quark.Flex.Is1;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private Func<MouseEventArgs, Task>? _cachedHandleClickOpenDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private ElementReference _inputElement;
    private ElementReference _registeredInputElement;
    private ValueAtomicBool _keysRegistered;
    private ValueAtomicBool _disposed;

    private async Task RegisterInputKeys()
    {
        if (_disposed.Value || (_keysRegistered.Value && _registeredInputElement.Equals(_inputElement)))
            return;
        if (_keysRegistered.Value)
            await InputInterop.UnregisterComboboxKeys(_registeredInputElement);

        var element = _inputElement;
        await InputInterop.RegisterComboboxKeys(element);
        if (_disposed.Value)
        {
            await InputInterop.UnregisterComboboxKeys(element);
            return;
        }
        _registeredInputElement = element;
        _keysRegistered.Value = true;
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_keysRegistered.Value)
                await InputInterop.UnregisterComboboxKeys(_registeredInputElement);
        }
        finally
        {
            await base.DisposeAsync();
        }
    }

    [CascadingParameter(Name = "ParentCombobox")]
    private Combobox? ParentCombobox { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await RegisterInputKeys();
    }

    private string GetDisplayValue()
    {
        return ParentCombobox?.Search ?? string.Empty;
    }

    private async Task HandleInput(ChangeEventArgs args)
    {
        if (ParentCombobox is null)
            return;

        var value = args.Value?.ToString();
        await ParentCombobox.SetSearch(value ?? string.Empty);
        await ParentCombobox.SetOpen(true);
    }

    protected override async Task HandleFocus(FocusEventArgs e)
    {
        if (ParentCombobox != null && !ParentCombobox.Disabled)
            await ParentCombobox.SetOpen(true);

        await base.HandleFocus(e);
    }

    private async Task HandleClickOpen(MouseEventArgs _)
    {
        if (ParentCombobox != null && !ParentCombobox.Disabled && !ParentCombobox.Open)
            await ParentCombobox.SetOpen(true);
    }

    protected override async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var preventBackspace = e.Key == "Backspace" && (ParentCombobox?.Search.IsNullOrEmpty() ?? false);
        var navigationKey = e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End" or "Enter" or "Escape" || preventBackspace;

        if (!Disabled && !ReadOnly && !e.AltKey && !e.CtrlKey && !e.MetaKey && ParentCombobox != null && navigationKey)
            await ParentCombobox.HandleInputKeyDown(e.Key);

        await base.HandleKeyDown(e);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "combobox-chip-input";

        MinWidth ??= _staticCss0;
        Flex ??= _defaultFlex;
        OutlineStyle ??= _defaultOutlineStyle;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["type"] = "text";
        attributes["data-combobox-slot"] = "combobox-chip-input";
        attributes["role"] = "combobox";
        attributes["autocomplete"] = "off";
        attributes["aria-autocomplete"] = "list";
        attributes["data-combobox-multiple"] = ParentCombobox?.Multiple == true ? "true" : "false";
        attributes["aria-expanded"] = ParentCombobox?.Open == true ? "true" : "false";
        attributes["aria-activedescendant"] = ParentCombobox?.ActiveItemId ?? string.Empty;

        if (ParentCombobox is not null)
        {
            attributes["id"] = Id ?? ParentCombobox.InputId;
            attributes["aria-controls"] = ParentCombobox.ContentId;
        }

        if (ParentCombobox?.Disabled == true)
            attributes["disabled"] = QuarkAttributeValues.True;

    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentCombobox?.Open);
        hc.Add(ParentCombobox?.ActiveItemId);
        hc.Add(ParentCombobox?.Search);
        hc.Add(ParentCombobox?.Disabled);
        hc.Add(ParentCombobox?.Multiple);
    }
}
