@namespace Soenneker.Quark
@implements ISearchableSelect
@implements IValidationInput
        <Combobox Value="@ItemValue"
                  ValueChanged="(_cachedHandleValueChangedDelegate ??= HandleValueChanged)"
                  Search="@_search"
                  SearchChanged="(_searchChanged ??= SetSearch)"
                  Open="@_open"
                  OpenChanged="(_openChanged ??= SetOpen)"
                  Disabled="@Disabled"
                  AutoHighlight="true"
                  Width="_staticCss1"
                  MinWidth="_staticCss0">
            <ComboboxInput DisplayValue="@DisplayValue" Placeholder="@Placeholder" @attributes="InputAttributes" />
            <ComboboxContent>
                <ComboboxEmpty>@EmptyText</ComboboxEmpty>
                <ComboboxList>
                    @for (int index = 0; index < Choices.Count; index++)
                    {
                        SelectOption choice = Choices[index];
                        if (MatchesSearch(choice))
                        {
                            <ComboboxItem @key="choice.Value" Value="@EncodeChoice(index, choice.Value)" Disabled="@choice.Disabled">@choice.Label</ComboboxItem>
                        }
                    }
                </ComboboxList>
            </ComboboxContent>
        </Combobox>

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = MinWidth.Is0;
    private static readonly CssValue<WidthBuilder> _staticCss1 = Width.IsFull;
    private Func<string?, Task>? _cachedHandleValueChangedDelegate;

    private Action<string?>? _searchChanged;
    private Action<bool>? _openChanged;
    private string? _encodedValueSource;
    private string? _encodedValue;
    private string?[] _encodedChoices = [];
    private void SetSearch(string? value) => _search = value;
    private void SetOpen(bool value) => _open = value;
    private string? _search;
    private bool _open;
    [Parameter]
    public IReadOnlyList<SelectOption> Choices { get; set; } = [];
    [Parameter]
    public string? Value { get; set; }
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }
    [Parameter]
    public string Placeholder { get; set; } = "Select an option";
    [Parameter]
    public string EmptyText { get; set; } = "No options found.";
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }
    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }
    public object? ValidationValue => Value;
    private string? ItemValue
    {
        get
        {
            if (_encodedValueSource != Value)
            {
                _encodedValueSource = Value;
                _encodedValue = Value is null ? null : EncodeValue(Value);
            }
            return _encodedValue;
        }
    }

    private string EncodeChoice(int index, string value)
    {
        if (_encodedChoices.Length != Choices.Count)
            Array.Resize(ref _encodedChoices, Choices.Count);

        string? encoded = _encodedChoices[index];
        if (encoded is null || !encoded.AsSpan("option:".Length).SequenceEqual(value))
            _encodedChoices[index] = encoded = EncodeValue(value);
        return encoded;
    }
    private string DisplayValue
    {
        get
        {
            for (int index = 0; index < Choices.Count; index++)
            {
                SelectOption choice = Choices[index];
                if (string.Equals(choice.Value, Value, StringComparison.Ordinal))
                    return choice.Label;
            }
            return string.Empty;
        }
    }
    private bool MatchesSearch(SelectOption choice) => string.IsNullOrWhiteSpace(_search)
        || choice.Label.Contains(_search, StringComparison.OrdinalIgnoreCase) || choice.Value.Contains(_search, StringComparison.OrdinalIgnoreCase);
    private static string EncodeValue(string value) => "option:" + value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ParentValidation is not null)
            await ParentValidation.InitializeInput(this);
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task HandleValueChanged(string? itemValue)
    {
        if (Disabled)
            return;
        if (itemValue is null || !itemValue.StartsWith("option:", StringComparison.Ordinal))
            return;

        SelectOption? choice = null;
        for (int index = 0; index < Choices.Count; index++)
        {
            SelectOption candidate = Choices[index];
            if (candidate.Value.AsSpan().SequenceEqual(itemValue.AsSpan("option:".Length)))
            {
                choice = candidate;
                break;
            }
        }
        if (choice is null || choice.Disabled)
            return;
        Value = choice.Value;
        await ValueChanged.InvokeAsync(Value);
        if (ParentValidation is not null)
            await ParentValidation.NotifyInputChanged(Value);
    }
}
