@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<Span @attributes="BuildAttributes()">
    @ChildContent
    @if (ShowRemove)
    {
        <Button Type="@ButtonType.Button" DataSlot="combobox-chip-remove" Variant="ButtonVariant.Ghost" ButtonSize="_staticCss2" Margin='_renderCss0' Opacity="_staticCss1" tabindex="-1" aria-label="Remove selection" Disabled="@(ParentCombobox?.Disabled == true)" @onclick="(_cachedHandleRemoveClickDelegate ??= HandleRemoveClick)" @onmousedown:preventDefault="true">
            <Icon Name="LucideIcon.X" PointerEvents="_renderCss1" />
        </Button>
    }
</Span>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<OpacityBuilder> _staticCss1 = CssValue<OpacityBuilder>.For(Quark.Opacity.Is50, Quark.Opacity.Is100.OnHover);
    private static readonly CssValue<ButtonSizeBuilder> _staticCss2 = ButtonSize.IconXs;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Token("[calc(--spacing(5.25))]");
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFit;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Sm;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Muted;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is1_5;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Foreground;
    private static readonly CssValue<MarginBuilder> _renderCss0 = Quark.Margin.FromLeft.Negative1;
    private static readonly CssValue<PointerEventsBuilder> _renderCss1 = Quark.PointerEvents.None;
    private string? _lastBuiltClass;

    private Func<MouseEventArgs, Task>? _cachedHandleRemoveClickDelegate;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public bool ShowRemove { get; set; } = true;

    [CascadingParameter(Name = "ParentCombobox")]
    private Combobox? ParentCombobox { get; set; }

    private async Task HandleRemoveClick(MouseEventArgs _)
    {
        if (ParentCombobox is null || ParentCombobox.Disabled)
            return;

        await ParentCombobox.RemoveValue(Value);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "combobox-chip";
        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Whitespace ??= _defaultWhitespace;
        TextColor ??= _defaultTextColor;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-value"] = Value;

        {
            const string @class = "has-data-[slot=combobox-chip-remove]:pr-0";
            const string variant = @class + " " + "has-disabled:pointer-events-none has-disabled:cursor-not-allowed has-disabled:opacity-50";
            PrependClassAttribute(attributes, ParentCombobox?.Disabled == true ? variant : @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(ShowRemove);
        hc.Add(ParentCombobox?.Disabled);
    }
}
