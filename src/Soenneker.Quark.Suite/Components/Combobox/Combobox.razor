@using System.Threading
@implements IMultipleAutoSaveInput<string?, string[]>
@namespace Soenneker.Quark
@using Soenneker.Blazor.Utils.Ids
@inherits Soenneker.Quark.FormControlElement
@implements IAsyncDisposable

@if (AutoSave && ShowAutoSaveStatus)
{
    <Div Display="Soenneker.Quark.Display.Flex" ItemsAlign="Items.Center" Gap="Soenneker.Quark.Gap.Is2" MinWidth="Soenneker.Quark.MinWidth.Is0">
        @RenderAutoSaveControl()
        <AutoSaveStatus State="@(Multiple ? _autoSaveMultiple.State : _autoSave.State)" HasSaved="@(Multiple ? _autoSaveMultiple.HasSaved : _autoSave.HasSaved)" Visible="@(AutoSave && ShowAutoSaveStatus && (Multiple ? OnAutoSaveMultiple is not null : OnAutoSave is not null))"
                Class="@AutoSaveStatusClass" SavingClass="@AutoSaveSavingClass"
                SavedClass="@AutoSaveSavedClass" FailedClass="@AutoSaveFailedClass" />
    </Div>
}
else
{
    @RenderAutoSaveControl()
}


@code {
    private RenderFragment RenderAutoSaveControl() => @<text>
<CascadingValue Name="ParentCombobox" Value="@this">
    <Popover Open="@Open"
             OpenChanged="(_cachedHandlePopoverOpenChangedDelegate ??= HandlePopoverOpenChanged)">
        <div @attributes="BuildAttributes()">
            @ChildContent
        </div>
    </Popover>
</CascadingValue>
    </text>;

    [Parameter] public bool AutoSave { get; set; } = false;
    [Parameter] public int AutoSaveDelay { get; set; } = 750;
    [Parameter] public bool ShowAutoSaveStatus { get; set; } = true;
    [Parameter] public Func<string?, CancellationToken, ValueTask>? OnAutoSave { get; set; }
    [Parameter] public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }
    [Parameter] public string? AutoSaveStatusClass { get; set; }
    [Parameter] public string? AutoSaveSavingClass { get; set; }
    [Parameter] public string? AutoSaveSavedClass { get; set; }
    [Parameter] public string? AutoSaveFailedClass { get; set; }
    private AutoSaveController<string?> _autoSave;
    private Func<Task>? _autoSaveRefresh;
    private Task RefreshAutoSave() => InvokeAsync(StateHasChanged);
    private Task NotifyAutoSave(string? value) => _autoSave.NotifyValueChanged(value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, _autoSaveRefresh ??= RefreshAutoSave);
    [Parameter] public Func<string[], CancellationToken, ValueTask>? OnAutoSaveMultiple { get; set; }
    private AutoSaveController<string[]> _autoSaveMultiple;
    private Task NotifyAutoSaveMultiple(string[] value) => _autoSaveMultiple.NotifyValueChanged(value.ToArray(), AutoSave, AutoSaveDelay, OnAutoSaveMultiple, AutoSaveStateChanged, _autoSaveRefresh ??= RefreshAutoSave);

    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private Func<bool, Task>? _cachedHandlePopoverOpenChangedDelegate;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "combobox";
        Position ??= _defaultPosition;
    }

    private readonly string _comboboxId = BlazorIdGenerator.New("quark-combobox");
    private string? _inputId;
    private string? _contentId;
    private readonly List<ComboboxItem> _items = [];
    private ComboboxList? _virtualList;
    private IReadOnlyList<SelectOption>? _virtualOptions;
    private string? _virtualActiveValue;
    private readonly List<int> _enabledVirtualIndexes = [];
    private readonly Dictionary<string, int> _enabledVirtualPositions = new(StringComparer.Ordinal);
    internal void SetVirtualOptions(ComboboxList list, IReadOnlyList<SelectOption> options)
    {
        _virtualList = list;
        if (!ReferenceEquals(_virtualOptions, options))
        {
            _enabledVirtualIndexes.Clear();
            _enabledVirtualPositions.Clear();
            for (int i = 0; i < options.Count; i++)
                if (!options[i].Disabled)
                {
                    _enabledVirtualPositions.Add(options[i].Value, _enabledVirtualIndexes.Count);
                    _enabledVirtualIndexes.Add(i);
                }
        }
        _virtualOptions = options;
        EnsureActiveItem();
    }
    internal void ClearVirtualOptions(ComboboxList list)
    {
        if (!ReferenceEquals(_virtualList, list)) return;
        _virtualList = null; _virtualOptions = null; _virtualActiveValue = null;
        _enabledVirtualIndexes.Clear(); _enabledVirtualPositions.Clear();
    }
    private HashSet<ComboboxItem>? _registeredItems;
    private ComboboxItem? _firstActiveItem;
    private ComboboxItem? _visibleItem;
    private ElementReference _triggerElement;
    private bool _hasTriggerElement;
    private bool _triggerReservesInlineEndAction;

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public bool Multiple { get; set; }

    [Parameter]
    public string[]? Values { get; set; }

    [Parameter]
    public EventCallback<string[]> ValueChangedMultiple { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public EventCallback<string?> SearchChanged { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Whether another remote page is available when keyboard navigation reaches the last option.</summary>
    [Parameter] public bool HasMoreOptions { get; set; }

    /// <summary>Loads the next page when ArrowDown reaches the last enabled option.</summary>
    [Parameter] public EventCallback LoadMoreOptions { get; set; }

    [Parameter]
    public bool AutoHighlight { get; set; }

    [Parameter]
    public bool ShowClear { get; set; }

    internal string InputId => _inputId ??= BlazorIdGenerator.Child(_comboboxId, "input");

    internal string ContentId => _contentId ??= BlazorIdGenerator.Child(_comboboxId, "listbox");

    internal string? ActiveItemId => GetActiveItemId();

    internal bool HasVisibleItems => HasAnyVisibleItem();

    internal bool HasTriggerElement => _hasTriggerElement;

    internal ElementReference TriggerElement => _triggerElement;

    internal bool TriggerReservesInlineEndAction => _triggerReservesInlineEndAction;

    internal bool HasClearValue => Multiple
        ? Values?.Length > 0 || !Search.IsNullOrEmpty()
        : !Value.IsNullOrEmpty() || !Search.IsNullOrEmpty();

    internal IReadOnlyList<string> SelectedValues => Values ?? [];

    private async Task HandlePopoverOpenChanged(bool open)
    {
        Open = open;
        var searchChanged = false;
        if (Open)
        {
            searchChanged = ClearSelectedSearchForSingle();
            EnsureActiveItem();
        }
        else
        {
            SetActiveValue(null);
        }

        if (searchChanged)
            await SearchChanged.InvokeAsync(Search);

        await OpenChanged.InvokeAsync(open);
        Refresh();
    }

    internal void SetTriggerElement(ElementReference elementReference, bool reservesInlineEndAction = false)
    {
        _triggerElement = elementReference;
        _hasTriggerElement = true;
        _triggerReservesInlineEndAction = reservesInlineEndAction;
    }

    internal async Task Select(string? v)
    {
        if (Disabled)
            return;

        if (Multiple)
        {
            await ToggleValue(v);
            return;
        }

        var selectionChanged = Value != v;
        Value = v;
        Search = "";
        Open = false;
        SetActiveValue(v);
        await ValueChanged.InvokeAsync(v);
        if (selectionChanged) await NotifyAutoSave(v);
        await SearchChanged.InvokeAsync(Search);
        await OpenChanged.InvokeAsync(false);
        Refresh();
    }

    internal bool IsSelected(string? value)
    {
        if (value.IsNullOrEmpty())
            return false;

        if (Multiple)
            return IndexOfSelectedValue(value) >= 0;

        return string.Equals(Value, value, StringComparison.Ordinal);
    }

    internal async Task SetOpen(bool open)
    {
        if (open && Disabled)
            return;

        Open = open;
        var searchChanged = false;
        if (open)
        {
            searchChanged = ClearSelectedSearchForSingle();
            EnsureActiveItem();
        }
        else
        {
            SetActiveValue(null);
        }

        await OpenChanged.InvokeAsync(open);
        if (searchChanged)
            await SearchChanged.InvokeAsync(Search);

        Refresh();
    }

    internal async Task SetSearch(string? s)
    {
        if (Disabled)
            return;

        Search = s ?? "";
        await SearchChanged.InvokeAsync(Search);
        EnsureActiveItem();
        Refresh();
    }

    internal void RegisterItem(ComboboxItem item)
    {
        if (_registeredItems is not null)
        {
            if (!_registeredItems.Add(item))
                return;
        }
        else
        {
            if (_items.Contains(item))
                return;
            if (_items.Count >= 16)
            {
                _registeredItems = new HashSet<ComboboxItem>(_items);
                _registeredItems.Add(item);
            }
        }

        bool hadVisibleItems = HasVisibleItems;
        string? activeItemId = ActiveItemId;
        _items.Add(item);
        EnsureActiveItem();
        if (hadVisibleItems != HasVisibleItems || activeItemId != ActiveItemId)
            Refresh();
    }

    internal void UnregisterItem(ComboboxItem item)
    {
        bool hadVisibleItems = HasVisibleItems;
        if (!_items.Remove(item))
            return;

        _registeredItems?.Remove(item);
        if (ReferenceEquals(_firstActiveItem, item))
            _firstActiveItem = null;
        if (ReferenceEquals(_visibleItem, item))
            _visibleItem = null;

        if (item.IsActiveItem)
            EnsureActiveItem();

        if (item.IsActiveItem || hadVisibleItems != HasVisibleItems)
            Refresh();
    }

    internal void SetActiveItem(ComboboxItem item)
    {
        if (!item.Disabled && !item.Hidden && !item.IsActiveItem)
        {
            SetActiveValue(item.Value);
            Refresh();
        }
    }

    internal async Task HandleInputKeyDown(string key)
    {
        if (Disabled)
            return;

        if (!Open && key is "Home" or "End" or "Enter" or "Escape")
            return;

        switch (key)
        {
            case "ArrowDown":
            case "ArrowUp":
            case "Home":
            case "End":
                if (!Open)
                    Open = true;

                if (key == "ArrowDown" && HasMoreOptions)
                {
                    bool atEnd;
                    if (_virtualOptions is not null)
                        atEnd = _enabledVirtualIndexes.Count > 0 && _virtualOptions[_enabledVirtualIndexes[^1]].Value == _virtualActiveValue;
                    else
                    {
                        var count = CountVisibleSelectableItems(out var activeIndex);
                        atEnd = count > 0 && activeIndex == count - 1;
                    }
                    if (atEnd) await LoadMoreOptions.InvokeAsync();
                }
                await MoveActiveItem(key);
                await OpenChanged.InvokeAsync(Open);
                Refresh();
                break;
            case "Enter":
                if (_virtualOptions is not null)
                {
                    var position = _virtualActiveValue is null ? -1 : _enabledVirtualPositions.GetValueOrDefault(_virtualActiveValue, -1);
                    var option = position < 0 ? null : _virtualOptions[_enabledVirtualIndexes[position]];
                    if (option is not null) await Select(option.Value);
                    break;
                }
                var activeItem = FindActiveSelectableItem();
                if (activeItem is not null)
                    await Select(activeItem.Value);
                break;
            case "Escape":
                await SetOpen(false);
                break;
            case "Backspace":
                if (Multiple && Search.IsNullOrEmpty())
                    await RemoveLastValue();
                break;
        }
    }

    internal async Task RemoveValue(string value)
    {
        if (Disabled || !Multiple || value.IsNullOrEmpty())
            return;

        if (Values is null || Values.Length == 0)
            return;

        var index = IndexOfSelectedValue(value);
        if (index < 0)
            return;

        var next = new string[Values.Length - 1];
        if (index > 0)
            Array.Copy(Values, 0, next, 0, index);

        var remaining = Values.Length - index - 1;
        if (remaining > 0)
            Array.Copy(Values, index + 1, next, index, remaining);

        Values = next;
        await ValueChangedMultiple.InvokeAsync(Values);
        await NotifyAutoSaveMultiple(Values);
        EnsureActiveItem();
        Refresh();
    }

    internal async Task Clear()
    {
        if (Disabled)
            return;

        Search = "";

        if (Multiple)
        {
            Values = [];
            await ValueChangedMultiple.InvokeAsync(Values);
        await NotifyAutoSaveMultiple(Values);
        }
        else
        {
            Value = null;
            await ValueChanged.InvokeAsync(null);
        await NotifyAutoSave(null);
        }

        Open = false;
        SetActiveValue(null);
        await SearchChanged.InvokeAsync(Search);
        await OpenChanged.InvokeAsync(false);
        Refresh();
    }

    private async Task MoveActiveItem(string key)
    {
        if (_virtualOptions is not null && _virtualList is not null)
        {
            if (_enabledVirtualIndexes.Count == 0) { SetActiveValue(null); return; }
            int current = _virtualActiveValue is null ? -1 : _enabledVirtualPositions.GetValueOrDefault(_virtualActiveValue, -1);
            int targetIndex = _enabledVirtualIndexes[OptionNavigation.Move(current, _enabledVirtualIndexes.Count, key)];
            SetActiveValue(_virtualOptions[targetIndex].Value);
            await _virtualList.Reveal(targetIndex);
            return;
        }
        var count = CountVisibleSelectableItems(out var currentIndex);
        if (count == 0)
        {
            SetActiveValue(null);
            return;
        }

        var nextIndex = OptionNavigation.Move(currentIndex, count, key);

        var next = GetVisibleSelectableItemAt(nextIndex);
        if (next is not null)
            SetActiveValue(next.Value);
    }

    private void EnsureActiveItem()
    {
        if (_virtualOptions is not null)
        {
            int position = _virtualActiveValue is null ? -1 : _enabledVirtualPositions.GetValueOrDefault(_virtualActiveValue, -1);
            if (position < 0 && Value is not null) position = _enabledVirtualPositions.GetValueOrDefault(Value, -1);
            if (position < 0 && AutoHighlight && _enabledVirtualIndexes.Count > 0) position = 0;
            SetActiveValue(position < 0 ? null : _virtualOptions[_enabledVirtualIndexes[position]].Value);
            return;
        }
        if (FindActiveSelectableItem() is not null)
            return;

        ComboboxItem? first = GetVisibleSelectableItemAt(0);
        if (first is null)
        {
            SetActiveValue(null);
            return;
        }

        if (AutoHighlight)
        {
            SetActiveValue(first.Value);
            return;
        }

        if (Value is not null)
        {
            var selectedItem = FindVisibleSelectableItem(Value);
            if (selectedItem is not null)
            {
                SetActiveValue(selectedItem.Value);
                return;
            }
        }

        SetActiveValue(null);
    }

    private async Task ToggleValue(string? value)
    {
        if (value.IsNullOrEmpty())
            return;

        var existingIndex = IndexOfSelectedValue(value);
        if (existingIndex >= 0)
        {
            var next = new string[Values!.Length - 1];
            if (existingIndex > 0)
                Array.Copy(Values, 0, next, 0, existingIndex);

            var remaining = Values.Length - existingIndex - 1;
            if (remaining > 0)
                Array.Copy(Values, existingIndex + 1, next, existingIndex, remaining);

            Values = next;
        }
        else if (Values is { Length: > 0 })
        {
            var next = new string[Values.Length + 1];
            Array.Copy(Values, next, Values.Length);
            next[^1] = value;
            Values = next;
        }
        else
        {
            Values = [value];
        }

        Search = "";
        Open = true;
        SetActiveValue(value);

        await ValueChangedMultiple.InvokeAsync(Values);
        await NotifyAutoSaveMultiple(Values);
        await SearchChanged.InvokeAsync(Search);
        await OpenChanged.InvokeAsync(Open);
        Refresh();
    }

    private bool ClearSelectedSearchForSingle()
    {
        if (!Multiple && Value is not null && string.Equals(Search, Value, StringComparison.Ordinal))
        {
            Search = "";
            return true;
        }

        return false;
    }

    private async Task RemoveLastValue()
    {
        if (!Multiple || Values is null || Values.Length == 0)
            return;

        await RemoveValue(Values[^1]);
    }

    private void SetActiveValue(string? value)
    {
        if (_virtualOptions is not null) _virtualActiveValue = value;
        _firstActiveItem = null;
        foreach (var item in _items)
        {
            bool active = string.Equals(item.Value, value, StringComparison.Ordinal);
            item.SetActive(active);
            if (active)
                _firstActiveItem ??= item;
        }
    }

    private string? GetActiveItemId()
    {
        if (_firstActiveItem?.IsActiveItem == true)
            return _firstActiveItem.ItemId;

        foreach (var item in _items)
        {
            if (item.IsActiveItem)
            {
                _firstActiveItem = item;
                return item.ItemId;
            }
        }

        return null;
    }

    private bool HasAnyVisibleItem()
    {
        if (_virtualOptions is not null) return _virtualOptions.Count > 0;
        if (_visibleItem is { Hidden: false })
            return true;

        foreach (var item in _items)
        {
            if (!item.Hidden)
            {
                _visibleItem = item;
                return true;
            }
        }

        return false;
    }

    private ComboboxItem? FindActiveSelectableItem()
    {
        if (_firstActiveItem is { IsActiveItem: true, Hidden: false, Disabled: false })
            return _firstActiveItem;

        foreach (var item in _items)
        {
            if (item.IsActiveItem && !item.Hidden && !item.Disabled)
                return item;
        }

        return null;
    }

    private ComboboxItem? FindVisibleSelectableItem(string value)
    {
        foreach (var item in _items)
        {
            if (!item.Hidden && !item.Disabled && string.Equals(item.Value, value, StringComparison.Ordinal))
                return item;
        }

        return null;
    }

    private int CountVisibleSelectableItems(out int activeIndex)
    {
        activeIndex = -1;
        var count = 0;

        foreach (var item in _items)
        {
            if (item.Hidden || item.Disabled)
                continue;

            if (item.IsActiveItem)
                activeIndex = count;

            count++;
        }

        return count;
    }

    private ComboboxItem? GetVisibleSelectableItemAt(int targetIndex)
    {
        var index = 0;

        foreach (var item in _items)
        {
            if (item.Hidden || item.Disabled)
                continue;

            if (index == targetIndex)
                return item;

            index++;
        }

        return null;
    }

    private int IndexOfSelectedValue(string value) => OptionNavigation.IndexOf(Values, value, StringComparison.Ordinal);

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-state"] = Open ? "open" : "closed";
        if (Disabled)
            attributes["data-disabled"] = "true";

    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(OnAutoSave);
        hc.Add(AutoSaveStateChanged);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
        hc.Add((Multiple ? _autoSaveMultiple.State : _autoSave.State));
        hc.Add((Multiple ? _autoSaveMultiple.HasSaved : _autoSave.HasSaved));
        hc.Add(OnAutoSaveMultiple);

        hc.Add(Value);
        hc.Add(Search);
        hc.Add(Open);
        hc.Add(Disabled);
        hc.Add(AutoHighlight);
        hc.Add(ShowClear);
        hc.Add(Multiple);

        if (Values is not null)
        {
            foreach (var value in Values)
            {
                hc.Add(value);
            }
        }
    }

    public override async ValueTask DisposeAsync()
    {
        await _autoSave.DisposeAsync();
        await _autoSaveMultiple.DisposeAsync();

        _hasTriggerElement = false;
        await base.DisposeAsync();
    }
}
