@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (StepContext?.HasContent == true)
{
    <CollapsibleTrigger Attributes="@BuildAttributes()">
        @TitleContent
        <Icon Name="LucideIcon.ChevronDown"
              Margin="_renderCss0"
              Size="_renderCss1"
              Opacity='_staticCss1'
              Rotate='Quark.Rotate.Is180.Modifier("group-data-[state=open]")'
              Transition="_renderCss2"
              aria-hidden="true" />
    </CollapsibleTrigger>
}
else
{
    <div @attributes="BuildAttributes()">
        @TitleContent
    </div>
}

@code {
    private static readonly CssValue<CursorBuilder> _conditionalCss0 = Quark.Cursor.Pointer;
    private static readonly CssValue<CursorBuilder> _conditionalCss1 = Quark.Cursor.Default;
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<OpacityBuilder> _staticCss1 = CssValue<OpacityBuilder>.For(Quark.Opacity.Is0, Quark.Opacity.Is100.OnGroupHover, Quark.Opacity.Is100.Modifier("group-data-[state=open]"));
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Quark.Items.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private static readonly CssValue<MarginBuilder> _renderCss0 = Quark.Margin.FromLeft.Auto;
    private static readonly CssValue<SizeBuilder> _renderCss1 = Quark.Size.Is4;
    private static readonly CssValue<TransitionBuilder> _renderCss2 = Quark.Transition.All;
    private static readonly CssValue<RoundedBuilder> _renderCss3 = Quark.Rounded.Full;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss4 = Quark.BackgroundColor.Muted;
    private static readonly CssValue<TruncateBuilder> _renderCss5 = Quark.Truncate.Default;
    private string? _lastBuiltClass;

    [CascadingParameter]
    private ChainOfThoughtStepContext? StepContext { get; set; }

    [Parameter]
    public RenderFragment? Icon { get; set; }

    private RenderFragment? _titleContent;
    private RenderFragment TitleContent => _titleContent ??= @<text>
        @if (Icon is not null)
        {
            @Icon
        }
        else
        {
            <Span Size="_renderCss1" Rounded="_renderCss3" BackgroundColor="_renderCss4" aria-hidden="true" />
        }
        <Span MinWidth="_staticCss0" Truncate="_renderCss5">@ChildContent</Span>
    </text>;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "chain-of-thought-step-title";

        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        Cursor ??= StepContext?.HasContent == true ? _conditionalCss0 : _conditionalCss1;
        ItemsAlign ??= _defaultItemsAlign;
        Gap ??= _defaultGap;
        TextSize ??= _defaultTextSize;
        TextColor ??= _defaultTextColor;
        Transition ??= _defaultTransition;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (StepContext?.HasContent == true)
            {
            const string @class = "group hover:text-foreground";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(StepContext?.HasContent == true);
    }
}
