@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<CollapsibleContent Attributes="@BuildAttributes()">
    @ChildContent
</CollapsibleContent>

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromLeft.Is6.FromTop.Is1;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.FromLeft.Is3;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.FromLeft.Default;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "chain-of-thought-step-content";

        Margin ??= _defaultMargin;
        Padding ??= _defaultPadding;
        Border ??= _defaultBorder;
    }
}
