@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<Collapsible Open="@Open" DefaultOpen="@DefaultOpen" OpenChanged="@OpenChanged" Attributes="@BuildAttributes()">
    @ChildContent
</Collapsible>

@code {
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private string? _lastBuiltClass;

    [Parameter]
    public bool? Open { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; } = true;

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool AutoCloseOnAllComplete { get; set; } = true;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "chain-of-thought";

        Width ??= _defaultWidth;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        {
            const string @class = "not-prose";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(DefaultOpen);
        hc.Add(AutoCloseOnAllComplete);
    }
}
