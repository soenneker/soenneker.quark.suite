@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (HasContent)
{
    <Collapsible Open="@_open" OpenChanged="HandleOpenChanged" Attributes="@BuildStepAttributes()">
        <CascadingValue Value="@Context" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </Collapsible>
}
else
{
    <div @attributes="BuildStepAttributes()">
        <CascadingValue Value="@Context" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Block;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnY.Is1;
    private static readonly string PendingStatus = nameof(ChainOfThoughtStatus.Pending).ToLowerInvariant();
    private static readonly string RunningStatus = nameof(ChainOfThoughtStatus.Running).ToLowerInvariant();
    private static readonly string CompletedStatus = nameof(ChainOfThoughtStatus.Completed).ToLowerInvariant();
    private static readonly string FailedStatus = nameof(ChainOfThoughtStatus.Failed).ToLowerInvariant();
    private ChainOfThoughtStepContext? _context;
    private ChainOfThought? _registeredParent;
    private ValueAtomicBool _initialized;
    private bool _open;
    private bool _wasComplete;

    [CascadingParameter]
    private ChainOfThought? ParentChain { get; set; }

    [Parameter]
    public ChainOfThoughtStatus Status { get; set; } = ChainOfThoughtStatus.Running;

    [Parameter]
    public bool HasContent { get; set; }

    [Parameter]
    public bool AutoCloseOnComplete { get; set; } = true;

    protected override void OnParametersSet()
    {
        var complete = AutoCloseOnComplete && Status == ChainOfThoughtStatus.Completed;
        if (!_initialized.Value)
        {
            _open = !complete;
            _initialized.Value = true;
        }
        else if (complete && !_wasComplete)
            _open = false;

        _wasComplete = complete;
        if (_registeredParent != ParentChain)
            _registeredParent?.UnregisterStep(this);
        _registeredParent = ParentChain;
        ParentChain?.RegisterStep(this, Status);
        base.OnParametersSet();
    }

    private void HandleOpenChanged(bool open) => _open = open;

    public override async ValueTask DisposeAsync()
    {
        _registeredParent?.UnregisterStep(this);
        _registeredParent = null;
        await base.DisposeAsync();
    }

    private ChainOfThoughtStepContext Context
    {
        get
        {
            if (_context is null || _context.HasContent != HasContent)
                _context = new ChainOfThoughtStepContext(HasContent);

            return _context;
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "chain-of-thought-step";

        Display ??= _defaultDisplay;
        Padding ??= _defaultPadding;
    }

    private IReadOnlyDictionary<string, object> BuildStepAttributes()
    {
        var attributes = BuildAttributes();
        attributes["data-status"] = GetStatusValue(Status);
        attributes["data-has-content"] = HasContent ? "true" : "false";
        return attributes;
    }

    private static string GetStatusValue(ChainOfThoughtStatus status) => status switch
    {
        ChainOfThoughtStatus.Pending => PendingStatus,
        ChainOfThoughtStatus.Running => RunningStatus,
        ChainOfThoughtStatus.Completed => CompletedStatus,
        ChainOfThoughtStatus.Failed => FailedStatus,
        _ => status.ToString().ToLowerInvariant()
    };

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Status);
        hc.Add(HasContent);
        hc.Add(AutoCloseOnComplete);
        hc.Add(_open);
    }
}
