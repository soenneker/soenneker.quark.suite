@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">
    @if (Icon is not null)
    {
        @Icon
    }
    else
    {
        <Icon Name="LucideIcon.CircleCheck" Size="_renderCss0" aria-hidden="true" />
    }
    <Span MinWidth="_staticCss0" Truncate="_renderCss1">@Label</Span>
</div>

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Items.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnY.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<TruncateBuilder> _renderCss1 = Quark.Truncate.Default;
    [Parameter]
    public string Label { get; set; } = "Task complete";

    [Parameter]
    public RenderFragment? Icon { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "chain-of-thought-complete";

        Display ??= _defaultDisplay;
        ItemsAlign ??= _defaultItemsAlign;
        Gap ??= _defaultGap;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        TextColor ??= _defaultTextColor;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Label);
    }
}
