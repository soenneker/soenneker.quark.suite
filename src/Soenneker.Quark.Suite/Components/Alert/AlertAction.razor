@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IAlertAction

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<TopBuilder> _defaultTop = Quark.Top.Is2;
    private static readonly CssValue<RightBuilder> _defaultRight = Quark.Right.Is2;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "alert-action";

        Position ??= _defaultPosition;
        Top ??= _defaultTop;
        Right ??= _defaultRight;
    }
}
