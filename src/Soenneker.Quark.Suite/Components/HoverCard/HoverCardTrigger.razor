@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        <CascadingValue Name="@SlotAttributes.Name" Value="TriggerAttributes" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
}
else
{
    <BradixHoverCardTrigger AdditionalAttributes="@TriggerAttributes">
        @ChildContent
    </BradixHoverCardTrigger>
}

@code {
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "hover-card-trigger";
    }

    [CascadingParameter]
    private BradixHoverCard? HoverCard { get; set; }

    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? ParentTriggerContext { get; set; }

    [CascadingParameter(Name = SlotAttributes.Name)]
    private IReadOnlyDictionary<string, object>? SlotAttributeOverrides { get; set; }
    private string? _slotClass;
    private string? _slotStyle;

    [Parameter]
    public bool AsChild { get; set; }

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildAttributes();

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        SlotAttributes.MergeInto(attributes, SlotAttributeOverrides, ref _slotClass, ref _slotStyle);


        if (ParentTriggerContext?.TriggerId is not null)
            attributes["id"] = ParentTriggerContext.TriggerId;

        var describedBy = BuildAriaDescribedBy();
        if (describedBy is not null)
            attributes["aria-describedby"] = describedBy;

        if (ParentTriggerContext?.AriaHasPopup is not null)
            attributes["aria-haspopup"] = ParentTriggerContext.AriaHasPopup;

        if (ParentTriggerContext?.AriaControls is not null)
        {
            attributes["aria-expanded"] = ParentTriggerContext.IsOpen ? "true" : "false";
            attributes["aria-controls"] = ParentTriggerContext.AriaControls;
        }
    }

    private (TriggerContext?, BradixHoverCard?, bool, string?)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<Task>? _contextOpenCallback;
    private Func<Task>? _contextCloseCallback;
    private Func<Task>? _contextOnMouseEnterCallback;
    private Func<Task>? _contextOnMouseLeaveCallback;
    private Func<Task>? _contextOnFocusInCallback;
    private Func<Task>? _contextOnFocusOutCallback;
    private Action<ElementReference>? _contextRegisterElementCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (ParentTriggerContext, HoverCard, HoverCard?.CurrentOpen == true, HoverCard?.ContentId);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = ParentTriggerContext?.DataSlot,
            TriggerId = ParentTriggerContext?.TriggerId,
            IsOpen = ParentTriggerContext?.AriaControls is not null ? ParentTriggerContext.IsOpen : HoverCard?.CurrentOpen == true,
            DataState = HoverCard?.CurrentOpen == true ? "open" : "closed",
            AriaHasPopup = ParentTriggerContext?.AriaHasPopup,
            AriaControls = ParentTriggerContext?.AriaControls,
            AriaDescribedBy = BuildAriaDescribedBy(),
            Toggle = ParentTriggerContext?.Toggle,
            ParentDisabled = ParentTriggerContext?.ParentDisabled == true,
            PreventPointerDownDefault = ParentTriggerContext?.PreventPointerDownDefault == true,
            OnClick = ParentTriggerContext?.OnClick,
            OnKeyDown = ParentTriggerContext?.OnKeyDown,
            OnPointerMove = ParentTriggerContext?.OnPointerMove,
            OnPointerLeave = ParentTriggerContext?.OnPointerLeave,
            OnPointerUp = ParentTriggerContext?.OnPointerUp,
            OnMouseMove = ParentTriggerContext?.OnMouseMove,
            SuppressClickAfterPointerDown = ParentTriggerContext?.SuppressClickAfterPointerDown == true,
            OnPointerDown = ParentTriggerContext?.OnPointerDown,
            OnPointerDownEvent = ParentTriggerContext?.OnPointerDownEvent,
            Open = HoverCard is null ? null : (_contextOpenCallback ??= () => HoverCard.HandleTriggerEnter()),
            Close = HoverCard is null ? null : (_contextCloseCallback ??= () => HoverCard.Dismiss()),
            OnMouseEnter = _contextOnMouseEnterCallback ??= async () =>
            {
                if (ParentTriggerContext?.OnMouseEnter is not null) await ParentTriggerContext.OnMouseEnter();
                if (HoverCard is not null) await HoverCard.HandleTriggerEnter();
            },
            OnMouseLeave = _contextOnMouseLeaveCallback ??= async () =>
            {
                if (ParentTriggerContext?.OnMouseLeave is not null) await ParentTriggerContext.OnMouseLeave();
                if (HoverCard is not null) await HoverCard.HandleTriggerLeave();
            },
            OnFocusIn = _contextOnFocusInCallback ??= async () =>
            {
                if (ParentTriggerContext?.OnFocusIn is not null) await ParentTriggerContext.OnFocusIn();
                if (HoverCard is not null) await HoverCard.HandleTriggerFocus();
            },
            OnFocusOut = _contextOnFocusOutCallback ??= async () =>
            {
                if (ParentTriggerContext?.OnFocusOut is not null) await ParentTriggerContext.OnFocusOut();
                if (HoverCard is not null) await HoverCard.HandleTriggerBlur();
            },
            RegisterElement = _contextRegisterElementCallback ??= elementReference =>
            {
                ParentTriggerContext?.RegisterElement?.Invoke(elementReference);
                HoverCard?.RegisterAnchor(elementReference);
            }
        };
    }

    private string? _combinedDescribedBy;
    private string? BuildAriaDescribedBy()
    {
        var hoverCardId = HoverCard?.CurrentOpen == true ? HoverCard.ContentId : null;
        var parentDescribedBy = ParentTriggerContext?.AriaDescribedBy;

        if (parentDescribedBy is null)
            return hoverCardId;

        if (hoverCardId is null)
            return parentDescribedBy;

        return QuarkStringCache.Concat(parentDescribedBy, " ", hoverCardId, ref _combinedDescribedBy);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(HoverCard?.CurrentOpen);
        hc.Add(HoverCard?.ContentId);
        hc.Add(AsChild);
        hc.Add(SlotAttributeOverrides);
        hc.Add(ParentTriggerContext?.ParentDisabled);
        hc.Add(ParentTriggerContext?.PreventPointerDownDefault);
        hc.Add(ParentTriggerContext?.TriggerId);
        hc.Add(ParentTriggerContext?.AriaHasPopup);
        hc.Add(ParentTriggerContext?.AriaControls);
        hc.Add(ParentTriggerContext?.AriaDescribedBy);
        hc.Add(ParentTriggerContext?.IsOpen);
        hc.Add(ParentTriggerContext?.SuppressClickAfterPointerDown == true);
    }
}
