@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixHoverCard Open="@(_hasControlledOpen ? Open : (bool?)null)"
                 DefaultOpen="@DefaultOpen"
                 OpenChanged="@OpenChanged"
                 OpenDelay="@OpenDelay"
                 CloseDelay="@CloseDelay">
    @ChildContent
</BradixHoverCard>

@code {
    private bool _hasControlledOpen;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        if (parameters.TryGetValue<bool>(nameof(Open), out _))
            _hasControlledOpen = true;

        return base.SetParametersAsync(parameters);
    }
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "hover-card";
    }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public int OpenDelay { get; set; } = 700;

    [Parameter]
    public int CloseDelay { get; set; } = 300;

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(_hasControlledOpen);
        hc.Add(DefaultOpen);
        hc.Add(OpenDelay);
        hc.Add(CloseDelay);
    }
}