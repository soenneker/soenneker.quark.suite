
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IOrderedList

<ol @attributes="BuildAttributes()">
	@ChildContent
</ol>

@code {
    private string? _appendedClass0;
    private string? _appendedClass1;
    private string? _appendedClass2;
    private string? _appendedClass3;
    private string? _listStyleValue;
    private string? _listStyleDeclaration;
    private string? _appendedStyle;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "ordered-list";
    }

    /// <summary>
    /// Gets or sets the list variant style.
    /// </summary>
    [Parameter]
    public CssValue<ListVariantBuilder>? ListVariant { get; set; }

    /// <summary>
    /// Gets or sets the list style type.
    /// </summary>
    [Parameter]
    public CssValue<ListStyleTypeBuilder>? ListStyleType { get; set; }

    // shadcn-style list - new-york-v4
    protected override void BuildAttributesCore(Dictionary<string, object> attrs)
    {
        base.BuildAttributesCore(attrs);

        if (ListVariant is null or { IsEmpty: true })
            AppendClassAttribute(attrs, "my-6 ms-6 [&>li]:mt-2", ref _appendedClass0);

        if ((ListVariant is null or { IsEmpty: true }) && (ListStyleType is null or { IsEmpty: true }))
            AppendClassAttribute(attrs, "list-decimal", ref _appendedClass1);

        if (ListVariant is { IsEmpty: false })
        {
            var cls = ListVariant.Value.ToString();
            if (cls.Length > 0)
            {
                AppendClassAttribute(attrs, cls, ref _appendedClass2);
            }
        }
        
        if (ListStyleType is { IsEmpty: false })
        {
            var cls = ListStyleType.Value.ToString();
            if (cls.Length > 0)
            {
                AppendListStyleType(attrs, cls);
            }
        }
    }

    private void AppendListStyleType(Dictionary<string, object> attrs, string value)
    {
        const string arbitraryPrefix = "list-[";

        if (value.StartsWith(arbitraryPrefix, StringComparison.Ordinal) && value.EndsWith(']'))
        {
            if (_listStyleValue != value)
            {
                _listStyleDeclaration = string.Concat("list-style-type: ", value.AsSpan(arbitraryPrefix.Length, value.Length - arbitraryPrefix.Length - 1));
                _listStyleValue = value;
            }
            AppendStyleDeclAttr(attrs, _listStyleDeclaration!, ref _appendedStyle);
            return;
        }

        AppendClassAttribute(attrs, value, ref _appendedClass3);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        AddIf(ref hc, ListVariant);
        AddIf(ref hc, ListStyleType);
    }
}