
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IOrderedListItem

<li @attributes="BuildAttributes()">
	@ChildContent
</li>

@code {
    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);

        if (Value.HasValue)
            attributes["value"] = QuarkAttributeValues.FromInt32(Value.Value);

    }


    [Parameter]
    public int? Value { get; set; }


    private string? _appendedClass0;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "ordered-list-item";
    }

    /// <summary>
    /// Gets or sets the list variant style.
    /// </summary>
    [Parameter]
    public CssValue<ListVariantBuilder>? ListVariant { get; set; }

    // shadcn-style list item - new-york-v4
    protected override void BuildAttributesCore(Dictionary<string, object> attrs)
    {
        base.BuildAttributesCore(attrs);
        
        if (ListVariant is { IsEmpty: false })
        {
            var cls = ListVariant.Value.ToString();
            if (cls.Length > 0)
            {
                AppendClassAttribute(attrs, cls, ref _appendedClass0);
            }
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);

        AddIf(ref hc, ListVariant);
    }
}