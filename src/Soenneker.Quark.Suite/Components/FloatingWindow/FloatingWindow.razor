    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        _initialization.TrySetCanceled();
        try
        {
            await _disposeCts.CancelAsync();
            try
            {
                if (_initializeTask is not null)
                    await _initializeTask;
            }
            finally
            {
                if (_initializeTask is not null)
                    await WindowInterop.Destroy(Id!, CancellationToken.None);
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or OperationCanceledException or ObjectDisposedException) { }
        finally
        {
            _initialized = false;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
            _disposeCts.Dispose();
            await base.DisposeAsync();
        }
    }

