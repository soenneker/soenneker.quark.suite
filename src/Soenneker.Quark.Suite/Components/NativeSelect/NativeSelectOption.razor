@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements INativeSelectOption

<option @attributes="BuildAttributes()">@ChildContent</option>

@code {
    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);

        if (Label is not null)
            attributes["label"] = Label;

        if (Selected.HasValue)
            attributes["selected"] = Selected.Value ? QuarkAttributeValues.True : false;

    }


    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool? Selected { get; set; }


    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Token("[Canvas]");
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Token("[CanvasText]");
    /// <summary>
    /// Gets or sets the option value.
    /// </summary>

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (Value is not null)
            attributes["value"] = Value!;

        if (Disabled)
            attributes["disabled"] = QuarkAttributeValues.True;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Label);
        hc.Add(Selected);

        hc.Add(Value);
        hc.Add(Disabled);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "native-select-option";
        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;

    }
}