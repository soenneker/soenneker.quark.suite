@namespace Soenneker.Quark

<Tooltip>
    <TooltipTrigger AsChild="true">
        <Button Type="@ButtonType.Button"
                Variant="ButtonVariant.Ghost"
                ButtonSize="ButtonSize.Icon"
                DataSlot="button"
                data-theme="@ThemeState"
                Size="Quark.Size.Is8"
                Position="Quark.Position.Relative" Overflow="Quark.Overflow.Hidden" Class="group/toggle extend-touch-target"
                OnClick="@(_ => HandleClick())"
                aria-label="@AriaLabel">
            <Span Position="Quark.Position.Relative" Display="Quark.Display.Grid" Size="Quark.Size.Is4_5" Overflow="Quark.Overflow.Hidden" Class="place-items-center" aria-hidden="true">
                <Span Class="@SunClass">
                    <Icon Name="LucideIcon.Sun" Size="Quark.Size.Is4_5" />
                </Span>
                <Span Class="@SystemClass">
                    <Icon Name="LucideIcon.Monitor" Size="Quark.Size.Is4_5" />
                </Span>
                <Span Class="@MoonClass">
                    <Icon Name="LucideIcon.Moon" Size="Quark.Size.Is4_5" />
                </Span>
            </Span>
            <Span ScreenReader="Quark.ScreenReader.Only">@AriaLabel</Span>
        </Button>
    </TooltipTrigger>
    <TooltipContent>@TooltipText</TooltipContent>
</Tooltip>

@code {
    /// <summary>The selected mode. When omitted, the button retains its light/dark behavior through IsDark and OnClick.</summary>
    [Parameter]
    public ThemeMode? Mode { get; set; }

    /// <summary>Raised with the next mode in the system, light, dark cycle.</summary>
    [Parameter]
    public EventCallback<ThemeMode> ModeChanged { get; set; }

    [Parameter]
    public bool IsDark { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Toggle theme";

    [Parameter]
    public EventCallback OnClick { get; set; }

    private ThemeMode CurrentMode => Mode ?? (IsDark ? ThemeMode.Dark : ThemeMode.Light);

    private ThemeMode NextMode => CurrentMode switch
    {
        var mode when mode == ThemeMode.System => ThemeMode.Light,
        var mode when mode == ThemeMode.Light => ThemeMode.Dark,
        _ => Mode is not null ? ThemeMode.System : ThemeMode.Light
    };

    private string ThemeState => CurrentMode.Value;

    private string TooltipText => $"Theme: {ThemeState}. Switch to {NextMode.Value} mode";

    private string SystemClass => GetIconClass(CurrentMode == ThemeMode.System, "-rotate-90");

    private string SunClass => GetIconClass(CurrentMode == ThemeMode.Light, "-rotate-90");

    private string MoonClass => GetIconClass(CurrentMode == ThemeMode.Dark, "rotate-90");

    private async Task HandleClick()
    {
        if (Mode is not null)
            await ModeChanged.InvokeAsync(NextMode);
        await OnClick.InvokeAsync();
    }

    private static string GetIconClass(bool active, string inactiveRotation)
    {
        const string baseClass = "absolute inset-0 grid place-items-center transition-all duration-300 ease-out";

        return active
            ? $"{baseClass} rotate-0 scale-100 opacity-100"
            : $"{baseClass} {inactiveRotation} scale-0 opacity-0";
    }
}
