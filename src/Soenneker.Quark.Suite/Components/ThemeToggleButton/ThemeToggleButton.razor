@namespace Soenneker.Quark

<Tooltip>
    <TooltipTrigger AsChild="true">
        <Button Type="@ButtonType.Button"
                Variant="ButtonVariant.Ghost"
                ButtonSize="_staticCss0"
                DataSlot="button"
                data-theme="@ThemeState"
                Size="_renderCss0"
                Position="_renderCss1" Overflow="_renderCss2" Class="group/toggle extend-touch-target"
                OnClick="@(_clickCallback ??= HandleClick)"
                aria-label="@AriaLabel">
            <Span Position="_renderCss1" Display="_renderCss3" Size="_renderCss4" Overflow="_renderCss2" Class="place-items-center" aria-hidden="true">
                <Span Class="@SunClass">
                    <Icon Name="LucideIcon.Sun" Size="_renderCss4" />
                </Span>
                <Span Class="@SystemClass">
                    <Icon Name="LucideIcon.Monitor" Size="_renderCss4" />
                </Span>
                <Span Class="@MoonClass">
                    <Icon Name="LucideIcon.Moon" Size="_renderCss4" />
                </Span>
            </Span>
            <Span ScreenReader="_renderCss5">@AriaLabel</Span>
        </Button>
    </TooltipTrigger>
    <TooltipContent>@TooltipText</TooltipContent>
</Tooltip>

@code {
    private Func<MouseEventArgs, Task>? _clickCallback;
    private (string Current, string Next) _tooltipKey;
    private string? _tooltipText;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = ButtonSize.Icon;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Size.Is8;
    private static readonly CssValue<PositionBuilder> _renderCss1 = Position.Relative;
    private static readonly CssValue<OverflowBuilder> _renderCss2 = Overflow.Hidden;
    private static readonly CssValue<DisplayBuilder> _renderCss3 = Display.Grid;
    private static readonly CssValue<SizeBuilder> _renderCss4 = Size.Is4_5;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss5 = ScreenReader.Only;
    /// <summary>The selected mode. When omitted, the button retains its light/dark behavior through IsDark and OnClick.</summary>
    [Parameter]
    public ThemeMode? Mode { get; set; }

    /// <summary>Raised with the next mode in the system, light, dark cycle.</summary>
    [Parameter]
    public EventCallback<ThemeMode> ModeChanged { get; set; }

    [Parameter]
    public bool IsDark { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Toggle theme";

    [Parameter]
    public EventCallback OnClick { get; set; }

    private ThemeMode CurrentMode => Mode ?? (IsDark ? ThemeMode.Dark : ThemeMode.Light);

    private ThemeMode NextMode => CurrentMode switch
    {
        var mode when mode == ThemeMode.System => ThemeMode.Light,
        var mode when mode == ThemeMode.Light => ThemeMode.Dark,
        _ => Mode is not null ? ThemeMode.System : ThemeMode.Light
    };

    private string ThemeState => CurrentMode.Value;

    private string TooltipText
    {
        get
        {
            var key = (ThemeState, NextMode.Value);
            if (_tooltipText is null || key != _tooltipKey)
            {
                _tooltipText = $"Theme: {key.Item1}. Switch to {key.Item2} mode";
                _tooltipKey = key;
            }
            return _tooltipText;
        }
    }

    private string SystemClass => GetIconClass(CurrentMode == ThemeMode.System, "-rotate-90");

    private string SunClass => GetIconClass(CurrentMode == ThemeMode.Light, "-rotate-90");

    private string MoonClass => GetIconClass(CurrentMode == ThemeMode.Dark, "rotate-90");

    private async Task HandleClick(MouseEventArgs _)
    {
        if (Mode is not null)
            await ModeChanged.InvokeAsync(NextMode);
        await OnClick.InvokeAsync();
    }

    private static string GetIconClass(bool active, string inactiveRotation)
    {
        const string baseClass = "absolute inset-0 grid place-items-center transition-all duration-300 ease-out";

        return active
            ? $"{baseClass} rotate-0 scale-100 opacity-100"
            : inactiveRotation == "rotate-90"
                ? baseClass + " rotate-90 scale-0 opacity-0"
                : baseClass + " -rotate-90 scale-0 opacity-0";
    }
}
