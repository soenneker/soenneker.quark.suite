@using Soenneker.Bradix
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixPopover Open="@(_hasControlledOpen ? Open : (bool?)null)"
               DefaultOpen="@DefaultOpen"
               OpenChanged="@OpenChanged"
               Modal="@Modal">
    <CascadingValue Value="_context" IsFixed="true"
                    ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />
</BradixPopover>

@code {
    private bool _hasControlledOpen;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        if (parameters.TryGetValue<bool>(nameof(Open), out _))
            _hasControlledOpen = true;

        return base.SetParametersAsync(parameters);
    }
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    /// <summary>Radix <c>modal</c>; default <c>false</c> (popover does not trap the page as a modal dialog).</summary>
    [Parameter]
    public bool Modal { get; set; }

    private PopoverContext _context = null!;

    protected override void OnInitialized()
    {
        _context = new PopoverContext
        {
            Modal = Modal
        };
    }

    protected override void OnParametersSet()
    {
        _context.Modal = Modal;
        base.OnParametersSet();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(_hasControlledOpen);
        hc.Add(DefaultOpen);
        hc.Add(Modal);
    }
}
