@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement

@if (AsChild)
{
    <BradixDismissableLayerBranch>
        <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </BradixDismissableLayerBranch>
}
else
{
    <BradixPopoverTrigger Id="@ResolvedTriggerId"
                          Disabled="@Disabled"
                          OnClick="@OnClick"
                          AdditionalAttributes="@TriggerAttributes">
        @ChildContent
    </BradixPopoverTrigger>
}

@code {
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    [CascadingParameter]
    private BradixPopover? BradixPopover { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    private QuarkAttributeDictionary _attributesBuffer;

    private string? ResolvedTriggerId => string.IsNullOrWhiteSpace(Id) ? BradixPopover?.DefaultTriggerId : Id;

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildTriggerAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "popover-trigger";
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
    }

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        Dictionary<string, object> attributes = _attributesBuffer.Create(BuildAttributes());
        attributes.Remove("id");

        return attributes;
    }

    private (bool, BradixPopover?, bool, string?, string?)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<PointerEventArgs, Task>? _contextOnPointerDownEventCallback;
    private Func<Task>? _contextToggleCallback;
    private Func<Task>? _contextOpenCallback;
    private Func<Task>? _contextCloseCallback;
    private Action<ElementReference>? _contextRegisterElementCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (Disabled, BradixPopover, BradixPopover?.CurrentOpen == true, ResolvedTriggerId, BradixPopover?.ContentId);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = "popover-trigger",
            TriggerId = ResolvedTriggerId,
            ParentDisabled = Disabled,
            IsOpen = BradixPopover?.CurrentOpen == true,
            DataState = BradixPopover?.CurrentOpen == true ? "open" : "closed",
            AriaHasPopup = "dialog",
            AriaControls = BradixPopover?.ContentId,
            OnPointerDownEvent = BradixPopover is null || Disabled ? null : (_contextOnPointerDownEventCallback ??= HandleTriggerPointerDown),
            SuppressClickAfterPointerDown = true,
            Toggle = BradixPopover is null || Disabled ? null : (_contextToggleCallback ??= () => BradixPopover.ToggleOpen()),
            Open = BradixPopover is null || Disabled ? null : (_contextOpenCallback ??= () => BradixPopover.SetOpen(true)),
            Close = BradixPopover is null ? null : (_contextCloseCallback ??= () => BradixPopover.SetOpen(false)),
            RegisterElement = BradixPopover is null
                ? null
                : (_contextRegisterElementCallback ??= elementReference =>
                {
                    BradixPopover.RegisterTrigger(elementReference, ResolvedTriggerId);

                    if (BradixPopover.HasCustomAnchor != true)
                        BradixPopover.RegisterAnchor(elementReference);
                })
        };
    }

    private Task HandleTriggerPointerDown(PointerEventArgs args)
    {
        if (BradixPopover is null || Disabled || args.Button != 0 || args.CtrlKey)
            return Task.CompletedTask;

        return BradixPopover.ToggleOpen();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Disabled);
        hc.Add(BradixPopover?.CurrentOpen);
        hc.Add(AsChild);
        hc.Add(ResolvedTriggerId);
        hc.Add(BradixPopover?.ContentId);
    }
}
