@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
<BradixPopoverPortal>
    <BradixPopoverContent Id="@ResolvedContentId"
                          Side="@Side"
                          Align="@Align"
                          SideOffset="@SideOffset"
                          AlignOffset="@AlignOffset"
                          ArrowPadding="@ArrowPadding"
                          AvoidCollisions="@AvoidCollisions"
                          CollisionPadding="@CollisionPadding"
                          CollisionBoundarySelector="@CollisionBoundarySelector"
                          CollisionBoundarySelectors="@CollisionBoundarySelectors"
                          Sticky="@Sticky"
                          HideWhenDetached="@HideWhenDetached"
                          CloseOnEscapeKeyDown="@CloseOnEscape"
                          OnOpenAutoFocus="@OnOpenAutoFocus"
                          OnOpenAutoFocusDetailed="@OnOpenAutoFocusDetailed"
                          AdditionalAttributes="@ContentAttributes">
        @ChildContent
    </BradixPopoverContent>
</BradixPopoverPortal>

@code {
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is50;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2_5;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.Is72;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is2_5;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Md;
    private static readonly CssValue<RingBuilder> _defaultRing = Quark.Ring.Is1;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.Utility("ring-foreground/10");
    private string? _lastPrependedClass;

    [CascadingParameter]
    private BradixPopover? BradixPopover { get; set; }

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public EventCallback OnOpenAutoFocus { get; set; }

    [Parameter]
    public EventCallback<BradixAutoFocusEventArgs> OnOpenAutoFocusDetailed { get; set; }

    [Parameter]
    public Side Side { get; set; } = Side.Bottom;

    [Parameter]
    public Alignment Align { get; set; } = Alignment.Center;

    [Parameter]
    public string Slot { get; set; } = "popover-content";

    [Parameter]
    public bool UseDefaultLayout { get; set; } = true;

    [Parameter]
    public bool UseDefaultMotion { get; set; } = true;

    [Parameter]
    public int SideOffset { get; set; } = 4;

    [Parameter]
    public double AlignOffset { get; set; }

    [Parameter]
    public double ArrowPadding { get; set; }

    [Parameter]
    public bool AvoidCollisions { get; set; } = true;

    [Parameter]
    public double CollisionPadding { get; set; }

    [Parameter]
    public string? CollisionBoundarySelector { get; set; }

    [Parameter]
    public IReadOnlyList<string>? CollisionBoundarySelectors { get; set; }

    [Parameter]
    public string Sticky { get; set; } = "partial";

    [Parameter]
    public bool HideWhenDetached { get; set; }

    private string? ResolvedContentId => string.IsNullOrWhiteSpace(Id) ? BradixPopover?.ContentId : Id;

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildContentAttributes();

    private IReadOnlyDictionary<string, object> BuildContentAttributes()
    {
        return BuildAttributes();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= Slot;

        ZIndex ??= _defaultZIndex;
        if (UseDefaultLayout)
        {
            Display ??= _defaultDisplay;
            FlexDirection ??= _defaultFlexDirection;
            Gap ??= _defaultGap;
        }

        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;
        Width ??= _defaultWidth;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        OutlineStyle ??= _defaultOutlineStyle;
        Shadow ??= _defaultShadow;
        Ring ??= _defaultRing;
        RingColor ??= _defaultRingColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (UseDefaultMotion)
        {
            const string @class = "origin-(--radix-popover-content-transform-origin) duration-100 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Side);
        hc.Add(Align);
        hc.Add(Slot);
        hc.Add(UseDefaultLayout);
        hc.Add(UseDefaultMotion);
        hc.Add(SideOffset);
        hc.Add(AlignOffset);
        hc.Add(ArrowPadding);
        hc.Add(AvoidCollisions);
        hc.Add(CollisionPadding);
        hc.Add(CollisionBoundarySelector);
        if (CollisionBoundarySelectors is not null)
        {
            foreach (var selector in CollisionBoundarySelectors)
                hc.Add(selector);
        }
        hc.Add(Sticky);
        hc.Add(HideWhenDetached);
        hc.Add(CloseOnEscape);
        hc.Add(BradixPopover?.CurrentOpen);
        hc.Add(ResolvedContentId);
    }
}
