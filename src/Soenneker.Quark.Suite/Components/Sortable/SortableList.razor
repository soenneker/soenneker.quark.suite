@using System.Text.Json
@using Soenneker.Atomics.ValueBools
@using Microsoft.JSInterop
@using Soenneker.Blazor.Utils.Ids
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ISortableList

@inject ISortableInterop SortableInterop

<div @ref="ElementRef" @attributes="BuildAttributes()">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private string? _lastBuiltClass;

    private string? _listId;
    private DotNetObjectReference<SortableList>? _dotNetRef;
    private string? _initializationError;
    private ValueAtomicBool _disposed;
    private InitializationKey? _lastInitializationKey;
    private InitializationKey? _lastFailedInitializationKey;


    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Sort { get; set; } = true;

    [Parameter]
    public int AnimationMs { get; set; } = 150;

    [Parameter]
    public bool ForceFallback { get; set; } = true;

    [Parameter]
    public string? Group { get; set; }

    [Parameter]
    public string? ListId { get; set; }

    [Parameter]
    public bool HandleOnly { get; set; }

    [Parameter]
    public string ItemSelector { get; set; } = "[data-sortable-item]";

    [Parameter]
    public string? HandleSelector { get; set; }

    [Parameter]
    public string? FilterSelector { get; set; }

    [Parameter]
    public EventCallback<SortableReorderEventArgs> OnReorder { get; set; }

    [JSInvokable(nameof(HandleReorder))]
    public Task HandleReorderFromJson(JsonElement payload) =>
        HandleReorder(JsonSerializer.Deserialize(payload, QuarkInteropJsonContext.Default.SortableReorderEventArgs)!);

    public Task HandleReorder(SortableReorderEventArgs args) =>
        args.OldIndex >= 0 && args.NewIndex >= 0 && OnReorder.HasDelegate
            ? OnReorder.InvokeAsync(args)
            : Task.CompletedTask;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sortable-list";

        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Gap ??= _defaultGap;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-sortable-list-id"] = ResolveListId();
        attributes["data-sortable-keyboard"] = "true";

        if (!attributes.ContainsKey("role"))
        {
            attributes["role"] = Role ?? "list";
        }

        if (Disabled)
        {
            attributes["data-disabled"] = "true";
            attributes["aria-disabled"] = "true";
        }

        if (_initializationError is not null)
        {
            attributes["data-sortable-init-error"] = _initializationError;
        }

        if (Disabled)
            PrependClassAttribute(attributes, "opacity-80", ref _lastBuiltClass);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;

        var initializationKey = new InitializationKey(Disabled, Sort, AnimationMs, ForceFallback, ItemSelector,
            ResolveHandleSelector(), FilterSelector, Group, ResolveListId(), OnReorder.HasDelegate);
        try
        {
            if (firstRender || _lastInitializationKey != initializationKey)
            {
                await SortableInterop.Initialize();
                if (_disposed.Read())
                    return;

                _dotNetRef ??= DotNetObjectReference.Create(this);
                await SortableInterop.InitializeList(ElementRef, Disabled, Sort, AnimationMs, ForceFallback, ItemSelector, ResolveHandleSelector(), FilterSelector,
                    Group, OnReorder.HasDelegate, _dotNetRef);
                if (_disposed.Read())
                {
                    await SortableInterop.Destroy(ElementRef);
                    return;
                }

                _lastInitializationKey = initializationKey;
                _lastFailedInitializationKey = null;
            }

            if (_initializationError is not null)
            {
                _initializationError = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            if (_disposed.Read())
                return;

            var error = ex.GetType().Name;
            if (!string.Equals(_initializationError, error, StringComparison.Ordinal) || _lastFailedInitializationKey != initializationKey)
            {
                _initializationError = error;
                _lastFailedInitializationKey = initializationKey;
                await InvokeAsync(StateHasChanged);
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            await SortableInterop.Destroy(ElementRef);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException or ObjectDisposedException)
        {
        }
        finally
        {
            _dotNetRef?.Dispose();
            _dotNetRef = null;
            await base.DisposeAsync();
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Disabled);
        hc.Add(Sort);
        hc.Add(AnimationMs);
        hc.Add(ForceFallback);
        hc.Add(Group);
        hc.Add(ListId);
        hc.Add(HandleOnly);
        hc.Add(ItemSelector);
        hc.Add(HandleSelector);
        hc.Add(FilterSelector);
    }

    private string? ResolveHandleSelector()
    {
        if (HandleSelector is not null)
        {
            return HandleSelector;
        }

        return HandleOnly ? "[data-sortable-handle]" : null;
    }

    private string ResolveListId()
    {
        return ListId.HasContent() ? ListId! : _listId ??= BlazorIdGenerator.New("quark-sortable");
    }
}
