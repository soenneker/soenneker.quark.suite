@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ISortableHandle

<button type="button" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @attributes="BuildAttributes()">
    @ChildContent
</button>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Grab;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private string? _lastPrependedClass;

    private Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private Task HandleClick(MouseEventArgs args)
    {
        return OnClick.HasDelegate ? OnClick.InvokeAsync(args) : Task.CompletedTask;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sortable-handle";
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Shrink ??= _defaultShrink;
        Cursor ??= _defaultCursor;
        UserSelect ??= _defaultUserSelect;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-sortable-handle"] = string.Empty;
        attributes.TryAdd("aria-keyshortcuts", "Space Enter ArrowUp ArrowDown Home End");

        if (!attributes.ContainsKey("aria-label") && AriaLabel is null)
        {
            attributes["aria-label"] = "Drag handle";
        }

        PrependClassAttribute(attributes, "touch-none", ref _lastPrependedClass);
    }
}