@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IAlertDialogTitle

<BradixAlertDialogTitle Id="@Context?.TitleId" AdditionalAttributes="@TitleAttributes">
    @ChildContent
</BradixAlertDialogTitle>

@code {
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Base;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private string? _lastPrependedClass;

    [CascadingParameter]
    private OverlayLabelContext? Context { get; set; }

    private IReadOnlyDictionary<string, object> TitleAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "alert-dialog-title";
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "cn-font-heading sm:group-data-[size=default]/alert-dialog-content:group-has-data-[slot=alert-dialog-media]/alert-dialog-content:col-start-2", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Context?.TitleId);
    }
}