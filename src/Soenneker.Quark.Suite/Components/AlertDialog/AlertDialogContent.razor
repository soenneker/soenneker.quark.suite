@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.InteractiveElement
@implements IAlertDialogContent

<BradixAlertDialogPortal>
    @if (ParentAlertDialog?.ShowBackdrop == true)
    {
        <BradixAlertDialogOverlay AdditionalAttributes="@OverlayAttributes" />
    }

    <BradixAlertDialogContent Id="@Context?.ContentId"
                              CloseOnEscapeKeyDown="@(ParentAlertDialog?.CloseOnEscape ?? true)"
                              AdditionalAttributes="@ContentAttributes">
        @ChildContent
    </BradixAlertDialogContent>
</BradixAlertDialogPortal>

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Fixed;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Grid;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is50;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is4;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Xl;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is4;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private string? _lastPrependedClass;
    private string? _lastBuiltClass;

    private QuarkAttributeDictionary _overlayAttributesBuffer;
    [CascadingParameter(Name = nameof(ParentAlertDialog))]
    public AlertDialog? ParentAlertDialog { get; set; }

    [CascadingParameter]
    private OverlayLabelContext? Context { get; set; }

    /// <summary>
    /// Gets or sets the size variant of the alert dialog content ("default" or "sm").
    /// </summary>
    [Parameter]
    public string AlertDialogContentSize { get; set; } = "default";

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "alert-dialog-content";
        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        ZIndex ??= _defaultZIndex;
        Width ??= _defaultWidth;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        TextColor ??= _defaultTextColor;

    }

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildAttributes();

    private IReadOnlyDictionary<string, object> OverlayAttributes => BuildOverlayAttributes();

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var size = AlertDialogContentSize.AsSpan().Trim();
        var normalizedSize = size.Equals("sm", StringComparison.OrdinalIgnoreCase) ? "sm" : "default";

        PrependClassAttribute(attributes, "group/alert-dialog-content top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ring-1 ring-foreground/10 duration-100 outline-none data-[size=default]:max-w-xs data-[size=sm]:max-w-xs data-[size=default]:sm:max-w-sm data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95", ref _lastPrependedClass);

        attributes["data-size"] = normalizedSize;
    }

    private Dictionary<string, object> BuildOverlayAttributes()
    {
        var attributes = _overlayAttributesBuffer.Create(3);

        {
            const string @class = "fixed inset-0 z-50 bg-black/10 duration-100 supports-backdrop-filter:backdrop-blur-xs data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:animate-in data-[state=open]:fade-in-0";
            const string variant = @class + " " + "backdrop-blur";
            PrependClassAttribute(attributes, ParentAlertDialog?.BlurBackdrop == true ? variant : @class, ref _lastBuiltClass);
        }

        attributes["data-slot"] = "alert-dialog-overlay";
        attributes["aria-hidden"] = "true";

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AlertDialogContentSize);
        hc.Add(ParentAlertDialog?.Visible ?? false);
        hc.Add(ParentAlertDialog?.ShowBackdrop ?? true);
        hc.Add(ParentAlertDialog?.BlurBackdrop ?? false);
        hc.Add(ParentAlertDialog?.TrapFocus ?? true);
        hc.Add(ParentAlertDialog?.CloseOnEscape ?? true);
        hc.Add(ParentAlertDialog?.CloseOnBackdropClick ?? true);
        hc.Add(ParentAlertDialog?.Static ?? false);
        hc.Add(Context?.ContentId);
    }
}
