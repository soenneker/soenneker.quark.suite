@using Soenneker.Bradix
@using Soenneker.Blazor.Utils.Ids

@namespace Soenneker.Quark
@inherits Soenneker.Quark.TriggerElement
@implements IAlertDialogTrigger

@if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <BradixDialogTrigger Disabled="@Disabled"
                         OnClick="@OnClick"
                         AdditionalAttributes="@TriggerAttributes">
        @ChildContent
    </BradixDialogTrigger>
}

@code {
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private QuarkAttributeDictionary _triggerAttributes;
    [CascadingParameter(Name = nameof(ParentAlertDialog))]
    public AlertDialog? ParentAlertDialog { get; set; }

    [CascadingParameter]
    private OverlayLabelContext? Context { get; set; }

    [CascadingParameter]
    private BradixDialog? BradixDialog { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildTriggerAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "alert-dialog-trigger";
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-state"] = ParentAlertDialog?.Visible == true ? "open" : "closed";
        attributes["aria-haspopup"] = "dialog";
        attributes["aria-expanded"] = ParentAlertDialog?.Visible == true ? "true" : "false";

        if (Disabled)
            attributes["disabled"] = QuarkAttributeValues.True;

        if (Context is not null)
            attributes["aria-controls"] = Context.ContentId;

    }

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        var attributes = _triggerAttributes.Create(BuildAttributes());

        attributes.Remove("type");
        attributes.Remove("id");
        attributes.Remove("data-state");
        attributes.Remove("aria-haspopup");
        attributes.Remove("aria-expanded");
        attributes.Remove("aria-controls");
        attributes.Remove("disabled");
        attributes.Remove("onclick");

        return attributes;
    }

    private string? _triggerContentId;
    private string? _overlayTriggerId;
    private string? GetOverlayTriggerId(OverlayLabelContext? context)
    {
        string? contentId = context?.ContentId;
        if (_triggerContentId != contentId)
        {
            _triggerContentId = contentId;
            _overlayTriggerId = contentId is null ? null : BlazorIdGenerator.Child(contentId, "trigger");
        }
        return _overlayTriggerId;
    }

    private (bool, AlertDialog?, bool, BradixDialog?, string?)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<PointerEventArgs, Task>? _contextOnPointerDownEventCallback;
    private Action<ElementReference>? _contextRegisterElementCallback;
    private Func<Task>? _contextToggleCallback;
    private Func<Task>? _contextOpenCallback;
    private Func<Task>? _contextCloseCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (Disabled, ParentAlertDialog, ParentAlertDialog?.Visible == true, BradixDialog, Context?.ContentId);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = null,
            TriggerId = GetOverlayTriggerId(Context),
            ParentDisabled = Disabled,
            IsOpen = ParentAlertDialog?.Visible == true,
            DataState = ParentAlertDialog?.Visible == true ? "open" : "closed",
            AriaHasPopup = "dialog",
            AriaControls = Context?.ContentId,
            OnPointerDownEvent = ParentAlertDialog is null || Disabled ? null : (_contextOnPointerDownEventCallback ??= HandleTriggerPointerDown),
            SuppressClickAfterPointerDown = true,
            RegisterElement = (_contextRegisterElementCallback ??= elementReference =>
            {
                if (BradixDialog is not null)
                    BradixDialog.RegisterTrigger(elementReference, GetOverlayTriggerId(Context));
            }),
            Toggle = ParentAlertDialog is null
                ? null
                : (_contextToggleCallback ??= async () =>
                {
                    if (ParentAlertDialog.Visible)
                        await ParentAlertDialog.Hide();
                    else
                        await ParentAlertDialog.Show();
                }),
            Open = ParentAlertDialog is null
                ? null
                : (_contextOpenCallback ??= async () =>
                {
                    await ParentAlertDialog.Show();
                }),
            Close = ParentAlertDialog is null ? null : (_contextCloseCallback ??= () => ParentAlertDialog.Hide())
        };
    }

    private Task HandleTriggerPointerDown(PointerEventArgs args)
    {
        if (ParentAlertDialog is null || Disabled || args.Button != 0 || args.CtrlKey)
            return Task.CompletedTask;

        return ParentAlertDialog.Visible ? ParentAlertDialog.Hide() : ParentAlertDialog.Show();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AsChild);
        hc.Add(Disabled);
        hc.Add(ParentAlertDialog?.Visible ?? false);
        hc.Add(Context?.ContentId);
    }
}
