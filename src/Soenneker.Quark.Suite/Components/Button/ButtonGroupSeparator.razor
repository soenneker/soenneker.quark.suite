@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixSeparator Orientation="@ResolvedOrientation"
                 Decorative="true"
                 AdditionalAttributes="@SeparatorAttributes" />

@code {
    private static readonly CssValue<SelfBuilder> _staticCss0 = Self.Stretch;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Utility("bg-input");
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private string? _lastPrependedClass;

    [Parameter]
    public SeparatorOrientation? Orientation { get; set; }

    private Orientation ResolvedOrientation
    {
        get
        {
            var effectiveOrientation = Orientation ?? SeparatorOrientation.Vertical;
            return effectiveOrientation == SeparatorOrientation.Horizontal ? Soenneker.Bradix.Orientation.Horizontal : Soenneker.Bradix.Orientation.Vertical;
        }
    }

    private IReadOnlyDictionary<string, object> SeparatorAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "button-group-separator";
        Position ??= _defaultPosition;
        SelfAlign ??= _staticCss0;
        BackgroundColor ??= _defaultBackgroundColor;
        Shrink ??= _defaultShrink;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "data-[orientation=horizontal]:mx-px data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-auto data-[orientation=vertical]:my-px data-[orientation=vertical]:h-auto data-[orientation=vertical]:w-px", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Orientation);
    }
}