@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits TriggerElement
@implements IButton
@inject NavigationManager Navigation
@inject ICollapseCoordinator CollapseCoordinator

@if (AsChild)
{
    <CascadingValue Name="@SlotAttributes.Name" Value="BuildSlotAttributes()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else if (RenderAsLink)
{
    <a href="@Href" @ref="_elementRef" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @onclick:preventDefault="PreventLinkDefault" @onclick:stopPropagation="StopClickPropagation" @onpointerdown="TriggerPointerDownCallback" @onpointerdown:preventDefault="PreventPointerDownDefault" @onkeydown="KeyDownCallback" @attributes="BuildAttributes()">
        @if (Loading)
        {
            <Spinner Size="_renderCss1" Margin="_renderCss2" Decorative="true" />
        }
        @if (LoadingTemplate is not null && Loading)
        {
            @LoadingTemplate
        }
        else
        {
            @RenderChildContent()
        }
    </a>
}
else
{
    <button @ref="_elementRef" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @onclick:stopPropagation="StopClickPropagation" @onpointerdown="TriggerPointerDownCallback" @onpointerdown:preventDefault="PreventPointerDownDefault" @onkeydown="KeyDownCallback" @attributes="BuildAttributes()">
        @if (Loading)
        {
            <Spinner Size="_renderCss1" Margin="_renderCss2" Decorative="true" />
        }
        @if (LoadingTemplate is not null && Loading)
        {
            @LoadingTemplate
        }
        else
        {
            @RenderChildContent()
        }
    </button>
}

@code {
    [Parameter]
    public Target? Target { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    [Parameter]
    public string? Download { get; set; }

    [Parameter]
    public string? HrefLang { get; set; }

    [Parameter]
    public string? ReferrerPolicy { get; set; }


    [Parameter]
    public string? FormAction { get; set; }

    [Parameter]
    public string? FormEncType { get; set; }

    [Parameter]
    public string? FormMethod { get; set; }

    [Parameter]
    public bool? FormNoValidate { get; set; }

    [Parameter]
    public string? FormTarget { get; set; }

    [Parameter]
    public string? PopoverTarget { get; set; }

    [Parameter]
    public string? PopoverTargetAction { get; set; }


    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        var effectiveSize = ButtonSize ?? ButtonGroup?.ButtonSize;
        var isLink = RenderAsLink;
        var isDisabled = Disabled || Loading || TriggerContext?.ParentDisabled == true || DialogCloseContext?.Disabled == true ||
            Attributes?.ContainsKey("disabled") == true || AdditionalAttributes?.ContainsKey("disabled") == true;
        AppendClass(ref cls, "group/button bg-clip-padding focus-visible:ring-3 active:not-aria-[haspopup]:translate-y-px");
        AppendClass(ref cls, GetButtonFocusClass(Variant));
        AppendClass(ref cls, "aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40");
        AppendClass(ref cls, "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4");
        AppendClass(ref cls, Variant?.Class ?? ButtonVariant.Default.Class);
        if (!InputGroupButton && effectiveSize is not null)
            AppendClass(ref cls, GetButtonSizeClass(effectiveSize));
        if (isLink && isDisabled)
            AppendClass(ref cls, "pointer-events-none opacity-50");
    }

    private static readonly CssValue<ButtonSizeBuilder> _staticCss1 = Quark.ButtonSize.Default;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<SizeBuilder> _renderCss1 = Quark.Size.Is4;
    private static readonly CssValue<MarginBuilder> _renderCss2 = Quark.Margin.FromRight.Is2;

    private Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    private EventCallback<PointerEventArgs> TriggerPointerDownCallback =>
        TriggerContext?.OnPointerDownEvent is not null || TriggerContext?.OnPointerDown is not null
            ? TriggerEvents.PointerDownCallback
            : default;

    private EventCallback<KeyboardEventArgs> KeyDownCallback =>
        TriggerContext?.OnKeyDown is not null || OnKeyDown.HasDelegate
            ? EventCallback.Factory.Create<KeyboardEventArgs>(this, _keyDownHandler ??= HandleKeyDown)
            : default;

    private Func<KeyboardEventArgs, Task>? _keyDownHandler;
    private TriggerEventReceiver? _triggerEvents;
    private TriggerEventReceiver TriggerEvents => _triggerEvents ??= new(this);

    private RenderFragment? _triggerChildContent;
    private RenderAttributeDictionary? _wrapperAttributes;

    [CascadingParameter]
    public IButtonGroup? ButtonGroup { get; set; }

    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? TriggerContext { get; set; }

    [CascadingParameter(Name = "BradixDialogCloseContext")]
    private BradixDialogCloseContext? DialogCloseContext { get; set; }

    private ElementReference _elementRef;
    private bool _triggerElementRegistered;
    private bool _ignoreNextKeyboardClick;
    private bool _ignoreNextPointerClick;
    private string? _registeredTriggerId;

    private bool RenderAsLink => string.Equals(Type?.Value, "link", StringComparison.Ordinal) || Href.HasContent();

    private bool PreventLinkDefault =>
        Disabled || Loading || CollapseTarget.HasContent() || TriggerContext?.Toggle is not null || DialogCloseContext is not null || (Href.HasContent() && !Href!.StartsWith("#", StringComparison.Ordinal));

    private bool StopClickPropagation => TriggerContext?.Toggle is not null || InputGroupButton;

    private bool PreventPointerDownDefault => TriggerContext?.PreventPointerDownDefault == true;

    private static readonly TriggerContext? NoTriggerContext = null;

    /// <summary>
    /// Gets or sets the size of the button (shadcn: default, xs, sm, lg, icon, icon-xs, icon-sm, icon-lg).
    /// </summary>
    [Parameter]
    public CssValue<ButtonSizeBuilder>? ButtonSize { get; set; } = _staticCss1;

    /// <summary>
    /// Gets or sets whether the button should span the full width of its container.
    /// </summary>
    [Parameter]
    public bool Block { get; set; }

    /// <summary>
    /// Gets or sets whether the child component should receive button styling directly.
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; }

    /// <summary>
    /// Gets or sets whether the button is in a loading state (opinionated extension with shadcn styling).
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool InputGroupButton { get; set; }

    /// <summary>
    /// Gets or sets the type of the button (button, submit, reset, or link).
    /// </summary>
    [Parameter]
    public ButtonType? Type { get; set; }

    /// <summary>
    /// Gets or sets the template to display When the button is in a loading state.
    /// </summary>
    [Parameter]
    public RenderFragment? LoadingTemplate { get; set; }

    /// <summary>
    /// Gets or sets the button value submitted with a form.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the button name submitted with a form.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Gets or sets the form ID that this button is associated with.
    /// </summary>
    [Parameter]
    public string? Form { get; set; }

    /// <summary>
    /// Gets or sets the navigation target URL When the button type is Link.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// Gets or sets the visual style variant (shadcn/ui).
    /// </summary>
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Default;

    /// <summary>
    /// Gets or sets one or more collapse targets (id, #id, .class, or space/comma-delimited list).
    /// </summary>
    [Parameter]
    public string? CollapseTarget { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        Type ??= ButtonType.Button;
        DataSlot ??= ResolveDataSlot() ?? "button";
        Display ??= _defaultDisplay;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Whitespace ??= _defaultWhitespace;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        Border ??= _defaultBorder;
        UserSelect ??= _defaultUserSelect;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;

        if (Block)
            Width ??= _defaultWidth;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (TriggerContext?.RegisterElement is not null && (!_triggerElementRegistered || !string.Equals(_registeredTriggerId, TriggerContext.TriggerId, StringComparison.Ordinal)))
        {
            TriggerContext.RegisterElement(_elementRef);
            _triggerElementRegistered = true;
            _registeredTriggerId = TriggerContext.TriggerId;
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// Builds the attributes dictionary for the button component.
    /// </summary>
    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes.Remove("onclick");
        attributes.Remove("onkeydown");
        attributes.Remove("onkeyup");

        var isLink = RenderAsLink;
        var isDisabled = Disabled || Loading || TriggerContext?.ParentDisabled == true || DialogCloseContext?.Disabled == true || attributes.ContainsKey("disabled");

        attributes["data-variant"] = Variant?.Value ?? ButtonVariant.Default.Value;

        var effectiveSize = ButtonSize ?? ButtonGroup?.ButtonSize;

        if (isLink)
        {
            attributes.Remove("autofocus");
            attributes.Remove("disabled");
        }

        if (isLink && isDisabled)
            attributes.TryAdd("tabindex", QuarkAttributeValues.MinusOne);



        if (Loading)
            attributes["aria-busy"] = "true";

        if (CollapseTarget.HasContent())
            attributes["aria-controls"] = CollapseTarget!;

        if (TriggerContext is not null)
        {
            if (TriggerContext.TriggerId is not null && !attributes.ContainsKey("id"))
                attributes["id"] = TriggerContext.TriggerId;

            if (TriggerContext.DataState is not null)
                attributes["data-state"] = TriggerContext.DataState;

            if (TriggerContext.AriaHasPopup is not null)
                attributes["aria-haspopup"] = TriggerContext.AriaHasPopup;

            if (TriggerContext.AriaControls is not null)
            {
                attributes["aria-expanded"] = TriggerContext.IsOpen ? "true" : "false";
                attributes["aria-controls"] = TriggerContext.AriaControls;
            }

            if (TriggerContext.AriaDescribedBy is not null)
                attributes["aria-describedby"] = TriggerContext.AriaDescribedBy;

            if (TriggerContext.ParentDisabled)
                attributes["data-disabled"] = "true";
        }

        if (DialogCloseContext is not null)
        {
            if (!string.IsNullOrWhiteSpace(DialogCloseContext.AriaLabel) && !attributes.ContainsKey("aria-label"))
                attributes["aria-label"] = DialogCloseContext.AriaLabel;

            if (DialogCloseContext.Disabled)
                attributes["data-disabled"] = string.Empty;
        }

        if (!isLink && Type is not null)
            attributes["type"] = Type.Value;

        if (isLink)
        {
            if (isDisabled)
                attributes["aria-disabled"] = "true";
        }
        else
        {
            if (isDisabled)
                attributes["disabled"] = QuarkAttributeValues.True;
        }

        if (!isLink)
        {
            if (Value.HasContent())
                attributes["value"] = Value!;
            if (Name.HasContent())
                attributes["name"] = Name!;
            if (Form.HasContent())
                attributes["form"] = Form!;
        }
    }

    private string? ResolveDataSlot()
    {
        return string.Equals(TriggerContext?.DataSlot, "tooltip-trigger", StringComparison.Ordinal) ? "button" : TriggerContext?.DataSlot;
    }

    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);
        if (RenderAsLink)
        {
            if (Target is not null)
                attributes["target"] = Target.Value;
            if (Rel is not null)
                attributes["rel"] = Rel;
            if (Download is not null)
                attributes["download"] = Download;
            if (HrefLang is not null)
                attributes["hreflang"] = HrefLang;
            if (ReferrerPolicy is not null)
                attributes["referrerpolicy"] = ReferrerPolicy;
        }

        if (!RenderAsLink)
        {
            if (FormAction is not null)
                attributes["formaction"] = FormAction;

            if (FormEncType is not null)
                attributes["formenctype"] = FormEncType;

            if (FormMethod is not null)
                attributes["formmethod"] = FormMethod;

            if (FormNoValidate.HasValue)
                attributes["formnovalidate"] = FormNoValidate.Value ? QuarkAttributeValues.True : false;

            if (FormTarget is not null)
                attributes["formtarget"] = FormTarget;

            if (PopoverTarget is not null)
                attributes["popovertarget"] = PopoverTarget;

            if (PopoverTargetAction is not null)
                attributes["popovertargetaction"] = PopoverTargetAction;

        }


        if (TriggerContext?.OnMouseEnter is not null)
            attributes["onmouseenter"] = TriggerEvents.MouseEnterCallback;

        if (TriggerContext?.OnMouseMove is not null)
            attributes["onmousemove"] = TriggerEvents.MouseMoveCallback;

        if (TriggerContext?.OnMouseLeave is not null)
            attributes["onmouseleave"] = TriggerEvents.MouseLeaveCallback;

        if (TriggerContext?.OnPointerMove is not null)
            attributes["onpointermove"] = TriggerEvents.PointerMoveCallback;

        if (TriggerContext?.OnPointerLeave is not null)
            attributes["onpointerleave"] = TriggerEvents.PointerLeaveCallback;

        if (TriggerContext?.OnPointerUp is not null)
            attributes["onpointerup"] = TriggerEvents.PointerUpCallback;

        if (TriggerContext?.OnFocusIn is not null)
            attributes["onfocusin"] = TriggerEvents.FocusInCallback;

        if (TriggerContext?.OnFocusOut is not null)
            attributes["onfocusout"] = TriggerEvents.FocusOutCallback;
    }

    private IReadOnlyDictionary<string, object> BuildSlotAttributes()
    {
        var attributes = (_wrapperAttributes ??= new()).Create(BuildAttributes(), 0);

        attributes.Remove("type");
        attributes.Remove("disabled");
        attributes.Remove("form");
        attributes.Remove("name");
        attributes.Remove("value");

        return attributes;
    }

    private RenderFragment? RenderChildContent()
    {
        if (TriggerContext is null || ChildContent is null)
            return ChildContent;

        return _triggerChildContent ??= @<CascadingValue Name="TriggerContext" Value="@NoTriggerContext" IsFixed="true">
                   @ChildContent
               </CascadingValue>;
    }

    protected override async Task HandleClick(MouseEventArgs args)
    {
        var isDisabled = Disabled || Loading || TriggerContext?.ParentDisabled == true || DialogCloseContext?.Disabled == true || (Attributes is not null && Attributes.ContainsKey("disabled"));
        if (isDisabled)
            return;

        if (_ignoreNextKeyboardClick)
        {
            _ignoreNextKeyboardClick = false;
            return;
        }

        var ignoreTriggerClick = false;

        if (_ignoreNextPointerClick)
        {
            _ignoreNextPointerClick = false;
            ignoreTriggerClick = true;
        }

        if (!ignoreTriggerClick)
        {
            if (TriggerContext?.OnClick is not null)
                await TriggerContext.OnClick();

            if (TriggerContext?.Toggle is not null)
                await TriggerContext.Toggle();
        }

        if (DialogCloseContext is not null)
            await DialogCloseContext.Close(args);

        if (Href.HasContent() && !Href!.StartsWith("#"))
            Navigation.NavigateTo(Href!);

        if (CollapseTarget.HasContent())
            await CollapseCoordinator.ToggleTargets(CollapseTarget);
        else if (Attributes is not null && Attributes.TryGetValue("data-toggle", out var dataToggleObj) && string.Equals(dataToggleObj?.ToString(), "collapse", StringComparison.OrdinalIgnoreCase) && Attributes.TryGetValue("data-target", out var dataTargetObj))
            await CollapseCoordinator.ToggleTargets(dataTargetObj?.ToString());

        await InvokeCapturedClick(args);

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }

    private async Task InvokeCapturedClick(MouseEventArgs args)
    {
        object? callback = null;

        if (AdditionalAttributes is not null)
            callback = GetAttribute(AdditionalAttributes, "onclick");

        if (callback is null && Attributes is not null)
            callback = GetAttribute(Attributes, "onclick");

        if (callback is null)
            return;

        switch (callback)
        {
            case EventCallback<MouseEventArgs> eventCallback when eventCallback.HasDelegate:
                await eventCallback.InvokeAsync(args);
                break;
            case EventCallback eventCallback when eventCallback.HasDelegate:
                await eventCallback.InvokeAsync(args);
                break;
            case Func<MouseEventArgs, Task> func:
                await func(args);
                break;
            case Func<Task> func:
                await func();
                break;
            case Action<MouseEventArgs> action:
                action(args);
                break;
            case Action action:
                action();
                break;
        }
    }

    private static object? GetAttribute(IReadOnlyDictionary<string, object> attributes, string name)
    {
        if (attributes.TryGetValue(name, out var value))
            return value;

        foreach ((var key, var candidate) in attributes)
        {
            if (string.Equals(key, name, StringComparison.OrdinalIgnoreCase))
                return candidate;
        }

        return null;
    }

    private Task HandleTriggerMouseEnter(MouseEventArgs args)
    {
        return TriggerContext?.OnMouseEnter?.Invoke() ?? Task.CompletedTask;
    }

    private Task HandleTriggerPointerMove(PointerEventArgs args)
    {
        return TriggerContext?.OnPointerMove?.Invoke() ?? Task.CompletedTask;
    }

    private Task HandleTriggerMouseMove(MouseEventArgs args)
    {
        return TriggerContext?.OnMouseMove?.Invoke() ?? Task.CompletedTask;
    }

    private Task HandleTriggerMouseLeave(MouseEventArgs args)
    {
        return TriggerContext?.OnMouseLeave?.Invoke() ?? Task.CompletedTask;
    }

    private Task HandleTriggerPointerLeave(PointerEventArgs args)
    {
        return TriggerContext?.OnPointerLeave?.Invoke() ?? Task.CompletedTask;
    }

    private Task HandleTriggerPointerDown(PointerEventArgs args)
    {
        if (TriggerContext?.OnPointerDownEvent is not null)
        {
            if (TriggerContext.SuppressClickAfterPointerDown && args.Button == 0 && !args.CtrlKey)
                _ignoreNextPointerClick = true;

            return TriggerContext.OnPointerDownEvent(args);
        }

        if (TriggerContext?.OnPointerDown is not null)
        {
            if (TriggerContext.SuppressClickAfterPointerDown && args.Button == 0 && !args.CtrlKey)
                _ignoreNextPointerClick = true;

            return TriggerContext.OnPointerDown();
        }

        return Task.CompletedTask;
    }

    private Task HandleTriggerPointerUp(PointerEventArgs args)
    {
        return TriggerContext?.OnPointerUp?.Invoke() ?? Task.CompletedTask;
    }

    private Task HandleTriggerFocusIn(FocusEventArgs args)
    {
        return TriggerContext?.OnFocusIn?.Invoke() ?? Task.CompletedTask;
    }

    private Task HandleTriggerFocusOut(FocusEventArgs args)
    {
        return TriggerContext?.OnFocusOut?.Invoke() ?? Task.CompletedTask;
    }

    protected override async Task HandleKeyDown(KeyboardEventArgs args)
    {
        await base.HandleKeyDown(args);

        if (TriggerContext?.OnKeyDown is not null)
        {
            // Tooltips close on activation but still allow the button's native keyboard click.
            if (TriggerContext.DataSlot != "tooltip-trigger" && args.Key is ("ArrowDown" or "Enter" or " " or "Space" or "Spacebar"))
                _ignoreNextKeyboardClick = true;

            await TriggerContext.OnKeyDown(args);
        }
    }


    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Target);
        hc.Add(Rel);
        hc.Add(Download);
        hc.Add(HrefLang);
        hc.Add(ReferrerPolicy);

        hc.Add(FormAction);
        hc.Add(FormEncType);
        hc.Add(FormMethod);
        hc.Add(FormNoValidate);
        hc.Add(FormTarget);
        hc.Add(PopoverTarget);
        hc.Add(PopoverTargetAction);

        hc.Add(ButtonSize);
        hc.Add(Disabled);
        hc.Add(Block);
        hc.Add(AsChild);
        hc.Add(Loading);
        hc.Add(Type);
        hc.Add(LoadingTemplate);
        hc.Add(Value);
        hc.Add(Form);
        hc.Add(AutoFocus);
        hc.Add(Href);
        hc.Add(Name);
        hc.Add(Variant);
        hc.Add(CollapseTarget);
        hc.Add(TriggerContext?.DataSlot);
        hc.Add(TriggerContext?.TriggerId);
        hc.Add(TriggerContext?.AriaControls);
        hc.Add(TriggerContext?.AriaDescribedBy);
        hc.Add(TriggerContext?.IsOpen);
        hc.Add(TriggerContext?.SuppressClickAfterPointerDown == true);
        hc.Add(TriggerContext?.ParentDisabled == true);
        hc.Add(DialogCloseContext?.Disabled == true);
        hc.Add(DialogCloseContext?.AriaLabel);
    }

    internal static string GetButtonSizeClass(CssValue<ButtonSizeBuilder>? size) => size?.ToString() ?? ButtonSizeEnum.Default.Class;

    internal static string GetButtonFocusClass(ButtonVariant? variant)
    {
        if (ReferenceEquals(variant, ButtonVariant.Destructive))
            return string.Empty;

        return "focus-visible:border-ring focus-visible:ring-ring/50";
    }

    internal static string GetInputGroupButtonSizeClass(CssValue<ButtonSizeBuilder>? size)
    {
        var value = size?.ToString();

        if (value == "default")
            return "h-8 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2";

        if (value == "xs")
            return "h-6 gap-1 rounded-[calc(var(--radius)-3px)] px-1.5 [&>svg:not([class*='size-'])]:size-3.5";

        if (value == "icon-xs")
            return "size-6 rounded-[calc(var(--radius)-3px)] p-0 has-[>svg]:p-0";

        if (value == "icon-sm")
            return "size-8 p-0 has-[>svg]:p-0";

        return value ?? string.Empty;
    }

}
