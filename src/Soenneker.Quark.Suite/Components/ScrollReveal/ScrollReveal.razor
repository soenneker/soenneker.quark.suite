@inject Soenneker.Blazor.Utils.ResourceLoader.Abstract.IResourceLoader ResourceLoader
@namespace Soenneker.Quark
@using System.Globalization
@using Microsoft.JSInterop
@using Soenneker.Asyncs.Locks
@using Soenneker.Atomics.ValueBools
@inherits Soenneker.Quark.Element
@implements IAsyncDisposable
@inject IScrollRevealInterop ScrollRevealInterop



<div @ref="_element" @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private (int Duration, int Delay, long Blur, long Distance, string Easing, ScrollRevealDirection Direction)? _styleKey;
    private string? _revealStyle;

    private string? _lastBuiltStyle;

    private ElementReference _element;
    private readonly AsyncLock _interopLock = new();
    private bool _initialized;
    private ValueAtomicBool _disposed = new(false);
    private int _configurationHash;

    /// <summary>
    /// Gets or sets the direction content travels from.
    /// </summary>
    [Parameter]
    public ScrollRevealDirection Direction { get; set; } = ScrollRevealDirection.Up;

    /// <summary>
    /// Gets or sets the starting offset in pixels.
    /// </summary>
    [Parameter]
    public double Distance { get; set; } = 24;

    /// <summary>
    /// Gets or sets the reveal duration in milliseconds.
    /// </summary>
    [Parameter]
    public int RevealDuration { get; set; } = 600;

    /// <summary>
    /// Gets or sets the delay before the reveal begins, in milliseconds.
    /// </summary>
    [Parameter]
    public int Delay { get; set; }

    /// <summary>
    /// Gets or sets the starting blur radius in pixels.
    /// </summary>
    [Parameter]
    public double BlurRadius { get; set; }

    /// <summary>
    /// Gets or sets the CSS easing function used by the transition.
    /// </summary>
    [Parameter]
    public string Easing { get; set; } = "cubic-bezier(0.22, 1, 0.36, 1)";

    /// <summary>
    /// Gets or sets the visible proportion required to trigger the reveal.
    /// </summary>
    [Parameter]
    public double Threshold { get; set; } = 0.15;

    /// <summary>
    /// Gets or sets the IntersectionObserver root margin.
    /// </summary>
    [Parameter]
    public string RootMargin { get; set; } = "0px 0px -10% 0px";

    /// <summary>
    /// Gets or sets whether the reveal only runs once.
    /// </summary>
    [Parameter]
    public bool Once { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the reveal behavior is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ResourceLoader.LoadStyle(QuarkAssetPath.Css("_content/Soenneker.Quark.Suite/css/scrollreveal.css", QuarkOptions));
        var configurationHash = GetConfigurationHash();

        if (firstRender || configurationHash != _configurationHash)
        {
            using (await _interopLock.Lock())
            {
                if (!_disposed.Value)
                {
                    await ScrollRevealInterop.Initialize(_element, new ScrollRevealInteropOptions
                    {
                        Threshold = Math.Clamp(Threshold, 0, 1),
                        RootMargin = RootMargin,
                        Once = Once,
                        Disabled = Disabled
                    });

                    _configurationHash = configurationHash;
                    _initialized = true;
                }
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "scroll-reveal";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-direction"] = GetDirectionValue(Direction);

        var duration = Math.Max(RevealDuration, 0);
        var delay = Math.Max(Delay, 0);
        var blur = Math.Max(BlurRadius, 0);
        var distance = Math.Max(Distance, 0);
        var key = (duration, delay, BitConverter.DoubleToInt64Bits(blur), BitConverter.DoubleToInt64Bits(distance), Easing, Direction);
        if (_revealStyle is null || _styleKey != key)
        {
            _revealStyle = string.Create(CultureInfo.InvariantCulture,
                $"--scroll-reveal-duration:{duration}ms; --scroll-reveal-delay:{delay}ms; --scroll-reveal-blur:{blur:0.###}px; --scroll-reveal-easing:{Easing}; --scroll-reveal-transform:{GetInitialTransform()}");
            _styleKey = key;
        }
        PrependStyleAttribute(attributes, _revealStyle, ref _lastBuiltStyle);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Direction);
        hc.Add(Distance);
        hc.Add(RevealDuration);
        hc.Add(Delay);
        hc.Add(BlurRadius);
        hc.Add(Easing);
        hc.Add(Threshold);
        hc.Add(RootMargin);
        hc.Add(Once);
        hc.Add(Disabled);
    }

    private int GetConfigurationHash()
    {
        var hc = new HashCode();
        hc.Add(Threshold);
        hc.Add(RootMargin);
        hc.Add(Once);
        hc.Add(Disabled);
        return hc.ToHashCode();
    }

    private string GetInitialTransform()
    {
        var distance = Format(Math.Max(Distance, 0));

        return Direction switch
        {
            ScrollRevealDirection.Up => $"translate3d(0, {distance}px, 0)",
            ScrollRevealDirection.Down => $"translate3d(0, -{distance}px, 0)",
            ScrollRevealDirection.Left => $"translate3d({distance}px, 0, 0)",
            ScrollRevealDirection.Right => $"translate3d(-{distance}px, 0, 0)",
            _ => "none"
        };
    }

    private static string GetDirectionValue(ScrollRevealDirection direction) => direction switch
    {
        ScrollRevealDirection.Up => "up",
        ScrollRevealDirection.Down => "down",
        ScrollRevealDirection.Left => "left",
        ScrollRevealDirection.Right => "right",
        ScrollRevealDirection.None => "none",
        _ => direction.ToString().ToLowerInvariant()
    };

    private static string Format(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;

        try
        {
            using (await _interopLock.Lock())
            {
                if (_initialized)
                {
                    await ScrollRevealInterop.Destroy(_element);
                    _initialized = false;
                }
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }

        finally
        {
            await base.DisposeAsync();
        }
    }
}
