@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark

@inherits Soenneker.Quark.Element
@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Blazor.Utils.Ids
@implements ICollapse
@inject ICollapseCoordinator CollapseCoordinator

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private string? _lastBuiltClass;

    private ValueAtomicBool _disposed;
    /// <summary>
    /// Gets or sets whether the collapse is expanded.
    /// </summary>
    [Parameter]
    public bool Expanded { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the expanded state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnExpandedChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the collapse should expand horizontally.
    /// </summary>
    [Parameter]
    public bool Horizontal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (Id.IsNullOrEmpty())
            Id = BlazorIdGenerator.New("quark-collapse");

        if (_disposed.Read())
            return;

        await CollapseCoordinator.Register(this);
        if (_disposed.Read())
            await CollapseCoordinator.Unregister(this);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "collapse";
        Overflow ??= _defaultOverflow;
        Transition ??= _defaultTransition;

    }

    public Task Toggle()
    {
        Expanded = !Expanded;

        Refresh();

        return OnExpandedChanged.InvokeIfHasDelegate(Expanded);
    }

    public Task Show()
    {
        if (Expanded)
            return Task.CompletedTask;

        Expanded = true;

        Refresh();

        return OnExpandedChanged.InvokeIfHasDelegate(Expanded);

    }

    public Task Hide()
    {
        if (!Expanded)
            return Task.CompletedTask;

        Expanded = false;

        Refresh();

        return OnExpandedChanged.InvokeIfHasDelegate(Expanded);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, Expanded ? "duration-200 ease-in-out"
            : Horizontal ? "duration-200 ease-in-out max-w-0" : "duration-200 ease-in-out max-h-0", ref _lastBuiltClass);

        attributes["id"] = Id!;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Expanded);
        hc.Add(Horizontal);
        hc.Add(Id);
    }

    internal bool HasCssClass(ReadOnlySpan<char> className)
    {
        if (className.IsEmpty)
            return false;

        if (ClassContainsToken(Class, className))
            return true;

        if (Attributes is not null && Attributes.TryGetValue("class", out var classObj))
            return ClassContainsToken(classObj?.ToString(), className);

        return false;
    }

    private static bool ClassContainsToken(string? classes, ReadOnlySpan<char> token)
    {
        if (classes.IsNullOrWhiteSpace())
            return false;

        var remaining = classes.AsSpan();
        var target = token;

        while (!remaining.IsEmpty)
        {
            remaining = remaining.TrimStart();

            var separator = remaining.IndexOfAny(" \t\r\n".AsSpan());
            var value = separator < 0 ? remaining : remaining[..separator];

            if (value.SequenceEqual(target))
                return true;

            if (separator < 0)
                break;

            remaining = remaining[(separator + 1)..];
        }

        return false;
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            await CollapseCoordinator.Unregister(this);
        }
        finally
        {
            await base.DisposeAsync();
        }
    }
}
