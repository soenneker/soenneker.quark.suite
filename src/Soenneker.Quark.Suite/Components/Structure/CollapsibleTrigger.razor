@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.Element

@if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <BradixCollapsibleTrigger Disabled="@Disabled"
                              OnClick="@OnClick"
                              AdditionalAttributes="@TriggerAttributes">
        @ChildContent
    </BradixCollapsibleTrigger>
}

@code {
    private string? _slotClass;
    private string? _slotStyle;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "collapsible-trigger";
    }

    [Parameter]
    public bool AsChild { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [CascadingParameter]
    private BradixCollapsible? Collapsible { get; set; }

    [CascadingParameter(Name = SlotAttributes.Name)]
    private IReadOnlyDictionary<string, object>? SlotAttributeOverrides { get; set; }

    private (BradixCollapsible?, bool, bool, string?, string?)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<Task>? _contextToggleCallback;
    private Func<Task>? _contextOpenCallback;
    private Func<Task>? _contextCloseCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (Collapsible, Collapsible?.Disabled == true, Collapsible?.IsOpen == true, Collapsible?.TriggerId, Collapsible?.ContentId);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = "collapsible-trigger",
            TriggerId = Collapsible?.TriggerId,
            ParentDisabled = Collapsible?.Disabled == true,
            IsOpen = Collapsible?.IsOpen == true,
            DataState = Collapsible?.IsOpen == true ? "open" : "closed",
            AriaControls = Collapsible?.ContentId,
            Toggle = Collapsible is null ? null : (_contextToggleCallback ??= () => Collapsible.Toggle()),
            Open = Collapsible is null ? null : (_contextOpenCallback ??= () => Collapsible.SetOpen(true)),
            Close = Collapsible is null ? null : (_contextCloseCallback ??= () => Collapsible.SetOpen(false))
        };
    }

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildAttributes();

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (AsChild && Collapsible is not null)
        {
            attributes["data-state"] = Collapsible.IsOpen ? "open" : "closed";
            attributes["aria-expanded"] = Collapsible.IsOpen ? "true" : "false";
            attributes["id"] = Collapsible.TriggerId;
            attributes["aria-controls"] = Collapsible.ContentId;
        }

        if (AsChild && (Disabled || Collapsible?.Disabled == true))
        {
            attributes["data-disabled"] = "true";
        }

        if (AsChild)
            SlotAttributes.MergeInto(attributes, SlotAttributeOverrides, ref _slotClass, ref _slotStyle);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Disabled);
        hc.Add(AsChild);
        hc.Add(OnClick.HasDelegate);
        hc.Add(Collapsible?.IsOpen == true);
        hc.Add(Collapsible?.Disabled == true);
        hc.Add(Collapsible?.TriggerId);
        hc.Add(SlotAttributeOverrides?.Count ?? 0);
    }
}