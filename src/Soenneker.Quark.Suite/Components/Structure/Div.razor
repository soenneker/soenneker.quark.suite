@namespace Soenneker.Quark
@inherits Soenneker.Quark.InteractiveElement
@implements IDiv

<div @ref="ElementRef" @attributes="BuildAttributes()">
	@ChildContent
</div>

@code {
    protected override bool IndependentChildContent => GetType() == typeof(Div) && Preset is null && Presets is null;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "div";
    }

    protected override void BuildOwnedAttributes(Dictionary<string, object> attrs)
    {
        base.BuildOwnedAttributes(attrs);

        if (OnClick.HasDelegate)
            SetEventAttribute(attrs, "onclick", OnClick);
    }
}
