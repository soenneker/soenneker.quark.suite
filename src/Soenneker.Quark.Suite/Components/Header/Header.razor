@namespace Soenneker.Quark.Header
@using Soenneker.Quark.Dtos
@inherits Soenneker.Quark.Element

<header @attributes="BuildAttributes()">
    <Div Presets="@ContainerPresets" Class="@ContainerClassValue">
        <Div Display="_renderCss0" MinHeight='_renderCss1' Height='_renderCss2' ItemsAlign="_staticCss0" Class="@InnerClassValue">
            @if (ShowSidebarTrigger)
            {
                <button type="button"
                        data-slot="sidebar-trigger"
                        data-variant="ghost"
                        data-size="default"
                        aria-label="@SidebarTriggerLabel"
                        aria-haspopup="dialog"
                        aria-expanded="@(SidebarIsExpanded ? "true" : "false")"
                        aria-controls="@ResolvedSidebarTriggerControls"
                        data-state="@(SidebarIsExpanded ? "open" : "closed")"
                        class="@SidebarTriggerClass"
                        @onclick="(_cachedHandleSidebarTriggerClickDelegate ??= HandleSidebarTriggerClick)">
                    @if (SidebarIsExpanded && SidebarTriggerOpenContent is not null)
                    {
                        @SidebarTriggerOpenContent
                    }
                    else if (SidebarTriggerClosedContent is not null)
                    {
                        @SidebarTriggerClosedContent
                    }
                    else
                    {
                        <Div Position="_renderCss3" Display="_renderCss0" Height="_renderCss4" Width="_renderCss5" ItemsAlign="_staticCss0" Justify="_renderCss6">
                            <Div Position="_renderCss3" Size="_renderCss7">
                                <Span Position="_renderCss8" Display="_renderCss9" Height='_renderCss10' Width="_renderCss5" BackgroundColor='_renderCss11' Transition="_renderCss12" Left="_renderCss13" Duration="_renderCss14" Class="ease-in-out" style="@FirstSidebarTriggerLineStyle"></Span>
                                <Span Position="_renderCss8" Display="_renderCss9" Height='_renderCss10' Width="_renderCss5" BackgroundColor='_renderCss11' Transition="_renderCss12" Left="_renderCss13" Duration="_renderCss14" Class="ease-in-out" style="@SecondSidebarTriggerLineStyle"></Span>
                            </Div>
                            <Span ScreenReader="_renderCss15">@SidebarTriggerLabel</Span>
                        </Div>
                    }

                    <Span Display="_renderCss0" Height="_renderCss4" ItemsAlign="_staticCss0" TextSize="_renderCss16" Leading="_renderCss17" FontWeight="_renderCss18">@SidebarTriggerText</Span>
                </button>
            }

            @if (BrandContent is not null)
            {
                @BrandContent
            }

            @if (NavigationContent is not null)
            {
                <nav class="@NavigationClassValue">
                    @NavigationContent
                </nav>
            }

            @if (ActionsContent is not null)
            {
                <Div Class="@ActionsClassValue">
                    @ActionsContent
                </Div>
            }
        </Div>
    </Div>
</header>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.Flex;
    private static readonly CssValue<MinHeightBuilder> _renderCss1 = Quark.MinHeight.Token("12");
    private static readonly CssValue<HeightBuilder> _renderCss2 = Quark.Height.Token("(--header-height)");
    private static readonly CssValue<PositionBuilder> _renderCss3 = Quark.Position.Relative;
    private static readonly CssValue<HeightBuilder> _renderCss4 = Quark.Height.Is8;
    private static readonly CssValue<WidthBuilder> _renderCss5 = Quark.Width.Is4;
    private static readonly CssValue<JustifyBuilder> _renderCss6 = Quark.Justify.Center;
    private static readonly CssValue<SizeBuilder> _renderCss7 = Quark.Size.Is4;
    private static readonly CssValue<PositionBuilder> _renderCss8 = Quark.Position.Absolute;
    private static readonly CssValue<DisplayBuilder> _renderCss9 = Quark.Display.Block;
    private static readonly CssValue<HeightBuilder> _renderCss10 = Quark.Height.Is0_5;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss11 = Quark.BackgroundColor.Foreground;
    private static readonly CssValue<TransitionBuilder> _renderCss12 = Quark.Transition.All;
    private static readonly CssValue<LeftBuilder> _renderCss13 = Quark.Left.Is0;
    private static readonly CssValue<DurationBuilder> _renderCss14 = Quark.Duration.Is200;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss15 = Quark.ScreenReader.Only;
    private static readonly CssValue<TextSizeBuilder> _renderCss16 = Quark.TextSize.Lg;
    private static readonly CssValue<LeadingBuilder> _renderCss17 = Quark.Leading.None;
    private static readonly CssValue<FontWeightBuilder> _renderCss18 = Quark.FontWeight.Medium;
    private string? _lastPrependedClass;

    private Func<Task>? _cachedHandleSidebarTriggerClickDelegate;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "header";
    }

    private static readonly IReadOnlyList<QuarkPresetToken> DefaultContainerPresets = [QuarkPresets.ContainerWrapper];

    [CascadingParameter(Name = "SidebarProvider")]
    public SidebarProvider? SidebarProvider { get; set; }

    [CascadingParameter(Name = "SidebarContextState")]
    public SidebarContextState? SidebarState { get; set; }

    [Parameter]
    public bool ShowSidebarTrigger { get; set; }

    [Parameter]
    public string SidebarTriggerLabel { get; set; } = "Toggle Menu";

    [Parameter]
    public string SidebarTriggerText { get; set; } = "Menu";

    [Parameter]
    public string? SidebarTriggerControls { get; set; }

    [Parameter]
    public IReadOnlyList<QuarkPresetToken>? ContainerPresets { get; set; } = DefaultContainerPresets;

    [Parameter]
    public string ContainerClass { get; set; } = "px-6 group-has-data-[slot=designer]/layout:max-w-none 3xl:fixed:px-0";

    [Parameter]
    public string InnerClass { get; set; } = "**:data-[slot=separator]:h-4! group-has-data-[slot=designer]/layout:fixed:max-w-none 3xl:fixed:container";

    [Parameter]
    public string SidebarTriggerClass { get; set; } = "pointer-events-auto shrink-0 cursor-pointer rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:text-accent-foreground px-4 py-2 has-[>svg]:px-3 extend-touch-target h-8 touch-manipulation items-center justify-start gap-2.5 p-0! hover:bg-transparent focus-visible:bg-transparent focus-visible:ring-0 active:bg-transparent dark:hover:bg-transparent flex lg:hidden";

    [Parameter]
    public string NavigationClass { get; set; } = "hidden items-center gap-0 lg:flex";

    [Parameter]
    public string ActionsClass { get; set; } = "ml-auto flex items-center gap-2 md:flex-1 md:justify-end";

    [Parameter]
    public RenderFragment? BrandContent { get; set; }

    [Parameter]
    public RenderFragment? NavigationContent { get; set; }

    [Parameter]
    public RenderFragment? ActionsContent { get; set; }

    [Parameter]
    public RenderFragment? SidebarTriggerOpenContent { get; set; }

    [Parameter]
    public RenderFragment? SidebarTriggerClosedContent { get; set; }

    private string ContainerClassValue => ContainerClass;
    private string InnerClassValue => InnerClass;
    private string NavigationClassValue => NavigationClass;
    private string ActionsClassValue => ActionsClass;
    private bool SidebarIsExpanded => SidebarState?.OpenMobile == true;
    private string? ResolvedSidebarTriggerControls => SidebarTriggerControls.HasContent() ? SidebarTriggerControls : SidebarProvider?.MobileContentId;
    private string FirstSidebarTriggerLineStyle => SidebarIsExpanded ? "top: 7px; transform: rotate(45deg);" : "top: 4px; transform: rotate(0deg);";
    private string SecondSidebarTriggerLineStyle => SidebarIsExpanded ? "top: 7px; transform: rotate(-45deg);" : "top: 10px; transform: rotate(0deg);";

    private Task HandleSidebarTriggerClick() =>
        SidebarProvider?.SetOpenMobile(SidebarState?.OpenMobile != true) ?? Task.CompletedTask;

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "pointer-events-auto sticky top-0 z-50 w-full bg-background", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShowSidebarTrigger);
        hc.Add(SidebarTriggerLabel);
        hc.Add(SidebarTriggerText);
        hc.Add(SidebarTriggerControls);
        hc.Add(SidebarIsExpanded);
        if (ContainerPresets is { Count: > 0 })
        {
            for (var i = 0; i < ContainerPresets.Count; i++)
            {
                hc.Add(ContainerPresets[i]);
            }
        }
        hc.Add(ContainerClass);
        hc.Add(InnerClass);
        hc.Add(SidebarTriggerClass);
        hc.Add(NavigationClass);
        hc.Add(ActionsClass);
        hc.Add(BrandContent is not null);
        hc.Add(NavigationContent is not null);
        hc.Add(ActionsContent is not null);
        hc.Add(SidebarTriggerOpenContent is not null);
        hc.Add(SidebarTriggerClosedContent is not null);
    }
}
