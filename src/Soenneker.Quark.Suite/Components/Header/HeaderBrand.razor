        data-variant="ghost"
        data-size="icon"
        Display="_staticCss13"
        Size="_renderCss0"
        Shrink="_staticCss12"
        ItemsAlign="_staticCss11"
        Justify="_staticCss10"
        Rounded="_staticCss9"
        Border="_staticCss8"
        BorderColor="_staticCss7"
        TextSize="_staticCss6"
        FontWeight="_staticCss5"
        Whitespace="_staticCss4"
        Transition="_staticCss3"
        OutlineStyle="_staticCss2"
        UserSelect="_staticCss1"
