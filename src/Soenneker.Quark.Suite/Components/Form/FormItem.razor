@namespace Soenneker.Quark.Forms
@inherits Soenneker.Quark.Element

<CascadingValue Name="ParentFormItem" Value="@this" IsFixed="true">
    <CascadingValue Value="_fieldContext" IsFixed="false">
        <CascadingValue Name="FormHorizontal" Value="Horizontal" IsFixed="true">
            <div @attributes="BuildAttributes()">
                @ChildContent
            </div>
        </CascadingValue>
    </CascadingValue>
</CascadingValue>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Grid;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private string? _lastBuiltClass;

    [Parameter]
    public bool Horizontal { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IsInvalid { get; set; }

    private readonly FieldContext _fieldContext = new();

    protected override void OnInitialized()
    {
        _fieldContext.StateChanged += OnFieldContextStateChanged;
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        _fieldContext.Update(Horizontal, IsInvalid);
        base.OnParametersSet();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "form-item";

        Display ??= _defaultDisplay;
        Gap ??= _defaultGap;

        if (Horizontal)
        {
            ItemsAlign ??= _staticCss0;
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (Disabled)
        {
            attributes["data-disabled"] = "true";
            attributes["aria-disabled"] = "true";
        }

        if (Horizontal)
        {
            const string @class = "grid-cols-[auto_1fr]" + " " + "*:data-[slot=form-label]:flex-auto" + " " + "has-[>[data-slot=form-control]]:items-start has-[>[data-slot=form-control]]:[&>[role=checkbox],[role=radio]]:mt-px";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Horizontal);
        hc.Add(Disabled);
        hc.Add(IsInvalid);
        hc.Add(_fieldContext.IsInvalid);
    }

    private void OnFieldContextStateChanged()
    {
        _ = RefreshOffThread();
    }

    public override async ValueTask DisposeAsync()
    {
        _fieldContext.StateChanged -= OnFieldContextStateChanged;
        await base.DisposeAsync();
    }
}