@namespace Soenneker.Quark.Forms
@inherits Soenneker.Quark.TypographyElement

<label @attributes="BuildAttributes()">
    @ChildContent
    @if (RequiredIndicator)
    {
        <Span TextColor="_renderCss0">*</Span>
    }
</label>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFit;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.None;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.OnPeerDisabled.Is50;
    private static readonly CssValue<TextColorBuilder> _renderCss0 = Quark.TextColor.Destructive;
    private string? _lastPrependedClass;

    [Parameter]
    public string? For { get; set; }

    [Parameter]
    public bool RequiredIndicator { get; set; }

    [CascadingParameter(Name = "FormHorizontal")]
    protected bool FormHorizontal { get; set; }

    [CascadingParameter]
    private FieldContext? FieldContext { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "form-label";

        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        Gap ??= _defaultGap;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Leading ??= _defaultLeading;
        UserSelect ??= _defaultUserSelect;
        Opacity ??= _defaultOpacity;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-error"] = FieldContext?.IsInvalid == true ? "true" : "false";

        PrependClassAttribute(attributes, "data-[error=true]:text-destructive group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed", ref _lastPrependedClass);

        if (For.HasContent())
            attributes["for"] = For!;
        else if (FieldContext is not null)
            attributes["for"] = FieldContext.ControlId;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(For);
        hc.Add(RequiredIndicator);
        hc.Add(FormHorizontal);
        hc.Add(FieldContext?.ControlId);
        hc.Add(FieldContext?.IsInvalid);
    }
}