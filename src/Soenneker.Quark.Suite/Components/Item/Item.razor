@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IItem

@if (AsChild)
{
    <CascadingValue Name="@SlotAttributes.Name" Value="BuildSlotAttributes()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <div @attributes="BuildAttributes()">@ChildContent</div>
}

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<FlexWrapBuilder> _defaultFlexWrap = Quark.FlexWrap.Wrap;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor2 = Quark.BorderColor.Border.OnFocusVisible.Ring;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor2 = Quark.BackgroundColor.Token("muted/50");
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Transparent.OnFocusVisible.Ring;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private string? _lastBuiltClass;

    [Parameter]
    public ItemVariant Variant { get; set; } = ItemVariant.Default;

    [Parameter]
    public ItemSize ItemSize { get; set; } = ItemSize.Default;

    [Parameter]
    public bool AsChild { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "item";
        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        FlexWrap ??= _defaultFlexWrap;
        ItemsAlign ??= _staticCss0;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        TextSize ??= _defaultTextSize;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        RingColor ??= _defaultRingColor;

        ApplyVariantDefaults();
        ApplySizeDefaults();

    }

    private void ApplyVariantDefaults()
    {
        if (ReferenceEquals(Variant, ItemVariant.Outline))
        {
            BorderColor ??= _defaultBorderColor2;
            return;
        }

        if (ReferenceEquals(Variant, ItemVariant.Muted))
        {
            BorderColor ??= _defaultBorderColor;
            BackgroundColor ??= _defaultBackgroundColor2;
            return;
        }

        BorderColor ??= _defaultBorderColor;
        BackgroundColor ??= _defaultBackgroundColor;
    }

    private void ApplySizeDefaults()
    {
        Gap = null;
        Padding = null;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-variant"] = GetDataVariant(Variant);
        attributes["data-size"] = GetDataSize(ItemSize);

        // shadcn/ui item base - exact copy from new-york-v4 ui/item.tsx
        const string itemClass = "group/item duration-100 focus-visible:ring-[3px] [a]:transition-colors [a]:hover:bg-muted";
        PrependClassAttribute(attributes, ReferenceEquals(ItemSize, ItemSize.ExtraSmall)
            ? itemClass + " gap-2 px-2.5 py-2 in-data-[slot=dropdown-menu-content]:p-0" : itemClass + " gap-2.5 px-3 py-2.5", ref _lastBuiltClass);
    }

    private static string GetDataVariant(ItemVariant? variant)
    {
        if (ReferenceEquals(variant, ItemVariant.Outline))
            return "outline";

        if (ReferenceEquals(variant, ItemVariant.Muted))
            return "muted";

        return "default";
    }

    private static string GetDataSize(ItemSize? size)
    {
        if (ReferenceEquals(size, ItemSize.ExtraSmall))
            return "xs";

        if (ReferenceEquals(size, ItemSize.Small))
            return "sm";

        return "default";
    }

    private IReadOnlyDictionary<string, object> BuildSlotAttributes()
    {
        return BuildAttributes();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Variant);
        hc.Add(ItemSize);
        hc.Add(AsChild);
    }
}
