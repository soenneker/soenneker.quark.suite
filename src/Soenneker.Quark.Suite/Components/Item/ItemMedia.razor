@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IItemMedia

<div @attributes="BuildAttributes()">@ChildContent</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is10;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Sm;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private string? _lastBuiltClass;

    [Parameter]
    public ItemMediaVariant Variant { get; set; } = ItemMediaVariant.Default;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "item-media";
        Display ??= _defaultDisplay;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Gap ??= _defaultGap;

        ApplyVariantDefaults();

    }

    private void ApplyVariantDefaults()
    {
        if (ReferenceEquals(Variant, ItemMediaVariant.Icon))
        {
            return;
        }

        if (ReferenceEquals(Variant, ItemMediaVariant.Image))
        {
            Size ??= _defaultSize;
            Rounded ??= _defaultRounded;
            Overflow ??= _defaultOverflow;
            return;
        }

        BackgroundColor ??= _defaultBackgroundColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-variant"] = GetDataVariant(Variant);

        // shadcn/ui item-media base - exact copy from new-york-v4 ui/item.tsx
        const string mediaClass = "group-has-data-[slot=item-description]/item:translate-y-0.5 group-has-data-[slot=item-description]/item:self-start [&_svg]:pointer-events-none";
        var prefix = ReferenceEquals(Variant, ItemMediaVariant.Icon) ? mediaClass + " [&_svg:not([class*='size-'])]:size-4"
            : ReferenceEquals(Variant, ItemMediaVariant.Image) ? mediaClass + " group-data-[size=sm]/item:size-8 group-data-[size=xs]/item:size-6 [&_img]:size-full [&_img]:object-cover" : mediaClass;
        PrependClassAttribute(attributes, prefix, ref _lastBuiltClass);
    }

    private static string GetDataVariant(ItemMediaVariant? variant)
    {
        if (ReferenceEquals(variant, ItemMediaVariant.Icon))
            return "icon";

        if (ReferenceEquals(variant, ItemMediaVariant.Image))
            return "image";

        return "default";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Variant);
    }
}