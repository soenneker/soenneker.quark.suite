@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IItemSeparator

<BradixSeparator Orientation="@Orientation.Horizontal"
                 Decorative="true"
                 AdditionalAttributes="@BuildAttributes()" />

@code {
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Utility("bg-border");
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsPx;
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.OnY.Is2;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "item-separator";
        BackgroundColor ??= _defaultBackgroundColor;
        Shrink ??= _defaultShrink;
        Height ??= _defaultHeight;
        Margin ??= _defaultMargin;
        Width ??= _defaultWidth;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-orientation"] = "horizontal";
    }
}