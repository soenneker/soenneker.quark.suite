@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.DialogOverlayElement

<BradixDialog Open="@Visible"
              OpenChanged="(_cachedHandleOpenChangedDelegate ??= HandleOpenChanged)"
              Modal="@TrapFocus">
    <CascadingValue Name="ParentDrawer" Value="@this">
        <CascadingValue Value="_context" IsFixed="true"
                        ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />
    </CascadingValue>
</BradixDialog>

@code {
    private Func<bool, Task>? _cachedHandleOpenChangedDelegate;

    public Drawer() : base("drawer") { }

    /// <summary>
    /// Gets or sets the drawer edge using the current shadcn/Vaul root API: <c>top</c>, <c>right</c>, <c>bottom</c>, or <c>left</c>.
    /// </summary>
    [Parameter]
    public string? Direction { get; set; }

    internal Side? DirectionSide => ParseDirection(Direction);

    private static Side? ParseDirection(string? direction)
    {
        if (string.IsNullOrWhiteSpace(direction))
            return null;

        var value = direction.AsSpan().Trim();

        if (value.Equals("top", StringComparison.OrdinalIgnoreCase))
            return Side.Top;

        if (value.Equals("right", StringComparison.OrdinalIgnoreCase))
            return Side.Right;

        if (value.Equals("bottom", StringComparison.OrdinalIgnoreCase))
            return Side.Bottom;

        return value.Equals("left", StringComparison.OrdinalIgnoreCase) ? Side.Left : null;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        CloseOnEscape = true;
        CloseOnBackdropClick = true;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Direction);
    }
}
