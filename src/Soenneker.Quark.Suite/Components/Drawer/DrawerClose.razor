@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (AsChild && AutoClose)
{
    <BradixDialogClose AsChild="true" AriaLabel="@((string?) null)" OnClick="(_cachedHandleBradixCloseClickDelegate ??= HandleBradixCloseClick)">
        <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </BradixDialogClose>
}
else if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else if (AutoClose)
{
    <BradixDialogClose OnClick="(_cachedHandleBradixCloseClickDelegate ??= HandleBradixCloseClick)" AdditionalAttributes="@CloseAttributes">
        @ChildContent
    </BradixDialogClose>
}
else
{
    <button type="button" @onclick="(_cachedHandleNonAutoCloseClickDelegate ??= HandleNonAutoCloseClick)" @attributes="CloseAttributes">
        @ChildContent
    </button>
}

@code {
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private Func<MouseEventArgs, Task>? _cachedHandleBradixCloseClickDelegate;

    private Func<MouseEventArgs, Task>? _cachedHandleNonAutoCloseClickDelegate;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "drawer-close";
        Cursor ??= _defaultCursor;
    }


    [CascadingParameter(Name = "ParentDrawer")]
    private Drawer? ParentDrawer { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    [Parameter]
    public bool AutoClose { get; set; } = true;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private IReadOnlyDictionary<string, object> CloseAttributes => BuildAttributes();

    private async Task HandleBradixCloseClick(MouseEventArgs e)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }

    private async Task HandleNonAutoCloseClick(MouseEventArgs e)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }

    private bool? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<Task>? _contextOnClickCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = AutoClose;
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = "drawer-close",
            OnClick = AutoClose ? null : (_contextOnClickCallback ??= () => OnClick.InvokeAsync())
        };
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AsChild);
        hc.Add(AutoClose);
        hc.Add(OnClick.HasDelegate);
    }

}
