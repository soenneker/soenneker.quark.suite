@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<ul @attributes="BuildAttributes()">
    @ChildContent
</ul>

@code {
    private string? _sizePrefix;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Row;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is0_5;
    private string? _lastBuiltClass;

    [CascadingParameter(Name = "ParentPagination")]
    private Pagination? ParentPagination { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "pagination-content";

        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Gap ??= _defaultGap;
        ItemsAlign ??= _staticCss0;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        var sizeClass = ParentPagination?.GetSizeClass();
        var prefix = ParentPagination?.Vertical == true
            ? string.IsNullOrEmpty(sizeClass) ? "flex-col" : QuarkStringCache.Concat(sizeClass, " ", "flex-col", ref _sizePrefix)
            : sizeClass;
        if (!string.IsNullOrEmpty(prefix))
            PrependClassAttribute(attributes, prefix, ref _lastBuiltClass);
    }
}