@namespace Soenneker.Quark
@inherits LocalizedFormControlElement

<PaginationLink Href="@Href" OnClick="@OnClick" Disabled="@Disabled" ButtonSize="_staticCss0" @attributes="BuildAttributes()" aria-label="@Localizer["PreviousPage"]">
    <Icon Name="LucideIcon.ChevronLeft" data-icon="inline-start" Class="cn-rtl-flip" />
    <Span Display="_renderCss0">@(Text ?? Localizer["Previous"])</Span>
</PaginationLink>

@code {
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = ButtonSize.Default;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.None.OnSm.Block;
    private string? _lastBuiltClass;

    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Text { get; set; }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        {
            const string @class = "pl-1.5!";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Href);
        hc.Add(Text);
        hc.Add(Disabled);
    }
}
