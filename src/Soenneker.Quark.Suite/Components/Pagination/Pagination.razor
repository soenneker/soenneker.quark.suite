@namespace Soenneker.Quark

@inherits Soenneker.Quark.Element
@implements IPagination

<CascadingValue Name="ParentPagination" Value="this">
    <nav @attributes="BuildAttributes()">
	    @ChildContent
    </nav>
</CascadingValue>

@code {
    private static readonly CssValue<PaginationSizeBuilder> _staticCss0 = Quark.PaginationSizes.Default;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.OnX.Auto;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    /// <summary>
    /// Gets or sets the size of the pagination component.
    /// </summary>
    [Parameter]
    public CssValue<PaginationSizeBuilder>? PaginationSize { get; set; } = _staticCss0;

    /// <summary>
    /// Gets or sets whether the pagination should be displayed vertically.
    /// </summary>
    [Parameter]
    public bool Vertical { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "pagination";

        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        Margin ??= _defaultMargin;
        Justify ??= _defaultJustify;
    }

    internal string? GetSizeClass()
    {
        var sizeClass = PaginationSize?.ToString();
        return string.IsNullOrWhiteSpace(sizeClass) ? null : sizeClass;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["role"] = "navigation";
        attributes["aria-label"] = "pagination";
        if (Vertical)
            attributes["data-orientation"] = "vertical";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        AddIf(ref hc, PaginationSize);
        hc.Add(Vertical);
    }
}