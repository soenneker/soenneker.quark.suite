@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ITree

<CascadingValue Name="ParentTree" Value="@this" IsFixed="true">
    <Div Attributes="@BuildAttributes()">
        @if (Virtualize)
        {
            <VirtualItems @ref="_virtualItems" ParentScroll="true" ItemKeys="@ItemKeys" ItemTemplate="@ItemTemplate" />
        }
        else { @ChildContent }
    </Div>
</CascadingValue>

@code {
    [Parameter] public bool Virtualize { get; set; }
    [Parameter] public IReadOnlyList<string> ItemKeys { get; set; } = [];
    [Parameter] public RenderFragment<int>? ItemTemplate { get; set; }
    [Parameter] public Func<int, bool>? ItemDisabled { get; set; }
    private VirtualItems? _virtualItems;
    private string? _currentKey;
    private IReadOnlyList<string> _previousKeys = [];

    private Dictionary<string, int> _keyIndexes = new(StringComparer.Ordinal);
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!Virtualize) return;
        if (!_previousKeys.SequenceEqual(ItemKeys))
        {
            _keyIndexes = new Dictionary<string, int>(StringComparer.Ordinal);
            for (int i = 0; i < ItemKeys.Count; i++) _keyIndexes.Add(ItemKeys[i], i);
        }
        if (_currentKey is null || !_keyIndexes.ContainsKey(_currentKey))
        {
            int previous = _currentKey is null ? 0 : _previousKeys.ToList().IndexOf(_currentKey);
            _currentKey = _previousKeys.Take(Math.Max(0, previous)).Reverse().FirstOrDefault(key => _keyIndexes.TryGetValue(key, out int i) && ItemDisabled?.Invoke(i) != true)
                ?? ItemKeys.Where((_, index) => ItemDisabled?.Invoke(index) != true).FirstOrDefault();
        }
        if (!_previousKeys.SequenceEqual(ItemKeys)) _previousKeys = ItemKeys.ToArray();
    }

    private CurrentCultureInt32TextCache _spacingText;
    private string? _spacingStyle;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private string? _lastBuiltStyle;

    private readonly List<TreeItem> _items = [];
    private TreeItem? _currentItem;

    [Parameter]
    public int Indent { get; set; } = 20;

    [Parameter]
    public TreeToggleIconType ToggleIconType { get; set; } = TreeToggleIconType.Chevron;

    internal void Register(TreeItem item)
    {
        // Each item registers once from OnInitialized; avoid scanning all prior rows on mount.
        _items.Add(item);

        if (_currentItem is null && !item.Disabled && item.Visible)
            _currentItem = item;
    }

    internal void Unregister(TreeItem item)
    {
        _items.Remove(item);

        if (Virtualize) return;
        if (ReferenceEquals(_currentItem, item))
        {
            _currentItem = FindFirstEnabledItem();
            _currentItem?.RefreshTreeItem();
        }
    }

    internal bool IsCurrent(TreeItem item) => !item.Disabled && item.Visible && (Virtualize ? item.Id == _currentKey : ReferenceEquals(_currentItem, item));

    internal void UpdateAvailability(TreeItem item)
    {
        if (ReferenceEquals(_currentItem, item) && (item.Disabled || !item.Visible))
        {
            _currentItem = FindFirstEnabledItem();
            _currentItem?.RefreshTreeItem();
        }
    }

    internal void SetCurrent(TreeItem item)
    {
        if (item.Disabled || !item.Visible || ReferenceEquals(_currentItem, item))
            return;

        var previous = _currentItem;
        _currentItem = item;
        if (Virtualize) _currentKey = item.Id;
        previous?.RefreshTreeItem();
        item.RefreshTreeItem();
    }

    internal async Task<bool> MoveFocus(TreeItem item, string? key)
    {
        if (key is not ("ArrowDown" or "ArrowUp" or "Home" or "End")) return false;
        if (Virtualize && _virtualItems is not null)
        {
            int index = _keyIndexes.GetValueOrDefault(item.Id!, -1);
            int direction = key is "ArrowUp" or "End" ? -1 : 1;
            int targetIndex = key == "Home" ? 0 : key == "End" ? ItemKeys.Count - 1 : index + direction;
            while (targetIndex >= 0 && targetIndex < ItemKeys.Count && ItemDisabled?.Invoke(targetIndex) == true) targetIndex += direction;
            if (targetIndex >= 0 && targetIndex < ItemKeys.Count)
            {
                _currentKey = ItemKeys[targetIndex];
                await _virtualItems.ScrollToIndex(targetIndex, "[role=treeitem]");
                await RequestRender();
            }
            return true;
        }
        TreeItem? first = null;
        TreeItem? last = null;
        TreeItem? previous = null;
        TreeItem? next = null;
        var foundCurrent = false;

        for (var i = 0; i < _items.Count; i++)
        {
            var candidate = _items[i];

            if (candidate.Disabled || !candidate.Visible)
                continue;

            first ??= candidate;
            last = candidate;

            if (ReferenceEquals(candidate, item))
            {
                foundCurrent = true;
                continue;
            }

            if (foundCurrent)
                next ??= candidate;
            else
                previous = candidate;
        }

        if (first is null)
            return false;

        var target = key switch
        {
            "ArrowDown" => foundCurrent ? next ?? last : first,
            "ArrowUp" => foundCurrent ? previous ?? first : first,
            "Home" => first,
            "End" => last,
            _ => null
        };

        if (target is null)
            return false;

        SetCurrent(target);
        await target.Focus();
        return true;
    }

    public ValueTask FocusItem(string key)
    {
        int index = _keyIndexes.GetValueOrDefault(key, -1);
        if (index < 0 || ItemDisabled?.Invoke(index) == true || _virtualItems is null) return ValueTask.CompletedTask;
        _currentKey = key;
        return _virtualItems.ScrollToIndex(index, "[role=treeitem]");
    }

    private TreeItem? FindFirstEnabledItem()
    {
        for (var i = 0; i < _items.Count; i++)
        {
            if (!_items[i].Disabled && _items[i].Visible)
                return _items[i];
        }

        return null;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tree";
        if (Virtualize) { Height ??= Quark.Height.Is96; OverflowY ??= Quark.Overflow.Auto; }
        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["role"] = "tree";
        attributes["aria-label"] = AriaLabel ?? "Tree";

        var spacing = _spacingText.Get(Indent);
        var declaration = QuarkStringCache.Concat("--tree-indent:", spacing, "px", ref _spacingStyle);
        PrependStyleAttribute(attributes, declaration, ref _lastBuiltStyle);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Virtualize); hc.Add(ItemKeys); hc.Add(ItemTemplate); hc.Add(_currentKey);
        hc.Add(Indent);
        hc.Add(ToggleIconType);
    }
}
