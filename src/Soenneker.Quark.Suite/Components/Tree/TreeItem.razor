@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IDisposable

<CascadingValue Name="ParentTreeItem" Value="@this">
    <button @ref="_element" @attributes="BuildAttributes()" @onclick="HandleClick" @onfocus="HandleFocus" @onkeydown="HandleKeyDown">
        @ChildContent
    </button>
</CascadingValue>

@code {
    private ElementReference _element;

    [CascadingParameter(Name = "ParentTree")]
    public Tree? ParentTree { get; set; }

    [Parameter]
    public int Level { get; set; }

    [Parameter]
    public bool Folder { get; set; }

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public int? PositionInSet { get; set; }

    [Parameter]
    public int? SetSize { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> Click { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> KeyDown { get; set; }

    internal TreeToggleIconType ToggleIconType => ParentTree?.ToggleIconType ?? TreeToggleIconType.Chevron;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ParentTree?.Register(this);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tree-item";
        ZIndex ??= Quark.ZIndex.Is10;
        TextAlign ??= Quark.TextAlign.Start;
        OutlineStyle ??= Quark.OutlineStyle.Hidden;
        UserSelect ??= Quark.UserSelect.None;
        Cursor ??= Quark.Cursor.Pointer.OnDisabled.NotAllowed;
        PointerEvents ??= Quark.PointerEvents.None.OnDisabled;
        Opacity ??= Quark.Opacity.Is50.OnDisabled;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["type"] = "button";
        attributes["role"] = "treeitem";
        attributes["data-folder"] = Folder ? "true" : "false";
        attributes["data-selected"] = Selected ? "true" : "false";
        attributes["aria-selected"] = Selected ? "true" : "false";
        attributes["aria-level"] = Math.Max(1, Level + 1);
        attributes["tabindex"] = ParentTree?.IsCurrent(this) == true ? "0" : "-1";

        if (PositionInSet is > 0)
            attributes["aria-posinset"] = PositionInSet.Value;

        if (SetSize is > 0)
            attributes["aria-setsize"] = SetSize.Value;

        if (Folder)
            attributes["aria-expanded"] = Expanded ? "true" : "false";

        if (Disabled)
        {
            attributes["data-disabled"] = "true";
            attributes["aria-disabled"] = "true";
            attributes["disabled"] = "disabled";
        }

        BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "ps-[var(--tree-padding)] not-last:pb-0.5 focus:z-20");
        });

        BuildStyleAttribute(attributes, (ref sty) =>
        {
            AppendStyleDecl(ref sty, $"--tree-padding:{Level * (ParentTree?.Indent ?? 20)}px");
        });
    }

    private Task HandleClick(MouseEventArgs args)
    {
        if (Disabled)
            return Task.CompletedTask;

        ParentTree?.SetCurrent(this);

        if (!Click.HasDelegate)
            return Task.CompletedTask;

        return Click.InvokeAsync(args);
    }

    private Task HandleFocus(FocusEventArgs _)
    {
        ParentTree?.SetCurrent(this);
        return Task.CompletedTask;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (Disabled)
            return;

        if (ParentTree is not null)
            await ParentTree.MoveFocus(this, args.Key);

        if (KeyDown.HasDelegate)
            await KeyDown.InvokeAsync(args);
    }

    internal ValueTask Focus() => _element.FocusAsync();

    internal void RefreshTreeItem() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ParentTree?.Unregister(this);

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Level);
        hc.Add(Folder);
        hc.Add(Expanded);
        hc.Add(Selected);
        hc.Add(Disabled);
        hc.Add(PositionInSet);
        hc.Add(SetSize);
    }
}
