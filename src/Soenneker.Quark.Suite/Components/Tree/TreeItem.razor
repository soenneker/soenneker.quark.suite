@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IDisposable

<CascadingValue Name="ParentTreeItem" Value="@this">
    <div class="tree-item-motion" data-visible="@(Visible ? "true" : "false")" aria-hidden="@(Visible ? null : "true")" inert="@(!Visible)">
    <div class="tree-item-clip">
    <button @ref="_element" @attributes="BuildAttributes()" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)" @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)">
        @ChildContent
    </button>
    </div>
    </div>
</CascadingValue>

@code {
    private QuarkInt32Attribute _sizeAttribute;
    private QuarkInt32Attribute _positionAttribute;
    private QuarkInt32Attribute _levelAttribute;
    private CurrentCultureInt32TextCache _spacingText;
    private string? _spacingStyle;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is10;
    private static readonly CssValue<TextAlignBuilder> _defaultTextAlign = Quark.TextAlign.Start;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private string? _lastPrependedClass;
    private string? _lastBuiltStyle;

    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private ElementReference _element;

    /// <summary>Whether the row is visible. Keep collapsed descendants mounted and set this to false to animate them closed.</summary>
    [Parameter]
    public bool Visible { get; set; } = true;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ParentTree?.UpdateAvailability(this);
    }

    [CascadingParameter(Name = "ParentTree")]
    public Tree? ParentTree { get; set; }

    [Parameter]
    public int Level { get; set; }

    [Parameter]
    public bool Folder { get; set; }

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public int? PositionInSet { get; set; }

    [Parameter]
    public int? SetSize { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> Click { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> KeyDown { get; set; }

    internal TreeToggleIconType ToggleIconType => ParentTree?.ToggleIconType ?? TreeToggleIconType.Chevron;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ParentTree?.Register(this);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tree-item";
        ZIndex ??= _defaultZIndex;
        TextAlign ??= _defaultTextAlign;
        OutlineStyle ??= _defaultOutlineStyle;
        UserSelect ??= _defaultUserSelect;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["type"] = "button";
        attributes["role"] = "treeitem";
        attributes["data-folder"] = Folder ? "true" : "false";
        attributes["data-selected"] = Selected ? "true" : "false";
        attributes["aria-selected"] = Selected ? "true" : "false";
        attributes["aria-level"] = _levelAttribute.Get(Math.Max(1, Level + 1));
        attributes["tabindex"] = ParentTree?.IsCurrent(this) == true ? "0" : "-1";

        if (PositionInSet is > 0)
            attributes["aria-posinset"] = _positionAttribute.Get(PositionInSet.Value);

        if (SetSize is > 0)
            attributes["aria-setsize"] = _sizeAttribute.Get(SetSize.Value);

        if (Folder)
            attributes["aria-expanded"] = Expanded ? "true" : "false";

        if (Disabled)
        {
            attributes["data-disabled"] = "true";
            attributes["aria-disabled"] = "true";
            attributes["disabled"] = "disabled";
        }

        PrependClassAttribute(attributes, "ps-[var(--tree-padding)] not-last:pb-0.5 focus:z-20", ref _lastPrependedClass);

        var spacing = _spacingText.Get(Level * (ParentTree?.Indent ?? 20));
        var declaration = QuarkStringCache.Concat("--tree-padding:", spacing, "px", ref _spacingStyle);
        PrependStyleAttribute(attributes, declaration, ref _lastBuiltStyle);
    }

    private Task HandleClick(MouseEventArgs args)
    {
        if (Disabled || !Visible)
            return Task.CompletedTask;

        ParentTree?.SetCurrent(this);

        if (!Click.HasDelegate)
            return Task.CompletedTask;

        return Click.InvokeAsync(args);
    }

    private Task HandleFocus(FocusEventArgs _)
    {
        ParentTree?.SetCurrent(this);
        return Task.CompletedTask;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (Disabled || !Visible)
            return;

        if (ParentTree is not null)
            await ParentTree.MoveFocus(this, args.Key);

        if (KeyDown.HasDelegate)
            await KeyDown.InvokeAsync(args);
    }

    internal ValueTask Focus() => _element.FocusAsync();

    internal void RefreshTreeItem() => _ = RefreshOffThread();

    public void Dispose() => ParentTree?.Unregister(this);

    public override async ValueTask DisposeAsync()
    {
        Dispose();
        await base.DisposeAsync();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentTree?.IsCurrent(this));
        hc.Add(ParentTree?.Indent);
        hc.Add(Level);
        hc.Add(Visible);
        hc.Add(Folder);
        hc.Add(Expanded);
        hc.Add(Selected);
        hc.Add(Disabled);
        hc.Add(PositionInSet);
        hc.Add(SetSize);
    }
}
