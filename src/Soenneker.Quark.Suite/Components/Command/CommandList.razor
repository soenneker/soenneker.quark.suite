@namespace Soenneker.Quark
@using Soenneker.Blazor.Utils.Ids
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private static readonly CssValue<MaxHeightBuilder> _defaultMaxHeight = Quark.MaxHeight.Token("72");
    private static readonly CssValue<OverflowBuilder> _defaultOverflowX = Quark.Overflow.X.Hidden;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowY = Quark.Overflow.Y.Auto;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<ScrollPaddingBuilder> _defaultScrollPadding = Quark.ScrollPadding.OnY.Is1;
    private string? _lastPrependedClass;

    private string? _orphanListId;

    [CascadingParameter(Name = "ParentCommand")]
    private Command? ParentCommand { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "command-list";

        MaxHeight ??= _defaultMaxHeight;
        OverflowX ??= _defaultOverflowX;
        OverflowY ??= _defaultOverflowY;
        OutlineStyle ??= _defaultOutlineStyle;
        ScrollPadding ??= _defaultScrollPadding;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["id"] = ParentCommand?.ListId ?? (_orphanListId ??= BlazorIdGenerator.New("quark-command-list"));
        attributes["role"] = "listbox";
        attributes["aria-label"] = "Suggestions";

        PrependClassAttribute(attributes, "no-scrollbar", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentCommand?.ListId);
    }
}
