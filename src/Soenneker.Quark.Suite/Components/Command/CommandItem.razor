@namespace Soenneker.Quark
@using Soenneker.Blazor.Utils.Ids
@inherits Soenneker.Quark.FormControlElement

<div @onclick="(_cachedHandleItemClickDelegate ??= HandleItemClick)" @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)" @onmouseenter="(_cachedHandleMouseMoveDelegate ??= HandleMouseMove)" @attributes="BuildAttributes()" role="option" @ref="_elementRef">
    @ChildContent
    <Icon Name="LucideIcon.Check" Margin="_renderCss0" Display='_renderCss1' Opacity='_staticCss1' />
</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<OpacityBuilder> _staticCss1 = CssValue<OpacityBuilder>.For(Quark.Opacity.Is0, Quark.Opacity.Is100.Modifier("group-data-[checked=true]/command-item"));
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Sm;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2.OnY.Token("1.5");
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Default;
    private static readonly CssValue<MarginBuilder> _renderCss0 = Quark.Margin.FromLeft.Auto;
    private static readonly CssValue<DisplayBuilder> _renderCss1 = Quark.Display.None.Modifier("group-has-data-[slot=command-shortcut]/command-item");
    private string? _lastBuiltStyle;
    private string? _lastPrependedClass;

    private Func<MouseEventArgs, Task>? _cachedHandleItemClickDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;
    private Func<MouseEventArgs, Task>? _cachedHandleMouseMoveDelegate;

    private ElementReference _elementRef;
    private string _searchText = string.Empty;
    private string? _searchValueSnapshot;
    private string[]? _keywordsSnapshot;

    [Parameter]
    public EventCallback OnSelect { get; set; }

    [Parameter]
    public string? SearchValue { get; set; }

    [Parameter]
    public string[]? Keywords { get; set; }

    [Parameter]
    public bool Checked { get; set; }

    [CascadingParameter(Name = "ParentCommand")]
    private Command? ParentCommand { get; set; }

    [CascadingParameter]
    private CommandGroup? ParentCommandGroup { get; set; }

    internal bool IsVisibleResolved => ParentCommand?.IsItemVisible(this) ?? true;

    internal string SearchText => _searchText;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "command-item";
        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        OutlineStyle ??= _defaultOutlineStyle;
        UserSelect ??= _defaultUserSelect;
        Cursor ??= _defaultCursor;

    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (!Id.HasContent())
            Id = BlazorIdGenerator.New("quark-command-item");

        ParentCommand?.RegisterItem(this, ParentCommandGroup);
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_searchValueSnapshot, SearchValue, StringComparison.Ordinal) || !Keywords.AsSpan().SequenceEqual(_keywordsSnapshot))
        {
            _searchText = BuildSearchText();
            _searchValueSnapshot = SearchValue;
            _keywordsSnapshot = Keywords is null ? null : [.. Keywords];
        }
        ParentCommand?.UpdateItemGroup(this, ParentCommandGroup);
        base.OnParametersSet();
    }

    private async Task HandleItemClick(MouseEventArgs _)
    {
        if (!Disabled && OnSelect.HasDelegate)
            await OnSelect.InvokeAsync();
    }

    private async Task HandleMouseMove(MouseEventArgs _)
    {
        if (Disabled || ParentCommand is null)
            return;

        await ParentCommand.SetActiveItem(this);
    }

    protected override async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await Select();
        else if (ParentCommand is not null && e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End")
            await ParentCommand.HandleInputNavigation(e.Key);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["cmdk-item"] = string.Empty;
        attributes["id"] = Id!;
        attributes["tabindex"] = QuarkAttributeValues.MinusOne;
        var selected = ParentCommand?.IsItemActive(this) == true;
        attributes["aria-selected"] = selected ? "true" : "false";
        attributes["data-selected"] = selected ? "true" : "false";
        if (!IsVisibleResolved)
            attributes["hidden"] = string.Empty;
        attributes["data-value"] = SearchText;
        attributes["data-disabled"] = Disabled ? "true" : "false";
        attributes["data-checked"] = Checked ? "true" : "false";
        if (Disabled)
            attributes["aria-disabled"] = "true";

        if (ParentCommand?.GetItemOrder(this) is { } order)
            {
                var sty = new PooledStringBuilder(stackalloc char[64]);
                try
                {
                    AppendStyleDecl(ref sty, "order: ", order.ToString());
                    BuildStyleAttribute(attributes, ref sty, ref _lastBuiltStyle);
                }
                finally
                {
                    sty.Dispose();
                }
            }

        PrependClassAttribute(attributes, "group/command-item in-data-[slot=dialog-content]:rounded-lg! data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 data-selected:bg-muted data-selected:text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 data-selected:*:[svg]:text-foreground", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Disabled);
        hc.Add(IsVisibleResolved);
        hc.Add(ParentCommand?.IsItemActive(this));
        hc.Add(ParentCommand?.GetItemOrder(this));
        hc.Add(SearchValue);
        if (Keywords is not null)
        {
            foreach (var keyword in Keywords)
                hc.Add(keyword);
        }

        hc.Add(Checked);
    }

    private string BuildSearchText()
    {
        var hasSearchValue = !string.IsNullOrWhiteSpace(SearchValue);
        var keywordCount = Keywords?.Length ?? 0;

        if (!hasSearchValue && keywordCount == 0)
            return string.Empty;

        if (keywordCount == 0)
            return SearchValue!;

        var length = hasSearchValue ? SearchValue!.Length : 0;
        var parts = hasSearchValue ? 1 : 0;

        foreach (var keyword in Keywords!)
        {
            if (string.IsNullOrWhiteSpace(keyword))
                continue;

            length += keyword.Length;
            parts++;
        }

        if (parts == 0)
            return string.Empty;

        length += parts - 1;
        return string.Create(length, (SearchValue, Keywords, hasSearchValue), static (span, state) =>
        {
            var position = 0;
            var wrotePart = false;

            if (state.hasSearchValue)
            {
                state.SearchValue.AsSpan().CopyTo(span);
                position += state.SearchValue!.Length;
                wrotePart = true;
            }

            foreach (var keyword in state.Keywords!)
            {
                if (string.IsNullOrWhiteSpace(keyword))
                    continue;

                if (wrotePart)
                    span[position++] = ' ';

                keyword.AsSpan().CopyTo(span[position..]);
                position += keyword.Length;
                wrotePart = true;
            }
        });
    }

    internal async Task Focus()
    {
        await _elementRef.FocusAsync();
    }

    internal async Task Select()
    {
        if (!Disabled && OnSelect.HasDelegate)
            await OnSelect.InvokeAsync();
    }

    public override async ValueTask DisposeAsync()
    {
        ParentCommand?.UnregisterItem(this);
        await base.DisposeAsync();
    }
}
