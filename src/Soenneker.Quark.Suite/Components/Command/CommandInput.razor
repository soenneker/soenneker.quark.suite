@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement

<div @attributes="BuildWrapperAttributes()">
    <InputGroup Class="h-8! rounded-lg! border-input/30 bg-input/30 shadow-none! *:data-[slot=input-group-addon]:pl-2!" @onclick="(_focusInputCallback ??= FocusInput)">
        <input @ref="_inputElement" value="@Value" @oninput="(_cachedHandleInputDelegate ??= HandleInput)" @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)" @attributes="BuildAttributes()" placeholder="@Placeholder" cmdk-input />
        <InputGroupAddon>
            <Icon Name="LucideIcon.Search" Size="_renderCss0" Shrink="_renderCss1" Opacity="_renderCss2" />
        </InputGroupAddon>
    </InputGroup>
</div>

@code {
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.NotAllowed.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<ShrinkBuilder> _renderCss1 = Quark.Shrink.Is0;
    private static readonly CssValue<OpacityBuilder> _renderCss2 = Quark.Opacity.Is50;
    private string? _lastPrependedClass;

    private Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private QuarkAttributeDictionary _wrapperAttributesBuffer;
    private ElementReference _inputElement;
    private Func<Task>? _focusInputCallback;
    private bool _focusAfterSelect;

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [CascadingParameter(Name = "ParentCommand")]
    private Command? ParentCommand { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";

        if (ParentCommand is not null)
            await ParentCommand.SetSearch(Value);

        await ValueChanged.InvokeAsync(Value);
    }

    private Task FocusInput()
    {
        return _inputElement.FocusAsync().AsTask();
    }

    protected override async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (ParentCommand is not null && e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End")
            await ParentCommand.HandleInputNavigation(e.Key);
        else if (ParentCommand is not null && e.Key == "Enter")
        {
            await ParentCommand.SelectActiveItem();
            _focusAfterSelect = true;
            await InvokeAsync(StateHasChanged);
        }

        await base.HandleKeyDown(e);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_focusAfterSelect)
            return;

        _focusAfterSelect = false;
        await _inputElement.FocusAsync();
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["type"] = "text";
        attributes["role"] = "combobox";
        attributes["aria-expanded"] = "true";
        attributes["aria-controls"] = ParentCommand?.ListId ?? "command-list";

        if (ParentCommand?.ActiveItemId is not null)
            attributes["aria-activedescendant"] = ParentCommand.ActiveItemId;

    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "command-input";

        Width ??= _defaultWidth;
        TextSize ??= _defaultTextSize;
        OutlineStyle ??= _defaultOutlineStyle;
        Cursor ??= _defaultCursor;
        Opacity ??= _defaultOpacity;
    }

    private Dictionary<string, object> BuildWrapperAttributes()
    {
        var attrs = _wrapperAttributesBuffer.Create(3);
        attrs["data-slot"] = "command-input-wrapper";
        attrs["cmdk-input-wrapper"] = string.Empty;
        PrependClassAttribute(attrs, "p-1 pb-0", ref _lastPrependedClass);
        return attrs;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentCommand?.ActiveItemId);
    }
}
