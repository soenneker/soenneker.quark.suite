@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()"></div>

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.OnX.Negative1;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsPx;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Border;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "command-separator";

        Margin ??= _defaultMargin;
        Height ??= _defaultHeight;
        BackgroundColor ??= _defaultBackgroundColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["role"] = "separator";
    }
}