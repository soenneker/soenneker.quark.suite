@namespace Soenneker.Quark
@using Soenneker.Blazor.Utils.Ids
@inherits Soenneker.Quark.Element

<CascadingValue Name="ParentCommand" Value="@this">
    <div @attributes="BuildAttributes()">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsFull;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Xl;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is1;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private string? _lastPrependedClass;

    private readonly List<CommandEntry> _entries = [];
    private readonly Dictionary<CommandItem, CommandEntry> _entryLookup = new(ReferenceEqualityComparer.Instance);
    private List<CommandEntry>? _orderedEntries;
    private bool _orderDirty = true;
    private CommandItem? _activeItem;
    private string? _search;
    private readonly string _listId = BlazorIdGenerator.New("quark-command-list");

    internal string? Search => _search;

    internal bool HasVisibleItems => HasAnyVisibleEntry();

    internal string? ActiveItemId => _activeItem?.Id;

    internal string ListId => _listId;

    internal bool HasRegisteredItems => _entries.Count > 0;

    internal void RegisterItem(CommandItem item, CommandGroup? group)
    {
        var existingEntry = FindEntry(item);
        if (existingEntry is not null)
        {
            UpdateItemGroup(item, group);
            return;
        }

        var entry = new CommandEntry { Item = item, Group = group, SearchTextSnapshot = item.SearchText };
        _entries.Add(entry);
        _entryLookup.Add(item, entry);
        _orderDirty = true;

        if (_activeItem is null && item.IsVisibleResolved && !item.Disabled)
            _activeItem = item;

        Refresh();
    }

    internal void UpdateItemGroup(CommandItem item, CommandGroup? group)
    {
        var entry = FindEntry(item);
        if (entry is not null && (!ReferenceEquals(entry.Group, group) || !string.Equals(entry.SearchTextSnapshot, item.SearchText, StringComparison.Ordinal)))
        {
            entry.Group = group;
            entry.SearchTextSnapshot = item.SearchText;
            _orderDirty = true;
        }
    }

    internal void UnregisterItem(CommandItem item)
    {
        var entry = FindEntry(item);
        if (entry is null)
            return;

        _entries.Remove(entry);
        _entryLookup.Remove(item);
        _orderedEntries?.Clear();
        _orderDirty = true;

        if (ReferenceEquals(_activeItem, item))
            _activeItem = GetFirstVisibleEntry()?.Item;

        Refresh();
    }

    internal bool IsItemActive(CommandItem item)
    {
        return ReferenceEquals(_activeItem, item);
    }

    internal bool IsItemVisible(CommandItem item)
    {
        var entry = FindEntry(item);
        return entry?.Matches(_search) ?? true;
    }

    internal int? GetItemOrder(CommandItem item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return null;

        var entry = FindEntry(item);
        if (entry is null || !entry.Matches(_search))
            return null;

        EnsureItemOrder();
        return entry.SearchOrder;
    }

    internal void InvalidateItemOrder() => _orderDirty = true;

    private void EnsureItemOrder()
    {
        if (!_orderDirty)
            return;

        var ordered = _orderedEntries ??= [];
        ordered.Clear();
        for (var i = 0; i < _entries.Count; i++)
        {
            var entry = _entries[i];
            entry.RegistrationOrder = i;
            if (entry.Matches(_search))
                ordered.Add(entry);
        }

        ordered.Sort(CommandEntryOrderComparer.Instance);
        var order = 0;
        for (var i = 0; i < ordered.Count; i++)
        {
            if (i == 0 || !IsSameEntryGroup(ordered[i - 1].Group, ordered[i].Group))
                order = 0;
            ordered[i].SearchOrder = order++;
        }

        _orderDirty = false;
    }

    internal bool GroupHasVisibleItems(CommandGroup group)
    {
        foreach (var entry in _entries)
        {
            if (entry.Group is null && entry.Matches(_search))
                return true;
        }

        foreach (var entry in _entries)
        {
            if (IsSameGroup(entry.Group, group) && entry.Matches(_search))
                return true;
        }

        return false;
    }

    private static bool IsSameGroup(CommandGroup? entryGroup, CommandGroup group)
    {
        if (ReferenceEquals(entryGroup, group))
            return true;

        if (entryGroup is null)
            return false;

        return string.Equals(entryGroup.Heading, group.Heading, StringComparison.Ordinal);
    }

    private static bool IsSameEntryGroup(CommandGroup? left, CommandGroup? right)
    {
        if (ReferenceEquals(left, right))
            return true;

        if (left is null || right is null)
            return false;

        return string.Equals(left.Heading, right.Heading, StringComparison.Ordinal);
    }

    internal async Task SetSearch(string? value)
    {
        _search = value;
        _orderDirty = true;
        _activeItem = GetFirstVisibleEntry()?.Item;
        await RefreshOffThread();
    }

    internal async Task SetActiveItem(CommandItem item)
    {
        if (!item.IsVisibleResolved || item.Disabled)
            return;

        if (!ReferenceEquals(_activeItem, item))
        {
            _activeItem = item;
            await RefreshOffThread();
        }
    }

    internal async Task HandleInputNavigation(string key)
    {
        var visibleCount = CountVisibleEntries(out var currentIndex);
        if (visibleCount == 0)
            return;

        var nextIndex = key switch
        {
            "ArrowDown" => currentIndex < 0 ? 0 : Math.Min(currentIndex + 1, visibleCount - 1),
            "ArrowUp" => currentIndex < 0 ? visibleCount - 1 : Math.Max(currentIndex - 1, 0),
            "Home" => 0,
            "End" => visibleCount - 1,
            _ => -1
        };

        if (nextIndex < 0)
            return;

        var nextEntry = GetVisibleEntryAt(nextIndex);
        if (nextEntry is null)
            return;

        _activeItem = nextEntry.Item;
        await RefreshOffThread();
    }

    internal async Task SelectActiveItem()
    {
        if (_activeItem is null || !_activeItem.IsVisibleResolved || _activeItem.Disabled)
            return;

        await _activeItem.Select();
    }

    private CommandEntry? FindEntry(CommandItem item) => _entryLookup.GetValueOrDefault(item);

    private bool HasAnyVisibleEntry()
    {
        foreach (var entry in _entries)
        {
            if (entry.Matches(_search))
                return true;
        }

        return false;
    }

    private CommandEntry? GetFirstVisibleEntry()
    {
        foreach (var entry in _entries)
        {
            if (entry.IsVisible && !entry.IsDisabled)
                return entry;
        }

        return null;
    }

    private int CountVisibleEntries(out int activeIndex)
    {
        activeIndex = -1;
        var count = 0;

        foreach (var entry in _entries)
        {
            if (!entry.IsVisible || entry.IsDisabled)
                continue;

            if (ReferenceEquals(entry.Item, _activeItem))
                activeIndex = count;

            count++;
        }

        return count;
    }

    private CommandEntry? GetVisibleEntryAt(int targetIndex)
    {
        var index = 0;

        foreach (var entry in _entries)
        {
            if (!entry.IsVisible || entry.IsDisabled)
                continue;

            if (index == targetIndex)
                return entry;

            index++;
        }

        return null;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "command";

        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        FlexDirection ??= _defaultFlexDirection;
        Overflow ??= _defaultOverflow;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "size-full rounded-xl!", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(_search);
        hc.Add(_activeItem?.Id);
    }
}
