@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (ParentCommand?.HasVisibleItems != true)
{
    <div @attributes="BuildAttributes()">@ChildContent</div>
}

@code {
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnY.Is6;
    private static readonly CssValue<TextAlignBuilder> _defaultTextAlign = Quark.TextAlign.Center;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    [CascadingParameter(Name = "ParentCommand")]
    private Command? ParentCommand { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "command-empty";

        Padding ??= _defaultPadding;
        TextAlign ??= _defaultTextAlign;
        TextSize ??= _defaultTextSize;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentCommand?.HasVisibleItems);
    }
}