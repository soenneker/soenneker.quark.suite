@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements INavigationMenuLink

@if (AsChild)
{
    <CascadingValue Name="@SlotAttributes.Name" Value="BuildSlotAttributes()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <BradixNavigationMenuLink Active="@Active"
                              AdditionalAttributes="@LinkAttributes">
        @ChildContent
    </BradixNavigationMenuLink>
}

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is2;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private string? _lastBuiltClass;

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    private QuarkAttributeDictionary _attributesBuffer;

    private IReadOnlyDictionary<string, object> LinkAttributes => BuildAttributes();
    private bool UsesTriggerStyle => Class?.Contains("group/navigation-menu-trigger", StringComparison.Ordinal) == true;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "navigation-menu-link";

        if (!UsesTriggerStyle)
        {
            Display ??= _defaultDisplay;
            ItemsAlign ??= _staticCss0;
            Gap ??= _defaultGap;
            Rounded ??= _defaultRounded;
            Padding ??= _defaultPadding;
            TextSize ??= _defaultTextSize;
            Transition ??= _defaultTransition;
            OutlineStyle ??= _defaultOutlineStyle;
            RingColor ??= _defaultRingColor;
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Href.HasContent())
            attributes["href"] = Href!;

        if (Target.HasContent())
            attributes["target"] = Target!;

        if (!UsesTriggerStyle)
            PrependClassAttribute(attributes, "hover:bg-muted focus:bg-muted focus-visible:ring-3 focus-visible:outline-1 in-data-[slot=navigation-menu-content]:rounded-md data-active:bg-muted/50 data-active:hover:bg-muted data-active:focus:bg-muted [&_svg:not([class*='size-'])]:size-4", ref _lastBuiltClass);
    }

    private IReadOnlyDictionary<string, object> BuildSlotAttributes()
    {
        Dictionary<string, object> attributes = _attributesBuffer.Create(BuildAttributes(), 2);

        if (Active)
        {
            attributes["data-active"] = "true";
            attributes["aria-current"] = "page";
        }

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Href);
        hc.Add(Active);
        hc.Add(Target);
        hc.Add(AsChild);
    }
}
