@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements INavigationMenu

<BradixNavigationMenu Dir="@ResolvedDir"
                      AdditionalAttributes="@RootAttributes">
    @ChildContent
    @if (Viewport)
    {
        <NavigationMenuViewport />
    }
</BradixNavigationMenu>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private string? _lastPrependedClass;

    [Parameter]
    public bool Viewport { get; set; } = true;

    [CascadingParameter(Name = "DirectionProviderDir")]
    private string? DirectionProviderDir { get; set; }

    private string? ResolvedDir
    {
        get
        {
            if (Attributes is not null &&
                Attributes.TryGetValue("dir", out var dirValue) &&
                dirValue?.ToString().HasContent() == true)
            {
                return dirValue.ToString();
            }

            return DirectionProviderDir;
        }
    }

    private IReadOnlyDictionary<string, object> RootAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "navigation-menu";

        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-viewport"] = Viewport ? "true" : "false";

        PrependClassAttribute(attributes, "group/navigation-menu max-w-max flex-1", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Viewport);
        hc.Add(DirectionProviderDir);
        hc.Add(ResolvedDir);
    }
}