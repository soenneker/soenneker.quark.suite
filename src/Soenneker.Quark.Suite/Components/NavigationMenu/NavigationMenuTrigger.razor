@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements INavigationMenuTrigger

<BradixNavigationMenuTrigger Disabled="@ResolvedDisabled"
                            AdditionalAttributes="@TriggerAttributes">
    @ChildContent
    @if (ShowChevron)
    {
        <Icon Name="LucideIcon.ChevronDown"
              Position="_renderCss0"
              Top='_renderCss1'
              Margin="_renderCss2"
              Size="_renderCss3"
              Transition='_renderCss4'
              Duration="_renderCss5"
              Rotate="_chevronRotate"
              aria-hidden="true" />
    }
</BradixNavigationMenuTrigger>

@code {
    private static readonly CssValue<RotateBuilder> _chevronRotate = Quark.Rotate.Is180.Modifier("group-data-[state=open]");
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is9;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsMax;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2_5.OnY.Token("1.5");
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Relative;
    private static readonly CssValue<TopBuilder> _renderCss1 = Quark.Top.Token("[1px]");
    private static readonly CssValue<MarginBuilder> _renderCss2 = Quark.Margin.FromLeft.Is1;
    private static readonly CssValue<SizeBuilder> _renderCss3 = Quark.Size.Is3;
    private static readonly CssValue<TransitionBuilder> _renderCss4 = Quark.Transition.Token("transition");
    private static readonly CssValue<DurationBuilder> _renderCss5 = Quark.Duration.Is300;
    private string? _lastPrependedClass;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public bool ShowChevron { get; set; } = true;

    [CascadingParameter]
    private NavigationMenuItem? ParentNavigationMenuItem { get; set; }

    private bool ResolvedDisabled => Disabled || ParentNavigationMenuItem?.Disabled == true;
    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "navigation-menu-trigger";

        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        RingColor ??= _defaultRingColor;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "hover:bg-muted focus:bg-muted focus-visible:ring-3 focus-visible:outline-1 data-[state=open]:bg-muted/50 data-[state=open]:hover:bg-muted data-[state=open]:focus:bg-muted group/navigation-menu-trigger group", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(Disabled);
        hc.Add(ParentNavigationMenuItem?.Disabled);
        hc.Add(ShowChevron);
    }
}
