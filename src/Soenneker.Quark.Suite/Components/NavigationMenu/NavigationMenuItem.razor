@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements INavigationMenuItem

<CascadingValue Value="@this" IsFixed="true">
    <BradixNavigationMenuItem AdditionalAttributes="@ItemAttributes">
        @ChildContent
    </BradixNavigationMenuItem>
</CascadingValue>

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private string? _lastBuiltClass;

    [Parameter]
    public bool Open { get; set; }

    private IReadOnlyDictionary<string, object> ItemAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "navigation-menu-item";

        Position ??= _defaultPosition;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (Disabled)
            attributes["aria-disabled"] = "true";

        if (Disabled)
            PrependClassAttribute(attributes, "pointer-events-none opacity-50", ref _lastBuiltClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(Disabled);
    }
}