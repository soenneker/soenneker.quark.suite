@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.OverlayElement
@implements INavigationMenuIndicator

<BradixNavigationMenuIndicator ForceMount="@Visible"
                              AdditionalAttributes="@IndicatorAttributes">
    <Div BackgroundColor='_renderCss0'
         Position="_renderCss1"
         Class="top-[60%] rotate-45"
         Height="_renderCss2"
         Width="_renderCss3"
         Rounded="_renderCss4"
         Shadow="_renderCss5"></Div>
</BradixNavigationMenuIndicator>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.End;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is1_5;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss0 = Quark.BackgroundColor.Utility("border");
    private static readonly CssValue<PositionBuilder> _renderCss1 = Quark.Position.Relative;
    private static readonly CssValue<HeightBuilder> _renderCss2 = Quark.Height.Is2;
    private static readonly CssValue<WidthBuilder> _renderCss3 = Quark.Width.Is2;
    private static readonly CssValue<RoundedBuilder> _renderCss4 = Quark.Rounded.TopLeft.Sm;
    private static readonly CssValue<ShadowBuilder> _renderCss5 = Quark.Shadow.Md;
    private string? _lastPrependedClass;

    private IReadOnlyDictionary<string, object> IndicatorAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "navigation-menu-indicator";

        ZIndex ??= "z-[1]";
        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Overflow ??= _defaultOverflow;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "data-[state=visible]:animate-in data-[state=hidden]:animate-out data-[state=hidden]:fade-out data-[state=visible]:fade-in top-full", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Visible);
    }
}