@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IEmptyMedia

<div @attributes="BuildAttributes()">@ChildContent</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromBottom.Is2;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is8;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor2 = Quark.BackgroundColor.Muted;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Foreground;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private string? _lastBuiltClass;

    /// <summary>
    /// Gets or sets the visual style variant.
    /// </summary>
    [Parameter]
    public EmptyMediaVariant Variant { get; set; } = EmptyMediaVariant.Default;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "empty-icon";
        Display ??= _defaultDisplay;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Margin ??= _defaultMargin;

        if (ReferenceEquals(Variant, EmptyMediaVariant.Icon))
        {
            Size ??= _defaultSize;
            Rounded ??= _defaultRounded;
            BackgroundColor ??= _defaultBackgroundColor2;
            TextColor ??= _defaultTextColor;
        }
        else
        {
            BackgroundColor ??= _defaultBackgroundColor;
        }

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-variant"] = ReferenceEquals(Variant, EmptyMediaVariant.Icon) ? "icon" : "default";

        {
            const string @class = "[&_svg]:pointer-events-none [&_svg]:shrink-0";
            const string variant = @class + " " + "[&_svg:not([class*='size-'])]:size-4";
            PrependClassAttribute(attributes, ReferenceEquals(Variant, EmptyMediaVariant.Icon) ? variant : @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Variant);
    }
}