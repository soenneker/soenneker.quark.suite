@namespace Soenneker.Quark
@inject NavigationManager Navigation

@if (ReferenceEquals(Mode, NavigationLinksMode.Header))
{
    @foreach (var item in Items)
    {
        var isActive = IsItemActive(item);
        @if (item.Href is not null)
        {
            <Anchor Href="@item.Href"
                    data-slot="button"
                    data-variant="ghost"
                    data-size="sm"
                    data-active="@BoolString(isActive)"
                    data-new="@BoolString(item.IsNew)"
                    aria-current="@(isActive ? "page" : null)"
                    class="@GetHeaderItemClass(isActive)">
                @item.Title
            </Anchor>
        }
        else
        {
            <Span DataSlot="button"
                  data-variant="ghost"
                  data-size="sm"
                  data-active="false"
                  data-new="@BoolString(item.IsNew)"
                  class="@_disabledHeaderClass">
                @item.Title
            </Span>
        }
    }
}
else if (ReferenceEquals(Mode, NavigationLinksMode.Stack))
{
    <Div Display="_renderCss0" FlexDirection="_renderCss1" Gap="_renderCss2">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <Div TextSize="_renderCss3" FontWeight="_renderCss4" TextColor="_renderCss5">@Title</Div>
        }

        <Div Display="_renderCss0" FlexDirection="_renderCss1" Gap="_renderCss6">
            @{ var viewIndex = 0; }
            @foreach (var item in Items)
            {
                var isActive = IsItemActive(item);
                @if (item.Href is not null)
                {
                    var view = GetStackView(viewIndex++, item);
                    <Anchor Href="@item.Href" PreventDefault="@(view.IsRelativeNavigation && SidebarProvider is not null && SidebarState?.OpenMobile == true)" OnClick="@view.Click" aria-current="@(isActive ? "page" : null)" class="@GetStackItemClass(isActive)">
                        @item.Title
                        @if (item.IsNew)
                        {
                            <Span Size="_renderCss7" Display="_renderCss0" Rounded="_renderCss8" BackgroundColor='_renderCss9' title="New"></Span>
                        }
                    </Anchor>
                }
                else
                {
                    <Span class="@_disabledStackClass">
                        @item.Title
                    </Span>
                }
            }
            @{ TrimStackViews(viewIndex); }
        </Div>
    </Div>
}
else
{
    <SidebarGroup Class="@GroupClass">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <SidebarGroupLabel>@Title</SidebarGroupLabel>
        }

        <SidebarGroupContent>
            <SidebarMenu>
                @foreach (var item in Items)
                {
                    var isActive = IsItemActive(item);
                    <SidebarMenuItem>
                        @if (item.Href is not null)
                        {
                            <SidebarMenuButton Href="@item.Href"
                                               Active="@isActive"
                                               aria-current="@(isActive ? "page" : null)"
                                               Variant="SidebarMenuButtonVariant.Navigation">
                                <Span>@item.Title</Span>
                                @if (item.IsNew)
                                {
                                    <Span Size="_renderCss7" Display="_renderCss0" Rounded="_renderCss8" BackgroundColor='_renderCss9' title="New"></Span>
                                }
                            </SidebarMenuButton>
                        }
                        else
                        {
                            <SidebarMenuButton Variant="SidebarMenuButtonVariant.Navigation"
                                               Opacity="_staticCss0"
                                               aria-disabled="true"
                                               tabindex="-1">
                                <Span>@item.Title</Span>
                                @if (item.IsNew)
                                {
                                    <Span Size="_renderCss7" Display="_renderCss0" Rounded="_renderCss8" BackgroundColor='_renderCss9' title="New"></Span>
                                }
                            </SidebarMenuButton>
                        }
                    </SidebarMenuItem>
                }
            </SidebarMenu>
        </SidebarGroupContent>
    </SidebarGroup>
}

@code {
    private static readonly string _disabledHeaderClass = GetHeaderItemClass(false) + " opacity-75";
    private static readonly string _disabledStackClass = GetStackItemClass(false) + " opacity-70";
    private List<StackItemView>? _stackViews;

    private StackItemView GetStackView(int index, NavigationItem item)
    {
        _stackViews ??= [];
        if (index == _stackViews.Count)
        {
            var added = new StackItemView(this, item);
            _stackViews.Add(added);
            return added;
        }

        var view = _stackViews[index];
        if (!ReferenceEquals(view.Item, item))
            _stackViews[index] = view = new StackItemView(this, item);
        return view;
    }

    private void TrimStackViews(int count)
    {
        if (_stackViews is { } views && views.Count > count)
            views.RemoveRange(count, views.Count - count);
    }

    private static readonly CssValue<OpacityBuilder> _staticCss0 = Quark.Opacity.Is70;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _renderCss1 = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _renderCss2 = Quark.Gap.Is4;
    private static readonly CssValue<TextSizeBuilder> _renderCss3 = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _renderCss4 = Quark.FontWeight.Medium;
    private static readonly CssValue<TextColorBuilder> _renderCss5 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<GapBuilder> _renderCss6 = Quark.Gap.Is3;
    private static readonly CssValue<SizeBuilder> _renderCss7 = Quark.Size.Is2;
    private static readonly CssValue<RoundedBuilder> _renderCss8 = Quark.Rounded.Full;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss9 = Quark.BackgroundColor.Utility("blue-500");
    [CascadingParameter(Name = "SidebarProvider")]
    public SidebarProvider? SidebarProvider { get; set; }

    [CascadingParameter(Name = "SidebarContextState")]
    public Soenneker.Quark.Dtos.SidebarContextState? SidebarState { get; set; }

    [Parameter]
    public IEnumerable<NavigationItem> Items { get; set; } = [];

    [Parameter]
    public NavigationLinksMode Mode { get; set; } = NavigationLinksMode.Sidebar;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? GroupClass { get; set; }

    [Parameter]
    public Func<NavigationItem, bool>? IsActive { get; set; }

    private string? _navigationTargetAfterClose;

    private bool IsItemActive(NavigationItem item)
    {
        return IsActive?.Invoke(item) ?? false;
    }

    private static string BoolString(bool value) => value ? "true" : "false";

    private Task HandleStackItemClick(NavigationItem item) => ShouldHandleStackNavigation(item)
        ? CloseAndNavigateStackItem(item)
        : Task.CompletedTask;

    private Task CloseAndNavigateStackItem(NavigationItem item)
    {
        var href = item.Href;

        if (!href.HasContent())
            return Task.CompletedTask;

        _navigationTargetAfterClose = GetNavigationTarget(href);
        return SidebarProvider!.SetOpenMobile(false);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!ReferenceEquals(Mode, NavigationLinksMode.Stack))
            _stackViews = null;

        if (_navigationTargetAfterClose is null || SidebarState?.OpenMobile == true)
            return;

        var target = _navigationTargetAfterClose;
        _navigationTargetAfterClose = null;
        Navigation.NavigateTo(target);
    }

    private string GetNavigationTarget(string href)
    {
        return href is "." or "./"
            ? Navigation.BaseUri
            : href;
    }

    private bool ShouldHandleStackNavigation(NavigationItem item)
    {
        return CanCoordinateStackNavigation(item) &&
               SidebarState?.OpenMobile == true;
    }

    private bool CanCoordinateStackNavigation(NavigationItem item)
    {
        return item.Href.HasContent() &&
               SidebarProvider is not null &&
               !item.Href!.StartsWith('#') &&
               !Uri.TryCreate(item.Href, UriKind.Absolute, out _);
    }

    private static string GetHeaderItemClass(bool isActive)
    {
        const string baseClass = "inline-flex shrink-0 items-center justify-center text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 h-8 gap-1.5 rounded-md has-[>svg]:px-2.5 px-2.5 relative items-center";

        return isActive
            ? $"{baseClass} bg-accent text-accent-foreground dark:bg-accent/50"
            : baseClass;
    }

    private static string GetStackItemClass(bool isActive)
    {
        const string baseClass = "inline-flex items-center gap-2 text-2xl leading-none font-medium transition-all";

        return isActive
            ? $"{baseClass} text-foreground"
            : $"{baseClass} text-foreground hover:text-foreground/80";
    }
}
