@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement

@if (HasContent)
{
    <div @attributes="BuildAttributes()" role="alert">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (UniqueErrorMessages.Count == 1)
        {
            @UniqueErrorMessages[0]
        }
        else if (UniqueErrorMessages.Count > 1)
        {
            <UnorderedList Margin="_renderCss0" Display="_renderCss1" ListStyleType="_renderCss2" Flex="_renderCss3" Gap="_renderCss4">
                @foreach (var message in UniqueErrorMessages)
                {
                    <UnorderedListItem>@message</UnorderedListItem>
                }
            </UnorderedList>
        }
    </div>
}

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromTop.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Normal;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Destructive;
    private static readonly CssValue<MarginBuilder> _renderCss0 = Quark.Margin.FromLeft.Is4;
    private static readonly CssValue<DisplayBuilder> _renderCss1 = Quark.Display.Flex;
    private static readonly CssValue<ListStyleTypeBuilder> _renderCss2 = Quark.ListStyleType.Disc;
    private static readonly CssValue<FlexBuilder> _renderCss3 = Quark.Flex.Col;
    private static readonly CssValue<GapBuilder> _renderCss4 = Quark.Gap.Is1;
    [Parameter]
    public IReadOnlyList<string?>? Errors { get; set; }

    [CascadingParameter]
    private FieldContext? FieldContext { get; set; }

    private IDisposable? _registration;
    private FieldContext? _registeredContext;
    private IReadOnlyList<string> _uniqueErrorMessages = [];
    private IReadOnlyList<string> UniqueErrorMessages => _uniqueErrorMessages;

    private bool HasContent => ChildContent is not null || UniqueErrorMessages.Count > 0;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _uniqueErrorMessages = BuildUniqueErrorMessages(Errors);

        var contextToRegister = HasContent ? FieldContext : null;

        if (!ReferenceEquals(_registeredContext, contextToRegister))
        {
            _registration?.Dispose();
            _registeredContext = contextToRegister;
            _registration = contextToRegister?.RegisterError();
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "field-error";

        Margin ??= _defaultMargin;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= _defaultTextColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        if (FieldContext is not null && !attributes.ContainsKey("id"))
            attributes["id"] = FieldContext.ErrorId;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(HasContent);
        if (Errors is not null)
        {
            foreach (var error in Errors)
                hc.Add(error);
        }
        hc.Add(FieldContext?.ErrorId);
    }

    public override async ValueTask DisposeAsync()
    {
        _registration?.Dispose();
        await base.DisposeAsync();
    }

    private string?[] _errorSnapshot = [];
    private List<string>? _messageBuffer;
    private HashSet<string>? _messageSet;

    private IReadOnlyList<string> BuildUniqueErrorMessages(IReadOnlyList<string?>? errors)
    {
        int count = errors?.Count ?? 0;
        bool unchanged = count == _errorSnapshot.Length;
        if (unchanged)
        {
            for (int i = 0; i < count; i++)
            {
                if (!string.Equals(errors![i], _errorSnapshot[i], StringComparison.Ordinal))
                {
                    unchanged = false;
                    break;
                }
            }
            if (unchanged)
                return _uniqueErrorMessages;
        }

        if (_errorSnapshot.Length != count)
            _errorSnapshot = count == 0 ? [] : new string?[count];
        _messageBuffer?.Clear();
        _messageSet?.Clear();
        for (int i = 0; i < count; i++)
        {
            string? error = errors![i];
            _errorSnapshot[i] = error;
            if (string.IsNullOrWhiteSpace(error))
                continue;

            var messages = _messageBuffer ??= [];
            string message = error.Trim();
            bool added;
            if (messages.Count < 8)
                added = !messages.Contains(message);
            else
            {
                if (_messageSet is null)
                    _messageSet = new HashSet<string>(messages, StringComparer.Ordinal);
                else if (_messageSet.Count == 0)
                    _messageSet.UnionWith(messages);
                added = _messageSet.Add(message);
            }
            if (added)
                messages.Add(message);
        }
        return _messageBuffer ?? (IReadOnlyList<string>)Array.Empty<string>();
    }
}
