@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.TypographyElement
@implements IFieldLabel

<BradixLabel For="@ResolvedFor"
             AdditionalAttributes="@BuildAttributes()">
    @ChildContent
    @if (RequiredIndicator)
    {
        <Span Class="field-required">*</Span>
    }
</BradixLabel>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Snug;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private string? _lastPrependedClass;

    /// <summary>
    /// Gets or sets the for attribute, which associates the label with a form control.
    /// </summary>
    [Parameter]
    public string? For { get; set; }

    /// <summary>
    /// Gets or sets whether to show the required indicator.
    /// </summary>
    [Parameter]
    public bool RequiredIndicator { get; set; }

    // Prefer a simple cascading bool rather than poking into ParentField.
    [CascadingParameter(Name = "FieldHorizontal")]
    protected bool FieldHorizontal { get; set; }

    [CascadingParameter]
    private FieldContext? FieldContext { get; set; }

    protected virtual bool IsHorizontal => FieldHorizontal;
    private string? ResolvedFor => For.HasContent() ? For! : FieldContext?.ControlId;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "field-label";

        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Leading ??= _defaultLeading;
        UserSelect ??= _defaultUserSelect;
        ItemsAlign ??= _staticCss0;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        {
            const string @class = "group/field-label peer/field-label flex gap-2 leading-snug group-data-[disabled=true]/field:opacity-50 group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 has-[[data-state=checked]]:border-primary/30 has-[[data-state=checked]]:bg-primary/5 has-[>[data-slot=field]]:w-full has-[>[data-slot=field]]:flex-col has-[>[data-slot=field]]:rounded-lg has-[>[data-slot=field]]:border *:data-[slot=field]:p-2.5 dark:has-[[data-state=checked]]:border-primary/20 dark:has-[[data-state=checked]]:bg-primary/10";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(For);
        hc.Add(RequiredIndicator);
        hc.Add(IsHorizontal);
        hc.Add(FieldContext?.ControlId);
    }
}
