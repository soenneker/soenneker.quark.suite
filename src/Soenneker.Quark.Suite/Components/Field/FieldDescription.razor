@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement

@if (HasContent)
{
    <p @attributes="BuildAttributes()">
        @ChildContent
    </p>
}

@code {
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Normal;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Normal;
    private static readonly CssValue<TextAlignBuilder> _defaultTextAlign = Quark.TextAlign.Left;
    private string? _lastPrependedClass;

    [CascadingParameter]
    private FieldContext? FieldContext { get; set; }

    private IDisposable? _registration;
    private FieldContext? _registeredContext;
    private bool HasContent => ChildContent is not null;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var contextToRegister = HasContent ? FieldContext : null;

        if (!ReferenceEquals(_registeredContext, contextToRegister))
        {
            _registration?.Dispose();
            _registeredContext = contextToRegister;
            _registration = contextToRegister?.RegisterDescription();
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "field-description";
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= _defaultTextColor;
        Leading ??= _defaultLeading;
        TextAlign ??= _defaultTextAlign;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        if (FieldContext is not null && !attributes.ContainsKey("id"))
            attributes["id"] = FieldContext.DescriptionId;
        PrependClassAttribute(attributes, "group-data-[orientation=horizontal]/field:text-balance last:mt-0 nth-last-2:-mt-1 [[data-variant=legend]+&]:-mt-1.5 [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(HasContent);
        hc.Add(FieldContext?.DescriptionId);
    }

    public override async ValueTask DisposeAsync()
    {
        _registration?.Dispose();
        await base.DisposeAsync();
    }
}
