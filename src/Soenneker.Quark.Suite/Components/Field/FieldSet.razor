@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@inject IFieldLayoutInterop FieldLayoutInterop

<fieldset @ref="_fieldset" @attributes="BuildAttributes()">
    @ChildContent
</fieldset>

@code {
    private ElementReference _fieldset;
    private bool _observed;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender || _disposed) return;
        await FieldLayoutInterop.Observe(_fieldset);
        _observed = true;
        if (_disposed) await FieldLayoutInterop.Unobserve(_fieldset);
    }

    public override async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_observed) await FieldLayoutInterop.Unobserve(_fieldset);
        }
        finally { await base.DisposeAsync(); }
    }

    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is4;
    private string? _lastPrependedClass;

    [Parameter]
    public bool Disabled { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "field-set";

        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Gap ??= _defaultGap;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (Disabled)
            attributes["disabled"] = QuarkAttributeValues.True;

        PrependClassAttribute(attributes, "has-[>[data-slot=checkbox-group]]:gap-3 has-[>[data-slot=radio-group]]:gap-3", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Disabled);
    }
}
