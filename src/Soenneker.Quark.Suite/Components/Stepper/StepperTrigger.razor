@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (AsChild)
{
    <span @attributes="BuildAttributes()">
        @ChildContent
    </span>
}
else
{
    <button @ref="_button" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)" @attributes="BuildAttributes()">
        @ChildContent
    </button>
}

@code {
    private static readonly CssValue<DisplayBuilder> _conditionalCss0 = Quark.Display.Flex;
    private static readonly CssValue<DisplayBuilder> _conditionalCss1 = Quark.Display.InlineFlex;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Items.Center;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.OnDisabled.None;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.OnDisabled.Is60;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2_5;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private ElementReference _button;
    private string? _tabId;
    private string? _panelId;
    private Stepper? _registeredParent;
    private int _registeredStep;

    [CascadingParameter(Name = nameof(ParentStepper))]
    internal Stepper? ParentStepper { get; set; }

    [CascadingParameter(Name = nameof(ParentStepperItem))]
    internal StepperItemContext? ParentStepperItem { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    private int Step => ParentStepperItem?.Step ?? 0;
    private string StepValue => ParentStepperItem?.Value ?? Step.ToString();
    private bool Selected => ParentStepper?.IsStepActive(Step, StepValue) == true;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_registeredParent != ParentStepper || _registeredStep != Step || AsChild)
        {
            _registeredParent?.UnregisterTrigger(_registeredStep);
            _registeredParent = null;
        }

        if (!AsChild && Step > 0)
        {
            ParentStepper?.RegisterTrigger(Step, _button);
            _registeredParent = ParentStepper;
            _registeredStep = Step;
        }

        base.OnAfterRender(firstRender);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "stepper-trigger";
        Display ??= ParentStepperItem?.IsStacked == true ? _conditionalCss0 : _conditionalCss1;
        Cursor ??= _defaultCursor;
        ItemsAlign ??= _defaultItemsAlign;
        OutlineStyle ??= _defaultOutlineStyle;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
        Rounded ??= _defaultRounded;
        Gap ??= _defaultGap;

        if (ParentStepperItem?.IsStacked == true)
            FlexDirection ??= _defaultFlexDirection;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (AsChild)
        {
            attributes["data-state"] = ParentStepperItem?.State ?? "inactive";

            if (ParentStepperItem?.Loading == true)
                attributes["data-loading"] = "true";

            return;
        }

        attributes["type"] = "button";
        attributes["role"] = "tab";
        attributes["id"] = QuarkStringCache.Concat(ParentStepper?.IdPrefix ?? "stepper", "-tab-", StepValue, ref _tabId);
        attributes["aria-selected"] = Selected ? "true" : "false";
        attributes["aria-controls"] = QuarkStringCache.Concat(ParentStepper?.IdPrefix ?? "stepper", "-panel-", StepValue, ref _panelId);
        attributes["tabindex"] = Selected ? QuarkAttributeValues.Zero : QuarkAttributeValues.MinusOne;
        attributes["data-state"] = ParentStepperItem?.State ?? "inactive";
        attributes["data-loading"] = ParentStepperItem?.Loading == true ? "true" : "false";

        if (ParentStepperItem?.Disabled == true)
            attributes["disabled"] = QuarkAttributeValues.True;

    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (ParentStepperItem?.Disabled == true)
            return;

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);

        if (ParentStepper is not null && Step > 0)
            await ParentStepper.SetActiveStep(Step, StepValue);
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        return ParentStepper is not null && Step > 0
            ? ParentStepper.HandleTriggerKeyDown(Step, args)
            : Task.CompletedTask;
    }

    public override async ValueTask DisposeAsync()
    {
        _registeredParent?.UnregisterTrigger(_registeredStep);
        _registeredParent = null;
        await base.DisposeAsync();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Step);
        hc.Add(StepValue);
        hc.Add(Selected);
        hc.Add(ParentStepperItem);
        hc.Add(AsChild);
    }
}
