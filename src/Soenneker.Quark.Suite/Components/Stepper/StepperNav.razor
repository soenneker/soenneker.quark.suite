@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<nav @attributes="BuildAttributes()">@ChildContent</nav>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection3 = Quark.FlexDirection.Col.OnMd.Row;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Quark.Items.Start.OnMd.Center;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection2 = Quark.FlexDirection.Col;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Row;
    [CascadingParameter(Name = nameof(ParentStepper))]
    internal Stepper? ParentStepper { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "stepper-nav";
        Display ??= _defaultDisplay;

        if (ParentStepper?.Responsive == true)
        {
            Width ??= _defaultWidth;
            FlexDirection ??= _defaultFlexDirection3;
            ItemsAlign ??= _defaultItemsAlign;
        }
        else if (ParentStepper?.ResolvedOrientation == "vertical")
        {
            FlexDirection ??= _defaultFlexDirection2;
        }
        else
        {
            Width ??= _defaultWidth;
            FlexDirection ??= _defaultFlexDirection;
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-state"] = ParentStepper?.ActiveValue ?? "1";
        attributes["data-orientation"] = ParentStepper?.ResolvedOrientation ?? "horizontal";
    }
}
