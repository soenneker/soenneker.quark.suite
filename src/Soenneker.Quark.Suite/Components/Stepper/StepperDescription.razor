@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">@ChildContent</div>

@code {
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize2 = Quark.TextSize.Xs;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.None.OnMd.Block;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    [CascadingParameter(Name = nameof(ParentStepperItem))]
    internal StepperItemContext? ParentStepperItem { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "stepper-description";
        TextColor ??= _defaultTextColor;

        if (ParentStepperItem?.IsStacked == true)
        {
            TextSize ??= _defaultTextSize2;
            FontWeight ??= _defaultFontWeight;
            Whitespace ??= _defaultWhitespace;
            Display ??= _defaultDisplay;
        }
        else
        {
            TextSize ??= _defaultTextSize;
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-state"] = ParentStepperItem?.State ?? "inactive";
    }
}
