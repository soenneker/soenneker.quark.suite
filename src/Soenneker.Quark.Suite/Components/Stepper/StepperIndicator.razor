@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">
    <Div Position="_renderCss0">
        @if (IndicatorContent is not null)
        {
            @IndicatorContent
        }
        else
        {
            @ChildContent
        }
    </Div>
</div>

@code {
    private static readonly CssValue<BorderBuilder> _stateCss0 = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _stateCss1 = Quark.BorderColor.Token("foreground");
    private static readonly CssValue<BorderColorBuilder> _stateCss2 = Quark.BorderColor.Border;
    private static readonly CssValue<BorderColorBuilder> _stateCss3 = Quark.BorderColor.Background;
    private static readonly CssValue<BackgroundColorBuilder> _stateCss4 = Quark.BackgroundColor.Background;
    private static readonly CssValue<BackgroundColorBuilder> _stateCss5 = Quark.BackgroundColor.Primary;
    private static readonly CssValue<BackgroundColorBuilder> _stateCss6 = Quark.BackgroundColor.Muted;
    private static readonly CssValue<TextColorBuilder> _stateCss7 = Quark.TextColor.Foreground;
    private static readonly CssValue<TextColorBuilder> _stateCss8 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TextColorBuilder> _stateCss9 = Quark.TextColor.PrimaryForeground;
    private static readonly CssValue<RingBuilder> _stateCss10 = Quark.Ring.Is2;
    private static readonly CssValue<RingColorBuilder> _stateCss11 = Quark.RingColor.Token("primary/30");
    private static readonly CssValue<RingOffsetBuilder> _stateCss12 = Quark.RingOffset.Background.Width(3);
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is8;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Quark.Items.Center;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<DurationBuilder> _defaultDuration = Quark.Duration.Is300;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Absolute;
    [CascadingParameter(Name = nameof(ParentStepper))]
    internal Stepper? ParentStepper { get; set; }

    [CascadingParameter(Name = nameof(ParentStepperItem))]
    internal StepperItemContext? ParentStepperItem { get; set; }

    [Parameter]
    public StepperIndicatorVariant Variant { get; set; } = StepperIndicatorVariant.Default;

    private RenderFragment? IndicatorContent => ParentStepper?.GetIndicator(ParentStepperItem?.State ?? "inactive", ParentStepperItem?.Loading == true);

    private bool IsActive => ParentStepperItem?.State == "active";
    private bool IsCompleted => ParentStepperItem?.State == "completed";
    private bool IsOutline => ReferenceEquals(Variant, StepperIndicatorVariant.Outline);

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "stepper-indicator";

        if (!HasExplicitParameter(nameof(Border)))
        {
            if (IsOutline)
                Border = _stateCss0;
            else
                Border = null;
        }

        if (!HasExplicitParameter(nameof(BorderColor)))
            BorderColor = IsOutline
                ? IsActive ? _stateCss1 : _stateCss2
                : _stateCss3;

        if (!HasExplicitParameter(nameof(BackgroundColor)))
            BackgroundColor = IsOutline
                ? _stateCss4
                : IsActive || IsCompleted ? _stateCss5 : _stateCss6;

        if (!HasExplicitParameter(nameof(TextColor)))
        {
            if (IsOutline)
                TextColor = IsActive || IsCompleted ? _stateCss7 : _stateCss8;
            else if (IsActive || IsCompleted)
                TextColor = _stateCss9;
            else
                TextColor = null;
        }

        if (!HasExplicitParameter(nameof(Ring)))
        {
            if (!IsOutline && IsActive)
                Ring = _stateCss10;
            else
                Ring = null;
        }

        if (!HasExplicitParameter(nameof(RingColor)))
        {
            if (!IsOutline && IsActive)
                RingColor = _stateCss11;
            else
                RingColor = null;
        }

        if (!HasExplicitParameter(nameof(RingOffset)))
        {
            if (!IsOutline && IsActive)
                RingOffset = _stateCss12;
            else
                RingOffset = null;
        }

        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        Size ??= _defaultSize;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _defaultItemsAlign;
        Justify ??= _defaultJustify;
        Overflow ??= _defaultOverflow;
        Transition ??= _defaultTransition;
        Duration ??= _defaultDuration;
        Rounded ??= _defaultRounded;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-state"] = ParentStepperItem?.State ?? "inactive";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentStepperItem);
        hc.Add(ParentStepper?.ActiveStep);
        hc.Add(ParentStepper?.Indicators);
        hc.Add(ParentStepper?.ActiveIndicator);
        hc.Add(ParentStepper?.CompletedIndicator);
        hc.Add(ParentStepper?.InactiveIndicator);
        hc.Add(ParentStepper?.LoadingIndicator);
        hc.Add(Variant);
    }
}
