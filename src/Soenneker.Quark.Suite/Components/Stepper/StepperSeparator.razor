@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()"></div>

@code {
    private static readonly CssValue<BackgroundColorBuilder> _completedBackground = Quark.BackgroundColor.Primary;
    private static readonly CssValue<BackgroundColorBuilder> _inactiveBackground = Quark.BackgroundColor.Muted;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Sm;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private static readonly CssValue<DurationBuilder> _defaultDuration = Quark.Duration.Is500;
    private static readonly CssValue<MarginBuilder> _defaultMargin2 = Quark.Margin.FromStart.Is4.OnMd.Is2;
    private static readonly CssValue<HeightBuilder> _defaultHeight3 = Quark.Height.Is8.OnMd.Is0_5;
    private static readonly CssValue<FlexBuilder> _defaultFlex2 = Quark.Flex.None.OnMd.Is1;
    private static readonly CssValue<HeightBuilder> _defaultHeight2 = Quark.Height.Is12;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.Is0_5;
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.Is2;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is0_5;
    private static readonly CssValue<FlexBuilder> _defaultFlex = Quark.Flex.Is1;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _defaultInset = Quark.Inset.OnX.Is0;
    private static readonly CssValue<TopBuilder> _defaultTop = Quark.Top.Is2;
    private static readonly CssValue<RightBuilder> _defaultRight = Quark.Right.Token("[calc(-50%+18px)]");
    private static readonly CssValue<LeftBuilder> _defaultLeft = Quark.Left.Token("[calc(50%+18px)]");
    [CascadingParameter(Name = nameof(ParentStepperItem))]
    internal StepperItemContext? ParentStepperItem { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "stepper-separator";
        Rounded ??= _defaultRounded;
        Transition ??= _defaultTransition;
        Duration ??= _defaultDuration;

        if (!HasExplicitParameter(nameof(BackgroundColor)))
            BackgroundColor = ParentStepperItem?.State == "completed" ? _completedBackground : _inactiveBackground;

        if (ParentStepperItem?.Responsive == true)
        {
            Margin ??= _defaultMargin2;
            Height ??= _defaultHeight3;
            Width ??= _defaultWidth;
            Flex ??= _defaultFlex2;
        }
        else if (ParentStepperItem?.Orientation == "vertical")
        {
            Margin ??= _defaultMargin;
            Height ??= _defaultHeight2;
            Width ??= _defaultWidth;
        }
        else
        {
            Margin ??= _defaultMargin;
            Height ??= _defaultHeight;
            Flex ??= _defaultFlex;
        }

        if (ParentStepperItem is { IsStacked: true, Orientation: "horizontal" })
        {
            Position ??= _defaultPosition;
            Inset ??= _defaultInset;
            Top ??= _defaultTop;
            Right ??= _defaultRight;
            Left ??= _defaultLeft;
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-state"] = ParentStepperItem?.State ?? "inactive";
    }
}
