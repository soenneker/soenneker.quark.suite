@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (ForceMount || IsActive)
{
    <div @attributes="BuildAttributes()">@ChildContent</div>
}

@code {
    private string? _panelId;
    private string? _tabId;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    [CascadingParameter(Name = nameof(ParentStepper))]
    internal Stepper? ParentStepper { get; set; }

    [Parameter]
    [EditorRequired]
    public int Value { get; set; }

    [Parameter]
    public string? ValueKey { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }

    private string ResolvedValue => ParentStepper?.GetStepValue(Value, ValueKey) ?? Value.ToString();

    private bool IsActive => ParentStepper?.IsStepActive(Value, ResolvedValue) == true;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "stepper-content";
        Width ??= _defaultWidth;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["role"] = "tabpanel";
        attributes["id"] = QuarkStringCache.Concat("stepper-panel-", "", ResolvedValue, ref _panelId);
        attributes["aria-labelledby"] = QuarkStringCache.Concat("stepper-tab-", "", ResolvedValue, ref _tabId);
        attributes["data-state"] = ParentStepper?.ActiveValue ?? "1";

        if (!IsActive && ForceMount)
        {
            attributes["hidden"] = QuarkAttributeValues.True;
            attributes["aria-hidden"] = "true";
            attributes["inert"] = QuarkAttributeValues.True;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(ValueKey);
        hc.Add(ForceMount);
        hc.Add(ParentStepper?.ActiveValue);
    }
}
