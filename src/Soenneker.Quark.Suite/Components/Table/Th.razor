@namespace Soenneker.Quark
@inherits Element

<th @attributes="BuildAttributes()">
    @if (Sortable)
    {
        <button type="button" class="@GetSortButtonClass()" @onclick="HandleClick">
            @ChildContent <span aria-hidden="true">@GetSortIndicator()</span>
        </button>
    }
    else
    {
        @ChildContent
    }
</th>

@code {
	[CascadingParameter(Name = nameof(DataTable))]
	private IDataTable? DataTable { get; set; }

	/// <summary>
	/// Gets or sets whether the column is sortable.
	/// </summary>
	[Parameter]
	public bool Sortable { get; set; }

	/// <summary>
	/// Gets or sets whether the column is searchable.
	/// </summary>
	[Parameter]
	public bool Searchable { get; set; }

	/// <summary>
	/// Gets or sets the text alignment for the column.
	/// </summary>
	[Parameter]
	public string HeaderAlign { get; set; } = string.Empty;

	/// <summary>
	/// Gets or sets the data attribute value.
	/// </summary>
	[Parameter]
	public string? Data { get; set; }

	[Parameter]
	public string? Name { get; set; }

	private int _columnIndex = -1;

	protected override void OnInitialized()
	{
		// Register this column with the parent table to get its position
		if (DataTable != null)
		{
			_columnIndex = DataTable.RegisterColumn(this);
		}
	}

	private async Task HandleClick(MouseEventArgs e)
	{
		if (!Sortable || DataTable == null)
			return;

		await DataTable.HandleColumnSort(_columnIndex);
	}

	private string GetSortClass()
	{
		if (DataTable == null)
			return string.Empty;

		return DataTable.GetSortClassByIndex(_columnIndex);
	}

	private string GetSortIndicator()
	{
		if (DataTable == null)
			return " ↕";

		return DataTable.GetSortIndicatorByIndex(_columnIndex);
	}

	private string GetAlignStyle()
	{
		if (HeaderAlign.IsNullOrWhiteSpace())
			return string.Empty;

		var align = HeaderAlign.ToLowerInvariantFast();

		return align switch
		{
			"left" => "text-align: left;",
			"center" => "text-align: center;",
			"right" => "text-align: right;",
			_ => string.Empty
		};
	}

	protected override void ApplyDefaultParameters()
	{
		base.ApplyDefaultParameters();
		DataSlot ??= "table-head";
		Height ??= Quark.Height.Is10;
		Padding ??= Quark.Padding.OnX.Is2;
		TextAlign ??= Quark.TextAlign.Start;
		VerticalAlign ??= Quark.VerticalAlign.Middle;
		FontWeight ??= Quark.FontWeight.Medium;
		Whitespace ??= Quark.Whitespace.Nowrap;
		TextColor ??= Quark.TextColor.Foreground;

	}

	protected override void BuildAttributesCore(Dictionary<string, object> attributes)
	{
		base.BuildAttributesCore(attributes);
		attributes.TryAdd("scope", "col");

		if (Sortable)
		{
			attributes["aria-sort"] = GetAriaSort();
		}


		BuildClassAttribute(attributes, (ref cls) =>
		{
			AppendClass(ref cls, "[&:has([role=checkbox])]:pe-0");
			if (Sortable)
			{
				var sortClass = GetSortClass();
				if (sortClass.HasContent())
					AppendClass(ref cls, sortClass);
			}
		});

		var alignStyle = GetAlignStyle();
		if (alignStyle.HasContent())
		{
			BuildStyleAttribute(attributes, (ref sty) =>
			{
				if (alignStyle.HasContent())
					AppendStyleDecl(ref sty, alignStyle);
			});
		}
	}

	private string GetAriaSort() => DataTable?.GetSortDirection(_columnIndex) switch
	{
		"asc" => "ascending",
		"desc" => "descending",
		_ => "none"
	};

	private string GetSortButtonClass()
	{
		const string baseClass = "inline-flex w-full cursor-pointer items-center gap-1 bg-transparent p-0 text-inherit";
		return HeaderAlign.ToLowerInvariantFast() switch
		{
			"center" => $"{baseClass} justify-center",
			"right" => $"{baseClass} justify-end",
			_ => baseClass
		};
	}

	protected override void ComputeRenderKeyCore(ref HashCode hc)
	{
		base.ComputeRenderKeyCore(ref hc);
		hc.Add(Sortable);
		hc.Add(Searchable);
		hc.Add(HeaderAlign);
		hc.Add(Data);
		hc.Add(Name);
		hc.Add(_columnIndex);
	}
}
