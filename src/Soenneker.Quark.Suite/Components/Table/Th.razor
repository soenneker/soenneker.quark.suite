@namespace Soenneker.Quark
@inherits Element

<th @attributes="BuildAttributes()">
    @if (Sortable)
    {
        <button type="button" class="@GetSortButtonClass()" @onclick="(_cachedHandleClickDelegate ??= HandleClick)">
            @ChildContent <span aria-hidden="true">@GetSortIndicator()</span>
        </button>
    }
    else
    {
        @ChildContent
    }
</th>

@code {
    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);

        if (Colspan.HasValue)
            attributes["colspan"] = QuarkAttributeValues.FromInt32(Colspan.Value);

        if (HtmlRowSpan.HasValue)
            attributes["rowspan"] = QuarkAttributeValues.FromInt32(HtmlRowSpan.Value);

        if (Headers is not null)
            attributes["headers"] = Headers;

        if (Scope is not null)
            attributes["scope"] = Scope;

        if (Abbr is not null)
            attributes["abbr"] = Abbr;

        if (AriaSort is not null)
            attributes["aria-sort"] = AriaSort;

    }


    /// <summary>
    /// Gets or sets the HTML colspan attribute.
    /// </summary>
    [Parameter]
    public int? Colspan { get; set; }

    /// <summary>
    /// Gets or sets the HTML rowspan attribute.
    /// </summary>
    [Parameter]
    public int? HtmlRowSpan { get; set; }

    /// <summary>
    /// Gets or sets the HTML headers attribute.
    /// </summary>
    [Parameter]
    public string? Headers { get; set; }

    /// <summary>
    /// Gets or sets the HTML scope attribute.
    /// </summary>
    [Parameter]
    public string? Scope { get; set; }

    /// <summary>
    /// Gets or sets the HTML abbr attribute.
    /// </summary>
    [Parameter]
    public string? Abbr { get; set; }

    /// <summary>
    /// Gets or sets the HTML aria-sort attribute.
    /// </summary>
    [Parameter]
    public string? AriaSort { get; set; }


    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is10;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2;
    private static readonly CssValue<TextAlignBuilder> _defaultTextAlign = Quark.TextAlign.Start;
    private static readonly CssValue<VerticalAlignBuilder> _defaultVerticalAlign = Quark.VerticalAlign.Middle;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Foreground;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;

    private Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    [CascadingParameter(Name = nameof(DataTable))]
    private IDataTable? DataTable { get; set; }

    /// <summary>
    /// Gets or sets whether the column is sortable.
    /// </summary>
    [Parameter]
    public bool Sortable { get; set; }

    /// <summary>
    /// Gets or sets whether the column is searchable.
    /// </summary>
    [Parameter]
    public bool Searchable { get; set; }

    /// <summary>
    /// Gets or sets the text alignment for the column.
    /// </summary>
    [Parameter]
    public string HeaderAlign { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the data attribute value.
    /// </summary>
    [Parameter]
    public string? Data { get; set; }

    [Parameter]
    public string? Name { get; set; }

    private string? _lastSortClass;
    private int _columnIndex = -1;

    protected override void OnInitialized()
    {
        // Register this column with the parent table to get its position
        if (DataTable != null)
        {
            _columnIndex = DataTable.RegisterColumn(this);
        }
    }

    internal void SetColumnIndex(int index)
    {
        _columnIndex = index;
        InvalidateRender();
    }

    public override async ValueTask DisposeAsync()
    {
        if (DataTable is DataTable table)
            table.UnregisterColumn(this);
        await base.DisposeAsync();
    }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!Sortable || DataTable == null)
            return;

        await DataTable.HandleColumnSort(_columnIndex);
    }

    private string GetSortClass()
    {
        if (DataTable == null)
            return string.Empty;

        return DataTable.GetSortClassByIndex(_columnIndex);
    }

    private string GetSortIndicator()
    {
        if (DataTable == null)
            return " â†•";

        return DataTable.GetSortIndicatorByIndex(_columnIndex);
    }

    private string GetAlignStyle()
    {
        if (HeaderAlign.IsNullOrWhiteSpace())
            return string.Empty;

        if (string.Equals(HeaderAlign, "left", StringComparison.OrdinalIgnoreCase))
            return "text-align: left;";
        if (string.Equals(HeaderAlign, "center", StringComparison.OrdinalIgnoreCase))
            return "text-align: center;";
        return string.Equals(HeaderAlign, "right", StringComparison.OrdinalIgnoreCase) ? "text-align: right;" : string.Empty;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table-head";
        Height ??= _defaultHeight;
        Padding ??= _defaultPadding;
        TextAlign ??= _defaultTextAlign;
        VerticalAlign ??= _defaultVerticalAlign;
        FontWeight ??= _defaultFontWeight;
        Whitespace ??= _defaultWhitespace;
        TextColor ??= _defaultTextColor;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes.TryAdd("scope", "col");

        if (Sortable)
        {
            attributes["aria-sort"] = GetAriaSort();
        }


        var sortClass = Sortable ? GetSortClass() : null;
        if (sortClass.HasContent())
            PrependClassAttribute(attributes, sortClass!, ref _lastSortClass);
        PrependClassAttribute(attributes, "[&:has([role=checkbox])]:pe-0", ref _lastBuiltClass);
        var alignStyle = GetAlignStyle();
        if (alignStyle.HasContent())
            PrependStyleAttribute(attributes, alignStyle, ref _lastBuiltStyle);
    }

    private string GetAriaSort() => DataTable?.GetSortDirection(_columnIndex) switch
    {
        "asc" => "ascending",
        "desc" => "descending",
        _ => "none"
    };

    private string GetSortButtonClass()
    {
        const string baseClass = "inline-flex w-full cursor-pointer items-center gap-1 bg-transparent p-0 text-inherit";
        if (string.Equals(HeaderAlign, "center", StringComparison.OrdinalIgnoreCase))
            return baseClass + " justify-center";
        return string.Equals(HeaderAlign, "right", StringComparison.OrdinalIgnoreCase) ? baseClass + " justify-end" : baseClass;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Colspan);
        hc.Add(HtmlRowSpan);
        hc.Add(Headers);
        hc.Add(Scope);
        hc.Add(Abbr);
        hc.Add(AriaSort);

        hc.Add(Sortable);
        hc.Add(Searchable);
        hc.Add(HeaderAlign);
        hc.Add(Data);
        hc.Add(Name);
        hc.Add(_columnIndex);
        hc.Add(DataTable?.GetSortDirection(_columnIndex));
    }
}
