@using Soenneker.Utils.Debounce

@namespace Soenneker.Quark
@inherits CancellableElement

<div @attributes="BuildAttributes()">
	<Input Type="text"
	       Value="@SearchTerm"
	       OnInput="(_cachedOnSearchInputHandlerDelegate ??= OnSearchInputHandler)"
	       Placeholder="@Placeholder"
	       Height="_renderCss0"
	       Width="_renderCss1"
	       MinWidth="_staticCss1"
	       Rounded="_renderCss2"
	       Border="_renderCss3"
	       BorderColor="_renderCss4"
	       BackgroundColor="_renderCss5"
	       Padding="_renderCss6"
	       TextSize="_renderCss7"
	       TextColor='_renderCss8'
	       RingColor="_renderCss9"
	       PointerEvents="_renderCss10"
	       Cursor="_renderCss11"
	       Opacity="_renderCss12"
	       Transition="_renderCss13"
	       OutlineStyle="_renderCss14"
	       Attributes="BuildInputAttributes()" />
</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<MinWidthBuilder> _staticCss1 = Quark.MinWidth.Is0;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<HeightBuilder> _renderCss0 = Quark.Height.Is8;
    private static readonly CssValue<WidthBuilder> _renderCss1 = Quark.Width.IsFull;
    private static readonly CssValue<RoundedBuilder> _renderCss2 = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _renderCss3 = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _renderCss4 = Quark.BorderColor.Input.OnFocusVisible.Ring;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss5 = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<PaddingBuilder> _renderCss6 = Quark.Padding.OnX.Is2_5.OnY.Is1;
    private static readonly CssValue<TextSizeBuilder> _renderCss7 = Quark.TextSize.Base.OnMd.Sm;
    private static readonly CssValue<TextColorBuilder> _renderCss8 = Quark.TextColor.MutedForeground.Modifier("placeholder");
    private static readonly CssValue<RingColorBuilder> _renderCss9 = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<PointerEventsBuilder> _renderCss10 = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<CursorBuilder> _renderCss11 = Quark.Cursor.NotAllowed.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _renderCss12 = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<TransitionBuilder> _renderCss13 = Quark.Transition.Colors;
    private static readonly CssValue<OutlineStyleBuilder> _renderCss14 = Quark.OutlineStyle.None;
    private Func<ChangeEventArgs, Task>? _cachedOnSearchInputHandlerDelegate;

    private string? _lastPrependedClass;

    private QuarkAttributeDictionary _inputAttributes;
	// shadcn input in table toolbar - new-york-v4 ui/input.tsx
	protected override void ApplyDefaultParameters()
	{
		base.ApplyDefaultParameters();
		DataSlot ??= "datatable-search";
		Display ??= _defaultDisplay;
		Width ??= _renderCss1;
		ItemsAlign ??= _staticCss0;
		Gap ??= _defaultGap;

	}

	protected override void BuildAttributesCore(Dictionary<string, object> attributes)
	{
		base.BuildAttributesCore(attributes);

		PrependClassAttribute(attributes, "sm:max-w-sm", ref _lastPrependedClass);
	}

	private Dictionary<string, object> BuildInputAttributes()
	{
		var attributes = _inputAttributes.Create(3);
		attributes["data-slot"] = "datatable-search-input";
		attributes["aria-label"] = AriaLabel ?? "Search table";
		attributes["class"] = "focus-visible:ring-[3px]";

		return attributes;
	}

	[CascadingParameter(Name = "DataTable")]
	private IDataTable? DataTable { get; set; }

	[Parameter]
	public string SearchTerm { get; set; } = string.Empty;

	[Parameter]
	public EventCallback<string> SearchTermChanged { get; set; }

	[Parameter]
	public EventCallback<string> OnSearch { get; set; }

	[Parameter]
	public string Placeholder { get; set; } = "Search...";

	public int DebounceMs { get; set; } = 300;

	private readonly Debouncer _debouncer = new();

	private Task OnSearchInputHandler(ChangeEventArgs e)
	{
		var newSearchTerm = e.Value?.ToString() ?? string.Empty;

		// Update the SearchTerm immediately for binding
		if (SearchTerm != newSearchTerm)
		{
			SearchTerm = newSearchTerm;
		}

		_debouncer.Debounce(DebounceMs, async _ =>
		{
			// First, notify the parent DataTable if available
			if (DataTable != null)
			{
				await DataTable.HandleSearch(newSearchTerm);
			}

			// Then, invoke the OnSearch callback if provided
			if (OnSearch.HasDelegate)
				await OnSearch.InvokeAsync(newSearchTerm);
		}, false, CancellationToken);

		if (SearchTermChanged.HasDelegate)
			return SearchTermChanged.InvokeAsync(newSearchTerm);

		return Task.CompletedTask;
	}

	public override async ValueTask DisposeAsync()
	{
		await base.DisposeAsync();

		await _debouncer.DisposeAsync();
	}

	protected override void ComputeRenderKeyCore(ref HashCode hc)
	{
		base.ComputeRenderKeyCore(ref hc);
		hc.Add(SearchTerm);
		hc.Add(Placeholder);
		hc.Add(AriaLabel);
		hc.Add(DebounceMs);
	}
}
