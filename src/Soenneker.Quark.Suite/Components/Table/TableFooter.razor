@namespace Soenneker.Quark
@inherits Element

<tfoot @attributes="BuildAttributes()">
    @ChildContent
</tfoot>

@code {
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Token("muted/50");
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.FromTop.Default;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private string? _lastPrependedClass;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table-footer";
        BackgroundColor ??= _defaultBackgroundColor;
        Border ??= _defaultBorder;
        FontWeight ??= _defaultFontWeight;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "[&>tr]:last:border-b-0", ref _lastPrependedClass);
    }
}