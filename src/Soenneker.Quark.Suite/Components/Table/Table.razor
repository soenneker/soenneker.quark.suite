@namespace Soenneker.Quark
@inherits Element

<Div DataSlot="table-container" Position="_renderCss0" Width="_renderCss1" OverflowX="_renderCss2">
    <table @ref="_tableElement" @attributes="BuildAttributes()">
        @if (UseAdaptiveLayout)
        {
            <colgroup @ref="_columnsElement"></colgroup>
        }
        @ChildContent
    </table>
</Div>

@code {
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Relative;
    private static readonly CssValue<WidthBuilder> _renderCss1 = Quark.Width.IsFull;
    private static readonly CssValue<OverflowBuilder> _renderCss2 = Quark.Overflow.Auto;
    private string? _lastPrependedClass;
    private string? _lastPrependedClass2;
    private string? _lastBuiltStyle;


    [Inject]
    private ITablesInterop TablesInterop { get; set; } = null!;

    private ElementReference _tableElement;
    private ElementReference _columnsElement;
    private AdaptiveTableLayout? _adaptiveLayout;
    private static readonly TableColumnSizingOptions DefaultColumnSizing = new();

    [CascadingParameter(Name = "DataTable")]
    private IDataTable? ParentDataTable { get; set; }

    /// <summary>
    /// Gets or sets whether column widths use fixed table layout, preventing cell content changes from resizing columns.
    /// When null, inherits the containing DataTable setting, or uses automatic layout for a standalone table.
    /// Widths come from column definitions or the first row; unspecified columns share the remaining space.
    /// Requires a table width other than auto (the default is full width).
    /// </summary>
    [Parameter]
    public bool? FixedLayout { get; set; }

    /// <summary>
    /// Measures content and reserves extra space so small updates do not shift columns.
    /// Widths grow only when that space is exceeded and reset on container resize or column changes.
    /// Takes precedence over FixedLayout. Inherits the DataTable setting, or defaults to false.
    /// Authored colgroups and rowspans retain native layout.
    /// </summary>
    [Parameter]
    public bool? AdaptiveLayout { get; set; }

    /// <summary>Measurement limits and extra space. Inherits the DataTable options when unspecified.</summary>
    [Parameter]
    public TableColumnSizingOptions? ColumnSizing { get; set; }

    private bool UseFixedLayout => FixedLayout ?? ParentDataTable?.FixedLayout ?? false;
    private bool UseAdaptiveLayout => AdaptiveLayout ?? ParentDataTable?.AdaptiveLayout ?? false;
    private TableColumnSizingOptions EffectiveColumnSizing => ColumnSizing ?? ParentDataTable?.ColumnSizing ?? DefaultColumnSizing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (UseAdaptiveLayout || _adaptiveLayout is not null)
        {
            _adaptiveLayout ??= new AdaptiveTableLayout(TablesInterop);
            await _adaptiveLayout.Synchronize(_tableElement, _columnsElement, UseAdaptiveLayout, EffectiveColumnSizing);
        }
    }

    public override async ValueTask DisposeAsync()
    {
        try
        {
            if (_adaptiveLayout is not null)
                await _adaptiveLayout.DisposeAsync();
        }
        finally
        {
            await base.DisposeAsync();
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table";
        Width ??= _renderCss1;
        TextSize ??= _defaultTextSize;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "caption-bottom", ref _lastPrependedClass);

        if (UseAdaptiveLayout)
            PrependClassAttribute(attributes, "[&>*>tr>td]:whitespace-normal [&>*>tr>td]:break-words [&>*>tr>td]:overflow-hidden [&>*>tr>th]:whitespace-normal [&>*>tr>th]:break-words [&>*>tr>th]:overflow-hidden", ref _lastPrependedClass2);

        if (UseFixedLayout)
            PrependStyleAttribute(attributes, "table-layout: fixed;", ref _lastBuiltStyle);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(UseFixedLayout);
        hc.Add(UseAdaptiveLayout);
        hc.Add(EffectiveColumnSizing);
    }

}
