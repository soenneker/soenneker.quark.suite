@namespace Soenneker.Quark
@inherits LocalizedComponentBase

@if (IsLoading)
{
    <div @attributes="BuildAttributes()">
        <Div DataSlot="datatable-loader-overlay"
             Position="_renderCss0"
             Inset="_renderCss1"
             Display="_renderCss2"
             ItemsAlign="_staticCss0"
             Justify="_renderCss3"
             Style="background: transparent;">
            <Div DataSlot="datatable-loader-content"
                 Display="_renderCss2"
                 ItemsAlign="_staticCss0"
                 Justify="_renderCss3"
                 role="status"
                 aria-live="polite"
                 aria-label="@(Label ?? Text["LoadingData"])">
                <Spinner MinimumArcLength="25" ShowTrack="true" DataSlot="datatable-spinner" Size="_spinnerSize" TextColor="Quark.TextColor.Primary" Decorative="true" />
                @ChildContent
            </Div>
        </Div>
    </div>
}

@code {
    private static readonly CssValue<SizeBuilder> _spinnerSize = Quark.Size.Is8;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is10;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _renderCss1 = Quark.Inset.Is0;
    private static readonly CssValue<DisplayBuilder> _renderCss2 = Quark.Display.Flex;
    private static readonly CssValue<JustifyBuilder> _renderCss3 = Quark.Justify.Center;
	[CascadingParameter(Name = nameof(IsLoading))]
	public bool IsLoading { get; set; }

	private bool _lastIsLoading;

	protected override bool ShouldRender()
	{
		if (QuarkOptions.AlwaysRender)
			return true;

		if (IsLoading != _lastIsLoading)
		{
			_lastIsLoading = IsLoading;
			return true;
		}

		return base.ShouldRender();
	}

	// shadcn Skeleton/Spinner overlay - new-york-v4 ui/skeleton.tsx + spinner
	[Parameter]
	public string? Label { get; set; }

	protected override void ApplyDefaultParameters()
	{
		base.ApplyDefaultParameters();
		DataSlot ??= "datatable-loader";
		Position ??= _renderCss0;
		Inset ??= _renderCss1;
		ZIndex ??= _defaultZIndex;
	}

	protected override void ComputeRenderKeyCore(ref HashCode hc)
	{
		base.ComputeRenderKeyCore(ref hc);
		hc.Add(IsLoading);
		hc.Add(Label);
	}
}
