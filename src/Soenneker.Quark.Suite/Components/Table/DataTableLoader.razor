@namespace Soenneker.Quark
@inherits Element

@if (IsLoading)
{
    <div @attributes="BuildAttributes()">
        <Div DataSlot="datatable-loader-overlay"
             Position="_renderCss0"
             Inset="_renderCss1"
             Display="_renderCss2"
             ItemsAlign="_staticCss0"
             Justify="_renderCss3"
             Class="bg-background/70 backdrop-blur-[2px]">
            <Div DataSlot="datatable-loader-content"
                 Display="_renderCss2"
                 MinWidth='_staticCss1'
                 ItemsAlign="_staticCss0"
                 Justify="_renderCss3"
                 Rounded="_renderCss4"
                 Border="_renderCss5"
                 BackgroundColor="_renderCss6"
                 Padding="_renderCss7"
                 Shadow="_renderCss8"
                 MinHeight='_renderCss9'
                 role="status"
                 aria-live="polite"
                 aria-label="@Label">
                <Div DataSlot="datatable-loader-default" Display="_renderCss2" ItemsAlign="_staticCss0" Gap="_renderCss10" TextColor="_renderCss11">
                    <Spinner DataSlot="datatable-spinner" Size="_spinnerSize" TextColor="Quark.TextColor.Primary" Decorative="true" />
                    <Span TextSize="_renderCss18">Loading...</Span>
                </Div>
                @ChildContent
            </Div>
        </Div>
    </div>
}

@code {
    private static readonly CssValue<SizeBuilder> _spinnerSize = Quark.Size.Is8;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<MinWidthBuilder> _staticCss1 = Quark.MinWidth.Token("[120px]");
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is10;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _renderCss1 = Quark.Inset.Is0;
    private static readonly CssValue<DisplayBuilder> _renderCss2 = Quark.Display.Flex;
    private static readonly CssValue<JustifyBuilder> _renderCss3 = Quark.Justify.Center;
    private static readonly CssValue<RoundedBuilder> _renderCss4 = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _renderCss5 = Quark.Border.Default;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss6 = Quark.BackgroundColor.Card;
    private static readonly CssValue<PaddingBuilder> _renderCss7 = Quark.Padding.Is6;
    private static readonly CssValue<ShadowBuilder> _renderCss8 = Quark.Shadow.Sm;
    private static readonly CssValue<MinHeightBuilder> _renderCss9 = Quark.MinHeight.Token("20");
    private static readonly CssValue<GapBuilder> _renderCss10 = Quark.Gap.Is2;
    private static readonly CssValue<TextColorBuilder> _renderCss11 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TextSizeBuilder> _renderCss18 = Quark.TextSize.Sm;
	[CascadingParameter(Name = nameof(IsLoading))]
	public bool IsLoading { get; set; }

	private bool _lastIsLoading;

	protected override bool ShouldRender()
	{
		if (QuarkOptions.AlwaysRender)
			return true;

		if (IsLoading != _lastIsLoading)
		{
			_lastIsLoading = IsLoading;
			return true;
		}

		return base.ShouldRender();
	}

	// shadcn Skeleton/Spinner overlay - new-york-v4 ui/skeleton.tsx + spinner
	[Parameter]
	public string Label { get; set; } = "Loading table data";

	protected override void ApplyDefaultParameters()
	{
		base.ApplyDefaultParameters();
		DataSlot ??= "datatable-loader";
		Position ??= _renderCss0;
		Inset ??= _renderCss1;
		ZIndex ??= _defaultZIndex;
	}

	protected override void ComputeRenderKeyCore(ref HashCode hc)
	{
		base.ComputeRenderKeyCore(ref hc);
		hc.Add(IsLoading);
		hc.Add(Label);
	}
}
