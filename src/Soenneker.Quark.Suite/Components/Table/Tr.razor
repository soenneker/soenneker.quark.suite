@namespace Soenneker.Quark
@inherits Element

<tr @key="@Key" @attributes="BuildAttributes()">
    @if (DataTable?.SelectionEnabled == true)
    {
        @if (SelectionHeader)
        {
            <th scope="col" class="h-10 w-10 px-2 text-start align-middle" data-slot="datatable-selection-head">
                <span @onclick:stopPropagation="true">
                    <Check Checked="@DataTable.AllRowsSelected" Indeterminate="@DataTable.SomeRowsSelected"
                           CheckedChanged="DataTable.SelectAllRows" Disabled="@(DataTable.IsLoading || DataTable.SelectableRowKeys.Count == 0)"
                           AriaLabel="Select all rows on this page" />
                </span>
            </th>
        }
        else if (SelectionKey is not null)
        {
            <Td Width="Quark.Width.Is10">
                <span @onclick:stopPropagation="true">
                    <Check Checked="@DataTable.IsRowSelected(SelectionKey)" CheckedChanged="@((bool selected) => DataTable.SetRowSelected(SelectionKey, selected))"
                           Disabled="@(DataTable.IsLoading || !DataTable.SelectableRowKeys.Contains(SelectionKey))"
                           AriaLabel="@SelectionLabel" />
                </span>
            </Td>
        }
    }
    @ChildContent
</tr>

@code {
    [CascadingParameter(Name = nameof(DataTable))]
    private IDataTable? DataTable { get; set; }

    /// <summary>Adds a select-all header cell when the parent DataTable enables selection.
    /// Set on one header row only. This cell does not participate in server-side column indexing.</summary>
    [Parameter]
    public bool SelectionHeader { get; set; }

    /// <summary>A stable row key. Adds a checkbox cell when the parent DataTable enables selection.
    /// Include the key in SelectableRowKeys to enable its checkbox. Account for this extra cell in authored colspans.</summary>
    [Parameter]
    public string? SelectionKey { get; set; }

    /// <summary>Accessible label for the row checkbox.</summary>
    [Parameter]
    public string SelectionLabel { get; set; } = "Select row";

    /// <summary>
    /// Gets or sets the key for the table row.
    /// </summary>
    [Parameter]
    public object? Key { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table-row";
        Border ??= Quark.Border.FromBottom.Default;
        Transition ??= Quark.Transition.Colors;

    }

	protected override void BuildAttributesCore(Dictionary<string, object> attributes)
	{
		base.BuildAttributesCore(attributes);

        if (DataTable?.SelectionEnabled == true && SelectionKey is not null)
        {
            var selected = DataTable.IsRowSelected(SelectionKey);
            attributes["data-state"] = selected ? "selected" : "unselected";
            attributes["aria-selected"] = selected ? "true" : "false";
        }


		PrependClassAttribute(attributes, "hover:bg-muted/50 has-aria-expanded:bg-muted/50 data-[state=selected]:bg-muted");
	}

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Key);
        hc.Add(SelectionHeader);
        hc.Add(SelectionKey);
        hc.Add(SelectionLabel);
        hc.Add(DataTable?.SelectionEnabled);
        hc.Add(DataTable?.IsLoading);
        hc.Add(DataTable?.AllRowsSelected);
        hc.Add(DataTable?.SomeRowsSelected);
        hc.Add(DataTable?.SelectableRowKeys.Count);
        hc.Add(SelectionKey is not null && DataTable?.IsRowSelected(SelectionKey) == true);
        hc.Add(SelectionKey is not null && DataTable?.SelectableRowKeys.Contains(SelectionKey) == true);
    }
}
