@namespace Soenneker.Quark
@inherits Element

<td @attributes="BuildAttributes()">
    @ChildContent
</td>

@code {
    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);

        if (HtmlRowSpan.HasValue)
            attributes["rowspan"] = QuarkAttributeValues.FromInt32(HtmlRowSpan.Value);

        if (Headers is not null)
            attributes["headers"] = Headers;

    }


    /// <summary>
    /// Gets or sets the HTML rowspan attribute.
    /// </summary>
    [Parameter]
    public int? HtmlRowSpan { get; set; }

    /// <summary>
    /// Gets or sets the HTML headers attribute.
    /// </summary>
    [Parameter]
    public string? Headers { get; set; }


    private QuarkInt32Attribute _colspanAttribute;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is2;
    private static readonly CssValue<VerticalAlignBuilder> _defaultVerticalAlign = Quark.VerticalAlign.Middle;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private string? _lastPrependedClass;

    /// <summary>
    /// Gets or sets the colspan attribute value.
    /// </summary>
    [Parameter]
    public int? Colspan { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table-cell";

        Padding ??= _defaultPadding;
        VerticalAlign ??= _defaultVerticalAlign;
        Whitespace ??= _defaultWhitespace;
    }

	protected override void BuildAttributesCore(Dictionary<string, object> attributes)
	{
        base.BuildAttributesCore(attributes);

        if (Colspan is > 1)
            attributes["colspan"] = _colspanAttribute.Get(Colspan.Value);

		PrependClassAttribute(attributes, "[&:has([role=checkbox])]:pe-0", ref _lastPrependedClass);
	}

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(HtmlRowSpan);
        hc.Add(Headers);

        hc.Add(Colspan);
    }
}
