@using Soenneker.Utils.PooledStringBuilders
@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement

<caption @attributes="BuildAttributes()">
    @ChildContent
</caption>

@code {
    /// <summary>Gets or sets the CaptionSide utilities, including responsive and state variants.</summary>
    [Parameter]
    public CssValue<CaptionSideBuilder>? CaptionSide { get; set; }

    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromTop.Is4;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table-caption";
        TextColor ??= _defaultTextColor;
        TextSize ??= _defaultTextSize;
        Margin ??= _defaultMargin;

    }

    protected override void BuildOwnedClassAndStyle(ref PooledStringBuilder sty, ref PooledStringBuilder cls)
    {
        base.BuildOwnedClassAndStyle(ref sty, ref cls);
        var preset = AppliedPresetContext;
        AddCss(ref cls, ResolvePresetValue(CaptionSide, preset?.CaptionSide, nameof(CaptionSide)));
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        AddIf(ref hc, CaptionSide);
    }
}