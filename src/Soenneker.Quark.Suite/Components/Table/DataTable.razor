@using System.Globalization
@using Soenneker.Atomics.ValueBools
@using Microsoft.Extensions.Logging
@using Soenneker.Blazor.Utils.Ids
@using Soenneker.DataTables.Dtos.ServerSideRequest

@namespace Soenneker.Quark
@inherits CancellableElement
@implements IDataTable

<CascadingValue Name="DataTable" Value="this">
    <CascadingValue Value="@IsLoading" Name="IsLoading" >
		@if (Visible)
		{
			<Div Id="@ElementId" Position="_renderCss0" Width="_renderCss1" MinWidth="_staticCss0">
                @TopContent

                @if (SelectionEnabled && SelectedKeys.Count > 0)
                {
                    <DataTableTopBar data-slot="datatable-selection-toolbar" role="region" aria-label="Selection actions"
                                     TextSize="_renderCss2" Gap="_renderCss3" Padding="_renderCss4"
                                     Margin="_renderCss5" Shadow="_renderCss6">
                        <Span role="status" TextSize="_renderCss2" FontWeight="_renderCss7">@SelectedKeys.Count selected</Span>
                        @SelectionContent
                        <Button Variant="ButtonVariant.Ghost" ButtonSize="_staticCss1" TextSize="_renderCss2"
                                Height="_renderCss8" Padding="_renderCss9" TextColor="_renderCss10"
                                Margin="_renderCss11" OnClick="@(_clearSelectionCallback ??= HandleClearSelection)">Clear selection</Button>
                    </DataTableTopBar>
                }

                <Div Position="_renderCss0" Width="_renderCss1" MinWidth="_staticCss0" Style="@(IsLoading ? "min-height: 8rem;" : null)" OverflowX="_renderCss12">
                    @OverlayContent
                    @if (IsLoading && OverlayContent is null)
                    {
                        <Div data-slot="datatable-loading" Position="_renderCss13" Inset="_renderCss14" ZIndex="_renderCss15"
                             Display="_renderCss16" ItemsAlign="@(LoadingAtTop ? _loadingItemsStart : _loadingItemsCenter)" Justify="_renderCss17"
                             Padding="@(LoadingAtTop ? (CssValue<PaddingBuilder>?)_loadingPadding : null)"
                             Style="background: color-mix(in srgb, var(--background) 60%, transparent);">
                            <Spinner Size="_renderCss18" aria-label="Loading data" />
                        </Div>
                    }

                    @if (TableContent != null)
                    {
                        <table @ref="_tableElement" @attributes="BuildAttributes()">
                            @if (AdaptiveLayout)
                            {
                                <colgroup @ref="_columnsElement"></colgroup>
                            }
                            @TableContent
                        </table>
                    }
                    else if (!IsLoading && ChildContent == null)
                    {
                        <Div TextAlign="_renderCss19" Padding="_renderCss20">
                            <p>No content available</p>
                        </Div>
                    }
                    else
                    {
                        <Div Width="_renderCss1">
                            @if (ChildContent != null)
                            {
                                @ChildContent
                            }
                        </Div>
                    }
                </Div>

                @BottomContent

                @if (ShouldRenderPageSizeSelector)
                {
                    <DataTableBottomBar Justify="_renderCss21"
                                        Gap="_renderCss22"
                                        Border="_renderCss23"
                                        BackgroundColor="_renderCss24"
                                        Padding="_renderCss25"
                                        Rounded="_renderCss26"
                                        Shadow="_renderCss6">
                        <DataTableInfo>
                            @PageSizeSelectorInfoText
                        </DataTableInfo>
                        <Span TextColor="_renderCss10" TextSize="_renderCss27" FontWeight="_renderCss7" aria-hidden="true">–</Span>
                        <DataTablePageSizeSelector PageSizeOptions="@ResolvedPageSizeOptions"
                                                   Label="@Options.PageSizeSelectorLabel"
                                                   Suffix="@Options.PageSizeSelectorSuffix"
                                                   ItemSingularText="@Options.PageSizeItemSingularText"
                                                   ItemPluralText="@Options.PageSizeItemPluralText" />
                    </DataTableBottomBar>
                }
            </Div>
		}
    </CascadingValue>
</CascadingValue>

@code {
    private Func<MouseEventArgs, Task>? _clearSelectionCallback;
    private Task HandleClearSelection(MouseEventArgs _) => ClearSelection();
    private static readonly CssValue<ItemsBuilder> _loadingItemsStart = Quark.Items.Start;
    private static readonly CssValue<ItemsBuilder> _loadingItemsCenter = Quark.Items.Center;
    private static readonly CssValue<PaddingBuilder> _loadingPadding = Quark.Padding.FromTop.Is4;
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss1 = Quark.ButtonSize.Sm;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Relative;
    private static readonly CssValue<WidthBuilder> _renderCss1 = Quark.Width.IsFull;
    private static readonly CssValue<TextSizeBuilder> _renderCss2 = Quark.TextSize.Xs;
    private static readonly CssValue<GapBuilder> _renderCss3 = Quark.Gap.Is2;
    private static readonly CssValue<PaddingBuilder> _renderCss4 = Quark.Padding.OnY.Is1.OnX.Is3;
    private static readonly CssValue<MarginBuilder> _renderCss5 = Quark.Margin.FromBottom.Is2;
    private static readonly CssValue<ShadowBuilder> _renderCss6 = Quark.Shadow.None;
    private static readonly CssValue<FontWeightBuilder> _renderCss7 = Quark.FontWeight.Medium;
    private static readonly CssValue<HeightBuilder> _renderCss8 = Quark.Height.Is7;
    private static readonly CssValue<PaddingBuilder> _renderCss9 = Quark.Padding.OnX.Is2;
    private static readonly CssValue<TextColorBuilder> _renderCss10 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<MarginBuilder> _renderCss11 = Quark.Margin.FromLeft.Auto;
    private static readonly CssValue<OverflowBuilder> _renderCss12 = Quark.Overflow.X.Auto;
    private static readonly CssValue<PositionBuilder> _renderCss13 = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _renderCss14 = Quark.Inset.Is0;
    private static readonly CssValue<ZIndexBuilder> _renderCss15 = Quark.ZIndex.Is10;
    private static readonly CssValue<DisplayBuilder> _renderCss16 = Quark.Display.Flex;
    private static readonly CssValue<JustifyBuilder> _renderCss17 = Quark.Justify.Center;
    private static readonly CssValue<SizeBuilder> _renderCss18 = Quark.Size.Is6;
    private static readonly CssValue<TextAlignBuilder> _renderCss19 = Quark.TextAlign.Center;
    private static readonly CssValue<PaddingBuilder> _renderCss20 = Quark.Padding.Is4;
    private static readonly CssValue<JustifyBuilder> _renderCss21 = Quark.Justify.Start;
    private static readonly CssValue<GapBuilder> _renderCss22 = Quark.Gap.Is1;
    private static readonly CssValue<BorderBuilder> _renderCss23 = Quark.Border.Is0;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss24 = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<PaddingBuilder> _renderCss25 = Quark.Padding.OnY.Is2.OnX.Is0;
    private static readonly CssValue<RoundedBuilder> _renderCss26 = Quark.Rounded.None;
    private static readonly CssValue<TextSizeBuilder> _renderCss27 = Quark.TextSize.Sm;
    private string? _lastPrependedClass;
    private string? _lastPrependedClass2;
    private string? _lastBuiltStyle;

    [Inject]
    private ITablesInterop TablesInterop { get; set; } = null!;

    [Parameter]
    public EventCallback OnInitialize { get; set; }

    [Parameter]
    public EventCallback<int> OnPageSizeChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnGoToPage { get; set; }

    [Parameter]
    public EventCallback<DataTableOrderEventArgs> OnOrder { get; set; }

    [Parameter]
    public RenderFragment? TopContent { get; set; }

    [Parameter]
    public bool SelectionEnabled { get; set; }

    [Parameter]
    public IReadOnlyCollection<string> SelectableRowKeys { get; set; } = Array.Empty<string>();

    [Parameter]
    public IReadOnlyCollection<string> SelectedKeys { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> SelectedKeysChanged { get; set; }

    [Parameter]
    public RenderFragment? SelectionContent { get; set; }

    public bool AllRowsSelected
    {
        get
        {
            if (SelectableRowKeys.Count == 0) return false;
            foreach (var key in SelectableRowKeys)
                if (!IsRowSelected(key)) return false;
            return true;
        }
    }

    public bool SomeRowsSelected
    {
        get
        {
            var anySelected = false;
            var anyUnselected = false;
            foreach (var key in SelectableRowKeys)
            {
                if (IsRowSelected(key)) anySelected = true;
                else anyUnselected = true;
                if (anySelected && anyUnselected) return true;
            }
            return false;
        }
    }

    public bool IsRowSelected(string key) => SelectedKeys.Contains(key);

    public async Task SetRowSelected(string key, bool selected)
    {
        if (!SelectionEnabled || IsLoading || !SelectableRowKeys.Contains(key))
            return;

        var keys = new HashSet<string>(SelectedKeys, StringComparer.Ordinal);
        if (selected ? keys.Add(key) : keys.Remove(key))
            await UpdateSelection(keys);
    }

    public async Task SelectAllRows(bool selected)
    {
        if (!SelectionEnabled || IsLoading)
            return;

        var keys = new HashSet<string>(SelectedKeys, StringComparer.Ordinal);
        if (selected)
            keys.UnionWith(SelectableRowKeys);
        else
            keys.ExceptWith(SelectableRowKeys);

        if (!keys.SetEquals(SelectedKeys))
            await UpdateSelection(keys);
    }

    public Task ClearSelection() => PublishSelection(Array.Empty<string>());

    private Task UpdateSelection(HashSet<string> keys)
    {
        var snapshot = new string[keys.Count];
        keys.CopyTo(snapshot);
        return PublishSelection(snapshot);
    }

    private async Task PublishSelection(string[] keys)
    {
        SelectedKeys = keys;
        await SelectedKeysChanged.InvokeAsync(SelectedKeys);
        await RefreshOffThread();
    }

    [Parameter]
    public RenderFragment? TableContent { get; set; }

    [Parameter]
    public RenderFragment? OverlayContent { get; set; }

    [Parameter]
    public bool LoadingAtTop { get; set; }

    [Parameter]
    public RenderFragment? BottomContent { get; set; }

    [Parameter]
    public DataTableOptions Options { get; set; } = new();

    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public bool FixedLayout { get; set; }

    [Parameter]
    public bool AdaptiveLayout { get; set; }

    [Parameter]
    public TableColumnSizingOptions ColumnSizing { get; set; } = new();

    private ElementReference _tableElement;
    private ElementReference _columnsElement;
    private AdaptiveTableLayout? _adaptiveLayout;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        var enabled = AdaptiveLayout && Visible && TableContent is not null;
        if (enabled || _adaptiveLayout is not null)
        {
            _adaptiveLayout ??= new AdaptiveTableLayout(TablesInterop);
            await _adaptiveLayout.Synchronize(_tableElement, _columnsElement, enabled, ColumnSizing);
        }
    }

    [Parameter]
    public int TotalRecords { get; set; }


    [Parameter]
    public EventCallback<DataTableServerSideRequest> OnInteraction { get; set; }

    public readonly string ElementId = BlazorIdGenerator.New("quark-datatable");

    // Debug properties
    public int CurrentPage { get; private set; } = 1;

    public int PageSize { get; private set; }

    public int TotalPages { get; private set; }

    public int TotalRecordsCount { get; private set; }

    public bool HasExactTotalRecords => !_usesContinuationPaging || TotalRecords > 0 || _continuationTokenPaging.HasKnownLastPage;

    private bool _usesContinuationPaging;

    public bool HasLoadedOnce { get; private set; }

    [Parameter]
    [System.Diagnostics.CodeAnalysis.SuppressMessage("Usage", "BL0007", Justification = "Preserve the existing effective loading getter while accepting independent external loading state.")]
    public bool IsLoading
    {
        get => _externalLoading || _isLoading;
        set => _externalLoading = value;
    }

    public string? SearchTerm => _searchTerm;

    public string? SortBy
    {
        get
        {
            if (_currentOrders.Count == 0)
                return null;

            var column = GetColumn(_currentOrders[0].Column);
            return column?.Data;
        }
    }

    public string? SortDirection => _currentOrders.Count == 0 ? null : _currentOrders[0].Dir;

    private readonly List<DataTableOrderRequest> _currentOrders = [];
    private readonly DataTableContinuationTokenPaging _continuationTokenPaging = new();
    private readonly List<Th> _registeredColumns = [];

    private string _searchTerm = string.Empty;
    private string? _continuationToken;

    private bool _isLoading;
    private bool _externalLoading;
    private bool _initialized;
    private bool _dataLoaded;
    private bool _hasLoadedOnce; // Flag to track if data has been loaded at least once
    private bool _isUpdatingParameters; // Flag to prevent infinite loops
    private bool _pendingInteraction;
    private ValueAtomicBool _disposed;
    private bool _isHandlingManualRequest; // Flag to prevent multiple simultaneous manual requests
    private int _manualRequestCount; // Counter to track manual request calls
    private DataTableOptions? _previousOptions;
    private int[]? _pageSizeOptionsSnapshot;
    private int[] _resolvedPageSizeOptions = [];
    private int _resolvedForPageSize;
    private bool _pageSizeOptionsInitialized;
    private bool ShouldRenderPageSizeSelector => Options.ShowPageSizeSelector && BottomContent is null;
    private int[] ResolvedPageSizeOptions => GetResolvedPageSizeOptions();
    private int StartRecord => TotalRecordsCount == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int EndRecord => Math.Min(CurrentPage * PageSize, TotalRecordsCount);
    private string VisibleRecordRangeText => StartRecord == EndRecord ? StartRecord.ToString() : $"{StartRecord}-{EndRecord}";
    private string PageInfoRecordSuffix => Options.PageInfoRecordText.HasContent() ? $" {Options.PageInfoRecordText}" : string.Empty;
    private (int Page, int Start, int End, int Total, bool Exact, string? Suffix) _pageInfoKey;
    private CultureInfo? _pageInfoCulture;
    private string? _pageInfoText;
    private string PageSizeSelectorInfoText
    {
        get
        {
            var key = (CurrentPage, StartRecord, EndRecord, TotalRecordsCount, HasExactTotalRecords, Options.PageInfoRecordText);
            var culture = CultureInfo.CurrentCulture;
            if (_pageInfoText is not null && key == _pageInfoKey && culture.IsReadOnly && ReferenceEquals(culture, _pageInfoCulture))
                return _pageInfoText;
            _pageInfoText = HasExactTotalRecords
        ? $"Page {CurrentPage} – {VisibleRecordRangeText} of {TotalRecordsCount}{PageInfoRecordSuffix}"
        : $"Page {CurrentPage} – {VisibleRecordRangeText}{PageInfoRecordSuffix}";
            _pageInfoKey = key;
            _pageInfoCulture = culture;
            return _pageInfoText;
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table";
        Width ??= _renderCss1;
        TextSize ??= _renderCss27;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["aria-busy"] = IsLoading ? "true" : "false";

        PrependClassAttribute(attributes, "q-datatable caption-bottom", ref _lastPrependedClass);

        if (AdaptiveLayout)
            PrependClassAttribute(attributes, "[&>*>tr>td]:whitespace-normal [&>*>tr>td]:break-words [&>*>tr>td]:overflow-hidden [&>*>tr>th]:whitespace-normal [&>*>tr>th]:break-words [&>*>tr>th]:overflow-hidden", ref _lastPrependedClass2);

        if (FixedLayout)
            PrependStyleAttribute(attributes, "table-layout: fixed;", ref _lastBuiltStyle);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PageSize = GetDefaultPageSize();
            await TablesInterop.Initialize(CancellationToken);

            _initialized = true;

            if (OnInitialize.HasDelegate)
                await OnInitialize.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during DataTable initialization: {Message}", ex.Message);
            throw;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Prevent infinite loops by checking if we're already updating parameters
        if (_isUpdatingParameters)
        {
            if (Options.Debug)
                Logger.LogDebug("OnParametersSetAsync called while already updating parameters - skipping");

            return;
        }

        if (Options.Debug)
            Logger.LogDebug("OnParametersSetAsync called: _dataLoaded={DataLoaded}, _initialized={Initialized}, TotalRecords={TotalRecords}, _totalRecords={CurrentTotalRecords}", _dataLoaded, _initialized, TotalRecords, TotalRecordsCount);

        _isUpdatingParameters = true;

        try
        {
            // Initialize total records and pages on first parameter set
            if (!_dataLoaded)
            {
                if (Options.Debug)
                    Logger.LogDebug("First parameter set - initializing data");
                // Ensure PageSize is initialized before first load
                if (PageSize <= 0)
                    PageSize = GetDefaultPageSize();
                TotalRecordsCount = TotalRecords;
                TotalPages = (int) Math.Ceiling((double) TotalRecordsCount / PageSize);

                // Load initial data without blocking first render so loader shows immediately
                if (OnInteraction.HasDelegate)
                {
                    if (Options.Debug)
                        Logger.LogDebug("Scheduling OnInteractionInternal for initial data load");

                    _isLoading = true; // ensure loader visible on first render
                    await RefreshOffThread();

                    _ = OnInteractionInternal();
                }

                _dataLoaded = true;
            }
            else
            {
                // Check if TotalRecords has changed
                int totalRecords = TotalRecords > 0
                    ? TotalRecords
                    : _continuationTokenPaging.CalculateTotalRecords(PageSize);
                if (TotalRecordsCount != totalRecords)
                {
                    if (Options.Debug)
                        Logger.LogDebug("TotalRecords changed from {OldTotal} to {NewTotal}", TotalRecordsCount, TotalRecords);

                    TotalRecordsCount = totalRecords;
                    TotalPages = (int) Math.Ceiling((double) TotalRecordsCount / PageSize);

                    if (Options.Debug)
                        Logger.LogDebug("TotalRecords updated to {TotalRecords}, TotalPages={TotalPages}", TotalRecordsCount, TotalPages);
                }
            }

            // Check if options have changed and trigger reload if needed
            var optionsChanged = _previousOptions != null && !Options.Equals(_previousOptions);

            if (_initialized && optionsChanged)
            {
                if (Options.Debug)
                    Logger.LogDebug("Options changed - resetting table");
                PageSize = GetDefaultPageSize();
                CurrentPage = 1;
                // Clear continuation token When options change
                _continuationToken = null;
                _continuationTokenPaging.Reset();

                if (OnInteraction.HasDelegate)
                {
                    await OnInteractionInternal();
                }
            }

            if (_previousOptions is null || optionsChanged)
                _previousOptions = Options.Clone();
        }
        finally
        {
            _isUpdatingParameters = false;
        }

        await base.OnParametersSetAsync();
    }

    public async ValueTask HandleGoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
            return;

        CurrentPage = page;
        // Clear continuation token When changing pages
        _continuationToken = null;

        await OnInteractionInternal();

        if (OnGoToPage.HasDelegate)
            await OnGoToPage.InvokeAsync(page);
    }

    public async ValueTask HandlePageSizeChanged(int pageSize)
    {
        if (pageSize <= 0 || pageSize == PageSize)
            return;

        PageSize = pageSize;
        CurrentPage = 1;
        TotalPages = Math.Max(1, (int) Math.Ceiling((double) TotalRecordsCount / PageSize));
        _continuationTokenPaging.Reset();
        _continuationToken = null;

        await RefreshOffThread();
        await OnInteractionInternal();

        if (OnPageSizeChanged.HasDelegate)
            await OnPageSizeChanged.InvokeAsync(pageSize);
    }

    public ValueTask GoToPage(int page)
    {
        return HandleGoToPage(page);
    }

    private int GetDefaultPageSize()
    {
        return Options.DefaultPageSize > 0 ? Options.DefaultPageSize : 10;
    }

    private static int[] NormalizePageSizeOptions(int[]? options, int currentPageSize)
    {
        var result = new List<int>();

        if (currentPageSize > 0)
            result.Add(currentPageSize);

        if (options is not null)
        {
            for (var i = 0; i < options.Length; i++)
            {
                var option = options[i];

                if (option > 0 && !result.Contains(option))
                    result.Add(option);
            }
        }

        if (result.Count == 0)
            result.Add(10);

        return result.ToArray();
    }

    private int[] GetResolvedPageSizeOptions()
    {
        var options = Options.PageSizeOptions;

        if (_pageSizeOptionsInitialized && _resolvedForPageSize == PageSize && PageSizeOptionsEqual(options, _pageSizeOptionsSnapshot))
            return _resolvedPageSizeOptions;

        _pageSizeOptionsInitialized = true;
        _resolvedForPageSize = PageSize;
        _pageSizeOptionsSnapshot = options is null ? null : [.. options];
        _resolvedPageSizeOptions = NormalizePageSizeOptions(options, PageSize);
        return _resolvedPageSizeOptions;
    }

    private static bool PageSizeOptionsEqual(int[]? left, int[]? right)
    {
        if (ReferenceEquals(left, right))
            return true;

        if (left is null || right is null || left.Length != right.Length)
            return false;

        for (var i = 0; i < left.Length; i++)
        {
            if (left[i] != right[i])
                return false;
        }

        return true;
    }

    public async ValueTask HandleSearch(string searchTerm)
    {
        if (Options.Debug)
            Logger.LogDebug("HandleSearch called with term: {SearchTerm}", searchTerm);

        _searchTerm = searchTerm;
        CurrentPage = 1; // Reset to first page When searching
        _continuationTokenPaging.Reset(); // Reset continuation token paging When searching
        _continuationToken = null; // Clear continuation token When searching


        await OnInteractionInternal();
    }

    public List<DataTableOrderRequest> GetCurrentOrders()
    {
        return _currentOrders.Count == 0 ? [] : [.._currentOrders];
    }

    public async ValueTask SetOrders(List<DataTableOrderRequest> orders)
    {
        _currentOrders.Clear();

        if (orders != null)
        {
            _currentOrders.AddRange(orders);
        }

        CurrentPage = 1;
        _continuationTokenPaging.Reset();
        _continuationToken = null;


        await OnInteractionInternal();
    }

    public string? GetSortDirection(int columnIndex)
    {
        // Validate that the column index is valid
        if (GetColumn(columnIndex) == null)
        {
            if (Options.Debug)
                Logger.LogWarning("GetSortDirection: Invalid column index {ColumnIndex}", columnIndex);
            return null;
        }

        var order = FindOrder(columnIndex);
        return order?.Dir;
    }

    public string GetSortClassByIndex(int columnIndex)
    {
        return string.Empty;
    }

    public string GetSortIndicatorByIndex(int columnIndex)
    {
        var direction = GetSortDirection(columnIndex);
        return direction switch
        {
            "asc" => " ↑",
            "desc" => " ↓",
            _ => " ↕"
        };
    }

    public async ValueTask HandleColumnSort(int columnIndex)
    {
        if (!IsColumnSortable(columnIndex))
            return;

        if (Options.Debug)
            Logger.LogDebug("HandleColumnSort called for column index: {ColumnIndex}", columnIndex);

        // Find existing order for this column
        var existing = FindOrder(columnIndex);
        var nextDirection = existing?.Dir switch
        {
            "asc" => "desc",
            "desc" => null,
            _ => "asc"
        };

        // Remove existing order for this column
        for (var i = _currentOrders.Count - 1; i >= 0; i--)
        {
            if (_currentOrders[i].Column == columnIndex)
                _currentOrders.RemoveAt(i);
        }

        // Add new order if direction is not null
        if (nextDirection != null)
        {
            _currentOrders.Add(new DataTableOrderRequest
            {
                Column = columnIndex,
                Dir = nextDirection
            });
        }

        // Reset to page 1 When sorting
        CurrentPage = 1;
        // Reset continuation token paging When sorting
        _continuationTokenPaging.Reset();
        _continuationToken = null;

        await OnInteractionInternal();

        if (OnOrder.HasDelegate)
        {
            var args = new DataTableOrderEventArgs
            {
                Column = $"Column_{columnIndex}",
                Direction = nextDirection ?? string.Empty,
                Orders = _currentOrders.Count == 0 ? [] : [.._currentOrders]
            };

            await OnOrder.InvokeAsync(args);
        }
    }

    public int RegisterColumn(Th columnHeader)
    {
        var existingIndex = _registeredColumns.IndexOf(columnHeader);
        if (existingIndex >= 0)
            return existingIndex;
        _registeredColumns.Add(columnHeader);
        var columnIndex = _registeredColumns.Count - 1;

        // Registration changes request metadata, not the rendered table. The header
        // receives its index immediately and later interactions read this collection.
        return columnIndex;
    }

    internal void UnregisterColumn(Th columnHeader)
    {
        var index = _registeredColumns.IndexOf(columnHeader);
        if (index < 0)
            return;
        _registeredColumns.RemoveAt(index);
        for (var i = index; i < _registeredColumns.Count; i++)
            _registeredColumns[i].SetColumnIndex(i);
        for (var i = _currentOrders.Count - 1; i >= 0; i--)
        {
            var order = _currentOrders[i];
            if (order.Column == index)
                _currentOrders.RemoveAt(i);
            else if (order.Column > index)
                _currentOrders[i] = new DataTableOrderRequest { Column = order.Column - 1, Dir = order.Dir };
        }
        if (!_disposed.Read())
            _ = RefreshOffThread();
    }

    private Th? GetColumn(int columnIndex)
    {
        if (columnIndex < 0 || columnIndex >= _registeredColumns.Count)
        {
            if (Options.Debug)
                Logger.LogWarning("GetColumn: Column index {ColumnIndex} is out of bounds for registered columns count {Count}", columnIndex, _registeredColumns.Count);
            return null;
        }

        return _registeredColumns[columnIndex];
    }

    private bool IsColumnSortable(int columnIndex)
    {
        var column = GetColumn(columnIndex);
        return column?.Sortable ?? false;
    }

    private List<DataTableColumnRequest> BuildColumns()
    {
        var columns = new List<DataTableColumnRequest>(_registeredColumns.Count);

        foreach (var column in _registeredColumns)
        {
            columns.Add(new DataTableColumnRequest
            {
                Data = column.Data,
                Name = column.Name ?? column.Data, // Use Name if provided, otherwise fall back to Data
                Searchable = column.Searchable,
                Orderable = column.Sortable
            });
        }

        return columns;
    }

    private DataTableOrderRequest? FindOrder(int columnIndex)
    {
        for (var i = 0; i < _currentOrders.Count; i++)
        {
            var order = _currentOrders[i];

            if (order.Column == columnIndex)
                return order;
        }

        return null;
    }

    private async ValueTask OnInteractionInternal()
    {
        // Prevent multiple simultaneous calls to OnInteractionInternal
        if (_disposed.Read())
            return;

        if (_isHandlingManualRequest)
        {
            _pendingInteraction = true;
            if (Options.Debug)
                Logger.LogDebug("OnInteractionInternal called while already handling a request - queued latest state");

            return;
        }

        _manualRequestCount++;

        if (Options.Debug)
            Logger.LogDebug("OnInteractionInternal called (count: {Count}): Page={Page}, PageSize={PageSize}, SearchTerm='{SearchTerm}'", _manualRequestCount, CurrentPage, PageSize, _searchTerm);

        if (!OnInteraction.HasDelegate)
        {
            if (Options.Debug)
                Logger.LogWarning("OnInteractionInternal: No OnInteraction delegate");

            return;
        }

        _isHandlingManualRequest = true;
        bool loadingChanged = !_isLoading;
        _isLoading = true;

        try
        {
            if (loadingChanged)
                await RefreshOffThread();
            do
            {
                _pendingInteraction = false;
                try
                {
                    // Calculate the actual start position based on current page
                    var actualStart = (CurrentPage - 1) * PageSize;

                    // Use continuation token paging to get the appropriate token
                    var continuationToken = _continuationTokenPaging.UpdateVirtualPage(actualStart, PageSize, _continuationToken);

                    var request = new DataTableServerSideRequest
                    {
                        Start = actualStart,
                        Length = PageSize,
                        Search = _searchTerm.HasContent() ? new DataTableSearchRequest {Value = _searchTerm} : null,
                        Order = _currentOrders.Count > 0 ? [.. _currentOrders] : null,
                        Columns = _registeredColumns.Count > 0 ? BuildColumns() : null,
                        ContinuationToken = continuationToken
                    };

                    if (Options.Debug)
                        Logger.LogDebug("Sending request: Start={Start}, Length={Length}, Search='{Search}', ContinuationToken='{Token}'", request.Start, request.Length, request.Search?.Value ?? "null", request.ContinuationToken ?? "null");

                    await OnInteraction.InvokeAsync(request);

                    // Mark that we've loaded data at least once after a successful request
                    if (!_hasLoadedOnce)
                    {
                        _hasLoadedOnce = true;
                        HasLoadedOnce = true;
                        if (Options.Debug)
                            Logger.LogDebug("Set HasLoadedOnce to true after first successful data load");
                    }
                }
                catch (OperationCanceledException)
                {
                    if (Options.Debug)
                        Logger.LogDebug("OnInteractionInternal was cancelled");
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "OnInteractionInternal error: {Message}", ex.Message);
                }
            } while (_pendingInteraction && !_disposed.Read());
        }
        finally
        {
            _isLoading = false;
            _isHandlingManualRequest = false;

            if (!_disposed.Read())
                await RefreshOffThread();
        }
    }

    public async ValueTask ClearSorting()
    {
        _currentOrders.Clear();
        CurrentPage = 1;
        _continuationTokenPaging.Reset();
        _continuationToken = null;
        _manualRequestCount = 0; // Reset the counter
        _hasLoadedOnce = false; // Reset the loaded flag
        HasLoadedOnce = false;

        await OnInteractionInternal();
    }

    public async ValueTask Reset()
    {
        _currentOrders.Clear();
        CurrentPage = 1;
        _continuationToken = null;
        _continuationTokenPaging.Reset();
        _manualRequestCount = 0; // Reset the counter
        _hasLoadedOnce = false; // Reset the loaded flag
        HasLoadedOnce = false;

        await OnInteractionInternal();
    }



    public async ValueTask CancelOperations()
    {
        if (Options.Debug)
            Logger.LogDebug("Cancelling ongoing operations");

        await Cancel();

        _isLoading = false;
        _isHandlingManualRequest = false;

        await RefreshOffThread();
    }

    public void UpdateContinuationTokenPaging(int recordCount, string? continuationToken, string? tokenUsedForCurrentPage = null)
    {
        int previousTotal = TotalRecordsCount;
        bool previouslyExact = HasExactTotalRecords;
        string? previousToken = _continuationToken;
        _usesContinuationPaging = true;
        if (Options.Debug)
            Logger.LogDebug("UpdateContinuationTokenPaging called: RecordCount={RecordCount}, Token='{Token}', TokenUsed='{TokenUsed}', TotalRecords={TotalRecords}", recordCount, continuationToken ?? "null", tokenUsedForCurrentPage ?? "null", TotalRecords);

        _continuationTokenPaging.UpdateFromResponse(PageSize, recordCount, continuationToken, tokenUsedForCurrentPage);
        _continuationToken = continuationToken;

        // Only update total records estimate if TotalRecords parameter is not provided (0 or negative)
        // This prevents conflicts between the continuation token paging system and the provided TotalRecords
        if (TotalRecords <= 0)
        {
            var oldTotalRecords = TotalRecordsCount;
            TotalRecordsCount = _continuationTokenPaging.CalculateTotalRecords(PageSize);
            if (Options.Debug)
                Logger.LogDebug("Updated _totalRecords from {OldTotal} to {NewTotal} (TotalRecords parameter is {ParamTotal})", oldTotalRecords, TotalRecordsCount, TotalRecords);
        }
        else
        {
            if (Options.Debug)
                Logger.LogDebug("Keeping _totalRecords as {CurrentTotal} (TotalRecords parameter is {ParamTotal})", TotalRecordsCount, TotalRecords);
        }

        var oldTotalPages = TotalPages;
        TotalPages = (int) Math.Ceiling((double) TotalRecordsCount / PageSize);

        if (Options.Debug)
            Logger.LogDebug("Updated continuation token paging: RecordCount={RecordCount}, Token='{Token}', TotalRecords={TotalRecords}, TotalPages={TotalPages} (was {OldTotalPages})", recordCount, continuationToken ?? "null", TotalRecordsCount, TotalPages, oldTotalPages);

        if (previousTotal != TotalRecordsCount || oldTotalPages != TotalPages || previousToken != _continuationToken || previouslyExact != HasExactTotalRecords)
            _ = RefreshOffThread();
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        _pendingInteraction = false;
        _registeredColumns.Clear();
        try
        {
            if (_adaptiveLayout is not null)
                await _adaptiveLayout.DisposeAsync();
        }
        finally
        {
            await base.DisposeAsync();
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);

        hc.Add(Visible);
        hc.Add(SelectionEnabled);
        hc.Add(SelectionContent);
        foreach (var key in SelectedKeys)
            hc.Add(key);
        foreach (var key in SelectableRowKeys)
            hc.Add(key);
        hc.Add(FixedLayout);
        hc.Add(AdaptiveLayout);
        hc.Add(ColumnSizing);
        hc.Add(IsLoading);
        hc.Add(LoadingAtTop);

        hc.Add(CurrentPage);
        hc.Add(PageSize);
        hc.Add(_searchTerm);

        hc.Add(_registeredColumns.Count);

        hc.Add(_hasLoadedOnce);
        hc.Add(TotalRecordsCount);
        hc.Add(HasExactTotalRecords);
        hc.Add(TotalPages);

        hc.Add(TotalRecords);
        hc.Add(Options);
        hc.Add(TopContent);
        hc.Add(TableContent);
        hc.Add(OverlayContent);
        hc.Add(BottomContent);

        hc.Add(_currentOrders.Count);
        for (var i = 0; i < _currentOrders.Count; i++)
        {
            var o = _currentOrders[i];
            hc.Add(o.Column);
            hc.Add(o.Dir);
        }
    }
