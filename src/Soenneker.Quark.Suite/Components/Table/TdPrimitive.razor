@namespace Soenneker.Quark
@inherits Element

<td @attributes="BuildAttributes()">
    @ChildContent
</td>

@code {
    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);

        if (Colspan.HasValue)
            attributes["colspan"] = QuarkAttributeValues.FromInt32(Colspan.Value);

        if (HtmlRowSpan.HasValue)
            attributes["rowspan"] = QuarkAttributeValues.FromInt32(HtmlRowSpan.Value);

        if (Headers is not null)
            attributes["headers"] = Headers;

    }


    /// <summary>
    /// Gets or sets the HTML rowspan attribute.
    /// </summary>
    [Parameter]
    public int? HtmlRowSpan { get; set; }

    /// <summary>
    /// Gets or sets the HTML headers attribute.
    /// </summary>
    [Parameter]
    public string? Headers { get; set; }


    private QuarkInt32Attribute _colspanAttribute;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table-cell-primitive";
    }

    [Parameter]
    public int? Colspan { get; set; }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Colspan is > 1)
            attributes["colspan"] = _colspanAttribute.Get(Colspan.Value);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(HtmlRowSpan);
        hc.Add(Headers);

        hc.Add(Colspan);
    }
}