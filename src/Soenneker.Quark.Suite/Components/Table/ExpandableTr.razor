@namespace Soenneker.Quark
@using Soenneker.Blazor.Utils.Ids
@inherits Element

<CascadingValue Value="this" IsFixed="false">
    <tr @key="@Key" @attributes="BuildAttributes()">
        @ChildContent
    </tr>

    @if (DetailContent is not null)
    {
        <tr id="@ContentId"
            data-slot="table-row-detail"
            data-state="@(IsExpanded ? "open" : "closed")"
            aria-hidden="@(!IsExpanded ? "true" : "false")"
            aria-labelledby="@TriggerId"
            class="@DetailRowClass">
            <td colspan="@Colspan"
                data-slot="table-row-detail-cell"
                class="@DetailCellClass">
                <div data-slot="table-row-detail-transition"
                     class="@DetailTransitionClass">
                    <div data-slot="table-row-detail-inner"
                         class="min-h-0 overflow-hidden"
                         inert="@(!IsExpanded ? string.Empty : null)">
                        @DetailContent
                    </div>
                </div>
            </td>
        </tr>
    }
</CascadingValue>

@code {
    private readonly string _generatedTriggerId = BlazorIdGenerator.New("quark-table-row-trigger");
    private readonly string _generatedContentId = BlazorIdGenerator.New("quark-table-row-detail");
    private bool _expanded;
    private bool _initialized;

    /// <summary>
    /// Gets or sets the key used to preserve the row during rendering.
    /// </summary>
    [Parameter]
    public object? Key { get; set; }

    /// <summary>
    /// Gets or sets the controlled expanded state. Leave unset to use the component's internal state.
    /// </summary>
    [Parameter]
    public bool? Expanded { get; set; }

    /// <summary>
    /// Gets or sets the initial expanded state when <see cref="Expanded"/> is not supplied.
    /// </summary>
    [Parameter]
    public bool DefaultExpanded { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the expanded state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>
    /// Gets or sets whether expansion is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the number of columns spanned by the detail cell.
    /// </summary>
    [Parameter]
    public int Colspan { get; set; } = 1;

    /// <summary>
    /// Gets or sets the content rendered in the expanded detail row.
    /// </summary>
    [Parameter]
    public RenderFragment? DetailContent { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes for the detail row.
    /// </summary>
    [Parameter]
    public string? DetailRowClass { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes for the detail cell.
    /// </summary>
    [Parameter]
    public string? DetailCellClass { get; set; } = "p-0 whitespace-normal";

    /// <summary>
    /// Gets whether the detail row is currently expanded.
    /// </summary>
    public bool IsExpanded => Expanded ?? _expanded;

    internal string TriggerId => _generatedTriggerId;
    internal string ContentId => _generatedContentId;

    private string DetailTransitionClass => IsExpanded
        ? "grid grid-rows-[1fr] opacity-100 transition-[grid-template-rows,opacity] duration-200 ease-out motion-reduce:transition-none"
        : "grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-200 ease-out motion-reduce:transition-none pointer-events-none";

    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            _expanded = DefaultExpanded;
            _initialized = true;
        }

        base.OnParametersSet();
    }

    internal async Task Toggle()
    {
        if (Disabled)
            return;

        bool next = !IsExpanded;

        if (!Expanded.HasValue)
        {
            _expanded = next;

            InvalidateRender();
            await InvokeAsync(StateHasChanged);
        }

        await ExpandedChanged.InvokeAsync(next);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "table-row";
        Border ??= Quark.Border.FromBottom.Default;
        Transition ??= Quark.Transition.Colors;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-state"] = IsExpanded ? "open" : "closed";

        BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "hover:bg-muted/50 has-aria-expanded:bg-muted/50 data-[state=selected]:bg-muted data-[state=open]:bg-muted/50");
        });
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Key);
        hc.Add(Expanded);
        hc.Add(DefaultExpanded);
        hc.Add(Disabled);
        hc.Add(Colspan);
        hc.Add(DetailContent);
        hc.Add(DetailRowClass);
        hc.Add(DetailCellClass);
    }
}
