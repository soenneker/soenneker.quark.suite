@using System.Globalization
@namespace Soenneker.Quark
@using Soenneker.Blazor.Utils.Ids
@inherits Element

<Div @attributes="BuildAttributes()">
    @if (Label.HasContent())
    {
        <Label For="@_selectId" TextColor="_renderCss0" TextSize="_renderCss1">@Label</Label>
    }

    <Select TValue="int"
            SelectedValue="@ComputedPageSize"
            SelectedValueChanged="(_cachedOnSelectedPageSizeChangedDelegate ??= OnSelectedPageSizeChanged)"
            SelectSize="SelectSizes.Sm">
        <SelectTrigger Id="@_selectId"
                       DataSlot="datatable-page-size-select"
                       Width="@ResolvedTriggerWidth"
                       TextColor="@ResolvedTriggerTextColor"
                       Cursor="_renderCss2"
                       Class="@ResolvedTriggerClass"
                       aria-label="@SelectAriaLabel">
            <SelectValue />
        </SelectTrigger>
        <SelectContent MinWidth="@ContentMinWidth">
            <SelectGroup>
                @{ var pageSizes = ResolvedPageSizeOptions; }
                @for (var i = 0; i < pageSizes.Length; i++)
                {
                    var size = pageSizes[i];
                    <SelectItem @key="size" TValue="int" ItemValue="@size" Text="@GetPageSizeText(size, i)" />
                }
            </SelectGroup>
        </SelectContent>
    </Select>

    @if (Suffix.HasContent())
    {
        <Span TextColor="_renderCss0" TextSize="_renderCss1">@Suffix</Span>
    }
</Div>

@code {
    private static readonly CssValue<DisplayBuilder> _conditionalCss0 = Quark.Display.InlineFlex;
    private static readonly CssValue<DisplayBuilder> _conditionalCss1 = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _conditionalCss2 = Quark.Gap.Is1;
    private static readonly CssValue<GapBuilder> _conditionalCss3 = Quark.Gap.Is2;
    private static readonly CssValue<MinWidthBuilder> _staticCss1 = Quark.MinWidth.Is32;
    private static readonly CssValue<WidthBuilder> _staticCss2 = Quark.Width.Is32;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<FlexWrapBuilder> _defaultFlexWrap = Quark.FlexWrap.Wrap;
    private static readonly CssValue<TextColorBuilder> _renderCss0 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TextSizeBuilder> _renderCss1 = Quark.TextSize.Sm;
    private static readonly CssValue<CursorBuilder> _renderCss2 = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private System.Func<int, Task>? _cachedOnSelectedPageSizeChangedDelegate;

    private string? _lastBuiltClass;

    private readonly string _selectId = BlazorIdGenerator.New("datatable-page-size");

    // Quark Select-based table footer page size selector.
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "datatable-page-size-selector";
        Display ??= Inline ? _conditionalCss0 : _conditionalCss1;
        Gap ??= Inline ? _conditionalCss2 : _conditionalCss3;
        ItemsAlign ??= _staticCss0;
        FlexWrap ??= _defaultFlexWrap;
    }

    [CascadingParameter(Name = "DataTable")]
    private IDataTable? DataTable { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter]
    public int[] PageSizeOptions { get; set; } = [10, 25, 50, 100];

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Suffix { get; set; }

    [Parameter]
    public string ItemSingularText { get; set; } = "item";

    [Parameter]
    public string ItemPluralText { get; set; } = "items";

    [Parameter]
    public CssValue<WidthBuilder>? TriggerWidth { get; set; } = _staticCss2;

    [Parameter]
    public CssValue<MinWidthBuilder>? ContentMinWidth { get; set; } = _staticCss1;

    [Parameter]
    public string SelectAriaLabel { get; set; } = "Rows per page";

    [Parameter]
    public bool Inline { get; set; } = true;

    private int ComputedPageSize => DataTable?.PageSize ?? PageSize;

    private int[]? _pageSizeOptionsSnapshot;
    private int[] _resolvedPageSizeOptions = [];
    private int _resolvedForPageSize;
    private bool _pageSizeOptionsInitialized;

    private int[] ResolvedPageSizeOptions => GetResolvedPageSizeOptions();

    private CssValue<WidthBuilder>? ResolvedTriggerWidth => Inline ? _inlineWidth : TriggerWidth;
    private CssValue<TextColorBuilder>? ResolvedTriggerTextColor
    {
        get
        {
            if (!Inline)
                return null;

            return _inlineColor;
        }
    }
    private string? ResolvedTriggerClass => Inline ? "!h-auto !min-h-0 !border-0 !rounded-none !bg-transparent !p-0 !shadow-none focus-visible:!ring-0 focus-visible:!ring-offset-0" : null;

    private async Task OnSelectedPageSizeChanged(int size)
    {
        if (size == ComputedPageSize)
            return;

        PageSize = size;

        if (DataTable != null)
            await DataTable.HandlePageSizeChanged(size);

        if (PageSizeChanged.HasDelegate)
            await PageSizeChanged.InvokeAsync(size);
    }

    private static readonly CssValue<WidthBuilder> _inlineWidth = Quark.Width.Auto;
    private static readonly CssValue<TextColorBuilder> _inlineColor = Quark.TextColor.MutedForeground;
    private (int Size, string? Unit, CultureInfo? Culture, string? Text)[] _pageTexts = [];

    private string GetPageSizeText(int size, int index)
    {
        var unit = size == 1 ? ItemSingularText : ItemPluralText;
        if (_pageTexts.Length != _resolvedPageSizeOptions.Length)
            _pageTexts = new (int, string?, CultureInfo?, string?)[_resolvedPageSizeOptions.Length];
        ref var entry = ref _pageTexts[index];
        var culture = CultureInfo.CurrentCulture;
        if (entry.Text is not null && entry.Size == size && entry.Unit == unit && culture.IsReadOnly && ReferenceEquals(culture, entry.Culture))
            return entry.Text;
        var text = unit.HasContent() ? $"{size} {unit}" : size.ToString();
        entry = (size, unit, culture, text);
        return text;
    }

    private static int[] NormalizePageSizeOptions(int[]? options, int currentPageSize)
    {
        var result = new List<int>();

        if (currentPageSize > 0)
            result.Add(currentPageSize);

        if (options is not null)
        {
            for (var i = 0; i < options.Length; i++)
            {
                var option = options[i];

                if (option > 0 && !result.Contains(option))
                    result.Add(option);
            }
        }

        if (result.Count == 0)
            result.Add(10);

        return result.ToArray();
    }

    private int[] GetResolvedPageSizeOptions()
    {
        var currentPageSize = ComputedPageSize;

        if (_pageSizeOptionsInitialized && _resolvedForPageSize == currentPageSize && PageSizeOptionsEqual(PageSizeOptions, _pageSizeOptionsSnapshot))
            return _resolvedPageSizeOptions;

        _pageSizeOptionsInitialized = true;
        _resolvedForPageSize = currentPageSize;
        _pageSizeOptionsSnapshot = PageSizeOptions is null ? null : [.. PageSizeOptions];
        _resolvedPageSizeOptions = NormalizePageSizeOptions(PageSizeOptions, currentPageSize);
        return _resolvedPageSizeOptions;
    }

    private static bool PageSizeOptionsEqual(int[]? left, int[]? right)
    {
        if (ReferenceEquals(left, right))
            return true;

        if (left is null || right is null || left.Length != right.Length)
            return false;

        for (var i = 0; i < left.Length; i++)
        {
            if (left[i] != right[i])
                return false;
        }

        return true;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        {
            const string @class = "q-datatable-page-size-selector";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(PageSize);
        hc.Add(ComputedPageSize);
        hc.Add(Label);
        hc.Add(Suffix);
        hc.Add(ItemSingularText);
        hc.Add(ItemPluralText);
        hc.Add(SelectAriaLabel);
        hc.Add(Inline);
        AddIf(ref hc, TriggerWidth);
        AddIf(ref hc, ResolvedTriggerTextColor);
        AddIf(ref hc, ContentMinWidth);
        var pageSizes = ResolvedPageSizeOptions;
        hc.Add(pageSizes.Length);
        foreach (var size in pageSizes)
            hc.Add(size);
    }
}
