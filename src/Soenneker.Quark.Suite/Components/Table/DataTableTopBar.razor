
@namespace Soenneker.Quark
@inherits Element

<Div Width="_renderCss0">
    <div @attributes="BuildAttributes()">
        @ChildContent
    </div>
</Div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is3;
    private static readonly CssValue<FlexWrapBuilder> _defaultFlexWrap = Quark.FlexWrap.Wrap;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Is1;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Card;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnY.Is2.OnX.Is3;
    private static readonly CssValue<WidthBuilder> _renderCss0 = Quark.Width.IsFull;
    private string? _lastBuiltClass;

    [Parameter]
    public string LayoutClass { get; set; } = string.Empty;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "datatable-top-bar";
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        FlexWrap ??= _defaultFlexWrap;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;

    }

    // shadcn table toolbar - new-york-v4 ui/table.tsx
    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        if (LayoutClass.HasContent())
            PrependClassAttribute(attributes, LayoutClass, ref _lastBuiltClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(LayoutClass);
    }
}
