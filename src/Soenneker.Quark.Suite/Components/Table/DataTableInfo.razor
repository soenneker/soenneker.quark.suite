@namespace Soenneker.Quark
@inherits Element

@if (ShowInfo)
{
    <div @attributes="BuildAttributes()">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            <Span>@StartRecord-@EndRecord@if (HasExactTotalRecords) {<text> of @ComputedTotalRecords</text>}</Span>
        }
    </div>
}

@code {
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    // shadcn table caption/info - new-york-v4 ui/table.tsx
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "datatable-info";

        TextColor ??= _defaultTextColor;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
    }

    [CascadingParameter(Name = "DataTable")]
    private IDataTable? DataTable { get; set; }

    [Parameter]
    public bool ShowInfo { get; set; } = true;

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalRecords { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    // Computed properties that use DataTable values When available
    private int ComputedCurrentPage => DataTable?.CurrentPage ?? CurrentPage;
    private int ComputedTotalRecords => DataTable?.TotalRecordsCount ?? TotalRecords;
    private int ComputedPageSize => DataTable?.PageSize ?? PageSize;
    private bool HasExactTotalRecords => DataTable?.HasExactTotalRecords ?? true;

    private int StartRecord => ComputedTotalRecords == 0 ? 0 : (ComputedCurrentPage - 1) * ComputedPageSize + 1;
    private int EndRecord => Math.Min(ComputedCurrentPage * ComputedPageSize, ComputedTotalRecords);

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShowInfo);
        hc.Add(CurrentPage);
        hc.Add(TotalRecords);
        hc.Add(PageSize);
        hc.Add(ComputedCurrentPage);
        hc.Add(ComputedTotalRecords);
        hc.Add(ComputedPageSize);
        hc.Add(HasExactTotalRecords);
    }
}
