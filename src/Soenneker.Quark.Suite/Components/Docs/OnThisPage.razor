@using System.Threading
@using Microsoft.AspNetCore.Components.Routing
@using Soenneker.Asyncs.Locks
@using Soenneker.Atomics.ValueBools
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IOnThisPageInterop OnThisPageInterop
@namespace Soenneker.Quark

@if (!ShouldHide)
{
    <Aside Position="_staticCss11" Display="_staticCss10" SelfAlign="_staticCss9" Class="@GetAsideClass()" Attributes="@_docsOnThisPageAttributes">
        <Div MaxHeight="@_containerMaxHeight" OverflowY="_staticCss8" Padding="@_containerPadding" Class="@ContainerClass">
            <Paragraph Margin="_staticCss7" TextSize="@_tocTextSize" FontWeight="_staticCss6" TextColor="_staticCss1">
                @Title
            </Paragraph>
            <Scrollspy Offset="96" Smooth="true" History="true" Display="_renderCss0">
                <Nav Display="_staticCss5" FlexDirection="_staticCss4" Gap="_staticCss3" TextSize="@_tocTextSize" AriaLabel="@Title" Class="@NavClass">
                    @foreach (var item in _items)
                    {
                        <Anchor @key="item.Id"
                                Href="@GetLinkHref(item.Id)"
                                Display="_staticCss2"
                                Leading="@_linkLeading"
                                TextColor="_staticCss1"
                                Transition="_staticCss0"
                                Class="@GetLinkClass(item)"
                                data-scrollspy-anchor="@item.Id"
                                data-scrollspy-offset="96">
                            @item.Title
                        </Anchor>
                    }
                </Nav>
            </Scrollspy>
        </Div>
    </Aside>
}

@code {
    private static readonly CssValue<TransitionBuilder> _staticCss0 = Transition.Colors;
    private static readonly CssValue<TextColorBuilder> _staticCss1 = TextColor.MutedForeground;
    private static readonly CssValue<DisplayBuilder> _staticCss2 = Display.Block;
    private static readonly CssValue<GapBuilder> _staticCss3 = Gap.Is2;
    private static readonly CssValue<FlexDirectionBuilder> _staticCss4 = FlexDirection.Col;
    private static readonly CssValue<DisplayBuilder> _staticCss5 = Display.Flex;
    private static readonly CssValue<FontWeightBuilder> _staticCss6 = FontWeight.Medium;
    private static readonly CssValue<MarginBuilder> _staticCss7 = Margin.FromBottom.Is4;
    private static readonly CssValue<OverflowBuilder> _staticCss8 = Overflow.Auto;
    private static readonly CssValue<SelfBuilder> _staticCss9 = Self.Start;
    private static readonly CssValue<DisplayBuilder> _staticCss10 = Display.None.OnXl.Block;
    private static readonly CssValue<PositionBuilder> _staticCss11 = Position.Sticky;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Display.Contents;

    private static readonly IReadOnlyDictionary<string, object> _docsOnThisPageAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "docs-on-this-page"
    };

    private static readonly CssValue<MaxHeightBuilder> _containerMaxHeight = MaxHeight.Token("[calc(100vh-var(--header-height)-2rem)]");
    private static readonly CssValue<PaddingBuilder> _containerPadding = Padding.OnX.Is1;
    private static readonly CssValue<TextSizeBuilder> _tocTextSize = TextSize.Token("[0.8rem]");
    private static readonly CssValue<LeadingBuilder> _linkLeading = Leading.Is6;

    private const string _defaultLinkClass = "hover:text-foreground";
    private const string _defaultAsideClass = "top-[calc(var(--header-height)+1rem)]";

    private CancellationTokenSource? _refreshCts;
    private string? _linkUri;
    private Dictionary<string, string>? _linkHrefs;
    private string? _lastLinkClass;
    private string? _topLinkClass;
    private string? _nestedLinkClass;
    private string? _deepLinkClass;
    private string? _asideClass;
    private string _linkPath = string.Empty;
    private readonly AsyncLock _refreshLock = new();
    private IReadOnlyList<OnThisPageTocItem> _items = [];
    private ValueAtomicBool _disposed = new(false);

    [Parameter]
    public string RootSelector { get; set; } = "[data-docs-content]";

    [Parameter]
    public string HeadingSelector { get; set; } = "h2[id], h3[id]";

    [Parameter]
    public string IgnoreSelector { get; set; } = "[data-docs-ignore-toc]";

    [Parameter]
    public string Title { get; set; } = "On This Page";

    [Parameter]
    public bool HideWhenEmpty { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? ContainerClass { get; set; }

    [Parameter]
    public string? NavClass { get; set; }

    [Parameter]
    public string? LinkClass { get; set; }

    private bool ShouldHide => HideWhenEmpty && _items.Count == 0;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ScheduleRefresh();
    }

    /// <summary>
    /// Re-scans the configured docs article root and recreates active heading tracking.
    /// </summary>
    public async ValueTask Refresh()
    {
        using (await _refreshLock.Lock())
        {
            if (_disposed.Value)
                return;

            var options = BuildOptions();
            var items = await OnThisPageInterop.GetItems(options);

            if (_disposed.Value)
                return;

            _items = items;
            _linkHrefs?.Clear();

            await InvokeAsync(StateHasChanged);
        }
    }

    private OnThisPageInteropOptions BuildOptions()
    {
        return new OnThisPageInteropOptions
        {
            RootSelector = RootSelector,
            HeadingSelector = HeadingSelector,
            IgnoreSelector = IgnoreSelector,
            RootMargin = "-80px 0px -70% 0px"
        };
    }

    private string GetLinkClass(OnThisPageTocItem item)
    {
        if (_lastLinkClass != LinkClass)
        {
            _lastLinkClass = LinkClass;
            _topLinkClass = _nestedLinkClass = _deepLinkClass = null;
        }
        ref string? result = ref (item.Level == 3 ? ref _nestedLinkClass : ref (item.Level >= 4 ? ref _deepLinkClass : ref _topLinkClass));
        if (result is not null)
            return result;

        var builder = new PooledStringBuilder(stackalloc char[128]);

        AppendClass(ref builder, _defaultLinkClass);
        AppendClass(ref builder, LinkClass);

        AppendClass(ref builder, item.Level switch
        {
            3 => "pl-4",
            >= 4 => "pl-6",
            _ => null
        });

        AppendClass(ref builder, "data-[active=true]:font-medium data-[active=true]:!text-foreground");

        return result = builder.ToStringAndDispose();
    }

    private string GetAsideClass() => string.IsNullOrWhiteSpace(Class)
        ? _defaultAsideClass
        : QuarkStringCache.Concat(_defaultAsideClass, " ", Class, ref _asideClass);

    private string GetLinkHref(string id)
    {
        var uri = Navigation.Uri;
        if (!string.Equals(_linkUri, uri, StringComparison.Ordinal))
        {
            var path = Navigation.ToBaseRelativePath(uri);
            var hashIndex = path.IndexOf('#');
            string nextPath = hashIndex >= 0 ? path[..hashIndex] : path;
            if (_linkPath != nextPath)
                _linkHrefs?.Clear();
            _linkPath = nextPath;
            _linkUri = uri;
        }

        var hrefs = _linkHrefs ??= new Dictionary<string, string>(StringComparer.Ordinal);
        if (!hrefs.TryGetValue(id, out var href))
        {
            href = string.IsNullOrWhiteSpace(_linkPath) ? string.Concat("#", id) : string.Concat(_linkPath, "#", id);
            hrefs.Add(id, href);
        }
        return href;
    }

    private static void AppendClass(ref PooledStringBuilder builder, string? className)
    {
        if (string.IsNullOrWhiteSpace(className))
            return;

        if (builder.Length > 0)
            builder.Append(' ');

        builder.Append(className);
    }

    private async ValueTask ScheduleRefresh()
    {
        if (_disposed.Value)
            return;

        var source = new CancellationTokenSource();
        var token = source.Token;
        var previous = _refreshCts;
        _refreshCts = source;
        try
        {
            if (previous is not null)
                await previous.CancelAsync();

            await Task.Delay(75, token);
            if (!token.IsCancellationRequested)
                await Refresh();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_refreshCts, source))
                _refreshCts = null;
            source.Dispose();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () => await ScheduleRefresh());
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;

        Navigation.LocationChanged -= OnLocationChanged;

        var refreshCts = _refreshCts;

        if (refreshCts != null)
            await refreshCts.CancelAsync();

        using (await _refreshLock.Lock())
        {
            refreshCts?.Dispose();

            if (ReferenceEquals(_refreshCts, refreshCts))
                _refreshCts = null;
        }
    }
}
