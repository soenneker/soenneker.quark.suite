@using System.Globalization
@using Microsoft.JSInterop
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IAsyncDisposable

@inject IResizableInterop ResizableInterop

<CascadingValue Name="ParentResizablePanelGroup" Value="@this">
    <div @ref="ElementRef" @attributes="BuildAttributes()">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsFull;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private string? _lastPrependedClass;
    private string? _lastBuiltStyle;

    private readonly List<ResizablePanel> _panels = [];
    private readonly List<ResizableHandle> _handles = [];
    private DotNetObjectReference<ResizablePanelGroup>? _dotNetRef;
    private double[]? _sizes;
    private bool _layoutDirty = true;
    private bool _isDragging;

    [CascadingParameter(Name = "DirectionProviderDir")]
    private string? DirectionProviderDir { get; set; }

    /// <summary>
    /// Gets or sets orientation: horizontal or vertical.
    /// </summary>
    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Horizontal;

    internal string OrientationValue => Orientation.Value;
    internal bool IsVertical => Orientation == Orientation.Vertical;
    internal ElementReference GroupElementRef => ElementRef;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "resizable-panel-group";
        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;

    }

    internal DotNetObjectReference<ResizablePanelGroup> GetOrCreateDotNetRef()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        return _dotNetRef;
    }

    private bool IsHorizontalRtl()
    {
        if (IsVertical)
            return false;

        if (string.Equals(DirectionProviderDir, "rtl", StringComparison.OrdinalIgnoreCase))
            return true;

        if (Attributes is not null &&
            Attributes.TryGetValue("dir", out var dirValue) &&
            string.Equals(dirValue?.ToString(), "rtl", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }

    internal int RegisterPanel(ResizablePanel panel)
    {
        var index = _panels.IndexOf(panel);
        if (index < 0)
        {
            index = _panels.Count;
            _panels.Add(panel);
            _layoutDirty = true;
            UpdatePanelIndexes();
        }
        return index;
    }

    internal void UnregisterPanel(ResizablePanel panel)
    {
        if (_panels.Remove(panel))
        {
            _layoutDirty = true;
            UpdatePanelIndexes();
            Refresh();
        }
    }

    internal int RegisterHandle(ResizableHandle handle)
    {
        var index = _handles.IndexOf(handle);
        if (index < 0)
        {
            index = _handles.Count;
            _handles.Add(handle);
            UpdateHandleIndexes();
        }
        return index;
    }

    internal void UnregisterHandle(ResizableHandle handle)
    {
        if (_handles.Remove(handle))
        {
            UpdateHandleIndexes();
            Refresh();
        }
    }

    internal void NotifyPanelConfigurationChanged()
    {
        _layoutDirty = true;

        if (!_isDragging)
            Refresh();
    }

    internal double GetPanelSize(int index)
    {
        EnsureLayoutState();
        return _sizes is not null && index >= 0 && index < _sizes.Length ? _sizes[index] : 0d;
    }

    internal string BuildPanelStyle(ResizablePanel panel, int index)
    {
        var size = GetPanelSize(index);
        var styles = new PooledStringBuilder(stackalloc char[256]);

        try
        {
            AppendStyleDecl(ref styles, "min-height: 0px");
            AppendStyleDecl(ref styles, "max-height: 100%");
            AppendStyleDecl(ref styles, "height: auto");
            AppendStyleDecl(ref styles, "min-width: 0px");
            AppendStyleDecl(ref styles, "max-width: 100%");
            AppendStyleDecl(ref styles, "width: auto");
            AppendStyleDecl(ref styles, "border: 0px");
            AppendStyleDecl(ref styles, "padding: 0px");
            AppendStyleDecl(ref styles, "margin: 0px");
            AppendStyleDecl(ref styles, "display: flex");
            styles.Append("; flex: ");
            styles.AppendInvariant(size);
            styles.Append(" 1 0px");
            AppendStyleDecl(ref styles, "overflow: hidden");

            if (IsVertical)
            {
                if (panel.MinSize.HasValue)
                {
                    styles.Append("; min-height: ");
                    styles.AppendInvariant(panel.MinSize.Value);
                    styles.Append("px");
                }

                if (panel.MaxSize.HasValue)
                {
                    styles.Append("; max-height: ");
                    styles.AppendInvariant(panel.MaxSize.Value);
                    styles.Append("px");
                }
            }
            else
            {
                if (panel.MinSize.HasValue)
                {
                    styles.Append("; min-width: ");
                    styles.AppendInvariant(panel.MinSize.Value);
                    styles.Append("px");
                }

                if (panel.MaxSize.HasValue)
                {
                    styles.Append("; max-width: ");
                    styles.AppendInvariant(panel.MaxSize.Value);
                    styles.Append("px");
                }
            }

            return styles.ToString();
        }
        finally
        {
            styles.Dispose();
        }
    }

    internal string GetSeparatorOrientation()
    {
        return IsVertical ? "horizontal" : "vertical";
    }

    internal double GetHandleValue(int handleIndex)
    {
        EnsureLayoutState();

        if (_sizes is null || handleIndex < 0 || handleIndex >= _sizes.Length)
            return 50d;

        return Math.Round(_sizes[handleIndex], 2, MidpointRounding.AwayFromZero);
    }

    internal Task StartHandleDrag(int handleIndex, PointerEventArgs e)
    {
        return StartHandleDrag(handleIndex, e.ClientX, e.ClientY, (long)e.PointerId);
    }

    internal Task StartHandleDrag(int handleIndex, MouseEventArgs e)
    {
        return StartHandleDrag(handleIndex, e.ClientX, e.ClientY, 0);
    }

    private Task StartHandleDrag(int handleIndex, double clientX, double clientY, long pointerId)
    {
        if (_isDragging || handleIndex < 0 || handleIndex >= _panels.Count - 1)
            return Task.CompletedTask;

        _dotNetRef ??= DotNetObjectReference.Create(this);
        _isDragging = true;

        return ResizableInterop.StartDrag(ElementRef, pointerId, clientX, clientY, OrientationValue, _dotNetRef, handleIndex).AsTask();
    }

    internal async Task HandleHandleKeyDown(int handleIndex, KeyboardEventArgs e)
    {
        var delta = e.ShiftKey ? 10d : 5d;
        double signedDelta;

        if (IsVertical)
        {
            signedDelta = e.Key switch
            {
                "ArrowUp" => -delta,
                "ArrowDown" => delta,
                _ => 0d
            };
        }
        else
        {
            signedDelta = e.Key switch
            {
                "ArrowLeft" when IsHorizontalRtl() => delta,
                "ArrowRight" when IsHorizontalRtl() => -delta,
                "ArrowLeft" => -delta,
                "ArrowRight" => delta,
                _ => 0d
            };
        }

        if (signedDelta == 0d)
            return;

        AdjustHandleByDelta(handleIndex, signedDelta, 0d);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task HandlePointerDragMove(int handleIndex, double percentage, double containerSize)
    {
        AdjustHandleToPercentage(handleIndex, percentage, containerSize);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task HandlePointerDragEnd(int handleIndex, double percentage, double containerSize)
    {
        AdjustHandleToPercentage(handleIndex, percentage, containerSize);
        _isDragging = false;
        return Task.CompletedTask;
    }

    private void EnsureLayoutState()
    {
        if (!_layoutDirty && _sizes is not null && _sizes.Length == _panels.Count)
            return;

        if (_panels.Count == 0)
        {
            _sizes = Array.Empty<double>();
            _layoutDirty = false;
            return;
        }

        var totalWeight = 0d;

        for (var i = 0; i < _panels.Count; i++)
        {
            totalWeight += Math.Max(1, _panels[i].DefaultSize);
        }

        var nextSizes = _sizes is not null && _sizes.Length == _panels.Count ? _sizes : new double[_panels.Count];

        for (var i = 0; i < _panels.Count; i++)
        {
            double weight = Math.Max(1, _panels[i].DefaultSize);
            nextSizes[i] = (weight / totalWeight) * 100d;
        }

        NormalizeSizes(nextSizes);
        _sizes = nextSizes;
        _layoutDirty = false;
    }

    private void AdjustHandleToPercentage(int handleIndex, double percentage, double containerSize)
    {
        EnsureLayoutState();

        if (_sizes is null || handleIndex < 0 || handleIndex >= _sizes.Length - 1)
            return;

        var offset = 0d;

        for (var i = 0; i < handleIndex; i++)
        {
            offset += _sizes[i];
        }

        var pairTotal = _sizes[handleIndex] + _sizes[handleIndex + 1];
        var nextPrimary = percentage - offset;
        ApplyPairSizes(handleIndex, pairTotal, nextPrimary, containerSize);
    }

    private void AdjustHandleByDelta(int handleIndex, double deltaPercent, double containerSize)
    {
        EnsureLayoutState();

        if (_sizes is null || handleIndex < 0 || handleIndex >= _sizes.Length - 1)
            return;

        var pairTotal = _sizes[handleIndex] + _sizes[handleIndex + 1];
        var nextPrimary = _sizes[handleIndex] + deltaPercent;
        ApplyPairSizes(handleIndex, pairTotal, nextPrimary, containerSize);
    }

    private void ApplyPairSizes(int handleIndex, double pairTotal, double requestedPrimarySize, double containerSize)
    {
        if (_sizes is null)
            return;

        (var minPrimary, var maxPrimary) = GetAllowedRange(handleIndex, pairTotal, containerSize);
        var primarySize = Math.Clamp(requestedPrimarySize, minPrimary, maxPrimary);
        var secondarySize = pairTotal - primarySize;

        if (_sizes[handleIndex] == primarySize && _sizes[handleIndex + 1] == secondarySize)
            return;

        _sizes[handleIndex] = primarySize;
        _sizes[handleIndex + 1] = secondarySize;
        NormalizeSizes(_sizes);
        RefreshLayoutDependents();
    }

    private (double minPrimary, double maxPrimary) GetAllowedRange(int handleIndex, double pairTotal, double containerSize)
    {
        var primary = _panels[handleIndex];
        var secondary = _panels[handleIndex + 1];

        var primaryMin = GetMinPercent(primary.MinSize, containerSize);
        var secondaryMin = GetMinPercent(secondary.MinSize, containerSize);
        var primaryMax = GetMaxPercent(primary.MaxSize, containerSize);
        var secondaryMax = GetMaxPercent(secondary.MaxSize, containerSize);

        var lowerBound = Math.Max(primaryMin, pairTotal - secondaryMax);
        var upperBound = Math.Min(primaryMax, pairTotal - secondaryMin);

        if (upperBound < lowerBound)
            return (lowerBound, lowerBound);

        return (lowerBound, upperBound);
    }

    private static double GetMinPercent(int? pixelValue, double containerSize)
    {
        if (!pixelValue.HasValue || pixelValue.Value <= 0 || containerSize <= 0)
            return 0d;

        return Math.Clamp((pixelValue.Value / containerSize) * 100d, 0d, 100d);
    }

    private static double GetMaxPercent(int? pixelValue, double containerSize)
    {
        if (!pixelValue.HasValue || pixelValue.Value <= 0 || containerSize <= 0)
            return double.PositiveInfinity;

        return Math.Clamp((pixelValue.Value / containerSize) * 100d, 0d, 100d);
    }

    private static void NormalizeSizes(double[] sizes)
    {
        if (sizes.Length == 0)
            return;

        var total = 0d;

        for (var i = 0; i < sizes.Length; i++)
        {
            total += sizes[i];
        }

        if (total <= 0)
        {
            var equal = 100d / sizes.Length;

            for (var i = 0; i < sizes.Length; i++)
            {
                sizes[i] = equal;
            }

            return;
        }

        for (var i = 0; i < sizes.Length; i++)
        {
            sizes[i] = (sizes[i] / total) * 100d;
        }
    }

    private void UpdatePanelIndexes()
    {
        for (var i = 0; i < _panels.Count; i++)
        {
            _panels[i].SetIndex(i);
        }
    }

    private void UpdateHandleIndexes()
    {
        for (var i = 0; i < _handles.Count; i++)
        {
            _handles[i].SetIndex(i);
        }
    }

    private void RefreshLayoutDependents()
    {
        foreach (var panel in _panels)
        {
            panel.Refresh();
        }

        foreach (var handle in _handles)
        {
            handle.Refresh();
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-group"] = "true";

        if (!attributes.ContainsKey("dir") && !string.IsNullOrWhiteSpace(DirectionProviderDir))
            attributes["dir"] = DirectionProviderDir!;

        PrependClassAttribute(attributes, "aria-[orientation=vertical]:flex-col", ref _lastPrependedClass);

        PrependStyleAttribute(attributes, IsVertical
            ? "height:100%; width:100%; overflow:hidden; display:flex; flex-direction:column; flex-wrap:nowrap"
            : "height:100%; width:100%; overflow:hidden; display:flex; flex-direction:row; flex-wrap:nowrap", ref _lastBuiltStyle);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ResizableInterop.Initialize();

        await base.OnAfterRenderAsync(firstRender);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(OrientationValue);

        if (_sizes is not null)
        {
            foreach (var size in _sizes)
            {
                hc.Add(size);
            }
        }
    }

    public override async ValueTask DisposeAsync()
    {
        await ResizableInterop.StopDrag();
        _dotNetRef?.Dispose();
        await base.DisposeAsync();
    }
}
