@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@implements IAsyncDisposable

@inject IResizableInterop ResizableInterop

<div @ref="ElementRef"
     @attributes="BuildAttributes()"
     @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)">
    @if (WithHandle)
    {
        <Div Display="_renderCss0"
             Height="_renderCss1"
             Width="_renderCss2"
             Shrink="_renderCss3"
             Rounded="_renderCss4"
             BackgroundColor='_renderCss5'
             ZIndex="_renderCss6" />
    }
</div>

@code {
    private static readonly object _maximumValue = 100;
    private QuarkDoubleAttribute _handleValue;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsPx;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _renderCss1 = Quark.Height.Is6;
    private static readonly CssValue<WidthBuilder> _renderCss2 = Quark.Width.Is1;
    private static readonly CssValue<ShrinkBuilder> _renderCss3 = Quark.Shrink.Is0;
    private static readonly CssValue<RoundedBuilder> _renderCss4 = Quark.Rounded.Lg;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss5 = Quark.BackgroundColor.Utility("bg-border");
    private static readonly CssValue<ZIndexBuilder> _renderCss6 = Quark.ZIndex.Is10;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;

    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    [CascadingParameter(Name = "ParentResizablePanelGroup")]
    private ResizablePanelGroup? ParentPanelGroup { get; set; }

    [CascadingParameter(Name = "DirectionProviderDir")]
    private string? DirectionProviderDir { get; set; }

    private ResizablePanelGroup? _registeredParentPanelGroup;
    private ResizablePanelGroup? _interopParentPanelGroup;
    private string? _interopOrientation;
    private int _interopIndex = -1;
    private bool _interopRegistered;
    private int _index;

    /// <summary>
    /// Gets or sets whether to show a visible grip handle.
    /// </summary>
    [Parameter]
    public bool WithHandle { get; set; }

    private bool IsVertical => ParentPanelGroup?.IsVertical == true;
    private string SeparatorOrientation => ParentPanelGroup?.GetSeparatorOrientation() ?? "vertical";
    private bool IsRtl => string.Equals(DirectionProviderDir, "rtl", StringComparison.OrdinalIgnoreCase);

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "resizable-handle";
        Position ??= _defaultPosition;
        Display ??= _renderCss0;
        Width ??= _defaultWidth;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        BackgroundColor ??= _renderCss5;

    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RegisterWithParent();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!ReferenceEquals(_registeredParentPanelGroup, ParentPanelGroup))
        {
            _registeredParentPanelGroup?.UnregisterHandle(this);
            RegisterWithParent();
        }
    }

    private void RegisterWithParent()
    {
        if (ParentPanelGroup is null)
            return;

        _registeredParentPanelGroup = ParentPanelGroup;
        _index = ParentPanelGroup.RegisterHandle(this);
    }

    internal void SetIndex(int index)
    {
        if (_index == index)
            return;

        _index = index;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task HandleKeyDown(KeyboardEventArgs e) =>
        ParentPanelGroup?.HandleHandleKeyDown(_index, e) ?? Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ParentPanelGroup is null)
        {
            if (_interopRegistered)
            {
                await ResizableInterop.UnregisterHandle(ElementRef);
                ClearInteropRegistration();
            }
        }
        else if (!_interopRegistered ||
                 !ReferenceEquals(_interopParentPanelGroup, ParentPanelGroup) ||
                 _interopIndex != _index ||
                 !string.Equals(_interopOrientation, ParentPanelGroup.OrientationValue, StringComparison.Ordinal))
        {
            await ResizableInterop.RegisterHandle(ElementRef, ParentPanelGroup.GroupElementRef, ParentPanelGroup.OrientationValue,
                ParentPanelGroup.GetOrCreateDotNetRef(), _index);
            _interopRegistered = true;
            _interopParentPanelGroup = ParentPanelGroup;
            _interopOrientation = ParentPanelGroup.OrientationValue;
            _interopIndex = _index;
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void ClearInteropRegistration()
    {
        _interopRegistered = false;
        _interopParentPanelGroup = null;
        _interopOrientation = null;
        _interopIndex = -1;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["role"] = "separator";
        attributes["tabindex"] = QuarkAttributeValues.Zero;
        attributes["aria-orientation"] = SeparatorOrientation;
        attributes["aria-valuemin"] = QuarkAttributeValues.Zero;
        attributes["aria-valuemax"] = _maximumValue;
        attributes["aria-valuenow"] = _handleValue.Get(ParentPanelGroup?.GetHandleValue(_index) ?? 50d);

        PrependClassAttribute(attributes, IsRtl
            ? "ring-offset-background after:absolute after:inset-y-0 after:start-1/2 after:w-1 after:-translate-x-1/2 focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-hidden aria-[orientation=horizontal]:h-px aria-[orientation=horizontal]:w-full aria-[orientation=horizontal]:after:start-0 aria-[orientation=horizontal]:after:h-1 aria-[orientation=horizontal]:after:w-full aria-[orientation=horizontal]:after:translate-x-0 aria-[orientation=horizontal]:after:-translate-y-1/2 rtl:after:translate-x-1/2 rtl:aria-[orientation=horizontal]:after:-translate-x-0 [&[aria-orientation=horizontal]>div]:rotate-90"
            : "ring-offset-background after:absolute after:inset-y-0 after:left-1/2 after:w-1 after:-translate-x-1/2 focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-hidden aria-[orientation=horizontal]:h-px aria-[orientation=horizontal]:w-full aria-[orientation=horizontal]:after:left-0 aria-[orientation=horizontal]:after:h-1 aria-[orientation=horizontal]:after:w-full aria-[orientation=horizontal]:after:translate-x-0 aria-[orientation=horizontal]:after:-translate-y-1/2 [&[aria-orientation=horizontal]>div]:rotate-90", ref _lastBuiltClass);

        PrependStyleAttribute(attributes, "flex-basis:auto; flex-grow:0; flex-shrink:0", ref _lastBuiltStyle);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(WithHandle);
        hc.Add(IsVertical);
        hc.Add(IsRtl);
        hc.Add(_index);
        hc.Add(SeparatorOrientation);
        hc.Add(ParentPanelGroup?.GetHandleValue(_index));
    }

    public override async ValueTask DisposeAsync()
    {
        _registeredParentPanelGroup?.UnregisterHandle(this);

        if (_interopRegistered)
        {
            await ResizableInterop.UnregisterHandle(ElementRef);
            ClearInteropRegistration();
        }

        await base.DisposeAsync();
    }
}
