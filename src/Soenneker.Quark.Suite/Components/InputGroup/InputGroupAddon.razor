@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IInputGroupAddon

<div @onclick="(_cachedHandleAddonClickDelegate ??= HandleAddonClick)" @attributes="BuildAttributes()">@ChildContent</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Auto;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Text;
    private static readonly CssValue<JustifyBuilder> _defaultJustify2 = Quark.Justify.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<PaddingBuilder> _defaultPadding4 = Quark.Padding.OnY.Is1_5.FromRight.Is2;
    private static readonly CssValue<PaddingBuilder> _defaultPadding3 = Quark.Padding.OnX.Is3.FromTop.Is3;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Start;
    private static readonly CssValue<PaddingBuilder> _defaultPadding2 = Quark.Padding.OnX.Is3.FromBottom.Is3;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnY.Is1_5.FromLeft.Is2;
    private string? _lastBuiltClass;

    private Func<MouseEventArgs, Task>? _cachedHandleAddonClickDelegate;

    [CascadingParameter]
    internal InputGroupContext? InputGroupContext { get; set; }

    [Parameter]
    public InputGroupAddonAlign AddonAlign { get; set; } = InputGroupAddonAlign.InlineStart;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "input-group-addon";

        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        Cursor ??= _defaultCursor;
        ItemsAlign ??= _staticCss0;
        Justify ??= ReferenceEquals(AddonAlign, InputGroupAddonAlign.BlockStart) || ReferenceEquals(AddonAlign, InputGroupAddonAlign.BlockEnd)
            ? _defaultJustify
            : _defaultJustify2;
        Gap ??= _defaultGap;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= _defaultTextColor;
        UserSelect ??= _defaultUserSelect;

        if (ReferenceEquals(AddonAlign, InputGroupAddonAlign.InlineEnd))
        {
            Padding ??= _defaultPadding4;
            return;
        }

        if (ReferenceEquals(AddonAlign, InputGroupAddonAlign.BlockStart))
        {
            Width ??= _defaultWidth;
            Padding ??= _defaultPadding3;
            return;
        }

        if (ReferenceEquals(AddonAlign, InputGroupAddonAlign.BlockEnd))
        {
            Width ??= _defaultWidth;
            Padding ??= _defaultPadding2;
            return;
        }

        Padding ??= _defaultPadding;
    }

    private static string GetAlignValue(InputGroupAddonAlign align)
    {
        if (ReferenceEquals(align, InputGroupAddonAlign.InlineEnd))
            return "inline-end";

        if (ReferenceEquals(align, InputGroupAddonAlign.BlockStart))
            return "block-start";

        if (ReferenceEquals(align, InputGroupAddonAlign.BlockEnd))
            return "block-end";

        return "inline-start";
    }

    private static string GetAlignClass(InputGroupAddonAlign align)
    {
        const string prefix = "group-data-[disabled=true]/input-group:opacity-50 [&>kbd]:rounded-[calc(var(--radius)-5px)] [&>svg:not([class*='size-'])]:size-4 ";
        if (ReferenceEquals(align, InputGroupAddonAlign.InlineEnd))
            return prefix + "order-last pr-2 has-[>button]:mr-[-0.3rem] has-[>kbd]:mr-[-0.15rem]";

        if (ReferenceEquals(align, InputGroupAddonAlign.BlockStart))
            return prefix + "order-first group-has-[>input]/input-group:pt-2.5 [.border-b]:pb-3";

        if (ReferenceEquals(align, InputGroupAddonAlign.BlockEnd))
            return prefix + "order-last group-has-[>input]/input-group:pb-2.5 [.border-t]:pt-3";

        return prefix + "order-first pl-2 has-[>button]:ml-[-0.3rem] has-[>kbd]:ml-[-0.15rem]";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["role"] = "group";
        attributes["data-align"] = GetAlignValue(AddonAlign);

        PrependClassAttribute(attributes, GetAlignClass(AddonAlign), ref _lastBuiltClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AddonAlign);
    }

    private Task HandleAddonClick(MouseEventArgs _) => InputGroupContext?.FocusControl().AsTask() ?? Task.CompletedTask;
}
