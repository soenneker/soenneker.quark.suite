@namespace Soenneker.Quark
@using ButtonSizeType = Soenneker.Quark.ButtonSize
@inherits Soenneker.Quark.Element
@implements IInputGroupButton

<Button Type="@Type" Variant="@Variant" ButtonSize="@ButtonSize" InputGroupButton="true" Attributes="BuildAttributes()">@ChildContent</Button>

@code {
    private static readonly CssValue<ButtonSizeBuilder> _staticCss1 = ButtonSizeType.Default;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.None;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private string? _lastBuiltClass;

    [Parameter]
    public CssValue<ButtonSizeBuilder> ButtonSize { get; set; } = _staticCss1;

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Default;

    [Parameter]
    public ButtonType Type { get; set; } = ButtonType.Button;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Shadow ??= _defaultShadow;
        TextSize ??= _defaultTextSize;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        PrependClassAttribute(attributes, Button.GetInputGroupButtonSizeClass(ButtonSize), ref _lastBuiltClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ButtonSize);
        hc.Add(Variant);
        hc.Add(Type);
    }
}
