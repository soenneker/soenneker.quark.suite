@using System.Threading
@implements IAutoSaveInput<string?>
@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements IInputGroupTextarea

<textarea @ref="_elementRef"
          @attributes="BuildAttributes()"
          value="@Value"
          @oninput="(_cachedHandleInputDelegate ??= HandleInput)"></textarea>


@if (AutoSave && ShowAutoSaveStatus && OnAutoSave is not null)
{
    <span data-slot="input-group-autosave-status" class="ml-auto mr-3 inline-flex shrink-0">
        <AutoSaveStatus State="@_autoSave.State" HasSaved="@_autoSave.HasSaved" Visible="@(AutoSave && ShowAutoSaveStatus && OnAutoSave is not null)"
                Class="@AutoSaveStatusClass" SavingClass="@AutoSaveSavingClass"
                SavedClass="@AutoSaveSavedClass" FailedClass="@AutoSaveFailedClass" />
    </span>
}

@code {
    private async Task PublishAutoSaveValue(string? value)
    {
        await ValueChanged.InvokeIfHasDelegate(value);
        await NotifyAutoSave(value);
    }

    [Parameter] public bool AutoSave { get; set; } = false;
    [Parameter] public int AutoSaveDelay { get; set; } = 750;
    [Parameter] public bool ShowAutoSaveStatus { get; set; } = true;
    [Parameter] public Func<string?, CancellationToken, ValueTask>? OnAutoSave { get; set; }
    [Parameter] public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }
    [Parameter] public string? AutoSaveStatusClass { get; set; }
    [Parameter] public string? AutoSaveSavingClass { get; set; }
    [Parameter] public string? AutoSaveSavedClass { get; set; }
    [Parameter] public string? AutoSaveFailedClass { get; set; }
    private AutoSaveController<string?> _autoSave;
    private Func<Task>? _autoSaveRefresh;
    private Task RefreshAutoSave() => InvokeAsync(StateHasChanged);
    private Task NotifyAutoSave(string? value) => _autoSave.NotifyValueChanged(value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, _autoSaveRefresh ??= RefreshAutoSave);

    private QuarkInt32Attribute _rowsAttribute;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<MinHeightBuilder> _defaultMinHeight = Quark.MinHeight.Token("16");
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Input.OnFocusVisible.Ring;
    private static readonly CssValue<FlexBuilder> _defaultFlex = Quark.Flex.Is1;
    private static readonly CssValue<ResizeBuilder> _defaultResize = Quark.Resize.None;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.None;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Is0;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is3.OnY.Is3;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.None;
    private static readonly CssValue<RingBuilder> _defaultRing = Quark.Ring.None.OnFocusVisible.Aria("invalid");
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Base.OnMd.Sm;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.OnDisabled.NotAllowed;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.OnDisabled.Is50;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Token("colors");
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private string? _lastPrependedClass;

    private Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;

    private ElementReference _elementRef;

    [CascadingParameter]
    internal InputGroupContext? InputGroupContext { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public int? Rows { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "input-group-control";
        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        MinHeight ??= _defaultMinHeight;
        BorderColor ??= _defaultBorderColor;
        Flex ??= _defaultFlex;
        Resize ??= _defaultResize;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        Shadow ??= _defaultShadow;
        Ring ??= _defaultRing;
        RingColor ??= _defaultRingColor;
        TextSize ??= _defaultTextSize;
        Cursor ??= _defaultCursor;
        Opacity ??= _defaultOpacity;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;

    }

    private Task HandleInput(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) return Task.CompletedTask;
        var value = e.Value?.ToString();
        if (Value == value) return Task.CompletedTask;
        Value = value;
        return PublishAutoSaveValue(value);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            InputGroupContext?.RegisterControl(_elementRef);

        return base.OnAfterRenderAsync(firstRender);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        ApplyFieldControlAttributes(attributes);

        if (Placeholder is not null)
            attributes["placeholder"] = Placeholder;
        if (Disabled)
            attributes["disabled"] = QuarkAttributeValues.True;
        if (ReadOnly)
            attributes["readonly"] = QuarkAttributeValues.True;
        if (Required)
            attributes["required"] = QuarkAttributeValues.True;
        if (Rows.HasValue)
            attributes["rows"] = _rowsAttribute.Get(Rows.Value);

        PrependClassAttribute(attributes, "field-sizing-content placeholder:text-muted-foreground focus-visible:ring-0 disabled:bg-transparent aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:bg-transparent dark:disabled:bg-transparent dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(OnAutoSave);
        hc.Add(AutoSaveStateChanged);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);

        hc.Add(Value);
        hc.Add(Placeholder);
        hc.Add(Disabled);
        hc.Add(ReadOnly);
        hc.Add(Required);
        hc.Add(Rows);
    }
    public override async ValueTask DisposeAsync()
    {
        await _autoSave.DisposeAsync();
        await base.DisposeAsync();
    }
}
