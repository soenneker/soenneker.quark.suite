@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.Element

<BradixTabsTrigger Value="@ResolvedValue"
                   Disabled="@Disabled"
                   OnMouseDown="(_cachedHandleClickDelegate ??= HandleClick)"
                   AdditionalAttributes="@TriggerAttributes">
    @ChildContent
</BradixTabsTrigger>

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    private string? _lastBuiltClass;

    private QuarkAttributeDictionary _attributesBuffer;
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [CascadingParameter(Name = nameof(ParentTabs))]
    private Tabs? ParentTabs { get; set; }

    private string ResolvedValue => Value ?? string.Empty;

    private IReadOnlyDictionary<string, object> TriggerAttributes
    {
        get
        {
            Dictionary<string, object> attributes = _attributesBuffer.Create(BuildAttributes());
            attributes.Remove("type");
            attributes.Remove("role");
            attributes.Remove("id");
            attributes.Remove("aria-controls");
            attributes.Remove("aria-selected");
            attributes.Remove("tabindex");
            attributes.Remove("data-state");
            attributes.Remove("disabled");
            attributes.Remove("onfocus");
            attributes.Remove("onkeydown");

            return attributes;
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tabs-trigger";

        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        Rounded ??= _defaultRounded;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (ParentTabs is not null)
            PrependClassAttribute(attributes, ParentTabs.TabsTriggerBaseClass, ref _lastBuiltClass);
    }

    internal Task Focus()
    {
        return Task.CompletedTask;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(OnClick.HasDelegate);
        hc.Add(Value);
        hc.Add(Disabled);
        hc.Add(ParentTabs?.Loop);
    }

    private Task HandleClick(MouseEventArgs args)
    {
        return OnClick.HasDelegate ? OnClick.InvokeAsync(args) : Task.CompletedTask;
    }
}