@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.Element

<BradixTabsContent Value="@ResolvedValue"
                   ForceMount="@ForceMount"
                   AdditionalAttributes="@ContentAttributes">
    @ChildContent
</BradixTabsContent>

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<FlexBuilder> _defaultFlex = Quark.Flex.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private QuarkAttributeDictionary _attributesBuffer;
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Radix <c>forceMount</c>: keep panel content in the tree even when inactive (e.g. animations).</summary>
    [Parameter]
    public bool ForceMount { get; set; }

    [CascadingParameter(Name = nameof(ParentTabs))]
    private Tabs? ParentTabs { get; set; }

    private string ResolvedValue => Value ?? string.Empty;

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildContentAttributes();

    private IReadOnlyDictionary<string, object> BuildContentAttributes()
    {
        Dictionary<string, object> attributes = _attributesBuffer.Create(BuildAttributes());
        attributes.Remove("role");
        attributes.Remove("tabindex");
        attributes.Remove("hidden");
        attributes.Remove("id");
        attributes.Remove("aria-labelledby");
        attributes.Remove("data-state");
        attributes.Remove("data-orientation");
        return attributes;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tabs-content";

        Flex ??= _defaultFlex;
        TextSize ??= _defaultTextSize;
        OutlineStyle ??= _defaultOutlineStyle;
        if (ParentTabs?.Vertical == true)
            MinWidth ??= _staticCss0;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(ParentTabs?.Vertical);
        hc.Add(ForceMount);
    }
}