@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.Element

<BradixTabsList Loop="@(ParentTabs?.Loop ?? true)"
                AdditionalAttributes="@ListAttributes">
    @ChildContent
</BradixTabsList>

@code {
    private static readonly CssValue<WidthBuilder> _justifiedWidth = Quark.Width.IsFull;
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFit;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Token("[3px]");
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<RoundedBuilder> _defaultRounded2 = Quark.Rounded.None;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor2 = Quark.BackgroundColor.Muted;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private string? _lastBuiltClass;

    private QuarkAttributeDictionary _attributesBuffer;
    [CascadingParameter(Name = nameof(ParentTabs))]
    private Tabs? ParentTabs { get; set; }

    private IReadOnlyDictionary<string, object> ListAttributes => BuildListAttributes();

    private IReadOnlyDictionary<string, object> BuildListAttributes()
    {
        Dictionary<string, object> attributes = _attributesBuffer.Create(BuildAttributes());
        attributes.Remove("role");
        attributes.Remove("aria-orientation");
        attributes.Remove("tabindex");
        return attributes;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tabs-list";

        var hasExplicitWidth = Width is not null;

        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Padding ??= _defaultPadding;
        TextColor ??= _defaultTextColor;

        if (ReferenceEquals(ParentTabs?.TabsListVariant, TabsListVariant.Line))
            Rounded ??= _defaultRounded2;
        else
            Rounded ??= _defaultRounded;

        if (ReferenceEquals(ParentTabs?.TabsListVariant, TabsListVariant.Default))
            BackgroundColor ??= _defaultBackgroundColor2;

        if (!ReferenceEquals(ParentTabs?.TabsListVariant, TabsListVariant.Default))
        {
            Gap ??= _defaultGap;
            BackgroundColor ??= _defaultBackgroundColor;
        }

        if (ParentTabs?.Justified == true && !hasExplicitWidth)
            Width = _justifiedWidth;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-variant"] = ReferenceEquals(ParentTabs?.TabsListVariant, TabsListVariant.Line) ? "line" : "default";
        attributes["aria-orientation"] = ParentTabs?.Vertical == true ? "vertical" : "horizontal";
        attributes["tabindex"] = QuarkAttributeValues.MinusOne;

        const string baseClass = "group/tabs-list data-[variant=line]:rounded-none group-data-[orientation=horizontal]/tabs:h-8 group-data-[orientation=vertical]/tabs:h-fit group-data-[orientation=vertical]/tabs:flex-col";
        PrependClassAttribute(attributes, ParentTabs?.Justified == true
            ? baseClass + " [&>[data-slot=tabs-trigger]]:flex-1" : baseClass, ref _lastBuiltClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentTabs?.Vertical);
        hc.Add(ParentTabs?.Justified);
        hc.Add(ParentTabs?.TabsListVariant);
    }
}
