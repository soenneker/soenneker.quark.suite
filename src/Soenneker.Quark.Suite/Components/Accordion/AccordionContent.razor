@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.Element
@implements IAccordionContent

<BradixAccordionContent ForceMount="@ResolvedForceMount" AdditionalAttributes="@OuterAttributes">
    <Div DataSlot="accordion-content-inner" Class="@InnerClass">
        @ChildContent
    </Div>
</BradixAccordionContent>

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);

        if (ParentAccordion?.AnimationsEnabled == true)
            AppendClass(ref cls, "data-[state=open]:animate-accordion-down data-[state=closed]:animate-accordion-up");
    }

    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;

    private QuarkAttributeDictionary _attributesBuffer;

    [CascadingParameter(Name = nameof(ParentAccordionItem))]
    public AccordionItem? ParentAccordionItem { get; set; }

    [CascadingParameter(Name = "ParentAccordion")]
    private Accordion? ParentAccordion { get; set; }

    private bool ResolvedForceMount => ParentAccordionItem?.ForceMount ?? false;

    private IReadOnlyDictionary<string, object> OuterAttributes => BuildOuterAttributes();

    private string? _lastInnerClass;

    private string InnerClass => AppendToClass("h-(--radix-accordion-content-height) pt-0 pb-2.5 [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground [&_p:not(:last-child)]:mb-4", Class ?? string.Empty, ref _lastInnerClass);

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        Overflow ??= _defaultOverflow;
        TextSize ??= _defaultTextSize;
    }

    private IReadOnlyDictionary<string, object> BuildOuterAttributes()
    {
        var className = Class;

        try
        {
            Class = null;

            Dictionary<string, object> attributes = _attributesBuffer.Create(BuildAttributes(), 1);
            attributes["data-slot"] = "accordion-content";



            return attributes;
        }
        finally
        {
            Class = className;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentAccordionItem?.ForceMount == true);
        hc.Add(ParentAccordion?.AnimationsEnabled == true);
    }

}
