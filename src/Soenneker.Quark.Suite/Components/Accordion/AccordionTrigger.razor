@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.TriggerElement
@implements IAccordionTrigger

<BradixAccordionHeader @attributes="HeaderAttributes">
    <BradixAccordionTrigger OnClick="@OnClick" OnKeyDown="@OnKeyDown" @attributes="TriggerAttributes">
        @ChildContent
        @if (ShowChevron)
        {
            <Icon Name="LucideIcon.ChevronDown" data-slot="accordion-trigger-icon" Size="_renderCss0" Shrink="_renderCss1" TextColor="_renderCss2" PointerEvents="_renderCss3" Transition="_renderCss4" Class="group-aria-expanded/accordion-trigger:rotate-180"/>
        }
    </BradixAccordionTrigger>
</BradixAccordionHeader>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Start;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexBuilder> _defaultFlex = Quark.Flex.Is1;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Between;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnY.Token("2.5");
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Transparent.OnFocusVisible.Ring;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<ShrinkBuilder> _renderCss1 = Quark.Shrink.Is0;
    private static readonly CssValue<TextColorBuilder> _renderCss2 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<PointerEventsBuilder> _renderCss3 = Quark.PointerEvents.None;
    private static readonly CssValue<TransitionBuilder> _renderCss4 = Quark.Transition.Transform;
    private string? _lastPrependedClass;

    private QuarkAttributeDictionary _attributesBuffer;
    private QuarkAttributeDictionary _headerAttributesBuffer;

    [Parameter]
    public bool ShowChevron { get; set; } = true;

    [CascadingParameter(Name = nameof(ParentAccordionItem))]
    public AccordionItem? ParentAccordionItem { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        Display ??= _defaultDisplay;
        Flex ??= _defaultFlex;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Rounded ??= _defaultRounded;
        TextAlign ??= "text-left";
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        Position ??= _defaultPosition;
        Padding ??= _defaultPadding;
        Border ??= _defaultBorder;
        BorderColor ??= _defaultBorderColor;
        RingColor ??= _defaultRingColor;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
    }

    private IReadOnlyDictionary<string, object> HeaderAttributes
    {
        get
        {
            Dictionary<string, object> attributes = _headerAttributesBuffer.Create(3);
            attributes["data-slot"] = "accordion-header";
            attributes["class"] = "flex";

            if (Disabled)
                attributes["data-disabled"] = "true";

            return attributes;
        }
    }

    private IReadOnlyDictionary<string, object> TriggerAttributes
    {
        get
        {
            Dictionary<string, object> attributes = _attributesBuffer.Create(BuildAttributes(), 1);
            attributes["data-slot"] = "accordion-trigger";

            attributes.Remove("onkeydown");

            if (Disabled)
            {
                attributes["disabled"] = QuarkAttributeValues.True;
                attributes["data-disabled"] = "true";
            }

            {
                const string @class = "group/accordion-trigger hover:underline focus-visible:ring-3 focus-visible:after:border-ring **:data-[slot=accordion-trigger-icon]:ml-auto **:data-[slot=accordion-trigger-icon]:size-4 **:data-[slot=accordion-trigger-icon]:text-muted-foreground";
                PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
            }

            return attributes;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShowChevron);
        hc.Add(Disabled);
        hc.Add(ParentAccordionItem?.ForceMount == true);
    }

}
