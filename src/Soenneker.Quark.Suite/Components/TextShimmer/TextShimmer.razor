@using System.Globalization
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<style>
@@keyframes text-shimmer {
    0% { background-position: 100% 50%; }
    100% { background-position: -100% 50%; }
}
</style>
@if (ResolvedTag == "p")
{
    <p @attributes="BuildAttributes()">@ChildContent</p>
}
else if (ResolvedTag == "div")
{
    <div @attributes="BuildAttributes()">@ChildContent</div>
}
else
{
    <span @attributes="BuildAttributes()">@ChildContent</span>
}

@code {
    private string? _lastPrependedClass;
    private string? _lastBuiltStyle;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "text-shimmer";
    }

    [Parameter]
    public double ShimmerDuration { get; set; } = 1;

    /// <summary>
    /// Gets or sets the rendered text element. Supported values are <c>span</c>, <c>p</c>, and <c>div</c>.
    /// </summary>
    [Parameter]
    public string Tag { get; set; } = "span";

    [Parameter]
    public double RepeatDelay { get; set; }

    [Parameter]
    public int Spread { get; set; } = 20;

    [Parameter]
    public int Angle { get; set; }

    [Parameter]
    public string? Color { get; set; }

    [Parameter]
    public bool InvertColor { get; set; }

    private string ResolvedTag => Tag;

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "bg-size-[200%_auto] bg-clip-text animate-[text-shimmer_var(--text-shimmer-duration)_linear_infinite]", ref _lastPrependedClass);

        PrependStyleAttribute(attributes, GetShimmerStyle(), ref _lastBuiltStyle);
    }

    private (long Duration, int Spread, int Angle, string? Color, bool Invert) _styleKey;
    private CultureInfo? _styleCulture;
    private string? _shimmerStyle;
    private string GetShimmerStyle()
    {
        var duration = Math.Max(ShimmerDuration + RepeatDelay, 0.001);
        var key = (BitConverter.DoubleToInt64Bits(duration), Math.Clamp(Spread, 5, 45), Angle, Color, InvertColor);
        var culture = CultureInfo.CurrentCulture;
        if (_shimmerStyle is not null && key == _styleKey && culture.IsReadOnly && ReferenceEquals(culture, _styleCulture))
            return _shimmerStyle;
        var durationText = duration.ToString("0.###", CultureInfo.InvariantCulture);
        _shimmerStyle = $"--text-shimmer-duration:{durationText}s; background-image:{BuildGradient()}; -webkit-text-fill-color:transparent";
        _styleKey = key;
        _styleCulture = culture;
        return _shimmerStyle;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShimmerDuration);
        hc.Add(RepeatDelay);
        hc.Add(Spread);
        hc.Add(Angle);
        hc.Add(Color);
        hc.Add(InvertColor);
        hc.Add(Tag);
    }

    private string BuildGradient()
    {
        var spread = Math.Clamp(Spread, 5, 45);
        var start = 50 - spread;
        var end = 50 + spread;
        var beam = Color ?? (InvertColor
            ? "oklch(from currentColor min(calc(l - 0.4), 0.2) c h / calc(alpha + 0.4))"
            : "oklch(from currentColor max(0.8, calc(l + 0.4)) c h / calc(alpha + 0.35))");

        return $"linear-gradient({90 + Angle}deg, currentColor {start}%, {beam} 50%, currentColor {end}%)";
    }
}
