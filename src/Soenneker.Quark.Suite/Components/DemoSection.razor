                            <Span ScreenReader="_renderCss45">@_copyButtonLabel</Span>
                            <Svg NativeWidth="16" NativeHeight="16" ViewBox="0 0 24 24" Fill="_renderCss29" Stroke='_renderCss30' StrokeWidth="_renderCss31" StrokeLineCap="_renderCss32" StrokeLineJoin="_renderCss33">
