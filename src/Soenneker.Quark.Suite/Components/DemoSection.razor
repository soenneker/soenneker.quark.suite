                    @if (ShouldShowCollapsedCodeOverlay)
                    {
                        <Div PointerEvents="_renderCss47"
                             Position="_renderCss34"
                             Inset="_renderCss48"
                             Display="_renderCss19"
                             ItemsAlign="_staticCss1"
                             Justify="_renderCss28"
                             Padding="_renderCss49">
                            <Div Position="_renderCss34"
                                 Inset="_renderCss48"
