                                    Variant="ButtonVariant.Outline"
                                    ButtonSize="_staticCss0"
                                    PointerEvents="_renderCss50"
                                    Position="_renderCss17"
                                    ZIndex="_renderCss37"
                                    Rounded="_renderCss40"
                                    BorderColor="_renderCss51"
                                    BackgroundColor="_renderCss52"
                                    TextColor="_renderCss53"
                                    Shadow="_renderCss54"
                                    OnClick="(_showCodeCallback ??= ShowCode)">
                                View Code
                            </Button>
