<Div Width="_renderCss0" Space="_renderCss1">
    <Div Space="_renderCss2">
        @if (Title != null)
        {
            <H2 Id="@ResolvedTitleId" TextSize="_renderCss3" FontWeight="_renderCss4" Tracking="_renderCss5" Margin="_renderCss6" ScrollMargin="@ResolvedTitleScrollMargin">
                @if (ShouldRenderTitleAnchor)
                {
                    <Anchor Href="@ResolvedTitleHref" Display="_renderCss7" ItemsAlign="_renderCss8" Gap="_renderCss9" TextColor='_renderCss10' DecorationLine="_renderCss11" OutlineStyle="_renderCss12" Class="group/title-anchor">
