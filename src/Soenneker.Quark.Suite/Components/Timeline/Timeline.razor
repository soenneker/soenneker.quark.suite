@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<CascadingValue Value="this" IsFixed="false">
    <div @attributes="BuildAttributes()">
        @if (ChildContent != null)
        {
            @ChildContent
        }
    </div>
</CascadingValue>

@code {
    private int _activeStep;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private string? _lastPrependedClass;

    [Parameter]
    public int DefaultValue { get; set; } = 1;

    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public string Orientation { get; set; } = "vertical";

    internal int ActiveStep => Value ?? _activeStep;

    protected override void OnInitialized()
    {
        _activeStep = DefaultValue;
        base.OnInitialized();
    }

    internal async Task SetActiveStep(int step)
    {
        if (ActiveStep == step)
            return;

        if (Value is null)
            _activeStep = step;

        await ValueChanged.InvokeAsync(step);
        Refresh();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "timeline";

        Display ??= _defaultDisplay;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["aria-label"] = AriaLabel ?? "Timeline";
        attributes["data-orientation"] = NormalizeOrientation();

        PrependClassAttribute(attributes, "group/timeline data-[orientation=horizontal]:w-full data-[orientation=horizontal]:flex-row data-[orientation=vertical]:flex-col", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(DefaultValue);
        hc.Add(Value);
        hc.Add(Orientation);
        hc.Add(_activeStep);
    }

    private string NormalizeOrientation()
    {
        return string.Equals(Orientation, "horizontal", StringComparison.OrdinalIgnoreCase)
            ? "horizontal"
            : "vertical";
    }
}
