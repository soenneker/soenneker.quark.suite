@namespace Soenneker.Quark
@using System
@using System.Collections.Generic
@using System.Globalization


@{
    double logMinimum = Math.Log10(Minimum);
    double logMaximum = Math.Log10(Maximum);
    double logRange = logMaximum - logMinimum;
    int lastExponent = (int)Math.Floor(logMaximum);

    string PositionOf(double value)
    {
        double fraction = logRange == 0 ? (value - Minimum) / (Maximum - Minimum)
            : (Math.Log10(value) - logMinimum) / logRange;
        return string.Create(CultureInfo.InvariantCulture, $"{100 * Math.Clamp(fraction, 0, 1):0.####}%");
    }
}

<figure class="m-0" aria-label="@Caption">
    <figcaption class="font-mono text-xs">@Caption</figcaption>
    <div class="flex flex-wrap justify-end gap-2">
        @for (int i = 0; i < Series.Count; i++)
        {
            var series = Series[i];
            if (series.Hidden) continue;
            <span class="inline-flex items-center gap-2 border border-current/20 px-2 py-1"><i class="size-3" style="background:@ColorFor(series)"></i>@series.Name</span>
        }
    </div>
    <div class="overflow-x-auto" tabindex="0" aria-label="@Caption">
        <div class="pt-16 pb-14 pl-20" style="min-width:@(Labels.Count * 12 + 5)rem">
            <div class="relative flex h-80 border-b border-current">
                @for (var exponent = (int)Math.Ceiling(logMinimum); exponent <= lastExponent; exponent++)
                {
                    var tick = Math.Pow(10, exponent);
                    <div class="absolute inset-x-0 border-t border-current/15" style="bottom:@PositionOf(tick)"><span class="absolute right-full -translate-y-1/2 pr-2 font-mono text-xs">@(TickFormatter?.Invoke(tick) ?? Format(tick))</span></div>
                }
                @for (var index = 0; index < Labels.Count; index++)
                {
                    <div class="relative flex min-w-0 flex-1 justify-center gap-1 px-2">
                        <strong class="absolute inset-x-0 bottom-[calc(100%+1.4rem)] text-center font-mono text-xs font-bold">@(index < Annotations.Count ? Annotations[index] : null)</strong>
                        @for (int i = 0; i < Series.Count; i++)
                        {
                            var series = Series[i];
                            if (series.Hidden) continue;
                            <div class="relative max-w-16 flex-1">
                                @if (index < series.Values.Count && series.Values[index] is double value && double.IsFinite(value) && value > 0)
                                {
                                    <div class="absolute bottom-0 w-full" style="height:@PositionOf(value);background:@ColorFor(series)" title="@($"{Labels[index]} · {series.Name}: {Format(value)}")"><b class="absolute bottom-full left-1/2 -translate-x-1/2 whitespace-nowrap pb-1 font-mono text-xs font-bold">@Format(value)</b></div>
                                }
                            </div>
                        }
                        <div class="absolute inset-x-0 top-full pt-2 text-center">@Labels[index]<small class="block font-mono text-xs">@(index < Descriptions.Count ? Descriptions[index] : null)</small></div>
                    </div>
                }
            </div>
        </div>
    </div>
</figure>

@code {
    [Parameter] public string Caption { get; set; } = "Logarithmic comparison";
    [Parameter] public IReadOnlyList<string> Labels { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Descriptions { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Annotations { get; set; } = [];
    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = [];
    [Parameter] public double Minimum { get; set; } = 0.001;
    [Parameter] public double Maximum { get; set; } = 10;
    [Parameter] public Func<double, string>? ValueFormatter { get; set; }

    [Parameter] public Func<double, string>? TickFormatter { get; set; }

    protected override void OnParametersSet()
    {
        if (!double.IsFinite(Minimum) || !double.IsFinite(Maximum) || Minimum <= 0 || Maximum <= Minimum)
            throw new ArgumentException("Logarithmic bounds must be finite, positive, and increasing.");
    }

    private string Format(double value) => ValueFormatter?.Invoke(value) ?? value.ToString("G4", CultureInfo.CurrentCulture);

    private static string ColorFor(ChartSeries series) => series.Color ?? "currentColor";
}
