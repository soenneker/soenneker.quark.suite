@namespace Soenneker.Quark
<text x="@ChartNumberFormatting.Format(X)" y="@ChartNumberFormatting.Format(Y)" text-anchor="@Anchor" dominant-baseline="middle" fill="currentColor" font-size="12">@Text</text>

@code {
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public string Anchor { get; set; } = "middle";
    [Parameter] public string? Text { get; set; }
}
