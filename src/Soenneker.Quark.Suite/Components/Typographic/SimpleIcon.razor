@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@using System.Globalization
@using System.Runtime.CompilerServices
@using Soenneker.Quark.Gen.SimpleIcons.Abstractions
@using Soenneker.Quark.Gen.SimpleIcons.Generated

@if (_svgWithAttributes is { } svgMarkup)
{
    @((MarkupString)svgMarkup)
}
@ChildContent

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineBlock;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is4;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<VerticalAlignBuilder> _defaultVerticalAlign = Quark.VerticalAlign.Middle;

    [Parameter]
    public SimpleIconEnum Name { get; set; }

    [Inject]
    private ISimpleIconsSvgProvider? SvgProvider { get; set; }

    private string? _svgWithAttributes;
    private IReadOnlyDictionary<string, object>? _svgAttributes;
    private SimpleIconEnum _svgName;
    private bool _svgResolved;

    private SimpleIconEnum _lastName;
    private string? _iconNameCache;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        DataSlot ??= "simple-icon";
        Display ??= _defaultDisplay;
        if (!HasExplicitSizeClass())
            Size ??= _defaultSize;
        Shrink ??= _defaultShrink;
        VerticalAlign ??= _defaultVerticalAlign;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var hasAccessibleName = HasNonEmptyAttribute(attributes, "aria-label") ||
                                HasNonEmptyAttribute(attributes, "aria-labelledby");

        attributes["focusable"] = "false";

        if (hasAccessibleName)
        {
            attributes.Remove("aria-hidden");
            attributes.TryAdd("role", "img");
        }
        else if (!attributes.ContainsKey("role"))
        {
            attributes.TryAdd("aria-hidden", "true");
        }
    }

    private static bool HasNonEmptyAttribute(IReadOnlyDictionary<string, object> attributes, string name) =>
        attributes.TryGetValue(name, out var value) && !string.IsNullOrWhiteSpace(value?.ToString());

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!EqualityComparer<SimpleIconEnum>.Default.Equals(_lastName, Name) || _iconNameCache is null)
        {
            _lastName = Name;
            _iconNameCache = Name.ToString();
        }

        var attributes = BuildAttributes();

        if (_svgResolved && EqualityComparer<SimpleIconEnum>.Default.Equals(_svgName, Name) && ReferenceEquals(_svgAttributes, attributes))
            return;

        _svgName = Name;
        _svgAttributes = attributes;
        _svgWithAttributes = GetSvgWithAttributes(attributes);
        _svgResolved = true;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Name);
    }

    private string? GetSvgWithAttributes(IReadOnlyDictionary<string, object> attributes)
    {
        var iconName = _iconNameCache;
        if (iconName is null)
            return null;

        var raw = GetSvg(iconName);

        if (raw.IsNullOrEmpty())
            return null;

        return SvgAttributeWriter.InjectAttributesIntoSvg(raw, attributes);
    }

    private string? GetSvg(string iconName)
    {
        var svg = SimpleIconSvgMap.GetSvg(iconName);

        if (svg.HasContent())
            return svg;

        return SvgProvider?.GetSvg(iconName);
    }

    private bool HasExplicitSizeClass()
    {
        if (ClassHasExplicitSize(Class))
            return true;

        if (Attributes is null)
            return false;

        if (Attributes is Dictionary<string, object> dictionary)
        {
            foreach (var attribute in dictionary)
                if (attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) && ClassHasExplicitSize(attribute.Value?.ToString()))
                    return true;
            return false;
        }

        if (Attributes is OrderedDictionary<string, object> ordered)
        {
            foreach (var attribute in ordered)
                if (attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) && ClassHasExplicitSize(attribute.Value?.ToString()))
                    return true;
            return false;
        }

        foreach (var attribute in Attributes)
        {
            if (attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) &&
                ClassHasExplicitSize(attribute.Value?.ToString()))
            {
                return true;
            }
        }

        return false;
    }

    private static bool ClassHasExplicitSize(string? className)
    {
        if (string.IsNullOrWhiteSpace(className))
            return false;

        var remaining = className.AsSpan();

        while (!remaining.IsEmpty)
        {
            remaining = remaining.TrimStart();

            var separator = remaining.IndexOfAny(" \t\r\n".AsSpan());
            var token = separator < 0 ? remaining : remaining[..separator];

            if (IsExplicitSizeToken(token))
                return true;

            if (separator < 0)
                break;

            remaining = remaining[(separator + 1)..];
        }

        return false;
    }

    private static bool IsExplicitSizeToken(ReadOnlySpan<char> token)
    {
        var separator = LastUnescapedColonIndex(token);
        var utility = separator >= 0 ? token[(separator + 1)..] : token;

        return utility.StartsWith("size-", StringComparison.Ordinal) ||
               utility.StartsWith("w-", StringComparison.Ordinal) ||
               utility.StartsWith("h-", StringComparison.Ordinal);
    }

    private static int LastUnescapedColonIndex(ReadOnlySpan<char> token)
    {
        for (var i = token.Length - 1; i >= 0; i--)
        {
            if (token[i] == ':' && (i == 0 || token[i - 1] != '\\'))
                return i;
        }

        return -1;
    }

}
