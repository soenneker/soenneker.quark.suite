@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@using System.Globalization
@using System.Runtime.CompilerServices
@using Soenneker.Quark.Gen.Lucide.Abstractions
@using Soenneker.Quark.Gen.Lucide.Generated

@if (_svgWithAttributes is { } svgMarkup)
{
    @((MarkupString)svgMarkup)
}
@ChildContent

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineBlock;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is4;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<VerticalAlignBuilder> _defaultVerticalAlign = Quark.VerticalAlign.Middle;

    [Parameter]
    public LucideIcon Name { get; set; }

    [Inject]
    private ILucideIconSvgProvider? SvgProvider { get; set; }

    private string? _svgWithAttributes;
    private IReadOnlyDictionary<string, object>? _svgAttributes;
    private LucideIcon _svgName;
    private bool _svgResolved;

    private LucideIcon _lastName;
    private string? _iconNameCache;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        DataSlot ??= "icon";
        Display ??= _defaultDisplay;
        Size ??= _defaultSize;
        Shrink ??= _defaultShrink;
        VerticalAlign ??= _defaultVerticalAlign;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var hasAccessibleName = HasNonEmptyAttribute(attributes, "aria-label") ||
                                HasNonEmptyAttribute(attributes, "aria-labelledby");

        attributes["focusable"] = "false";

        if (hasAccessibleName)
        {
            attributes.Remove("aria-hidden");
            attributes.TryAdd("role", "img");
        }
        else if (!attributes.ContainsKey("role"))
        {
            attributes.TryAdd("aria-hidden", "true");
        }
    }

    private static bool HasNonEmptyAttribute(IReadOnlyDictionary<string, object> attributes, string name) =>
        attributes.TryGetValue(name, out var value) && !string.IsNullOrWhiteSpace(value?.ToString());

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!EqualityComparer<LucideIcon>.Default.Equals(_lastName, Name) || _iconNameCache is null)
        {
            _lastName = Name;
            _iconNameCache = Name.ToString();
        }

        var attributes = BuildAttributes();

        if (_svgResolved && EqualityComparer<LucideIcon>.Default.Equals(_svgName, Name) && ReferenceEquals(_svgAttributes, attributes))
            return;

        _svgName = Name;
        _svgAttributes = attributes;
        _svgWithAttributes = GetSvgWithAttributes(attributes);
        _svgResolved = true;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Name);
    }

    private string? GetSvgWithAttributes(IReadOnlyDictionary<string, object> attributes)
    {
        var iconName = _iconNameCache;
        if (iconName is null)
            return null;

        var raw = GetSvg(iconName);

        if (raw.IsNullOrEmpty())
            return null;

        return SvgAttributeWriter.InjectAttributesIntoSvg(raw, attributes);
    }

    private string? GetSvg(string iconName)
    {
        var svg = LucideIconSvgMap.GetSvg(iconName);

        if (svg.HasContent())
            return svg;

        return SvgProvider?.GetSvg(iconName);
    }

}
