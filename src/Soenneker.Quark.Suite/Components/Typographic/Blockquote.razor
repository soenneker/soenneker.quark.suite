@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IBlockquote

<blockquote @attributes="BuildAttributes()">@ChildContent</blockquote>

@code {
    private static readonly CssValue<FontStyleBuilder> _defaultFontStyle = Quark.FontStyle.Italic;
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromTop.Is6;
    private string? _lastPrependedClass;

    /// <summary>
    /// Gets or sets the cite attribute for the blockquote.
    /// </summary>
    [Parameter]
    public string? Cite { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "blockquote";

        FontStyle ??= _defaultFontStyle;
        Margin ??= _defaultMargin;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Cite.HasContent())
            attributes["cite"] = Cite;

        PrependClassAttribute(attributes, "border-l-2 pl-6", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Cite);
    }
}