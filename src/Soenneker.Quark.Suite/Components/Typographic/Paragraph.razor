@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IParagraph

<p @attributes="BuildAttributes()">@ChildContent</p>

@code {
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Is7;
    private string? _lastPrependedClass;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "paragraph";

        Leading ??= _defaultLeading;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "[&:not(:first-child)]:mt-6", ref _lastPrependedClass);
    }
}