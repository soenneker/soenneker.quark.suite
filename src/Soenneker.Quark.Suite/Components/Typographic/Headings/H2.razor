@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IH2

<h2 @attributes="BuildAttributes()">@ChildContent</h2>

@code{
    private static readonly CssValue<TextSizeBuilder> _typography0 = Quark.TextSize.ThreeXl;
    private static readonly CssValue<FontWeightBuilder> _typography1 = Quark.FontWeight.Semibold;
    private static readonly CssValue<TrackingBuilder> _typography2 = Quark.Tracking.Tight;
    private static readonly CssValue<BorderBuilder> _typography3 = Quark.Border.FromBottom.Default;
    private static readonly CssValue<PaddingBuilder> _typography4 = Quark.Padding.FromBottom.Is2;
    private static readonly CssValue<TransitionBuilder> _typography5 = Quark.Transition.Token("transition-colors");
    private string? _lastPrependedClass;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "h2";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "first:mt-0", ref _lastPrependedClass);

        BuildTypographyDefaultAttributes(attributes, _typography0, _typography1, _typography2, "scroll-m-20", border: _typography3,
            padding: _typography4, transition: _typography5);
    }
}
