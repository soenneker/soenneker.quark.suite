@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IHeading

@{
    var level = GetHeadingLevel();
    var attrs = BuildAttributes();
}

@if (level == 1)
{
    <h1 @attributes="attrs">@ChildContent</h1>
}
else if (level == 2)
{
    <h2 @attributes="attrs">@ChildContent</h2>
}
else if (level == 3)
{
    <h3 @attributes="attrs">@ChildContent</h3>
}
else if (level == 4)
{
    <h4 @attributes="attrs">@ChildContent</h4>
}
else if (level == 5)
{
    <h5 @attributes="attrs">@ChildContent</h5>
}
else
{
    <h6 @attributes="attrs">@ChildContent</h6>
}

@code {
    private static readonly CssValue<TextSizeBuilder> _typography0 = Quark.TextSize.FourXl;
    private static readonly CssValue<FontWeightBuilder> _typography1 = Quark.FontWeight.Bold;
    private static readonly CssValue<TrackingBuilder> _typography2 = Quark.Tracking.Tight;
    private static readonly CssValue<TextSizeBuilder> _typography3 = Quark.TextSize.ThreeXl;
    private static readonly CssValue<TextSizeBuilder> _typography4 = Quark.TextSize.TwoXl;
    private static readonly CssValue<FontWeightBuilder> _typography5 = Quark.FontWeight.Semibold;
    private static readonly CssValue<TextSizeBuilder> _typography6 = Quark.TextSize.Xl;
    private static readonly CssValue<TextSizeBuilder> _typography7 = Quark.TextSize.Lg;
    private static readonly CssValue<FontWeightBuilder> _typography8 = Quark.FontWeight.Medium;
    private static readonly CssValue<TextSizeBuilder> _typography9 = Quark.TextSize.Base;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;



    /// <summary>
    /// Gets or sets the semantic HTML heading level independently of visual sizing.
    /// When omitted, the level continues to be inferred from the visual scale for compatibility.
    /// </summary>
    [Parameter]
    public HeadingLevel? Level { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "heading";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        {
            var cls = new PooledStringBuilder(stackalloc char[64]);
            var sty = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                BuildClassAndStyleAttributes(attributes, ref cls, ref sty, ref _lastBuiltClass, ref _lastBuiltStyle);
            }
            finally
            {
                cls.Dispose();
                sty.Dispose();
            }
        }

        var visualLevel = GetScaleLevel();

        switch (visualLevel)
        {
            case 1:
                BuildTypographyDefaultAttributes(attributes, _typography0, _typography1, _typography2);
                break;
            case 2:
                BuildTypographyDefaultAttributes(attributes, _typography3, _typography1, _typography2);
                break;
            case 3:
                BuildTypographyDefaultAttributes(attributes, _typography4, _typography5, _typography2);
                break;
            case 4:
                BuildTypographyDefaultAttributes(attributes, _typography6, _typography5);
                break;
            case 5:
                BuildTypographyDefaultAttributes(attributes, _typography7, _typography8);
                break;
            default:
                BuildTypographyDefaultAttributes(attributes, _typography9, _typography8);
                break;
        }
    }



    private int GetHeadingLevel()
    {
        if (Level.HasValue)
            return (int) Level.Value;

        return GetScaleLevel();
    }

    private int GetScaleLevel()
    {
        const int fallback = 3;
        var s = Scale?.ToString();

        if (s.IsNullOrWhiteSpace())
            return fallback;

        if (s.Length >= 7 && s.AsSpan().StartsWith("scale-"))
        {
            var d = s[^1] - '0';

            if ((uint)(d - 1) <= 5)
                return d; // 1..6
        }

        return fallback;
    }
    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Level);
    }
}
