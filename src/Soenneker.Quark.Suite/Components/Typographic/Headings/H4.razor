@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IH4

<h4 @attributes="BuildAttributes()">@ChildContent</h4>

@code{
    private static readonly CssValue<TextSizeBuilder> _typography0 = Quark.TextSize.Xl;
    private static readonly CssValue<FontWeightBuilder> _typography1 = Quark.FontWeight.Semibold;
    private static readonly CssValue<TrackingBuilder> _typography2 = Quark.Tracking.Tight;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "h4";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        BuildTypographyDefaultAttributes(attributes, _typography0, _typography1, _typography2, "scroll-m-20");
    }
}
