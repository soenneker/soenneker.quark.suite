@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<Span Attributes="@BuildAttributes()">
    @if (Pulse)
    {
        <Span DataSlot="pill-indicator-pulse"
              Position="_renderCss0"
              Inset="_renderCss1"
              Rounded="_renderCss2"
              BackgroundColor="@GetBackgroundColor()"
              Animation="_renderCss3"
              Opacity="_renderCss4"></Span>
    }
</Span>

@code {
    private static readonly CssValue<BackgroundColorBuilder> _variantColor0 = Quark.BackgroundColor.Utility("bg-red-500");
    private static readonly CssValue<BackgroundColorBuilder> _variantColor1 = Quark.BackgroundColor.Utility("bg-amber-500");
    private static readonly CssValue<BackgroundColorBuilder> _variantColor2 = Quark.BackgroundColor.Utility("bg-blue-500");
    private static readonly CssValue<BackgroundColorBuilder> _variantColor3 = Quark.BackgroundColor.Utility("bg-muted-foreground");
    private static readonly CssValue<BackgroundColorBuilder> _variantColor4 = Quark.BackgroundColor.Utility("bg-green-500");
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is2;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _renderCss1 = Quark.Inset.Is0;
    private static readonly CssValue<RoundedBuilder> _renderCss2 = Quark.Rounded.Full;
    private static readonly CssValue<AnimationBuilder> _renderCss3 = Quark.Animation.Ping;
    private static readonly CssValue<OpacityBuilder> _renderCss4 = Quark.Opacity.Is75;
    [Parameter]
    public PillIndicatorVariant Variant { get; set; } = PillIndicatorVariant.Success;

    [Parameter]
    public bool Pulse { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "pill-indicator";
        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        Size ??= _defaultSize;
        Shrink ??= _defaultShrink;
        Rounded ??= _renderCss2;
        BackgroundColor ??= GetBackgroundColor();
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-variant"] = GetVariantValue();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Variant);
        hc.Add(Pulse);
    }

    private string GetVariantValue()
    {
        if (ReferenceEquals(Variant, PillIndicatorVariant.Error))
            return "error";
        if (ReferenceEquals(Variant, PillIndicatorVariant.Warning))
            return "warning";
        if (ReferenceEquals(Variant, PillIndicatorVariant.Info))
            return "info";
        if (ReferenceEquals(Variant, PillIndicatorVariant.Neutral))
            return "neutral";

        return "success";
    }

    private CssValue<BackgroundColorBuilder> GetBackgroundColor()
    {
        if (ReferenceEquals(Variant, PillIndicatorVariant.Error))
            return _variantColor0;
        if (ReferenceEquals(Variant, PillIndicatorVariant.Warning))
            return _variantColor1;
        if (ReferenceEquals(Variant, PillIndicatorVariant.Info))
            return _variantColor2;
        if (ReferenceEquals(Variant, PillIndicatorVariant.Neutral))
            return _variantColor3;

        return _variantColor4;
    }
}
