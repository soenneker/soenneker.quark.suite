@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IPreCode

<pre @attributes="BuildPreAttributes()">
    <code @attributes="BuildCodeAttributes()">
        @ChildContent
    </code>
</pre>

@code {
    private string? _scrollClass;
    private string? _heightStyle;
    private QuarkAttributeDictionary _preAttributesBuffer;
    private QuarkAttributeDictionary _codeAttributesBuffer;
    [Parameter]
    public string? Language { get; set; }

    [Parameter]
    public bool Highlight { get; set; } = true;

    [Parameter]
    public string? Theme { get; set; } = "default";

    [Parameter]
    public bool Scrollable { get; set; } = true;

    protected virtual Dictionary<string, object> BuildPreAttributes()
    {
        var attributes = _preAttributesBuffer.Create(BuildAttributes(), 1);
        attributes["data-slot"] = "pre-code";
        if (Scrollable)
        attributes.TryAdd("tabindex", QuarkAttributeValues.Zero);

        if (!Class.HasContent())
        {
            var baseClasses = Scrollable ? "p-3 rounded overflow-auto" : "p-3 rounded";

            if (MaxHeight.HasValue)
            {
                attributes["style"] = QuarkStringCache.Concat("max-height: ", MaxHeight.Value.ToString(), "px;", ref _heightStyle);
            }

            attributes["class"] = baseClasses;
        }
        else
        {
            var currentClass = attributes.TryGetValue("class", out var classValue) ? classValue?.ToString() ?? Class : Class;

            if (Scrollable && !currentClass.Contains("overflow-auto"))
            {
                currentClass = AppendToClass(currentClass, "overflow-auto", ref _scrollClass);
            }

            attributes["class"] = currentClass;
        }

        return attributes;
    }

    protected virtual Dictionary<string, object> BuildCodeAttributes()
    {
        var attributes = _codeAttributesBuffer.Create(4);

        if (Language.HasContent())
            attributes["Language"] = Language;

        if (Theme.HasContent() && Theme != "default")
            attributes["Theme"] = Theme;

        if (Highlight)
            attributes["Highlight"] = QuarkAttributeValues.True;

        attributes["Inline"] = QuarkAttributeValues.False;

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Language);
        hc.Add(Highlight);
        hc.Add(Theme);
        hc.Add(Scrollable);
    }
}
