@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IPreCode

<pre @attributes="BuildPreAttributes()">
    <code @attributes="BuildCodeAttributes()">
        @ChildContent
    </code>
</pre>

@code {
    private QuarkAttributeDictionary _preAttributesBuffer;
    private QuarkAttributeDictionary _codeAttributesBuffer;
    [Parameter]
    public string? Language { get; set; }

    [Parameter]
    public bool Highlight { get; set; } = true;

    [Parameter]
    public string? Theme { get; set; } = "default";

    [Parameter]
    public bool Scrollable { get; set; } = true;

    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        var preset = AppliedPresetContext;
        if (ResolvePresetValue(Padding, preset?.Padding, nameof(Padding)) is null)
            AppendClass(ref cls, "p-3");
        if (ResolvePresetValue(Rounded, preset?.Rounded, nameof(Rounded)) is null)
            AppendClass(ref cls, "rounded");
        if (Scrollable && ResolvePresetValue(Overflow, preset?.Overflow, nameof(Overflow)) is null)
            AppendClass(ref cls, "overflow-auto");
    }

    protected virtual Dictionary<string, object> BuildPreAttributes()
    {
        var attributes = _preAttributesBuffer.Create(BuildAttributes(), 1);
        attributes["data-slot"] = "pre-code";
        if (Scrollable)
            attributes.TryAdd("tabindex", QuarkAttributeValues.Zero);

        return attributes;
    }

    protected virtual Dictionary<string, object> BuildCodeAttributes()
    {
        var attributes = _codeAttributesBuffer.Create(3);

        if (Language.HasContent())
            attributes["data-language"] = Language;

        if (Theme.HasContent() && Theme != "default")
            attributes["data-theme"] = Theme;

        if (Highlight)
            attributes["data-highlight"] = "true";

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Language);
        hc.Add(Highlight);
        hc.Add(Theme);
        hc.Add(Scrollable);
    }
}
