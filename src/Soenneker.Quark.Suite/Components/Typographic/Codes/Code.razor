@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements ICode

<code @attributes="BuildAttributes()">@ChildContent</code>

@code {
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Muted;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Default;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Token("[0.3rem]").OnY.Token("[0.2rem]");
    private static readonly CssValue<FontFamilyBuilder> _defaultFontFamily = Quark.FontFamily.Mono;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Semibold;
    /// <summary>
    /// Gets or sets the programming language for syntax highlighting.
    /// </summary>
    [Parameter]
    public string? Language { get; set; }

    /// <summary>
    /// Gets or sets whether the code should be displayed inline.
    /// </summary>
    [Parameter]
    public bool Inline { get; set; } = true;

    /// <summary>
    /// Gets or sets whether syntax highlighting should be applied.
    /// </summary>
    [Parameter]
    public bool Highlight { get; set; } = true;

    /// <summary>
    /// Gets or sets the syntax highlighting theme.
    /// </summary>
    [Parameter]
    public string? Theme { get; set; } = "default";

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "code";

        if (!Inline)
            return;

        BackgroundColor ??= _defaultBackgroundColor;
        Rounded ??= _defaultRounded;
        Position ??= _defaultPosition;
        Padding ??= _defaultPadding;
        FontFamily ??= _defaultFontFamily;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Language.HasContent())
            attributes["data-language"] = Language;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Language);
        hc.Add(Inline);
        hc.Add(Highlight);
        hc.Add(Theme);
    }
}
