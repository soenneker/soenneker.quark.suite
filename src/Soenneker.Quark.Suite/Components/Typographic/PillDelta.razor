@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<Span Attributes="@BuildAttributes()">
    <Icon Name="@IconName" Size="_renderCss0" aria-hidden="true" />
    @ChildContent
</Span>

@code {
    private static readonly CssValue<TextColorBuilder> _variantColor0 = Quark.TextColor.Utility("text-red-600").OnDark.Utility("text-red-400");
    private static readonly CssValue<TextColorBuilder> _variantColor1 = Quark.TextColor.Utility("text-green-600").OnDark.Utility("text-green-400");
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Quark.Items.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is0_5;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Semibold;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is3;
    [Parameter]
    public PillDeltaDirection Direction { get; set; } = PillDeltaDirection.Up;

    private LucideIcon IconName => Direction == PillDeltaDirection.Down ? LucideIcon.ArrowDown : LucideIcon.ArrowUp;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "pill-delta";
        Display ??= _defaultDisplay;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _defaultItemsAlign;
        Gap ??= _defaultGap;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= GetTextColor();
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-direction"] = Direction == PillDeltaDirection.Down ? "down" : "up";

    }

    private CssValue<TextColorBuilder> GetTextColor()
    {
        return Direction == PillDeltaDirection.Down
            ? _variantColor0
            : _variantColor1;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Direction);
    }
}
