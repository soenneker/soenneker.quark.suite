@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements ISpan

<span @ref="ElementRef"
      @onpointerdown:preventDefault="PreventPointerDownDefault"
      @attributes="BuildAttributes()">
    <CascadingValue Name="TriggerContext" Value="@NoChildTriggerContext" IsFixed="true">
        @ChildContent
    </CascadingValue>
</span>

@code {
    private object? _cachedHandleClickMouseEventArgsCallback;

    private TriggerEventReceiver? _triggerEvents;
    private TriggerEventReceiver TriggerEvents => _triggerEvents ??= new(this);

    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? TriggerContext { get; set; }

    [CascadingParameter(Name = SlotAttributes.Name)]
    private IReadOnlyDictionary<string, object>? SlotAttributeOverrides { get; set; }

    private string? _slotClass;
    private string? _slotStyle;
    private bool TriggerDisabled => TriggerContext?.ParentDisabled == true;

    private ValueAtomicBool _triggerElementRegistered;
    private ValueAtomicBool _ignoreNextPointerClick;
    private string? _registeredTriggerId;
    private static readonly TriggerContext? NoChildTriggerContext = null;

    private bool PreventPointerDownDefault => TriggerContext?.PreventPointerDownDefault == true;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        if (TriggerContext?.DataSlot is not null)
            DataSlot ??= TriggerContext.DataSlot;
        else
            DataSlot ??= "span";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        SlotAttributes.MergeInto(attributes, SlotAttributeOverrides, ref _slotClass, ref _slotStyle);

        if (TriggerDisabled)
        {
            attributes["aria-disabled"] = "true";
            attributes["data-disabled"] = "true";
        }

        if (TriggerContext?.TriggerId is not null)
            attributes["id"] = TriggerContext.TriggerId;

        if (TriggerContext?.DataState is not null)
            attributes["data-state"] = TriggerContext.DataState;

        if (TriggerContext?.AriaHasPopup is not null)
            attributes["aria-haspopup"] = TriggerContext.AriaHasPopup;

        if (TriggerContext?.AriaControls is not null)
        {
            attributes["aria-expanded"] = TriggerContext.IsOpen ? "true" : "false";
            attributes["aria-controls"] = TriggerContext.AriaControls;
        }

        if (TriggerContext?.AriaDescribedBy is not null && !attributes.ContainsKey("aria-describedby"))
            attributes["aria-describedby"] = TriggerContext.AriaDescribedBy;

        if (OnClick.HasDelegate || TriggerContext?.OnClick is not null || TriggerContext?.Toggle is not null)
            attributes["onclick"] = (_cachedHandleClickMouseEventArgsCallback ??= EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick));

        if (TriggerContext?.OnMouseEnter is not null)
            attributes.TryAdd("onmouseenter", TriggerEvents.MouseEnterCallback);

        if (TriggerContext?.OnMouseMove is not null)
            attributes["onmousemove"] = TriggerEvents.MouseMoveCallback;

        if (TriggerContext?.OnMouseLeave is not null)
            attributes.TryAdd("onmouseleave", TriggerEvents.MouseLeaveCallback);

        if (TriggerContext?.OnPointerDown is not null || TriggerContext?.OnPointerDownEvent is not null)
            attributes.TryAdd("onpointerdown", TriggerEvents.PointerDownCallback);

        if (TriggerContext?.OnFocusIn is not null)
            attributes.TryAdd("onfocusin", TriggerEvents.FocusInCallback);

        if (TriggerContext?.OnFocusOut is not null)
            attributes.TryAdd("onfocusout", TriggerEvents.FocusOutCallback);

        if (TriggerContext?.OnKeyDown is not null)
            attributes.TryAdd("onkeydown", TriggerEvents.KeyDownCallback);

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (TriggerContext?.RegisterElement is not null && (!_triggerElementRegistered.Value || !string.Equals(_registeredTriggerId, TriggerContext.TriggerId, StringComparison.Ordinal)))
        {
            TriggerContext.RegisterElement(ElementRef);
            _triggerElementRegistered.Value = true;
            _registeredTriggerId = TriggerContext.TriggerId;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(TriggerContext?.DataSlot);
        hc.Add(TriggerContext?.TriggerId);
        hc.Add(TriggerContext?.DataState);
        hc.Add(TriggerContext?.AriaHasPopup);
        hc.Add(TriggerContext?.AriaControls);
        hc.Add(TriggerContext?.AriaDescribedBy);
        hc.Add(TriggerContext?.IsOpen);
        hc.Add(TriggerContext?.SuppressClickAfterPointerDown == true);
        hc.Add(TriggerContext?.OnMouseMove is not null);
        hc.Add(TriggerContext?.ParentDisabled);
        hc.Add(TriggerContext?.PreventPointerDownDefault);
        hc.Add(TriggerContext?.OnClick is not null);
        hc.Add(TriggerContext?.Toggle is not null);
        hc.Add(TriggerContext?.OnMouseEnter is not null);
        hc.Add(TriggerContext?.OnMouseLeave is not null);
        hc.Add(TriggerContext?.OnPointerDown is not null);
        hc.Add(TriggerContext?.OnPointerDownEvent is not null);
        hc.Add(TriggerContext?.OnFocusIn is not null);
        hc.Add(TriggerContext?.OnFocusOut is not null);
        hc.Add(TriggerContext?.OnKeyDown is not null);
        hc.Add(OnClick.HasDelegate);
    }

    private Task HandleMouseEnter(MouseEventArgs e) => TriggerDisabled ? Task.CompletedTask : TriggerContext?.OnMouseEnter?.Invoke() ?? Task.CompletedTask;
    private Task HandleMouseMove(MouseEventArgs e) => TriggerDisabled ? Task.CompletedTask : TriggerContext?.OnMouseMove?.Invoke() ?? Task.CompletedTask;
    private Task HandleMouseLeave(MouseEventArgs e) => TriggerDisabled ? Task.CompletedTask : TriggerContext?.OnMouseLeave?.Invoke() ?? Task.CompletedTask;
    private Task HandlePointerDown(PointerEventArgs e)
    {
        if (TriggerDisabled)
            return Task.CompletedTask;
        if (TriggerContext?.OnPointerDownEvent is not null)
        {
            if (TriggerContext.SuppressClickAfterPointerDown && e.Button == 0 && !e.CtrlKey)
                _ignoreNextPointerClick.Value = true;

            return TriggerContext.OnPointerDownEvent(e);
        }

        if (TriggerContext?.OnPointerDown is not null)
        {
            if (TriggerContext.SuppressClickAfterPointerDown && e.Button == 0 && !e.CtrlKey)
                _ignoreNextPointerClick.Value = true;

            return TriggerContext.OnPointerDown();
        }

        return Task.CompletedTask;
    }

    private Task HandleFocusIn(FocusEventArgs e) => TriggerDisabled ? Task.CompletedTask : TriggerContext?.OnFocusIn?.Invoke() ?? Task.CompletedTask;
    private Task HandleFocusOut(FocusEventArgs e) => TriggerDisabled ? Task.CompletedTask : TriggerContext?.OnFocusOut?.Invoke() ?? Task.CompletedTask;
    private Task HandleKeyDown(KeyboardEventArgs e) => TriggerDisabled ? Task.CompletedTask : TriggerContext?.OnKeyDown?.Invoke(e) ?? Task.CompletedTask;

    private async Task HandleClick(MouseEventArgs e)
    {
        if (TriggerDisabled)
            return;

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);

        if (SlotAttributeOverrides?.TryGetValue("onclick", out var callback) == true)
        {
            switch (callback)
            {
                case EventCallback<MouseEventArgs> typed: await typed.InvokeAsync(e); break;
                case EventCallback untyped: await untyped.InvokeAsync(e); break;
                case Func<MouseEventArgs, Task> action: await action(e); break;
                case Func<Task> action: await action(); break;
                case Action<MouseEventArgs> action: action(e); break;
                case Action action: action(); break;
            }
        }

        var ignoreTriggerClick = false;

        if (_ignoreNextPointerClick.Exchange(false))
        {
            ignoreTriggerClick = true;
        }

        if (!ignoreTriggerClick)
        {
            if (TriggerContext?.OnClick is not null)
                await TriggerContext.OnClick();

            if (TriggerContext?.Toggle is not null)
                await TriggerContext.Toggle();
        }
    }
}
