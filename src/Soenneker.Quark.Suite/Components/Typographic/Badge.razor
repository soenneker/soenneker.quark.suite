@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements IBadge

@if (AsChild)
{
    <CascadingValue Name="@SlotAttributes.Name" Value="BuildAttributes()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <span @attributes="BuildAttributes()">@ChildContent</span>
}

@code {
    private const string _shadcnBadgeBase =
        "group/badge inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-all focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3!";

    [Parameter]
    public BadgeVariant Variant { get; set; } = BadgeVariant.Default;

    [Parameter]
    public SemanticTone? Tone { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-variant"] = GetDataVariant(Variant);
        if (Tone is not null)
            attributes["data-tone"] = Tone.Value switch
            {
                SemanticTone.SuccessValue => "success",
                SemanticTone.InfoValue => "info",
                SemanticTone.WarningValue => "warning",
                SemanticTone.DangerValue => "danger",
                SemanticTone.MutedValue => "muted",
                _ => "neutral"
            };

        var preset = AppliedPresetContext;
        var hasBackgroundColor = BackgroundColor is not null || preset?.BackgroundColor is not null;
        var hasTextColor = TextColor is not null || preset?.TextColor is not null;
        var hasBorderColor = BorderColor is not null || preset?.BorderColor is not null;

        BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, _shadcnBadgeBase);
            if (Tone is null)
                AppendBadgeVariantClasses(ref cls, Variant, hasBackgroundColor, hasTextColor, hasBorderColor);
            else
                AppendToneClasses(ref cls, Tone, hasBackgroundColor, hasTextColor, hasBorderColor);
        });
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "badge";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Variant);
        hc.Add(Tone);
        hc.Add(AsChild);
    }

    private static void AppendToneClasses(ref PooledStringBuilder classes, SemanticTone tone,
        bool hasBackgroundColor, bool hasTextColor, bool hasBorderColor)
    {
        string background;
        string foreground;
        if (tone == SemanticTone.Success)
        {
            background = "bg-emerald-500/10";
            foreground = "text-emerald-700 dark:text-emerald-400";
        }
        else if (tone == SemanticTone.Info)
        {
            background = "bg-sky-500/10";
            foreground = "text-sky-700 dark:text-sky-400";
        }
        else if (tone == SemanticTone.Warning)
        {
            background = "bg-amber-500/10";
            foreground = "text-amber-800 dark:text-amber-400";
        }
        else if (tone == SemanticTone.Danger)
        {
            background = "bg-destructive/10";
            foreground = "text-destructive";
        }
        else
        {
            background = "bg-muted";
            foreground = tone == SemanticTone.Muted ? "text-muted-foreground" : "text-foreground";
        }
        AppendVariantClasses(ref classes, "border-transparent", background, foreground, null,
            hasBackgroundColor, hasTextColor, hasBorderColor);
    }

    private static string GetDataVariant(BadgeVariant? variant)
    {
        if (ReferenceEquals(variant, BadgeVariant.Secondary))
            return "secondary";

        if (ReferenceEquals(variant, BadgeVariant.Destructive))
            return "destructive";

        if (ReferenceEquals(variant, BadgeVariant.Outline))
            return "outline";

        if (ReferenceEquals(variant, BadgeVariant.Ghost))
            return "ghost";

        if (ReferenceEquals(variant, BadgeVariant.Link))
            return "link";

        return "default";
    }

    private static void AppendBadgeVariantClasses(ref PooledStringBuilder classes, BadgeVariant? variant, bool hasBackgroundColor, bool hasTextColor,
        bool hasBorderColor)
    {
        if (ReferenceEquals(variant, BadgeVariant.Secondary))
        {
            AppendVariantClasses(ref classes, "border-transparent", "bg-secondary [a]:hover:bg-secondary/80", "text-secondary-foreground", null,
                hasBackgroundColor, hasTextColor, hasBorderColor);
            return;
        }

        if (ReferenceEquals(variant, BadgeVariant.Destructive))
        {
            AppendVariantClasses(ref classes, "border-transparent", "bg-destructive/10 dark:bg-destructive/20 [a]:hover:bg-destructive/20", "text-destructive",
                "focus-visible:ring-destructive/20 dark:focus-visible:ring-destructive/40", hasBackgroundColor, hasTextColor, hasBorderColor);
            return;
        }

        if (ReferenceEquals(variant, BadgeVariant.Outline))
        {
            AppendVariantClasses(ref classes, "border-border", "[a]:hover:bg-muted", "text-foreground [a]:hover:text-muted-foreground", null,
                hasBackgroundColor, hasTextColor, hasBorderColor);
            return;
        }

        if (ReferenceEquals(variant, BadgeVariant.Ghost))
        {
            AppendVariantClasses(ref classes, "border-transparent", "hover:bg-muted dark:hover:bg-muted/50", "hover:text-muted-foreground", null,
                hasBackgroundColor, hasTextColor, hasBorderColor);
            return;
        }

        if (ReferenceEquals(variant, BadgeVariant.Link))
        {
            AppendVariantClasses(ref classes, "border-transparent", null, "text-primary", "underline-offset-4 [a]:hover:underline", hasBackgroundColor,
                hasTextColor, hasBorderColor);
            return;
        }

        AppendVariantClasses(ref classes, "border-transparent", "bg-primary [a]:hover:bg-primary/80", "text-primary-foreground", null, hasBackgroundColor,
            hasTextColor, hasBorderColor);
    }

    private static void AppendVariantClasses(ref PooledStringBuilder classes, string? borderClasses, string? backgroundClasses, string? textClasses,
        string? otherClasses,
        bool hasBackgroundColor, bool hasTextColor, bool hasBorderColor)
    {
        if (!hasBorderColor && borderClasses is not null)
            AppendClass(ref classes, borderClasses);

        if (!hasBackgroundColor && backgroundClasses is not null)
            AppendClass(ref classes, backgroundClasses);

        if (!hasTextColor && textClasses is not null)
            AppendClass(ref classes, textClasses);

        if (otherClasses is not null)
            AppendClass(ref classes, otherClasses);
    }
}
