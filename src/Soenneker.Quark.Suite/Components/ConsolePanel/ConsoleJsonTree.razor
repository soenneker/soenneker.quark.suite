@inject Soenneker.Blazor.Utils.ResourceLoader.Abstract.IResourceLoader ResourceLoader
@inject QuarkOptions QuarkOptions
@namespace Soenneker.Quark
@using System.Text.Json
@implements IDisposable

<div class="json-tree @(WrapLines ? "json-wrap" : null)">
    @_root
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
            await ResourceLoader.LoadStyle(QuarkAssetPath.Css("_content/Soenneker.Quark.Suite/css/consolejsontree.css", QuarkOptions));
    }

    [Parameter] public string Json { get; set; } = "{}";
    [Parameter] public bool WrapLines { get; set; } = true;
    [Parameter] public RenderFragment? Tools { get; set; }
    private string? _previousJson;
    private RenderFragment? _root;

    protected override void OnParametersSet()
    {
        if (_previousJson == Json) return;
        using var document = JsonDocument.Parse(Json);
        _root = CreateNode(document.RootElement, null, false, true);
        _previousJson = Json;
    }

    private RenderFragment CreateNode(JsonElement value, string? name, bool comma, bool root = false)
    {
        var kind = value.ValueKind;
        string? key = name is null ? null : Quote(name);
        string? toggleLabel = null;
        RenderFragment[] children = [];
        string? rawText = null;
        if (kind is JsonValueKind.Object or JsonValueKind.Array)
        {
            toggleLabel = name is null ? "Toggle JSON" : $"Toggle {name}";
            int count = kind == JsonValueKind.Object ? CountProperties(value) : value.GetArrayLength();
            children = new RenderFragment[count];
            int index = 0;
            if (kind == JsonValueKind.Object)
            {
                foreach (JsonProperty property in value.EnumerateObject())
                    children[index] = CreateNode(property.Value, property.Name, ++index < count);
            }
            else
            {
                foreach (JsonElement item in value.EnumerateArray())
                    children[index] = CreateNode(item, null, ++index < count);
            }
        }
        else
            rawText = value.GetRawText();

        string? countLabel = kind is JsonValueKind.Object or JsonValueKind.Array ?
            (children.Length == 1 ? "1 item" : $"{children.Length} items") : null;
        return RenderNode(kind, key, toggleLabel, rawText, children, countLabel, comma, root);
    }

    private RenderFragment RenderNode(JsonValueKind kind, string? key, string? toggleLabel, string? rawText,
        RenderFragment[] children, string? countLabel, bool comma, bool root) => @<text>
        @if (kind is JsonValueKind.Object or JsonValueKind.Array)
        {
            string opening = kind == JsonValueKind.Object ? "{" : "[";
            string closing = kind == JsonValueKind.Object ? "}" : "]";
            <details class="json-node @(root && Tools is not null ? "json-with-tools" : null)" open="@(!root)">
                <summary aria-label="@toggleLabel"><span class="json-caret" aria-hidden="true"></span>@if (key is not null) {<span class="json-key">@key: </span>}<span>@opening</span><span class="json-collapsed"> &hellip; <span class="json-count">@countLabel</span> @closing@(comma ? "," : "")</span></summary>
                @if (root && Tools is not null)
                {
                    <div class="json-tools">@Tools</div>
                }
                <div class="json-children">
                    @foreach (var child in children)
                    {
                        @child
                    }
                </div>
                <div class="json-closing">@closing@(comma ? "," : "")</div>
            </details>
        }
        else
        {
            <div class="json-leaf">@if (key is not null) {<span class="json-key">@key: </span>}<span class="@ValueClass(kind)">@rawText</span>@(comma ? "," : "")</div>
        }
    </text>;

    private static string Quote(string value) => "\"" + JsonEncodedText.Encode(value).ToString() + "\"";
    private static int CountProperties(JsonElement value)
    {
        var count = 0;
        foreach (JsonProperty _ in value.EnumerateObject()) count++;
        return count;
    }

    private static string ValueClass(JsonValueKind kind) => kind switch
    {
        JsonValueKind.String => "json-string",
        JsonValueKind.Number => "json-number",
        JsonValueKind.True => "json-true",
        JsonValueKind.False => "json-false",
        JsonValueKind.Null => "json-null",
        _ => "json-undefined"
    };
    public void Dispose() => _root = null;
}
