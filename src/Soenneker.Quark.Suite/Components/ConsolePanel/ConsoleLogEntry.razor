@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IConsoleLogEntry

<div @attributes="BuildAttributes()">
    @if ((FormatExceptions ?? PanelFormatExceptions) && _traceStart >= 0)
    {
        <div class="console-exception">
            @(_summaryMessage ??= RenderMessage(_displaySummary))
            <details class="@(ResolvedShowWrapToggle ? "console-has-wrap" : null)">
                <summary><span class="console-show">Show stack trace</span><span class="console-hide">Hide stack trace</span></summary>
                @RenderWrapToggle()
                <div class="console-trace @(_wrap ? "console-wrap" : null)">
                    @foreach (var frame in _trace)
                    {
                        <div class="console-frame">
                            @if (frame.Method is not null)
                            {
                                <span class="console-secondary">@frame.Prefix</span><span>@frame.Method</span><span class="console-secondary">@frame.Arguments</span>
                                @if (frame.File is not null)
                                {
                                    <div class="console-location"><span class="console-secondary">@frame.Directory</span><span>@frame.File</span></div>
                                }
                            }
                            else
                            {
                                @frame.Prefix
                            }
                        </div>
                    }
                </div>
            </details>
        </div>
    }
    else
    {
        @(_textMessage ??= RenderMessage(_displayText))
    }
</div>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public bool? FormatExceptions { get; set; }
    [CascadingParameter(Name = "ConsoleFormatExceptions")] public bool PanelFormatExceptions { get; set; }

    [Parameter] public bool? FormatJson { get; set; }
    [CascadingParameter(Name = "ConsoleFormatJson")] public bool PanelFormatJson { get; set; }

    [Parameter] public bool? WrapLines { get; set; }
    [Parameter] public bool? ShowWrapToggle { get; set; }
    [CascadingParameter(Name = "ConsoleWrapLines")] public bool PanelWrapLines { get; set; } = true;
    [CascadingParameter(Name = "ConsoleShowWrapToggle")] public bool PanelShowWrapToggle { get; set; } = true;

    private bool ResolvedShowWrapToggle => ShowWrapToggle ?? PanelShowWrapToggle;
    private bool? _previousWrapLines;
    private bool? _previousShowWrapToggle;
    private ConsoleJsonContent _displayText = new("", []);
    private ConsoleJsonContent _displaySummary = new("", []);
    private bool _previousFormatJson;
    private string? _previousText;
    private string _summary = "";
    private ConsoleStackFrame[] _trace = [];
    private int _traceStart = -1;
    private bool _wrap = true;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        bool wrapLines = WrapLines ?? PanelWrapLines;
        if (_previousWrapLines != wrapLines || _previousShowWrapToggle != ResolvedShowWrapToggle)
            _wrap = wrapLines;
        _previousWrapLines = wrapLines;
        _previousShowWrapToggle = ResolvedShowWrapToggle;
        bool formatJson = FormatJson ?? PanelFormatJson;
        if (_previousText == Text && _previousFormatJson == formatJson) return;
        _textMessage = _summaryMessage = null;
        _previousFormatJson = formatJson;
        _displayText = formatJson ? ConsoleJsonFormatter.Format(Text) : new ConsoleJsonContent(Text, []);
        _previousText = Text;
        _traceStart = -1;
        _trace = [];
        if (!Text.Contains("Exception", StringComparison.Ordinal) || Text.IndexOf('\n') < 0) return;
        string[] lines = Text.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        // Require both an exception heading and a stack frame; ordinary multiline logs remain plain text.
        var hasException = false;
        for (var i = 1; i < lines.Length; i++)
        {
            hasException |= lines[i - 1].Contains("Exception", StringComparison.Ordinal);
            if (!hasException || !lines[i].AsSpan().TrimStart().StartsWith("at ", StringComparison.Ordinal)) continue;
            _traceStart = i;
            _summary = string.Join("\n", lines, 0, i);
            _displaySummary = formatJson ? ConsoleJsonFormatter.Format(_summary) : new ConsoleJsonContent(_summary, []);
            _trace = new ConsoleStackFrame[lines.Length - i];
            for (int j = i; j < lines.Length; j++)
                _trace[j - i] = ConsoleStackFrame.Parse(lines[j]);
            break;
        }
    }

    private RenderFragment? _textMessage;
    private RenderFragment? _summaryMessage;
    private RenderFragment? _wrapToggle;

    private RenderFragment RenderWrapToggle() => _wrapToggle ??= @<text>
        @if (ResolvedShowWrapToggle)
        {
            <div class="console-tools"><Check @bind-Checked="_wrap">Wrap lines</Check></div>
        }
    </text>;

    private RenderFragment RenderMessage(ConsoleJsonContent content) => @<div class="@(content.Payloads.Count > 0 ? "console-json" : null)">
        <div class="console-message">@content.Summary</div>
        @for (var i = 0; i < content.Payloads.Count; i++)
        {
            <div class="console-json-payload @(_wrap ? "console-wrap" : null)">
                <ConsoleJsonTree Json="@content.Payloads[i]" WrapLines="@_wrap" Tools="@(ResolvedShowWrapToggle ? RenderWrapToggle() : null)" />
            </div>
        }
    </div>;

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Text);
        hc.Add(FormatJson);
        hc.Add(PanelFormatJson);
        hc.Add(FormatExceptions);
        hc.Add(PanelFormatExceptions);
        hc.Add(_wrap);
        hc.Add(ResolvedShowWrapToggle);
    }
}
