@namespace Soenneker.Quark
@using Microsoft.JSInterop
@using Soenneker.Asyncs.Locks
@using Soenneker.Atomics.ValueBools
@inherits Soenneker.Quark.Element
@implements IConsolePanel
@implements IAsyncDisposable
@inject IConsolePanelInterop ConsolePanelInterop

<div @ref="_element" @attributes="BuildAttributes()">
    @if (ShowDownload || ShowCopy)
    {
        <Div DataSlot="console-actions"
             Display="_renderCss0"
             FlexWrap="_renderCss1"
             ItemsAlign="_renderCss2"
             Justify="_renderCss3"
             Gap="_renderCss4"
             Margin="_renderCss5"
             Position="_renderCss6"
             Top="_renderCss7"
             ZIndex="_renderCss8"
             FontFamily="_renderCss9">
            @if (ShowDownload)
            {
                <Button Type="@ButtonType.Button"
                        Variant="@ActionVariant"
                        ButtonSize="@ActionSize"
                        Disabled="@ActionsDisabled"
                        OnClick="(_cachedDownloadDelegate ??= Download)">
                    <Icon Name="@DownloadIcon" Size="_renderCss10" />
                    <Span>@DownloadLabel</Span>
                </Button>
            }
            @if (ShowCopy)
            {
                <CopyButton TextProvider="(_resolveTextCallback ??= ResolveText)"
                            Variant="@ActionVariant"
                            ButtonSize="@ActionSize"
                            Disabled="@ActionsDisabled"
                            IdleIcon="@CopyIcon"
                            CopyLabel="@CopyLabel"
                            DoneLabel="@CopiedLabel"
                            OnCopySuccess="@OnCopySuccess"
                            OnCopyError="@OnCopyError">
                    @CopyLabel
                </CopyButton>
            }
            @Actions
        </Div>
    }
    <CascadingValue Name="ConsoleFormatExceptions" Value="FormatExceptions">
        <CascadingValue Name="ConsoleFormatJson" Value="FormatJson">
            <CascadingValue Name="ConsoleWrapLines" Value="WrapLines">
                <CascadingValue Name="ConsoleShowWrapToggle" Value="ShowWrapToggle">
                    @ChildContent
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</div>

@code {
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = ButtonSize.Sm;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowY = Quark.Overflow.Auto;
    private static readonly CssValue<OverscrollBuilder> _defaultOverscroll = Quark.Overscroll.Contain;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Is1;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Border;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Xl;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is4;
    private static readonly CssValue<FontFamilyBuilder> _defaultFontFamily = Quark.FontFamily.Mono;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Normal;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.Flex;
    private static readonly CssValue<FlexWrapBuilder> _renderCss1 = Quark.FlexWrap.Wrap;
    private static readonly CssValue<ItemsBuilder> _renderCss2 = Items.Center;
    private static readonly CssValue<JustifyBuilder> _renderCss3 = Quark.Justify.End;
    private static readonly CssValue<GapBuilder> _renderCss4 = Quark.Gap.Is2;
    private static readonly CssValue<MarginBuilder> _renderCss5 = Quark.Margin.FromBottom.Is3;
    private static readonly CssValue<PositionBuilder> _renderCss6 = Quark.Position.Sticky;
    private static readonly CssValue<TopBuilder> _renderCss7 = Quark.Top.Is0;
    private static readonly CssValue<ZIndexBuilder> _renderCss8 = Quark.ZIndex.Is10;
    private static readonly CssValue<FontFamilyBuilder> _renderCss9 = Quark.FontFamily.Sans;
    private static readonly CssValue<SizeBuilder> _renderCss10 = Quark.Size.Is3;
    private Func<Task>? _cachedDownloadDelegate;

    private string? _lastPrependedClass;
    private string? _lastBuiltStyle;

    [Parameter]
    public bool FormatExceptions { get; set; }
    [Parameter]
    public bool FormatJson { get; set; }
    [Parameter] public bool WrapLines { get; set; } = true;
    [Parameter] public bool ShowWrapToggle { get; set; } = true;
    private ElementReference _element;
    private Func<string?>? _resolveTextCallback;
    private readonly AsyncLock _interopLock = new();
    private bool _autoScrollInitialized;
    private ValueAtomicBool _disposed = new(false);

    /// <summary>The complete plain-text console content used for copy and download actions.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Resolves the latest plain-text console content when an action is invoked.</summary>
    [Parameter]
    public Func<string?>? TextProvider { get; set; }

    /// <summary>The filename used when downloading the console content.</summary>
    [Parameter]
    public string DownloadFileName { get; set; } = "console.log";

    /// <summary>The MIME type used when downloading the console content.</summary>
    [Parameter]
    public string DownloadContentType { get; set; } = "text/plain;charset=utf-8";

    /// <summary>Shows the download action.</summary>
    [Parameter]
    public bool ShowDownload { get; set; } = true;

    /// <summary>Shows the copy action.</summary>
    [Parameter]
    public bool ShowCopy { get; set; } = true;

    /// <summary>Disables the built-in actions.</summary>
    [Parameter]
    public bool ActionsDisabled { get; set; }

    /// <summary>Text displayed by the download action.</summary>
    [Parameter]
    public string DownloadLabel { get; set; } = "Download log";

    /// <summary>Text displayed by the copy action.</summary>
    [Parameter]
    public string CopyLabel { get; set; } = "Copy";

    /// <summary>Text exposed after a successful copy.</summary>
    [Parameter]
    public string CopiedLabel { get; set; } = "Copied";

    /// <summary>Icon displayed by the download action.</summary>
    [Parameter]
    public LucideIcon DownloadIcon { get; set; } = LucideIcon.Download;

    /// <summary>Icon displayed by the copy action.</summary>
    [Parameter]
    public LucideIcon CopyIcon { get; set; } = LucideIcon.Copy;

    /// <summary>Visual variant used by the built-in actions.</summary>
    [Parameter]
    public ButtonVariant ActionVariant { get; set; } = ButtonVariant.Outline;

    /// <summary>Size used by the built-in actions.</summary>
    [Parameter]
    public CssValue<ButtonSizeBuilder>? ActionSize { get; set; } = _staticCss0;

    /// <summary>Optional actions rendered after the built-in actions.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Automatically scrolls to the latest console output when rendered content changes.</summary>
    [Parameter]
    public bool AutoScroll { get; set; } = true;

    /// <summary>Fixed console height below the medium breakpoint.</summary>
    [Parameter]
    public string SmallScreenHeight { get; set; } = "24rem";

    /// <summary>Fixed console height at the medium breakpoint and above.</summary>
    [Parameter]
    public string MediumScreenHeight { get; set; } = "32rem";

    /// <summary>Raised after the log is downloaded.</summary>
    [Parameter]
    public EventCallback<string> OnDownload { get; set; }

    /// <summary>Raised when downloading the log fails.</summary>
    [Parameter]
    public EventCallback<Exception?> OnDownloadError { get; set; }

    /// <summary>Raised after the log is copied.</summary>
    [Parameter]
    public EventCallback<string> OnCopySuccess { get; set; }

    /// <summary>Raised when copying the log fails.</summary>
    [Parameter]
    public EventCallback<Exception?> OnCopyError { get; set; }

    private string? ResolveText() => TextProvider?.Invoke() ?? Text;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Value || AutoScroll == _autoScrollInitialized)
        {
            await base.OnAfterRenderAsync(firstRender);
            return;
        }

        using (await _interopLock.Lock())
        {
            if (!_disposed.Value && AutoScroll != _autoScrollInitialized)
            {
                if (AutoScroll)
                    await ConsolePanelInterop.InitializeAutoScroll(_element);
                else
                    await ConsolePanelInterop.DestroyAutoScroll(_element);

                _autoScrollInitialized = AutoScroll;
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task Download()
    {
        if (ActionsDisabled)
            return;

        try
        {
            var value = ResolveText();

            if (string.IsNullOrEmpty(value))
                throw new InvalidOperationException("No console text was provided to download.");

            await ConsolePanelInterop.Download(DownloadFileName, DownloadContentType, value);

            if (OnDownload.HasDelegate)
                await OnDownload.InvokeAsync(value);
        }
        catch (Exception exception)
        {
            if (OnDownloadError.HasDelegate)
                await OnDownloadError.InvokeAsync(exception);
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "console";
        Role ??= "log";
        AriaLabel ??= "Console output";
        Position ??= _defaultPosition;
        Shrink ??= _defaultShrink;
        OverflowY ??= _defaultOverflowY;
        Overscroll ??= _defaultOverscroll;
        Border ??= _defaultBorder;
        BorderColor ??= _defaultBorderColor;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        FontFamily ??= _defaultFontFamily;
        TextSize ??= _defaultTextSize;
        Leading ??= _defaultLeading;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["aria-live"] = "polite";

        PrependClassAttribute(attributes, "min-w-0 max-w-full h-[var(--console-height-small)] min-h-[var(--console-height-small)] max-h-[var(--console-height-small)] md:h-[var(--console-height-medium)] md:min-h-[var(--console-height-medium)] md:max-h-[var(--console-height-medium)] bg-muted/30 [scrollbar-gutter:stable] [scrollbar-width:thin]", ref _lastPrependedClass);

        {
            var sty = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendStyleDecl(ref sty, "--console-height-small: ", ResolveHeight(SmallScreenHeight, "24rem"));
                AppendStyleDecl(ref sty, "--console-height-medium: ", ResolveHeight(MediumScreenHeight, "32rem"));
                BuildStyleAttribute(attributes, ref sty, ref _lastBuiltStyle);
            }
            finally
            {
                sty.Dispose();
            }
        }
    }

    private static string ResolveHeight(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value.Trim().Trim('[', ']');

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;

        try
        {
            using (await _interopLock.Lock())
            {
                if (_autoScrollInitialized)
                {
                    await ConsolePanelInterop.DestroyAutoScroll(_element);
                    _autoScrollInitialized = false;
                }
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }

        finally
        {
            await base.DisposeAsync();
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AutoScroll);
        hc.Add(FormatExceptions);
        hc.Add(FormatJson);
        hc.Add(WrapLines);
        hc.Add(ShowWrapToggle);
    }
}
