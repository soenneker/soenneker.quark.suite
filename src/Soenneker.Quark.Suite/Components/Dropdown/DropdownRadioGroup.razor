@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixDropdownMenuRadioGroup Value="@Value"
                              DefaultValue="@DefaultValue" Disabled="@Disabled" ValueChanged="@ValueChanged"
                              AdditionalAttributes="@GroupAttributes"
                              ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />

@code {
    [Parameter] public string? DefaultValue { get; set; }
    [Parameter] public bool Disabled { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dropdown-menu-radio-group";
    }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    private IReadOnlyDictionary<string, object> GroupAttributes => BuildAttributes();

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(DefaultValue);
        hc.Add(Disabled);
    }
}