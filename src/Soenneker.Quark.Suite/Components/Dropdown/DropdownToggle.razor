@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements IDropdownToggle

@if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <BradixDropdownMenuTrigger Disabled="@(Disabled || ParentDropdown?.Disabled == true)"
                               OnClick="Clicked"
                               AdditionalAttributes="@TriggerAttributes">
        @ChildContent
    </BradixDropdownMenuTrigger>
}

@code {
    private QuarkAttributeDictionary _triggerAttributes;
    [Parameter]
    public bool AsChild { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the toggle is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> Clicked { get; set; }

    [CascadingParameter(Name = nameof(ParentDropdown))]
    public Dropdown? ParentDropdown { get; set; }

    [CascadingParameter]
    private BradixDropdownMenu? DropdownMenu { get; set; }

    [CascadingParameter]
    private BradixMenu? Menu { get; set; }

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildTriggerAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dropdown-menu-trigger";

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Disabled || ParentDropdown?.Disabled == true)
        {
            attributes["disabled"] = QuarkAttributeValues.True;
        }
    }

    private (bool, BradixDropdownMenu?, bool, string?, string?)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Action<ElementReference>? _contextRegisterElementCallback;
    private Func<PointerEventArgs, Task>? _contextOnPointerDownEventCallback;
    private Func<Task>? _contextOpenCallback;
    private Func<Task>? _contextCloseCallback;
    private Func<KeyboardEventArgs, Task>? _contextOnKeyDownCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (Disabled || ParentDropdown?.Disabled == true, DropdownMenu, DropdownMenu?.CurrentOpen == true, DropdownMenu?.TriggerId, DropdownMenu?.ContentId);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = null,
            TriggerId = DropdownMenu?.TriggerId,
            ParentDisabled = Disabled || ParentDropdown?.Disabled == true,
            IsOpen = DropdownMenu?.CurrentOpen == true,
            DataState = DropdownMenu?.CurrentOpen == true ? "open" : "closed",
            AriaHasPopup = "menu",
            AriaControls = DropdownMenu?.ContentId,
            RegisterElement = (_contextRegisterElementCallback ??= elementReference => { Menu?.RegisterTrigger(elementReference); }),
            PreventPointerDownDefault = DropdownMenu?.CurrentOpen != true,
            OnPointerDownEvent = DropdownMenu is null ? null : (_contextOnPointerDownEventCallback ??= async args =>
            {
                if (Disabled || ParentDropdown?.Disabled == true || args.Button != 0 || args.CtrlKey)
                    return;

                Menu?.SetFocusFirstItemOnOpen(false);
                await DropdownMenu.ToggleOpen();
            }),
            Open = DropdownMenu is null ? null : (_contextOpenCallback ??= async () =>
            {
                Menu?.SetFocusFirstItemOnOpen(true);
                await DropdownMenu.SetOpen(true);
            }),
            Close = DropdownMenu is null ? null : (_contextCloseCallback ??= () => DropdownMenu.SetOpen(false)),
            OnKeyDown = (_contextOnKeyDownCallback ??= HandleToggleKeyDown)
        };
    }

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        var attributes = _triggerAttributes.Create(BuildAttributes());
        attributes.Remove("type");
        attributes.Remove("id");
        attributes.Remove("disabled");

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Disabled);
        hc.Add(AsChild);
        hc.Add(DropdownMenu?.CurrentOpen == true);
        hc.Add(ParentDropdown?.Disabled == true);
    }

    private async Task HandleToggleKeyDown(KeyboardEventArgs e)
    {
        if (DropdownMenu is null || ParentDropdown is null || Disabled || ParentDropdown.Disabled)
            return;

        if (e.Key is "ArrowDown" or "Enter" or " " or "Space" or "Spacebar")
        {
            Menu?.SetFocusFirstItemOnOpen(true);
            await DropdownMenu.SetOpen(true);
        }
        else if (e.Key == "Escape" && DropdownMenu.CurrentOpen)
            await DropdownMenu.SetOpen(false);
    }
}
