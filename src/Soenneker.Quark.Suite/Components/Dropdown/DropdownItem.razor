@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements IDropdownItem

<BradixDropdownMenuItem Disabled="@Disabled" Href="@(IsLink ? Href : null)" Target="@(IsLink ? Target : null)" CloseOnSelect="@CloseOnSelect" OnSelect="(_cachedHandleSelectDelegate ??= HandleSelect)" AdditionalAttributes="@ItemAttributes">
    @ChildContent
</BradixDropdownMenuItem>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1_5;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is1_5.OnY.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.OnFocus.Accent;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.OnFocus.AccentForeground;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Default;
    private System.Func<Task>? _cachedHandleSelectDelegate;

    private string? _lastPrependedClass;


    [Parameter]
    public bool Indented { get; set; }

    /// <summary>
    /// Gets or sets whether the dropdown item is active.
    /// </summary>
    [Parameter]
    public bool Active { get; set; }

    /// <summary>
    /// Gets or sets whether selecting this item closes the dropdown menu.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// Gets or sets whether the dropdown item should be rendered as a link.
    /// </summary>
    [Parameter]
    public bool IsLink { get; set; }

    /// <summary>
    /// Gets or sets the href attribute for the link.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// Gets or sets the target attribute for the link.
    /// </summary>
    [Parameter]
    public string? Target { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the dropdown item is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> Clicked { get; set; }

    /// <summary>
    /// Variant: default or destructive.
    /// </summary>
    [Parameter]
    public string Variant { get; set; } = "default";

    private QuarkAttributeDictionary _itemAttributesBuffer;

    private IReadOnlyDictionary<string, object> ItemAttributes => BuildItemAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dropdown-menu-item";
        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;
        OutlineStyle ??= _defaultOutlineStyle;
        UserSelect ??= _defaultUserSelect;
        Cursor ??= _defaultCursor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        var variant = Variant.Equals("destructive", StringComparison.OrdinalIgnoreCase) ? "destructive" : "default";
        attributes["data-variant"] = variant;
        if (Indented)
            attributes["data-inset"] = "true";

        PrependClassAttribute(attributes, "group/dropdown-menu-item not-data-[variant=destructive]:focus:**:text-accent-foreground data-disabled:pointer-events-none data-disabled:opacity-50 data-inset:pl-7 data-[variant=destructive]:text-destructive data-[variant=destructive]:focus:bg-destructive/10 data-[variant=destructive]:focus:text-destructive dark:data-[variant=destructive]:focus:bg-destructive/20 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 data-[variant=destructive]:*:[svg]:text-destructive", ref _lastPrependedClass);

        if (Active)
        {
            attributes["aria-current"] = "page";
        }
    }

    private IReadOnlyDictionary<string, object> BuildItemAttributes()
    {
        Dictionary<string, object> attributes = _itemAttributesBuffer.Create(BuildAttributes());
        attributes.Remove("href");
        attributes.Remove("target");
        attributes.Remove("type");
        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Active);
        hc.Add(Disabled);
        hc.Add(CloseOnSelect);
        hc.Add(IsLink);
        hc.Add(Href);
        hc.Add(Target);
        hc.Add(Indented);
        hc.Add(Variant);
    }

    private Task HandleSelect()
    {
        return Clicked.HasDelegate ? Clicked.InvokeAsync(new MouseEventArgs()) : Task.CompletedTask;
    }

}
