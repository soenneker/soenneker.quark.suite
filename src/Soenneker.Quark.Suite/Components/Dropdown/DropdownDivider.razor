
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IDropdownDivider

<BradixDropdownMenuSeparator AdditionalAttributes="@SeparatorAttributes" />

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.OnX.Negative1.OnY.Is1;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsPx;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Border;
    private IReadOnlyDictionary<string, object> SeparatorAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dropdown-menu-separator";
        Margin ??= _defaultMargin;
        Height ??= _defaultHeight;
        BackgroundColor ??= _defaultBackgroundColor;

    }
}