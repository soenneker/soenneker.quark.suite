
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.OverlayElement
@implements IDropdownMenu

<BradixDropdownMenuPortal>
    <BradixDropdownMenuContent Side="@ResolvedSide"
                               Align="@ResolvedAlign"
                               SideOffset="@SideOffset"
                               AlignOffset="@AlignOffset"
                               ArrowPadding="@ArrowPadding"
                               AvoidCollisions="@AvoidCollisions"
                               CollisionPadding="@CollisionPadding"
                               CollisionBoundarySelector="@CollisionBoundarySelector"
                               CollisionBoundarySelectors="@CollisionBoundarySelectors"
                               Sticky="@Sticky"
                               HideWhenDetached="@HideWhenDetached"
                               AdditionalAttributes="@ContentAttributes">
        @ChildContent
    </BradixDropdownMenuContent>
</BradixDropdownMenuPortal>

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is32;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is50;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.Token("(--radix-dropdown-menu-trigger-width)");
    private static readonly CssValue<OverflowBuilder> _defaultOverflowX = Quark.Overflow.X.Hidden;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowY = Quark.Overflow.Y.Auto;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is1;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Md;
    private static readonly CssValue<DurationBuilder> _defaultDuration = Quark.Duration.Is150;
    private string? _lastPrependedClass;

    /// <summary>
    /// Gets or sets whether the dropdown menu should be right-aligned.
    /// </summary>
    [Parameter]
    public bool RightAligned { get; set; }

    /// <summary>
    /// Gets or sets the alignment of the dropdown menu relative to the trigger.
    /// </summary>
    [Parameter]
    public Alignment? Align { get; set; }

    /// <summary>
    /// Gets or sets the side of the dropdown menu.
    /// </summary>
    [Parameter]
    public Side Side { get; set; } = Side.Bottom;

    [Parameter]
    public double SideOffset { get; set; } = 4;

    [Parameter]
    public double AlignOffset { get; set; }

    [Parameter]
    public double ArrowPadding { get; set; }

    [Parameter]
    public bool AvoidCollisions { get; set; } = true;

    [Parameter]
    public double CollisionPadding { get; set; }

    [Parameter]
    public string? CollisionBoundarySelector { get; set; }

    [Parameter]
    public IReadOnlyList<string>? CollisionBoundarySelectors { get; set; }

    [Parameter]
    public string Sticky { get; set; } = "partial";

    [Parameter]
    public bool HideWhenDetached { get; set; }

    [CascadingParameter(Name = nameof(ParentDropdown))]
    public Dropdown? ParentDropdown { get; set; }

    private bool ResolvedRightAligned => RightAligned || ParentDropdown?.RightAligned == true;

    private Side ResolvedSide => ParentDropdown?.Side ?? Side;

    private Alignment ResolvedAlign => Align ?? (ResolvedRightAligned ? Alignment.End : Alignment.Start);

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildContentAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dropdown-menu-content";

        ZIndex ??= _defaultZIndex;
        MaxHeight ??= "max-h-(--radix-dropdown-menu-content-available-height)";
        Width ??= _defaultWidth;
        MinWidth ??= _staticCss0;
        OverflowX ??= _defaultOverflowX;
        OverflowY ??= _defaultOverflowY;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        TextColor ??= _defaultTextColor;
        Shadow ??= _defaultShadow;
        Duration ??= _defaultDuration;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        {
            const string @class = "cn-menu-target cn-menu-translucent ring-1 ring-foreground/10 origin-(--radix-dropdown-menu-content-transform-origin) data-[state=closed]:overflow-hidden data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }

    private IReadOnlyDictionary<string, object> BuildContentAttributes()
    {
        return BuildAttributes();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ResolvedRightAligned);
        hc.Add(Align);
        hc.Add(ResolvedSide);
        hc.Add(SideOffset);
        hc.Add(AlignOffset);
        hc.Add(ArrowPadding);
        hc.Add(AvoidCollisions);
        hc.Add(CollisionPadding);
        hc.Add(CollisionBoundarySelector);
        if (CollisionBoundarySelectors is not null)
        {
            foreach (var selector in CollisionBoundarySelectors)
                hc.Add(selector);
        }
        hc.Add(Sticky);
        hc.Add(HideWhenDetached);
    }
}
