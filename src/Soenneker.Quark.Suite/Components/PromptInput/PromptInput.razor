@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<CascadingValue Value="@this" IsFixed="true">
    <CascadingValue Name="PromptInputAttachmentsVersion" Value="@_attachmentsVersion" IsFixed="false">
        <form @ref="ElementRef" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @onsubmit="(_cachedHandleSubmitDelegate ??= HandleSubmit)" @onsubmit:preventDefault @attributes="BuildAttributes()">
            @ChildContent
        </form>
    </CascadingValue>
</CascadingValue>

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Auto;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is0;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Token("[24px]");
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Border;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Card;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Text;
    private string? _lastPrependedClass;

    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;
    private System.Func<Task>? _cachedHandleSubmitDelegate;

    private string? _value;
    private readonly List<PromptInputAttachmentInfo> _attachments = [];
    private HashSet<string>? _attachmentIds;
    private HashSet<(string Name, long Size, string? Type)>? _attachmentMetadata;
    private int _attachmentsVersion;

    [Parameter]
    public EventCallback<string?> OnSubmit { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback<PromptInputMessage> OnSubmitMessage { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<PromptInputAttachmentInfo>> AttachmentsChanged { get; set; }

    [Parameter]
    public bool Multiple { get; set; }

    [Parameter]
    public string? Accept { get; set; }

    [Parameter]
    public bool GlobalDrop { get; set; }

    internal IReadOnlyList<PromptInputAttachmentInfo> Attachments => _attachments;

    private Task HandleClick(MouseEventArgs args)
    {
        return OnClick.HasDelegate ? OnClick.InvokeAsync(args) : Task.CompletedTask;
    }

    internal void SetValue(string? value)
    {
        _value = value;
    }

    internal async Task Submit(string? value)
    {
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(value);

        if (OnSubmitMessage.HasDelegate)
            await OnSubmitMessage.InvokeAsync(new PromptInputMessage
            {
                Text = value,
                Files = CopyAttachments()
            });
    }

    internal Task AddAttachments(IReadOnlyList<PromptInputAttachmentInfo> attachments)
    {
        if (attachments.Count == 0)
            return Task.CompletedTask;

        if (!Multiple)
            _attachments.Clear();

        if (_attachments.Count + attachments.Count < 8)
        {
            for (var index = 0; index < attachments.Count; index++)
            {
                var attachment = attachments[index];
                if (!ContainsSameAttachment(attachment))
                    _attachments.Add(attachment);
            }
        }
        else
        {
            var ids = _attachmentIds ??= new(StringComparer.Ordinal);
            var metadata = _attachmentMetadata ??= [];
            try
            {
                for (var index = 0; index < _attachments.Count; index++)
                {
                    var existing = _attachments[index];
                    ids.Add(existing.Id);
                    metadata.Add((existing.Name, existing.Size, existing.Type));
                }
                for (var index = 0; index < attachments.Count; index++)
                {
                    var attachment = attachments[index];
                    var key = (attachment.Name, attachment.Size, attachment.Type);
                    if (ids.Contains(attachment.Id) || metadata.Contains(key)) continue;
                    ids.Add(attachment.Id);
                    metadata.Add(key);
                    _attachments.Add(attachment);
                }
            }
            finally
            {
                ids.Clear();
                metadata.Clear();
            }
        }

        return NotifyAttachmentsChanged();
    }

    internal Task RemoveAttachment(string id)
    {
        int kept = 0;
        for (int i = 0; i < _attachments.Count; i++)
        {
            var attachment = _attachments[i];
            if (!string.Equals(attachment.Id, id, StringComparison.Ordinal))
                _attachments[kept++] = attachment;
        }

        if (kept == _attachments.Count)
            return Task.CompletedTask;

        _attachments.RemoveRange(kept, _attachments.Count - kept);

        return NotifyAttachmentsChanged();
    }

    internal Task ClearAttachments()
    {
        if (_attachments.Count == 0)
            return Task.CompletedTask;

        _attachments.Clear();
        return NotifyAttachmentsChanged();
    }

    private async Task NotifyAttachmentsChanged()
    {
        if (AttachmentsChanged.HasDelegate)
            await AttachmentsChanged.InvokeAsync(CopyAttachments());

        _attachmentsVersion++;
        StateHasChanged();
    }

    private static bool IsSameAttachment(PromptInputAttachmentInfo left, PromptInputAttachmentInfo right)
    {
        return string.Equals(left.Id, right.Id, StringComparison.Ordinal) ||
               (string.Equals(left.Name, right.Name, StringComparison.Ordinal) &&
                left.Size == right.Size &&
               string.Equals(left.Type, right.Type, StringComparison.Ordinal));
    }

    private PromptInputAttachmentInfo[] CopyAttachments() => _attachments.ToArray();

    private bool ContainsSameAttachment(PromptInputAttachmentInfo attachment)
    {
        for (var i = 0; i < _attachments.Count; i++)
        {
            if (IsSameAttachment(_attachments[i], attachment))
                return true;
        }

        return false;
    }

    private Task HandleSubmit()
    {
        return Submit(_value);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "prompt-input";

        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        Gap ??= _defaultGap;
        Overflow ??= _defaultOverflow;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BorderColor ??= _defaultBorderColor;
        BackgroundColor ??= _defaultBackgroundColor;
        Cursor ??= _defaultCursor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["role"] = "group";
        attributes["aria-label"] = "Chat input";
        attributes["data-global-drop"] = GlobalDrop ? "true" : "false";
        attributes["data-multiple"] = Multiple ? "true" : "false";

        PrependClassAttribute(attributes, "dark:border-border/50 dark:bg-input/30", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Multiple);
        hc.Add(Accept);
        hc.Add(GlobalDrop);
    }
}
