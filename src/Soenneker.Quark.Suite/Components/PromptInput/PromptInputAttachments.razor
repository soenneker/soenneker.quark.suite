@namespace Soenneker.Quark
@inherits Soenneker.Quark.Component

@if (PromptInput is not null && PromptInput.Attachments.Count > 0)
{
    <Attachments Variant="@Variant" @attributes="BuildAttributes()">
        @for (var attachmentIndex = 0; attachmentIndex < PromptInput.Attachments.Count; attachmentIndex++)
        {
            var attachment = PromptInput.Attachments[attachmentIndex];
            if (AttachmentTemplate is not null)
            {
                @AttachmentTemplate(attachment)
            }
            else
            {
                var view = GetAttachmentView(attachmentIndex, attachment);
                <Attachment Name="@attachment.Name" Description="@view.Description" Variant="@AttachmentVariant">
                    <Button Type="@ButtonType.Button"
                            ButtonSize="_staticCss0"
                            Variant="ButtonVariant.Ghost"
                            aria-label="@view.RemoveLabel"
                            OnClick="@view.Remove">
                        <Icon Name="LucideIcon.X" />
                    </Button>
                </Attachment>
            }
        }
    </Attachments>
}

@code {
    private AttachmentView?[]? _attachmentViews;

    private AttachmentView GetAttachmentView(int index, PromptInputAttachmentInfo attachment)
    {
        var count = PromptInput!.Attachments.Count;
        if (_attachmentViews is null || _attachmentViews.Length != count)
            Array.Resize(ref _attachmentViews, count);
        var view = _attachmentViews[index];
        if (view is null || !ReferenceEquals(view.Attachment, attachment))
            _attachmentViews[index] = view = new AttachmentView(this, attachment);
        return view;
    }

    protected override void OnParametersSet()
    {
        if (AttachmentTemplate is not null || PromptInput is null || PromptInput.Attachments.Count == 0)
            _attachmentViews = null;
        base.OnParametersSet();
    }

    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = ButtonSize.IconXs;
    [CascadingParameter]
    public PromptInput? PromptInput { get; set; }

    [CascadingParameter(Name = "PromptInputAttachmentsVersion")]
    public int AttachmentsVersion { get; set; }

    [Parameter]
    public string Variant { get; set; } = "inline";

    [Parameter]
    public string AttachmentVariant { get; set; } = "inline";

    [Parameter]
    public RenderFragment<PromptInputAttachmentInfo>? AttachmentTemplate { get; set; }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AttachmentsVersion);
        hc.Add(Variant);
        hc.Add(AttachmentVariant);
        hc.Add(PromptInput?.Attachments.Count);
    }
}
