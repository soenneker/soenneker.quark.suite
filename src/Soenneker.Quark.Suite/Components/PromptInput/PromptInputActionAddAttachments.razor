@using System.Text.Json
@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Soenneker.Blazor.Utils.Ids
@inherits Soenneker.Quark.Element
@implements IAsyncDisposable
@inject IPromptInputInterop PromptInputInterop

<PromptInputButton>
    <Button Type="@ButtonType.Button"
            ButtonSize="@ButtonSize"
            Variant="@Variant"
            Disabled="@Disabled"
            aria-label="@Label"
            OnClick="(_cachedOpenFileDialogDelegate ??= OpenFileDialog)"
            @attributes="BuildAttributes()">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <Icon Name="@IconName" />
            @if (ShowLabel)
            {
                <span>@Label</span>
            }
        }
    </Button>
    <InputFile id="@_inputId"
               data-slot="prompt-input-file-input"
               class="sr-only"
               tabindex="-1"
               accept="@EffectiveAccept"
               multiple="@EffectiveMultiple"
               disabled="@Disabled"
               aria-hidden="true"
               OnChange="(_cachedHandleFilesSelectedDelegate ??= HandleFilesSelected)" />
</PromptInputButton>

@code {
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = Soenneker.Quark.ButtonSize.IconSm;
    private Func<Task>? _cachedOpenFileDialogDelegate;
    private Func<InputFileChangeEventArgs, Task>? _cachedHandleFilesSelectedDelegate;

    private readonly string _inputId = BlazorIdGenerator.New("prompt-input-file");
    private DotNetObjectReference<PromptInputActionAddAttachments>? _dotNetReference;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;

    [CascadingParameter]
    public PromptInput? PromptInput { get; set; }

    [Parameter]
    public string Label { get; set; } = "Add attachments";

    [Parameter]
    public string? Accept { get; set; }

    [Parameter]
    public bool? Multiple { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ShowLabel { get; set; }

    [Parameter]
    public LucideIcon IconName { get; set; } = LucideIcon.Paperclip;

    [Parameter]
    public CssValue<ButtonSizeBuilder>? ButtonSize { get; set; } = _staticCss0;

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;

    private bool EffectiveMultiple => Multiple ?? PromptInput?.Multiple == true;

    private string? EffectiveAccept => Accept ?? PromptInput?.Accept;

    private Task OpenFileDialog()
    {
        if (Disabled || !_registered.Value)
            return Task.CompletedTask;

        return PromptInputInterop.OpenFileDialogById(_inputId).AsTask();
    }

    private Task HandleFilesSelected(InputFileChangeEventArgs args)
    {
        if (Disabled || _disposed.Read() || PromptInput is null)
            return Task.CompletedTask;

        var browserFiles = args.GetMultipleFiles(args.FileCount);
        var multiple = EffectiveMultiple;
        var accept = EffectiveAccept;
        List<PromptInputAttachmentInfo>? accepted = null;
        for (var i = 0; i < browserFiles.Count; i++)
        {
            var file = browserFiles[i];
            if (!FileAcceptFilter.Matches(accept, file.Name, file.ContentType)) continue;
            (accepted ??= new(multiple ? browserFiles.Count : 1)).Add(new(
                file.Name, file.Size, string.IsNullOrEmpty(file.ContentType) ? null : file.ContentType,
                file.LastModified.ToUnixTimeMilliseconds()));
            if (!multiple) break;
        }
        return accepted is null ? Task.CompletedTask : PromptInput.AddAttachments(accepted);
    }

    [JSInvokable(nameof(AddAttachments))]
    public Task AddAttachmentsFromJson(JsonElement payload)
    {
        if (Disabled || _disposed.Read() || PromptInput is null) return Task.CompletedTask;
        var multiple = EffectiveMultiple;
        var accept = EffectiveAccept;
        List<PromptInputAttachmentInfo>? accepted = null;
        foreach (var file in payload.EnumerateArray())
        {
            var name = file.TryGetProperty("name", out var nameValue) ? nameValue.GetString() ?? string.Empty : string.Empty;
            var type = file.TryGetProperty("type", out var typeValue) ? typeValue.GetString() : null;
            if (!FileAcceptFilter.Matches(accept, name, type)) continue;
            var size = file.TryGetProperty("size", out var sizeValue) ? sizeValue.GetInt64() : 0;
            var modified = file.TryGetProperty("lastModified", out var modifiedValue) ? modifiedValue.GetInt64() : 0;
            var id = file.TryGetProperty("id", out var idValue) ? idValue.GetString() : null;
            (accepted ??= new(multiple ? payload.GetArrayLength() : 1)).Add(new(name, size, type, modified, id));
            if (!multiple) break;
        }
        return accepted is null ? Task.CompletedTask : PromptInput.AddAttachments(accepted);
    }

    public Task AddAttachments(PromptInputAttachmentInfo[] attachments)
    {
        if (Disabled || _disposed.Read() || PromptInput is null)
            return Task.CompletedTask;

        var multiple = EffectiveMultiple;
        var accept = EffectiveAccept;
        List<PromptInputAttachmentInfo>? accepted = null;
        foreach (var attachment in attachments)
        {
            if (!FileAcceptFilter.Matches(accept, attachment.Name, attachment.Type)) continue;
            (accepted ??= new(multiple ? attachments.Length : 1)).Add(string.IsNullOrEmpty(attachment.Id)
                ? new(attachment.Name, attachment.Size, attachment.Type, attachment.LastModified) : attachment);
            if (!multiple) break;
        }
        return accepted is null ? Task.CompletedTask : PromptInput.AddAttachments(accepted);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_disposed.Read() || !firstRender)
            return;

        _dotNetReference = DotNetObjectReference.Create(this);
        await PromptInputInterop.RegisterAttachmentsById(_inputId, _dotNetReference, PromptInput?.GlobalDrop == true);
        if (_disposed.Read())
        {
            await UnregisterAttachments();
            return;
        }

        _registered.Value = true;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Label);
        hc.Add(Accept);
        hc.Add(Multiple);
        hc.Add(Disabled);
        hc.Add(ShowLabel);
        hc.Add(IconName);
        hc.Add(ButtonSize);
        hc.Add(Variant);
        hc.Add(PromptInput?.GlobalDrop);
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_registered.Value)
                await UnregisterAttachments();
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
            await base.DisposeAsync();
        }
    }

    private async ValueTask UnregisterAttachments()
    {
        try
        {
            await PromptInputInterop.UnregisterAttachmentsById(_inputId);
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
