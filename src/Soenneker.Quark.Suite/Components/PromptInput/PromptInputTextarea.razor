@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@using Microsoft.JSInterop
@inherits Soenneker.Quark.Component
@implements IAsyncDisposable
@inject IPromptInputInterop PromptInputInterop

<textarea @ref="_element"
          @attributes="TextareaAttributes"
          value="@Value"
          placeholder="@Placeholder"
          rows="@(Rows.HasValue ? _rowsAttribute.Get(Rows.Value) : null)"
          @oninput="(_cachedHandleInputDelegate ??= HandleInput)"
          @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"></textarea>

@code {
    private QuarkInt32Attribute _rowsAttribute;
    private string? _textareaClass;
    private Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private ElementReference _element;
    private bool _registered;
    private ValueAtomicBool _disposed;
    private QuarkAttributeDictionary _attributesBuffer;

    [CascadingParameter]
    public PromptInput? PromptInput { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "How can I help you today?";

    [Parameter]
    public int? Rows { get; set; } = 2;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "prompt-input-textarea";
    }

    private IReadOnlyDictionary<string, object> TextareaAttributes
    {
        get
        {
            var attributes = _attributesBuffer.Create(BuildAttributes(), 2);
            attributes.TryGetValue("class", out var existingClass);
            attributes["aria-label"] = "Message input";
            const string baseClass =
                "field-sizing-content min-h-14 max-h-40 w-full resize-none border-0 bg-transparent px-4 py-4 text-sm leading-6 font-normal text-primary shadow-none outline-none placeholder:text-muted-foreground focus-visible:ring-0 focus-visible:ring-offset-0 dark:bg-transparent";
            var existingClassString = existingClass?.ToString();
            attributes["class"] = string.IsNullOrWhiteSpace(existingClassString) ? baseClass : QuarkStringCache.Concat(baseClass, " ", existingClassString, ref _textareaClass);

            return attributes;
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" && !args.ShiftKey && PromptInput is not null
            ? PromptInput.Submit(Value)
            : Task.CompletedTask;

    private Task HandleInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        Value = value;
        PromptInput?.SetValue(value);
        return ValueChanged.InvokeAsync(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_disposed.Read() || !firstRender)
            return;

        await PromptInputInterop.RegisterTextarea(_element);
        if (_disposed.Read())
        {
            await UnregisterTextarea();
            return;
        }

        _registered = true;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(Placeholder);
        hc.Add(Rows);
    }

    private async ValueTask UnregisterTextarea()
    {
        try
        {
            await PromptInputInterop.UnregisterTextarea(_element);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_registered)
            {
                _registered = false;
                await UnregisterTextarea();
            }
        }
        finally
        {
            await base.DisposeAsync();
        }
    }
}
