@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@using System.Text.RegularExpressions
@inject IInputInterop InputInterop

<CascadingValue Value="_context" IsFixed="false">
    <div dir="ltr" data-input-otp-container="true" style="@ContainerStyle" class="cn-input-otp inline-flex items-center has-disabled:opacity-50">
        @ChildContent
        <div style="position:absolute;inset:0;pointer-events:none">
            <input @ref="_inputRef"
                   value="@CurrentValue"
                   @oninput="(_cachedHandleInputDelegate ??= HandleInput)"
                   @onfocus="(_cachedHandleOtpFocusDelegate ??= HandleOtpFocus)"
                   @onblur="(_cachedHandleOtpBlurDelegate ??= HandleOtpBlur)"
                   @onclick="(_cachedHandleSelectionClickDelegate ??= HandleSelectionClick)"
                   @onselect="(_cachedHandleSelectionDelegate ??= HandleSelection)"
                   @onkeyup="(_cachedHandleSelectionKeyDelegate ??= HandleSelectionKey)"
                   @attributes="BuildAttributes()" />
        </div>
    </div>
</CascadingValue>

@code {
    private QuarkInt32Attribute _selectionIndexAttribute, _lengthAttribute;
    private (bool Disabled, string Height) _containerStyleKey;
    private string? _containerStyle;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.OnDisabled.NotAllowed;
    private Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private Func<FocusEventArgs, Task>? _cachedHandleOtpFocusDelegate;
    private Func<MouseEventArgs, Task>? _cachedHandleSelectionClickDelegate;
    private Func<EventArgs, Task>? _cachedHandleSelectionDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleSelectionKeyDelegate;
    private ValueAtomicBool _disposed;
    private Action<FocusEventArgs>? _cachedHandleOtpBlurDelegate;

    private InputOtpContext _context = new();
    private ElementReference _inputRef;
    private string _uncontrolledValue = string.Empty;
    private string? _cachedPattern;
    private Regex? _cachedPatternRegex;

    private string CurrentValue => OtpValue ?? _uncontrolledValue;

    /// <summary>
    /// Gets or sets the OTP value.
    /// </summary>
    [Parameter]
    public string? OtpValue { get; set; }

    /// <summary>
    /// Gets or sets the initial OTP value for uncontrolled usage.
    /// </summary>
    [Parameter]
    public string? DefaultOtpValue { get; set; }

    /// <summary>
    /// Gets or sets the callback when the OTP value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string> OtpValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the number of slots.
    /// </summary>
    [Parameter]
    public int Length { get; set; } = 6;

    /// <summary>
    /// Optional regex pattern used to validate entered characters.
    /// </summary>
    [Parameter]
    public string? Pattern { get; set; }

    /// <summary>
    /// Controls the virtual keyboard hint for the hidden input.
    /// </summary>
    [Parameter]
    public string? InputMode { get; set; } = "numeric";

    /// <summary>
    /// Sets the OTP package root height custom property used by the transparent input.
    /// </summary>
    [Parameter]
    public string RootHeight { get; set; } = "32px";

    /// <summary>
    /// Gets or sets the autocomplete attribute for the hidden input.
    /// </summary>
    [Parameter]
    public string AutoComplete { get; set; } = "one-time-code";

    internal string? InputId => Id;

    private string Sanitize(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        if (string.IsNullOrWhiteSpace(Pattern))
            return value;

        var regex = GetPatternRegex();
        var firstInvalid = 0;
        while (firstInvalid < value.Length && regex.IsMatch(value.AsSpan(firstInvalid, 1)))
            firstInvalid++;

        if (firstInvalid == value.Length)
            return value;

        var builder = new PooledStringBuilder(stackalloc char[64]);
        try
        {
            builder.Append(value.AsSpan(0, firstInvalid));
            for (var remaining = firstInvalid + 1; remaining < value.Length; remaining++)
                if (regex.IsMatch(value.AsSpan(remaining, 1)))
                    builder.Append(value[remaining]);
            return builder.ToString();
        }
        finally
        {
            builder.Dispose();
        }
    }

    private Regex GetPatternRegex()
    {
        if (_cachedPatternRegex is not null && string.Equals(_cachedPattern, Pattern, StringComparison.Ordinal))
            return _cachedPatternRegex;

        _cachedPattern = Pattern;
        _cachedPatternRegex = new Regex(Pattern!, RegexOptions.CultureInvariant);
        return _cachedPatternRegex;
    }

    protected override void OnInitialized()
    {
        _uncontrolledValue = Sanitize(DefaultOtpValue ?? string.Empty);
        SyncContext();
    }

    protected override void OnParametersSet()
    {
        SyncContext();
        base.OnParametersSet();
    }

    private Task HandleInput(ChangeEventArgs args)
    {
        return SetValue(args.Value?.ToString() ?? string.Empty);
    }

    private async Task SetValue(string value)
    {
        if (Disabled || ReadOnly)
            return;

        var sanitized = Sanitize(value);

        if (sanitized.Length > Math.Max(0, Length))
            sanitized = sanitized[..Math.Max(0, Length)];

        if (OtpValue is null)
            _uncontrolledValue = sanitized;

        var selection = await InputInterop.GetSelection(_inputRef);
        if (_disposed.Value) return;
        var index = selection is null ? sanitized.Length : Math.Min(selection.Start, sanitized.Length);
        _context = CreateContext(sanitized, focused: true, index);
        await OtpValueChanged.InvokeAsync(sanitized);
    }

    private async Task HandleOtpFocus(FocusEventArgs _)
    {
        _context = CreateContext(CurrentValue, focused: true, activeIndex: CurrentValue.Length);
        await SyncSelection();
    }

    private Task HandleSelectionClick(MouseEventArgs _) => SyncSelection();
    private Task HandleSelection(EventArgs _) => SyncSelection();
    private Task HandleSelectionKey(KeyboardEventArgs e) => e.Key is "ArrowLeft" or "ArrowRight" or "Home" or "End"
        ? SyncSelection() : Task.CompletedTask;

    private async Task SyncSelection()
    {
        if (Disabled || !_context.Focused || _disposed.Value) return;
        var selection = await InputInterop.GetSelection(_inputRef);
        if (!_disposed.Value && selection is not null)
            _context = CreateContext(CurrentValue, focused: true, activeIndex: selection.Start);
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        await base.DisposeAsync();
    }

    private void HandleOtpBlur(FocusEventArgs _)
    {
        _context = CreateContext(CurrentValue, focused: false);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "input-otp";
        Cursor ??= _defaultCursor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var selectionIndex = _context.ActiveIndex;

        attributes["data-input-otp"] = "true";
        attributes["data-input-otp-mss"] = _selectionIndexAttribute.Get(selectionIndex);
        attributes["data-input-otp-mse"] = _selectionIndexAttribute.Get(selectionIndex);
        attributes["type"] = "text";
        attributes["autocomplete"] = AutoComplete;
        attributes["dir"] = "ltr";
        attributes["spellcheck"] = "false";
        attributes["maxlength"] = _lengthAttribute.Get(Math.Max(0, Length));

        if (!string.IsNullOrWhiteSpace(InputMode))
            attributes["inputmode"] = InputMode;

        if (!string.IsNullOrWhiteSpace(Name))
            attributes["name"] = Name;

        if (Disabled)
        {
            attributes["data-disabled"] = "true";
            attributes["disabled"] = QuarkAttributeValues.True;
        }

        if (ReadOnly)
            attributes["readonly"] = QuarkAttributeValues.True;

        if (Required)
            attributes["required"] = QuarkAttributeValues.True;

        attributes["style"] =
            "position:absolute;inset:0;width:100%;height:100%;display:flex;text-align:left;opacity:1;color:transparent;pointer-events:all;background:transparent;caret-color:transparent;border:0 solid transparent;outline:0 solid transparent;box-shadow:none;line-height:1;letter-spacing:-.5em;font-size:var(--root-height);font-family:monospace;font-variant-numeric:tabular-nums";

    }

    private void SyncContext()
    {
        _context = CreateContext(CurrentValue, _context.Focused, _context.ActiveIndex);
    }

    private string ContainerStyle
    {
        get
        {
            var key = (Disabled, RootHeight);
            if (_containerStyle is null || _containerStyleKey != key)
            {
                _containerStyleKey = key;
                _containerStyle = $"position: relative; display: inline-flex; width: fit-content; cursor: {(Disabled ? "default" : "text")}; user-select: none; pointer-events: none; --root-height: {RootHeight};";
            }
            return _containerStyle;
        }
    }

    private InputOtpContext CreateContext(string value, bool focused, int? activeIndex = null)
    {
        int index = Math.Clamp(activeIndex ?? 0, 0, Math.Max(0, Length - 1));
        if (_context.Value == value && _context.Length == Length && _context.Focused == focused && _context.ActiveIndex == index)
            return _context;
        return new InputOtpContext
        {
            Value = value,
            Length = Length,
            Focused = focused,
            ActiveIndex = index
        };
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(OtpValue);
        hc.Add(DefaultOtpValue);
        hc.Add(Length);
        hc.Add(Pattern);
        hc.Add(InputMode);
        hc.Add(AutoComplete);
        hc.Add(Disabled);
        hc.Add(RootHeight);
        hc.Add(_context.Value);
        hc.Add(_context.Focused);
        hc.Add(_context.ActiveIndex);
    }
}
