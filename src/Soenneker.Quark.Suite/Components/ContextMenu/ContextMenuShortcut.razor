@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<span @attributes="BuildAttributes()">
    @ChildContent
</span>

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromLeft.Auto;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TrackingBuilder> _defaultTracking = Quark.Tracking.Widest;
    private string? _lastPrependedClass;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "context-menu-shortcut";

        Margin ??= _defaultMargin;
        TextSize ??= _defaultTextSize;
        TextColor ??= _defaultTextColor;
        Tracking ??= _defaultTracking;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "group-focus/context-menu-item:text-accent-foreground", ref _lastPrependedClass);
    }
}