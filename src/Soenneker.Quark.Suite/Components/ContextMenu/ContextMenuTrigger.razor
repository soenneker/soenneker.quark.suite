@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixContextMenuTrigger Disabled="@Disabled"
                          AdditionalAttributes="@TriggerAttributes"
                          ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />

@code {
    // The modal menu disables body pointer events; its own trigger must still receive repeated right-clicks.
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = "data-[state=open]:pointer-events-auto";

    [Parameter]
    public bool Disabled { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "context-menu-trigger";
        PointerEvents ??= _defaultPointerEvents;
    }

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildAttributes();

}
