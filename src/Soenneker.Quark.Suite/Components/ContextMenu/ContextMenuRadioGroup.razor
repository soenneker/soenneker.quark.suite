@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixContextMenuRadioGroup Value="@Value" DefaultValue="@DefaultValue" ValueChanged="@ValueChanged" Disabled="@Disabled" AdditionalAttributes="@RadioGroupAttributes"
                             ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? DefaultValue { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(DefaultValue);
        hc.Add(Disabled);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "context-menu-radio-group";
    }

    private IReadOnlyDictionary<string, object> RadioGroupAttributes => BuildAttributes();
}