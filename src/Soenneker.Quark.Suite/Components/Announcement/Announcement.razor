@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (Href.HasContent())
{
    <a href="@Href" target="@Target?.Value" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @attributes="BuildAttributes()">
        @RenderContent()
    </a>
}
else if (OnClick.HasDelegate)
{
    <button type="button" @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @attributes="BuildAttributes()">
        @RenderContent()
    </button>
}
else
{
    <span @attributes="BuildAttributes()">
        @RenderContent()
    </span>
}

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        AppendClass(ref cls, "group/announcement");
        AppendClass(ref cls, "hover:shadow-md focus-visible:border-ring focus-visible:ring-[3px] [&_svg]:pointer-events-none [&_svg]:shrink-0");
        AppendClass(ref cls, Themed ? "shadow-primary/5 hover:bg-primary/10 dark:bg-primary/10 dark:hover:bg-primary/15" : "hover:bg-muted/50");
    }

    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<MaxWidthBuilder> _staticCss1 = Quark.MaxWidth.IsFull;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2.OnY.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Sm;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<ShrinkBuilder> _renderCss0 = Quark.Shrink.Is0;
    private static readonly CssValue<RoundedBuilder> _renderCss1 = Quark.Rounded.Full;
    private static readonly CssValue<PaddingBuilder> _renderCss2 = Quark.Padding.OnX.Is2.OnY.Token("0.5");
    private static readonly CssValue<TextSizeBuilder> _renderCss3 = Quark.TextSize.Xs;
    private static readonly CssValue<FontWeightBuilder> _renderCss4 = Quark.FontWeight.Semibold;
    private static readonly CssValue<DisplayBuilder> _renderCss5 = Quark.Display.InlineFlex;
    private static readonly CssValue<ItemsBuilder> _renderCss6 = Items.Center;
    private static readonly CssValue<TruncateBuilder> _renderCss7 = Quark.Truncate.Default;
    private static readonly CssValue<SizeBuilder> _renderCss8 = Quark.Size.Is3_5;
    private static readonly CssValue<TransitionBuilder> _renderCss9 = Quark.Transition.Transform;

    private Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;


    /// <summary>
    /// Gets or sets the compact label shown before the announcement text.
    /// </summary>
    [Parameter]
    public string? TagText { get; set; }

    /// <summary>
    /// Gets or sets custom content for the compact label shown before the announcement text.
    /// </summary>
    [Parameter]
    public RenderFragment? TagContent { get; set; }

    /// <summary>
    /// Gets or sets optional leading icon content.
    /// </summary>
    [Parameter]
    public RenderFragment? IconContent { get; set; }

    /// <summary>
    /// Gets or sets whether the trailing chevron is rendered.
    /// </summary>
    [Parameter]
    public bool ShowChevron { get; set; } = true;

    /// <summary>
    /// Gets or sets whether primary themed colors are used.
    /// </summary>
    [Parameter]
    public bool Themed { get; set; }

    /// <summary>
    /// Gets or sets the URL to navigate to.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// Gets or sets the target attribute for the link.
    /// </summary>
    [Parameter]
    public Target? Target { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        DataSlot ??= "announcement";
        Display ??= _renderCss5;
        MaxWidth ??= _staticCss1;
        ItemsAlign ??= _renderCss6;
        Gap ??= _defaultGap;
        Rounded ??= _renderCss1;
        Border ??= _defaultBorder;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Shadow ??= _defaultShadow;
        OutlineStyle ??= _defaultOutlineStyle;
        Transition ??= _defaultTransition;
        RingColor ??= _defaultRingColor;
    }



    protected override void ApplyBorderColor(ref PooledStringBuilder sty, ref PooledStringBuilder cls, CssValue<BorderColorBuilder>? value)
    {
        var borderColor = ResolvePresetValue(BorderColor, value, nameof(BorderColor)) ?? (Themed ? Quark.BorderColor.Utility("border-primary/20") : Quark.BorderColor.Border);
        base.ApplyBorderColor(ref sty, ref cls, borderColor);
    }

    protected override void ApplyBackgroundColor(ref PooledStringBuilder sty, ref PooledStringBuilder cls, CssValue<BackgroundColorBuilder>? value)
    {
        var backgroundColor = ResolvePresetValue(BackgroundColor, value, nameof(BackgroundColor)) ?? (Themed ? Quark.BackgroundColor.Utility("bg-primary/5") : Quark.BackgroundColor.Background);
        base.ApplyBackgroundColor(ref sty, ref cls, backgroundColor);
    }

    protected override void ApplyTextColor(ref PooledStringBuilder sty, ref PooledStringBuilder cls, CssValue<TextColorBuilder>? value)
    {
        var textColor = ResolvePresetValue(TextColor, value, nameof(TextColor)) ?? (Themed ? Quark.TextColor.Primary : Quark.TextColor.Foreground);
        base.ApplyTextColor(ref sty, ref cls, textColor);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(TagText);
        hc.Add(TagContent);
        hc.Add(IconContent);
        hc.Add(ShowChevron);
        hc.Add(Themed);
        hc.Add(Href);
        hc.Add(Target);
        hc.Add(OnClick.HasDelegate);
    }

    private RenderFragment? _content;
    private RenderFragment RenderContent() => _content ??=
        @<text>
             @if (TagContent is not null)
             {
                 <Span DataSlot="announcement-tag" Shrink="_renderCss0" Rounded="_renderCss1" BackgroundColor="@(Themed ? Quark.BackgroundColor.Primary : Quark.BackgroundColor.Muted)" Padding='_renderCss2' TextSize="_renderCss3" FontWeight="_renderCss4" TextColor="@(Themed ? Quark.TextColor.PrimaryForeground : Quark.TextColor.MutedForeground)">@TagContent</Span>
             }
             else if (TagText.HasContent())
             {
                 <Span DataSlot="announcement-tag" Shrink="_renderCss0" Rounded="_renderCss1" BackgroundColor="@(Themed ? Quark.BackgroundColor.Primary : Quark.BackgroundColor.Muted)" Padding='_renderCss2' TextSize="_renderCss3" FontWeight="_renderCss4" TextColor="@(Themed ? Quark.TextColor.PrimaryForeground : Quark.TextColor.MutedForeground)">@TagText</Span>
             }

             @if (IconContent is not null)
             {
                 <Span DataSlot="announcement-icon" Display="_renderCss5" Shrink="_renderCss0" ItemsAlign="_renderCss6">
                     @IconContent
                 </Span>
             }

             <Span DataSlot="announcement-text" MinWidth="_staticCss0" Truncate="_renderCss7">
                 @ChildContent
             </Span>

             @if (ShowChevron)
             {
                 <Icon Name="LucideIcon.ChevronRight" DataSlot="announcement-chevron" Size="_renderCss8" Shrink="_renderCss0" Transition="_renderCss9" Class="group-hover/announcement:translate-x-0.5 cn-rtl-flip" aria-hidden="true"/>
             }
    </text>;

    private Task HandleClick(MouseEventArgs args)
    {
        return OnClick.HasDelegate ? OnClick.InvokeAsync(args) : Task.CompletedTask;
    }

}
