@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (Tooltip.HasContent())
{
    <div @attributes="BuildAttributes()">
        <TooltipProvider DelayDuration="200">
            <Tooltip>
                <TooltipTrigger AsChild="true">
                    @ChildContent
                </TooltipTrigger>
                <TooltipContent Side="@TooltipSide" Rounded="_renderCss0">
                    @Tooltip
                </TooltipContent>
            </Tooltip>
        </TooltipProvider>
    </div>
}
else
{
    <div @attributes="BuildAttributes()">@ChildContent</div>
}

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsFull;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Items.Center;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.FromLeft.Default;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2;
    private static readonly CssValue<RoundedBuilder> _renderCss0 = Quark.Rounded.Full;
    [Parameter]
    public string? Tooltip { get; set; }

    [Parameter]
    public Bradix.Side TooltipSide { get; set; } = Bradix.Side.Top;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "feedback-bar-close";

        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        ItemsAlign ??= _defaultItemsAlign;
        Justify ??= _defaultJustify;
        Border ??= _defaultBorder;
        Padding ??= _defaultPadding;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Tooltip);
        hc.Add(TooltipSide);
    }
}
