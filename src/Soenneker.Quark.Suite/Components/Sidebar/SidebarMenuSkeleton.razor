@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">
    @if (ShowIcon)
    {
        <Skeleton Size="_renderCss0" Rounded="_renderCss1" data-sidebar="menu-skeleton-icon" />
    }
    <Skeleton @attributes="BuildTextSkeletonAttributes()" />
</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is8;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<RoundedBuilder> _renderCss1 = Quark.Rounded.Md;

    private Dictionary<string, object>? _textSkeletonAttributes;
    [Parameter]
    public bool ShowIcon { get; set; }

    private int _width;

    protected override void OnInitialized()
    {
        _width = Random.Shared.Next(50, 90);
        base.OnInitialized();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sidebar-menu-skeleton";

        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Rounded ??= _renderCss1;
        Padding ??= _defaultPadding;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-sidebar"] = "menu-skeleton";
    }

    private Dictionary<string, object> BuildTextSkeletonAttributes() => _textSkeletonAttributes ??= new Dictionary<string, object>
    {
        ["data-sidebar"] = "menu-skeleton-text",
        ["class"] = "h-4 max-w-(--skeleton-width) flex-1",
        ["style"] = $"--skeleton-width: {_width}%"
    };

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShowIcon);
        hc.Add(_width);
    }
}