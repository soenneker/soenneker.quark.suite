@namespace Soenneker.Quark
@using System.Globalization
@using Microsoft.JSInterop
@inject Soenneker.Blazor.Utils.LocalStorage.Abstract.ILocalStorageUtil LocalStorageUtil
@using Soenneker.Quark.Dtos
@using Soenneker.Bradix
@inherits Soenneker.Quark.Element

@if (ShouldRenderMobileSidebar)
{
    <Sheet Visible="State?.OpenMobile == true" VisibleChanged="OnMobileVisibleChanged" ShowBackdrop="MobileShowBackdrop" CloseOnBackdropClick="@ResolvedMobileCloseOnBackdropClick" CloseOnEscape="MobileCloseOnEscape" LockScroll="MobileLockScroll" TrapFocus="@ResolvedMobileTrapFocus">
        <SheetContent Side="@ToSheetSide(Side)" KeepMounted="MobileKeepMounted" ShowCloseButton="MobileShowCloseButton" ContainerClass="@GetMobileContainerClass()" ContainerStyle="@GetMobileContainerStyle()" OverlayClass="@MobileOverlayClass" OverlayStyle="@GetMobileOverlayStyle()" @attributes="BuildMobileAttributes()">
            <SheetHeader ScreenReader="Quark.ScreenReader.Only">
                <SheetTitle>Sidebar</SheetTitle>
                <SheetDescription>Displays the mobile sidebar.</SheetDescription>
            </SheetHeader>
            <Div Display="Quark.Display.Flex" Height="Quark.Height.IsFull" Width="Quark.Width.IsFull" FlexDirection="Quark.FlexDirection.Col">
                @if (IsNavigationShell(Shell))
                {
                    <Div Display="Quark.Display.Flex" Flex="Quark.Flex.Is1" FlexDirection="Quark.FlexDirection.Col" Gap="Quark.Gap.Is12" BackgroundColor="Quark.BackgroundColor.Background" Padding="Quark.Padding.Is6" Class="no-scrollbar min-h-0 overflow-y-auto">
                        @RenderMobileBody()
                    </Div>
                }
                else
                {
                    @RenderMobileBody()
                }
            </Div>
        </SheetContent>
    </Sheet>
}
else if (IsNoneCollapsible(Collapsible))
{
    <aside @attributes="BuildStaticAttributes()">
        @if (IsNavigationShell(Shell))
        {
            <Div Height="Quark.Height.Is9" Class="hidden lg:block"></Div>
            <Div Position="Quark.Position.Absolute" Top="Quark.Top.Is12" Right="Quark.Right.Is2" Bottom="Quark.Bottom.Is0" Height="Quark.Height.IsFull" Class="hidden w-px bg-linear-to-b from-transparent via-border to-transparent lg:flex"></Div>
        }

        @ChildContent
        @ResizeHandle
    </aside>
}
else
{
    <Div @attributes="BuildAttributes()">
        <Div @attributes="BuildGapAttributes()"></Div>
        <aside @attributes="BuildContainerAttributes()">
            <Div @attributes="BuildInnerAttributes()">
                @ChildContent
            </Div>
            @ResizeHandle
        </aside>
    </Div>
}

@code {
    private static readonly IReadOnlyDictionary<string, object> InnerAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "sidebar-inner",
        ["data-sidebar"] = "sidebar",
        ["class"] = "flex size-full flex-col bg-sidebar group-data-[variant=floating]:rounded-lg group-data-[variant=floating]:shadow-sm group-data-[variant=floating]:ring-1 group-data-[variant=floating]:ring-sidebar-border"
    };

    private RenderFragment? _mobileBody;
    private QuarkAttributeDictionary _rootAttributeDictionaries;
    private QuarkAttributeDictionary _gapAttributeDictionaries;
    private QuarkAttributeDictionary _containerAttributeDictionaries;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sidebar";
    }


    [Parameter]
    public SidebarSide Side { get; set; } = SidebarSide.Left;

    [Parameter]
    public SidebarVariant Variant { get; set; } = SidebarVariant.Sidebar;

    [Parameter]
    public SidebarShell Shell { get; set; } = SidebarShell.Default;

    [Parameter]
    public SidebarCollapsible Collapsible { get; set; } = SidebarCollapsible.Offcanvas;

    /// <summary>Enables a desktop drag handle and keyboard resizing of the expanded sidebar.</summary>
    [Parameter]
    public bool Resizable { get; set; }

    /// <summary>Minimum expanded width in pixels when resizing. Defaults to 192.</summary>
    [Parameter]
    public double MinResizeWidth { get; set; } = 192;

    /// <summary>Maximum expanded width in pixels when resizing. Defaults to 480.</summary>
    [Parameter]
    public double MaxResizeWidth { get; set; } = 480;

    /// <summary>Expanded width in pixels. Null uses the provider's SidebarWidth until resized. Supports two-way binding.</summary>
    [Parameter]
    public double? ExpandedWidth { get; set; }

    /// <summary>Called when a saved width is restored, a drag completes, or the width is changed with the keyboard, in pixels.</summary>
    [Parameter]
    public EventCallback<double?> ExpandedWidthChanged { get; set; }

    /// <summary>Optional localStorage key for the expanded width. A saved width is restored when desktop resizing first becomes available and takes precedence over the initial ExpandedWidth. Use a unique key per sidebar; null disables persistence.</summary>
    [Parameter]
    public string? ResizeStorageKey { get; set; }

    private bool CanResize => Resizable && State?.IsMobile != true && !ShouldRenderMobileSidebar &&
        (IsNoneCollapsible(Collapsible) || !IsCollapsed);

    private RenderFragment ResizeHandle => @<text>
        @if (CanResize)
        {
            <SidebarResizeHandle MinWidth="MinResizeWidth" MaxWidth="MaxResizeWidth" RightSide="IsRightSide(Side)"
                                 WidthChanged="OnResizeWidthChanged" />
        }
    </text>;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!double.IsFinite(MinResizeWidth) || MinResizeWidth <= 0 ||
            !double.IsFinite(MaxResizeWidth) || MaxResizeWidth < MinResizeWidth)
            throw new ArgumentOutOfRangeException(nameof(MinResizeWidth), "Resize widths must be finite, positive, and ordered.");
        if (ExpandedWidth.HasValue && (!double.IsFinite(ExpandedWidth.Value) || ExpandedWidth.Value <= 0))
            throw new ArgumentOutOfRangeException(nameof(ExpandedWidth));
    }

    private string? _restoredStorageKey;
    private long _widthRevision;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        var key = string.IsNullOrWhiteSpace(ResizeStorageKey) ? null : ResizeStorageKey;
        if (key is null)
        {
            _restoredStorageKey = null;
            return;
        }
        if (!CanResize || _restoredStorageKey == key)
            return;
        _restoredStorageKey = key;
        var revision = _widthRevision;
        var initialWidth = ExpandedWidth;
        string? saved;
        try { saved = await LocalStorageUtil.Get(key); }
        catch (JSException) { return; }
        catch (OperationCanceledException) { return; }
        if (key != ResizeStorageKey || revision != _widthRevision || initialWidth != ExpandedWidth || !CanResize)
        {
            if (!CanResize && _restoredStorageKey == key)
                _restoredStorageKey = null;
            return;
        }
        if (!double.TryParse(saved, NumberStyles.Float, CultureInfo.InvariantCulture, out var width) || !double.IsFinite(width) || width <= 0)
            return;
        ExpandedWidth = Math.Clamp(width, MinResizeWidth, MaxResizeWidth);
        await ExpandedWidthChanged.InvokeAsync(ExpandedWidth);
        Refresh();
    }

    private async Task OnResizeWidthChanged(double width)
    {
        if (!CanResize)
            return;
        _widthRevision++;
        ExpandedWidth = Math.Clamp(width, MinResizeWidth, MaxResizeWidth);
        if (!string.IsNullOrWhiteSpace(ResizeStorageKey))
        {
            try { await LocalStorageUtil.Set(ResizeStorageKey, ExpandedWidth.Value.ToString(CultureInfo.InvariantCulture)); }
            catch (JSException) { }
            catch (OperationCanceledException) { }
        }
        await ExpandedWidthChanged.InvokeAsync(ExpandedWidth);
    }

    private void ApplyResizeAttributes(Dictionary<string, object> attributes)
    {
        attributes["data-sidebar-resize-root"] = "";
        if (ExpandedWidth is { } width)
        {
            var value = (Resizable ? Math.Clamp(width, MinResizeWidth, MaxResizeWidth) : width)
                .ToString(System.Globalization.CultureInfo.InvariantCulture);
            attributes["style"] = CombineStyleDecls(attributes.TryGetValue("style", out var style) ? style?.ToString() : null,
                $"--sidebar-width: {value}px;")!;
        }
    }

    [Parameter]
    public bool Contained { get; set; }

    [Parameter]
    public SidebarMobileMode MobileMode { get; set; } = SidebarMobileMode.Auto;

    [Parameter]
    public string? Dir { get; set; }

    [CascadingParameter(Name = "DirectionProviderDir")]
    public string? DirectionProviderDir { get; set; }

    [Parameter]
    public bool MobileCloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public bool MobileShowBackdrop { get; set; } = true;

    [Parameter]
    public bool MobileCloseOnEscape { get; set; } = true;

    [Parameter]
    public bool MobileLockScroll { get; set; } = true;

    [Parameter]
    public bool MobileShowCloseButton { get; set; }

    [Parameter]
    public bool? MobileTrapFocus { get; set; }

    /// <summary>
    /// Keeps the mobile content rendered while closed when mobile focus trapping is disabled.
    /// </summary>
    [Parameter]
    public bool MobileKeepMounted { get; set; }

    [Parameter]
    public string? MobileClass { get; set; }

    [Parameter]
    public string? MobileStyle { get; set; }

    [Parameter]
    public string? MobileOffsetTop { get; set; }

    [Parameter]
    public string? MobileContainerClass { get; set; }

    [Parameter]
    public string? MobileContainerStyle { get; set; }

    [Parameter]
    public string? MobileOverlayClass { get; set; }

    [Parameter]
    public string? MobileOverlayStyle { get; set; }

    [Parameter]
    public RenderFragment? MobileTopContent { get; set; }

    [Parameter]
    public RenderFragment? MobileContent { get; set; }

    [CascadingParameter(Name = "SidebarProvider")]
    public SidebarProvider? SidebarProvider { get; set; }

    [CascadingParameter(Name = "SidebarContextState")]
    public SidebarContextState? State { get; set; }

    private static bool IsRightSide(SidebarSide? side) => ReferenceEquals(side, SidebarSide.Right);
    private static bool IsNavigationShell(SidebarShell? shell) => ReferenceEquals(shell, SidebarShell.Navigation);
    private static bool IsNoneCollapsible(SidebarCollapsible? collapsible) => ReferenceEquals(collapsible, SidebarCollapsible.None);
    private static bool IsAutoMobileMode(SidebarMobileMode? mode) => ReferenceEquals(mode, SidebarMobileMode.Auto);
    private static bool IsHiddenMobileMode(SidebarMobileMode? mode) => ReferenceEquals(mode, SidebarMobileMode.Hidden);
    private static bool IsFullScreenMobileMode(SidebarMobileMode? mode) => ReferenceEquals(mode, SidebarMobileMode.FullScreen);
    private static bool IsFloatingLikeVariant(SidebarVariant? variant) => ReferenceEquals(variant, SidebarVariant.Floating) || ReferenceEquals(variant, SidebarVariant.Inset);

    private static string ToDataSide(SidebarSide? side) => IsRightSide(side) ? "right" : "left";

    private static Side ToSheetSide(SidebarSide? side) => IsRightSide(side) ? Soenneker.Bradix.Side.Right : Soenneker.Bradix.Side.Left;

    private static string ToDataVariant(SidebarVariant? variant)
    {
        if (ReferenceEquals(variant, SidebarVariant.Floating))
            return "floating";

        if (ReferenceEquals(variant, SidebarVariant.Inset))
            return "inset";

        return "sidebar";
    }

    private static string ToDataCollapsible(SidebarCollapsible? collapsible)
    {
        if (ReferenceEquals(collapsible, SidebarCollapsible.Icon))
            return "icon";

        if (IsNoneCollapsible(collapsible))
            return "none";

        return "offcanvas";
    }

    private static string ToDataMobileMode(SidebarMobileMode? mode)
    {
        if (IsHiddenMobileMode(mode))
            return "hidden";

        if (ReferenceEquals(mode, SidebarMobileMode.Sheet))
            return "sheet";

        if (IsFullScreenMobileMode(mode))
            return "full-screen";

        return "auto";
    }

    private static string ToDataShell(SidebarShell? shell) => IsNavigationShell(shell) ? "navigation" : "default";

    private bool IsCollapsed => State is not null && !State.Open;

    private string? ResolvedDir => Dir.HasContent() ? Dir : DirectionProviderDir;

    private SidebarMobileMode ResolvedMobileMode
    {
        get
        {
            var mode = MobileMode ?? SidebarMobileMode.Auto;
            return IsAutoMobileMode(mode) ? IsNoneCollapsible(Collapsible) ? SidebarMobileMode.Hidden : SidebarMobileMode.Sheet : mode;
        }
    }

    private bool ShouldRenderMobileSidebar => (State?.IsMobile == true || State?.OpenMobile == true) && !IsHiddenMobileMode(ResolvedMobileMode);

    private bool ResolvedMobileTrapFocus => MobileTrapFocus ?? MobileShowBackdrop;

    private bool ResolvedMobileCloseOnBackdropClick => MobileShowBackdrop && MobileCloseOnBackdropClick;

    private Task OnMobileVisibleChanged(bool visible)
    {
        return SidebarProvider?.SetOpenMobile(visible) ?? Task.CompletedTask;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        ApplyResizeAttributes(attributes);
        attributes["data-side"] = ToDataSide(Side);
        attributes["data-variant"] = ToDataVariant(Variant);
        attributes["data-shell"] = ToDataShell(Shell);
        attributes["data-state"] = IsCollapsed ? "collapsed" : "expanded";
        attributes["data-collapsible"] = IsCollapsed ? ToDataCollapsible(Collapsible) : "";

        if (ResolvedDir.HasContent())
            attributes["dir"] = ResolvedDir!;

        BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "group peer hidden text-sidebar-foreground md:block");

            if (Contained)
                AppendClass(ref cls, "relative");
        });
    }

    private Dictionary<string, object> BuildStaticAttributes()
    {
        var attributes = BuildRootAttributes(12);
        attributes["data-slot"] = DataSlot!;
        attributes["data-sidebar"] = "sidebar";
        attributes["data-side"] = ToDataSide(Side);
        attributes["data-variant"] = ToDataVariant(Variant);
        attributes["data-shell"] = ToDataShell(Shell);
        attributes["data-state"] = State?.State ?? "expanded";
        attributes["data-collapsible"] = "none";
        ApplyResizeAttributes(attributes);

        if (ResolvedDir.HasContent())
            attributes["dir"] = ResolvedDir!;

        BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, IsNavigationShell(Shell) ? "group peer hidden h-full w-(--sidebar-width) flex-col bg-sidebar text-sidebar-foreground lg:flex" : "group peer flex h-full w-(--sidebar-width) flex-col bg-sidebar text-sidebar-foreground");

            if (Resizable && !IsNavigationShell(Shell))
                AppendClass(ref cls, "relative shrink-0");

            if (IsNavigationShell(Shell))
                AppendClass(ref cls, "sticky self-start shrink-0 overflow-hidden [--sidebar-menu-width:--spacing(56)] lg:bg-transparent");
        });

        if (IsNavigationShell(Shell))
        {
            const string navigationShellStyle = "top: var(--header-height, 0px); height: calc(100svh - var(--header-height, 0px)); max-height: calc(100svh - var(--header-height, 0px));";
            attributes["style"] = CombineStyleDecls(navigationShellStyle, attributes.TryGetValue("style", out var style) ? style?.ToString() : null)!;
        }

        return attributes;
    }

    private Dictionary<string, object> BuildMobileAttributes()
    {
        var attributes = BuildRootAttributes(15);
        if (SidebarProvider is not null)
            attributes["id"] = SidebarProvider.MobileContentId;
        attributes["data-slot"] = DataSlot!;
        attributes["data-sidebar"] = "sidebar";
        attributes["data-mobile"] = "true";
        attributes["data-mobile-mode"] = ToDataMobileMode(ResolvedMobileMode);
        attributes["data-side"] = ToDataSide(Side);
        attributes["data-variant"] = ToDataVariant(Variant);
        attributes["data-shell"] = ToDataShell(Shell);
        attributes["data-state"] = State?.OpenMobile == true ? "expanded" : "collapsed";

        if (ResolvedDir.HasContent())
            attributes["dir"] = ResolvedDir!;

        BuildClassAndStyleAttributes(attributes, (ref cls, ref sty) =>
        {
            AppendClass(ref cls, "group w-(--sidebar-width) bg-sidebar p-0 text-sidebar-foreground");
            AppendStyleDecl(ref sty, "--sidebar-width: var(--sidebar-width-mobile)");

            if (MobileOffsetTop.HasContent())
            {
                AppendStyleDecl(ref sty, $"top: {MobileOffsetTop}");
                AppendStyleDecl(ref sty, $"height: calc(100svh - {MobileOffsetTop})");
            }

            if (!MobileShowCloseButton)
                AppendClass(ref cls, "[&>button]:hidden");

            if (IsFullScreenMobileMode(ResolvedMobileMode))
                AppendClass(ref cls, "inset-0 h-svh w-screen! max-w-none! rounded-none border-0 sm:max-w-none!");

            if (IsNavigationShell(Shell))
                AppendClass(ref cls, "gap-0 border-none bg-background/90 shadow-none backdrop-blur");

            if (MobileClass.HasContent())
                AppendClass(ref cls, MobileClass!);

            if (MobileStyle.HasContent())
                AppendStyleDecl(ref sty, MobileStyle!);
        });

        return attributes;
    }

    private string? GetMobileContainerClass()
    {
        if (!IsNavigationShell(Shell))
            return MobileContainerClass;

        return MobileContainerClass.HasContent()
            ? AppendToClass("z-40", MobileContainerClass!)
            : "z-40";
    }

    private string? GetMobileContainerStyle()
    {
        if (!MobileOffsetTop.HasContent())
            return MobileContainerStyle;

        return CombineStyleDecls($"top: {MobileOffsetTop};", MobileContainerStyle);
    }

    private string? GetMobileOverlayStyle()
    {
        if (!MobileOffsetTop.HasContent())
            return MobileOverlayStyle;

        return CombineStyleDecls($"top: {MobileOffsetTop};", MobileOverlayStyle);
    }

    private static string? CombineStyleDecls(string? first, string? second)
    {
        var hasFirst = first.HasContent();
        var hasSecond = second.HasContent();

        if (!hasFirst && !hasSecond)
            return null;

        if (!hasFirst)
            return second;

        if (!hasSecond)
            return first;

        return $"{first} {second}";
    }

    private RenderFragment RenderMobileBody() => _mobileBody ??= builder =>
    {
        if (MobileContent is not null)
        {
            builder.AddContent(0, MobileContent);
            return;
        }

        if (MobileTopContent is not null)
            builder.AddContent(1, MobileTopContent);

        builder.AddContent(2, ChildContent);
    };

    private Dictionary<string, object> BuildGapAttributes()
    {
        var attributes = _gapAttributeDictionaries.Create(8);
        attributes["data-slot"] = "sidebar-gap";

        BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "relative w-(--sidebar-width) bg-transparent transition-[width] duration-200 ease-linear");
            AppendClass(ref cls, "group-data-[collapsible=offcanvas]:w-0");
            AppendClass(ref cls, "group-data-[side=right]:rotate-180");

            if (IsFloatingLikeVariant(Variant))
                AppendClass(ref cls, "group-data-[collapsible=icon]:w-[calc(var(--sidebar-width-icon)+(--spacing(4)))]");
            else
                AppendClass(ref cls, "group-data-[collapsible=icon]:w-(--sidebar-width-icon)");
        });

        return attributes;
    }

    private Dictionary<string, object> BuildContainerAttributes()
    {
        var attributes = _containerAttributeDictionaries.Create(10);
        attributes["data-slot"] = "sidebar-container";
        attributes["data-side"] = ToDataSide(Side);

        BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, Contained
                ? "absolute inset-y-0 z-10 hidden h-full w-(--sidebar-width) transition-[left,right,width] duration-200 ease-linear data-[side=left]:left-0 data-[side=left]:group-data-[collapsible=offcanvas]:left-[calc(var(--sidebar-width)*-1)] data-[side=right]:right-0 data-[side=right]:group-data-[collapsible=offcanvas]:right-[calc(var(--sidebar-width)*-1)] md:flex"
                : "fixed inset-y-0 z-10 hidden h-svh w-(--sidebar-width) transition-[left,right,width] duration-200 ease-linear data-[side=left]:left-0 data-[side=left]:group-data-[collapsible=offcanvas]:left-[calc(var(--sidebar-width)*-1)] data-[side=right]:right-0 data-[side=right]:group-data-[collapsible=offcanvas]:right-[calc(var(--sidebar-width)*-1)] md:flex");

            if (IsFloatingLikeVariant(Variant))
                AppendClass(ref cls, "p-2 group-data-[collapsible=icon]:w-[calc(var(--sidebar-width-icon)+(--spacing(4))+2px)]");
            else
                AppendClass(ref cls, "group-data-[collapsible=icon]:w-(--sidebar-width-icon) group-data-[side=left]:border-r group-data-[side=right]:border-l");
        });

        return attributes;
    }

    private static IReadOnlyDictionary<string, object> BuildInnerAttributes() => InnerAttributes;

    private Dictionary<string, object> BuildRootAttributes(int capacity)
    {
        var attributes = _rootAttributeDictionaries.Create(capacity + (Attributes?.Count ?? 0));
        base.BuildOwnedAttributes(attributes);

        var cls = new PooledStringBuilder(64);
        var sty = new PooledStringBuilder(128);

        try
        {
            base.BuildOwnedClassAndStyle(ref sty, ref cls);

            if (Attributes is not null)
            {
                foreach (var kv in Attributes)
                {
                    if (kv.Key.Equals("class", StringComparison.OrdinalIgnoreCase))
                    {
                        if (kv.Value is not null)
                            AppendClass(ref cls, kv.Value.ToString()!);

                        continue;
                    }

                    if (kv.Key.Equals("style", StringComparison.OrdinalIgnoreCase))
                    {
                        if (kv.Value is not null)
                            AppendStyleDecl(ref sty, kv.Value.ToString()!);

                        continue;
                    }

                    attributes[kv.Key] = kv.Value!;
                }
            }

            if (cls.Length > 0)
                attributes["class"] = cls.ToString();

            if (sty.Length > 0)
                attributes["style"] = sty.ToString();

            return attributes;
        }
        finally
        {
            cls.Dispose();
            sty.Dispose();
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ResizeStorageKey);
        hc.Add(Resizable);
        hc.Add(MinResizeWidth);
        hc.Add(MaxResizeWidth);
        hc.Add(ExpandedWidth);
        hc.Add(Side);
        hc.Add(Variant);
        hc.Add(Shell);
        hc.Add(Collapsible);
        hc.Add(Contained);
        hc.Add(MobileMode);
        hc.Add(Dir);
        hc.Add(DirectionProviderDir);
        hc.Add(MobileCloseOnBackdropClick);
        hc.Add(MobileShowBackdrop);
        hc.Add(MobileCloseOnEscape);
        hc.Add(MobileLockScroll);
        hc.Add(MobileShowCloseButton);
        hc.Add(MobileTrapFocus);
        hc.Add(MobileKeepMounted);
        hc.Add(MobileClass);
        hc.Add(MobileStyle);
        hc.Add(MobileOffsetTop);
        hc.Add(MobileContainerClass);
        hc.Add(MobileContainerStyle);
        hc.Add(MobileOverlayClass);
        hc.Add(MobileOverlayStyle);
        hc.Add(MobileTopContent is not null);
        hc.Add(MobileContent is not null);
        hc.Add(State?.Open);
        hc.Add(State?.OpenMobile);
        hc.Add(State?.IsMobile);
    }

}
