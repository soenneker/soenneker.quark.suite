@namespace Soenneker.Quark
@using Soenneker.Quark.Dtos
@inherits Soenneker.Quark.Element

<button @onclick="(_cachedHandleRailClickDelegate ??= HandleRailClick)" @attributes="BuildAttributes()">
    @if (ShowTrigger)
    {
        <span @attributes="BuildTriggerAttributes()">
            @if (ChildContent is null)
            {
                <Svg Size="_renderCss0" Class="cn-rtl-flip" ViewBox="0 0 24 24" Fill="_renderCss1" Stroke='_renderCss2' StrokeWidth="_renderCss3" StrokeLineCap="_renderCss4" StrokeLineJoin="_renderCss5" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <path d="M9 3v18"></path>
                </Svg>
            }
            else
            {
                @ChildContent
            }
        </span>
    }
</button>

@code {
    private string? _triggerStyle;
    private (string Top, bool Open)? _triggerStyleKey;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<FillBuilder> _renderCss1 = Quark.Fill.None;
    private static readonly CssValue<StrokeBuilder> _renderCss2 = Quark.Stroke.Current;
    private static readonly CssValue<StrokeWidthBuilder> _renderCss3 = Quark.StrokeWidth.Is2;
    private static readonly CssValue<StrokeLineCapBuilder> _renderCss4 = Quark.StrokeLineCap.Round;
    private static readonly CssValue<StrokeLineJoinBuilder> _renderCss5 = Quark.StrokeLineJoin.Round;
    private string? _lastBuiltClass;
    private string? _lastBuiltClass2;

    private Func<MouseEventArgs, Task>? _cachedHandleRailClickDelegate;

    private QuarkAttributeDictionary _triggerAttributesBuffer;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sidebar-rail";
    }

    [CascadingParameter(Name = "SidebarProvider")]
    public SidebarProvider? SidebarProvider { get; set; }

    [CascadingParameter(Name = "SidebarContextState")]
    public SidebarContextState? State { get; set; }

    [Parameter]
    public bool ShowTrigger { get; set; }

    [Parameter]
    public string TriggerTop { get; set; } = "1rem";

    [Parameter]
    public string? TriggerClass { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private async Task HandleRailClick(MouseEventArgs args)
    {
        if (SidebarProvider is not null)
            await SidebarProvider.ToggleSidebar();

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-sidebar"] = "rail";
        attributes["type"] = "button";
        attributes["aria-label"] = "Toggle Sidebar";
        attributes["title"] = "Toggle Sidebar";
        attributes["aria-expanded"] = State?.Open == true ? "true" : "false";

        if (!ShowTrigger)
            attributes["tabindex"] = QuarkAttributeValues.MinusOne;

        const string prefix = "absolute inset-y-0 z-20 hidden w-4 cursor-default transition-all ease-linear group-data-[side=left]:-right-4 group-data-[side=right]:-left-4 after:absolute after:inset-y-0 after:w-[2px] group-data-[side=left]:after:left-0 group-data-[side=right]:after:right-0 hover:after:bg-sidebar-border sm:flex hover:group-data-[collapsible=offcanvas]:bg-sidebar";
        PrependClassAttribute(attributes, ShowTrigger ? prefix + " focus-visible:outline-none focus-visible:[&>[data-sidebar=rail-trigger]]:ring-2 focus-visible:[&>[data-sidebar=rail-trigger]]:ring-sidebar-ring" : prefix, ref _lastBuiltClass);
    }

    private Dictionary<string, object> BuildTriggerAttributes()
    {
        var attributes = _triggerAttributesBuffer.Create(4);
        attributes["data-sidebar"] = "rail-trigger";
        attributes["aria-hidden"] = "true";
        var key = (TriggerTop, State?.Open == true);
        if (_triggerStyle is null || _triggerStyleKey != key)
        {
            _triggerStyle = $"top: {TriggerTop}; --sidebar-rail-trigger-offset: {(key.Item2 ? "2.75rem" : "1rem")};";
            _triggerStyleKey = key;
        }
        attributes["style"] = _triggerStyle;

        const string prefix = "absolute flex size-7 items-center justify-center rounded-md border border-sidebar-border bg-sidebar text-sidebar-foreground shadow-xs transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground [&_svg]:size-4 [&_svg]:shrink-0 group-data-[side=left]:right-(--sidebar-rail-trigger-offset) group-data-[side=right]:left-(--sidebar-rail-trigger-offset) group-data-[state=collapsed]:pointer-events-none group-data-[state=collapsed]:opacity-0 group-hover:pointer-events-auto! group-hover:opacity-100!";
        attributes["class"] = TriggerClass.HasContent() ? QuarkStringCache.Concat(prefix, " ", TriggerClass!, ref _lastBuiltClass2) : prefix;

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(State?.Open);
        hc.Add(ShowTrigger);
        hc.Add(TriggerTop);
        hc.Add(TriggerClass);
        hc.Add(ChildContent is not null);
    }
}
