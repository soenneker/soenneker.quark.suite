@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div role="separator" @attributes="BuildAttributes()"></div>

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.OnX.Is2;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsPx;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.Auto;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Utility("bg-sidebar-border");
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sidebar-separator";

        Margin ??= _defaultMargin;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        BackgroundColor ??= _defaultBackgroundColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-sidebar"] = "separator";
        attributes["aria-orientation"] = "horizontal";
    }
}