@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@using Microsoft.AspNetCore.Components.Routing
@using Soenneker.Quark.Dtos

@if (AsChild)
{
    <CascadingValue Name="@SlotAttributes.Name" Value="BuildSlotAttributes()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else if (ShouldRenderNavLink)
{
    <NavLink href="@Href"
             Match="@Match"
             ActiveClass="@_activeClass"
             @onclick="(_cachedHandleActivateDelegate ??= HandleActivate)"
             @attributes="BuildAttributes()">
        @ChildContent
    </NavLink>
}
else if (Href.HasContent())
{
    <Anchor Href="@Href"
            Target="@Target"
            @onclick="(_cachedHandleActivateDelegate ??= HandleActivate)"
            @attributes="BuildAttributes()">
        @ChildContent
    </Anchor>
}
else
{
    <button @ref="_elementRef"
            @onclick="(_cachedHandleActivateDelegate ??= HandleActivate)"
            @onclick:stopPropagation="StopClickPropagation"
            @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
            @attributes="BuildAttributes()">
        @RenderChildContent()
    </button>
}

@code {
    private (string Size, string Variant, string? BaseClass)? _buttonClassKey;
    private string? _navigationHref;
    private bool _relativeNavigationHref;

    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is2;
    private static readonly CssValue<WidthBuilder> _defaultWidth2 = Quark.Width.IsFull;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow2 = Quark.Overflow.Hidden;
    private static readonly CssValue<TextAlignBuilder> _defaultTextAlign = Quark.TextAlign.Left;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.Utility("ring-sidebar-ring");
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Token("transition-[width,height,padding]");
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor2 = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Background;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<HeightBuilder> _defaultHeight4 = Quark.Height.Token("[30px]");
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFit;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Visible;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Transparent;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize3 = Quark.TextSize.Token("[0.8rem]");
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<HeightBuilder> _defaultHeight3 = Quark.Height.Is7;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize2 = Quark.TextSize.Xs;
    private static readonly CssValue<HeightBuilder> _defaultHeight2 = Quark.Height.Is12;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is8;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private string? _lastBuiltClass;

    private System.Func<MouseEventArgs, Task>? _cachedHandleActivateDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    [Parameter]
    public SidebarMenuButtonVariant Variant { get; set; } = SidebarMenuButtonVariant.Default;

    [Parameter]
    public SidebarMenuButtonSize ButtonSize { get; set; } = SidebarMenuButtonSize.Default;

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public Target? Target { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }

    [Parameter]
    public NavLinkMatch Match { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [CascadingParameter(Name = "SidebarProvider")]
    public SidebarProvider? SidebarProvider { get; set; }

    [CascadingParameter(Name = "SidebarContextState")]
    public SidebarContextState? State { get; set; }

    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? TriggerContext { get; set; }

    private RenderFragment? _triggerChildContent;
    private ElementReference _elementRef;
    private bool _triggerElementRegistered;
    private string? _registeredTriggerId;

    private const string _activeClass = "bg-sidebar-accent text-sidebar-accent-foreground font-medium";

    private bool StopClickPropagation => TriggerContext?.Toggle is not null;

    private static readonly TriggerContext? NoChildTriggerContext = null;

    private bool ShowCollapsedTooltip =>
        Tooltip.HasContent() &&
        State?.IsMobile != true &&
        State?.Open == false;

    private bool ShouldRenderNavLink
    {
        get
        {
            if (!Href.HasContent() || Target is not null || Href!.StartsWith('#')) return false;
            if (_navigationHref != Href)
            {
                _relativeNavigationHref = !Uri.TryCreate(Href, UriKind.Absolute, out _);
                _navigationHref = Href;
            }
            return _relativeNavigationHref;
        }
    }

    private static string GetVariantClass(SidebarMenuButtonVariant variant)
    {
        if (ReferenceEquals(variant, SidebarMenuButtonVariant.Outline))
            return "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground hover:shadow-[0_0_0_1px_hsl(var(--sidebar-accent))]";

        if (ReferenceEquals(variant, SidebarMenuButtonVariant.Navigation))
            return "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground after:absolute after:inset-x-0 after:-inset-y-1 after:z-0 after:rounded-md data-[active=true]:border-accent data-[active=true]:bg-accent 3xl:fixed:w-full 3xl:fixed:max-w-48";

        return "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground";
    }

    private static string GetSizeClass(SidebarMenuButtonSize size)
    {
        if (ReferenceEquals(size, SidebarMenuButtonSize.Lg))
            return "group-data-[collapsible=icon]:p-0!";

        return "";
    }

    private static string GetDataSize(SidebarMenuButtonSize size)
    {
        if (ReferenceEquals(size, SidebarMenuButtonSize.Sm))
            return "sm";

        if (ReferenceEquals(size, SidebarMenuButtonSize.Lg))
            return "lg";

        return "default";
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "sidebar-menu-button";

        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        Width ??= _defaultWidth2;
        Overflow ??= _defaultOverflow2;
        TextAlign ??= _defaultTextAlign;
        RingColor ??= _defaultRingColor;
        OutlineStyle ??= _defaultOutlineStyle;
        Transition ??= _defaultTransition;
        BackgroundColor ??= _defaultBackgroundColor2;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;

        if (ReferenceEquals(Variant, SidebarMenuButtonVariant.Outline))
        {
            ApplySizeDefaults();
            BackgroundColor ??= _defaultBackgroundColor;
            Shadow ??= "shadow-[0_0_0_1px_hsl(var(--sidebar-border))]";
        }
        else if (ReferenceEquals(Variant, SidebarMenuButtonVariant.Navigation))
        {
            Position ??= _defaultPosition;
            Height ??= _defaultHeight4;
            Width ??= _defaultWidth;
            Overflow ??= _defaultOverflow;
            Border ??= _defaultBorder;
            BorderColor ??= _defaultBorderColor;
            TextSize ??= _defaultTextSize3;
            FontWeight ??= _defaultFontWeight;
        }
        else
        {
            ApplySizeDefaults();
        }
    }

    private void ApplySizeDefaults()
    {
        if (ReferenceEquals(ButtonSize, SidebarMenuButtonSize.Sm))
        {
            Height ??= _defaultHeight3;
            TextSize ??= _defaultTextSize2;
        }
        else if (ReferenceEquals(ButtonSize, SidebarMenuButtonSize.Lg))
        {
            Height ??= _defaultHeight2;
            TextSize ??= _defaultTextSize;
        }
        else
        {
            Height ??= _defaultHeight;
            TextSize ??= _defaultTextSize;
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var triggerDataState = TriggerContext?.DataState;
        attributes["data-sidebar"] = "menu-button";
        attributes["data-size"] = GetDataSize(ButtonSize);
        attributes["data-state"] = triggerDataState ?? (Open ? "open" : "closed");

        attributes["data-active"] = Active ? "true" : "false";

        if (TriggerContext?.TriggerId is not null && !attributes.ContainsKey("id"))
            attributes["id"] = TriggerContext.TriggerId;

        if (TriggerContext?.AriaHasPopup is not null)
            attributes["aria-haspopup"] = TriggerContext.AriaHasPopup;

        if (TriggerContext?.AriaControls is not null)
        {
            attributes["aria-expanded"] = TriggerContext.IsOpen ? "true" : "false";
            attributes["aria-controls"] = TriggerContext.AriaControls;
        }
        else if (Open)
        {
            attributes["aria-expanded"] = "true";
        }

        if (TriggerContext?.ParentDisabled == true)
            attributes["disabled"] = QuarkAttributeValues.True;

        if (ShowCollapsedTooltip)
            attributes["title"] = Tooltip!;

        if (!AsChild && !Href.HasContent())
            attributes["type"] = "button";

        var sizeClass = GetSizeClass(ButtonSize);
        var variantClass = GetVariantClass(Variant);
        attributes.TryGetValue("class", out var baseClass);
        var key = (sizeClass, variantClass, baseClass?.ToString());
        if (_buttonClassKey == key && _lastBuiltClass is not null)
            attributes["class"] = _lastBuiltClass;
        else
        {
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendClass(ref cls, "peer/menu-button group/menu-button group-has-data-[sidebar=menu-action]/menu-item:pr-8 group-data-[collapsible=icon]:size-8! group-data-[collapsible=icon]:p-2! focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground aria-disabled:pointer-events-none aria-disabled:opacity-50 data-[state=open]:hover:bg-sidebar-accent data-[state=open]:hover:text-sidebar-accent-foreground data-[active=true]:bg-sidebar-accent data-[active=true]:font-medium data-[active=true]:text-sidebar-accent-foreground [&_svg]:size-4 [&_svg]:shrink-0 [&>span:last-child]:truncate");
                AppendClass(ref cls, sizeClass);
                AppendClass(ref cls, variantClass);
                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass);
            }
            finally
            {
                cls.Dispose();
            }
        }
        _buttonClassKey = key;
    }

    private IReadOnlyDictionary<string, object> BuildSlotAttributes()
    {
        return BuildAttributes();
    }

    private RenderFragment? RenderChildContent()
    {
        if (TriggerContext is null || ChildContent is null)
            return ChildContent;

        return _triggerChildContent ??= @<CascadingValue Name="TriggerContext" Value="@NoChildTriggerContext" IsFixed="true">
            @ChildContent
        </CascadingValue>;
    }

    private async Task HandleActivate(MouseEventArgs args)
    {
        if (TriggerContext?.OnClick is not null)
            await TriggerContext.OnClick();

        if (TriggerContext?.Toggle is not null)
            await TriggerContext.Toggle();

        if (Href.HasContent() && State?.IsMobile == true && SidebarProvider is not null)
            await SidebarProvider.SetOpenMobile(false);

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        TriggerContext?.OnKeyDown?.Invoke(args) ?? Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (TriggerContext?.RegisterElement is not null &&
            (!_triggerElementRegistered || !string.Equals(_registeredTriggerId, TriggerContext.TriggerId, StringComparison.Ordinal)))
        {
            TriggerContext.RegisterElement(_elementRef);
            _triggerElementRegistered = true;
            _registeredTriggerId = TriggerContext.TriggerId;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Variant);
        hc.Add(ButtonSize);
        hc.Add(Active);
        hc.Add(Open);
        hc.Add(Href);
        hc.Add(Target);
        hc.Add(Tooltip);
        hc.Add(Match);
        hc.Add(AsChild);
        hc.Add(State?.Open);
        hc.Add(State?.IsMobile);
        hc.Add(TriggerContext?.TriggerId);
        hc.Add(TriggerContext?.DataState);
        hc.Add(TriggerContext?.AriaHasPopup);
        hc.Add(TriggerContext?.AriaControls);
        hc.Add(TriggerContext?.IsOpen);
        hc.Add(TriggerContext?.ParentDisabled == true);
    }
}
