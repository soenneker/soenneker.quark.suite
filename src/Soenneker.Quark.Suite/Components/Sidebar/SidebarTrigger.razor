@namespace Soenneker.Quark
@using Soenneker.Quark.Dtos
@inherits Soenneker.Quark.Element

<button @onclick="(_cachedHandleTriggerClickDelegate ??= HandleTriggerClick)" @attributes="BuildAttributes()">
    @if (OpenContent is not null || ClosedContent is not null)
    {
        @if (State?.IsMobile == true && State?.OpenMobile == true && OpenContent is not null)
        {
            @OpenContent
        }
        else if (ClosedContent is not null)
        {
            @ClosedContent
        }

        @if (ChildContent is not null)
        {
            @ChildContent
        }
    }
    else if (ChildContent is null)
    {
        <Svg Size="_renderCss0" Class="cn-rtl-flip" ViewBox="0 0 24 24" Fill="_renderCss1" Stroke='_renderCss2' StrokeWidth="_renderCss3" StrokeLineCap="_renderCss4" StrokeLineJoin="_renderCss5" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M9 3v18"></path>
        </Svg>
        <Span ScreenReader="_renderCss6">Toggle Sidebar</Span>
    }
    else
    {
        @ChildContent
    }
</button>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is7;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Transparent.OnFocusVisible.Ring;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.OnDisabled.None;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.OnDisabled.Is50;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<FillBuilder> _renderCss1 = Quark.Fill.None;
    private static readonly CssValue<StrokeBuilder> _renderCss2 = Quark.Stroke.Current;
    private static readonly CssValue<StrokeWidthBuilder> _renderCss3 = Quark.StrokeWidth.Is2;
    private static readonly CssValue<StrokeLineCapBuilder> _renderCss4 = Quark.StrokeLineCap.Round;
    private static readonly CssValue<StrokeLineJoinBuilder> _renderCss5 = Quark.StrokeLineJoin.Round;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss6 = Quark.ScreenReader.Only;
    private string? _lastPrependedClass;

    private Func<MouseEventArgs, Task>? _cachedHandleTriggerClickDelegate;

    [Parameter]
    public bool Unstyled { get; set; }

    [Parameter]
    public string? UnstyledDataSlot { get; set; }

    [Parameter]
    public string? UnstyledAriaHasPopup { get; set; }

    [Parameter]
    public string? UnstyledAriaControls { get; set; }

    [Parameter]
    public RenderFragment? OpenContent { get; set; }

    [Parameter]
    public RenderFragment? ClosedContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [CascadingParameter(Name = "SidebarProvider")]
    public SidebarProvider? SidebarProvider { get; set; }

    [CascadingParameter(Name = "SidebarContextState")]
    public SidebarContextState? State { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        DataSlot ??= Unstyled ? UnstyledDataSlot ?? "popover-trigger" : "sidebar-trigger";
        Display ??= _defaultDisplay;
        Size ??= _defaultSize;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Whitespace ??= _defaultWhitespace;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        BackgroundColor ??= _defaultBackgroundColor;

        if (!Unstyled)
        {
            Border ??= _defaultBorder;
            BorderColor ??= _defaultBorderColor;
            RingColor ??= _defaultRingColor;
            UserSelect ??= _defaultUserSelect;
            Cursor ??= _defaultCursor;
            PointerEvents ??= _defaultPointerEvents;
            Opacity ??= _defaultOpacity;
        }
    }

    private async Task HandleTriggerClick(MouseEventArgs args)
    {
        if (SidebarProvider is not null)
            await SidebarProvider.ToggleSidebar();

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Unstyled)
        {
            attributes["data-variant"] = "ghost";
            attributes["data-size"] = "default";
        }
        else
        {
            attributes["data-sidebar"] = "trigger";
            attributes["data-variant"] = "ghost";
            attributes["data-size"] = "icon-sm";
        }

        attributes["type"] = "button";
        var isExpanded = State?.IsMobile == true ? State?.OpenMobile == true : State?.Open == true;
        attributes["aria-expanded"] = isExpanded ? "true" : "false";

        if (State?.IsMobile == true && SidebarProvider is not null)
            attributes["aria-controls"] = SidebarProvider.MobileContentId;

        if (Unstyled)
        {
            attributes["data-state"] = isExpanded ? "open" : "closed";

            if (!string.IsNullOrWhiteSpace(UnstyledAriaHasPopup))
                attributes["aria-haspopup"] = UnstyledAriaHasPopup;

            if (!string.IsNullOrWhiteSpace(UnstyledAriaControls))
                attributes["aria-controls"] = UnstyledAriaControls;
        }

        if (!Unstyled)
        {
            const string @class = "group/button bg-clip-padding active:not-aria-[haspopup]:translate-y-px focus-visible:ring-[3px] aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 hover:bg-muted hover:text-foreground dark:hover:bg-muted/50 rounded-[min(var(--radius-md),12px)] in-data-[slot=button-group]:rounded-lg -ml-1";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(State?.IsMobile);
        hc.Add(State?.Open);
        hc.Add(State?.OpenMobile);
        hc.Add(Unstyled);
        hc.Add(UnstyledDataSlot);
        hc.Add(UnstyledAriaHasPopup);
        hc.Add(UnstyledAriaControls);
        hc.Add(OpenContent is not null);
        hc.Add(ClosedContent is not null);
    }
}
