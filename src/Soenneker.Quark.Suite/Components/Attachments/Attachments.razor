@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">@ChildContent</div>

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        AppendClass(ref cls, "[scrollbar-color:var(--scrollbar-thumb)_transparent] [scrollbar-width:thin] [&::-webkit-scrollbar-thumb]:border-transparent [&::-webkit-scrollbar-track]:bg-transparent");
        AppendClass(ref cls, "data-[variant=list]:flex data-[variant=list]:flex-row data-[variant=list]:flex-wrap data-[variant=inline]:flex data-[variant=inline]:flex-wrap data-[variant=inline]:gap-2");
        AppendClass(ref cls, "data-[variant=grid]:grid data-[variant=grid]:grid-cols-2 data-[variant=grid]:gap-2");
    }

    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.End;
    private static readonly CssValue<MinWidthBuilder> _staticCss1 = Quark.MinWidth.Is0;
    private static readonly CssValue<MaxWidthBuilder> _staticCss2 = Quark.MaxWidth.IsFull;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<FlexWrapBuilder> _defaultFlexWrap = Quark.FlexWrap.Wrap;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2_5;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowX = Quark.Overflow.X.Auto;
    private static readonly CssValue<OverscrollBuilder> _defaultOverscroll = Quark.Overscroll.XContain;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.FromBottom.Is0_5;

    [Parameter]
    public string Variant { get; set; } = "list";

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "attachment-list";
        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        MaxWidth ??= _staticCss2;
        MinWidth ??= _staticCss1;
        FlexWrap ??= _defaultFlexWrap;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Gap ??= _defaultGap;
        OverflowX ??= _defaultOverflowX;
        Overscroll ??= _defaultOverscroll;
        Padding ??= _defaultPadding;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-variant"] = Variant;


    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Variant);
    }
}
