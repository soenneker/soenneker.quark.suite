</div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _defaultInset = Quark.Inset.Is0;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.IsFull;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Token("[inherit]");
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Is0;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "attachment-preview";
        Position ??= _defaultPosition;
        Inset ??= _defaultInset;
        Display ??= _defaultDisplay;
        Size ??= _defaultSize;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Overflow ??= _defaultOverflow;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;

    }
}