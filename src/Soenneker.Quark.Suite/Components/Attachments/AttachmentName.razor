@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Foreground;
    private static readonly CssValue<TruncateBuilder> _defaultTruncate = Quark.Truncate.Default;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "attachment-name";
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= _defaultTextColor;
        Truncate ??= _defaultTruncate;

    }
}