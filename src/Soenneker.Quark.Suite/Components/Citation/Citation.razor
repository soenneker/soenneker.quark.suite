@namespace Soenneker.Quark

@if (_resolved.Length > 0)
{
    <CascadingValue Value="this" IsFixed="false">
        <HoverCard OpenDelay="@OpenDelay" CloseDelay="@CloseDelay">
            @ChildContent
        </HoverCard>
    </CascadingValue>
}

@code {
    private ResolvedCitation[] _resolved = [];
    private (string Url, RenderFragment? Title, RenderFragment? Description)[] _sources = [];

    internal int ActiveIndex { get; private set; }

    internal ResolvedCitation ActiveCitation => _resolved[Math.Clamp(ActiveIndex, 0, Math.Max(0, _resolved.Length - 1))];

    internal IReadOnlyList<ResolvedCitation> ResolvedCitations => _resolved;

    internal bool CanScrollPrev => ActiveIndex > 0;

    internal bool CanScrollNext => ActiveIndex < _resolved.Length - 1;

    [Parameter]
    public IReadOnlyList<CitationSourceInput> Citations { get; set; } = [];

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public int OpenDelay { get; set; } = 50;

    [Parameter]
    public int CloseDelay { get; set; } = 50;

    internal void ScrollPrev()
    {
        if (CanScrollPrev)
        {
            ActiveIndex--;
            StateHasChanged();
        }
    }

    internal void ScrollNext()
    {
        if (CanScrollNext)
        {
            ActiveIndex++;
            StateHasChanged();
        }
    }

    protected override void OnParametersSet()
    {
        ResolveCitations(Citations);

        if (ActiveIndex >= _resolved.Length)
            ActiveIndex = Math.Max(0, _resolved.Length - 1);
    }

    private void ResolveCitations(IReadOnlyList<CitationSourceInput> citations)
    {
        if (citations.Count == 0)
        {
            _resolved = [];
            _sources = [];
            return;
        }

        if (_resolved.Length != citations.Count)
        {
            _resolved = new ResolvedCitation[citations.Count];
            _sources = new (string, RenderFragment?, RenderFragment?)[citations.Count];
        }

        for (int i = 0; i < citations.Count; i++)
        {
            var source = citations[i];
            var previous = _sources[i];
            if (_resolved[i] is not null && previous.Url == source.Url &&
                ReferenceEquals(previous.Title, source.Title) && ReferenceEquals(previous.Description, source.Description))
                continue;

            _resolved[i] = CitationSourceResolver.Resolve(source);
            _sources[i] = (source.Url, source.Title, source.Description);
        }
    }
}
