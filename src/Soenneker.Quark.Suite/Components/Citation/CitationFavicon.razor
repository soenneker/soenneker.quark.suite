@namespace Soenneker.Quark
@inherits Soenneker.Quark.Component

@if (!string.IsNullOrWhiteSpace(ResolvedSource?.FaviconSrc))
{
    <Image Source="@ResolvedSource.FaviconSrc"
           Alt=""
           Attributes="@BuildAttributes()" />
}

@code {
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is4;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Background;
    [CascadingParameter]
    private Citation? ParentCitation { get; set; }

    [Parameter]
    public ResolvedCitation? Source { get; set; }

    private ResolvedCitation? ResolvedSource => Source ?? ParentCitation?.ActiveCitation;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "citation-favicon";

        Size ??= _defaultSize;
        Shrink ??= _defaultShrink;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
    }
}