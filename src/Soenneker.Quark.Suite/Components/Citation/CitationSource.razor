@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (ResolvedSource is not null)
{
    <div @attributes="BuildAttributes()">
        <CitationFavicon Source="@ResolvedSource" />
        <CitationSiteName Source="@ResolvedSource" />
    </div>
}

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromTop.Is2;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Quark.Items.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1_5;
    [CascadingParameter]
    private Citation? ParentCitation { get; set; }

    [Parameter]
    public ResolvedCitation? Source { get; set; }

    private ResolvedCitation? ResolvedSource => Source ?? ParentCitation?.ActiveCitation;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "citation-source";

        Margin ??= _defaultMargin;
        Display ??= _defaultDisplay;
        ItemsAlign ??= _defaultItemsAlign;
        Gap ??= _defaultGap;
    }
}