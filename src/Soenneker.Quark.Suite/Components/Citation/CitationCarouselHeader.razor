@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">@ChildContent</div>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Auto;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Quark.Items.Center;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Between;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is3.FromTop.Is3;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "citation-carousel-header";

        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        ItemsAlign ??= _defaultItemsAlign;
        Justify ??= _defaultJustify;
        Padding ??= _defaultPadding;
    }
}
