@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement

@if (ResolvedSource is not null)
{
    <span @attributes="BuildAttributes()">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @ResolvedSource.SiteName
        }
    </span>
}

@code {
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Is4_5;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Normal;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Primary;
    [CascadingParameter]
    private Citation? ParentCitation { get; set; }

    [Parameter]
    public ResolvedCitation? Source { get; set; }

    private ResolvedCitation? ResolvedSource => Source ?? ParentCitation?.ActiveCitation;



    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "citation-site-name";

        TextSize ??= _defaultTextSize;
        Leading ??= _defaultLeading;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= _defaultTextColor;
    }
}