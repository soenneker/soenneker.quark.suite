@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement

@if (ParentCitation is not null)
{
    <span @attributes="BuildAttributes()">@(ParentCitation.ActiveIndex + 1)/@ParentCitation.ResolvedCitations.Count</span>
}

@code {
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Is4_5;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Token("[350]");
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private string? _lastBuiltClass;

    [CascadingParameter]
    private Citation? ParentCitation { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "citation-carousel-index";

        TextSize ??= _defaultTextSize;
        Leading ??= _defaultLeading;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= _defaultTextColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        {
            const string @class = "tabular-nums";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }
}
