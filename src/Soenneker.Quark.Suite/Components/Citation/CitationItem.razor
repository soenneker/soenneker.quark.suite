@namespace Soenneker.Quark
@inherits Soenneker.Quark.Component

@if (Citation is not null)
{
    <Anchor Href="@Citation.Url" Target="Target.Blank" rel="noreferrer" Display="_renderCss0" Width="_renderCss1" FlexDirection="_renderCss2" Gap="_renderCss3" Padding="_renderCss4" TextAlign="_renderCss5" DecorationLine="_renderCss6" OutlineStyle="_renderCss7" Attributes="@BuildAttributes()">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @if (ShowTitle && Citation.Title is not null)
            {
                <H4 DataSlot="citation-title" LineClamp="_renderCss8" TextSize="_renderCss9" Leading="_renderCss10" FontWeight='@("font-[450]")' TextColor="_renderCss11">@Citation.Title</H4>
            }
            @if (ShowDescription && Citation.Description is not null)
            {
                <Paragraph DataSlot="citation-description" LineClamp="_renderCss12" TextSize="_renderCss9" Leading='_renderCss13' FontWeight='@("font-[350]")' TextColor="_renderCss14">@Citation.Description</Paragraph>
            }
            @if (ShowSource)
            {
                <CitationSource Source="@Citation" />
            }
        }
    </Anchor>
}

@code {
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.Flex;
    private static readonly CssValue<WidthBuilder> _renderCss1 = Quark.Width.IsFull;
    private static readonly CssValue<FlexDirectionBuilder> _renderCss2 = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _renderCss3 = Quark.Gap.Is1;
    private static readonly CssValue<PaddingBuilder> _renderCss4 = Quark.Padding.Is3;
    private static readonly CssValue<TextAlignBuilder> _renderCss5 = Quark.TextAlign.Start;
    private static readonly CssValue<DecorationLineBuilder> _renderCss6 = Quark.DecorationLine.None;
    private static readonly CssValue<OutlineStyleBuilder> _renderCss7 = Quark.OutlineStyle.None;
    private static readonly CssValue<LineClampBuilder> _renderCss8 = Quark.LineClamp.Is2;
    private static readonly CssValue<TextSizeBuilder> _renderCss9 = Quark.TextSize.Xs;
    private static readonly CssValue<LeadingBuilder> _renderCss10 = Quark.Leading.Is4;
    private static readonly CssValue<TextColorBuilder> _renderCss11 = Quark.TextColor.Primary;
    private static readonly CssValue<LineClampBuilder> _renderCss12 = Quark.LineClamp.Is3;
    private static readonly CssValue<LeadingBuilder> _renderCss13 = Quark.Leading.Is4_5;
    private static readonly CssValue<TextColorBuilder> _renderCss14 = Quark.TextColor.MutedForeground;
    [CascadingParameter]
    private Citation? ParentCitation { get; set; }

    [Parameter]
    public int? Index { get; set; }

    [Parameter]
    public bool ShowTitle { get; set; } = true;

    [Parameter]
    public bool ShowDescription { get; set; } = true;

    [Parameter]
    public bool ShowSource { get; set; } = true;

    private ResolvedCitation? Citation => ParentCitation is null
        ? null
        : ParentCitation.ResolvedCitations[Math.Clamp(Index ?? ParentCitation.ActiveIndex, 0, ParentCitation.ResolvedCitations.Count - 1)];

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "citation-item";
    }
}
