@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (ParentCitation is not null)
{
    <div @attributes="BuildAttributes()">
        @if (ShowFavicons)
        {
            <Div DataSlot="citation-favicon-group"
                 Display="_renderCss0"
                 Space='_renderCss1'
                 Class="*:data-[slot=citation-favicon]:ring-2 *:data-[slot=citation-favicon]:ring-secondary">
                @for (var i = 0; i < Math.Min(3, ParentCitation.ResolvedCitations.Count); i++)
                {
                    <CitationFavicon Source="@ParentCitation.ResolvedCitations[i]" />
                }
            </Div>
        }
        <Span TextSize="_renderCss2" Leading='_renderCss3' FontWeight="_renderCss4" TextColor="_renderCss5">@(Label ?? $"{ParentCitation.ResolvedCitations.Count} {(ParentCitation.ResolvedCitations.Count == 1 ? "source" : "sources")}")</Span>
    </div>
}

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromTop.Is0;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is6;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFit;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Items.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1_5;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Secondary;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.Flex;
    private static readonly CssValue<SpaceBuilder> _renderCss1 = Quark.Space.X.Token("-2");
    private static readonly CssValue<TextSizeBuilder> _renderCss2 = Quark.TextSize.Xs;
    private static readonly CssValue<LeadingBuilder> _renderCss3 = Quark.Leading.Is4_5;
    private static readonly CssValue<FontWeightBuilder> _renderCss4 = Quark.FontWeight.Normal;
    private static readonly CssValue<TextColorBuilder> _renderCss5 = Quark.TextColor.Primary;
    [CascadingParameter]
    private Citation? ParentCitation { get; set; }

    [Parameter]
    public bool ShowFavicons { get; set; } = true;

    [Parameter]
    public string? Label { get; set; }

    private static readonly CssValue<PaddingBuilder> _faviconPadding = Quark.Padding.FromRight.Is2.FromLeft.Is1;
    private static readonly CssValue<PaddingBuilder> _textPadding = Quark.Padding.OnX.Is2;
    private CssValue<PaddingBuilder> SourcesBadgePadding =>
        ShowFavicons
            ? _faviconPadding
            : _textPadding;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "citation-sources-badge";

        Margin ??= _defaultMargin;
        Display ??= _renderCss0;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        ItemsAlign ??= _defaultItemsAlign;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= SourcesBadgePadding;
    }
}
