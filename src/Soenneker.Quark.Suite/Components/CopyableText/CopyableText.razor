@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ICopyableText

<span @ref="ElementRef" @attributes="BuildAttributes()">
    @if (TextPreset is not null)
    {
        <Span Preset="@TextPreset" @attributes="BuildTextAttributes()">@DisplayText</Span>
    }
    else
    {
        <span @attributes="BuildTextAttributes()">@DisplayText</span>
    }
    <CopyButton Preset="@CopyButtonPreset" Text="@ResolvedCopyText"
                Variant="@CopyButtonVariant"
                ButtonSize="@CopyButtonSize"
                Disabled="@CopyDisabled"
                IdleIcon="@IdleIcon"
                DoneIcon="@DoneIcon"
                ErrorIcon="@ErrorIcon"
                CopyLabel="@CopyLabel"
                DoneLabel="@DoneLabel"
                ErrorLabel="@ErrorLabel"
                ResetDelay="@ResetDelay"
                Class="@ResolvedCopyButtonClass"
                Attributes="@CopyButtonAttributes"
                OnCopySuccess="@OnCopySuccess"
                OnCopyError="@OnCopyError" />
    @if (!string.IsNullOrWhiteSpace(ActionHref) || OnAction.HasDelegate)
    {
        <Button Type="@ButtonType.Button" Href="@ActionHref" OnClick="@OnAction"
                Variant="@ButtonVariant.Ghost" ButtonSize="@_staticCss0"
                Disabled="@(Disabled || ActionDisabled)" AriaLabel="@ActionLabel" Title="@ActionLabel"
                Class="shrink-0 size-6! p-0! text-muted-foreground hover:bg-transparent hover:text-foreground active:translate-y-0"
                DataSlot="copyable-text-action">
            <span aria-hidden="true"><Icon Name="@ActionIcon" Size="Soenneker.Quark.Size.Is4" /></span>
        </Button>
    }
</span>

@code {
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = ButtonSize.IconXs;
    private string? _textClass;
    private string? _copyButtonClass;
    private string? _mergedTextClass;
    private QuarkAttributeDictionary _textAttributes;
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string? CopyText { get; set; }

    [Parameter]
    public bool TruncateText { get; set; } = true;

    [Parameter]
    public bool ShowFullTextOnHover { get; set; } = true;

    [Parameter]
    public bool AlwaysShowCopyButton { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? TextClass { get; set; }

    [Parameter]
    public string? CopyButtonClass { get; set; }

    [Parameter]
    public ButtonVariant CopyButtonVariant { get; set; } = ButtonVariant.Ghost;

    [Parameter]
    public CssValue<ButtonSizeBuilder>? CopyButtonSize { get; set; } = _staticCss0;

    [Parameter]
    public LucideIcon IdleIcon { get; set; } = LucideIcon.Copy;

    [Parameter]
    public LucideIcon DoneIcon { get; set; } = LucideIcon.Check;

    [Parameter]
    public LucideIcon ErrorIcon { get; set; } = LucideIcon.X;

    [Parameter]
    public string CopyLabel { get; set; } = "Copy";

    [Parameter]
    public string DoneLabel { get; set; } = "Copied";

    [Parameter]
    public string ErrorLabel { get; set; } = "Copy failed";

    [Parameter]
    public int ResetDelay { get; set; } = 1600;

    [Parameter]
    public IReadOnlyDictionary<string, object>? TextAttributes { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, object>? CopyButtonAttributes { get; set; }

    [Parameter]
    public EventCallback<string> OnCopySuccess { get; set; }

    [Parameter]
    public EventCallback<Exception?> OnCopyError { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool DisableCopyWhenEmpty { get; set; } = true;
    [Parameter] public bool FieldAppearance { get; set; }
    [Parameter] public QuarkPresetToken? TextPreset { get; set; }
    [Parameter] public QuarkPresetToken? CopyButtonPreset { get; set; }
    [Parameter] public string? ActionHref { get; set; }
    [Parameter] public LucideIcon ActionIcon { get; set; } = LucideIcon.ExternalLink;
    [Parameter] public string ActionLabel { get; set; } = "Open";
    [Parameter] public bool ActionDisabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnAction { get; set; }

    private string DisplayText => Text ?? Placeholder ?? string.Empty;
    private string? ResolvedCopyText => CopyText ?? Text;
    private bool CopyDisabled => Disabled || (DisableCopyWhenEmpty && string.IsNullOrEmpty(ResolvedCopyText));
    private string ResolvedTextClass => TextPreset is not null ? TextClass ?? string.Empty : AppendClass(TruncateText ? "min-w-0 flex-1 truncate" : "min-w-0 flex-1", FieldAppearance ? "font-mono text-[13px] leading-none text-foreground/80 " + TextClass : TextClass, ref _textClass);

    private string ResolvedCopyButtonClass
    {
        get
        {
            if (CopyButtonPreset is not null) return CopyButtonClass ?? string.Empty;
            const string always = "shrink-0 size-6! p-0! text-muted-foreground hover:bg-transparent hover:text-foreground active:translate-y-0";
            const string onHover = always + " transition-opacity duration-200 ease-out md:opacity-0 group-hover/copyable-text:opacity-100 group-focus-within/copyable-text:opacity-100";
            return AppendClass(AlwaysShowCopyButton || FieldAppearance ? always : onHover, CopyButtonClass, ref _copyButtonClass);
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "copyable-text";
    }

    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);

        if (Disabled)
            attributes["aria-disabled"] = "true";
    }

    protected override void BuildOwnedClassAndStyle(ref PooledStringBuilder style, ref PooledStringBuilder cssClass)
    {
        base.BuildOwnedClassAndStyle(ref style, ref cssClass);
        if (FieldAppearance && Preset is not null)
        {
            AppendClass(ref cssClass, "group/copyable-text");
            return;
        }
        if (FieldAppearance) AppendClass(ref cssClass, "h-8 w-full cursor-default select-none rounded-lg border border-transparent bg-input/60 px-2 py-1 shadow-none dark:bg-input/40");
        AppendClass(ref cssClass, "group/copyable-text inline-flex max-w-full min-w-0 items-center gap-1 align-middle");
    }

    private Dictionary<string, object> BuildTextAttributes()
    {
        var attributes = CopyAttributes(TextAttributes);
        attributes["data-slot"] = "copyable-text-value";

        if (TruncateText && ShowFullTextOnHover && !string.IsNullOrEmpty(Text) && !attributes.ContainsKey("title"))
            attributes["title"] = Text;

        MergeAttribute(attributes, "class", ResolvedTextClass, ref _mergedTextClass);
        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hashCode)
    {
        base.ComputeRenderKeyCore(ref hashCode);
        hashCode.Add(ActionHref);
        hashCode.Add(ActionIcon);
        hashCode.Add(ActionLabel);
        hashCode.Add(ActionDisabled);
        hashCode.Add(OnAction);
        hashCode.Add(Placeholder);
        hashCode.Add(DisableCopyWhenEmpty);
        hashCode.Add(FieldAppearance);
        hashCode.Add(TextPreset);
        hashCode.Add(CopyButtonPreset);
        hashCode.Add(Text);
        hashCode.Add(CopyText);
        hashCode.Add(TruncateText);
        hashCode.Add(ShowFullTextOnHover);
        hashCode.Add(AlwaysShowCopyButton);
        hashCode.Add(Disabled);
        hashCode.Add(TextClass);
        hashCode.Add(CopyButtonClass);
        hashCode.Add(CopyButtonVariant);
        hashCode.Add(CopyButtonSize);
        hashCode.Add(IdleIcon);
        hashCode.Add(DoneIcon);
        hashCode.Add(ErrorIcon);
        hashCode.Add(CopyLabel);
        hashCode.Add(DoneLabel);
        hashCode.Add(ErrorLabel);
        hashCode.Add(ResetDelay);
        AddAttributesToHash(ref hashCode, TextAttributes);
        AddAttributesToHash(ref hashCode, CopyButtonAttributes);
    }

    private static void AddAttributesToHash(ref HashCode hashCode, IReadOnlyDictionary<string, object>? attributes)
    {
        if (attributes is null)
            return;

        foreach ((var key, var value) in attributes)
        {
            hashCode.Add(key, StringComparer.OrdinalIgnoreCase);
            hashCode.Add(value);
        }
    }

    private static string AppendClass(string defaultClass, string? additionalClass, ref string? previous) =>
        string.IsNullOrWhiteSpace(additionalClass) ? defaultClass.Trim() : QuarkStringCache.Concat(defaultClass.Trim(), " ", additionalClass, ref previous);

    private Dictionary<string, object> CopyAttributes(IReadOnlyDictionary<string, object>? source)
    {
        var attributes = _textAttributes.Create((source?.Count ?? 0) + 3, StringComparer.OrdinalIgnoreCase);

        if (source is not null)
        {
            foreach ((var key, var value) in source)
                attributes[key] = value;
        }

        return attributes;
    }

    private static void MergeAttribute(Dictionary<string, object> attributes, string name, string? value, ref string? previous)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        if (attributes.TryGetValue(name, out var existing) && !string.IsNullOrWhiteSpace(existing?.ToString()))
            attributes[name] = QuarkStringCache.Concat(existing.ToString()!, " ", value, ref previous);
        else
            attributes[name] = value;
    }
}
