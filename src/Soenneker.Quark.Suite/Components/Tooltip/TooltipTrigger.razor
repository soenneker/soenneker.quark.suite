@using Soenneker.Atomics.ValueBools
@using Soenneker.Bradix
@using Microsoft.JSInterop

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@inject ITooltipInterop Interop

@if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <BradixTooltipTrigger AdditionalAttributes="@TriggerAttributes">
        @ChildContent
    </BradixTooltipTrigger>
}

@code {
    private ValueAtomicBool _disposed;
    private QuarkAttributeDictionary _triggerAttributes;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tooltip-trigger";
    }

    private bool _hasPointerMoveOpened;
    private bool _pointerDown;
    private ElementReference _triggerElement;
    private DotNetObjectReference<TooltipTrigger>? _dotNetReference;
    private bool _triggerRegistered;

    [CascadingParameter]
    private BradixTooltip? Tooltip { get; set; }

    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? ParentTriggerContext { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildTriggerAttributes();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        await EnsureTriggerRegistered();
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_triggerRegistered)
                await Interop.UnregisterTooltipTrigger(_triggerElement);
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
            await base.DisposeAsync();
        }
    }

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        var attributes = _triggerAttributes.Create(BuildAttributes());
        attributes.Remove("type");
        attributes.Remove("data-state");
        attributes.Remove("id");
        attributes.Remove("aria-describedby");
        attributes.Remove("aria-haspopup");
        attributes.Remove("aria-expanded");
        attributes.Remove("aria-controls");
        attributes.Remove("onpointermove");
        attributes.Remove("onpointerleave");
        attributes.Remove("onpointerdown");
        attributes.Remove("onpointerup");
        attributes.Remove("onmouseenter");
        attributes.Remove("onmousemove");
        attributes.Remove("onmouseleave");
        attributes.Remove("onfocusin");
        attributes.Remove("onfocusout");
        attributes.Remove("onclick");
        attributes.Remove("onkeydown");
        return attributes;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (ParentTriggerContext?.TriggerId is not null)
            attributes["id"] = ParentTriggerContext.TriggerId;

        var describedBy = BuildAriaDescribedBy();
        if (describedBy is not null)
            attributes["aria-describedby"] = describedBy;

        if (ParentTriggerContext?.AriaHasPopup is not null)
            attributes["aria-haspopup"] = ParentTriggerContext.AriaHasPopup;

        if (ParentTriggerContext?.AriaControls is not null)
        {
            attributes["aria-expanded"] = ParentTriggerContext.IsOpen ? "true" : "false";
            attributes["aria-controls"] = ParentTriggerContext.AriaControls;
        }

    }

    private (TriggerContext?, BradixTooltip?, bool, string?, string?)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<Task>? _contextOnClickCallback;
    private Func<Task>? _contextOnPointerMoveCallback;
    private Func<Task>? _contextOnPointerLeaveCallback;
    private Func<PointerEventArgs, Task>? _contextOnPointerDownEventCallback;
    private Func<Task>? _contextOnPointerUpCallback;
    private Func<Task>? _contextOpenCallback;
    private Func<Task>? _contextCloseCallback;
    private Func<Task>? _contextOnMouseEnterCallback;
    private Func<Task>? _contextOnMouseMoveCallback;
    private Func<Task>? _contextOnMouseLeaveCallback;
    private Func<Task>? _contextOnFocusInCallback;
    private Func<Task>? _contextOnFocusOutCallback;
    private Func<KeyboardEventArgs, Task>? _contextOnKeyDownCallback;
    private Action<ElementReference>? _contextRegisterElementCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (ParentTriggerContext, Tooltip, Tooltip?.CurrentOpen == true, Tooltip?.ContentId, Tooltip?.StateAttribute);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = ParentTriggerContext?.DataSlot ?? "tooltip-trigger",
            TriggerId = ParentTriggerContext?.TriggerId,
            IsOpen = ParentTriggerContext?.AriaControls is not null ? ParentTriggerContext.IsOpen : Tooltip?.CurrentOpen == true,
            DataState = ParentTriggerContext?.AriaControls is not null
                ? ParentTriggerContext.IsOpen ? "open" : "closed"
                : Tooltip?.StateAttribute ?? "closed",
            AriaHasPopup = ParentTriggerContext?.AriaHasPopup,
            AriaControls = ParentTriggerContext?.AriaControls,
            AriaDescribedBy = BuildAriaDescribedBy(),
            Toggle = ParentTriggerContext?.Toggle,
            SuppressClickAfterPointerDown = ParentTriggerContext?.SuppressClickAfterPointerDown == true,
            OnClick = (_contextOnClickCallback ??= HandleTriggerClick),
            OnPointerMove = (_contextOnPointerMoveCallback ??= HandleTriggerPointerMove),
            OnPointerLeave = (_contextOnPointerLeaveCallback ??= HandleTriggerPointerLeave),
            OnPointerDownEvent = (_contextOnPointerDownEventCallback ??= HandleTriggerPointerDown),
            OnPointerUp = (_contextOnPointerUpCallback ??= HandleTriggerPointerUp),
            Open = Tooltip is null ? null : (_contextOpenCallback ??= () => Tooltip.HandleTriggerEnter()),
            Close = Tooltip is null ? null : (_contextCloseCallback ??= () => Tooltip.Close()),
            OnMouseEnter = (_contextOnMouseEnterCallback ??= HandleTriggerMouseEnter),
            OnMouseMove = (_contextOnMouseMoveCallback ??= HandleTriggerMouseMove),
            OnMouseLeave = (_contextOnMouseLeaveCallback ??= HandleTriggerMouseLeave),
            OnFocusIn = (_contextOnFocusInCallback ??= HandleTriggerFocusIn),
            OnFocusOut = Tooltip is null ? null : (_contextOnFocusOutCallback ??= () => Tooltip.HandleTriggerBlur()),
            OnKeyDown = Tooltip is null ? null : (_contextOnKeyDownCallback ??= e => HandleTriggerKeyDownCore(e, Tooltip)),
            RegisterElement = Tooltip is null
                ? null
                : (_contextRegisterElementCallback ??= elementReference => _ = InvokeAsync(() => HandleTriggerElementRegistered(elementReference)))
        };
    }

    private async Task HandleTriggerElementRegistered(ElementReference elementReference)
    {
        _triggerElement = elementReference;
        Tooltip?.RegisterTrigger(elementReference);
        await EnsureTriggerRegistered();
    }

    private async Task EnsureTriggerRegistered()
    {
        if (_disposed.Read() || _triggerRegistered || Tooltip is null || _triggerElement.Context is null)
            return;

        _dotNetReference ??= DotNetObjectReference.Create(this);
        await Interop.RegisterTooltipTrigger(_triggerElement, _dotNetReference);
        if (_disposed.Read())
        {
            await Interop.UnregisterTooltipTrigger(_triggerElement);
            return;
        }

        _triggerRegistered = true;
    }

    private string? _combinedDescribedBy;
    private string? BuildAriaDescribedBy()
    {
        var tooltipId = Tooltip?.CurrentOpen == true ? Tooltip.ContentId : null;
        var parentDescribedBy = ParentTriggerContext?.AriaDescribedBy;

        if (parentDescribedBy is null)
            return tooltipId;

        if (tooltipId is null)
            return parentDescribedBy;

        return QuarkStringCache.Concat(parentDescribedBy, " ", tooltipId, ref _combinedDescribedBy);
    }

    private Task HandleTriggerPointerMove()
    {
        if (Tooltip is null || _hasPointerMoveOpened || ShouldBlockOpenFromPointerTransit())
            return Task.CompletedTask;

        _hasPointerMoveOpened = true;
        return Tooltip.HandleTriggerEnter();
    }

    private Task HandleTriggerMouseEnter()
    {
        return HandleTriggerMouseMove();
    }

    private Task HandleTriggerMouseMove()
    {
        if (Tooltip is null || _hasPointerMoveOpened || ShouldBlockOpenFromPointerTransit())
            return Task.CompletedTask;

        _hasPointerMoveOpened = true;
        return Tooltip.HandleTriggerEnter();
    }

    private bool ShouldBlockOpenFromPointerTransit()
    {
        return Tooltip is not null &&
               !Tooltip.EffectiveDisableHoverableContent &&
               Tooltip.ShouldBlockTriggerHoverOpen;
    }

    private Task HandleTriggerMouseLeave()
    {
        _hasPointerMoveOpened = false;

        return Tooltip?.HandleTriggerLeave() ?? Task.CompletedTask;
    }

    private Task HandleTriggerPointerLeave()
    {
        _hasPointerMoveOpened = false;

        return Tooltip?.HandleTriggerLeave() ?? Task.CompletedTask;
    }

    private async Task HandleTriggerPointerDown(PointerEventArgs args)
    {
        _pointerDown = true;

        if (Tooltip is not null)
            await Tooltip.Close();

        if (ParentTriggerContext?.OnPointerDownEvent is not null)
        {
            await ParentTriggerContext.OnPointerDownEvent(args);
            return;
        }

        if (ParentTriggerContext?.OnPointerDown is not null)
            await ParentTriggerContext.OnPointerDown();
    }

    private Task HandleTriggerPointerUp()
    {
        _pointerDown = false;
        return Task.CompletedTask;
    }

    private Task HandleTriggerFocusIn()
    {
        return Tooltip is null
            ? Task.CompletedTask
            : Tooltip.HandleTriggerFocus(_pointerDown);
    }

    private static Task HandleTriggerKeyDownCore(KeyboardEventArgs e, BradixTooltip tooltip)
    {
        if ((e.Key == "Escape" || e.Key == "Enter" || e.Key == " ") && tooltip.CurrentOpen)
            return tooltip.Close();

        return Task.CompletedTask;
    }

    private Task HandleTriggerClick()
    {
        _pointerDown = false;
        return Tooltip?.HandleTriggerClick() ?? Task.CompletedTask;
    }

    [JSInvokable]
    public Task HandleDocumentPointerUp()
    {
        _pointerDown = false;
        return Task.CompletedTask;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Tooltip);
        hc.Add(Tooltip?.CurrentOpen);
        hc.Add(Tooltip?.ContentId);
        hc.Add(AsChild);
        hc.Add(ParentTriggerContext?.TriggerId);
        hc.Add(ParentTriggerContext?.AriaHasPopup);
        hc.Add(ParentTriggerContext?.AriaControls);
        hc.Add(ParentTriggerContext?.AriaDescribedBy);
        hc.Add(ParentTriggerContext?.IsOpen);
        hc.Add(ParentTriggerContext?.SuppressClickAfterPointerDown == true);
    }
}
