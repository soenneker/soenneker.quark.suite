@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixTooltip Open="@(_hasControlledOpen ? Open : (bool?)null)"
               DefaultOpen="@DefaultOpen"
               OpenChanged="@OpenChanged"
               DelayDuration="@DelayDuration"
               ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />

@code {
    private bool _hasControlledOpen;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        if (parameters.TryGetValue<bool>(nameof(Open), out _))
            _hasControlledOpen = true;

        return base.SetParametersAsync(parameters);
    }
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tooltip";
    }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public int? DelayDuration { get; set; }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(_hasControlledOpen);
        hc.Add(DefaultOpen);
        hc.Add(DelayDuration);
    }
}