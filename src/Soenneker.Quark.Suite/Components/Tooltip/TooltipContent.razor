@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixTooltipPortal ForceMount="@ForceMount">
    <BradixTooltipContent ForceMount="@ForceMount"
                          Side="@Side"
                          Align="@Align"
                          SideOffset="@SideOffset"
                          AlignOffset="@AlignOffset"
                          ArrowPadding="@ArrowPadding"
                          AvoidCollisions="@AvoidCollisions"
                          CollisionPadding="@CollisionPadding"
                          CollisionBoundarySelector="@CollisionBoundarySelector"
                          CollisionBoundarySelectors="@CollisionBoundarySelectors"
                          Sticky="@Sticky"
                          HideWhenDetached="@HideWhenDetached"
                          AdditionalAttributes="@ContentAttributes">
        @ChildContent
        @if (ShowArrow)
        {
            <BradixTooltipArrow Width="10" Height="5" Class="z-50 size-2.5 translate-y-[calc(-50%_-_2px)] rotate-45 rounded-[2px] bg-foreground fill-foreground" />
        }
    </BradixTooltipContent>
</BradixTooltipPortal>

@code {
    private static readonly CssValue<MaxWidthBuilder> _staticCss0 = Quark.MaxWidth.IsXs;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is50;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFit;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Items.Center;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Utility("bg-foreground");
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is3.OnY.Token("1.5");
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Utility("text-background");
    private string? _lastPrependedClass;

    [CascadingParameter]
    private BradixTooltip? Tooltip { get; set; }

    [CascadingParameter(Name = "DirectionProviderDir")]
    private string? DirectionProviderDir { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }

    /// <summary>
    /// Gets or sets side placement: top, right, bottom, or left.
    /// </summary>
    [Parameter]
    public Side Side { get; set; } = Side.Top;

    /// <summary>
    /// Gets or sets alignment along the placement axis: start, center, or end.
    /// </summary>
    [Parameter]
    public Alignment Align { get; set; } = Alignment.Center;

    /// <summary>
    /// Gets or sets whether the decorative arrow is shown.
    /// </summary>
    [Parameter]
    public bool ShowArrow { get; set; } = true;

    /// <summary>
    /// Gets or sets offset from the trigger in pixels.
    /// </summary>
    [Parameter]
    public int SideOffset { get; set; }

    [Parameter]
    public double AlignOffset { get; set; }

    [Parameter]
    public double ArrowPadding { get; set; }

    [Parameter]
    public bool AvoidCollisions { get; set; } = true;

    [Parameter]
    public double CollisionPadding { get; set; }

    [Parameter]
    public string? CollisionBoundarySelector { get; set; }

    [Parameter]
    public IReadOnlyList<string>? CollisionBoundarySelectors { get; set; }

    [Parameter]
    public string Sticky { get; set; } = "partial";

    [Parameter]
    public bool HideWhenDetached { get; set; }

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tooltip-content";

        ZIndex ??= _defaultZIndex;
        Display ??= _defaultDisplay;
        Width ??= _defaultWidth;
        MaxWidth ??= _staticCss0;
        ItemsAlign ??= _defaultItemsAlign;
        Gap ??= "gap-1.5";
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        TextColor ??= _defaultTextColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        {
            const string @class = "origin-(--radix-tooltip-content-transform-origin) has-data-[slot=kbd]:pr-1.5 **:data-[slot=kbd]:relative **:data-[slot=kbd]:isolate **:data-[slot=kbd]:z-50 **:data-[slot=kbd]:rounded-sm data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[state=delayed-open]:animate-in data-[state=instant-open]:animate-in data-[state=delayed-open]:fade-in-0 data-[state=instant-open]:fade-in-0 data-[state=delayed-open]:zoom-in-95 data-[state=instant-open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Tooltip?.CurrentOpen ?? Open);
        hc.Add(ForceMount);
        hc.Add(Side);
        hc.Add(Align);
        hc.Add(SideOffset);
        hc.Add(AlignOffset);
        hc.Add(ArrowPadding);
        hc.Add(AvoidCollisions);
        hc.Add(CollisionPadding);
        hc.Add(CollisionBoundarySelector);
        if (CollisionBoundarySelectors is not null)
        {
            foreach (var selector in CollisionBoundarySelectors)
                hc.Add(selector);
        }
        hc.Add(Sticky);
        hc.Add(HideWhenDetached);
        hc.Add(ShowArrow);
        hc.Add(DirectionProviderDir);
    }

}
