@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElementBase

<div @attributes="BuildAttributes()">
    @{
        var filteredAutocompleteOptions = GetFilteredAutocompleteOptions();
        var shouldRenderAutocomplete = filteredAutocompleteOptions.Count > 0;
    }

    @if (!InlineTags && IsInputOnTop)
    {
        @RenderInputContainer(shouldRenderAutocomplete)
    }

    @if (!InlineTags)
    {
        @RenderTagList()
    }

    @if (InlineTags)
    {
        @RenderInputContainer(shouldRenderAutocomplete)
    }
    else if (!IsInputOnTop)
    {
        @RenderInputContainer(shouldRenderAutocomplete)
    }

    @if (shouldRenderAutocomplete)
    {
        <div data-slot="tag-input-autocomplete" role="listbox" class="@GetAutocompleteClass()">
            @for (var index = 0; index < filteredAutocompleteOptions.Count; index++)
            {
                var option = filteredAutocompleteOptions[index];
                <button type="button" data-slot="tag-input-autocomplete-item" data-active="@(index == _activeAutocompleteIndex ? "true" : "false")" role="option" class="relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground data-[active=true]:bg-accent data-[active=true]:text-accent-foreground" @onclick="() => AddAutocompleteTag(option)">
                    @option
                </button>
            }
        </div>
    }

    @if (ShowCounter || ClearAll)
    {
        <div data-slot="tag-input-footer" class="mt-1 flex items-center justify-between gap-2 text-xs text-muted-foreground">
            @if (ShowCounter)
            {
                <span data-slot="tag-input-counter">@Values.Length@CounterMaxText</span>
            }

            @if (ClearAll && Values.Length > 0 && !ReadOnly && !Disabled)
            {
                <button type="button" data-slot="tag-input-clear-all" class="font-medium text-foreground underline-offset-4 hover:underline" @onclick="ClearTags">Clear All</button>
            }
        </div>
    }
</div>

@code {
    private ElementReference _inputRef;
    private string _inputValue = string.Empty;
    private int? _activeTagIndexInternal;
    private int _activeAutocompleteIndex = -1;
    private bool _preventDefaultKeys;
    private bool _isFocused;
    private QuarkAttributeDictionary _inputContainerAttributeBuffer;
    private QuarkAttributeDictionary _tagListAttributeBuffer;
    private QuarkAttributeDictionary _inputAttributeBuffer;
    private QuarkAttributeDictionary _autocompleteAttributeBuffer;
    private QuarkAttributeDictionary _footerAttributeBuffer;
    private QuarkAttributeDictionary _clearAllAttributeBuffer;
    private QuarkAttributeDictionary[] _tagAttributeBuffers = [];
    private QuarkAttributeDictionary[] _removeButtonAttributeBuffers = [];
    private QuarkAttributeDictionary[] _autocompleteItemAttributeBuffers = [];

    [Parameter]
    public string[] Values { get; set; } = [];

    [Parameter]
    public EventCallback<string[]> ValuesChanged { get; set; }

    [Parameter]
    public int? ActiveTagIndex { get; set; }

    [Parameter]
    public EventCallback<int?> ActiveTagIndexChanged { get; set; }

    [Parameter]
    public int? MaxTags { get; set; }

    [Parameter]
    public int? MinTags { get; set; }

    [Parameter]
    public int? MaxLength { get; set; }

    [Parameter]
    public int? MinLength { get; set; }

    [Parameter]
    public bool AllowDuplicates { get; set; }

    [Parameter]
    public bool AddOnPaste { get; set; } = true;

    [Parameter]
    public bool AddTagsOnBlur { get; set; }

    [Parameter]
    public bool SortTags { get; set; }

    [Parameter]
    public bool ShowCounter { get; set; }

    [Parameter]
    public bool ClearAll { get; set; }

    [Parameter]
    public bool InlineTags { get; set; } = true;

    [Parameter]
    public bool EnableAutocomplete { get; set; }

    [Parameter]
    public bool RestrictTagsToAutocompleteOptions { get; set; }

    [Parameter]
    public bool TruncateTags { get; set; }

    [Parameter]
    public int TruncateLength { get; set; } = 20;

    [Parameter]
    public string Delimiter { get; set; } = ",";

    [Parameter]
    public string[] DelimiterList { get; set; } = [","];

    [Parameter]
    public string[] AutocompleteOptions { get; set; } = [];

    [Parameter]
    public Func<string, bool>? ValidateTag { get; set; }

    [Parameter]
    public Func<string, string>? GenerateTagId { get; set; }

    [Parameter]
    public Func<string, string, bool>? AutocompleteFilter { get; set; }

    [Parameter]
    public EventCallback<string> OnTagAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnTagRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnInputChange { get; set; }

    [Parameter]
    public EventCallback<string> OnTagClick { get; set; }

    [Parameter]
    public EventCallback OnClearAll { get; set; }

    [Parameter]
    public TagInputVariant Variant { get; set; } = TagInputVariant.Secondary;

    [Parameter]
    public TagInputSize TagSize { get; set; } = TagInputSize.Md;

    [Parameter]
    public TagInputDirection Direction { get; set; } = TagInputDirection.Row;

    [Parameter]
    public TagInputFieldPosition InputFieldPosition { get; set; } = TagInputFieldPosition.Bottom;

    [Parameter]
    public string? PlaceholderWhenFull { get; set; }

    [Parameter]
    public string? InputClass { get; set; }

    [Parameter]
    public string? TagClass { get; set; }

    [Parameter]
    public string? TagListClass { get; set; }

    [Parameter]
    public string? AutocompleteClass { get; set; }

    private int? CurrentActiveTagIndex => ActiveTagIndex ?? _activeTagIndexInternal;

    private bool IsFull => MaxTags is not null && Values.Length >= MaxTags.Value;

    private bool IsInputOnTop => ReferenceEquals(InputFieldPosition, TagInputFieldPosition.Top);

    private string EffectivePlaceholder => IsFull && PlaceholderWhenFull.HasContent()
        ? PlaceholderWhenFull!
        : Placeholder ?? string.Empty;

    private string CounterMaxText => MaxTags is null ? string.Empty : $"/{MaxTags.Value}";

    private IReadOnlyList<string> GetFilteredAutocompleteOptions()
    {
        if (!_isFocused || Disabled || ReadOnly || !EnableAutocomplete || AutocompleteOptions.Length == 0)
            return Array.Empty<string>();

        var input = _inputValue.Trim();
        List<string>? options = null;

        foreach (var option in AutocompleteOptions)
        {
            if (!option.HasContent() || (!AllowDuplicates && ContainsTag(option)))
                continue;

            if (!(AutocompleteFilter?.Invoke(option, input) ?? option.Contains(input, StringComparison.OrdinalIgnoreCase)))
                continue;

            options ??= new List<string>(Math.Min(8, AutocompleteOptions.Length));
            options.Add(option);

            if (options.Count == 8)
                break;
        }

        return options is null ? Array.Empty<string>() : options;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "tag-input";
        Position ??= Quark.Position.Relative;
        Width ??= Quark.Width.IsFull;
    }

    private RenderFragment RenderInputContainer(bool shouldRenderAutocomplete) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "data-slot", InlineTags ? "tag-input-inline-container" : "tag-input-field-container");
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => _inputRef.FocusAsync()));
        builder.AddAttribute(3, "class", GetInputContainerClass());

        if (InlineTags)
            builder.AddContent(4, RenderTagList());

        builder.OpenElement(5, "input");
        builder.AddAttribute(6, "value", _inputValue);
        builder.AddAttribute(7, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, HandleInput));
        builder.AddAttribute(8, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleKeyDown));
        builder.AddAttribute(9, "onkeydown:preventDefault", _preventDefaultKeys);
        builder.AddAttribute(10, "onfocus", EventCallback.Factory.Create<FocusEventArgs>(this, HandleFocus));
        builder.AddAttribute(11, "onblur", EventCallback.Factory.Create<FocusEventArgs>(this, HandleBlur));
        builder.AddAttribute(12, "data-slot", "tag-input-input");
        builder.AddAttribute(13, "type", "text");
        builder.AddAttribute(14, "autocomplete", "off");
        builder.AddAttribute(15, "placeholder", Values.Length == 0 || !InlineTags ? EffectivePlaceholder : string.Empty);
        builder.AddAttribute(16, "aria-expanded", shouldRenderAutocomplete ? "true" : "false");
        builder.AddAttribute(17, "aria-autocomplete", EnableAutocomplete ? "list" : "none");
        builder.AddAttribute(18, "disabled", Disabled || IsFull);
        builder.AddAttribute(19, "readonly", ReadOnly);
        builder.AddAttribute(20, "name", Name);
        builder.AddAttribute(21, "id", Id);
        builder.AddAttribute(22, "aria-label", AriaLabel);
        builder.AddAttribute(23, "aria-describedby", AriaDescribedBy);
        builder.AddAttribute(24, "class", "min-w-24 flex-1 bg-transparent px-1 py-1 outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed");
        builder.AddElementReferenceCapture(25, element => _inputRef = element);
        builder.CloseElement();

        builder.CloseElement();
    };

    private RenderFragment RenderTagList() => builder =>
    {
        if (Values.Length == 0)
            return;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "data-slot", "tag-input-list");
        builder.AddAttribute(2, "role", "list");
        builder.AddAttribute(3, "class", GetTagListClass());

        for (var i = 0; i < Values.Length; i++)
        {
            var tag = Values[i];
            var tagIndex = i;
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "data-slot", "tag-input-tag");
            builder.AddAttribute(6, "data-active", CurrentActiveTagIndex == i ? "true" : "false");
            builder.AddAttribute(7, "role", "listitem");
            builder.AddAttribute(8, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => HandleTagClick(tag, tagIndex)));
            builder.AddAttribute(9, "class", GetTagClass());

            builder.OpenElement(10, "span");
            builder.AddAttribute(11, "data-slot", "tag-input-tag-text");
            builder.AddContent(12, GetDisplayTag(tag));
            builder.CloseElement();

            if (!ReadOnly && !Disabled)
            {
                builder.OpenElement(13, "button");
                builder.AddAttribute(14, "data-slot", "tag-input-tag-remove");
                builder.AddAttribute(15, "aria-label", $"Remove {tag}");
                builder.AddAttribute(16, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => RemoveTagAt(tagIndex, moveToPrevious: true)));
                builder.AddAttribute(17, "class", "-me-1 inline-flex size-4 items-center justify-center rounded-full text-current/70 outline-none hover:text-current focus-visible:ring-2 focus-visible:ring-ring");
                builder.OpenComponent<Icon>(18);
                builder.AddAttribute(19, nameof(Icon.Name), LucideIcon.X);
                builder.AddAttribute(20, nameof(Icon.Class), "size-3");
                builder.CloseComponent();
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private async Task HandleInput(ChangeEventArgs args)
    {
        _inputValue = args.Value?.ToString() ?? string.Empty;
        _activeAutocompleteIndex = -1;
        await SetActiveTagIndex(null);
        if (OnInputChange.HasDelegate)
            await OnInputChange.InvokeAsync(_inputValue);

        if (AddOnPaste && ContainsSplitDelimiter(_inputValue))
            await AddTags(_inputValue);

        Refresh();
    }

    protected override async Task HandleKeyDown(KeyboardEventArgs args)
    {
        _preventDefaultKeys = ShouldPreventKey(args.Key);

        if (Disabled || ReadOnly)
            return;

        switch (args.Key)
        {
            case "Enter":
            {
                var filteredAutocompleteOptions = GetFilteredAutocompleteOptions();
                if (_activeAutocompleteIndex >= 0 && _activeAutocompleteIndex < filteredAutocompleteOptions.Count)
                    await AddAutocompleteTag(filteredAutocompleteOptions[_activeAutocompleteIndex]);
                else
                    await AddTagsFromInput();
                break;
            }
            case "Backspace":
                if (_inputValue.Length == 0)
                    await HandleBackspace();
                break;
            case "Delete":
                if (_inputValue.Length == 0 && CurrentActiveTagIndex is not null)
                    await RemoveTagAt(CurrentActiveTagIndex.Value, moveToPrevious: false);
                break;
            case "ArrowLeft":
                if (_inputValue.Length == 0)
                    await MoveActiveTag(-1);
                break;
            case "ArrowRight":
                if (_inputValue.Length == 0)
                    await MoveActiveTag(1);
                break;
            case "Home":
                if (_inputValue.Length == 0 && Values.Length > 0)
                    await SetActiveTagIndex(0);
                break;
            case "End":
                if (_inputValue.Length == 0 && Values.Length > 0)
                    await SetActiveTagIndex(Values.Length - 1);
                break;
            case "ArrowDown":
                MoveAutocomplete(1);
                break;
            case "ArrowUp":
                MoveAutocomplete(-1);
                break;
            default:
                if (IsDelimiterKey(args.Key))
                    await AddTagsFromInput();
                break;
        }

        Refresh();
    }

    protected override async Task HandleFocus(FocusEventArgs args)
    {
        _isFocused = true;
        await base.HandleFocus(args);
    }

    protected override async Task HandleBlur(FocusEventArgs args)
    {
        _isFocused = false;

        if (AddTagsOnBlur && _inputValue.HasContent() && !Disabled && !ReadOnly)
            await AddTagsFromInput();

        await base.HandleBlur(args);
    }

    private bool ShouldPreventKey(string key)
    {
        if (Disabled || ReadOnly)
            return false;

        return key is "Enter" or "ArrowUp" or "ArrowDown" ||
               (key is "Backspace" or "Delete" or "ArrowLeft" or "ArrowRight" or "Home" or "End" && _inputValue.Length == 0) ||
               IsDelimiterKey(key);
    }

    private bool IsDelimiterKey(string key)
    {
        if (key == "Enter")
            return true;

        foreach (var delimiter in DelimiterList)
        {
            if (string.Equals(delimiter, key, StringComparison.Ordinal))
                return true;
        }

        return Delimiter.HasContent() && string.Equals(Delimiter, key, StringComparison.Ordinal);
    }

    private async Task AddTagsFromInput()
    {
        if (!_inputValue.HasContent())
            return;

        await AddTags(_inputValue);
    }

    private async Task AddTags(string raw)
    {
        var delimiters = GetSplitDelimiters();
        var candidates = raw.Split(delimiters, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var nextTags = new List<string>(Values.Length + candidates.Length);
        nextTags.AddRange(Values);
        var added = OnTagAdd.HasDelegate ? new List<string>(candidates.Length) : null;
        var addedCount = 0;

        foreach (var candidate in candidates)
        {
            if (!CanAddTag(candidate, nextTags))
                continue;

            nextTags.Add(candidate);
            added?.Add(candidate);
            addedCount++;

            if (MaxTags is not null && nextTags.Count >= MaxTags.Value)
                break;
        }

        if (addedCount == 0)
            return;

        if (SortTags)
            nextTags.Sort(StringComparer.OrdinalIgnoreCase);

        Values = nextTags.ToArray();
        _inputValue = string.Empty;
        _activeAutocompleteIndex = -1;
        await ValuesChanged.InvokeAsync(Values);
        if (added is not null)
        {
            foreach (var tag in added)
                await OnTagAdd.InvokeAsync(tag);
        }

        await SetActiveTagIndex(null);
    }

    private string[] GetSplitDelimiters()
    {
        var delimiters = new List<string>(DelimiterList.Length + 1);

        if (Delimiter.HasContent())
            delimiters.Add(Delimiter);

        foreach (var delimiter in DelimiterList)
        {
            if (delimiter.HasContent() && !delimiters.Contains(delimiter))
                delimiters.Add(delimiter);
        }

        return delimiters.Count == 0 ? [","] : delimiters.ToArray();
    }

    private bool ContainsSplitDelimiter(string value)
    {
        if (!value.HasContent())
            return false;

        var hasConfiguredDelimiter = false;

        if (Delimiter.HasContent())
        {
            hasConfiguredDelimiter = true;

            if (value.Contains(Delimiter, StringComparison.Ordinal))
                return true;
        }

        foreach (var delimiter in DelimiterList)
        {
            if (!delimiter.HasContent())
                continue;

            hasConfiguredDelimiter = true;

            if (value.Contains(delimiter, StringComparison.Ordinal))
                return true;
        }

        return !hasConfiguredDelimiter && value.Contains(',');
    }

    private bool CanAddTag(string tag, IReadOnlyList<string> currentTags)
    {
        if (!tag.HasContent())
            return false;

        if (MaxTags is not null && currentTags.Count >= MaxTags.Value)
            return false;

        if (MaxLength is not null && tag.Length > MaxLength.Value)
            return false;

        if (MinLength is not null && tag.Length < MinLength.Value)
            return false;

        if (!AllowDuplicates)
        {
            for (var i = 0; i < currentTags.Count; i++)
            {
                if (string.Equals(currentTags[i], tag, StringComparison.OrdinalIgnoreCase))
                    return false;
            }
        }

        if (RestrictTagsToAutocompleteOptions)
        {
            var found = false;

            foreach (var option in AutocompleteOptions)
            {
                if (!string.Equals(option, tag, StringComparison.OrdinalIgnoreCase))
                    continue;

                found = true;
                break;
            }

            if (!found)
                return false;
        }

        return ValidateTag?.Invoke(tag) ?? true;
    }

    private async Task AddAutocompleteTag(string tag)
    {
        await AddTags(tag);
        _isFocused = true;
        await _inputRef.FocusAsync();
    }

    private async Task RemoveTagAt(int index, bool moveToPrevious)
    {
        if (index < 0 || index >= Values.Length)
            return;

        if (MinTags is not null && Values.Length <= MinTags.Value)
            return;

        var removed = Values[index];
        var nextValues = new string[Values.Length - 1];

        if (index > 0)
            Array.Copy(Values, 0, nextValues, 0, index);

        if (index < Values.Length - 1)
            Array.Copy(Values, index + 1, nextValues, index, Values.Length - index - 1);

        Values = nextValues;
        await ValuesChanged.InvokeAsync(Values);
        if (OnTagRemove.HasDelegate)
            await OnTagRemove.InvokeAsync(removed);

        if (Values.Length == 0)
            await SetActiveTagIndex(null);
        else
            await SetActiveTagIndex(Math.Clamp(moveToPrevious ? index - 1 : index, 0, Values.Length - 1));
    }

    private async Task HandleBackspace()
    {
        if (CurrentActiveTagIndex is { } index)
            await RemoveTagAt(index, moveToPrevious: true);
        else if (Values.Length > 0)
            await SetActiveTagIndex(Values.Length - 1);
    }

    private async Task MoveActiveTag(int delta)
    {
        if (Values.Length == 0)
        {
            await SetActiveTagIndex(null);
            return;
        }

        var next = CurrentActiveTagIndex is null
            ? delta < 0 ? Values.Length - 1 : 0
            : Math.Clamp(CurrentActiveTagIndex.Value + delta, 0, Values.Length - 1);

        await SetActiveTagIndex(next);
    }

    private void MoveAutocomplete(int delta)
    {
        var count = GetFilteredAutocompleteOptions().Count;
        if (count == 0)
        {
            _activeAutocompleteIndex = -1;
            return;
        }

        _activeAutocompleteIndex = _activeAutocompleteIndex < 0
            ? delta > 0 ? 0 : count - 1
            : (_activeAutocompleteIndex + delta + count) % count;
    }

    private async Task SetActiveTagIndex(int? index)
    {
        _activeTagIndexInternal = index;
        if (ActiveTagIndexChanged.HasDelegate)
            await ActiveTagIndexChanged.InvokeAsync(index);
    }

    private async Task ClearTags()
    {
        if (Disabled || ReadOnly)
            return;

        Values = [];
        _inputValue = string.Empty;
        await ValuesChanged.InvokeAsync(Values);
        await SetActiveTagIndex(null);
        if (OnClearAll.HasDelegate)
            await OnClearAll.InvokeAsync();
    }

    private bool ContainsTag(string tag)
    {
        foreach (var value in Values)
        {
            if (string.Equals(value, tag, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    private string GetDisplayTag(string tag)
    {
        if (!TruncateTags || tag.Length <= TruncateLength)
            return tag;

        return string.Concat(tag.AsSpan(0, Math.Max(0, TruncateLength)), "...");
    }

    private async Task HandleTagClick(string tag, int index)
    {
        await SetActiveTagIndex(index);
        if (OnTagClick.HasDelegate)
            await OnTagClick.InvokeAsync(tag);
        await _inputRef.FocusAsync();
    }

    private string GetInputContainerClass()
    {
        var cls = "flex min-h-9 w-full flex-wrap items-center gap-1 rounded-md border border-input bg-transparent px-2 py-1 text-sm shadow-xs transition-[color,box-shadow] focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/50 has-aria-invalid:border-destructive has-aria-invalid:ring-destructive/20 dark:bg-input/30 dark:has-aria-invalid:border-destructive/50 dark:has-aria-invalid:ring-destructive/40";
        if (Disabled)
            cls = AppendToClass(cls, "cursor-not-allowed opacity-50");
        if (InputClass.HasContent())
            cls = AppendToClass(cls, InputClass!);
        return cls;
    }

    private string GetTagListClass()
    {
        var cls = ReferenceEquals(Direction, TagInputDirection.Column)
            ? "flex w-full flex-col gap-1"
            : "flex flex-wrap items-center gap-1";
        if (!InlineTags)
            cls = AppendToClass(cls, "mb-2");
        if (TagListClass.HasContent())
            cls = AppendToClass(cls, TagListClass!);
        return cls;
    }

    private string GetTagClass()
    {
        var cls = "inline-flex max-w-full items-center gap-1 border font-medium transition-colors data-[active=true]:ring-2 data-[active=true]:ring-ring data-[active=true]:ring-offset-1";
        cls = AppendToClass(cls, GetTagVariantClass());
        cls = AppendToClass(cls, GetTagSizeClass());
        if (TagClass.HasContent())
            cls = AppendToClass(cls, TagClass!);
        return cls;
    }

    private string GetAutocompleteClass()
    {
        var cls = "absolute z-50 mt-1 max-h-60 w-full overflow-auto rounded-md border bg-popover p-1 text-popover-foreground shadow-md";
        return AutocompleteClass.HasContent() ? AppendToClass(cls, AutocompleteClass!) : cls;
    }

    private Dictionary<string, object> BuildInputContainerAttributes()
    {
        var attributes = _inputContainerAttributeBuffer.Create(4);
        attributes["data-slot"] = InlineTags ? "tag-input-inline-container" : "tag-input-field-container";
        attributes["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => _inputRef.FocusAsync());

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "flex min-h-9 w-full flex-wrap items-center gap-1 rounded-md border border-input bg-transparent px-2 py-1 text-sm shadow-xs transition-[color,box-shadow] focus-within:border-ring focus-within:ring-[3px] focus-within:ring-ring/50");
            AppendClass(ref cls, "has-aria-invalid:border-destructive has-aria-invalid:ring-destructive/20 dark:bg-input/30 dark:has-aria-invalid:border-destructive/50 dark:has-aria-invalid:ring-destructive/40");

            if (Disabled)
                AppendClass(ref cls, "cursor-not-allowed opacity-50");

            if (InputClass.HasContent())
                AppendClass(ref cls, InputClass!);
        });

        return attributes;
    }

    private Dictionary<string, object> BuildTagListAttributes()
    {
        var attributes = _tagListAttributeBuffer.Create(4);
        attributes["data-slot"] = "tag-input-list";
        attributes["role"] = "list";

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, ReferenceEquals(Direction, TagInputDirection.Column)
                ? "flex w-full flex-col gap-1"
                : "flex flex-wrap items-center gap-1");

            if (!InlineTags)
                AppendClass(ref cls, "mb-2");

            if (TagListClass.HasContent())
                AppendClass(ref cls, TagListClass!);
        });

        return attributes;
    }

    private Dictionary<string, object> BuildTagAttributes(int index)
    {
        var tag = Values[index];
        EnsureAttributeBufferCapacity(ref _tagAttributeBuffers, index + 1);
        var attributes = _tagAttributeBuffers[index].Create(6);
        attributes["data-slot"] = "tag-input-tag";
        attributes["data-active"] = CurrentActiveTagIndex == index ? "true" : "false";
        attributes["role"] = "listitem";
        attributes["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => HandleTagClick(tag, index));

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "inline-flex max-w-full items-center gap-1 border font-medium transition-colors data-[active=true]:ring-2 data-[active=true]:ring-ring data-[active=true]:ring-offset-1");
            AppendClass(ref cls, GetTagVariantClass());
            AppendClass(ref cls, GetTagSizeClass());

            if (TagClass.HasContent())
                AppendClass(ref cls, TagClass!);
        });

        return attributes;
    }

    private Dictionary<string, object> BuildRemoveButtonAttributes(string tag, int index)
    {
        EnsureAttributeBufferCapacity(ref _removeButtonAttributeBuffers, index + 1);
        var attributes = _removeButtonAttributeBuffers[index].Create(6);
        attributes["data-slot"] = "tag-input-tag-remove";
        attributes["aria-label"] = $"Remove {tag}";
        attributes["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => RemoveTagAt(index, moveToPrevious: true));

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "-me-1 inline-flex size-4 items-center justify-center rounded-full text-current/70 outline-none hover:text-current focus-visible:ring-2 focus-visible:ring-ring");
        });

        return attributes;
    }

    private Dictionary<string, object> BuildInputAttributes(bool shouldRenderAutocomplete)
    {
        var attributes = _inputAttributeBuffer.Create(16);
        attributes["data-slot"] = "tag-input-input";
        attributes["type"] = "text";
        attributes["autocomplete"] = "off";
        attributes["placeholder"] = Values.Length == 0 || !InlineTags ? EffectivePlaceholder : string.Empty;
        attributes["aria-expanded"] = shouldRenderAutocomplete ? "true" : "false";
        attributes["aria-autocomplete"] = EnableAutocomplete ? "list" : "none";

        if (Disabled || IsFull)
            attributes["disabled"] = true;

        if (ReadOnly)
            attributes["readonly"] = true;

        if (Name.HasContent())
            attributes["name"] = Name!;

        if (Id.HasContent())
            attributes["id"] = Id!;

        if (AriaLabel.HasContent())
            attributes["aria-label"] = AriaLabel!;

        if (AriaDescribedBy.HasContent())
            attributes["aria-describedby"] = AriaDescribedBy!;

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "min-w-24 flex-1 bg-transparent px-1 py-1 outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed");
        });

        return attributes;
    }

    private Dictionary<string, object> BuildAutocompleteAttributes()
    {
        var attributes = _autocompleteAttributeBuffer.Create(4);
        attributes["data-slot"] = "tag-input-autocomplete";
        attributes["role"] = "listbox";

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "absolute z-50 mt-1 max-h-60 w-full overflow-auto rounded-md border bg-popover p-1 text-popover-foreground shadow-md");

            if (AutocompleteClass.HasContent())
                AppendClass(ref cls, AutocompleteClass!);
        });

        return attributes;
    }

    private Dictionary<string, object> BuildAutocompleteItemAttributes(int index)
    {
        EnsureAttributeBufferCapacity(ref _autocompleteItemAttributeBuffers, index + 1);
        var attributes = _autocompleteItemAttributeBuffers[index].Create(4);
        attributes["data-slot"] = "tag-input-autocomplete-item";
        attributes["data-active"] = index == _activeAutocompleteIndex ? "true" : "false";
        attributes["role"] = "option";

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground data-[active=true]:bg-accent data-[active=true]:text-accent-foreground");
        });

        return attributes;
    }

    private Dictionary<string, object> BuildFooterAttributes()
    {
        var attributes = _footerAttributeBuffer.Create(4);
        attributes["data-slot"] = "tag-input-footer";

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "mt-1 flex items-center justify-between gap-2 text-xs text-muted-foreground");
        });

        return attributes;
    }

    private Dictionary<string, object> BuildClearAllAttributes()
    {
        var attributes = _clearAllAttributeBuffer.Create(4);
        attributes["data-slot"] = "tag-input-clear-all";

        RenderComponent.BuildClassAttribute(attributes, (ref cls) =>
        {
            AppendClass(ref cls, "font-medium text-foreground underline-offset-4 hover:underline");
        });

        return attributes;
    }

    private static void EnsureAttributeBufferCapacity(ref QuarkAttributeDictionary[] buffers, int requiredLength)
    {
        if (buffers.Length >= requiredLength)
            return;

        var nextLength = Math.Max(requiredLength, Math.Max(4, buffers.Length * 2));
        Array.Resize(ref buffers, nextLength);
    }

    private string GetTagVariantClass()
    {
        if (ReferenceEquals(Variant, TagInputVariant.Primary))
            return "border-transparent bg-primary text-primary-foreground";

        if (ReferenceEquals(Variant, TagInputVariant.Destructive))
            return "border-transparent bg-destructive/10 text-destructive dark:bg-destructive/20";

        if (ReferenceEquals(Variant, TagInputVariant.Outline))
            return "border-border bg-background text-foreground";

        if (ReferenceEquals(Variant, TagInputVariant.Default))
            return "border-transparent bg-primary text-primary-foreground";

        return "border-transparent bg-secondary text-secondary-foreground";
    }

    private string GetTagSizeClass()
    {
        if (ReferenceEquals(TagSize, TagInputSize.Sm))
            return "h-5 rounded-md px-1.5 text-xs";

        if (ReferenceEquals(TagSize, TagInputSize.Lg))
            return "h-8 rounded-lg px-2.5 text-sm";

        return "h-6 rounded-md px-2 text-xs";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-disabled"] = Disabled ? "true" : "false";
        attributes["data-readonly"] = ReadOnly ? "true" : "false";
        attributes["data-inline-tags"] = InlineTags ? "true" : "false";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(_inputValue);
        hc.Add(_activeTagIndexInternal);
        hc.Add(_activeAutocompleteIndex);
        hc.Add(_isFocused);
        hc.Add(Values.Length);
        foreach (var value in Values)
            hc.Add(value);
        hc.Add(ActiveTagIndex);
        hc.Add(MaxTags);
        hc.Add(MinTags);
        hc.Add(MaxLength);
        hc.Add(MinLength);
        hc.Add(AllowDuplicates);
        hc.Add(AddOnPaste);
        hc.Add(AddTagsOnBlur);
        hc.Add(SortTags);
        hc.Add(ShowCounter);
        hc.Add(ClearAll);
        hc.Add(InlineTags);
        hc.Add(EnableAutocomplete);
        hc.Add(RestrictTagsToAutocompleteOptions);
        hc.Add(TruncateTags);
        hc.Add(TruncateLength);
        hc.Add(Delimiter);
        hc.Add(PlaceholderWhenFull);
        hc.Add(Variant);
        hc.Add(TagSize);
        hc.Add(Direction);
        hc.Add(InputFieldPosition);
    }
}
