@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">@ChildContent</div>

@code {
    private static readonly CssValue<MaxWidthBuilder> _staticCss0 = Quark.MaxWidth.IsNone;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Primary;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Normal;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Is6_5;
    private string? _lastPrependedClass;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "message-markdown";
        MaxWidth ??= _staticCss0;
        TextColor ??= _defaultTextColor;
        FontWeight ??= _defaultFontWeight;
        TextSize ??= _defaultTextSize;
        Leading ??= _defaultLeading;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        {
            const string @class = "prose prose-headings:font-[450] prose-headings:leading-5.5 prose-h2:tracking-[-0.45px] prose-headings:mb-4 prose-headings:mt-6 prose-h1:text-xl prose-h2:text-lg prose-h3:text-base prose-h3:leading-4.5 prose-h3:tracking-[-0.4px] prose-h4:text-sm prose-h5:text-xs prose-h6:text-xs prose-headings:[&_a]:no-underline prose-headings:[&_a]:shadow-none prose-headings:[&_a]:text-inherit prose-lead:text-primary [&_[data-streamdown=link]]:text-foreground [&_[data-streamdown=link]]:font-normal [&_[data-streamdown=link]]:underline [&_[data-streamdown=link]]:underline-offset-2 [&_[data-streamdown=strong]]:text-foreground [&_[data-streamdown=strong]]:font-[550] prose-p:mb-1 prose-p:mt-4 prose-li:my-[-0.5px] prose-li:marker:text-muted-foreground/50 prose-ul:my-0 prose-ol:my-0 prose-ol:pl-3 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }
}
