@namespace Soenneker.Quark
@inherits Soenneker.Quark.Component

<Avatar AvatarSize="@AvatarSize" Attributes="@BuildAttributes()">
    <AvatarImage Src="@Src" Alt="@Alt" Margin='_renderCss0' Attributes="@ImageAttributes" />
    <AvatarFallback Margin='_renderCss0' Shrink="_renderCss1" Attributes="@FallbackAttributes">@Fallback</AvatarFallback>
</Avatar>

@code {
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is7;
    private static readonly CssValue<MarginBuilder> _renderCss0 = Quark.Margin.OnY.Token("0!");
    private static readonly CssValue<ShrinkBuilder> _renderCss1 = Quark.Shrink.Is0;
    [Parameter]
    public string? Src { get; set; }

    [Parameter]
    public string Alt { get; set; } = "";

    [Parameter]
    public RenderFragment? Fallback { get; set; }

    [Parameter]
    public string AvatarSize { get; set; } = "default";

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        Size ??= _defaultSize;
        Shrink ??= _renderCss1;
    }

    private static readonly IReadOnlyDictionary<string, object> ImageAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "message-avatar-image"
    };

    private static readonly IReadOnlyDictionary<string, object> FallbackAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "message-avatar-fallback"
    };
}
