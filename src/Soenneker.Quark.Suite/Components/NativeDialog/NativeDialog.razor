@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@inherits Soenneker.Quark.InteractiveElement
@implements INativeDialog

<dialog @ref="ElementRef"
        @oncancel="(_cachedHandleCancelDelegate ??= HandleCancel)"
        @oncancel:preventDefault="@(!CloseOnEscape)"
        @onclose="(_cachedHandleCloseDelegate ??= HandleClose)"
        @attributes="BuildAttributes()">
    @ChildContent
</dialog>

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.Auto;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Xl;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Border;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is6;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private string? _lastPrependedClass;

    private System.Func<Task>? _cachedHandleCancelDelegate;
    private System.Func<Task>? _cachedHandleCloseDelegate;

    [Inject]
    private INativeDialogInterop Interop { get; set; } = null!;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool Modal { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<string?> OnClose { get; set; }

    private bool _domOpen;
    public Task Show() => SetOpen(true, false);

    public Task ShowModal() => SetOpen(true, true);

    public Task Close(string? returnValue = null) => !_domOpen
        ? SetOpen(false, Modal)
        : Interop.Close(ElementRef, returnValue).AsTask();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "native-dialog";

        Margin ??= _defaultMargin;
        Width ??= _defaultWidth;
        MaxWidth ??= "max-w-[calc(100%-2rem)] sm:max-w-lg";
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BorderColor ??= _defaultBorderColor;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        TextColor ??= _defaultTextColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        PrependClassAttribute(attributes, "shadow-lg backdrop:bg-black/50 backdrop:backdrop-blur-xs", ref _lastPrependedClass);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (Open == _domOpen)
            return;

        if (!Open)
        {
            if (_domOpen)
                await Interop.Close(ElementRef);

            return;
        }

        if (Modal)
            await Interop.ShowModal(ElementRef);
        else
            await Interop.Show(ElementRef);

        _domOpen = true;
    }

    private async Task SetOpen(bool open, bool modal)
    {
        if (Open == open)
            return;

        Open = open;
        Modal = modal;
        await OpenChanged.InvokeIfHasDelegate(Open);
        await RefreshOffThread();
    }

    private Task HandleCancel() => OnCancel.InvokeIfHasDelegate();

    private async Task HandleClose()
    {
        _domOpen = false;

        string? returnValue = OnClose.HasDelegate || OpenChanged.HasDelegate
            ? await Interop.GetReturnValue(ElementRef)
            : null;

        if (Open)
        {
            Open = false;
            await OpenChanged.InvokeIfHasDelegate(false);
        }

        await OnClose.InvokeIfHasDelegate(returnValue);
        await RefreshOffThread();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(Modal);
        hc.Add(CloseOnEscape);
        hc.Add(OpenChanged.HasDelegate);
        hc.Add(OnCancel.HasDelegate);
        hc.Add(OnClose.HasDelegate);
    }
}
