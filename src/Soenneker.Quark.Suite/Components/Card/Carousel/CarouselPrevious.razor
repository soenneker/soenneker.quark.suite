@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<Button Variant="ButtonVariant.Outline" ButtonSize="_staticCss0" OnClick="(_cachedHandlePreviousClickDelegate ??= HandlePreviousClick)" Disabled="@(!(ParentCarousel?.CanScrollPrevious ?? false))" @attributes="BuildAttributes()">
    <Svg Size="_renderCss0" Class="cn-rtl-flip" NativeWidth="16" NativeHeight="16" ViewBox="0 0 24 24" Fill="_renderCss1" Stroke="_renderCss2" StrokeWidth="_renderCss3"><path d="m15 18-6-6 6-6"/></Svg>
    <Span ScreenReader="_renderCss4">Previous slide</Span>
</Button>

@code {
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = Quark.ButtonSize.IconSm;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Absolute;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<FillBuilder> _renderCss1 = Quark.Fill.None;
    private static readonly CssValue<StrokeBuilder> _renderCss2 = Quark.Stroke.Current;
    private static readonly CssValue<StrokeWidthBuilder> _renderCss3 = Quark.StrokeWidth.Is2;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss4 = Quark.ScreenReader.Only;
    private System.Func<MouseEventArgs, Task>? _cachedHandlePreviousClickDelegate;

    private string? _lastBuiltClass;

    [CascadingParameter(Name = "ParentCarousel")]
    private Carousel? ParentCarousel { get; set; }

    private Carousel? _subscribedCarousel;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "carousel-previous";

        Position ??= _defaultPosition;
        Rounded ??= _defaultRounded;
    }

    private async Task HandlePreviousClick(MouseEventArgs e)
    {
        if (ParentCarousel is not null)
            await ParentCarousel.Previous();

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (ReferenceEquals(_subscribedCarousel, ParentCarousel))
            return;

        if (_subscribedCarousel is not null)
            _subscribedCarousel.StateChanged -= OnCarouselStateChanged;

        _subscribedCarousel = ParentCarousel;

        if (_subscribedCarousel is not null)
            _subscribedCarousel.StateChanged += OnCarouselStateChanged;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        var horizontal = ParentCarousel?.IsVertical != true;

        {
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                if (horizontal)
                    AppendClass(ref cls, "touch-manipulation top-1/2 -left-12 -translate-y-1/2");
                else
                    AppendClass(ref cls, "touch-manipulation -top-12 left-1/2 -translate-x-1/2 rotate-90");
                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass);
            }
            finally
            {
                cls.Dispose();
            }
        }
    }

    private void OnCarouselStateChanged()
    {
        _ = RefreshOffThread();
    }

    public override async ValueTask DisposeAsync()
    {
        if (_subscribedCarousel is not null)
            _subscribedCarousel.StateChanged -= OnCarouselStateChanged;

        await base.DisposeAsync();
    }
}