@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()" role="group" aria-roledescription="slide">
    @ChildContent
</div>

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        AppendClass(ref cls, "basis-full");
    }

    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<GrowBuilder> _defaultGrow = Quark.Grow.Is0;
    private static readonly CssValue<PaddingBuilder> _defaultPadding2 = Quark.Padding.FromTop.Is4;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.FromLeft.Is4;


    [CascadingParameter(Name = "ParentCarousel")]
    private Carousel? ParentCarousel { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ParentCarousel?.RegisterItem();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "carousel-item";

        MinWidth ??= _staticCss0;
        Shrink ??= _defaultShrink;
        Grow ??= _defaultGrow;
        if (ParentCarousel?.IsVertical == true)
        {
            Padding ??= _defaultPadding2;
        }
        else
        {
            Padding ??= _defaultPadding;
        }
    }




    public override async ValueTask DisposeAsync()
    {
        ParentCarousel?.UnregisterItem();
        await base.DisposeAsync();
    }

}
