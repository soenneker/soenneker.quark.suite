@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()" role="group" aria-roledescription="slide">
    @ChildContent
</div>

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        AppendClass(ref cls, "basis-full");
        if (ResolvePresetValue(Padding, AppliedPresetContext?.Padding, nameof(Padding)) is null)
            AddCss<PaddingBuilder>(ref cls, ParentCarousel?.IsVertical == true ? _defaultPadding2 : _defaultPadding);
    }

    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<GrowBuilder> _defaultGrow = Quark.Grow.Is0;
    private static readonly CssValue<PaddingBuilder> _defaultPadding2 = Quark.Padding.FromTop.Is4;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.FromLeft.Is4;


    [CascadingParameter(Name = "ParentCarousel")]
    private Carousel? ParentCarousel { get; set; }

    private Carousel? _registeredCarousel;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ReferenceEquals(_registeredCarousel, ParentCarousel))
            return;

        _registeredCarousel?.UnregisterItem();
        _registeredCarousel = ParentCarousel;
        _registeredCarousel?.RegisterItem();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "carousel-item";

        MinWidth ??= _staticCss0;
        Shrink ??= _defaultShrink;
        Grow ??= _defaultGrow;
    }




    public override async ValueTask DisposeAsync()
    {
        var parent = _registeredCarousel;
        _registeredCarousel = null;
        parent?.UnregisterItem();
        await base.DisposeAsync();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ParentCarousel?.IsVertical);
    }

}
