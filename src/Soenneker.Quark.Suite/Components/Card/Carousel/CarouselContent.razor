@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildViewportAttributes()" @onpointerdown="(_cachedHandlePointerDownDelegate ??= HandlePointerDown)" @onpointerup="(_cachedHandlePointerUpDelegate ??= HandlePointerUp)" @onpointercancel="(_cachedHandlePointerCancelDelegate ??= HandlePointerCancel)" @ontouchstart="(_cachedHandleTouchStartDelegate ??= HandleTouchStart)" @ontouchend="(_cachedHandleTouchEndDelegate ??= HandleTouchEnd)" @ontouchcancel="(_cachedHandleTouchCancelDelegate ??= HandleTouchCancel)">
    <div @attributes="BuildAttributes()">
        @ChildContent
    </div>
</div>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;
    private string? _transformStyle;
    private double _transformOffset;
    private bool _transformHorizontal;

    private Action<PointerEventArgs>? _cachedHandlePointerDownDelegate;
    private Action<PointerEventArgs>? _cachedHandlePointerUpDelegate;
    private Action<PointerEventArgs>? _cachedHandlePointerCancelDelegate;
    private Action<TouchEventArgs>? _cachedHandleTouchStartDelegate;
    private Action<TouchEventArgs>? _cachedHandleTouchEndDelegate;
    private Action<TouchEventArgs>? _cachedHandleTouchCancelDelegate;

    private static readonly IReadOnlyDictionary<string, object> ViewportAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "carousel-content",
        ["class"] = "overflow-hidden"
    };

    [CascadingParameter(Name = "ParentCarousel")]
    private Carousel? ParentCarousel { get; set; }

    private Carousel? _subscribedCarousel;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        Display ??= _defaultDisplay;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (ReferenceEquals(_subscribedCarousel, ParentCarousel))
            return;

        if (_subscribedCarousel is not null)
            _subscribedCarousel.StateChanged -= OnCarouselStateChanged;

        _subscribedCarousel = ParentCarousel;

        if (_subscribedCarousel is not null)
            _subscribedCarousel.StateChanged += OnCarouselStateChanged;
    }

    private IReadOnlyDictionary<string, object> BuildViewportAttributes() => ViewportAttributes;

    private void HandlePointerDown(PointerEventArgs args)
    {
        ParentCarousel?.BeginPointerDrag(args);
    }

    private void HandlePointerUp(PointerEventArgs args)
    {
        ParentCarousel?.CompletePointerDrag(args);
    }

    private void HandlePointerCancel(PointerEventArgs _)
    {
        ParentCarousel?.CancelPointerDrag();
    }

    private void HandleTouchStart(TouchEventArgs args)
    {
        ParentCarousel?.BeginTouchDrag(args);
    }

    private void HandleTouchEnd(TouchEventArgs args)
    {
        ParentCarousel?.CompleteTouchDrag(args);
    }

    private void HandleTouchCancel(TouchEventArgs _)
    {
        ParentCarousel?.CancelPointerDrag();
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        {
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                var horizontal = ParentCarousel?.IsVertical != true;
                if (horizontal)
                {
                    if (!HasClassToken("-ml-"))
                        AppendClass(ref cls, "-ml-4");
                }
                else
                {
                    if (!HasClassToken("-mt-"))
                        AppendClass(ref cls, "-mt-4");
                    AppendClass(ref cls, "flex-col");
                }

                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass);
            }
            finally
            {
                cls.Dispose();
            }
        }

        {
            var sty = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                var horizontal = ParentCarousel?.IsVertical != true;
                var offset = ParentCarousel?.ScrollOffsetPixels ?? 0;
                if (_transformStyle is null || !_transformOffset.Equals(offset) || _transformHorizontal != horizontal)
                {
                    _transformOffset = offset;
                    _transformHorizontal = horizontal;
                    var formattedOffset = offset < 0.5 ? "0" : offset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                    var coordinate = offset < 0.5 ? "0" : string.Concat("-", formattedOffset);
                    _transformStyle = horizontal
                        ? $"transform: translate3d({coordinate}px, 0px, 0px)"
                        : $"transform: translate3d(0px, {coordinate}px, 0px)";
                }
                AppendStyleDecl(ref sty, _transformStyle);
                AppendStyleDecl(ref sty, "transition: transform 300ms ease-in-out");
                AppendStyleDecl(ref sty, "will-change: transform");
                BuildStyleAttribute(attributes, ref sty, ref _lastBuiltStyle);
            }
            finally
            {
                sty.Dispose();
            }
        }
    }

    private bool HasClassToken(string tokenPart)
    {
        return Class?.Contains(tokenPart, StringComparison.Ordinal) == true;
    }

    private void OnCarouselStateChanged()
    {
        _ = RefreshOffThread();
    }

    public override async ValueTask DisposeAsync()
    {
        if (_subscribedCarousel is not null)
            _subscribedCarousel.StateChanged -= OnCarouselStateChanged;

        await base.DisposeAsync();
    }

}
