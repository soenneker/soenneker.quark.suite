@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ICard

<CascadingValue Value="@this" IsFixed="true">
    <div @attributes="BuildAttributes()">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.CardForeground;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Card;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Xl;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is4;
    private string? _lastPrependedClass;

    [Parameter]
    public CardSize CardSize { get; set; } = CardSize.Default;

    public override CssValue<ShadowBuilder>? Shadow { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "card";
        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        TextSize ??= _defaultTextSize;
        TextColor ??= _defaultTextColor;
        BackgroundColor ??= _defaultBackgroundColor;
        Rounded ??= _defaultRounded;
        Gap ??= _defaultGap;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-size"] = CardSize?.Value ?? CardSize.Default.Value;

        {
            const string @class = "group/card overflow-hidden py-4 ring-1 ring-foreground/10 has-data-[slot=card-footer]:pb-0 has-[>img:first-child]:pt-0 data-[size=sm]:gap-3 data-[size=sm]:py-3 data-[size=sm]:has-data-[slot=card-footer]:pb-0 *:[img:first-child]:rounded-t-xl *:[img:last-child]:rounded-b-xl";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(CardSize.Value);
    }
}
