@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ICardFooter

<Div Attributes="@BuildAttributes()">
	@ChildContent
</Div>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Bottom.Xl;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.FromTop.Is1;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Token("muted/50");
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is4;
    private string? _lastPrependedClass;

	protected override void ApplyDefaultParameters()
	{
		base.ApplyDefaultParameters();
		DataSlot ??= "card-footer";
		Display ??= _defaultDisplay;
		ItemsAlign ??= _staticCss0;
		Rounded ??= _defaultRounded;
		Border ??= _defaultBorder;
		BackgroundColor ??= _defaultBackgroundColor;
		Padding ??= _defaultPadding;
	}

	protected override void BuildAttributesCore(Dictionary<string, object> attributes)
	{
		base.BuildAttributesCore(attributes);

		PrependClassAttribute(attributes, "group-data-[size=sm]/card:p-3", ref _lastPrependedClass);
	}
}