@namespace Soenneker.Quark
@inherits Soenneker.Quark.MediaElement
@implements ICardImg

<Image @attributes="BuildAttributes()"/>

@code {
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<RoundedBuilder> _defaultRounded2 = Quark.Rounded.Top.Xl;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Bottom.Xl;
    private string? _lastPrependedClass;

    /// <summary>
    /// Gets or sets whether the image should be positioned at the top of the card.
    /// </summary>
    [Parameter]
    public bool AtTop { get; set; }

    /// <summary>
    /// Gets or sets whether the image should be positioned at the bottom of the card.
    /// </summary>
    [Parameter]
    public bool AtBottom { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "card-img";
        Width ??= _defaultWidth;

        if (AtTop)
            Rounded ??= _defaultRounded2;
        else if (AtBottom)
            Rounded ??= _defaultRounded;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        PrependClassAttribute(attributes, "object-cover", ref _lastPrependedClass);

        if (Source.HasContent())
            attributes["src"] = Source;

        attributes["alt"] = Alt ?? string.Empty;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AtTop);
        hc.Add(AtBottom);
    }
}
