@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ICardBody

<div @attributes="BuildAttributes()" >
	@ChildContent
</div>

@code {
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is4.Modifier("group-data-[size=sm]/card").OnX.Is3;
	protected override void ApplyDefaultParameters()
	{
		base.ApplyDefaultParameters();
		DataSlot ??= "card-content";
		Padding ??= _defaultPadding;
	}
}
