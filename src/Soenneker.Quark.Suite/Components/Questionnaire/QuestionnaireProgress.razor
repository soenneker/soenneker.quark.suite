@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<div @attributes="BuildAttributes()">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (ParentQuestionnaire is not null && Total > 0)
    {
        @GetProgressText(Current, Total)
    }
</div>

@code {
    private QuarkInt32Attribute _currentAttribute;
    private QuarkInt32Attribute _totalAttribute;
    private int _currentText;
    private int _totalText;
    private string? _progressText;

    private string GetProgressText(int current, int total)
    {
        if (_progressText is null || _currentText != current || _totalText != total)
        {
            _currentText = current;
            _totalText = total;
            _progressText = $"Question {current} of {total}";
        }
        return _progressText;
    }

    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Token("[14ch]");
    private static readonly CssValue<MinHeightBuilder> _defaultMinHeight = Quark.MinHeight.Token("[1lh]");
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFit;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private string? _lastBuiltClass;

    [CascadingParameter]
    internal Questionnaire? ParentQuestionnaire { get; set; }

    public int Current => (ParentQuestionnaire?.CurrentIndex ?? -1) + 1;
    public int Total => ParentQuestionnaire?.EnabledItemCount ?? 0;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "questionnaire-progress";
        MinHeight ??= _defaultMinHeight;
        Width ??= _defaultWidth;
        MinWidth ??= _staticCss0;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        TextColor ??= _defaultTextColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["role"] = "progressbar";
        attributes["aria-label"] = "Questionnaire progress";
        attributes["aria-live"] = "polite";
        var total = Total;
        var current = Current;
        if (total > 0)
        {
            attributes["aria-valuemin"] = QuarkAttributeValues.One;
            attributes["aria-valuemax"] = _totalAttribute.Get(total);
            attributes["aria-valuenow"] = _currentAttribute.Get(current);
            attributes["aria-valuetext"] = GetProgressText(current, total);
        }

        {
            const string @class = "tabular-nums";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Current);
        hc.Add(Total);
    }
}
