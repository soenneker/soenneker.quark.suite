@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<button @onclick="(_cachedHandleClickDelegate ??= HandleClick)" @attributes="BuildAttributes()">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @:Next
    }
</button>

@code {
    private (string Size, string Focus, string Variant, string? BaseClass)? _buttonClassKey;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = Quark.ButtonSize.Default;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Items.Center;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private string? _lastBuiltClass;

    private Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    [CascadingParameter]
    internal Questionnaire? ParentQuestionnaire { get; set; }

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Default;

    [Parameter]
    public CssValue<ButtonSizeBuilder>? ButtonSize { get; set; } = _staticCss0;

    [Parameter]
    public bool Disabled { get; set; }

    private bool Visible => ParentQuestionnaire is { EnabledItemCount: > 1, IsLast: false };
    private Task HandleClick(MouseEventArgs args) => ParentQuestionnaire?.GoNext() ?? Task.CompletedTask;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "questionnaire-next";
        Display ??= _defaultDisplay;
        ItemsAlign ??= _defaultItemsAlign;
        Justify ??= _defaultJustify;
        Shrink ??= _defaultShrink;
        Rounded ??= _defaultRounded;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Whitespace ??= _defaultWhitespace;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        Border ??= _defaultBorder;
        UserSelect ??= _defaultUserSelect;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["aria-keyshortcuts"] = "Enter";
        attributes["type"] = "button";
        attributes["data-variant"] = Variant.Value;
        attributes["data-size"] = ButtonSize?.ToString() ?? "default";
        if (Disabled) attributes["disabled"] = QuarkAttributeValues.True;
        var focusClass = Button.GetButtonFocusClass(Variant);
        var sizeClass = Button.GetButtonSizeClass(ButtonSize);
        attributes.TryGetValue("class", out var baseClass);
        var key = (sizeClass, focusClass, Variant.Class, baseClass?.ToString());
        if (_buttonClassKey == key && _lastBuiltClass is not null)
            attributes["class"] = _lastBuiltClass;
        else
        {
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendClass(ref cls, "group/button bg-clip-padding focus-visible:ring-3 active:not-aria-[haspopup]:translate-y-px");
                AppendClass(ref cls, focusClass);
                AppendClass(ref cls, Variant.Class);
                AppendClass(ref cls, sizeClass);
                AppendClass(ref cls, "col-start-3 row-start-1 min-h-11 justify-self-end sm:min-h-0");
                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass);
            }
            finally
            {
                cls.Dispose();
            }
        }
        _buttonClassKey = key;
        if (!Visible)
        {
            attributes["hidden"] = QuarkAttributeValues.True;
            attributes["inert"] = QuarkAttributeValues.True;
            attributes["aria-hidden"] = "true";
            attributes["tabindex"] = QuarkAttributeValues.MinusOne;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Visible);
        hc.Add(Disabled);
        hc.Add(Variant);
        hc.Add(ButtonSize);
    }
}
