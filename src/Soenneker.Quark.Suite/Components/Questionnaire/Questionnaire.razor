@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<CascadingValue Value="@this" IsFixed="false">
    <form @onsubmit="(_cachedHandleSubmitDelegate ??= HandleSubmit)" @onsubmit:preventDefault @onreset="(_cachedHandleResetDelegate ??= HandleReset)" @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)" @attributes="BuildAttributes()">
        @ChildContent
    </form>
</CascadingValue>

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is4;
    private System.Func<Task>? _cachedHandleSubmitDelegate;
    private System.Func<Task>? _cachedHandleResetDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private readonly List<QuestionnaireItem> _items = [];
    private QuestionnaireItem[] _enabledItems = [];
    private string? _currentItem;
    private QuestionnaireItem? _focusPending;
    private int _version;

    [Parameter]
    public string? DefaultItem { get; set; }

    [Parameter]
    public string? Item { get; set; }

    [Parameter]
    public EventCallback<string> ItemChanged { get; set; }

    [Parameter]
    public QuestionnaireShortcutMode Shortcuts { get; set; }

    [Parameter]
    public EventCallback<QuestionnaireSubmitEventArgs> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    internal IReadOnlyList<QuestionnaireItem> EnabledItems
    {
        get
        {
            var count = 0;
            var unchanged = true;
            for (var index = 0; index < _items.Count; index++)
            {
                var item = _items[index];
                if (item.Disabled) continue;
                if (count >= _enabledItems.Length || !ReferenceEquals(_enabledItems[count], item))
                    unchanged = false;
                count++;
            }
            if (unchanged && count == _enabledItems.Length) return _enabledItems;

            var snapshot = new QuestionnaireItem[count];
            var target = 0;
            for (var index = 0; index < _items.Count; index++)
            {
                var item = _items[index];
                if (!item.Disabled) snapshot[target++] = item;
            }
            return _enabledItems = snapshot;
        }
    }

    internal int EnabledItemCount
    {
        get
        {
            var count = 0;
            foreach (var item in _items)
            {
                if (!item.Disabled)
                    count++;
            }
            return count;
        }
    }

    internal QuestionnaireItem? ActiveItem
    {
        get
        {
            QuestionnaireItem? first = null;
            var activeName = Item ?? _currentItem ?? DefaultItem;
            foreach (var item in _items)
            {
                if (item.Disabled)
                    continue;
                first ??= item;
                if (string.Equals(item.Name, activeName, StringComparison.Ordinal))
                    return item;
            }
            return first;
        }
    }

    internal int CurrentIndex
    {
        get
        {
            var activeName = Item ?? _currentItem ?? DefaultItem;
            var index = 0;
            foreach (var item in _items)
            {
                if (item.Disabled)
                    continue;
                if (string.Equals(item.Name, activeName, StringComparison.Ordinal))
                    return index;
                index++;
            }
            return index == 0 ? -1 : 0;
        }
    }

    internal bool IsFirst => CurrentIndex <= 0;

    internal bool IsLast
    {
        get
        {
            var index = CurrentIndex;
            return index >= 0 && index == EnabledItemCount - 1;
        }
    }

    internal void RegisterItem(QuestionnaireItem item)
    {
        if (_items.Contains(item))
            return;

        _items.Add(item);
        _currentItem ??= DefaultItem ?? item.Name;
    }

    internal void UnregisterItem(QuestionnaireItem item)
    {
        _items.Remove(item);
        if (string.Equals(_currentItem, item.Name, StringComparison.Ordinal))
            _currentItem = GetEnabledItemAt(0)?.Name;
    }

    internal Task GoPrevious()
    {
        var index = CurrentIndex;
        var previous = index > 0 ? GetEnabledItemAt(index - 1) : null;
        return previous is not null ? SetActiveItem(previous) : Task.CompletedTask;
    }

    internal async Task GoNext()
    {
        var active = ActiveItem;
        if (active is null || !await active.Validate())
            return;

        var index = CurrentIndex;
        var next = index >= 0 ? GetEnabledItemAt(index + 1) : null;
        if (next is not null)
            await SetActiveItem(next);
    }

    internal async Task SkipCurrent()
    {
        var active = ActiveItem;
        if (active is null || active.Required)
            return;

        await active.Skip();
        var next = GetEnabledItemAt(CurrentIndex + 1);
        if (next is not null)
            await SetActiveItem(next);
        else
            await SubmitValidated();
    }

    internal void RequestRefresh()
    {
        _version++;
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending is not null)
        {
            var item = _focusPending;
            _focusPending = null;
            await item.Focus();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task SetActiveItem(QuestionnaireItem item)
    {
        if (!string.Equals(Item, item.Name, StringComparison.Ordinal))
            _currentItem = item.Name;

        if (ItemChanged.HasDelegate)
            await ItemChanged.InvokeAsync(item.Name);

        _focusPending = item;
        _version++;
        Refresh();
    }

    private Task HandleSubmit() => SubmitValidated();

    private async Task SubmitValidated()
    {
        foreach (var item in EnabledItems)
        {
            if (!await item.Validate())
            {
                await SetActiveItem(item);
                return;
            }
        }

        if (!OnSubmit.HasDelegate)
            return;

        var answers = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal);
        foreach (var item in _items)
        {
            if (item.Disabled || item.Status == QuestionnaireItemStatus.Skipped)
                continue;

            var values = item.GetAnswers();
            if (values.Count > 0)
                answers[item.Name] = values;
        }

        await OnSubmit.InvokeAsync(new QuestionnaireSubmitEventArgs(answers));
    }

    private async Task HandleReset()
    {
        foreach (var item in _items.ToArray())
            await item.Reset();

        var first = FindEnabled(DefaultItem) ?? GetEnabledItemAt(0);
        if (first is not null)
            await SetActiveItem(first);

        if (OnReset.HasDelegate)
            await OnReset.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (Shortcuts == QuestionnaireShortcutMode.None || args.CtrlKey || args.MetaKey || args.AltKey || args.Key.Length != 1)
            return;

        var active = ActiveItem;
        if (active is null)
            return;

        await active.SelectShortcut(args.Key);
    }

    private QuestionnaireItem? GetEnabledItemAt(int index)
    {
        foreach (var item in _items)
        {
            if (!item.Disabled && index-- == 0)
                return item;
        }
        return null;
    }

    private QuestionnaireItem? FindEnabled(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return null;

        foreach (var item in _items)
        {
            if (!item.Disabled && string.Equals(item.Name, name, StringComparison.Ordinal))
                return item;
        }

        return null;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "questionnaire";
        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Width ??= _defaultWidth;
        MinWidth ??= _staticCss0;
        Gap ??= _defaultGap;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["novalidate"] = QuarkAttributeValues.True;
        if (Shortcuts != QuestionnaireShortcutMode.None)
            attributes["data-shortcuts"] = Shortcuts == QuestionnaireShortcutMode.Letters ? "letters" : "numbers";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(DefaultItem);
        hc.Add(Item);
        hc.Add(_currentItem);
        hc.Add(_version);
        hc.Add(Shortcuts);
    }
}
