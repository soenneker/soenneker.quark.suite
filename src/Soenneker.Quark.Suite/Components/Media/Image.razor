@using Soenneker.Utils.PooledStringBuilders
@namespace Soenneker.Quark
@inherits Soenneker.Quark.MediaElement
@implements IImage

@if (ChildContent is null)
{
    <img @attributes="BuildAttributes()" />
}
else
{
    <CascadingValue Value="@Context" IsFixed="false">
        <Dialog ShowBackdrop="true" TrapFocus="true">
            <div @attributes="BuildRootAttributes()">
                @ChildContent
            </div>
        </Dialog>
    </CascadingValue>
}

@code {
    [Parameter]
    public CssValue<ObjectFitBuilder>? ObjectFit { get; set; }

    [Parameter]
    public CssValue<ObjectPositionBuilder>? ObjectPosition { get; set; }

    private QuarkInt32Attribute _IntrinsicHeightAttribute;
    private QuarkInt32Attribute _IntrinsicWidthAttribute;
    private string? _appendedClass0;
    private string? _lastBuiltClass;

    private static readonly IReadOnlyList<int> DefaultSrcSetWidths = ImageSources.DefaultWidths;
    private QuarkAttributeDictionary _rootAttributes;
    private ImageContext? _context;
    private string? _resolvedSource;
    private string? _resolvedSourceInput;
    private string? _resolvedExtensionInput;
    private string? _resolvedBase64Input;
    private string? _resolvedMediaTypeInput;
    private IThemeInterop? _variantTheme;
    private bool _variantThemeInitialized;

    [Inject]
    private IServiceProvider ImageServices { get; set; } = null!;

    [Parameter]
    public int? IntrinsicWidth { get; set; }

    [Parameter]
    public int? IntrinsicHeight { get; set; }

    [Parameter]
    public bool AutoSrcSet { get; set; }

    [Parameter]
    public bool AutoDark { get; set; }

    [Parameter]
    public IReadOnlyList<int> SrcSetWidths { get; set; } = DefaultSrcSetWidths;

    private string? EffectiveExtension => Extension ?? (AutoSrcSet ? "avif" : null);
    private string? EffectiveDecoding => Decoding ?? (AutoSrcSet ? "async" : null);

    private string? _darkSourceInput, _darkSource;
    private string? EffectiveSource
    {
        get
        {
            var source = ResolvedSource;
            if (!AutoDark || _variantTheme?.IsDark != true) return source;
            if (_darkSourceInput != source)
            {
                _darkSourceInput = source;
                _darkSource = ImageSources.AddImageSuffix(source, "-dark", true);
            }
            return _darkSource;
        }
    }

    private ImageSrcSetCache _srcSetCache;
    private string? EffectiveSrcSet => SrcSet.HasContent() || !AutoSrcSet ? SrcSet : _srcSetCache.Get(EffectiveSource, SrcSetWidths);

    private string? GetEffectiveSizes(string? srcSet) => Sizes ?? (AutoSrcSet && srcSet.HasContent() ? "100vw" : null);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (AutoDark && _variantTheme is null)
        {
            _variantTheme = ImageServices.GetService(typeof(IThemeInterop)) as IThemeInterop
                ?? throw new InvalidOperationException("Image.AutoDark requires AddQuarkThemeAsScoped or AddQuarkSuiteAsScoped.");
            _variantTheme.ThemeChanged += OnVariantThemeChanged;
        }
        else if (!AutoDark && _variantTheme is not null)
        {
            _variantTheme.ThemeChanged -= OnVariantThemeChanged;
            _variantTheme = null;
            _variantThemeInitialized = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_variantTheme is not null && !_variantThemeInitialized)
        {
            _variantThemeInitialized = true;
            await _variantTheme.Initialize();
            if (!IsDisposed)
                Refresh();
        }
    }

    private void OnVariantThemeChanged(bool isDark) => _ = InvokeAsync(() =>
    {
        if (!IsDisposed)
            Refresh();
    });

    public override async ValueTask DisposeAsync()
    {
        if (_variantTheme is not null)
            _variantTheme.ThemeChanged -= OnVariantThemeChanged;
        await base.DisposeAsync();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "image";
    }

    [Parameter]
    public string? Extension { get; set; }

    [Parameter]
    public string? Base64 { get; set; }

    [Parameter]
    public string? MediaType { get; set; }

    /// <summary>
    /// Gets or sets whether the image should be fluid (responsive).
    /// </summary>
    [Parameter]
    public bool Fluid { get; set; }

    /// <summary>
    /// Gets or sets the loading attribute value.
    /// </summary>
    [Parameter]
    public string? Loading { get; set; }

    /// <summary>
    /// Gets or sets the decoding attribute value.
    /// </summary>
    [Parameter]
    public string? Decoding { get; set; }

    /// <summary>
    /// Gets or sets the fetchpriority attribute value.
    /// </summary>
    [Parameter]
    public string? FetchPriority { get; set; }

    /// <summary>
    /// Gets or sets the sizes attribute value.
    /// </summary>
    [Parameter]
    public string? Sizes { get; set; }

    /// <summary>
    /// Gets or sets the srcset attribute value.
    /// </summary>
    [Parameter]
    public string? SrcSet { get; set; }

    /// <summary>
    /// Gets or sets the crossorigin attribute value.
    /// </summary>
    [Parameter]
    public string? CrossOrigin { get; set; }

    /// <summary>
    /// Gets or sets the referrerpolicy attribute value.
    /// </summary>
    [Parameter]
    public string? ReferrerPolicy { get; set; }

    /// <summary>
    /// Gets or sets the usemap attribute value.
    /// </summary>
    [Parameter]
    public string? UseMap { get; set; }

    /// <summary>
    /// Gets or sets whether the image is a server-side image map.
    /// </summary>
    [Parameter]
    public bool IsMap { get; set; }

    /// <summary>
    /// Gets or sets the longdesc attribute value.
    /// </summary>
    [Parameter]
    public string? LongDesc { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the image loads.
    /// </summary>
    [Parameter]
    public EventCallback<ProgressEventArgs> OnLoad { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the image fails to load.
    /// </summary>
    [Parameter]
    public EventCallback<ErrorEventArgs> OnError { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the image starts loading.
    /// </summary>
    [Parameter]
    public EventCallback<ProgressEventArgs> OnLoadStart { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the image load is aborted.
    /// </summary>
    [Parameter]
    public EventCallback<ProgressEventArgs> OnAbort { get; set; }

    private string? ResolvedSource
    {
        get
        {
            if (string.Equals(_resolvedSourceInput, Source, StringComparison.Ordinal) &&
                string.Equals(_resolvedExtensionInput, EffectiveExtension, StringComparison.Ordinal) &&
                string.Equals(_resolvedBase64Input, Base64, StringComparison.Ordinal) &&
                string.Equals(_resolvedMediaTypeInput, MediaType, StringComparison.Ordinal))
                return _resolvedSource;

            _resolvedSourceInput = Source;
            _resolvedExtensionInput = EffectiveExtension;
            _resolvedBase64Input = Base64;
            _resolvedMediaTypeInput = MediaType;
            _resolvedSource = Source.HasContent() ? ImageSources.ApplyExtension(Source, EffectiveExtension) :
                Base64.HasContent() ? $"data:{(MediaType.HasContent() ? MediaType : "image/png")};base64,{Base64}" :
                null;
            return _resolvedSource;
        }
    }

    private ImageContext Context
    {
        get
        {
            var source = EffectiveSource;
            var loading = GetLoadingAttribute();
            var srcSet = EffectiveSrcSet;
            var sizes = GetEffectiveSizes(srcSet);

            if (_context is null || !string.Equals(_context.Source, source, StringComparison.Ordinal) ||
                !string.Equals(_context.Alt, Alt, StringComparison.Ordinal) || !string.Equals(_context.Loading, loading, StringComparison.Ordinal) ||
                !string.Equals(_context.Decoding, EffectiveDecoding, StringComparison.Ordinal) || !string.Equals(_context.SrcSet, srcSet, StringComparison.Ordinal) ||
                !string.Equals(_context.Sizes, sizes, StringComparison.Ordinal) ||
                _context.IntrinsicWidth != IntrinsicWidth || _context.IntrinsicHeight != IntrinsicHeight)
            {
                _context = new ImageContext(source, Alt, loading, EffectiveDecoding, srcSet, sizes)
                {
                    IntrinsicWidth = IntrinsicWidth,
                    IntrinsicHeight = IntrinsicHeight
                };
            }

            return _context;
        }
    }

    private string? GetLoadingAttribute()
    {
        if (Lazy)
            return "lazy";

        return Loading ?? (AutoSrcSet ? "lazy" : null);
    }

    private string? GetFluidClass()
    {
        if (Fluid)
            return "w-full max-w-full h-auto";
        return null;
    }

    private Dictionary<string, object> BuildRootAttributes()
    {
        var attributes = _rootAttributes.Create(BuildAttributes());

        attributes.Remove("width");
        attributes.Remove("height");
        attributes.Remove("src");
        attributes.Remove("alt");
        attributes.Remove("loading");
        attributes.Remove("decoding");
        attributes.Remove("fetchpriority");
        attributes.Remove("sizes");
        attributes.Remove("srcset");
        attributes.Remove("crossorigin");
        attributes.Remove("referrerpolicy");
        attributes.Remove("usemap");
        attributes.Remove("ismap");
        attributes.Remove("longdesc");
        attributes.Remove("onload");
        attributes.Remove("onerror");
        attributes.Remove("onloadstart");
        attributes.Remove("onabort");

        AppendToClassAttr(attributes, "group/image relative inline-flex aspect-auto max-w-full min-w-64 flex-col overflow-hidden rounded-[20px] border dark:border-muted", ref _appendedClass0);

        return attributes;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var fluidClass = GetFluidClass();

        if (fluidClass != null)
        {
            PrependClassAttribute(attributes, fluidClass, ref _lastBuiltClass);
        }

        var resolvedSource = EffectiveSource;
        if (resolvedSource.HasContent())
            attributes["src"] = resolvedSource;

        if (IntrinsicWidth.HasValue)
            attributes["width"] = _IntrinsicWidthAttribute.Get(IntrinsicWidth.Value);
        if (IntrinsicHeight.HasValue)
            attributes["height"] = _IntrinsicHeightAttribute.Get(IntrinsicHeight.Value);

        attributes["alt"] = Alt ?? string.Empty;

        var loadingAttr = GetLoadingAttribute();
        if (loadingAttr.HasContent())
            attributes["loading"] = loadingAttr;

        if (EffectiveDecoding.HasContent())
            attributes["decoding"] = EffectiveDecoding;

        if (FetchPriority.HasContent())
            attributes["fetchpriority"] = FetchPriority;

        var srcSet = EffectiveSrcSet;
        var sizes = GetEffectiveSizes(srcSet);
        if (sizes.HasContent())
            attributes["sizes"] = sizes;

        if (srcSet.HasContent())
            attributes["srcset"] = srcSet;

        if (CrossOrigin.HasContent())
            attributes["crossorigin"] = CrossOrigin;

        if (ReferrerPolicy.HasContent())
            attributes["referrerpolicy"] = ReferrerPolicy;

        if (UseMap.HasContent())
            attributes["usemap"] = UseMap;

        if (IsMap)
            attributes["ismap"] = QuarkAttributeValues.True;

        if (LongDesc.HasContent())
            attributes["longdesc"] = LongDesc;

        if (OnLoad.HasDelegate)
            SetEventAttribute(attributes, "onload", EventCallback.Factory.Create(this, OnLoad));

        if (OnError.HasDelegate)
            SetEventAttribute(attributes, "onerror", EventCallback.Factory.Create(this, OnError));

        if (OnLoadStart.HasDelegate)
            SetEventAttribute(attributes, "onloadstart", EventCallback.Factory.Create(this, OnLoadStart));

        if (OnAbort.HasDelegate)
            SetEventAttribute(attributes, "onabort", EventCallback.Factory.Create(this, OnAbort));
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        AddIf(ref hc, ObjectFit);
        AddIf(ref hc, ObjectPosition);

        hc.Add(IntrinsicWidth);
        hc.Add(IntrinsicHeight);
        hc.Add(AutoSrcSet);
        hc.Add(AutoDark);
        hc.Add(EffectiveSource);
        for (int i = 0; i < SrcSetWidths.Count; i++)
            hc.Add(SrcSetWidths[i]);
        hc.Add(Extension);
        hc.Add(Base64);
        hc.Add(MediaType);
        hc.Add(Fluid);
        hc.Add(Loading);
        hc.Add(Decoding);
        hc.Add(FetchPriority);
        hc.Add(Sizes);
        hc.Add(SrcSet);
        hc.Add(CrossOrigin);
        hc.Add(ReferrerPolicy);
        hc.Add(UseMap);
        hc.Add(IsMap);
        hc.Add(LongDesc);
    }

    protected override void BuildOwnedClassAndStyle(ref PooledStringBuilder sty, ref PooledStringBuilder cls)
    {
        base.BuildOwnedClassAndStyle(ref sty, ref cls);
        var preset = AppliedPresetContext;
        AddCss(ref cls, ResolvePresetValue(ObjectFit, preset?.ObjectFit, nameof(ObjectFit)));
        AddCss(ref cls, ResolvePresetValue(ObjectPosition, preset?.ObjectPosition, nameof(ObjectPosition)));
    }
}
