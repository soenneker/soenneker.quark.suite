@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<Button Variant="@Variant" ButtonSize="@ButtonSize" Attributes="@BuildAttributes()"
        ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />

@code {
    private string? _composedClass;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = Soenneker.Quark.ButtonSize.IconSm;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "image-action";
    }

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;

    [Parameter]
    public CssValue<ButtonSizeBuilder>? ButtonSize { get; set; } = _staticCss0;

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        const string baseClass = "pointer-events-auto bg-background/90 shadow-xs backdrop-blur hover:bg-background";
        PrependClassAttribute(attributes, baseClass, ref _composedClass);
    }
}
