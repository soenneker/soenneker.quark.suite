@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<img @attributes="BuildPreviewAttributes()" />

@code {
    private QuarkInt32Attribute _widthAttribute, _heightAttribute;
    private string? _appendedClass0;
    [CascadingParameter]
    private ImageContext? ImageContext { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "image-lightbox-preview";
    }

    private Dictionary<string, object> BuildPreviewAttributes()
    {
        var attributes = BuildAttributes();
        if (ImageContext?.IntrinsicWidth is int width)
            attributes["width"] = _widthAttribute.Get(width);
        if (ImageContext?.IntrinsicHeight is int height)
            attributes["height"] = _heightAttribute.Get(height);
        attributes["src"] = ImageContext?.Source ?? string.Empty;
        attributes["alt"] = ImageContext?.Alt ?? string.Empty;
        AppendToClassAttr(attributes, "max-h-[85vh] max-w-[90vw] rounded-lg object-contain", ref _appendedClass0);
        return attributes;
    }
}
