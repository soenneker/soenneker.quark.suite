@namespace Soenneker.Quark
@inherits Soenneker.Quark.MediaElement
@implements IAudio

<audio @attributes="BuildAttributes()">
	@ChildContent
</audio>

@code {
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "audio";
    }


    /// <summary>
    /// Gets or sets whether the audio should autoplay.
    /// </summary>
    [Parameter]
    public bool Autoplay { get; set; }

    /// <summary>
    /// Gets or sets whether the audio should loop.
    /// </summary>
    [Parameter]
    public bool Loop { get; set; }

    /// <summary>
    /// Gets or sets whether the audio should be muted.
    /// </summary>
    [Parameter]
    public bool Muted { get; set; }

    /// <summary>
    /// Gets or sets whether to show audio controls.
    /// </summary>
    [Parameter]
    public bool Controls { get; set; } = true;

    /// <summary>
    /// Gets or sets the preload attribute value.
    /// </summary>
    [Parameter]
    public string? Preload { get; set; }

    /// <summary>
    /// Gets or sets the crossorigin attribute value.
    /// </summary>
    [Parameter]
    public string? CrossOrigin { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When audio metadata is loaded.
    /// </summary>
    [Parameter]
    public EventCallback<ProgressEventArgs> OnLoadedMetadata { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the audio can start playing.
    /// </summary>
    [Parameter]
    public EventCallback<EventArgs> OnCanPlay { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the audio starts playing.
    /// </summary>
    [Parameter]
    public EventCallback<EventArgs> OnPlay { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the audio is paused.
    /// </summary>
    [Parameter]
    public EventCallback<EventArgs> OnPause { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the audio ends.
    /// </summary>
    [Parameter]
    public EventCallback<EventArgs> OnEnded { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When an audio error occurs.
    /// </summary>
    [Parameter]
    public EventCallback<ErrorEventArgs> OnError { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the audio playback time updates.
    /// </summary>
    [Parameter]
    public EventCallback<EventArgs> OnTimeUpdate { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the audio volume changes.
    /// </summary>
    [Parameter]
    public EventCallback<EventArgs> OnVolumeChange { get; set; }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        // Add audio-specific attributes
        if (Source.HasContent())
            attributes["src"] = Source;

        if (Autoplay)
            attributes["autoplay"] = QuarkAttributeValues.True;

        if (Loop)
            attributes["loop"] = QuarkAttributeValues.True;

        if (Muted)
            attributes["muted"] = QuarkAttributeValues.True;

        if (Controls)
            attributes["controls"] = QuarkAttributeValues.True;

        if (Preload.HasContent())
            attributes["preload"] = Preload;

        if (CrossOrigin.HasContent())
            attributes["crossorigin"] = CrossOrigin;

        // Add event handlers
        if (OnLoadedMetadata.HasDelegate)
            SetEventAttribute(attributes, "onloadedmetadata", EventCallback.Factory.Create(this, OnLoadedMetadata));

        if (OnCanPlay.HasDelegate)
            SetEventAttribute(attributes, "oncanplay", EventCallback.Factory.Create(this, OnCanPlay));

        if (OnPlay.HasDelegate)
            SetEventAttribute(attributes, "onplay", EventCallback.Factory.Create(this, OnPlay));

        if (OnPause.HasDelegate)
            SetEventAttribute(attributes, "onpause", EventCallback.Factory.Create(this, OnPause));

        if (OnEnded.HasDelegate)
            SetEventAttribute(attributes, "onended", EventCallback.Factory.Create(this, OnEnded));

        if (OnError.HasDelegate)
            SetEventAttribute(attributes, "onerror", EventCallback.Factory.Create(this, OnError));

        if (OnTimeUpdate.HasDelegate)
            SetEventAttribute(attributes, "ontimeupdate", EventCallback.Factory.Create(this, OnTimeUpdate));

        if (OnVolumeChange.HasDelegate)
            SetEventAttribute(attributes, "onvolumechange", EventCallback.Factory.Create(this, OnVolumeChange));
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Autoplay);
        hc.Add(Loop);
        hc.Add(Muted);
        hc.Add(Controls);
        hc.Add(Preload);
        hc.Add(CrossOrigin);
        hc.Add(OnLoadedMetadata);
        hc.Add(OnCanPlay);
        hc.Add(OnPlay);
        hc.Add(OnPause);
        hc.Add(OnEnded);
        hc.Add(OnError);
        hc.Add(OnTimeUpdate);
        hc.Add(OnVolumeChange);
    }
}
