@using Soenneker.Utils.PooledStringBuilders
@namespace Soenneker.Quark
@inherits Soenneker.Quark.MediaElement
@implements ISvg

<svg @attributes="BuildAttributes()">
    @ChildContent
</svg>

@code {
    [Parameter]
    public CssValue<StrokeWidthBuilder>? StrokeWidth { get; set; }

    [Parameter]
    public CssValue<FillBuilder>? Fill { get; set; }

    [Parameter]
    public CssValue<FillRuleBuilder>? FillRule { get; set; }

    [Parameter]
    public CssValue<StrokeBuilder>? Stroke { get; set; }

    [Parameter]
    public CssValue<StrokeLineCapBuilder>? StrokeLineCap { get; set; }

    [Parameter]
    public CssValue<StrokeLineJoinBuilder>? StrokeLineJoin { get; set; }

    [Parameter]
    public CssValue<StrokeWidthBuilder>? SvgStrokeWidth { get; set; }

    /// <summary>
    /// Gets or sets the SVG namespace attribute.
    /// </summary>
    [Parameter]
    public string? Xmlns { get; set; } = "http://www.w3.org/2000/svg";

    /// <summary>
    /// Gets or sets the SVG viewBox attribute.
    /// </summary>
    [Parameter]
    public string? ViewBox { get; set; } = "0 0 24 24";

    /// <summary>
    /// Gets or sets the native SVG width attribute. Use the inherited <see cref="Component.Width" /> parameter for Quark/Tailwind width utilities.
    /// </summary>
    [Parameter]
    public string? NativeWidth { get; set; }

    /// <summary>
    /// Gets or sets the native SVG height attribute. Use the inherited <see cref="Component.Height" /> parameter for Quark/Tailwind height utilities.
    /// </summary>
    [Parameter]
    public string? NativeHeight { get; set; }

    /// <summary>
    /// Gets or sets the preserveAspectRatio attribute.
    /// </summary>
    [Parameter]
    public string? PreserveAspectRatio { get; set; }

    /// <summary>
    /// Gets or sets the focusable attribute.
    /// </summary>
    [Parameter]
    public bool? Focusable { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "svg";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Xmlns.HasContent())
            attributes["xmlns"] = Xmlns!;

        if (ViewBox.HasContent())
            attributes["viewBox"] = ViewBox!;

        if (NativeWidth.HasContent())
            attributes["width"] = NativeWidth!;

        if (NativeHeight.HasContent())
            attributes["height"] = NativeHeight!;

        if (PreserveAspectRatio.HasContent())
            attributes["preserveAspectRatio"] = PreserveAspectRatio!;

        if (Focusable.HasValue)
            attributes["focusable"] = Focusable.Value ? "true" : "false";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        AddIf(ref hc, StrokeWidth);
        AddIf(ref hc, Fill);
        AddIf(ref hc, FillRule);
        AddIf(ref hc, Stroke);
        AddIf(ref hc, StrokeLineCap);
        AddIf(ref hc, StrokeLineJoin);
        AddIf(ref hc, SvgStrokeWidth);

        hc.Add(Xmlns);
        hc.Add(ViewBox);
        hc.Add(NativeWidth);
        hc.Add(NativeHeight);
        hc.Add(PreserveAspectRatio);
        hc.Add(Focusable);
    }

    protected override void BuildOwnedClassAndStyle(ref PooledStringBuilder sty, ref PooledStringBuilder cls)
    {
        base.BuildOwnedClassAndStyle(ref sty, ref cls);
        var preset = AppliedPresetContext;
        AddCss(ref cls, StrokeWidth);
        AddCss(ref cls, ResolvePresetValue(Fill, preset?.Fill, nameof(Fill)));
        AddCss(ref cls, ResolvePresetValue(FillRule, preset?.FillRule, nameof(FillRule)));
        AddCss(ref cls, ResolvePresetValue(Stroke, preset?.Stroke, nameof(Stroke)));
        AddCss(ref cls, ResolvePresetValue(StrokeLineCap, preset?.StrokeLineCap, nameof(StrokeLineCap)));
        AddCss(ref cls, ResolvePresetValue(StrokeLineJoin, preset?.StrokeLineJoin, nameof(StrokeLineJoin)));
        AddCss(ref cls, ResolvePresetValue(SvgStrokeWidth, preset?.SvgStrokeWidth, nameof(SvgStrokeWidth)));
    }
}
