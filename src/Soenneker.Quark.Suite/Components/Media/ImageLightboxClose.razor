@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<DialogClose Variant="ButtonVariant.Ghost" ButtonSize="_staticCss0" Attributes="@BuildAttributes()">
    @if (ChildContent is null)
    {
        <Icon Name="LucideIcon.X" />
        <Span ScreenReader="_renderCss0">Close</Span>
    }
    else
    {
        @ChildContent
    }
</DialogClose>

@code {
    private string? _composedClass;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = ButtonSize.Icon;
    private static readonly CssValue<ScreenReaderBuilder> _renderCss0 = Quark.ScreenReader.Only;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "image-lightbox-close";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        const string baseClass = "text-white hover:bg-white/10 hover:text-white";
        PrependClassAttribute(attributes, baseClass, ref _composedClass);
    }
}
