@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IAudioControls

<div @attributes="BuildAttributes()">
    <Div Display="_staticDisplay0" ItemsAlign="_staticItemsAlign1" Gap="_staticGap2" Rounded="_staticRounded3"
         BackgroundColor="_staticBackgroundColor4"
         Width="@(Compact ? _compactWidth : _fullWidth)" MinHeight="@BarMinHeight"
         Padding="@(Compact ? _compactPadding : _fullPadding)" TextColor="_staticTextColor5"
         Class="data-[disabled=true]:opacity-50" data-disabled="@(Disabled ? "true" : "false")">
        <Button Shrink="_staticShrink6" TextColor="_staticTextColor5" Variant="ButtonVariant.Ghost" ButtonSize="ButtonSize.IconSm" Rounded="_staticRounded3"
                Disabled="@Disabled" title="@PlaybackLabel" aria-label="@PlaybackLabel"
                OnClick="OnTogglePlayback">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                @if (!IsPlaying)
                {
                    <path d="M8 5v14l11-7z" />
                }
                else if (StopInsteadOfPause)
                {
                    <path d="M6 6h12v12H6z" />
                }
                else
                {
                    <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
                }
            </svg>
        </Button>
        @if (!Compact)
        {
            <Span Shrink="_staticShrink6" Whitespace="_staticWhitespace7" TextSize="_staticTextSize8" FontWeight="_staticFontWeight9" FontVariantNumeric="_staticFontVariantNumeric10">@CurrentTimeText / @DurationText</Span>
            <Div Class="group/seek" MinWidth="_seekMinWidth" Flex="_staticFlex11">
                <Slider Class="[&_[data-slot=slider-track]]:bg-foreground/20 [&_[data-slot=slider-thumb]]:opacity-0 [&_[data-slot=slider-thumb]]:transition-opacity group-hover/seek:[&_[data-slot=slider-thumb]]:opacity-100 group-focus-within/seek:[&_[data-slot=slider-thumb]]:opacity-100 motion-reduce:[&_[data-slot=slider-thumb]]:transition-none" MinHeight="_sliderMinHeight" Min="0" Max="@Math.Max(SafeDuration, 1)" Step="1"
                        SliderValue="@Math.Clamp(SafeSeconds(CurrentTime), 0, SafeDuration)"
                        SliderValueChanged="CurrentTimeChanged" Disabled="@(Disabled || !CanSeek || SafeDuration <= 0)"
                        Label="Playback position" />
            </Div>
            <ContentRenderBoundary Version="@((SafeVolume, Disabled, VolumeChanged))">
            <Div Display="_staticDisplay0" ItemsAlign="_staticItemsAlign1" Class="group/volume" Shrink="_staticShrink6">
                <Button Shrink="_staticShrink6" TextColor="_staticTextColor5" Variant="ButtonVariant.Ghost" ButtonSize="ButtonSize.IconSm" Rounded="_staticRounded3"
                        Disabled="@Disabled" title="@(SafeVolume > 0 ? "Mute" : "Unmute")" aria-label="@(SafeVolume > 0 ? "Mute" : "Unmute")"
                        OnClick="ToggleMute">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" stroke="none" />
                        @if (SafeVolume > 0)
                        {
                            <path d="M15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14" />
                        }
                        else
                        {
                            <path d="m16 9 6 6m0-6-6 6" />
                        }
                    </svg>
                </Button>
                <Div Class="order-first transition-[width,opacity] ease-out group-hover/volume:visible group-hover/volume:w-20 group-hover/volume:opacity-100 group-focus-within/volume:visible group-focus-within/volume:w-20 group-focus-within/volume:opacity-100 motion-reduce:transition-none" Visibility="_staticVisibility12" Width="_staticWidth13" Overflow="_staticOverflow14" Opacity="_staticOpacity15" Duration="_staticDuration16">
                    <Div Width="_staticWidth17" Padding="_staticPadding18">
                        <Slider Class="[&_[data-slot=slider-track]]:bg-foreground/20" MinHeight="_sliderMinHeight" Min="0" Max="1" Step="0.01" SliderValue="@SafeVolume"
                                SliderValueChanged="VolumeChanged" Disabled="@Disabled" Label="Volume" />
                    </Div>
                </Div>
            </Div>
            </ContentRenderBoundary>
        }
    </Div>
    @ChildContent
</div>
@code {
    private static readonly CssValue<MinWidthBuilder> _seekMinWidth = Quark.MinWidth.Token("8");
    private static readonly CssValue<MinHeightBuilder> _sliderMinHeight = Quark.MinHeight.Token("7");
    private static readonly CssValue<DisplayBuilder> _staticDisplay0 = Quark.Display.Flex;
    private static readonly CssValue<ItemsBuilder> _staticItemsAlign1 = Items.Center;
    private static readonly CssValue<GapBuilder> _staticGap2 = Quark.Gap.Is2.OnSm.Is3;
    private static readonly CssValue<RoundedBuilder> _staticRounded3 = Quark.Rounded.Full;
    private static readonly CssValue<BackgroundColorBuilder> _staticBackgroundColor4 = Quark.BackgroundColor.Secondary;
    private static readonly CssValue<TextColorBuilder> _staticTextColor5 = Quark.TextColor.Foreground;
    private static readonly CssValue<ShrinkBuilder> _staticShrink6 = Quark.Shrink.Is0;
    private static readonly CssValue<WhitespaceBuilder> _staticWhitespace7 = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TextSizeBuilder> _staticTextSize8 = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _staticFontWeight9 = Quark.FontWeight.Normal;
    private static readonly CssValue<FontVariantNumericBuilder> _staticFontVariantNumeric10 = Quark.FontVariantNumeric.TabularNums;
    private static readonly CssValue<FlexBuilder> _staticFlex11 = Quark.Flex.Is1;
    private static readonly CssValue<VisibilityBuilder> _staticVisibility12 = Quark.Visibility.Invisible;
    private static readonly CssValue<WidthBuilder> _staticWidth13 = Quark.Width.Is0;
    private static readonly CssValue<OverflowBuilder> _staticOverflow14 = Quark.Overflow.Hidden;
    private static readonly CssValue<OpacityBuilder> _staticOpacity15 = Quark.Opacity.Is0;
    private static readonly CssValue<DurationBuilder> _staticDuration16 = Quark.Duration.Is200;
    private static readonly CssValue<WidthBuilder> _staticWidth17 = Quark.Width.Is20;
    private static readonly CssValue<PaddingBuilder> _staticPadding18 = Quark.Padding.OnX.Is2;
    private long _currentSecond = -1, _durationSecond = -1;
    private string _currentTimeText = "0:00", _durationText = "0:00";
    private string CurrentTimeText => CachedTime(CurrentTime, ref _currentSecond, ref _currentTimeText);
    private string DurationText => CachedTime(MediaDuration, ref _durationSecond, ref _durationText);
    private static string CachedTime(double value, ref long previous, ref string text)
    {
        long second = (long)SafeSeconds(value);
        if (second != previous)
        {
            previous = second;
            text = FormatTime(second);
        }
        return text;
    }

    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public double MediaDuration { get; set; }
    [Parameter] public double CurrentTime { get; set; }
    [Parameter] public double Volume { get; set; } = 0.5;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool StopInsteadOfPause { get; set; }
    [Parameter] public bool CanSeek { get; set; } = true;
    [Parameter] public EventCallback OnTogglePlayback { get; set; }
    [Parameter] public EventCallback<double> CurrentTimeChanged { get; set; }
    [Parameter] public EventCallback<double> VolumeChanged { get; set; }

    private static readonly CssValue<WidthBuilder> _compactWidth = Quark.Width.IsFit;
    private static readonly CssValue<WidthBuilder> _fullWidth = Quark.Width.IsFull;
    private static readonly CssValue<MinHeightBuilder> _fullMinHeight = Quark.MinHeight.Token("14");
    private static readonly CssValue<PaddingBuilder> _compactPadding = Quark.Padding.Is2;
    private static readonly CssValue<PaddingBuilder> _fullPadding = CssValue<PaddingBuilder>.For(Quark.Padding.OnX.Is3, Quark.Padding.OnY.Is2);
    private CssValue<MinHeightBuilder>? BarMinHeight => Compact ? (CssValue<MinHeightBuilder>?)null : _fullMinHeight;

    private double _volumeBeforeMute = 0.5;

    private Task ToggleMute()
    {
        if (SafeVolume > 0)
        {
            _volumeBeforeMute = SafeVolume;
            return VolumeChanged.InvokeAsync(0);
        }

        return VolumeChanged.InvokeAsync(_volumeBeforeMute);
    }

    private string PlaybackLabel => IsPlaying ? (StopInsteadOfPause ? "Stop" : "Pause") : "Play";
    private double SafeDuration => SafeSeconds(MediaDuration);
    private double SafeVolume => double.IsFinite(Volume) ? Math.Clamp(Volume, 0, 1) : 0;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "audio-controls";
        Width ??= _fullWidth;
    }

    private static double SafeSeconds(double value) => double.IsFinite(value) ? Math.Clamp(value, 0, TimeSpan.MaxValue.TotalSeconds - 1) : 0;

    private static string FormatTime(double seconds)
    {
        var time = TimeSpan.FromSeconds(SafeSeconds(seconds));
        return time.TotalHours >= 1 ? $"{(long)time.TotalHours}:{time.Minutes:00}:{time.Seconds:00}" : $"{time.Minutes}:{time.Seconds:00}";
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(IsPlaying);
        hc.Add(MediaDuration);
        hc.Add(CurrentTime);
        hc.Add(Volume);
        hc.Add(Disabled);
        hc.Add(Compact);
        hc.Add(StopInsteadOfPause);
        hc.Add(CanSeek);
        hc.Add(OnTogglePlayback);
        hc.Add(CurrentTimeChanged);
        hc.Add(VolumeChanged);
    }
}
