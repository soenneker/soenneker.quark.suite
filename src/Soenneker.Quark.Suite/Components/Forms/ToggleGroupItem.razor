@namespace Soenneker.Quark
@using Soenneker.Bradix
@inherits Soenneker.Quark.FormControlElement

<BradixToggleGroupItem Value="@ResolvedValue"
                       Disabled="@Disabled"
                       AdditionalAttributes="@ItemAttributes">
    @ChildContent
</BradixToggleGroupItem>

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        var variant = Variant ?? ParentToggleGroup?.Variant ?? ToggleVariant.Default;
        var size = ToggleSize ?? ParentToggleGroup?.ToggleSize ?? "default";
        var isRtl = string.Equals(ParentToggleGroup?.ResolvedDirection, "rtl", StringComparison.OrdinalIgnoreCase);
        var variantClass = Toggle.GetToggleVariantClass(variant);
        var sizeClass = Toggle.ResolveToggleSizeClass(size, includeShrink: true, isRtl);
        var horizontalEdgeClasses = isRtl ? "group-data-[spacing=0]/toggle-group:has-data-[icon=inline-end]:pe-1.5 group-data-[spacing=0]/toggle-group:has-data-[icon=inline-start]:ps-1.5 group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:first:rounded-s-lg group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:last:rounded-e-lg group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:data-[variant=outline]:border-s-0 group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:data-[variant=outline]:first:border-s" : "group-data-[spacing=0]/toggle-group:has-data-[icon=inline-end]:pr-1.5 group-data-[spacing=0]/toggle-group:has-data-[icon=inline-start]:pl-1.5 group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:first:rounded-l-lg group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:last:rounded-r-lg group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:data-[variant=outline]:border-l-0 group-data-[orientation=horizontal]/toggle-group:data-[spacing=0]:data-[variant=outline]:first:border-l";
        AppendClass(ref cls, "shrink-0 group-data-[spacing=0]/toggle-group:rounded-none group-data-[spacing=0]/toggle-group:px-2 focus:z-10 focus-visible:z-10");
        AppendClass(ref cls, horizontalEdgeClasses);
        AppendClass(ref cls, "group-data-[orientation=vertical]/toggle-group:data-[spacing=0]:first:rounded-t-lg group-data-[orientation=vertical]/toggle-group:data-[spacing=0]:last:rounded-b-lg group-data-[orientation=vertical]/toggle-group:data-[spacing=0]:data-[variant=outline]:border-t-0 group-data-[orientation=vertical]/toggle-group:data-[spacing=0]:data-[variant=outline]:first:border-t group/toggle");
        AppendClass(ref cls, "hover:text-foreground focus-visible:ring-[3px] aria-invalid:border-destructive aria-invalid:ring-destructive/20 aria-pressed:bg-muted data-[state=on]:bg-muted dark:aria-invalid:ring-destructive/40");
        AppendClass(ref cls, "[&_svg]:pointer-events-none [&_svg]:shrink-0");
        AppendClass(ref cls, variantClass);
        AppendClass(ref cls, sizeClass);
    }

    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.OnFocusVisible.Ring;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;

    [CascadingParameter(Name = "ParentToggleGroup")]
    private ToggleGroup? ParentToggleGroup { get; set; }

    /// <summary>
    /// Gets or sets visual variant (overrides group).
    /// </summary>
    [Parameter]
    public ToggleVariant? Variant { get; set; }

    /// <summary>
    /// Gets or sets size (overrides group).
    /// </summary>
    [Parameter]
    public CssValue<ToggleSizeBuilder>? ToggleSize { get; set; }

    private QuarkAttributeDictionary _itemAttributesBuffer;

    private string ResolvedValue => Value ?? string.Empty;

    private IReadOnlyDictionary<string, object> ItemAttributes
    {
        get
        {
            var variant = Variant ?? ParentToggleGroup?.Variant ?? ToggleVariant.Default;
            var size = ToggleSize ?? ParentToggleGroup?.ToggleSize ?? "default";
            var attributes = _itemAttributesBuffer.Create(BuildAttributes(), 5);

            attributes.Remove("disabled");
            attributes.Remove("value");
            attributes.Remove("type");
            attributes.Remove("aria-pressed");
            attributes.Remove("data-state");
            attributes.Remove("tabindex");
            attributes.Remove("onclick");
            attributes.Remove("onkeydown");
            attributes.Remove("onfocus");

            attributes["data-value"] = ResolvedValue;
            attributes["data-state"] = ParentToggleGroup?.IsItemPressed(ResolvedValue) == true ? "on" : "off";
            attributes["data-variant"] = ReferenceEquals(variant, ToggleVariant.Outline) ? "outline" : "default";
            attributes["data-size"] = GetToggleSizeDataAttribute(size);
            attributes["data-spacing"] = ParentToggleGroup?.SpacingText ?? "0";



            return attributes;
        }
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();

        DataSlot ??= "toggle-group-item";
        Display ??= _defaultDisplay;
        Shrink ??= _defaultShrink;
        ItemsAlign ??= _staticCss0;
        Justify ??= _defaultJustify;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        Whitespace ??= _defaultWhitespace;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        BorderColor ??= _defaultBorderColor;
        RingColor ??= _defaultRingColor;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(Variant);
        hc.Add(ToggleSize);
        hc.Add(ParentToggleGroup?.Variant);
        hc.Add(ParentToggleGroup?.ToggleSize);
        hc.Add(ParentToggleGroup?.Spacing);
        hc.Add(ParentToggleGroup?.Orientation);
        hc.Add(ParentToggleGroup?.IsItemPressed(ResolvedValue) == true);
    }

    private static string GetToggleSizeDataAttribute(CssValue<ToggleSizeBuilder>? size)
    {
        return size?.ToString() is "sm" ? "sm" : "default";
    }
}
