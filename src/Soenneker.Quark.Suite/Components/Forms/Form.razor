@using Microsoft.AspNetCore.Components.Forms

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<EditForm Model="@Model" OnValidSubmit="(_cachedHandleValidSubmitDelegate ??= HandleValidSubmit)" OnInvalidSubmit="(_cachedHandleInvalidSubmitDelegate ??= HandleInvalidSubmit)" @attributes="BuildAttributes()">
    @ChildContent
</EditForm>

@code {
    protected override void BuildOwnedAttributes(Dictionary<string, object> attributes)
    {
        base.BuildOwnedAttributes(attributes);

        if (AutoComplete is not null)
            attributes["autocomplete"] = AutoComplete;

        if (Action is not null)
            attributes["action"] = Action;

        if (Method is not null)
            attributes["method"] = Method;

        if (EncType is not null)
            attributes["enctype"] = EncType;

        if (Name is not null)
            attributes["name"] = Name;

        if (Target is not null)
            attributes["target"] = Target;

        if (Rel is not null)
            attributes["rel"] = Rel;

        if (AcceptCharset is not null)
            attributes["accept-charset"] = AcceptCharset;

        if (NoValidate.HasValue)
            attributes["novalidate"] = NoValidate.Value ? QuarkAttributeValues.True : false;

    }


    /// <summary>
    /// Gets or sets browser autofill tokens, such as off, email, or section-shipping shipping street-address.
    /// </summary>
    [Parameter]
    public string? AutoComplete { get; set; }

    /// <summary>
    /// Gets or sets the HTML action attribute.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Gets or sets the HTML method attribute.
    /// </summary>
    [Parameter]
    public string? Method { get; set; }

    /// <summary>
    /// Gets or sets the HTML enctype attribute.
    /// </summary>
    [Parameter]
    public string? EncType { get; set; }

    /// <summary>
    /// Gets or sets the HTML name attribute.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Gets or sets the HTML target attribute.
    /// </summary>
    [Parameter]
    public string? Target { get; set; }

    /// <summary>
    /// Gets or sets the HTML rel attribute.
    /// </summary>
    [Parameter]
    public string? Rel { get; set; }

    /// <summary>
    /// Gets or sets the HTML accept-charset attribute.
    /// </summary>
    [Parameter]
    public string? AcceptCharset { get; set; }

    /// <summary>
    /// Gets or sets the HTML novalidate attribute.
    /// </summary>
    [Parameter]
    public bool? NoValidate { get; set; }


    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is6;
    private Func<Task>? _cachedHandleValidSubmitDelegate;
    private Func<Task>? _cachedHandleInvalidSubmitDelegate;

    /// <summary>
    /// Gets or sets the form model.
    /// </summary>
    [Parameter]
    public object? Model { get; set; }

    /// <summary>
    /// Gets or sets callback when form is submitted and valid.
    /// </summary>
    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    /// <summary>
    /// Gets or sets callback when form is submitted and invalid.
    /// </summary>
    [Parameter]
    public EventCallback OnInvalidSubmit { get; set; }

    private async Task HandleValidSubmit()
    {
        // EditContext passed via EditForm - user can use DataAnnotationsValidator
        if (OnValidSubmit.HasDelegate)
            await OnValidSubmit.InvokeAsync();
    }

    private Task HandleInvalidSubmit() => OnInvalidSubmit.HasDelegate ? OnInvalidSubmit.InvokeAsync() : Task.CompletedTask;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "form";
        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Gap ??= _defaultGap;

    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AutoComplete);
        hc.Add(Action);
        hc.Add(Method);
        hc.Add(EncType);
        hc.Add(Name);
        hc.Add(Target);
        hc.Add(Rel);
        hc.Add(AcceptCharset);
        hc.Add(NoValidate);

        hc.Add(Model);
    }
}