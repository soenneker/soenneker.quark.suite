@using System.Linq.Expressions
@using System.Threading
@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements Soenneker.Quark.IValidationInput
@implements IInput
@inject IInputInterop InputInterop

@if (UsesAutoSaveStatusSlot)
{
    <span class="inline-flex w-full min-w-0 items-center gap-2">
        <input @ref="_elementRef"
               @attributes="BuildAttributes()"
               @bind-value:get="Value"
               @bind-value:set="HandleInputValueChanged"
               @bind-value:event="oninput"
               @onchange="(_cachedHandleChangeDelegate ??= HandleChange)" />
        <AutoSaveStatus State="@_autoSave.State"
                        HasSaved="@_autoSave.HasSaved"
                        Class="@AutoSaveStatusClass"
                        SavingClass="@AutoSaveSavingClass"
                        SavedClass="@AutoSaveSavedClass"
                        FailedClass="@AutoSaveFailedClass" />
    </span>
}
else
{
    <input @ref="_elementRef"
           @attributes="BuildAttributes()"
           @bind-value:get="Value"
           @bind-value:set="HandleInputValueChanged"
           @bind-value:event="oninput"
           @onchange="(_cachedHandleChangeDelegate ??= HandleChange)" />
}

@code {
    private static readonly CssValue<InputSizeBuilder> _staticCss1 = InputSizes.Default;
    private (bool PlainText, bool AutoSaveSlot, string? Size, string? Validation, string? BaseClass) _builtInputClassKey;
    private Func<Task>? _autoSaveRefreshCallback;
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Base.OnMd.Sm;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<BorderBuilder> _defaultBorder2 = Quark.Border.Is0;
    private static readonly CssValue<PaddingBuilder> _defaultPadding2 = Quark.Padding.OnY.Is2;
    private static readonly CssValue<RingBuilder> _defaultRing = Quark.Ring.None.OnFocusVisible;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is8;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Input.OnFocusVisible.Ring;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2_5.OnY.Is1;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None.OnDisabled;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.NotAllowed.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private string? _lastBuiltClass;

    private Func<ChangeEventArgs, Task>? _cachedHandleChangeDelegate;

    private object? _cachedHandleInputBlurFocusEventArgsCallback;
    private object? _cachedHandleInputKeyDownKeyboardEventArgsCallback;

    private ElementReference _elementRef;
    private bool _hasPendingNativeTimeValue;
    private string? _pendingNativeTimeValue;
    private bool _suppressNextRender;
    private AutoSaveController<string?> _autoSave;
    private InputSelectionSnapshot? _pendingSelectionRestore;

    [CascadingParameter]
    internal InputGroupContext? InputGroupContext { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound value for validation.
    /// </summary>
    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>
    /// Gets or sets the input type (e.g., "text", "email", "password").
    /// </summary>
    [Parameter]
    public virtual string? Type { get; set; }

    /// <summary>
    /// Gets or sets the size of the input.
    /// </summary>
    [Parameter]
    public CssValue<InputSizeBuilder>? InputSize { get; set; } = _staticCss1;

    /// <summary>
    /// Gets or sets whether the input should be rendered as plain text.
    /// </summary>
    [Parameter]
    public bool PlainText { get; set; }

    /// <summary>
    /// Gets or sets whether the input should use floating label styling.
    /// </summary>
    [Parameter]
    public bool FloatingLabel { get; set; }

    /// <summary>
    /// Gets or sets the label text for the input.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the input value changes.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked during input.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    /// <summary>
    /// Gets or sets the parent validation context.
    /// </summary>
    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }

    /// <summary>
    /// Gets or sets the function that selects the value used for validation.
    /// </summary>
    [Parameter]
    public Func<object?>? ValidationValueSelector { get; set; }

    [Parameter]
    public bool AutoSave { get; set; }

    [Parameter]
    public int AutoSaveDelay { get; set; } = 750;

    [Parameter]
    public bool AutoSaveOnBlur { get; set; } = true;

    [Parameter]
    public bool AutoSaveOnEnter { get; set; }

    [Parameter]
    public bool ShowAutoSaveStatus { get; set; } = true;

    [Parameter]
    public Func<string?, CancellationToken, ValueTask>? OnAutoSave { get; set; }

    [Parameter]
    public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }

    [Parameter]
    public string? AutoSaveStatusClass { get; set; }

    [Parameter]
    public string? AutoSaveSavingClass { get; set; }

    [Parameter]
    public string? AutoSaveSavedClass { get; set; }

    [Parameter]
    public string? AutoSaveFailedClass { get; set; }

    /// <summary>
    /// Gets the value used for validation purposes.
    /// </summary>
    public virtual object? ValidationValue => ValidationValueSelector?.Invoke() ?? Value;

    private bool UsesAutoSaveStatusSlot => AutoSave && OnAutoSave is not null && ShowAutoSaveStatus;

    /// <summary>
    /// Called after the component has rendered.
    /// </summary>
    /// <param name="firstRender">True if this is the first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            InputGroupContext?.RegisterControl(_elementRef);

        if (firstRender && CanRestoreSelection())
            await InputInterop.Initialize();

        if (firstRender && ParentValidation is not null)
        {
            await ParentValidation.InitializeInput(this);
            ParentValidation.ValidationStatusChanged += OnParentValidationStatusChanged;

            if (ValueExpression is not null)
                await ParentValidation.InitializeInputExpression(ValueExpression);
        }

        await RestorePendingSelection();
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override bool ShouldRender()
    {
        if (_suppressNextRender)
        {
            _suppressNextRender = false;
            return false;
        }

        return base.ShouldRender();
    }

    private void OnParentValidationStatusChanged(object? sender, ValidationStatusChangedEventArgs e)
    {
        _ = RefreshOffThread();
    }

    /// <summary>
    /// Handles the input event.
    /// </summary>
    /// <param name="newValue">The input value from the native input event.</param>
    protected virtual async Task HandleInputValueChanged(string? newValue)
    {
        if (IsNativeTimeInput())
        {
            TrackPendingNativeTimeValue(newValue);
            return;
        }

        var valueChanged = false;
        if (!string.Equals(Value, newValue, StringComparison.Ordinal))
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(Value);
            await CapturePendingSelection(Value);
            valueChanged = true;
        }

        if (OnInput.HasDelegate)
            await OnInput.InvokeIfHasDelegate(new ChangeEventArgs { Value = Value });

        if (ParentValidation is not null)
        {
            var valueObj = ValidationValue;
            await ParentValidation.NotifyInputChanged(valueObj);
        }

        if (valueChanged)
            await _autoSave.NotifyValueChanged(Value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
    }

    /// <summary>
    /// Handles the change event.
    /// </summary>
    /// <param name="e">The change event arguments.</param>
    protected virtual async Task HandleChange(ChangeEventArgs e)
    {
        if (IsNativeTimeInput())
        {
            TrackPendingNativeTimeValue(e.Value?.ToString());
            return;
        }

        var newValue = e.Value?.ToString();
        var valueChanged = false;
        if (!string.Equals(Value, newValue, StringComparison.Ordinal))
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(Value);
            valueChanged = true;
        }

        await OnChange.InvokeIfHasDelegate(e);

        if (ParentValidation is not null)
        {
            ParentValidation.MarkTouched();
            var valueObj = ValidationValue;
            await ParentValidation.NotifyInputChanged(valueObj);
        }

        if (valueChanged)
            await _autoSave.NotifyValueChanged(Value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
    }

    private async Task CapturePendingSelection(string? value)
    {
        if (!CanRestoreSelection())
            return;

        var selection = await InputInterop.GetSelection(_elementRef);

        if (selection is not null && string.Equals(selection.Value, value, StringComparison.Ordinal))
            _pendingSelectionRestore = selection;
    }

    private async Task RestorePendingSelection()
    {
        var selection = _pendingSelectionRestore;

        if (selection is null)
            return;

        _pendingSelectionRestore = null;

        if (!CanRestoreSelection())
            return;

        await InputInterop.RestoreSelection(_elementRef, selection.Start, selection.End, selection.Value);
    }

    private bool CanRestoreSelection()
    {
        var inputType = GetInputType();

        return inputType is null ||
               string.Equals(inputType, "text", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(inputType, "search", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(inputType, "url", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(inputType, "tel", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(inputType, "password", StringComparison.OrdinalIgnoreCase);
    }

    private void TrackPendingNativeTimeValue(string? newValue)
    {
        if (!string.Equals(Value, newValue, StringComparison.Ordinal))
        {
            Value = newValue;
            _pendingNativeTimeValue = newValue;
            _hasPendingNativeTimeValue = true;
        }

        _suppressNextRender = true;
    }

    private async Task HandleInputBlur(FocusEventArgs e)
    {
        if (IsNativeTimeInput() && _hasPendingNativeTimeValue)
        {
            _hasPendingNativeTimeValue = false;
            var value = _pendingNativeTimeValue;
            _pendingNativeTimeValue = null;

            await ValueChanged.InvokeIfHasDelegate(value);
            if (OnChange.HasDelegate)
                await OnChange.InvokeIfHasDelegate(new ChangeEventArgs { Value = value });
            await _autoSave.NotifyValueChanged(value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

            if (ParentValidation is not null)
            {
                ParentValidation.MarkTouched();
                await ParentValidation.NotifyInputChanged(ValidationValue);
            }
        }

        if (AutoSaveOnBlur)
            _autoSave.QueueFlush(Value, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnBlur.InvokeIfHasDelegate(e);
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (AutoSaveOnEnter && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            await _autoSave.Flush(Value, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnKeyDown.InvokeIfHasDelegate(e);
    }

    private bool ShouldShowInvalid()
    {
        return ParentValidation?.ShouldShowInvalid == true;
    }

    /// <summary>
    /// Gets the validation class for the input based on validation status.
    /// </summary>
    /// <returns>The validation class name, or null if no validation class should be applied.</returns>
    public virtual string? GetValidationClass()
    {
        return null; // aria-invalid classes in base handle validation styling
    }

    /// <summary>
    /// Gets the color class for the input based on background color.
    /// </summary>
    /// <returns>The color class name, or null if no color class should be applied.</returns>
    public virtual string? GetColorClass()
    {
        return null;
    }

    /// <summary>
    /// Gets the size class for the input.
    /// </summary>
    /// <returns>The size class name, or null if no size class should be applied.</returns>
    public virtual string? GetSizeClass()
    {
        var sizeClass = InputSize?.ToString();
        return string.IsNullOrWhiteSpace(sizeClass) ? null : sizeClass;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "input";

        Width ??= _defaultWidth;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        TextSize ??= _defaultTextSize;

        if (PlainText)
        {
            Display ??= _defaultDisplay;
            Border ??= _defaultBorder2;
            Padding ??= _defaultPadding2;
            Ring ??= _defaultRing;
            Cursor ??= _defaultCursor;
            Opacity ??= _defaultOpacity;
        }
        else
        {
            Height ??= _defaultHeight;
            MinWidth ??= _staticCss0;
            Rounded ??= _defaultRounded;
            Border ??= _defaultBorder;
            BorderColor ??= _defaultBorderColor;
            Transition ??= _defaultTransition;
            OutlineStyle ??= _defaultOutlineStyle;
            Padding ??= _defaultPadding;
            RingColor ??= _defaultRingColor;
            PointerEvents ??= _defaultPointerEvents;
            Cursor ??= _defaultCursor;
            Opacity ??= _defaultOpacity;
        }
    }

    /// <summary>
    /// Gets the input type, defaulting to "text" if not specified.
    /// </summary>
    /// <returns>The input type string.</returns>
    protected virtual string? GetInputType() => Type;

    private bool IsNativeTimeInput() => string.Equals(GetInputType(), "time", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Builds the attributes dictionary for the input component.
    /// </summary>
    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes.Remove("value");

        var inputType = GetInputType();

        if (!string.IsNullOrWhiteSpace(inputType) && !string.Equals(inputType, "text", StringComparison.OrdinalIgnoreCase))
            attributes["type"] = inputType;

        if (IsNativeTimeInput() || OnBlur.HasDelegate || (AutoSave && AutoSaveOnBlur && OnAutoSave is not null))
            attributes["onblur"] = (_cachedHandleInputBlurFocusEventArgsCallback ??= EventCallback.Factory.Create<FocusEventArgs>(this, HandleInputBlur));

        if (OnKeyDown.HasDelegate || (AutoSave && AutoSaveOnEnter && OnAutoSave is not null))
            attributes["onkeydown"] = (_cachedHandleInputKeyDownKeyboardEventArgsCallback ??= EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleInputKeyDown));

        ApplyFieldControlAttributes(attributes, ShouldShowInvalid());

        var sizeClass = GetSizeClass();
        var validationClass = GetValidationClass();
        attributes.TryGetValue("class", out var existingClass);
        var baseClass = existingClass as string ?? existingClass?.ToString();
        if (existingClass is not null) attributes["class"] = baseClass!;
        var classKey = (PlainText, UsesAutoSaveStatusSlot, sizeClass, validationClass, baseClass);
        if (_lastBuiltClass is null || _builtInputClassKey != classKey)
        {
            _builtInputClassKey = classKey;
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                if (PlainText)
                {
                    AppendClass(ref cls, "focus-visible:outline-none");
                }
                else
                {
                    AppendClass(ref cls, "file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground");
                    AppendClass(ref cls, "disabled:bg-input/50 dark:bg-input/30 dark:disabled:bg-input/80");
                    AppendClass(ref cls, "focus-visible:ring-3");
                    AppendClass(ref cls, "aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40");
                }

                if (sizeClass is not null)
                    AppendClass(ref cls, sizeClass);
                if (UsesAutoSaveStatusSlot)
                    AppendClass(ref cls, "min-w-0 flex-1");
                if (validationClass is not null)
                    AppendClass(ref cls, validationClass);
                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass);
            }
            finally
            {
                cls.Dispose();
            }
        }
        else
            attributes["class"] = _lastBuiltClass;

    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        await _autoSave.DisposeAsync();

        if (ParentValidation is not null)
            ParentValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(Type);
        hc.Add(Placeholder);
        hc.Add(Disabled);
        hc.Add(ReadOnly);
        hc.Add(Required);
        AddIf(ref hc, InputSize);
        hc.Add(PlainText);
        hc.Add(FloatingLabel);
        hc.Add(Label);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(AutoSaveOnBlur);
        hc.Add(AutoSaveOnEnter);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);
        hc.Add(OnAutoSave is not null);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
    }
}
