@using System.Linq.Expressions
@using System.Threading
@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements IDateInput

<div @attributes="BuildWrapperAttributes()">
    <Input Type="@GetInputModeString()"
           Id="@Id"
           Name="@Name"
           Value="@GetCurrentValue()"
           ValueChanged="(_cachedHandleValueChangedDelegate ??= HandleValueChanged)"

           PlainText="@PlainText"
           FloatingLabel="@FloatingLabel"
           Label="@Label"
           Placeholder="@Placeholder"
           Disabled="@Disabled"
           ReadOnly="@ReadOnly"
           Required="@Required"
           Class="@ResolvedInputClass"
           AriaInvalid="@AriaInvalid"
           AriaDisabled="@AriaDisabled"
           AriaExpanded="@AriaExpanded"
           AriaHasPopup="@AriaHasPopup"
           AriaLabel="@AriaLabel"
           AriaDescribedBy="@AriaDescribedBy"
           AdditionalAttributes="BuildInputAttributes()"
           OnClick="@OnClick"
           OnInput="(_cachedHandleInputDelegate ??= HandleInput)"
           OnChange="(_cachedHandleChangeDelegate ??= HandleChange)"
           OnBlur="(_cachedHandleInputBlurDelegate ??= HandleInputBlur)"
           OnKeyDown="(_cachedHandleInputKeyDownDelegate ??= HandleInputKeyDown)"
           ValidationValueSelector="@(_validationValueSelector ??= () => (object?)Date ?? (object?)DateOnly)" />
    <AutoSaveStatus State="@CurrentAutoSaveState"
                    HasSaved="@CurrentAutoSaveHasSaved"
                    Visible="@UsesAutoSaveStatusSlot"
                    Class="@AutoSaveStatusClass"
                    SavingClass="@AutoSaveSavingClass"
                    SavedClass="@AutoSaveSavedClass"
                    FailedClass="@AutoSaveFailedClass" />
</div>

@code {
    [Parameter]
    public string? Form { get; set; }

    [Parameter]
    public string? AutoComplete { get; set; }

    private QuarkInt32Attribute _stepAttribute;
    private DateInputValueCache _currentValueCache, _minValueCache, _maxValueCache;
    private Func<object?>? _validationValueSelector;
    private Func<Task>? _autoSaveRefreshCallback;
    private Func<string?, Task>? _cachedHandleValueChangedDelegate;
    private Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private Func<ChangeEventArgs, Task>? _cachedHandleChangeDelegate;
    private Func<FocusEventArgs, Task>? _cachedHandleInputBlurDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleInputKeyDownDelegate;

    private QuarkAttributeDictionary _inputAttributesBuffer;
    private QuarkAttributeDictionary _wrapperAttributesBuffer;
    private AutoSaveController<DateTime?> _dateAutoSave;
    private AutoSaveController<DateOnly?> _dateOnlyAutoSave;
    private Validation? _subscribedValidation;
    private LambdaExpression? _registeredExpression;

    /// <summary>
    /// Gets or sets the date value.
    /// </summary>
    [Parameter]
    public DateTime? Date { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound date value.
    /// </summary>
    [Parameter]
    public Expression<Func<DateTime?>>? DateExpression { get; set; }

    /// <summary>
    /// Gets or sets the date-only value.
    /// </summary>
    [Parameter]
    public DateOnly? DateOnly { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound date-only value.
    /// </summary>
    [Parameter]
    public Expression<Func<DateOnly?>>? DateOnlyExpression { get; set; }

    /// <summary>
    /// Gets or sets the minimum date value.
    /// </summary>
    [Parameter]
    public DateTime Min { get; set; }

    /// <summary>
    /// Gets or sets the maximum date value.
    /// </summary>
    [Parameter]
    public DateTime Max { get; set; }

    /// <summary>
    /// Gets or sets the minimum date-only value.
    /// </summary>
    [Parameter]
    public DateOnly MinDateOnly { get; set; }

    /// <summary>
    /// Gets or sets the maximum date-only value.
    /// </summary>
    [Parameter]
    public DateOnly MaxDateOnly { get; set; }

    /// <summary>
    /// Gets or sets the step value for date increments.
    /// </summary>
    [Parameter]
    public int Step { get; set; } = 1;

    /// <summary>
    /// Gets or sets the input mode for the date picker.
    /// </summary>
    [Parameter]
    public DateInputMode InputMode { get; set; } = DateInputMode.Date;

    /// <summary>
    /// Gets or sets the callback invoked When the date changes.
    /// </summary>
    [Parameter]
    public EventCallback<DateTime?> DateChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the date-only value changes.
    /// </summary>
    [Parameter]
    public EventCallback<DateOnly?> DateOnlyChanged { get; set; }

    /// <summary>
    /// Gets or sets whether the input should be displayed as plain text.
    /// </summary>
    [Parameter]
    public bool PlainText { get; set; }

    /// <summary>
    /// Gets or sets whether the label should float.
    /// </summary>
    [Parameter]
    public bool FloatingLabel { get; set; }

    /// <summary>
    /// Gets or sets the label text.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the input changes.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the input value changes.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    [Parameter]
    public bool AutoSave { get; set; }

    [Parameter]
    public int AutoSaveDelay { get; set; } = 750;

    [Parameter]
    public bool AutoSaveOnBlur { get; set; } = true;

    [Parameter]
    public bool AutoSaveOnEnter { get; set; }

    [Parameter]
    public bool ShowAutoSaveStatus { get; set; } = true;

    [Parameter]
    public Func<DateTime?, CancellationToken, ValueTask>? OnAutoSave { get; set; }

    [Parameter]
    public Func<DateOnly?, CancellationToken, ValueTask>? OnAutoSaveDateOnly { get; set; }

    [Parameter]
    public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }

    [Parameter]
    public string? AutoSaveStatusClass { get; set; }

    [Parameter]
    public string? AutoSaveSavingClass { get; set; }

    [Parameter]
    public string? AutoSaveSavedClass { get; set; }

    [Parameter]
    public string? AutoSaveFailedClass { get; set; }

    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }

    /// <summary>
    /// Gets the value used for validation.
    /// </summary>
    public object? ValidationValue => Date ?? (object?)DateOnly;

    public string? GetValidationClass()
    {
        if (ParentValidation?.Status == ValidationStatus.Error)
            return "is-invalid border-[var(--destructive,oklch(0.577_0.245_27.325))]";

        if (ParentValidation?.Status == ValidationStatus.Success)
            return "is-valid border-[var(--series-2,oklch(0.65_0.2_145))]";

        return null;
    }

    public string? GetColorClass()
    {
        return null;
    }

    private string InputModeValue => InputMode?.Value ?? DateInputMode.Date.Value;
    private bool UsesDateOnlyValue => DateExpression is null && !Date.HasValue && !DateChanged.HasDelegate &&
        (DateOnlyExpression is not null || DateOnly.HasValue || DateOnlyChanged.HasDelegate);
    private AutoSaveState CurrentAutoSaveState => UsesDateOnlyValue ? _dateOnlyAutoSave.State : _dateAutoSave.State;
    private bool CurrentAutoSaveHasSaved => UsesDateOnlyValue ? _dateOnlyAutoSave.HasSaved : _dateAutoSave.HasSaved;
    private bool UsesAutoSaveStatusSlot => AutoSave && ShowAutoSaveStatus && (OnAutoSave is not null || OnAutoSaveDateOnly is not null);

    private string? ResolvedInputClass => UsesAutoSaveStatusSlot ? "min-w-0 flex-1" : null;

    private string GetCurrentValue() => _currentValueCache.Get(Date, DateOnly, InputModeValue);

    private async Task HandleValueChanged(string? value)
    {
        if (!UsesDateOnlyValue)
        {
            DateTime? next = DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dateValue) ? dateValue : null;
            var valueChanged = Date != next;
            Date = next;

            if (valueChanged)
            {
                await DateChanged.InvokeIfHasDelegate(Date);
                await _dateAutoSave.NotifyValueChanged(Date, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
            }

            return;
        }

        if (DateOnlyExpression is not null || DateOnly.HasValue || DateOnlyChanged.HasDelegate)
        {
            DateOnly? next = System.DateOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dateOnlyValue) ? dateOnlyValue : null;
            var valueChanged = DateOnly != next;
            DateOnly = next;

            if (valueChanged)
            {
                await DateOnlyChanged.InvokeIfHasDelegate(DateOnly);
                await _dateOnlyAutoSave.NotifyValueChanged(DateOnly, AutoSave, AutoSaveDelay, OnAutoSaveDateOnly, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!ReferenceEquals(_subscribedValidation, ParentValidation))
        {
            if (_subscribedValidation is not null)
                _subscribedValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
            _subscribedValidation = ParentValidation;
            _registeredExpression = null;
            if (_subscribedValidation is not null)
                _subscribedValidation.ValidationStatusChanged += OnParentValidationStatusChanged;
        }
        var expression = (LambdaExpression?)DateExpression ?? DateOnlyExpression;
        if (ParentValidation is not null && !ReferenceEquals(_registeredExpression, expression))
        {
            _registeredExpression = expression;
            if (DateExpression is not null)
            {
                await ParentValidation.InitializeInputExpression(DateExpression);
            }
            else
            {
                await ParentValidation.InitializeInputExpression(DateOnlyExpression!);
            }
        }

    }

    private void OnParentValidationStatusChanged(object? sender, ValidationStatusChangedEventArgs e)
    {
        _ = RefreshOffThread();
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        await OnInput.InvokeIfHasDelegate(e);

        ParentValidation?.MarkTouched();
    }

    private async Task HandleInputBlur(FocusEventArgs e)
    {
        if (AutoSaveOnBlur)
            QueueAutoSaveFlush();

        await OnBlur.InvokeIfHasDelegate(e);
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (AutoSaveOnEnter && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            await FlushAutoSave();

        await OnKeyDown.InvokeIfHasDelegate(e);
    }

    private Task FlushAutoSave()
    {
        return UsesDateOnlyValue
            ? _dateOnlyAutoSave.Flush(DateOnly, AutoSave, OnAutoSaveDateOnly, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread))
            : _dateAutoSave.Flush(Date, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
    }

    private void QueueAutoSaveFlush()
    {
        if (UsesDateOnlyValue)
            _dateOnlyAutoSave.QueueFlush(DateOnly, AutoSave, OnAutoSaveDateOnly, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
        else
            _dateAutoSave.QueueFlush(Date, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
    }

    /// <summary>
    /// Disposes the component.
    /// </summary>
    public override async ValueTask DisposeAsync()
    {
        if (_subscribedValidation is not null)
            _subscribedValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
        try { await _dateAutoSave.DisposeAsync(); }
        finally
        {
            try { await _dateOnlyAutoSave.DisposeAsync(); }
            finally { await base.DisposeAsync(); }
        }
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        await OnChange.InvokeIfHasDelegate(e);

        ParentValidation?.MarkTouched();
    }

    private string GetInputModeString()
    {
        return InputModeValue;
    }

    private Dictionary<string, object> BuildInputAttributes()
    {
        var attributes = _inputAttributesBuffer.Create(BuildAttributes(), 5);
        attributes.Remove("oninput");
        attributes.Remove("onchange");

        // Add DateInput-specific attributes
        if (Min != default)
        {
            var minString = _minValueCache.Get(Min, null, InputModeValue);
            attributes["min"] = minString;
        }
        else if (MinDateOnly != default)
        {
            var minString = _minValueCache.Get(null, MinDateOnly, InputModeValue);
            attributes["min"] = minString;
        }

        if (Max != default)
        {
            var maxString = _maxValueCache.Get(Max, null, InputModeValue);
            attributes["max"] = maxString;
        }
        else if (MaxDateOnly != default)
        {
            var maxString = _maxValueCache.Get(null, MaxDateOnly, InputModeValue);
            attributes["max"] = maxString;
        }

        if (Step > 1)
            attributes["step"] = _stepAttribute.Get(Step);

        BuildGlobalHtmlAttributes(attributes);
        if (Form is not null)
            attributes["form"] = Form;

        if (AutoComplete is not null)
            attributes["autocomplete"] = AutoComplete;

        return attributes;
    }

    private Dictionary<string, object> BuildWrapperAttributes()
    {
        var attributes = _wrapperAttributesBuffer.Create(1);

        if (UsesAutoSaveStatusSlot)
            attributes["class"] = "inline-flex w-full min-w-0 items-center gap-2";

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Form);
        hc.Add(AutoComplete);

        hc.Add(Date);
        hc.Add(DateOnly);
        hc.Add(Min);
        hc.Add(Max);
        hc.Add(MinDateOnly);
        hc.Add(MaxDateOnly);
        hc.Add(Step);
        hc.Add(InputMode);
        hc.Add(PlainText);
        hc.Add(FloatingLabel);
        hc.Add(Label);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(AutoSaveOnBlur);
        hc.Add(AutoSaveOnEnter);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(CurrentAutoSaveState);
        hc.Add(CurrentAutoSaveHasSaved);
        hc.Add(OnAutoSave is not null);
        hc.Add(OnAutoSaveDateOnly is not null);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
        hc.Add(Placeholder);
        hc.Add(Disabled);
        hc.Add(ReadOnly);
        hc.Add(Required);
    }
}
