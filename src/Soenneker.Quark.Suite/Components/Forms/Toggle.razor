@using Soenneker.Blazor.Extensions.EventCallback
@using System.Threading

@namespace Soenneker.Quark
@inherits Soenneker.Quark.ToggleElement
@implements IToggle

@if (UsesAutoSaveStatusSlot)
{
    <Span Display="_renderCss0" ItemsAlign="_renderCss1" Gap="_renderCss2">
        <button @ref="_element" @onclick="HandleToggleClick" @onfocus="OnFocus" @onkeydown="HandleToggleKeyDown" @attributes="ToggleAttributes">@ChildContent</button>
        <AutoSaveStatus State="@_autoSave.State"
                        HasSaved="@_autoSave.HasSaved"
                        Visible="@UsesAutoSaveStatusSlot"
                        Class="@AutoSaveStatusClass"
                        SavingClass="@AutoSaveSavingClass"
                        SavedClass="@AutoSaveSavedClass"
                        FailedClass="@AutoSaveFailedClass" />
    </Span>
}
else
{
    <button @ref="_element" @onclick="HandleToggleClick" @onfocus="OnFocus" @onkeydown="HandleToggleKeyDown" @attributes="ToggleAttributes">@ChildContent</button>
}

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        var isRtl = string.Equals(ResolvedDir, "rtl", StringComparison.OrdinalIgnoreCase);
        var variantClass = GetToggleVariantClass(Variant);
        var sizeClass = ResolveToggleSizeClass(ToggleSize, includeShrink: false, isRtl);
        AppendClass(ref cls, "group/toggle hover:bg-muted hover:text-foreground focus-visible:ring-[3px]");
        AppendClass(ref cls, "aria-invalid:border-destructive aria-invalid:ring-destructive/20 aria-pressed:bg-muted data-[state=on]:bg-muted dark:aria-invalid:ring-destructive/40");
        AppendClass(ref cls, "[&_svg]:pointer-events-none [&_svg]:shrink-0");
        AppendClass(ref cls, variantClass);
        AppendClass(ref cls, sizeClass);
    }

    private Func<Task>? _autoSaveRefreshCallback;
    private static readonly CssValue<JustifyBuilder> _defaultJustify = Quark.Justify.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<WhitespaceBuilder> _defaultWhitespace = Quark.Whitespace.Nowrap;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.All;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer.OnDisabled.NotAllowed;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.OnDisabled.None;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.OnDisabled.Is50;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor2 = Quark.BorderColor.Input.OnFocusVisible.Ring;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.OnFocusVisible.Ring;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.InlineFlex;
    private static readonly CssValue<ItemsBuilder> _renderCss1 = Items.Center;
    private static readonly CssValue<GapBuilder> _renderCss2 = Quark.Gap.Is2;
    private ElementReference _element;
    private ElementReference _registeredElement;
    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? TriggerContext { get; set; }



    private object? _cachedHandleToggleBlurFocusEventArgsCallback;

    private QuarkAttributeDictionary _toggleAttributes;
    private AutoSaveController<bool?> _autoSave;

    /// <summary>
    /// Gets or sets whether the toggle is pressed.
    /// </summary>
    [Parameter]
    public bool Pressed { get; set; }

    /// <summary>
    /// Gets or sets callback invoked when pressed state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> PressedChanged { get; set; }

    /// <summary>
    /// Gets or sets visual variant.
    /// </summary>
    [Parameter]
    public ToggleVariant Variant { get; set; } = ToggleVariant.Default;

    /// <summary>
    /// Gets or sets size.
    /// </summary>
    [Parameter]
    public CssValue<ToggleSizeBuilder>? ToggleSize { get; set; } = "default";

    [Parameter]
    public bool AutoSave { get; set; }

    [Parameter]
    public int AutoSaveDelay { get; set; } = 750;

    [Parameter]
    public bool AutoSaveOnBlur { get; set; } = true;

    [Parameter]
    public bool AutoSaveOnEnter { get; set; }

    [Parameter]
    public bool ShowAutoSaveStatus { get; set; } = true;

    [Parameter]
    public Func<bool?, CancellationToken, ValueTask>? OnAutoSave { get; set; }

    [Parameter]
    public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }

    [Parameter]
    public string? AutoSaveStatusClass { get; set; }

    [Parameter]
    public string? AutoSaveSavingClass { get; set; }

    [Parameter]
    public string? AutoSaveSavedClass { get; set; }

    [Parameter]
    public string? AutoSaveFailedClass { get; set; }

    [CascadingParameter(Name = "DirectionProviderDir")]
    private string? DirectionProviderDir { get; set; }

    private string? ResolvedDir => !string.IsNullOrWhiteSpace(Dir) ? Dir : DirectionProviderDir;
    private bool UsesAutoSaveStatusSlot => AutoSave && OnAutoSave is not null && ShowAutoSaveStatus;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "toggle";
        Display ??= _renderCss0;
        ItemsAlign ??= _renderCss1;
        Justify ??= _defaultJustify;
        Gap ??= _defaultGap;
        FontWeight ??= _defaultFontWeight;
        Whitespace ??= _defaultWhitespace;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        RingColor ??= _defaultRingColor;
        Cursor ??= _defaultCursor;
        PointerEvents ??= _defaultPointerEvents;
        Opacity ??= _defaultOpacity;

        if (ReferenceEquals(Variant, ToggleVariant.Outline))
        {
            Border ??= _defaultBorder;
            BorderColor ??= _defaultBorderColor2;
            BorderColor ??= _defaultBorderColor;
        }

        BackgroundColor ??= _defaultBackgroundColor;
    }

    private IReadOnlyDictionary<string, object> ToggleAttributes
    {
        get
        {
            var attributes = _toggleAttributes.Create(BuildAttributes(), 3);

            if (Disabled)
            {
                attributes["disabled"] = QuarkAttributeValues.True;
                attributes["data-disabled"] = string.Empty;
            }
            attributes["aria-pressed"] = Pressed ? "true" : "false";
            attributes.Remove("data-state");
            attributes["type"] = "button";
            attributes.Remove("onclick");
            attributes.Remove("onfocus");
            attributes.Remove("onkeydown");

            if (!string.IsNullOrWhiteSpace(ResolvedDir))
                attributes["dir"] = ResolvedDir;

            attributes["data-state"] = Pressed ? "on" : "off";
            ApplyTriggerAttributes(attributes);

            if (OnBlur.HasDelegate || (AutoSave && AutoSaveOnBlur && OnAutoSave is not null))
                attributes["onblur"] = (_cachedHandleToggleBlurFocusEventArgsCallback ??= EventCallback.Factory.Create<FocusEventArgs>(this, HandleToggleBlur));



            return attributes;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (TriggerContext?.RegisterElement is { } register && _registeredElement.Id != _element.Id)
        {
            register(_element);
            _registeredElement = _element;
        }
        return base.OnAfterRenderAsync(firstRender);
    }

    private void ApplyTriggerAttributes(Dictionary<string, object> attributes)
    {
        if (TriggerContext is not { } context) return;
        if (context.AriaDescribedBy is { } describedBy)
            attributes["aria-describedby"] = attributes.TryGetValue("aria-describedby", out var existing)
                ? $"{existing} {describedBy}" : describedBy;
        if (context.OnPointerMove is { } move)
            attributes["onpointermove"] = EventCallback.Factory.Create(this, move);
        if (context.OnPointerLeave is { } leave)
            attributes["onpointerleave"] = EventCallback.Factory.Create(this, leave);
        if (context.OnPointerDownEvent is { } down)
            attributes["onpointerdown"] = EventCallback.Factory.Create<PointerEventArgs>(this, down);
        if (context.OnPointerUp is { } up)
            attributes["onpointerup"] = EventCallback.Factory.Create(this, up);
        if (context.OnFocusIn is { } focus)
            attributes["onfocusin"] = EventCallback.Factory.Create(this, focus);
        if (context.OnFocusOut is { } blur)
            attributes["onfocusout"] = EventCallback.Factory.Create(this, blur);
    }

    private async Task HandleToggleClick(MouseEventArgs args)
    {
        if (Disabled) return;
        await OnClick.InvokeIfHasDelegate(args);
        if (TriggerContext?.OnClick is { } click) await click();
        await HandlePressedChanged(!Pressed);
    }

    private async Task HandlePressedChanged(bool pressed)
    {
        Pressed = pressed;
        await PressedChanged.InvokeAsync(pressed);
        await _autoSave.NotifyValueChanged(pressed, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        Refresh();
    }

    private async Task HandleToggleBlur(FocusEventArgs e)
    {
        if (AutoSaveOnBlur)
            _autoSave.QueueFlush(Pressed, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnBlur.InvokeIfHasDelegate(e);
    }

    private async Task HandleToggleKeyDown(KeyboardEventArgs e)
    {
        if (AutoSaveOnEnter && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            await _autoSave.Flush(Pressed, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnKeyDown.InvokeIfHasDelegate(e);
        if (TriggerContext?.OnKeyDown is { } keyDown) await keyDown(e);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);

        hc.Add(Pressed);
        hc.Add(TriggerContext);
        hc.Add(Disabled);
        hc.Add(Variant);
        hc.Add(ToggleSize);
        hc.Add(Dir);
        hc.Add(DirectionProviderDir);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(AutoSaveOnBlur);
        hc.Add(AutoSaveOnEnter);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);
        hc.Add(OnAutoSave is not null);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
    }

    public override async ValueTask DisposeAsync()
    {
        await _autoSave.DisposeAsync();
        await base.DisposeAsync();
    }

    internal static string GetToggleVariantClass(ToggleVariant? variant)
    {
        if (ReferenceEquals(variant, ToggleVariant.Outline))
            return "border border-input bg-transparent hover:bg-muted";

        return "bg-transparent";
    }

    internal static string GetToggleGroupVariantClass(ToggleVariant? variant)
    {
        return string.Empty;
    }

    internal static string ResolveToggleSizeClass(CssValue<ToggleSizeBuilder>? size, bool includeShrink, bool isRtl = false)
    {
        var value = size?.ToString();

        if (string.IsNullOrWhiteSpace(value))
            return ResolveToggleTokenSizeClass("default", includeShrink, isRtl);

        var resolved = ResolveToggleTokenSizeClass(value, includeShrink, isRtl);
        return string.IsNullOrEmpty(resolved) ? value : resolved;
    }

    private static readonly string[] _toggleTokenClasses = CreateToggleTokenClasses();

    private static string[] CreateToggleTokenClasses()
    {
        var classes = new string[12];
        string[] sizes = ["sm", "lg", "default"];
        for (var i = 0; i < sizes.Length; i++)
        {
            for (var flags = 0; flags < 4; flags++)
                classes[i * 4 + flags] = CreateToggleTokenSizeClass(sizes[i], (flags & 2) != 0, (flags & 1) != 0);
        }
        return classes;
    }

    internal static string ResolveToggleTokenSizeClass(string? size, bool includeShrink, bool isRtl = false)
    {
        var index = size switch { "sm" => 0, "lg" => 1, "default" => 2, _ => -1 };
        return index < 0 ? string.Empty : _toggleTokenClasses[index * 4 + (includeShrink ? 2 : 0) + (isRtl ? 1 : 0)];
    }

    private static string CreateToggleTokenSizeClass(string? size, bool includeShrink, bool isRtl)
    {
        var prefix = includeShrink ? "shrink-0 " : string.Empty;
        var iconPadding = isRtl ? "has-data-[icon=inline-end]:pe-2 has-data-[icon=inline-start]:ps-2" : "has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2";
        var iconPaddingSm = isRtl ? "has-data-[icon=inline-end]:pe-1.5 has-data-[icon=inline-start]:ps-1.5" : "has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5";

        return size switch
        {
            "sm" => $"{prefix}h-7 min-w-7 rounded-[min(var(--radius-md),12px)] px-2.5 text-[0.8rem] {iconPaddingSm} [&_svg:not([class*='size-'])]:size-3.5",
            "lg" => $"{prefix}{(includeShrink ? string.Empty : "h-9 ")}min-w-9 rounded-lg text-sm px-2.5 {iconPadding} [&_svg:not([class*='size-'])]:size-4",
            "default" => $"{prefix}h-8 min-w-8 rounded-lg text-sm px-2.5 {iconPadding} [&_svg:not([class*='size-'])]:size-4",
            _ => string.Empty
        };
    }

}
