@namespace Soenneker.Quark
@using Soenneker.Utils.PooledStringBuilders
@inject IInputInterop Interop

<input @ref="_input" @attributes="AdditionalAttributes" type="text" inputmode="numeric" value="@DisplayValue" @oninput="Change" />

@code {
    /// <summary>Each # accepts one ASCII digit. Other non-digit characters are formatting literals.</summary>
    [Parameter, EditorRequired] public string Mask { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] private Microsoft.AspNetCore.Components.Forms.EditContext? EditContext { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    private ElementReference _input;
    private string? _registeredMask;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Mask) || !Mask.Contains('#') || Mask.AsSpan().IndexOfAnyInRange('0', '9') >= 0)
            throw new ArgumentException("A mask requires a # digit slot and cannot contain literal digits.", nameof(Mask));
    }

    private string DisplayValue
    {
        get
        {
            int slots = Mask.AsSpan().Count('#');
            var raw = Digits(Value, slots);
            if (raw.Length == 0 || slots == Mask.Length) return raw;

            using var display = new PooledStringBuilder(stackalloc char[64]);
            int digit = 0;
            foreach (char token in Mask)
            {
                if (digit == raw.Length && digit < slots) break;
                display.Append(token == '#' ? raw[digit++] : token);
            }
            return display.ToString();
        }
    }

    private static string Digits(string? text, int slots)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (text.Length <= slots && text.AsSpan().IndexOfAnyExceptInRange('0', '9') < 0) return text;

        using var digits = new PooledStringBuilder(stackalloc char[64]);
        foreach (char c in text)
        {
            if (!char.IsAsciiDigit(c)) continue;
            digits.Append(c);
            if (digits.Length == slots) break;
        }
        return digits.ToString();
    }

    private async Task Change(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(Digits(e.Value?.ToString(), Mask.AsSpan().Count('#')));
        if (ValueExpression is not null && EditContext is not null)
            EditContext.NotifyFieldChanged(Microsoft.AspNetCore.Components.Forms.FieldIdentifier.Create(ValueExpression));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_registeredMask == Mask) return;
        string mask = Mask;
        await Interop.RegisterDigitMask(_input, mask);
        _registeredMask = mask;
    }
}
