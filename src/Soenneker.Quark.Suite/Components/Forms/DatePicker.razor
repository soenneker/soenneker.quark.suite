@using System.Threading
@using System.Globalization
@using System.Linq.Expressions
@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Blazor.Utils.Ids
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements Soenneker.Quark.IValidationInput
@implements IDatePicker

<Popover Open="@_open"
         OpenChanged="(_cachedHandleOpenChangedDelegate ??= HandleOpenChanged)">
    <div @attributes="GetContainerAttributes()">
        <input type="hidden" @attributes="BuildHiddenInputAttributes()" />

        <PopoverTrigger AsChild="true" Id="@TriggerId">
            <Button Variant="ButtonVariant.Outline"
                    Type="@ButtonType.Button"
                    Disabled="Disabled"
                    OnBlur="(_cachedHandleAutoSaveBlurDelegate ??= HandleAutoSaveBlur)"
                    OnKeyDown="(_cachedHandleAutoSaveKeyDownDelegate ??= HandleAutoSaveKeyDown)"
                    Class="@GetTriggerClass()"
                    @attributes="BuildTriggerAttributes()">
                @if (SelectedDate.HasValue)
                {
                    <span>@FormatDisplay(SelectedDate.Value)</span>
                }
                else
                {
                    <span>@GetPlaceholderText()</span>
                }
                <Icon Name="LucideIcon.ChevronDown" />
            </Button>
        </PopoverTrigger>
        @if (AutoSave && OnAutoSave is not null && ShowAutoSaveStatus)
        {
            <AutoSaveStatus State="@_autoSave.State"
                            HasSaved="@_autoSave.HasSaved"
                            Class="@AutoSaveStatusClass"
                            SavingClass="@AutoSaveSavingClass"
                            SavedClass="@AutoSaveSavedClass"
                            FailedClass="@AutoSaveFailedClass" />
        }

        <PopoverContent Side="Side.Bottom"
                        Align="Alignment.Start"
                        Width="_renderCss0"
                        Padding="_renderCss1"
                        @attributes="PanelAttributes">
            <Calendar SelectedDate="SelectedDate"
                      SelectedDateChanged="(_cachedHandleCalendarChangedDelegate ??= HandleCalendarChanged)"
                      DisplayMonth="_displayMonth"
                      DisplayMonthChanged="(_cachedHandleCalendarMonthChangedDelegate ??= HandleCalendarMonthChanged)"
                      Min="Min"
                      Max="Max"
                      Border="_renderCss2"
                      Shadow="_renderCss3"
                      Padding="_renderCss1"
                      MinWidth="_staticCss0" />
        </PopoverContent>
    </div>
</Popover>

@code {
    private static readonly CssValue<InputSizeBuilder> _staticCss1 = InputSizes.Default;
    private string? _triggerClass;
    private DateOnly _formattedDate;
    private string? _formattedDisplay;
    private DateInputValueCache _serializedDate;
    private Func<Task>? _autoSaveRefreshCallback;
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<WidthBuilder> _renderCss0 = Quark.Width.Auto;
    private static readonly CssValue<PaddingBuilder> _renderCss1 = Quark.Padding.Is0;
    private static readonly CssValue<BorderBuilder> _renderCss2 = Quark.Border.Is0;
    private static readonly CssValue<ShadowBuilder> _renderCss3 = Quark.Shadow.None;
    private Func<bool, Task>? _cachedHandleOpenChangedDelegate;
    private Func<FocusEventArgs, Task>? _cachedHandleAutoSaveBlurDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleAutoSaveKeyDownDelegate;
    private Func<DateOnly?, Task>? _cachedHandleCalendarChangedDelegate;
    private Func<DateOnly?, Task>? _cachedHandleCalendarMonthChangedDelegate;

    private AutoSaveController<DateOnly?> _autoSave;

    [Parameter]
    public bool AutoSave { get; set; }

    [Parameter]
    public int AutoSaveDelay { get; set; } = 750;

    [Parameter]
    public bool AutoSaveOnBlur { get; set; } = true;

    [Parameter]
    public bool AutoSaveOnEnter { get; set; }

    [Parameter]
    public bool ShowAutoSaveStatus { get; set; } = true;

    [Parameter]
    public Func<DateOnly?, CancellationToken, ValueTask>? OnAutoSave { get; set; }

    [Parameter]
    public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }

    [Parameter]
    public string? AutoSaveStatusClass { get; set; }

    [Parameter]
    public string? AutoSaveSavingClass { get; set; }

    [Parameter]
    public string? AutoSaveSavedClass { get; set; }

    [Parameter]
    public string? AutoSaveFailedClass { get; set; }

    private QuarkAttributeDictionary _triggerAttributesBuffer;
    private QuarkAttributeDictionary _hiddenInputAttributesBuffer;

    /// <summary>
    /// Gets or sets the selected date value.
    /// </summary>
    [Parameter]
    public DateOnly? SelectedDate { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound value.
    /// </summary>
    [Parameter]
    public Expression<Func<DateOnly?>>? SelectedDateExpression { get; set; }

    /// <summary>
    /// Gets or sets the minimum date value.
    /// </summary>
    [Parameter]
    public DateOnly? Min { get; set; }

    /// <summary>
    /// Gets or sets the maximum date value.
    /// </summary>
    [Parameter]
    public DateOnly? Max { get; set; }

    /// <summary>
    /// Gets or sets the size of the date picker.
    /// </summary>
    [Parameter]
    public CssValue<InputSizeBuilder>? InputSize { get; set; } = _staticCss1;

    /// <summary>
    /// Gets or sets the callback invoked When the value changes.
    /// </summary>
    [Parameter]
    public EventCallback<DateOnly?> SelectedDateChanged { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the input changes.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the input value changes.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }

    /// <summary>
    /// Gets the value used for validation.
    /// </summary>
    public object? ValidationValue => SelectedDate;

    private bool _open;
    private DateOnly _displayMonth = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _lastSyncedSelectedDate;
    private string? _triggerId;

    private static readonly IReadOnlyDictionary<string, object> PanelAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "date-picker-panel"
    };

    private static readonly IReadOnlyDictionary<string, object> ContainerAttributes = new Dictionary<string, object>
    {
        ["class"] = "relative flex w-fit items-center gap-2"
    };

    private string TriggerId => CurrentFieldContext?.ControlId ?? Id ?? (_triggerId ??= BlazorIdGenerator.New("quark-datepicker-trigger"));

    private string FormatDisplay(DateOnly value)
    {
        if (_formattedDisplay is null || _formattedDate != value)
        {
            _formattedDate = value;
            _formattedDisplay = value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture);
        }
        return _formattedDisplay;
    }

    private string GetPlaceholderText()
    {
        return Placeholder.HasContent() ? Placeholder! : "Pick a date";
    }

    private string GetSerializedValue()
    {
        return _serializedDate.Get(null, SelectedDate, "date");
    }

    private string GetTriggerClass()
    {
        var baseClass = "w-[212px] justify-between text-left font-normal data-[empty=true]:text-muted-foreground";
        return Class.HasContent() ? AppendToClass(Class, baseClass, ref _triggerClass) : baseClass;
    }

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        var attributes = _triggerAttributesBuffer.Create(2);
        attributes["id"] = TriggerId;

        if (!SelectedDate.HasValue)
            attributes["data-empty"] = "true";

        if (Attributes is not null)
        {
            foreach (var attribute in Attributes)
            {
                if (attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("style", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("value", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("name", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("placeholder", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("readonly", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("required", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("autocomplete", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("oninput", StringComparison.OrdinalIgnoreCase) ||
                    attribute.Key.Equals("onchange", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                attributes[attribute.Key] = attribute.Value;
            }
        }

        ApplyFieldControlAttributes(attributes, ParentValidation?.Status == ValidationStatus.Error);
        return attributes;
    }

    private IReadOnlyDictionary<string, object> BuildHiddenInputAttributes()
    {
        var attributes = _hiddenInputAttributesBuffer.Create(5);
        attributes["aria-hidden"] = "true";
        attributes["tabindex"] = "-1";
        attributes["value"] = GetSerializedValue();

        if (Name.HasContent())
            attributes["name"] = Name!;

        if (Disabled)
            attributes["disabled"] = QuarkAttributeValues.True;

        return attributes;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ParentValidation is not null)
        {
            await ParentValidation.InitializeInput(this);

            if (SelectedDateExpression is not null)
                await ParentValidation.InitializeInputExpression(SelectedDateExpression);
        }

        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            if (SelectedDate.HasValue)
                _displayMonth = new DateOnly(SelectedDate.Value.Year, SelectedDate.Value.Month, 1);
            else
            {
                var today = DateOnly.FromDateTime(DateTime.Today);
                _displayMonth = new DateOnly(today.Year, today.Month, 1);
            }
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (SelectedDate != _lastSyncedSelectedDate)
            SyncDisplayMonthToSelection(SelectedDate);
    }

    private static IReadOnlyDictionary<string, object> GetContainerAttributes() => ContainerAttributes;

    private async Task HandleOpenChanged(bool open)
    {
        _open = open;
        await RefreshOffThread();
    }

    internal async Task ClosePanel()
    {
        if (_open)
            _open = false;

        await RefreshOffThread();
    }

    private async Task NotifyValueChanged(bool valueChanged)
    {
        ChangeEventArgs? args = OnInput.HasDelegate || OnChange.HasDelegate ? new ChangeEventArgs { Value = GetSerializedValue() } : null;

        if (valueChanged)
            await SelectedDateChanged.InvokeIfHasDelegate(SelectedDate);

        if (args is not null)
        {
            await OnInput.InvokeIfHasDelegate(args);
            await OnChange.InvokeIfHasDelegate(args);
        }

        if (ParentValidation is not null)
            await ParentValidation.NotifyInputChanged(SelectedDate);
    }

    private async Task HandleCalendarChanged(DateOnly? date)
    {
        if (!date.HasValue)
            return;

        if ((Min.HasValue && date.Value < Min.Value) || (Max.HasValue && date.Value > Max.Value))
            return;

        var valueChanged = SelectedDate != date;
        SelectedDate = date;
        SyncDisplayMonthToSelection(date);

        if (ParentValidation is not null)
            ParentValidation.MarkTouched();

        await NotifyValueChanged(valueChanged);
        if (valueChanged)
            await _autoSave.NotifyValueChanged(SelectedDate, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await ClosePanel();
    }

    private async Task HandleCalendarMonthChanged(DateOnly? month)
    {
        if (month.HasValue)
            _displayMonth = new DateOnly(month.Value.Year, month.Value.Month, 1);

        await RefreshOffThread();
    }

    private void SyncDisplayMonthToSelection(DateOnly? selectedDate)
    {
        _lastSyncedSelectedDate = selectedDate;

        if (!selectedDate.HasValue)
            return;

        _displayMonth = new DateOnly(selectedDate.Value.Year, selectedDate.Value.Month, 1);
    }

    public override async ValueTask DisposeAsync()
    {
        try { await _autoSave.DisposeAsync(); }
        finally { await base.DisposeAsync(); }
    }

    private async Task HandleAutoSaveBlur(FocusEventArgs e)
    {
        if (AutoSaveOnBlur)
            _autoSave.QueueFlush(SelectedDate, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnBlur.InvokeAsync(e);
    }

    private async Task HandleAutoSaveKeyDown(KeyboardEventArgs e)
    {
        if (AutoSaveOnEnter && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            await _autoSave.Flush(SelectedDate, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnKeyDown.InvokeAsync(e);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(SelectedDate);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(AutoSaveOnBlur);
        hc.Add(AutoSaveOnEnter);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);
        hc.Add(OnAutoSave is not null);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
        hc.Add(Placeholder);
        hc.Add(Disabled);
        hc.Add(ReadOnly);
        hc.Add(Required);
        hc.Add(Min);
        hc.Add(Max);
        hc.Add(_open);
        hc.Add(_triggerId);
        AddIf(ref hc, InputSize);
    }
}
