@using System.Linq.Expressions
@using System.Threading
@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement
@implements Soenneker.Quark.IValidationInput
@implements IMemoInput
@inject IInputInterop InputInterop

@if (UsesAutoSaveStatusSlot)
{
    <Span Display="_renderCss0" Width="_renderCss1" MinWidth="_staticCss0" ItemsAlign="_renderCss2" Gap="_renderCss3">
        <textarea @ref="_elementRef" @attributes="BuildAttributes()" @bind:get="Value" @bind:set="HandleInputValueChanged" @bind:event="oninput" @onchange="(_cachedHandleChangeDelegate ??= HandleChange)"></textarea>
        <AutoSaveStatus State="@_autoSave.State"
                        HasSaved="@_autoSave.HasSaved"
                        Class="@ResolvedAutoSaveStatusClass"
                        SavingClass="@AutoSaveSavingClass"
                        SavedClass="@AutoSaveSavedClass"
                        FailedClass="@AutoSaveFailedClass" />
    </Span>
}
else
{
    <textarea @ref="_elementRef" @attributes="BuildAttributes()" @bind:get="Value" @bind:set="HandleInputValueChanged" @bind:event="oninput" @onchange="(_cachedHandleChangeDelegate ??= HandleChange)"></textarea>
}

@code {
    private static readonly CssValue<InputSizeBuilder> _staticCss1 = InputSizes.Default;
    private QuarkInt32Attribute _minlengthAttribute;
    private QuarkInt32Attribute _maxlengthAttribute;
    private QuarkInt32Attribute _rowsAttribute;
    private (bool PlainText, bool AutoSaveSlot, string? Size, string? Validation, string? BaseClass) _builtInputClassKey;
    private Func<Task>? _autoSaveRefreshCallback;
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<MinHeightBuilder> _defaultMinHeight = Quark.MinHeight.Token("16");
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Input.OnFocusVisible.Ring;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2_5.OnY.Is2;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Base.OnMd.Sm;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.NotAllowed.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.InlineFlex;
    private static readonly CssValue<WidthBuilder> _renderCss1 = Quark.Width.IsFull;
    private static readonly CssValue<ItemsBuilder> _renderCss2 = Items.Start;
    private static readonly CssValue<GapBuilder> _renderCss3 = Quark.Gap.Is2;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;

    private Func<ChangeEventArgs, Task>? _cachedHandleChangeDelegate;

    private object? _cachedHandleMemoBlurFocusEventArgsCallback;
    private object? _cachedHandleMemoKeyDownKeyboardEventArgsCallback;

    private ElementReference _elementRef;
    private AutoSaveController<string?> _autoSave;
    private InputSelectionSnapshot? _pendingSelectionRestore;

	/// <summary>
	/// Gets or sets the number of rows for the textarea.
	/// </summary>
	[Parameter]
	public int Rows { get; set; } = 3;

	/// <summary>
	/// Gets or sets the maximum length of the input.
	/// </summary>
	[Parameter]
	public int MaxLength { get; set; }

	/// <summary>
	/// Gets or sets the minimum length of the input.
	/// </summary>
	[Parameter]
	public int MinLength { get; set; }

	/// <summary>
	/// Gets or sets the pattern for validation.
	/// </summary>
	[Parameter]
	public string? Pattern { get; set; }

	/// <summary>
	/// Gets or sets whether the textarea should auto-resize.
	/// </summary>
	[Parameter]
	public bool AutoResize { get; set; }

	/// <summary>
	/// Gets or sets the size of the input.
	/// </summary>
	[Parameter]
	public CssValue<InputSizeBuilder>? InputSize { get; set; } = _staticCss1;

	/// <summary>
	/// Gets or sets the callback invoked When the value changes.
	/// </summary>
	[Parameter]
	public EventCallback<string?> ValueChanged { get; set; }

	/// <summary>
	/// Gets or sets the expression that identifies the bound value.
	/// </summary>
	[Parameter]
	public Expression<Func<string?>>? ValueExpression { get; set; }

	/// <summary>
	/// Gets or sets the callback invoked When the input changes.
	/// </summary>
	[Parameter]
	public EventCallback<ChangeEventArgs> OnChange { get; set; }

	/// <summary>
	/// Gets or sets the callback invoked When the input value changes.
	/// </summary>
	[Parameter]
	public EventCallback<ChangeEventArgs> OnInput { get; set; }

    [Parameter]
    public bool AutoSave { get; set; }

    [Parameter]
    public int AutoSaveDelay { get; set; } = 750;

    [Parameter]
    public bool AutoSaveOnBlur { get; set; } = true;

    [Parameter]
    public bool AutoSaveOnEnter { get; set; }

    [Parameter]
    public bool ShowAutoSaveStatus { get; set; } = true;

    [Parameter]
    public Func<string?, CancellationToken, ValueTask>? OnAutoSave { get; set; }

    [Parameter]
    public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }

    [Parameter]
    public string? AutoSaveStatusClass { get; set; }

    [Parameter]
    public string? AutoSaveSavingClass { get; set; }

    [Parameter]
    public string? AutoSaveSavedClass { get; set; }

    [Parameter]
    public string? AutoSaveFailedClass { get; set; }

	[CascadingParameter(Name = nameof(ParentValidation))]
	public Validation? ParentValidation { get; set; }

    /// <summary>
    /// Gets the value used for validation.
    /// </summary>
    public object? ValidationValue => Value;

    private bool UsesAutoSaveStatusSlot => AutoSave && OnAutoSave is not null && ShowAutoSaveStatus;

    private string? _resolvedAutoSaveStatusClass;
    private string ResolvedAutoSaveStatusClass
    {
        get
        {
            const string statusClass = "mt-3.5";

            return string.IsNullOrWhiteSpace(AutoSaveStatusClass)
                ? statusClass
                : QuarkStringCache.Concat(statusClass, " ", AutoSaveStatusClass!, ref _resolvedAutoSaveStatusClass);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
	{
        if (firstRender && ParentValidation is not null)
            ParentValidation.ValidationStatusChanged += OnParentValidationStatusChanged;

        if (firstRender)
            await InputInterop.Initialize();

		if (firstRender && ParentValidation is not null)
		{
			await ParentValidation.InitializeInput(this);

			if (ValueExpression is not null)
				await ParentValidation.InitializeInputExpression(ValueExpression);

		}

        await RestorePendingSelection();
        await base.OnAfterRenderAsync(firstRender);
	}

	private void OnParentValidationStatusChanged(object? sender, ValidationStatusChangedEventArgs e)
	{
		_ = RefreshOffThread();
	}

	private bool ShouldShowInvalid()
	{
		return ParentValidation?.ShouldShowInvalid == true;
	}

	private string? GetValidationClass()
	{
		if (ShouldShowInvalid())
			return "border-destructive ring-destructive/20 dark:ring-destructive/40";
		return null;
	}

	private string? GetSizeClass()
	{
		var sizeClass = InputSize?.ToString();
		return string.IsNullOrWhiteSpace(sizeClass) ? null : sizeClass;
	}

	protected override void ApplyDefaultParameters()
	{
		base.ApplyDefaultParameters();
		DataSlot ??= "textarea";

		Display ??= _defaultDisplay;
		MinHeight ??= _defaultMinHeight;
		Width ??= _renderCss1;
		Rounded ??= _defaultRounded;
		Border ??= _defaultBorder;
		BorderColor ??= _defaultBorderColor;
		BackgroundColor ??= _defaultBackgroundColor;
		Padding ??= _defaultPadding;
		TextSize ??= _defaultTextSize;
		Transition ??= _defaultTransition;
		OutlineStyle ??= _defaultOutlineStyle;
		RingColor ??= _defaultRingColor;
		Cursor ??= _defaultCursor;
		Opacity ??= _defaultOpacity;
	}

	protected override void BuildAttributesCore(Dictionary<string, object> attributes)
	{
		base.BuildAttributesCore(attributes);
        attributes.Remove("value");
        ApplyFieldControlAttributes(attributes, ShouldShowInvalid());

        var sizeClass = GetSizeClass();
        var validationClass = GetValidationClass();
        attributes.TryGetValue("class", out var existingClass);
        var baseClass = existingClass as string ?? existingClass?.ToString();
        if (existingClass is not null) attributes["class"] = baseClass!;
        var classKey = (false, UsesAutoSaveStatusSlot, sizeClass, validationClass, baseClass);
        if (_lastBuiltClass is null || _builtInputClassKey != classKey)
        {
            _builtInputClassKey = classKey;
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendClass(ref cls, "field-sizing-content placeholder:text-muted-foreground aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 dark:bg-input/30 focus-visible:ring-[3px]");
                if (sizeClass != null)
                    AppendClass(ref cls, sizeClass);
                if (validationClass != null)
                    AppendClass(ref cls, validationClass);
                if (UsesAutoSaveStatusSlot)
                    AppendClass(ref cls, "min-w-0 flex-1");
                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass);
            }
            finally
            {
                cls.Dispose();
            }
        }
        else
            attributes["class"] = _lastBuiltClass;

		if (Placeholder.HasContent())
			attributes["placeholder"] = Placeholder;

		if (Disabled)
			attributes["disabled"] = QuarkAttributeValues.True;

		if (ReadOnly)
			attributes["readonly"] = QuarkAttributeValues.True;

		if (Required)
			attributes["required"] = QuarkAttributeValues.True;

		if (Rows > 0)
			attributes["rows"] = _rowsAttribute.Get(Rows);

		if (MaxLength > 0)
			attributes["maxlength"] = _maxlengthAttribute.Get(MaxLength);

		if (MinLength > 0)
			attributes["minlength"] = _minlengthAttribute.Get(MinLength);

		if (Pattern.HasContent())
			attributes["pattern"] = Pattern;

		if (AutoResize)
            {
                var sty = new PooledStringBuilder(stackalloc char[64]);
                try
                {
                    AppendStyleDecl(ref sty, "resize: vertical; min-height: 60px;");
                    BuildStyleAttribute(attributes, ref sty, ref _lastBuiltStyle);
                }
                finally
                {
                    sty.Dispose();
                }
            }

        if (OnBlur.HasDelegate || (AutoSave && AutoSaveOnBlur && OnAutoSave is not null))
            attributes["onblur"] = (_cachedHandleMemoBlurFocusEventArgsCallback ??= EventCallback.Factory.Create<FocusEventArgs>(this, HandleMemoBlur));

        if (OnKeyDown.HasDelegate || (AutoSave && AutoSaveOnEnter && OnAutoSave is not null))
            attributes["onkeydown"] = (_cachedHandleMemoKeyDownKeyboardEventArgsCallback ??= EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleMemoKeyDown));
	}

    private async Task HandleInputValueChanged(string? newValue)
	{
		newValue ??= string.Empty;
		var valueChanged = false;
		if (Value != newValue)
		{
			Value = newValue;
			await ValueChanged.InvokeAsync(Value);
            await CapturePendingSelection(Value);
			valueChanged = true;
		}

		if (OnInput.HasDelegate)
			await OnInput.InvokeIfHasDelegate(new ChangeEventArgs { Value = Value });

		if (ParentValidation is not null)
		{
			ParentValidation.MarkTouched();
			await ParentValidation.NotifyInputChanged(Value);
		}

		if (valueChanged)
            await _autoSave.NotifyValueChanged(Value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
	}

    private async Task HandleChange(ChangeEventArgs e)
	{
		var newValue = e?.Value?.ToString() ?? string.Empty;
		var valueChanged = false;
		if (Value != newValue)
		{
			Value = newValue;
			await ValueChanged.InvokeAsync(Value);
			valueChanged = true;
		}

		await OnChange.InvokeIfHasDelegate(e);

		if (ParentValidation is not null)
		{
			ParentValidation.MarkTouched();
			await ParentValidation.NotifyInputChanged(Value);
		}

		if (valueChanged)
            await _autoSave.NotifyValueChanged(Value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
	}

    private async Task CapturePendingSelection(string? value)
    {
        var selection = await InputInterop.GetSelection(_elementRef);

        if (selection is not null && string.Equals(selection.Value, value, StringComparison.Ordinal))
            _pendingSelectionRestore = selection;
    }

    private async Task RestorePendingSelection()
    {
        var selection = _pendingSelectionRestore;

        if (selection is null)
            return;

        _pendingSelectionRestore = null;
        await InputInterop.RestoreSelection(_elementRef, selection.Start, selection.End, selection.Value);
    }

    private async Task HandleMemoBlur(FocusEventArgs e)
    {
        if (AutoSaveOnBlur)
            _autoSave.QueueFlush(Value, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnBlur.InvokeIfHasDelegate(e);
    }

    private async Task HandleMemoKeyDown(KeyboardEventArgs e)
    {
        if (AutoSaveOnEnter && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            await _autoSave.Flush(Value, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnKeyDown.InvokeIfHasDelegate(e);
    }

	public override async ValueTask DisposeAsync()
        {
        if (ParentValidation is not null)
            ParentValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
        try { await _autoSave.DisposeAsync(); }
        finally { await base.DisposeAsync(); }
    }

	protected override void ComputeRenderKeyCore(ref HashCode hc)
	{
        base.ComputeRenderKeyCore(ref hc);
		hc.Add(Value);
		hc.Add(Rows);
		hc.Add(MaxLength);
		hc.Add(MinLength);
		hc.Add(Pattern);
		hc.Add(AutoResize);
		AddIf(ref hc, InputSize);
		hc.Add(Placeholder);
		hc.Add(Disabled);
		hc.Add(ReadOnly);
		hc.Add(Required);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(AutoSaveOnBlur);
        hc.Add(AutoSaveOnEnter);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);
        hc.Add(OnAutoSave is not null);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
	}
}
