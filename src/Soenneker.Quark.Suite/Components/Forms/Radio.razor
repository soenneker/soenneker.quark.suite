@using System.Threading
@implements IAutoSaveInput<bool>
@using Soenneker.Atomics.ValueBools
@using System.Linq.Expressions
@using Soenneker.Blazor.Utils.Ids
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.ToggleElement
@implements Soenneker.Quark.IValidationInput
@implements IRadio

@if (AutoSave && ShowAutoSaveStatus && ParentRadioGroup is null)
{
    <Div Display="Soenneker.Quark.Display.Flex" ItemsAlign="Items.Center" Gap="Soenneker.Quark.Gap.Is2" MinWidth="Soenneker.Quark.MinWidth.Is0">
        @RenderAutoSaveControl()
        <AutoSaveStatus State="@_autoSave.State" HasSaved="@_autoSave.HasSaved" Visible="@(AutoSave && ShowAutoSaveStatus && OnAutoSave is not null)"
                Class="@AutoSaveStatusClass" SavingClass="@AutoSaveSavingClass"
                SavedClass="@AutoSaveSavedClass" FailedClass="@AutoSaveFailedClass" />
    </Div>
}
else
{
    @RenderAutoSaveControl()
}


@code {
    private RenderFragment RenderAutoSaveControl() => @<text>
@if (ParentRadioGroup is not null)
{
    @if (HasInlineLabel)
    {
        <label @attributes="BuildLabelAttributes()">
                <BradixRadioGroupItem Id="@ControlId"
                                      Value="@ResolvedGroupedValue"
                                      InputValue="@ResolvedGroupedValue"
                                      Disabled="@Disabled"
                                  OnClick="(_cachedHandleGroupedClickDelegate ??= HandleGroupedClick)"
                                  OnFocus="(_cachedHandleGroupedFocusDelegate ??= HandleGroupedFocus)"
                                  OnKeyDown="(_cachedHandleGroupedKeyDownDelegate ??= HandleGroupedKeyDown)"
                                      AdditionalAttributes="@BuildGroupedItemAttributes()">
                    <BradixRadioGroupIndicator AdditionalAttributes="@BuildGroupedIndicatorAttributes()">
                        <Span @attributes="BuildGroupedIndicatorDotAttributes()" ></Span>
                    </BradixRadioGroupIndicator>
                </BradixRadioGroupItem>
            @if (ChildContent != null)
            {
                @ChildContent
            }
        </label>
    }
    else
    {
        <BradixRadioGroupItem Id="@ControlId"
                              Value="@ResolvedGroupedValue"
                              InputValue="@ResolvedGroupedValue"
                              Disabled="@Disabled"
                              OnClick="(_cachedHandleGroupedClickDelegate ??= HandleGroupedClick)"
                              OnFocus="(_cachedHandleGroupedFocusDelegate ??= HandleGroupedFocus)"
                              OnKeyDown="(_cachedHandleGroupedKeyDownDelegate ??= HandleGroupedKeyDown)"
                              AdditionalAttributes="@BuildGroupedItemAttributes()">
            <BradixRadioGroupIndicator AdditionalAttributes="@BuildGroupedIndicatorAttributes()">
                <Span @attributes="BuildGroupedIndicatorDotAttributes()"></Span>
            </BradixRadioGroupIndicator>
        </BradixRadioGroupItem>
    }
}
else
{
    <Div @attributes="BuildWrapperAttributes()">
        @if (HasInlineLabel)
        {
            <label @attributes="BuildLabelAttributes()">
                <input
                    @attributes="BuildInputAttributes()"
                    @onclick="(_cachedHandleInputClickDelegate ??= HandleInputClick)"
                    @onchange="(_cachedHandleChangeDelegate ??= HandleChange)"
                    @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)" />
                <Span @attributes="BuildIndicatorAttributes()">
                    @if (EffectiveChecked)
                    {
                        <Span @attributes="BuildUngroupedIndicatorDotAttributes()" />
                    }
                </Span>
                @if (ChildContent != null)
                {
                    @ChildContent
                }
            </label>
        }
        else
        {
            <input
                @attributes="BuildInputAttributes()"
                @onclick="(_cachedHandleInputClickDelegate ??= HandleInputClick)"
                @onchange="(_cachedHandleChangeDelegate ??= HandleChange)"
                @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)" />
            <Span @attributes="BuildIndicatorAttributes()">
                @if (EffectiveChecked)
                {
                    <Span @attributes="BuildUngroupedIndicatorDotAttributes()" />
                }
            </Span>
        }
    </Div>
}
    </text>;

    [Parameter] public bool AutoSave { get; set; } = false;
    [Parameter] public int AutoSaveDelay { get; set; } = 750;
    [Parameter] public bool ShowAutoSaveStatus { get; set; } = true;
    [Parameter] public Func<bool, CancellationToken, ValueTask>? OnAutoSave { get; set; }
    [Parameter] public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }
    [Parameter] public string? AutoSaveStatusClass { get; set; }
    [Parameter] public string? AutoSaveSavingClass { get; set; }
    [Parameter] public string? AutoSaveSavedClass { get; set; }
    [Parameter] public string? AutoSaveFailedClass { get; set; }
    private AutoSaveController<bool> _autoSave;
    private Func<Task>? _autoSaveRefresh;
    private Task RefreshAutoSave() => InvokeAsync(StateHasChanged);
    private Task NotifyAutoSave(bool value) => _autoSave.NotifyValueChanged(value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, _autoSaveRefresh ??= RefreshAutoSave);

    private (string? Size, string? Validation) _itemClassKey;
    private string? _itemClass;

    private string GetRadioItemClass()
    {
        var size = GetSizeClass();
        var validation = GetValidationClass();
        var key = (size, validation);
        if (_itemClass is null || _itemClassKey != key)
        {
            _itemClassKey = key;
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendClass(ref cls, _shadcnRadioItemBase);
                if (size.HasContent()) AppendClass(ref cls, size);
                if (validation is not null) AppendClass(ref cls, validation);
                _itemClass = cls.ToString();
            }
            finally { cls.Dispose(); }
        }
        return _itemClass;
    }

    private Func<MouseEventArgs, Task>? _cachedHandleGroupedClickDelegate;
    private Func<FocusEventArgs, Task>? _cachedHandleGroupedFocusDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleGroupedKeyDownDelegate;

    private string? _lastBuiltClass;
    private string? _lastPrependedClass;
    private string? _groupedItemClass;

    private Func<MouseEventArgs, Task>? _cachedHandleInputClickDelegate;
    private Func<ChangeEventArgs, Task>? _cachedHandleChangeDelegate;
    private Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private static readonly IReadOnlyDictionary<string, object> GroupedIndicatorAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "radio-group-indicator",
        ["class"] = "flex size-4 items-center justify-center"
    };

    private static readonly IReadOnlyDictionary<string, object> GroupedIndicatorDotAttributes = new Dictionary<string, object>
    {
        ["aria-hidden"] = "true",
        ["class"] = "absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-foreground"
    };

    private static readonly IReadOnlyDictionary<string, object> UngroupedIndicatorDotAttributes = new Dictionary<string, object>
    {
        ["aria-hidden"] = "true",
        ["class"] = "absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-foreground",
        ["data-slot"] = "radio-group-indicator"
    };

    /// <summary>
    /// Gets or sets the callback invoked When the radio state changes.
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }

    [CascadingParameter(Name = "ParentRadioGroup")]
    public RadioGroup? ParentRadioGroup { get; set; }


    private QuarkAttributeDictionary _wrapperAttributeDictionaries;
    private QuarkAttributeDictionary _labelAttributeDictionaries;
    private QuarkAttributeDictionary _inputAttributeDictionaries;
    private QuarkAttributeDictionary _indicatorAttributeDictionaries;
    private QuarkAttributeDictionary _groupedItemAttributeDictionaries;
    private bool _hasObservedGroupedCheckedState;
    private bool _lastGroupedCheckedState;
    private bool HasInlineLabel => ChildContent != null;

    /// <summary>
    /// When inside RadioGroup, reflects group value; otherwise uses Checked.
    /// </summary>
    private bool EffectiveChecked => ParentRadioGroup != null
        ? string.Equals(ParentRadioGroup.Value, ResolvedGroupedValue, StringComparison.Ordinal)
        : Checked;

    /// <summary>
    /// When inside RadioGroup, true if group or this radio is disabled.
    /// </summary>
    private bool EffectiveDisabled => ParentRadioGroup?.Disabled == true || Disabled;

    private string? _generatedId;
    private string ControlId => Id != _generatedId || ParentRadioGroup is not null ? Id! : CurrentFieldContext?.ControlId ?? Id!;
    private string ResolvedGroupedValue => Value ?? ControlId;

    /// <summary>
    /// Gets or sets the size of the radio.
    /// </summary>
    [Parameter]
    public CssValue<RadioSizeBuilder>? RadioSize { get; set; }

    /// <summary>
    /// Gets or sets whether the radio should be displayed inline.
    /// </summary>
    [Parameter]
    public bool Inline { get; set; }

    /// <summary>
    /// Gets the value used for validation.
    /// Inside a radio group, the selected option value is the real control state.
    /// </summary>
    public object? ValidationValue => ParentRadioGroup is not null ? ParentRadioGroup.Value : EffectiveChecked ? QuarkAttributeValues.True : QuarkAttributeValues.False;

    protected override void OnInitialized()
    {
        if (Id.IsNullOrEmpty())
            Id = _generatedId = BlazorIdGenerator.New("quark-radio");
    }

    private Validation? _subscribedValidation;
    private Expression<Func<bool>>? _registeredValidationExpression;
    private ValueAtomicBool _validationDisposed;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (_validationDisposed.Value)
            return;
        var validation = ParentValidation;
        bool ownerChanged = !ReferenceEquals(_subscribedValidation, validation);
        if (ownerChanged)
        {
            if (_subscribedValidation is not null)
            {
                _subscribedValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
                _subscribedValidation.UnregisterInput(this);
            }
            _subscribedValidation = validation;
            _registeredValidationExpression = null;
            if (validation is not null)
                validation.ValidationStatusChanged += OnParentValidationStatusChanged;
        }
        if (validation is null)
            return;
        var expression = ParentRadioGroup is null ? CheckedExpression : null;
        if (!ReferenceEquals(_registeredValidationExpression, expression))
        {
            _registeredValidationExpression = expression;
            await validation.InitializeInputExpression(expression!);
        }
        if (ownerChanged && !_validationDisposed.Value && ReferenceEquals(_subscribedValidation, validation))
            await validation.InitializeInput(this);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ParentRadioGroup is not null)
        {
            if (!_hasObservedGroupedCheckedState)
            {
                _lastGroupedCheckedState = EffectiveChecked;
                _hasObservedGroupedCheckedState = true;
            }
            else if (_lastGroupedCheckedState != EffectiveChecked)
            {
                _lastGroupedCheckedState = EffectiveChecked;

                if (EffectiveChecked)
                {
                    if (OnChange.HasDelegate)
                        await OnChange.InvokeAsync(new ChangeEventArgs { Value = true });

                    if (ParentValidation is not null)
                    {
                        ParentValidation.MarkTouched();
                        await ParentValidation.NotifyInputChanged(ParentRadioGroup.Value, overrideNewValue: true);
                    }
                }
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnParentValidationStatusChanged(object? sender, ValidationStatusChangedEventArgs e)
    {
        _ = RefreshOffThread();
    }

    private Dictionary<string, object> BuildWrapperAttributes()
    {
        var attributes = _wrapperAttributeDictionaries.Create(1);
        {
            const string @class = "flex items-center gap-2";
            const string variant = @class + " " + "inline-flex";
            PrependClassAttribute(attributes, Inline ? variant : @class, ref _lastBuiltClass);
        }

        return attributes;
    }

    private string? GetSizeClass()
    {
        var sizeClass = RadioSize?.ToString();
        return string.IsNullOrWhiteSpace(sizeClass) ? null : sizeClass;
    }

    private Task HandleInputClick(MouseEventArgs e)
    {
        return base.HandleClick(e);
    }

    private Task HandleGroupedClick(MouseEventArgs e)
    {
        return base.HandleClick(e);
    }

    private Task HandleGroupedFocus(FocusEventArgs e)
    {
        return base.HandleFocus(e);
    }

    private Task HandleGroupedKeyDown(KeyboardEventArgs e)
    {
        return base.HandleKeyDown(e);
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (EffectiveDisabled)
            return;

        if (ParentRadioGroup != null)
        {
            await ParentRadioGroup.SetValue(Value);
            if (OnChange.HasDelegate)
                await OnChange.InvokeAsync(new ChangeEventArgs { Value = true });
            if (ParentValidation is not null)
            {
                ParentValidation.MarkTouched();
                await ParentValidation.NotifyInputChanged(ParentRadioGroup.Value, overrideNewValue: true);
            }
            return;
        }

        if (!Checked)
        {
            Checked = true;
            await CheckedChanged.InvokeAsync(true);
            await NotifyAutoSave(true);
            InvalidateRender();
        }

        if (OnChange.HasDelegate)

            await OnChange.InvokeAsync(new ChangeEventArgs { Value = Checked });

        if (ParentValidation is not null)
        {
            ParentValidation.MarkTouched();
            await ParentValidation.NotifyInputChanged(ValidationValue, overrideNewValue: true);
        }
    }


    private const string _shadcnRadioItemBase =
        "group/radio-group-item peer relative flex aspect-square size-4 shrink-0 rounded-full border border-input outline-hidden after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 aria-invalid:aria-checked:border-primary dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 data-[state=checked]:border-primary data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground dark:data-[state=checked]:bg-primary";

    private Dictionary<string, object> BuildLabelAttributes()
    {
        var attributes = _labelAttributeDictionaries.Create(2);
        const string labelClass = "flex items-center gap-3 text-sm font-medium leading-none select-none focus-within:outline-none rounded-[4px] cursor-pointer";
        attributes["class"] = EffectiveDisabled ? labelClass + " cursor-not-allowed opacity-50" : labelClass;
        attributes["for"] = ControlId;
        return attributes;
    }

    private Dictionary<string, object> BuildInputAttributes()
    {
        var attributes = _inputAttributeDictionaries.Create(12 + (Attributes?.Count ?? 0));
        foreach (var attribute in base.BuildAttributes())
            attributes[attribute.Key] = attribute.Value;
        attributes["id"] = ControlId;
        attributes["type"] = "radio";
        attributes["name"] = ParentRadioGroup?.EffectiveName ?? Name ?? ControlId;
        attributes["value"] = Value ?? string.Empty;
        attributes["checked"] = EffectiveChecked ? QuarkAttributeValues.True : QuarkAttributeValues.False;
        attributes["data-state"] = EffectiveChecked ? "checked" : "unchecked";
        attributes["tabindex"] = QuarkAttributeValues.Zero;

        if (Required)
            attributes["required"] = QuarkAttributeValues.True;

        if (AutoFocus)
            attributes["autofocus"] = QuarkAttributeValues.True;

        if (EffectiveDisabled)
            attributes["disabled"] = QuarkAttributeValues.True;

        PrependClassAttribute(attributes, "peer sr-only", ref _lastPrependedClass);

        if (ParentRadioGroup is null)
            ApplyFieldControlAttributes(attributes, ParentValidation?.Status == ValidationStatus.Error);

        return attributes;
    }

    private Dictionary<string, object> BuildIndicatorAttributes()
    {
        var attributes = _indicatorAttributeDictionaries.Create(4);
        attributes["data-slot"] = "radio-group-item";
        attributes["data-state"] = EffectiveChecked ? "checked" : "unchecked";

        if (EffectiveDisabled)
            attributes["data-disabled"] = "true";

        attributes["class"] = GetRadioItemClass();

        return attributes;
    }

    private Dictionary<string, object> BuildGroupedItemAttributes()
    {
        var attributes = _groupedItemAttributeDictionaries.Create(4 + (AdditionalAttributes?.Count ?? 0) + (Attributes?.Count ?? 0));
        foreach (var attribute in base.BuildAttributes())
            attributes[attribute.Key] = attribute.Value;
        attributes.Remove("type");
        attributes.Remove("role");
        attributes.Remove("aria-checked");
        attributes.Remove("data-state");
        attributes.Remove("disabled");
        attributes.Remove("name");
        attributes.Remove("value");
        attributes.Remove("checked");
        attributes.Remove("onclick");
        attributes.Remove("onchange");
        attributes.Remove("onkeydown");
        attributes.Remove("onfocus");
        attributes["data-slot"] = "radio-group-item";
        PrependClassAttribute(attributes, GetRadioItemClass(), ref _groupedItemClass);

        return attributes;
    }

    private static IReadOnlyDictionary<string, object> BuildGroupedIndicatorAttributes() => GroupedIndicatorAttributes;

    private static IReadOnlyDictionary<string, object> BuildGroupedIndicatorDotAttributes() => GroupedIndicatorDotAttributes;

    private static IReadOnlyDictionary<string, object> BuildUngroupedIndicatorDotAttributes() => UngroupedIndicatorDotAttributes;

    private string? GetValidationClass()
    {
        if (ParentValidation?.Status == ValidationStatus.Error)
            return "border-destructive ring-[3px] ring-destructive/20 dark:ring-destructive/40";
        return null;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(OnAutoSave);
        hc.Add(AutoSaveStateChanged);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);

        hc.Add(Checked);
        hc.Add(Disabled);
        hc.Add(Name);
        hc.Add(Value);
        hc.Add(ParentRadioGroup?.Value);
        AddIf(ref hc, RadioSize);
        hc.Add(Inline);
    }

    public override async ValueTask DisposeAsync()
    {
        await _autoSave.DisposeAsync();

        if (!_validationDisposed.TrySetTrue())
            return;
        if (_subscribedValidation is not null)
        {
            _subscribedValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
            _subscribedValidation.UnregisterInput(this);
            _subscribedValidation = null;
        }
        await base.DisposeAsync();
    }
}
