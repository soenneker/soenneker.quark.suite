@using System.Linq.Expressions
@using System.Text.Json
@using System.Threading
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Soenneker.Blazor.Utils.Clipboard.Abstract
@using Soenneker.Blazor.Utils.Ids

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement

@inject ICodeEditorInterop CodeEditorInterop
@inject IThemeInterop ThemeInterop
@inject IClipboardUtil ClipboardUtil

<div @ref="_dropZone" class="group/code-editor relative w-full min-w-0">
    @if (ShowCopyButton)
    {
        <button type="button"
                class="absolute top-2 right-2 z-10 inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border bg-background/95 text-muted-foreground shadow-xs transition-all hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none disabled:cursor-not-allowed disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
                title="@_copyButtonLabel"
                aria-label="@_copyButtonLabel"
                @onclick="CopyText">
            <Span ScreenReader="Quark.ScreenReader.Only">@_copyButtonLabel</Span>
            <Icon Name="LucideIcon.Copy" />
        </button>
    }

    <div @ref="_container" @attributes="BuildContainerAttributes()"></div>
    @if (AllowFileDrop && !ReadOnly)
    {
        <div hidden
             data-code-editor-drop-overlay
             class="pointer-events-none absolute inset-0 z-50 flex items-center justify-center rounded-lg border-2 border-primary bg-[color-mix(in_oklch,var(--surface),transparent_8%)] font-semibold text-primary">
            @FileDropLabel
        </div>
        <InputFile id="@_fileInputId"
                   class="sr-only"
                   tabindex="-1"
                   aria-hidden="true"
                   accept="@FileDropAccept"
                   multiple="@FileDropMultiple"
                   OnChange="HandleFilesDropped" />
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the code text value.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked When the code text changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> TextChanged { get; set; }

    /// <summary>
    /// Gets or sets the expression that identifies the bound text value for validation.
    /// </summary>
    [Parameter]
    public Expression<Func<string?>>? TextExpression { get; set; }

    /// <summary>
    /// Gets or sets the programming language for syntax highlighting.
    /// </summary>
    [Parameter]
    public string Language { get; set; } = "csharp";

    /// <summary>
    /// Gets or sets the editor theme (e.g., "vs", "vs-dark", "hc-black", or "auto" to follow app light/dark mode).
    /// </summary>
    [Parameter]
    public string Theme { get; set; } = "auto";

    /// <summary>
    /// Gets or sets whether word wrapping is enabled.
    /// </summary>
    [Parameter]
    public bool WordWrap { get; set; }

    /// <summary>
    /// Gets or sets whether the minimap is displayed.
    /// </summary>
    [Parameter]
    public bool Minimap { get; set; } = true;

    /// <summary>
    /// Gets or sets whether a copy-to-clipboard button is shown over the editor.
    /// </summary>
    [Parameter]
    public bool ShowCopyButton { get; set; }

    /// <summary>
    /// Gets or sets whether the editor height should automatically adjust to content.
    /// </summary>
    [Parameter]
    public bool AutoHeight { get; set; }

    /// <summary>
    /// Gets or sets the minimum number of lines to display.
    /// </summary>
    [Parameter]
    public int? MinLines { get; set; } = 3;

    /// <summary>
    /// Gets or sets the maximum number of lines to display.
    /// </summary>
    [Parameter]
    public int? MaxLines { get; set; } = 30;

    /// <summary>
    /// Gets or sets whether files can be dropped directly onto the editor.
    /// </summary>
    [Parameter]
    public bool AllowFileDrop { get; set; }

    /// <summary>
    /// Gets or sets the file types accepted by the hidden file input used for drops.
    /// </summary>
    [Parameter]
    public string? FileDropAccept { get; set; }

    /// <summary>
    /// Gets or sets whether more than one file can be dropped at a time.
    /// </summary>
    [Parameter]
    public bool FileDropMultiple { get; set; } = true;

    /// <summary>
    /// Gets or sets the maximum number of files accepted in one drop.
    /// </summary>
    [Parameter]
    public int MaxDroppedFiles { get; set; } = 10;

    /// <summary>
    /// Gets or sets the text displayed while files are dragged over the editor.
    /// </summary>
    [Parameter]
    public string FileDropLabel { get; set; } = "Drop files to insert";

    /// <summary>
    /// Handles dropped files and returns the text to insert at the drop position.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyList<IBrowserFile>, CancellationToken, ValueTask<string?>>? OnFilesDropped { get; set; }

    private readonly string _fileInputId = BlazorIdGenerator.New("code-editor-file-input");
    private readonly CancellationTokenSource _disposeCts = new();
    private ElementReference _dropZone;
    private ElementReference _container;
    private string? _lastText;
    private string? _lastLanguage;
    private string? _lastTheme;
    private bool _lastAutoHeight;
    private int? _lastMinLines;
    private int? _lastMaxLines;
    private bool _initialized;
    private bool _valueChanged;
    private bool _copyStateChanged;
    private bool _themeIsAuto;
    private bool _fileDropConfigured;
    private string _copyButtonLabel = "Copy";
    private DotNetObjectReference<CodeEditor>? _themeCallbackRef;
    private DotNetObjectReference<CodeEditor>? _editorCallbackRef;
    private const string AutoDarkTheme = "vs-dark";
    private static readonly string AutoLightTheme = new(['q', 'u', 'a', 'r', 'k', 'L', 'i', 'g', 'h', 't']);

    [JSInvokable]
    public async Task OnThemeChanged(bool isDark)
    {
        if (_themeIsAuto && _initialized)
            await CodeEditorInterop.SetTheme(GetAutoTheme(isDark));
    }

    [JSInvokable]
    public async Task OnCodeEditorTextChanged(string value)
    {
        if (string.Equals(Text, value, StringComparison.Ordinal))
            return;

        Text = value;
        _lastText = value;
        _valueChanged = true;
        await TextChanged.InvokeAsync(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CodeEditorInterop.Initialize();

            _themeIsAuto = string.Equals(Theme, "auto", StringComparison.OrdinalIgnoreCase);
            var effectiveTheme = Theme;
            if (_themeIsAuto)
            {
                await ThemeInterop.Initialize();
                var isDark = await ThemeInterop.GetIsDark();
                effectiveTheme = GetAutoTheme(isDark);
                _themeCallbackRef = DotNetObjectReference.Create(this);
                await CodeEditorInterop.RegisterThemeChangedCallback(_themeCallbackRef);
            }

            var options = new
            {
                value = Text ?? string.Empty,
                language = Language,
                theme = effectiveTheme,
                readOnly = ReadOnly,
                wordWrap = WordWrap ? "on" : "off",
                minimap = new { enabled = Minimap },
                automaticLayout = true
            };

            var json = JsonSerializer.Serialize(options);
            await CodeEditorInterop.CreateEditor(_container, json);
            _editorCallbackRef = DotNetObjectReference.Create(this);
            await CodeEditorInterop.RegisterContentChangedCallback(_container, _editorCallbackRef);

            // If auto-height is enabled, set up content change listener
            if (AutoHeight)
            {
                await CodeEditorInterop.AddContentChangeListener(_container, MinLines, MaxLines);
            }

            _initialized = true;
            _lastLanguage = Language;
            _lastTheme = Theme;
            _lastText = Text;
            _lastAutoHeight = AutoHeight;
            _lastMinLines = MinLines;
            _lastMaxLines = MaxLines;
        }
        else if (_initialized)
        {
            // OnParametersSet runs before the browser lays out visibility changes (e.g. DemoSection code panel
            // uses `hidden` on small viewports until "View Code"). Sync Monaco after paint.
            if (AutoHeight)
                await CodeEditorInterop.UpdateContentHeight(_container, MinLines, MaxLines);
            else
                await CodeEditorInterop.Layout(_container);
        }

        if (_initialized && AllowFileDrop && !ReadOnly && !_fileDropConfigured)
        {
            await CodeEditorInterop.ConfigureFileDrop(_container, _dropZone, _fileInputId);
            _fileDropConfigured = true;
        }
        else if (_initialized && (!AllowFileDrop || ReadOnly) && _fileDropConfigured)
        {
            await CodeEditorInterop.RemoveFileDrop(_container);
            _fileDropConfigured = false;
        }

        _valueChanged = false;
        _copyStateChanged = false;
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Set default width and height if not specified
        Width ??= Soenneker.Quark.Width.Is100;
        
        // Don't set a fixed height if AutoHeight is enabled
        if (!AutoHeight && Height == null && Style == null)
        {
            Style = "height: 300px";
        }

        if (_initialized)
        {
            var heightSettingsChanged = AutoHeight != _lastAutoHeight || MinLines != _lastMinLines || MaxLines != _lastMaxLines;

            if (!string.Equals(Text, _lastText, StringComparison.Ordinal))
            {
                await CodeEditorInterop.SetValue(_container, Text ?? string.Empty);
                _lastText = Text;
            }

            if (!string.Equals(Language, _lastLanguage, StringComparison.OrdinalIgnoreCase))
            {
                await CodeEditorInterop.SetLanguage(_container, Language);
                _lastLanguage = Language;
            }

            if (!string.Equals(Theme, _lastTheme, StringComparison.OrdinalIgnoreCase))
            {
                var effectiveTheme = string.Equals(Theme, "auto", StringComparison.OrdinalIgnoreCase)
                    ? GetAutoTheme(await ThemeInterop.GetIsDark())
                    : Theme;
                await CodeEditorInterop.SetTheme(effectiveTheme);
                _lastTheme = Theme;
            }

            if (AutoHeight && heightSettingsChanged)
            {
                await CodeEditorInterop.UpdateContentHeight(_container, MinLines, MaxLines);
            }

            _lastAutoHeight = AutoHeight;
            _lastMinLines = MinLines;
            _lastMaxLines = MaxLines;
        }

        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        return _valueChanged || _copyStateChanged || base.ShouldRender();
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attrs)
    {
        base.BuildAttributesCore(attrs);
        // Not used on wrapper div; still apply base surface/interactive attributes
    }

    private Dictionary<string, object> BuildContainerAttributes()
    {
        var attrs = new Dictionary<string, object>(base.BuildAttributes())
        {
            ["data-slot"] = "code-editor"
        };
        // Monaco editor needs position: relative for proper rendering
        BuildStyleAttribute(attrs, (ref sty) =>
        {
            AppendStyleDecl(ref sty, "position: relative");
            AppendStyleDecl(ref sty, "width: 100%");
            AppendStyleDecl(ref sty, "min-width: 0");
        });

        return attrs;
    }

    private async Task HandleFilesDropped(InputFileChangeEventArgs args)
    {
        if (OnFilesDropped is null || args.FileCount == 0)
            return;

        if (MaxDroppedFiles < 1)
            throw new InvalidOperationException($"{nameof(MaxDroppedFiles)} must be at least one.");

        if (!FileDropMultiple && args.FileCount > 1)
            throw new InvalidOperationException("Only one dropped file is allowed.");

        if (args.FileCount > MaxDroppedFiles)
            throw new InvalidOperationException($"No more than {MaxDroppedFiles} files can be dropped at once.");

        IReadOnlyList<IBrowserFile> files = args.GetMultipleFiles(MaxDroppedFiles);
        string? insertion = await OnFilesDropped(files, _disposeCts.Token);
        if (!string.IsNullOrEmpty(insertion))
            await CodeEditorInterop.InsertTextAtDropPosition(_container, insertion, _disposeCts.Token);
    }

    public override async ValueTask DisposeAsync()
    {
        await _disposeCts.CancelAsync();

        if (_themeCallbackRef != null)
        {
            await CodeEditorInterop.UnregisterThemeChangedCallback(_themeCallbackRef);
            _themeCallbackRef.Dispose();
            _themeCallbackRef = null;
        }

        if (_initialized)
        {
            try
            {
                await CodeEditorInterop.DisposeEditor(_container);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException or ObjectDisposedException)
            {
                // Ignore navigation-time JS teardown races.
            }
        }

        _editorCallbackRef?.Dispose();
        _editorCallbackRef = null;
        _disposeCts.Dispose();

        await base.DisposeAsync();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Text);
        hc.Add(Language);
        hc.Add(Theme);
        hc.Add(WordWrap);
        hc.Add(Minimap);
        hc.Add(ShowCopyButton);
        hc.Add(AutoHeight);
        hc.Add(MinLines);
        hc.Add(MaxLines);
        hc.Add(AllowFileDrop);
        hc.Add(FileDropAccept);
        hc.Add(FileDropMultiple);
        hc.Add(MaxDroppedFiles);
        hc.Add(FileDropLabel);
    }

    private async Task CopyText()
    {
        try
        {
            var value = _initialized
                ? await CodeEditorInterop.GetValue(_container)
                : Text;

            if (string.IsNullOrEmpty(value))
                return;

            await ClipboardUtil.WriteText(value);
            _copyButtonLabel = "Copied!";
            _copyStateChanged = true;
            StateHasChanged();

            await Task.Delay(1500);

            _copyButtonLabel = "Copy";
            _copyStateChanged = true;
            StateHasChanged();
        }
        catch
        {
            _copyButtonLabel = "Copy";
            _copyStateChanged = true;
        }
    }

    private static string GetAutoTheme(bool isDark) => isDark ? AutoDarkTheme : AutoLightTheme;
}
