@using Soenneker.Atomics.ValueBools
@using System.Linq.Expressions
@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Blazor.Utils.Ids
@using Soenneker.Bradix
@using System.Threading
@using BradixCheckboxCheckedState = Soenneker.Bradix.BradixCheckboxCheckedState

@namespace Soenneker.Quark
@inherits Soenneker.Quark.ToggleElement
@implements Soenneker.Quark.IValidationInput
@implements ICheck

@if (HasInlineLabel)
{
    <div @attributes="BuildWrapperAttributes()">
        <label @attributes="BuildLabelAttributes()">
            @ControlContent
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else if (Label.HasContent())
            {
                @Label
            }
            <AutoSaveStatus State="@_autoSave.State"
                            HasSaved="@_autoSave.HasSaved"
                            Visible="@UsesAutoSaveStatusSlot"
                            Class="@AutoSaveStatusClass"
                            SavingClass="@AutoSaveSavingClass"
                            SavedClass="@AutoSaveSavedClass"
                            FailedClass="@AutoSaveFailedClass" />
        </label>
    </div>
}
else if (UsesAutoSaveStatusSlot)
{
    <Span Display="_renderCss1" ItemsAlign="_renderCss2" Gap="_renderCss3">
        @ControlContent
        <AutoSaveStatus State="@_autoSave.State"
                        HasSaved="@_autoSave.HasSaved"
                        Visible="@UsesAutoSaveStatusSlot"
                        Class="@AutoSaveStatusClass"
                        SavingClass="@AutoSaveSavingClass"
                        SavedClass="@AutoSaveSavedClass"
                        FailedClass="@AutoSaveFailedClass" />
    </Span>
}
else
{
    @ControlContent
}

@code {
    private RenderFragment? _controlContent;
    private RenderFragment ControlContent => _controlContent ??= @<text>
        @if (Switch)
        {
            <BradixSwitch Checked="@Checked" Required="@Required" Disabled="@Disabled" Name="@Name" Form="@ResolvedForm"
                          Value="@ResolvedCheckboxValue" CheckedChanged="HandleSwitchChanged" OnClick="@OnClick"
                          AdditionalAttributes="@BuildControlAttributes()">
                <BradixSwitchThumb AdditionalAttributes="SwitchThumbAttributes" />
            </BradixSwitch>
        }
        else
        {
            <BradixCheckbox Checked="@CurrentCheckedState"
                            Required="@Required"
                            Disabled="@Disabled"
                            Name="@Name"
                            Form="@ResolvedForm"
                            Value="@ResolvedCheckboxValue"
                            CheckedChanged="(_cachedHandleCheckedStateChangedDelegate ??= HandleCheckedStateChanged)" OnClick="@OnClick"
                            AdditionalAttributes="@BuildControlAttributes()">
                <BradixCheckboxIndicator AdditionalAttributes="@BuildIndicatorAttributes()">
                    @if (Indeterminate)
                    {
                        <Icon Name="LucideIcon.Minus" Size='_renderCss0' aria-hidden="true" />
                    }
                    else
                    {
                        <Icon Name="LucideIcon.Check" Size='_renderCss0' aria-hidden="true" />
                    }
                </BradixCheckboxIndicator>
            </BradixCheckbox>
        }
    </text>;

    private Task HandleSwitchChanged(bool value) => HandleCheckedStateChanged(value ? BradixCheckboxCheckedState.Checked : BradixCheckboxCheckedState.Unchecked);

    private static readonly IReadOnlyDictionary<string, object> SwitchThumbAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "switch-thumb",
        ["class"] = "pointer-events-none block size-4 rounded-full bg-background ring-0 transition-transform group-data-[size=sm]/switch:size-3 data-[state=checked]:translate-x-[calc(100%-2px)] rtl:data-[state=checked]:-translate-x-[calc(100%-2px)] data-[state=unchecked]:translate-x-0"
    };
    private string? _switchClass;

    private Func<Task>? _autoSaveRefreshCallback;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is3_5;
    private static readonly CssValue<DisplayBuilder> _renderCss1 = Quark.Display.InlineFlex;
    private static readonly CssValue<ItemsBuilder> _renderCss2 = Items.Center;
    private static readonly CssValue<GapBuilder> _renderCss3 = Quark.Gap.Is2;
    private Func<BradixCheckboxCheckedState, Task>? _cachedHandleCheckedStateChangedDelegate;

    private string? _lastBuiltClass;
    private string? _lastBuiltClass3;
    private (string? Validation, string? Indicator, string? BaseClass, string? Size) _controlClassKey;
    private string? _lastControlStyle;

    private object? _cachedHandleControlBlurFocusEventArgsCallback;
    private object? _cachedHandleControlKeyDownKeyboardEventArgsCallback;

    private static readonly IReadOnlyDictionary<string, object> IndicatorAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "checkbox-indicator",
        ["class"] = "grid place-content-center text-current print:text-black transition-none [&>svg]:size-3.5"
    };

    private QuarkAttributeDictionary _wrapperAttributeDictionaries;
    private QuarkAttributeDictionary _labelAttributeDictionaries;
    private QuarkAttributeDictionary _controlAttributeDictionaries;

    private AutoSaveController<bool?> _autoSave;

    [Parameter]
    public bool Indeterminate { get; set; }

    [Parameter]
    public bool Switch { get; set; }

    [Parameter]
    public bool Inline { get; set; }

    [Parameter]
    public bool Reverse { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? IndicatorClass { get; set; }

    [Parameter]
    public string? IndicatorStyle { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    [Parameter]
    public bool AutoSave { get; set; }

    [Parameter]
    public int AutoSaveDelay { get; set; } = 750;

    [Parameter]
    public bool AutoSaveOnBlur { get; set; } = true;

    [Parameter]
    public bool AutoSaveOnEnter { get; set; }

    [Parameter]
    public bool ShowAutoSaveStatus { get; set; } = true;

    [Parameter]
    public Func<bool?, CancellationToken, ValueTask>? OnAutoSave { get; set; }

    [Parameter]
    public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }

    [Parameter]
    public string? AutoSaveStatusClass { get; set; }

    [Parameter]
    public string? AutoSaveSavingClass { get; set; }

    [Parameter]
    public string? AutoSaveSavedClass { get; set; }

    [Parameter]
    public string? AutoSaveFailedClass { get; set; }

    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }

    public object? ValidationValue => Checked ? QuarkAttributeValues.True : QuarkAttributeValues.False;

    private bool HasInlineLabel => ChildContent is not null || Label.HasContent();
    private bool UsesAutoSaveStatusSlot => AutoSave && OnAutoSave is not null && ShowAutoSaveStatus;
    private string? _generatedId;
    private string ControlId => Id != _generatedId ? Id! : CurrentFieldContext?.ControlId ?? Id!;
    private string ResolvedCheckboxValue => Value.HasContent() ? Value! : "on";
    private BradixCheckboxCheckedState CurrentCheckedState => Indeterminate
        ? BradixCheckboxCheckedState.Indeterminate
        : Checked
            ? BradixCheckboxCheckedState.Checked
            : BradixCheckboxCheckedState.Unchecked;

    protected override void OnInitialized()
    {
        Id ??= _generatedId = BlazorIdGenerator.New("quark-check");

        base.OnInitialized();
    }

    private Validation? _subscribedValidation;
    private Expression<Func<bool>>? _registeredValidationExpression;
    private ValueAtomicBool _validationDisposed;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (_validationDisposed.Value)
            return;
        var validation = ParentValidation;
        bool ownerChanged = !ReferenceEquals(_subscribedValidation, validation);
        if (ownerChanged)
        {
            if (_subscribedValidation is not null)
            {
                _subscribedValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
                _subscribedValidation.UnregisterInput(this);
            }
            _subscribedValidation = validation;
            _registeredValidationExpression = null;
            if (validation is not null)
                validation.ValidationStatusChanged += OnParentValidationStatusChanged;
        }
        if (validation is null)
            return;
        if (!ReferenceEquals(_registeredValidationExpression, CheckedExpression))
        {
            _registeredValidationExpression = CheckedExpression;
            await validation.InitializeInputExpression(CheckedExpression!);
        }
        if (ownerChanged && !_validationDisposed.Value && ReferenceEquals(_subscribedValidation, validation))
            await validation.InitializeInput(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnParentValidationStatusChanged(object? s, ValidationStatusChangedEventArgs e)
    {
        _ = RefreshOffThread();
    }

    public virtual Dictionary<string, object> BuildWrapperAttributes()
    {
        var attributes = _wrapperAttributeDictionaries.Create(2);
        {
            const string @class = "flex items-center gap-2";
            const string variant = @class + " " + "inline-flex";
            PrependClassAttribute(attributes, Inline ? variant : @class, ref _lastBuiltClass);
        }

        return attributes;
    }

    public virtual Dictionary<string, object> BuildLabelAttributes()
    {
        var attributes = _labelAttributeDictionaries.Create(2);
        attributes["for"] = ControlId;

        const string labelClass = "flex items-center gap-2 text-sm font-medium leading-none select-none group-data-[disabled=true]:pointer-events-none group-data-[disabled=true]:opacity-50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50";
        const string reversedClass = labelClass + " flex-row-reverse justify-end";
        const string disabledClass = labelClass + " cursor-not-allowed opacity-50";
        const string reversedDisabledClass = reversedClass + " cursor-not-allowed opacity-50";
        attributes["class"] = Reverse ? (Disabled ? reversedDisabledClass : reversedClass) : (Disabled ? disabledClass : labelClass);

        return attributes;
    }

    public virtual Dictionary<string, object> BuildControlAttributes()
    {
        var attributes = _controlAttributeDictionaries.Create(12 + (Attributes?.Count ?? 0));
        foreach (var attribute in base.BuildAttributes())
            attributes[attribute.Key] = attribute.Value;
        attributes.Remove("type");
        attributes.Remove("role");
        attributes.Remove("aria-checked");
        attributes.Remove("data-state");
        attributes.Remove("disabled");
        attributes.Remove("name");
        attributes.Remove("value");
        attributes.Remove("onclick");
        attributes["id"] = ControlId;
        attributes["data-slot"] = "checkbox";

        if (AriaLabel.HasContent())
            attributes["aria-label"] = AriaLabel!;

        if (AriaLabelledBy.HasContent())
            attributes["aria-labelledby"] = AriaLabelledBy!;

        if (OnBlur.HasDelegate || (AutoSave && AutoSaveOnBlur && OnAutoSave is not null))
            attributes["onblur"] = (_cachedHandleControlBlurFocusEventArgsCallback ??= EventCallback.Factory.Create<FocusEventArgs>(this, HandleControlBlur));

        if (OnKeyDown.HasDelegate || (AutoSave && AutoSaveOnEnter && OnAutoSave is not null))
            attributes["onkeydown"] = (_cachedHandleControlKeyDownKeyboardEventArgsCallback ??= EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleControlKeyDown));

        ApplyFieldControlAttributes(attributes, ParentValidation?.Status == ValidationStatus.Error);

        if (Switch)
        {
            attributes["data-slot"] = "switch";
            attributes["data-size"] = "default";
            PrependClassAttribute(attributes, "peer group/switch relative inline-flex shrink-0 items-center rounded-full border border-transparent transition-all outline-hidden focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 data-[size=default]:h-[18.4px] data-[size=default]:w-[32px] data-[size=sm]:h-[14px] data-[size=sm]:w-[24px] data-[state=checked]:bg-primary data-[state=unchecked]:bg-input disabled:cursor-not-allowed disabled:opacity-50", ref _switchClass);
            if (IndicatorStyle.HasContent())
                PrependStyleAttribute(attributes, IndicatorStyle!, ref _lastControlStyle);
            return attributes;
        }

        var validationClass = GetValidationClass();
        var size = ResolvePresetValue(Size, BuildPresetContext()?.Size, nameof(Size))?.ToString();

        var controlClassKey = (validationClass, IndicatorClass, attributes.GetValueOrDefault("class")?.ToString(), size);
        if (_lastBuiltClass3 is null || _controlClassKey != controlClassKey)
        {
            _controlClassKey = controlClassKey;
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendClass(ref cls, "peer relative flex shrink-0 items-center justify-center rounded-[4px] border border-input transition-colors outline-hidden");
                AppendClass(ref cls, "print:border-black print:data-[state=checked]:border-black print:data-[state=indeterminate]:border-black print:data-[state=checked]:bg-transparent print:data-[state=indeterminate]:bg-transparent group-has-disabled/field:opacity-50 after:absolute after:-inset-x-3 after:-inset-y-2");
                AppendClass(ref cls, "focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50");
                AppendClass(ref cls, "disabled:cursor-not-allowed disabled:opacity-50");
                AppendClass(ref cls, "aria-invalid:border-destructive aria-invalid:ring-destructive/20 aria-invalid:aria-checked:border-primary");
                AppendClass(ref cls, "dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40");
                AppendClass(ref cls, "data-[state=checked]:border-primary data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground dark:data-[state=checked]:bg-primary");
                AppendClass(ref cls, string.IsNullOrWhiteSpace(size) ? "size-4" : size);
                if (validationClass is not null)
                    AppendClass(ref cls, validationClass);
                if (IndicatorClass.HasContent())
                    AppendClass(ref cls, IndicatorClass!);
                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass3);
            }
            finally
            {
                cls.Dispose();
            }
        }
        else
            attributes["class"] = _lastBuiltClass3;

        if (IndicatorStyle.HasContent())
            PrependStyleAttribute(attributes, IndicatorStyle!, ref _lastControlStyle);

        return attributes;
    }

    private string? ResolvedForm => BuildControlAttributes().TryGetValue("form", out var form) ? form?.ToString() : null;

    private static IReadOnlyDictionary<string, object> BuildIndicatorAttributes() => IndicatorAttributes;

    private string? GetValidationClass()
    {
        return ParentValidation?.Status == ValidationStatus.Error
            ? "border-destructive ring-[3px] ring-destructive/20 dark:border-destructive/50 dark:ring-destructive/40"
            : null;
    }

    private async Task HandleCheckedStateChanged(BradixCheckboxCheckedState state)
    {
        var next = state == BradixCheckboxCheckedState.Checked;
        Checked = next;
        Indeterminate = state == BradixCheckboxCheckedState.Indeterminate;
        await CheckedChanged.InvokeAsync(next);
        await _autoSave.NotifyValueChanged(next, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
        Refresh();

        if (ParentValidation is not null)
        {
            ParentValidation.MarkTouched();
            await ParentValidation.NotifyInputChanged(next);
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync(new ChangeEventArgs { Value = next });
    }

    private async Task HandleControlBlur(FocusEventArgs e)
    {
        if (AutoSaveOnBlur)
            _autoSave.QueueFlush(Checked, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnBlur.InvokeIfHasDelegate(e);
    }

    private async Task HandleControlKeyDown(KeyboardEventArgs e)
    {
        if (AutoSaveOnEnter && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            await _autoSave.Flush(Checked, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnKeyDown.InvokeIfHasDelegate(e);
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_validationDisposed.TrySetTrue())
            return;
        if (_subscribedValidation is not null)
        {
            _subscribedValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
            _subscribedValidation.UnregisterInput(this);
            _subscribedValidation = null;
        }
        try { await _autoSave.DisposeAsync(); }
        finally { await base.DisposeAsync(); }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Checked);
        hc.Add(Disabled);
        hc.Add(Name);
        hc.Add(Value);
        hc.Add(Indeterminate);
        hc.Add(Switch);
        hc.Add(Inline);
        hc.Add(Reverse);
        hc.Add(Label);
        hc.Add(IndicatorClass);
        hc.Add(IndicatorStyle);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(AutoSaveOnBlur);
        hc.Add(AutoSaveOnEnter);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);
        hc.Add(OnAutoSave is not null);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
    }
}

