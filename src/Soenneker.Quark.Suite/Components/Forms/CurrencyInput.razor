@using System.Buffers
@using System.Globalization
@using System.Linq.Expressions
@using System.Threading
@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElementBase
@implements ICurrencyInput

<Div DataSlot="currency-input" Display="_renderCss0" Width="_renderCss1" MaxWidth="_currencyMaxWidth" ItemsAlign="_renderCss2" Gap="_renderCss3">
    <Span Position="_renderCss4" Display="_renderCss0" MinWidth="_staticCss0" Flex="_renderCss5">
        @if (ShowSymbol && !SymbolAtEnd)
        {
            <Span PointerEvents="_renderCss6" Position="_renderCss7" Top="_renderCss8" Bottom="_renderCss9" Left="_renderCss10" ZIndex="_renderCss11" Display="_renderCss12" ItemsAlign="_renderCss2" Padding="_renderCss13" TextSize="_renderCss14" TextColor="_renderCss15">
                @EffectiveSymbol
            </Span>
        }

        <Input Id="@Id" Name="@Name" Type="text" Value="@DisplayValue" ValueChanged="(_cachedHandleValueChangedDelegate ??= HandleValueChanged)" InputSize="@InputSize" PlainText="@PlainText" FloatingLabel="@FloatingLabel" Label="@Label" Placeholder="@Placeholder" Disabled="@Disabled" ReadOnly="@ReadOnly" Required="@Required" Class="@InputClass" Style="@InputStyle" AriaLabel="@AriaLabel" AriaDescribedBy="@AriaDescribedBy" OnClick="@OnClick" OnDoubleClick="@OnDoubleClick" OnMouseOver="@OnMouseOver" OnMouseOut="@OnMouseOut" OnKeyDown="(_cachedHandleInputKeyDownDelegate ??= HandleInputKeyDown)" OnInput="(_cachedHandleInputDelegate ??= HandleInput)" OnChange="(_cachedHandleChangeDelegate ??= HandleChange)" OnFocus="(_cachedHandleInputFocusDelegate ??= HandleInputFocus)" OnBlur="(_cachedHandleInputBlurDelegate ??= HandleInputBlur)" @attributes="BuildInputAttributes()" ValidationValueSelector="@(_validationValueSelector ??= () => (object?)Value)"/>

        @if (ShowSymbol && SymbolAtEnd)
        {
            <Span PointerEvents="_renderCss6" Position="_renderCss7" Top="_renderCss8" Right="_renderCss16" Bottom="_renderCss9" ZIndex="_renderCss11" Display="_renderCss12" ItemsAlign="_renderCss2" Padding="_renderCss17" TextSize="_renderCss14" TextColor="_renderCss15">
                @EffectiveSymbol
            </Span>
        }
    </Span>

    <AutoSaveStatus State="@_autoSave.State"
                    HasSaved="@_autoSave.HasSaved"
                    Visible="@UsesAutoSaveStatusSlot"
                    Class="@AutoSaveStatusClass"
                    SavingClass="@AutoSaveSavingClass"
                    SavedClass="@AutoSaveSavedClass"
                    FailedClass="@AutoSaveFailedClass" />
</Div>

@code {
    private static readonly CssValue<InputSizeBuilder> _staticCss1 = Quark.InputSizes.Default;
    private static readonly CssValue<MaxWidthBuilder> _currencyMaxWidth = CssValue<MaxWidthBuilder>.For(Quark.MaxWidth.Is48, "sm:max-w-56");
    private string? _inputStyle;
    private (decimal? Value, int Places, bool Thousands, CultureInfo Culture) _displayKey;
    private (decimal? Value, int Places, CultureInfo Culture) _editingKey;
    private string? _displayFormattedValue, _editingFormattedValue;
    private string? _displayFormat, _editingFormat;
    private (int Places, bool Thousands) _formatKey;
    private Func<object?>? _validationValueSelector;
    private Func<Task>? _autoSaveRefreshCallback;
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<DisplayBuilder> _renderCss0 = Quark.Display.InlineFlex;
    private static readonly CssValue<WidthBuilder> _renderCss1 = Quark.Width.IsFull;
    private static readonly CssValue<ItemsBuilder> _renderCss2 = Quark.Items.Center;
    private static readonly CssValue<GapBuilder> _renderCss3 = Quark.Gap.Is2;
    private static readonly CssValue<PositionBuilder> _renderCss4 = Quark.Position.Relative;
    private static readonly CssValue<FlexBuilder> _renderCss5 = Quark.Flex.Is1;
    private static readonly CssValue<PointerEventsBuilder> _renderCss6 = Quark.PointerEvents.None;
    private static readonly CssValue<PositionBuilder> _renderCss7 = Quark.Position.Absolute;
    private static readonly CssValue<TopBuilder> _renderCss8 = Quark.Top.Is0;
    private static readonly CssValue<BottomBuilder> _renderCss9 = Quark.Bottom.Is0;
    private static readonly CssValue<LeftBuilder> _renderCss10 = Quark.Left.Is0;
    private static readonly CssValue<ZIndexBuilder> _renderCss11 = Quark.ZIndex.Is10;
    private static readonly CssValue<DisplayBuilder> _renderCss12 = Quark.Display.Flex;
    private static readonly CssValue<PaddingBuilder> _renderCss13 = Quark.Padding.FromLeft.Is3;
    private static readonly CssValue<TextSizeBuilder> _renderCss14 = Quark.TextSize.Sm;
    private static readonly CssValue<TextColorBuilder> _renderCss15 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<RightBuilder> _renderCss16 = Quark.Right.Is0;
    private static readonly CssValue<PaddingBuilder> _renderCss17 = Quark.Padding.FromRight.Is3;
    private System.Func<string, Task>? _cachedHandleValueChangedDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleInputKeyDownDelegate;
    private System.Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private System.Func<ChangeEventArgs, Task>? _cachedHandleChangeDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleInputFocusDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleInputBlurDelegate;

    private QuarkAttributeDictionary _inputAttributesBuffer;
    private AutoSaveController<decimal?> _autoSave;

    [Parameter]
    public decimal? Value { get; set; }

    [Parameter]
    public EventCallback<decimal?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<decimal?>>? ValueExpression { get; set; }

    [Parameter]
    public decimal? Min { get; set; }

    [Parameter]
    public decimal? Max { get; set; }

    [Parameter]
    public bool AllowNegative { get; set; } = true;

    [Parameter]
    public int DecimalPlaces { get; set; } = 2;

    [Parameter]
    public bool UseThousandsSeparator { get; set; } = true;

    [Parameter]
    public string? Symbol { get; set; }

    [Parameter]
    public bool ShowSymbol { get; set; } = true;

    [Parameter]
    public bool SymbolAtEnd { get; set; }

    [Parameter]
    public string? CultureName { get; set; }

    [Parameter]
    public CssValue<InputSizeBuilder>? InputSize { get; set; } = _staticCss1;

    [Parameter]
    public bool PlainText { get; set; }

    [Parameter]
    public bool FloatingLabel { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    [Parameter]
    public bool AutoSave { get; set; }

    [Parameter]
    public int AutoSaveDelay { get; set; } = 750;

    [Parameter]
    public bool AutoSaveOnBlur { get; set; } = true;

    [Parameter]
    public bool AutoSaveOnEnter { get; set; }

    [Parameter]
    public bool ShowAutoSaveStatus { get; set; } = true;

    [Parameter]
    public Func<decimal?, CancellationToken, ValueTask>? OnAutoSave { get; set; }

    [Parameter]
    public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }

    [Parameter]
    public string? AutoSaveStatusClass { get; set; }

    [Parameter]
    public string? AutoSaveSavingClass { get; set; }

    [Parameter]
    public string? AutoSaveSavedClass { get; set; }

    [Parameter]
    public string? AutoSaveFailedClass { get; set; }

    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }

    public object? ValidationValue => Value;

    private string? _cultureNameSnapshot;
    private CultureInfo? _cultureSnapshot;
    private string _editingValue = string.Empty;
    private bool _isFocused;
    private bool UsesAutoSaveStatusSlot => AutoSave && OnAutoSave is not null && ShowAutoSaveStatus;

    private string EffectiveSymbol
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Symbol))
                return Symbol;

            return GetCultureInfo().NumberFormat.CurrencySymbol;
        }
    }

    private string DisplayValue => _isFocused ? _editingValue : FormatDisplayValue(Value);

    private string InputClass
    {
        get => "text-right tabular-nums";
    }

    private string? InputStyle
    {
        get
        {
            var symbolPadding = GetSymbolPaddingStyle();

            if (string.IsNullOrWhiteSpace(symbolPadding))
                return Style;

            if (string.IsNullOrWhiteSpace(Style))
                return symbolPadding;

            return QuarkStringCache.Concat(symbolPadding, " ", Style!, ref _inputStyle);
        }
    }

    public string? GetValidationClass()
    {
        if (ParentValidation?.Status == ValidationStatus.Error)
            return "is-invalid border-[var(--destructive,oklch(0.577_0.245_27.325))]";

        if (ParentValidation?.Status == ValidationStatus.Success)
            return "is-valid border-[var(--series-2,oklch(0.65_0.2_145))]";

        return null;
    }

    public string? GetColorClass()
    {
        return null;
    }

    public string? GetSizeClass()
    {
        var sizeClass = InputSize?.ToString();
        return string.IsNullOrWhiteSpace(sizeClass) ? null : sizeClass;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!_isFocused)
            _editingValue = FormatEditingValue(Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ParentValidation is not null && ValueExpression is not null)
        {
            ParentValidation.ValidationStatusChanged += OnParentValidationStatusChanged;
            await ParentValidation.InitializeInputExpression(ValueExpression);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnParentValidationStatusChanged(object? sender, ValidationStatusChangedEventArgs e)
    {
        _ = RefreshOffThread();
    }

    private async Task HandleValueChanged(string value)
    {
        _editingValue = value ?? string.Empty;

        if (!TryParseCurrency(_editingValue, out var next))
            return;

        var valueChanged = !Nullable.Equals(Value, next);
        Value = next;

        if (valueChanged)
        {
            await ValueChanged.InvokeIfHasDelegate(Value);
            await _autoSave.NotifyValueChanged(Value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        await OnInput.InvokeIfHasDelegate(e);

        if (ParentValidation is not null)
        {
            ParentValidation.MarkTouched();
            await ParentValidation.NotifyInputChanged(Value);
        }
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        await OnChange.InvokeIfHasDelegate(e);

        if (ParentValidation is not null)
        {
            ParentValidation.MarkTouched();
            await ParentValidation.NotifyInputChanged(Value);
        }
    }

    private async Task HandleInputFocus(FocusEventArgs e)
    {
        _isFocused = true;
        _editingValue = FormatEditingValue(Value);

        await OnFocus.InvokeIfHasDelegate(e);
        Refresh();
    }

    private async Task HandleInputBlur(FocusEventArgs e)
    {
        _isFocused = false;
        _editingValue = FormatEditingValue(Value);

        await OnBlur.InvokeIfHasDelegate(e);
        if (AutoSaveOnBlur)
            _autoSave.QueueFlush(Value, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        Refresh();
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (AutoSaveOnEnter && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            await _autoSave.Flush(Value, AutoSave, OnAutoSave, AutoSaveStateChanged, (_autoSaveRefreshCallback ??= RefreshOffThread));

        await OnKeyDown.InvokeIfHasDelegate(e);
    }

    private Dictionary<string, object> BuildInputAttributes()
    {
        var attributes = _inputAttributesBuffer.Create(Attributes?.Count ?? 0, StringComparer.OrdinalIgnoreCase);

        if (Attributes is not null)
        {
            foreach (var pair in Attributes)
            {
                if (pair.Key.Equals("onfocus", StringComparison.OrdinalIgnoreCase) || pair.Key.Equals("onblur", StringComparison.OrdinalIgnoreCase) || pair.Key.Equals("oninput", StringComparison.OrdinalIgnoreCase) || pair.Key.Equals("onchange", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                attributes[pair.Key] = pair.Value;
            }
        }

        attributes["inputmode"] = DecimalPlaces > 0 ? "decimal" : "numeric";

        return attributes;
    }

    private bool TryParseCurrency(string? input, out decimal? result)
    {
        result = null;

        if (string.IsNullOrWhiteSpace(input))
            return true;

        var culture = GetCultureInfo();
        ReadOnlySpan<char> trimmed = input.AsSpan().Trim();
        char[]? rented = null;
        Span<char> buffer = trimmed.Length <= 256 ? stackalloc char[trimmed.Length] :
            (rented = ArrayPool<char>.Shared.Rent(trimmed.Length));
        trimmed.CopyTo(buffer);
        var length = trimmed.Length;
        try
        {
            var symbol = EffectiveSymbol;
            if (!string.IsNullOrWhiteSpace(symbol))
                length = ReplaceCurrencyToken(buffer[..length], symbol, null);

            var format = culture.NumberFormat;
            if (!string.IsNullOrWhiteSpace(format.CurrencySymbol))
                length = ReplaceCurrencyToken(buffer[..length], format.CurrencySymbol, null);

            length = ReplaceCurrencyToken(buffer[..length], format.CurrencyGroupSeparator, null);
            length = ReplaceCurrencyToken(buffer[..length], format.NumberGroupSeparator, null);
            length = ReplaceCurrencyToken(buffer[..length], " ", null);
            if (format.CurrencyDecimalSeparator != ".")
                length = ReplaceCurrencyToken(buffer[..length], format.CurrencyDecimalSeparator, '.');
            if (format.NumberDecimalSeparator != "." && format.NumberDecimalSeparator != format.CurrencyDecimalSeparator)
                length = ReplaceCurrencyToken(buffer[..length], format.NumberDecimalSeparator, '.');
            length = ReplaceCurrencyToken(buffer[..length], "(", '-');
            length = ReplaceCurrencyToken(buffer[..length], ")", null);

            ReadOnlySpan<char> normalized = buffer[..length];
            if (!AllowNegative && normalized.Contains('-'))
                return false;
            if (!decimal.TryParse(normalized, NumberStyles.Number | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var parsed))
                return false;
            result = Clamp(parsed);
            return true;
        }
        finally
        {
            if (rented is not null)
                ArrayPool<char>.Shared.Return(rented);
        }
    }

    private static int ReplaceCurrencyToken(Span<char> buffer, string token, char? replacement)
    {
        // An empty grouping separator means that the culture does not group digits.
        if (token.Length == 0)
            return buffer.Length;
        int first = buffer.IndexOf(token.AsSpan(), StringComparison.Ordinal);
        if (first < 0)
            return buffer.Length;
        int written = first;
        int read = first;
        do
        {
            if (replacement.HasValue)
                buffer[written++] = replacement.Value;
            read += token.Length;
            int next = buffer[read..].IndexOf(token.AsSpan(), StringComparison.Ordinal);
            int count = next < 0 ? buffer.Length - read : next;
            buffer.Slice(read, count).CopyTo(buffer[written..]);
            written += count;
            read += count;
        } while (read < buffer.Length);
        return written;
    }

    private decimal Clamp(decimal value)
    {
        var rounded = Math.Round(value, Math.Max(0, DecimalPlaces), MidpointRounding.AwayFromZero);

        if (!AllowNegative && rounded < 0)
            rounded = 0;

        if (Min.HasValue && rounded < Min.Value)
            rounded = Min.Value;

        if (Max.HasValue && rounded > Max.Value)
            rounded = Max.Value;

        return rounded;
    }

    private void UpdateFormats()
    {
        var key = (Math.Max(0, DecimalPlaces), UseThousandsSeparator);
        if (_displayFormat is not null && _formatKey == key) return;
        _formatKey = key;
        _editingFormat = $"F{key.Item1}";
        _displayFormat = UseThousandsSeparator ? $"N{key.Item1}" : _editingFormat;
    }

    private string FormatDisplayValue(decimal? value)
    {
        if (!value.HasValue) return string.Empty;
        var culture = GetCultureInfo();
        var key = (value, DecimalPlaces, UseThousandsSeparator, culture);
        if (_displayFormattedValue is null || _displayKey != key || !culture.IsReadOnly || !ReferenceEquals(_displayKey.Culture, culture))
        {
            UpdateFormats();
            _displayFormattedValue = value.Value.ToString(_displayFormat, culture);
            _displayKey = key;
        }
        return _displayFormattedValue;
    }

    private string FormatEditingValue(decimal? value)
    {
        if (!value.HasValue) return string.Empty;
        var culture = GetCultureInfo();
        var key = (value, DecimalPlaces, culture);
        if (_editingFormattedValue is null || _editingKey != key || !culture.IsReadOnly || !ReferenceEquals(_editingKey.Culture, culture))
        {
            UpdateFormats();
            _editingFormattedValue = value.Value.ToString(_editingFormat, culture);
            _editingKey = key;
        }
        return _editingFormattedValue;
    }

    private string? GetSymbolPaddingStyle()
    {
        if (!ShowSymbol)
            return null;

        var length = EffectiveSymbol.AsSpan().Trim().Length;
        return (SymbolAtEnd, length) switch
        {
            (false, <= 1) => "padding-left: 2.25rem;",
            (false, <= 3) => "padding-left: 3rem;",
            (false, <= 6) => "padding-left: 4rem;",
            (false, _) => "padding-left: 5rem;",
            (true, <= 1) => "padding-right: 2.25rem;",
            (true, <= 3) => "padding-right: 3rem;",
            (true, <= 6) => "padding-right: 4rem;",
            _ => "padding-right: 5rem;"
        };
    }

    private CultureInfo GetCultureInfo()
    {
        if (string.IsNullOrWhiteSpace(CultureName))
            return CultureInfo.CurrentCulture;

        if (!string.Equals(_cultureNameSnapshot, CultureName, StringComparison.Ordinal))
        {
            _cultureNameSnapshot = CultureName;
            try { _cultureSnapshot = CultureInfo.GetCultureInfo(CultureName); }
            catch (CultureNotFoundException) { _cultureSnapshot = null; }
        }
        return _cultureSnapshot ?? CultureInfo.CurrentCulture;
    }

    public override async ValueTask DisposeAsync()
    {
        if (ParentValidation is not null)
            ParentValidation.ValidationStatusChanged -= OnParentValidationStatusChanged;
        try { await _autoSave.DisposeAsync(); }
        finally { await base.DisposeAsync(); }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(Min);
        hc.Add(Max);
        hc.Add(AllowNegative);
        hc.Add(DecimalPlaces);
        hc.Add(UseThousandsSeparator);
        hc.Add(Symbol);
        hc.Add(ShowSymbol);
        hc.Add(SymbolAtEnd);
        hc.Add(CultureName);
        AddIf(ref hc, InputSize);
        hc.Add(PlainText);
        hc.Add(FloatingLabel);
        hc.Add(Label);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(AutoSaveOnBlur);
        hc.Add(AutoSaveOnEnter);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);
        hc.Add(OnAutoSave is not null);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
        hc.Add(Placeholder);
        hc.Add(Disabled);
        hc.Add(ReadOnly);
        hc.Add(Required);
        hc.Add(_isFocused);
        hc.Add(_editingValue);
    }

}
