    /// </summary>
    public object? ValidationValue => SelectedDateTime;

    private bool _open;
    private string _inputText = string.Empty;
    private DateTime? _lastSyncedValue;
    private bool _initialized;
    private DateOnly _displayMonth = DateOnly.FromDateTime(DateTime.Today);
    private string[] _dayNames = [];
    private CultureInfo _currentCulture = CultureInfo.CurrentCulture;
    private CultureInfo? _dayNamesCulture;
    private DayOfWeek _dayNamesFirstDay;
    private Cell[]? _monthCells;
    private MonthCellState _monthCellState;
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _pendingDate;
    private int _hour; // 0-23
    private int _minute; // 0-59
    private bool _isAm;
    private const int _minuteStep = 1;
    private readonly string _panelId = BlazorIdGenerator.New("quark-datetimepicker-panel");

    private static readonly IReadOnlyDictionary<string, object> PanelAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "date-time-picker-panel"
    };

    private static readonly IReadOnlyDictionary<string, object> ContainerAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "date-time-picker",
        ["class"] = "q-date-time-picker relative w-full"
    };

    private static readonly string[] InputFormats =
    [
        "yyyy-MM-dd hh:mm tt", "yyyy-MM-dd h:mm tt",
        "yyyy-MM-dd HH:mm", "yyyy-MM-dd'T'HH:mm",
        "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss"
    ];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentCulture = CultureInfo.CurrentCulture;
        _today = DateOnly.FromDateTime(DateTime.Today);
        InitializeDayNames();

        if (!_initialized || SelectedDateTime != _lastSyncedValue)
        {
            SyncSelection();
            _initialized = true;
        }
    }

    private void SyncSelection()
    {
        _lastSyncedValue = SelectedDateTime;
        _inputText = SelectedDateTime.HasValue ? FormatDisplay(SelectedDateTime.Value) : string.Empty;
        SyncPanel();
    }

    private void SyncPanel()
    {
        var value = SelectedDateTime ?? DateTime.Now;
        _pendingDate = SelectedDateTime.HasValue ? DateOnly.FromDateTime(value) : null;
        _displayMonth = DateOnly.FromDateTime(value);
        _hour = value.Hour;
        _minute = value.Minute;
        _isAm = _hour < 12;
    }

    private async Task ApplyInput(ChangeEventArgs e)
    {
        _inputText = e.Value?.ToString() ?? string.Empty;
        DateTime? next = null;
        if (!string.IsNullOrWhiteSpace(_inputText))
        {
            if (!DateTime.TryParseExact(_inputText.AsSpan().Trim(), InputFormats, CultureInfo.InvariantCulture,
                    DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeLocal, out var parsed))
            {
                Refresh();
                return;
            }

            next = parsed;
        }

        var valueChanged = SelectedDateTime != next;
        SelectedDateTime = next;
        _lastSyncedValue = next;
        SyncPanel();
        if (valueChanged)
            await SelectedDateTimeChanged.InvokeIfHasDelegate(SelectedDateTime);

        if (ParentValidation is not null)
            await ParentValidation.NotifyInputChanged(SelectedDateTime);

        Refresh();
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        await ApplyInput(e);
        await OnInput.InvokeIfHasDelegate(e);
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        await ApplyInput(e);
        await OnChange.InvokeIfHasDelegate(e);
    }

    private static void PreventPanelAutoFocus(BradixAutoFocusEventArgs args) => args.PreventDefault();

    private string? GetSizeClass()
    {
        var sizeClass = InputSize?.ToString();
        return string.IsNullOrWhiteSpace(sizeClass) ? null : sizeClass;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ParentValidation is not null)
        {
            await ParentValidation.InitializeInput(this);

            if (SelectedDateTimeExpression is not null)
            {
                await ParentValidation.InitializeInputExpression(SelectedDateTimeExpression);
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private static string FormatDisplay(DateTime dt) => dt.ToString("yyyy-MM-dd hh:mm tt", CultureInfo.InvariantCulture);
    private int DisplayHour => _hour % 12 == 0 ? 12 : _hour % 12;

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        var sizeClass = GetSizeClass();
        var validationClass = (string?)null;
        attributes.TryGetValue("class", out var existingClass);
        var baseClass = existingClass as string ?? existingClass?.ToString();
        if (existingClass is not null) attributes["class"] = baseClass!;
        var classKey = (false, false, sizeClass, validationClass, baseClass);
        if (_lastBuiltClass is null || _builtInputClassKey != classKey)
        {
            _builtInputClassKey = classKey;
            var cls = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendClass(ref cls, "selection:bg-primary selection:text-primary-foreground dark:bg-input/30 dark:hover:bg-input/50");
                AppendClass(ref cls, "focus-visible:ring-[3px]");
                AppendClass(ref cls, "aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20 dark:aria-[invalid=true]:ring-destructive/40");
                if (sizeClass != null)
                    AppendClass(ref cls, sizeClass);
                BuildClassAttribute(attributes, ref cls, ref _lastBuiltClass);
            }
            finally
            {
                cls.Dispose();
            }
        }
        else
            attributes["class"] = _lastBuiltClass;

        if (Placeholder.HasContent())
            attributes["placeholder"] = Placeholder!;

        if (Disabled)
            attributes["disabled"] = QuarkAttributeValues.True;

        if (ReadOnly)
            attributes["readonly"] = QuarkAttributeValues.True;

        if (Required)
            attributes["required"] = QuarkAttributeValues.True;

        if (ParentValidation?.Status == ValidationStatus.Error)
            attributes["aria-invalid"] = "true";

        attributes["aria-expanded"] = _open ? "true" : "false";
        attributes["aria-controls"] = _panelId;

        // min/max intentionally omitted for text input (handled in panel)

        attributes["onclick"] = (_cachedOpenPanelMouseEventArgsCallback ??= EventCallback.Factory.Create<MouseEventArgs>(this, OpenPanel));
        attributes["onfocus"] = (_cachedOpenPanelFocusEventArgsCallback ??= EventCallback.Factory.Create<FocusEventArgs>(this, OpenPanel));

        attributes["autocomplete"] = "off";
        attributes["oninput"] = (_cachedHandleInputChangeEventArgsCallback ??= EventCallback.Factory.Create<ChangeEventArgs>(this, HandleInput));
        attributes["onchange"] = (_cachedHandleChangeChangeEventArgsCallback ??= EventCallback.Factory.Create<ChangeEventArgs>(this, HandleChange));
    }

    private static IReadOnlyDictionary<string, object> GetContainerAttributes() => ContainerAttributes;

    private void InitializeDayNames()
    {
        var culture = _currentCulture;
        var first = culture.DateTimeFormat.FirstDayOfWeek;

        if (culture.IsReadOnly && ReferenceEquals(_dayNamesCulture, culture) && _dayNamesFirstDay == first && _dayNames.Length != 0)
            return;

        var names = culture.DateTimeFormat.AbbreviatedDayNames;
        var dayNames = new string[7];

        for (var i = 0; i < dayNames.Length; i++)
        {
            dayNames[i] = names[((int)first + i) % 7];
        }

        _dayNames = dayNames;
        _dayNamesCulture = culture;
        _dayNamesFirstDay = first;
    }


    private static readonly string[] DayClasses = CreateDayClasses();

    private static string[] CreateDayClasses()
    {
        var classes = new string[8];
        for (var i = 0; i < classes.Length; i++)
            classes[i] = CreateDayClass(i);
        return classes;
    }

    private string GetDayClass(Cell day) => DayClasses[
        (day.InMonth ? 0 : 1) | (day.Date == _today ? 2 : 0) |
        (SelectedDateTime.HasValue && day.Date == DateOnly.FromDateTime(SelectedDateTime.Value) ? 4 : 0)];

    private static string CreateDayClass(int state)
    {
        var css = "relative flex aspect-square h-8 w-8 items-center justify-center rounded-lg text-sm outline-none transition-all focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50";

        if ((state & 1) != 0)
            css += " text-muted-foreground opacity-50";

        if ((state & 2) != 0)
            css += " bg-accent text-accent-foreground";

        if ((state & 4) != 0)
            css += " bg-primary text-primary-foreground hover:bg-primary hover:text-primary-foreground";
        else
            css += " hover:bg-muted hover:text-foreground";

        return css;
    }

    private Cell[] BuildMonthCells()
    {
        var culture = _currentCulture;
        var firstOfMonth = new DateOnly(_displayMonth.Year, _displayMonth.Month, 1);
        var state = new MonthCellState(firstOfMonth, culture.Name, culture.DateTimeFormat.FirstDayOfWeek,
            Min.HasValue ? DateOnly.FromDateTime(Min.Value) : null, Max.HasValue ? DateOnly.FromDateTime(Max.Value) : null);

        if (_monthCells is not null && _monthCellState.Equals(state))
            return _monthCells;

        var startDow = culture.DateTimeFormat.FirstDayOfWeek;
        var offset = ((int)firstOfMonth.DayOfWeek - (int)startDow + 7) % 7;
        var gridStart = firstOfMonth.AddDays(-offset);
        var cells = new Cell[42];

        for (var i = 0; i < 42; i++)
        {
            var d = gridStart.AddDays(i);
            var inMonth = d.Month == _displayMonth.Month;
            var disabled = (state.Min.HasValue && d < state.Min.Value) || (state.Max.HasValue && d > state.Max.Value);
            cells[i] = new Cell(this, d, inMonth, disabled);
        }

        _monthCellState = state;
        _monthCells = cells;
        return cells;
    }

    private Task OpenPanel()
    {
        if (Disabled || ReadOnly)
            return Task.CompletedTask;

        if (!_open)
            _open = true;
        Refresh();
        return Task.CompletedTask;
    }

    private Task HandleOpenChanged(bool open)
    {
        _open = open;
        Refresh();
        return Task.CompletedTask;
    }

    internal async Task ClosePanel()
    {
        if (_open)
            _open = false;
        await RefreshOffThread();
    }


    private async Task Commit()
    {
        var date = _pendingDate ?? (SelectedDateTime.HasValue ? DateOnly.FromDateTime(SelectedDateTime.Value) : _today);
        var dt = new DateTime(date.Year, date.Month, date.Day, _hour, _minute, 0);

        if (SelectedDateTime != dt)
        {
            SelectedDateTime = dt;
            SyncSelection();
            await SelectedDateTimeChanged.InvokeAsync(SelectedDateTime);
        }

        SyncSelection();

        if (ParentValidation is not null)
        {
            ParentValidation.MarkTouched();
            await ParentValidation.NotifyInputChanged(SelectedDateTime);
        }

        Refresh();
    }

    private async Task SelectDate(DateOnly date)
    {
        if ((Min.HasValue && date < DateOnly.FromDateTime(Min.Value)) || (Max.HasValue && date > DateOnly.FromDateTime(Max.Value)))
            return;

        _pendingDate = date;
        await Commit();
    }

    private Task IncrementHour()
    {
        _hour = (_hour + 1) % 24;
        _isAm = _hour < 12;
        return Commit();
    }

    private Task DecrementHour()
    {
        _hour = (_hour + 23) % 24;
        _isAm = _hour < 12;
        return Commit();
    }

    private Task IncrementMinute()
    {
        _minute = (_minute + _minuteStep) % 60;
        return Commit();
    }

    private Task DecrementMinute()
    {
        _minute = (_minute + 60 - _minuteStep) % 60;
        return Commit();
    }

    private Task SetAmPm(bool am)
    {
        _isAm = am;
        if (am && _hour >= 12)
            _hour -= 12;
        if (!am && _hour < 12)
            _hour += 12;
        return Commit();
    }

    private Task ToggleAmPm() => SetAmPm(!_isAm);
    private Task OnHourWheel(WheelEventArgs e) => e.DeltaY < 0 ? IncrementHour() : DecrementHour();
    private Task OnMinuteWheel(WheelEventArgs e) => e.DeltaY < 0 ? IncrementMinute() : DecrementMinute();

    private Task OnHourKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp")
            return IncrementHour();
        if (e.Key == "ArrowDown")
            return DecrementHour();
        return Task.CompletedTask;
    }

    private Task OnMinuteKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp")
            return IncrementMinute();
        if (e.Key == "ArrowDown")
            return DecrementMinute();
        return Task.CompletedTask;
    }

    private Task OnHourInput(ChangeEventArgs e)
    {
        if (e?.Value is null)
            return Task.CompletedTask;
        if (int.TryParse(e.Value.ToString(), out var v))
        {
            v = Math.Clamp(v, 1, 12);
            // preserve am/pm while mapping 12->0 for AM case
            var baseHour = _isAm ? 0 : 12;
            _hour = v % 12 + baseHour;
            return Commit();
        }

        return Task.CompletedTask;
    }

    private Task OnMinuteInput(ChangeEventArgs e)
    {
        if (e?.Value is null)
            return Task.CompletedTask;
        if (int.TryParse(e.Value.ToString(), out var v))
        {
            v = (v % 60 + 60) % 60;
            _minute = v;
            return Commit();
        }

        return Task.CompletedTask;
    }

    private Task PrevMonth()
    {
        _displayMonth = _displayMonth.AddMonths(-1);
        Refresh();
        return Task.CompletedTask;
    }

    private Task NextMonth()
    {
        _displayMonth = _displayMonth.AddMonths(1);
        Refresh();
        return Task.CompletedTask;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(SelectedDateTime);
        hc.Add(_inputText);
        hc.Add(Placeholder);
        hc.Add(Disabled);
        hc.Add(ReadOnly);
        hc.Add(Required);
        hc.Add(Min);
        hc.Add(Max);
        hc.Add(_open);
        hc.Add(_panelId);
        hc.Add(_displayMonth);
        hc.Add(_pendingDate);
        hc.Add(_hour);
        hc.Add(_minute);
        hc.Add(_isAm);
        AddIf(ref hc, InputSize);
    }

}
