@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits LocalizedFormControlElement
@implements IValidationInput
@implements IDateTimePicker

@if (AutoSave && ShowAutoSaveStatus)
{
    <Div Display="Soenneker.Quark.Display.Flex" ItemsAlign="Items.Center" Gap="Soenneker.Quark.Gap.Is2" MinWidth="Soenneker.Quark.MinWidth.Is0">
        @RenderAutoSaveControl()
        <AutoSaveStatus State="@_autoSave.State" HasSaved="@_autoSave.HasSaved" Visible="@(AutoSave && ShowAutoSaveStatus && OnAutoSave is not null)"
                Class="@AutoSaveStatusClass" SavingClass="@AutoSaveSavingClass"
                SavedClass="@AutoSaveSavedClass" FailedClass="@AutoSaveFailedClass" />
    </Div>
}
else
{
    @RenderAutoSaveControl()
}


@code {
    private RenderFragment RenderAutoSaveControl() => @<text>
<Popover Open="@_open" OpenChanged="(_cachedHandleOpenChangedDelegate ??= HandleOpenChanged)">
    <Div @attributes="GetContainerAttributes()">
        <PopoverAnchor>
            <input type="text" value="@_inputText" @attributes="BuildAttributes()"/>
        </PopoverAnchor>

        <PopoverContent Id="@_panelId" Side="Side.Bottom" Align="Alignment.Start" OnOpenAutoFocusDetailed="PreventPanelAutoFocus" Width="_renderCss0" MinWidth='_staticCss4' Rounded="_renderCss1" Border="_renderCss2" BackgroundColor="_renderCss3" Padding="_renderCss4" TextColor="_renderCss5" Shadow="_renderCss6" @attributes="PanelAttributes">
            <CascadingValue TValue="Validation" Name="ParentValidation" Value="@((Validation?)null)" IsFixed="true">
            <Calendar SelectedDate="_pendingDate"
                      SelectedDateChanged="(_calendarDateChanged ??= HandleCalendarDateChanged)"
                      DisplayMonth="_displayMonth"
                      DisplayMonthChanged="(_calendarMonthChanged ??= HandleCalendarMonthChanged)"
                      Min="@(Min.HasValue ? DateOnly.FromDateTime(Min.Value) : (DateOnly?)null)"
                      Max="@(Max.HasValue ? DateOnly.FromDateTime(Max.Value) : (DateOnly?)null)"
                      Disabled="Disabled" ReadOnly="ReadOnly"
                      Border="_calendarBorder" Padding="_calendarPadding" />

            <Div Flex="_timeFlex" Justify="_timeJustify" Margin="_renderCss20" Display="_renderCss8" ItemsAlign="_renderCss9" Gap="_renderCss21" Border="_renderCss22" Padding="_renderCss23">
                <Div Display="_renderCss8" ItemsAlign="_renderCss9" Gap="_renderCss14">
                    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss2" AriaLabel="Decrease hour" @onclick="(_cachedDecrementHourDelegate ??= DecrementHour)">-</Button>
                    <Input Type="number" Value="@DisplayHour.ToString(CultureInfo.InvariantCulture)" Width="_renderCss24" TextAlign="_renderCss25" Class="[appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" aria-label="@Localizer["Hour"]" step="1" min="1" max="12" OnInput="(_cachedOnHourInputDelegate ??= OnHourInput)"/>
                    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss2" AriaLabel="Increase hour" @onclick="(_cachedIncrementHourDelegate ??= IncrementHour)">+</Button>
                </Div>
                <Span TextSize="_renderCss11" TextColor="_renderCss19">:</Span>
                <Div Display="_renderCss8" ItemsAlign="_renderCss9" Gap="_renderCss14">
                    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss2" AriaLabel="Decrease minute" @onclick="(_cachedDecrementMinuteDelegate ??= DecrementMinute)">-</Button>
                    <Input Type="number" Value="@_minute.ToString(CultureInfo.InvariantCulture)" Width="_renderCss24" TextAlign="_renderCss25" Class="[appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" aria-label="@Localizer["Minute"]" Step="@_minuteStep.ToString(CultureInfo.InvariantCulture)" min="0" max="59" OnInput="(_cachedOnMinuteInputDelegate ??= OnMinuteInput)"/>
                    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss2" AriaLabel="Increase minute" @onclick="(_cachedIncrementMinuteDelegate ??= IncrementMinute)">+</Button>
                </Div>
                <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss1" Title="Click to toggle" @onclick="(_cachedToggleAmPmDelegate ??= ToggleAmPm)">@(_isAm ? "AM" : "PM")</Button>
            </Div>
            </CascadingValue>
        </PopoverContent>
    </Div>
</Popover>
    </text>;

    [Parameter] public bool AutoSave { get; set; } = false;
    [Parameter] public int AutoSaveDelay { get; set; } = 750;
    [Parameter] public bool ShowAutoSaveStatus { get; set; } = true;
    [Parameter] public Func<DateTime?, CancellationToken, ValueTask>? OnAutoSave { get; set; }
    [Parameter] public EventCallback<AutoSaveState> AutoSaveStateChanged { get; set; }
    [Parameter] public string? AutoSaveStatusClass { get; set; }
    [Parameter] public string? AutoSaveSavingClass { get; set; }
    [Parameter] public string? AutoSaveSavedClass { get; set; }
    [Parameter] public string? AutoSaveFailedClass { get; set; }
    private AutoSaveController<DateTime?> _autoSave;
    private Func<Task>? _autoSaveRefresh;
    private Task RefreshAutoSave() => InvokeAsync(StateHasChanged);
    private Task NotifyAutoSave(DateTime? value) => _autoSave.NotifyValueChanged(value, AutoSave, AutoSaveDelay, OnAutoSave, AutoSaveStateChanged, _autoSaveRefresh ??= RefreshAutoSave);

    private static readonly CssValue<BorderBuilder> _calendarBorder = Quark.Border.Is0;
    private static readonly CssValue<PaddingBuilder> _calendarPadding = Quark.Padding.Is0;
    private static readonly CssValue<FlexBuilder> _timeFlex = Quark.Flex.Wrap;
    private static readonly CssValue<JustifyBuilder> _timeJustify = Quark.Justify.Center;
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        var sizeClass = GetSizeClass();
        AppendClass(ref cls, "selection:bg-primary selection:text-primary-foreground dark:bg-input/30 dark:hover:bg-input/50");
        AppendClass(ref cls, "focus-visible:ring-[3px]");
        AppendClass(ref cls, "aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20 dark:aria-[invalid=true]:ring-destructive/40");
        if (sizeClass != null)
            AppendClass(ref cls, sizeClass);
    }

    private static readonly CssValue<InputSizeBuilder> _staticCss5 = InputSizes.Default;
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is0;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss1 = ButtonSize.Sm;
    private static readonly CssValue<ButtonSizeBuilder> _staticCss2 = ButtonSize.IconSm;
    private static readonly CssValue<MinWidthBuilder> _staticCss4 = Quark.MinWidth.Token("[18rem]");
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Input.OnFocusVisible.Ring;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Transparent;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is2_5.OnY.Is1;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Soenneker.Quark.Variant.Of(Quark.TextColor.MutedForeground).Custom("placeholder");
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.OnDisabled.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.OnDisabled.NotAllowed;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.OnDisabled.Is50;
    private static readonly CssValue<WidthBuilder> _renderCss0 = Quark.Width.Auto;
    private static readonly CssValue<RoundedBuilder> _renderCss1 = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _renderCss2 = Quark.Border.Default;
    private static readonly CssValue<BackgroundColorBuilder> _renderCss3 = Quark.BackgroundColor.Popover;
    private static readonly CssValue<PaddingBuilder> _renderCss4 = Quark.Padding.Is3;
    private static readonly CssValue<TextColorBuilder> _renderCss5 = Quark.TextColor.PopoverForeground;
    private static readonly CssValue<ShadowBuilder> _renderCss6 = Quark.Shadow.Md;
    private static readonly CssValue<DisplayBuilder> _renderCss8 = Quark.Display.Flex;
    private static readonly CssValue<ItemsBuilder> _renderCss9 = Items.Center;
    private static readonly CssValue<TextSizeBuilder> _renderCss11 = Quark.TextSize.Sm;
    private static readonly CssValue<GapBuilder> _renderCss14 = Quark.Gap.Is1;
    private static readonly CssValue<HeightBuilder> _renderCss15 = Quark.Height.Is8;
    private static readonly CssValue<TextColorBuilder> _renderCss19 = Quark.TextColor.MutedForeground;
    private static readonly CssValue<MarginBuilder> _renderCss20 = Quark.Margin.FromTop.Is3;
    private static readonly CssValue<GapBuilder> _renderCss21 = Quark.Gap.Is2;
    private static readonly CssValue<BorderBuilder> _renderCss22 = Quark.Border.FromTop.Is1;
    private static readonly CssValue<PaddingBuilder> _renderCss23 = Quark.Padding.FromTop.Is3;
    private static readonly CssValue<WidthBuilder> _renderCss24 = Quark.Width.Is10;
    private static readonly CssValue<TextAlignBuilder> _renderCss25 = Quark.TextAlign.Center;
    private Func<bool, Task>? _cachedHandleOpenChangedDelegate;
    private Func<ChangeEventArgs, Task>? _cachedOnHourInputDelegate;
    private Func<ChangeEventArgs, Task>? _cachedOnMinuteInputDelegate;


    private Func<Task>? _cachedDecrementHourDelegate;
    private Func<Task>? _cachedIncrementHourDelegate;
    private Func<Task>? _cachedDecrementMinuteDelegate;
    private Func<Task>? _cachedIncrementMinuteDelegate;
    private Func<Task>? _cachedToggleAmPmDelegate;

    private object? _cachedOpenPanelMouseEventArgsCallback;
    private object? _cachedOpenPanelFocusEventArgsCallback;
    private object? _cachedHandleInputChangeEventArgsCallback;
    private object? _cachedHandleChangeChangeEventArgsCallback;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "date-time-picker-input";

        Height ??= _renderCss15;
        Width ??= _defaultWidth;
        MinWidth ??= _staticCss0;
        Rounded ??= _renderCss1;
        Border ??= _renderCss2;
        BorderColor ??= _defaultBorderColor;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        TextSize ??= _renderCss11;
        Transition ??= _defaultTransition;
        OutlineStyle ??= _defaultOutlineStyle;
        TextColor ??= _defaultTextColor;
        RingColor ??= _defaultRingColor;
        PointerEvents ??= _defaultPointerEvents;
        Cursor ??= _defaultCursor;
        Opacity ??= _defaultOpacity;
    }


    [Parameter]
    public DateTime? SelectedDateTime { get; set; }

    [Parameter]
    public Expression<Func<DateTime?>>? SelectedDateTimeExpression { get; set; }

    [Parameter]
    public DateTime? Min { get; set; }

    [Parameter]
    public DateTime? Max { get; set; }

    [Parameter]
    public CssValue<InputSizeBuilder>? InputSize { get; set; } = _staticCss5;

    [Parameter]
    public EventCallback<DateTime?> SelectedDateTimeChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    [CascadingParameter(Name = nameof(ParentValidation))]
    public Validation? ParentValidation { get; set; }

    public object? ValidationValue => SelectedDateTime;

    private bool _open;
    private string _inputText = string.Empty;
    private DateTime? _lastSyncedValue;
    private ValueAtomicBool _initialized;
    private DateOnly _displayMonth = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _pendingDate;
    private int _hour; // 0-23
    private int _minute; // 0-59
    private bool _isAm;
    private const int _minuteStep = 1;
    private readonly string _panelId = BlazorIdGenerator.New("quark-datetimepicker-panel");
    private Func<DateOnly?, Task>? _calendarDateChanged;
    private Func<DateOnly?, Task>? _calendarMonthChanged;
    private Validation? _subscribedValidation;
    private LambdaExpression? _registeredExpression;

    private static readonly IReadOnlyDictionary<string, object> PanelAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "date-time-picker-panel"
    };

    private static readonly IReadOnlyDictionary<string, object> ContainerAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "date-time-picker",
        ["class"] = "q-date-time-picker relative w-full"
    };

    private static readonly string[] InputFormats =
    [
        "yyyy-MM-dd hh:mm tt", "yyyy-MM-dd h:mm tt",
        "yyyy-MM-dd HH:mm", "yyyy-MM-dd'T'HH:mm",
        "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss"
    ];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _today = DateOnly.FromDateTime(DateTime.Today);
        if (Disabled || ReadOnly) _open = false;

        if (!_initialized.Value || SelectedDateTime != _lastSyncedValue)
        {
            SyncSelection();
            _initialized.Value = true;
        }
    }

    private void SyncSelection()
    {
        _lastSyncedValue = SelectedDateTime;
        _inputText = SelectedDateTime.HasValue ? FormatDisplay(SelectedDateTime.Value) : string.Empty;
        SyncPanel();
    }

    private void SyncPanel()
    {
        var value = SelectedDateTime ?? DateTime.Now;
        _pendingDate = SelectedDateTime.HasValue ? DateOnly.FromDateTime(value) : null;
        _displayMonth = DateOnly.FromDateTime(value);
        _hour = value.Hour;
        _minute = value.Minute;
        _isAm = _hour < 12;
    }

    private async Task ApplyInput(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        _inputText = e.Value?.ToString() ?? string.Empty;
        DateTime? next = null;
        if (!string.IsNullOrWhiteSpace(_inputText))
        {
            if (!DateTime.TryParseExact(_inputText.AsSpan().Trim(), InputFormats, CultureInfo.InvariantCulture,
                    DateTimeStyles.AllowWhiteSpaces | DateTimeStyles.AssumeLocal, out var parsed))
            {
                Refresh();
                return;
            }

            if ((Min.HasValue && parsed < Min.Value) || (Max.HasValue && parsed > Max.Value))
            {
                Refresh();
                return;
            }
            next = parsed;
        }

        var valueChanged = SelectedDateTime != next;
        SelectedDateTime = next;
        _lastSyncedValue = next;
        SyncPanel();
        if (valueChanged)
        {
            await SelectedDateTimeChanged.InvokeIfHasDelegate(SelectedDateTime);
            await NotifyAutoSave(SelectedDateTime);
        }

        if (ParentValidation is not null)
            await ParentValidation.NotifyInputChanged(SelectedDateTime);

        Refresh();
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        await ApplyInput(e);
        await OnInput.InvokeIfHasDelegate(e);
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        await ApplyInput(e);
        await OnChange.InvokeIfHasDelegate(e);
    }

    private static void PreventPanelAutoFocus(BradixAutoFocusEventArgs args) => args.PreventDefault();

    private string? GetSizeClass()
    {
        var sizeClass = InputSize?.ToString();
        return string.IsNullOrWhiteSpace(sizeClass) ? null : sizeClass;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var validation = ParentValidation;
        var ownerChanged = !ReferenceEquals(_subscribedValidation, validation);
        if (ownerChanged)
        {
            if (_subscribedValidation is not null)
            {
                _subscribedValidation.ValidationStatusChanged -= OnValidationStatusChanged;
                _subscribedValidation.UnregisterInput(this);
            }
            _subscribedValidation = validation;
            _registeredExpression = null;
            if (validation is not null)
                validation.ValidationStatusChanged += OnValidationStatusChanged;
        }
        if (validation is null) return;
        if (!ReferenceEquals(_registeredExpression, SelectedDateTimeExpression))
        {
            _registeredExpression = SelectedDateTimeExpression;
            await validation.InitializeInputExpression(SelectedDateTimeExpression!);
        }
        if (ownerChanged && ReferenceEquals(_subscribedValidation, validation))
            await validation.InitializeInput(this);
    }

    private void OnValidationStatusChanged(object? sender, ValidationStatusChangedEventArgs args) => _ = RefreshOffThread();

    public override async ValueTask DisposeAsync()
    {
        await _autoSave.DisposeAsync();

        if (_subscribedValidation is not null)
        {
            _subscribedValidation.ValidationStatusChanged -= OnValidationStatusChanged;
            _subscribedValidation.UnregisterInput(this);
            _subscribedValidation = null;
        }
        await base.DisposeAsync();
    }

    private static string FormatDisplay(DateTime dt) => dt.ToString("yyyy-MM-dd hh:mm tt", CultureInfo.InvariantCulture);
    private int DisplayHour => _hour % 12 == 0 ? 12 : _hour % 12;

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        if (Placeholder.HasContent())
            attributes["placeholder"] = Placeholder!;

        if (Disabled)
            attributes["disabled"] = QuarkAttributeValues.True;

        if (ReadOnly)
            attributes["readonly"] = QuarkAttributeValues.True;

        if (Required)
            attributes["required"] = QuarkAttributeValues.True;

        if (ParentValidation?.Status == ValidationStatus.Error)
            attributes["aria-invalid"] = "true";

        attributes["aria-expanded"] = _open ? "true" : "false";
        attributes["aria-controls"] = _panelId;

        // min/max intentionally omitted for text input (handled in panel)

        attributes["onclick"] = (_cachedOpenPanelMouseEventArgsCallback ??= EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick));
        attributes["onfocus"] = (_cachedOpenPanelFocusEventArgsCallback ??= EventCallback.Factory.Create<FocusEventArgs>(this, HandleFocus));

        attributes["autocomplete"] = "off";
        attributes["oninput"] = (_cachedHandleInputChangeEventArgsCallback ??= EventCallback.Factory.Create<ChangeEventArgs>(this, HandleInput));
        attributes["onchange"] = (_cachedHandleChangeChangeEventArgsCallback ??= EventCallback.Factory.Create<ChangeEventArgs>(this, HandleChange));
    }

    private static IReadOnlyDictionary<string, object> GetContainerAttributes() => ContainerAttributes;

    private Task OpenPanel()
    {
        if (Disabled || ReadOnly)
            return Task.CompletedTask;

        if (!_open)
            _open = true;
        Refresh();
        return Task.CompletedTask;
    }

    protected override async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled) return;
        await OpenPanel();
        await OnClick.InvokeIfHasDelegate(args);
    }

    protected override async Task HandleFocus(FocusEventArgs args)
    {
        await OpenPanel();
        await OnFocus.InvokeIfHasDelegate(args);
    }

    private Task HandleOpenChanged(bool open)
    {
        _open = open && !Disabled && !ReadOnly;
        Refresh();
        return Task.CompletedTask;
    }

    internal async Task ClosePanel()
    {
        if (_open)
            _open = false;
        await RefreshOffThread();
    }


    private async Task Commit()
    {
        if (Disabled || ReadOnly) return;
        var date = _pendingDate ?? (SelectedDateTime.HasValue ? DateOnly.FromDateTime(SelectedDateTime.Value) : _today);
        var dt = new DateTime(date.Year, date.Month, date.Day, _hour, _minute, 0);
        if (Min.HasValue && Max.HasValue && Min.Value > Max.Value) return;
        if (Min.HasValue && dt < Min.Value) dt = Min.Value;
        if (Max.HasValue && dt > Max.Value) dt = Max.Value;

        if (SelectedDateTime != dt)
        {
            SelectedDateTime = dt;
            SyncSelection();
            await SelectedDateTimeChanged.InvokeAsync(SelectedDateTime);
        await NotifyAutoSave(SelectedDateTime);
        }

        SyncSelection();

        if (ParentValidation is not null)
        {
            ParentValidation.MarkTouched();
            await ParentValidation.NotifyInputChanged(SelectedDateTime);
        }

        Refresh();
    }

    private async Task SelectDate(DateOnly date)
    {
        if ((Min.HasValue && date < DateOnly.FromDateTime(Min.Value)) || (Max.HasValue && date > DateOnly.FromDateTime(Max.Value)))
            return;

        _pendingDate = date;
        await Commit();
    }

    private Task IncrementHour()
    {
        _hour = (_hour + 1) % 24;
        _isAm = _hour < 12;
        return Commit();
    }

    private Task DecrementHour()
    {
        _hour = (_hour + 23) % 24;
        _isAm = _hour < 12;
        return Commit();
    }

    private Task IncrementMinute()
    {
        _minute = (_minute + _minuteStep) % 60;
        return Commit();
    }

    private Task DecrementMinute()
    {
        _minute = (_minute + 60 - _minuteStep) % 60;
        return Commit();
    }

    private Task SetAmPm(bool am)
    {
        _isAm = am;
        if (am && _hour >= 12)
            _hour -= 12;
        if (!am && _hour < 12)
            _hour += 12;
        return Commit();
    }

    private Task ToggleAmPm() => SetAmPm(!_isAm);
    private Task OnHourInput(ChangeEventArgs e)
    {
        if (e?.Value is null)
            return Task.CompletedTask;
        if (int.TryParse(e.Value.ToString(), out var v))
        {
            v = Math.Clamp(v, 1, 12);
            // preserve am/pm while mapping 12->0 for AM case
            var baseHour = _isAm ? 0 : 12;
            _hour = v % 12 + baseHour;
            return Commit();
        }

        return Task.CompletedTask;
    }

    private Task OnMinuteInput(ChangeEventArgs e)
    {
        if (e?.Value is null)
            return Task.CompletedTask;
        if (int.TryParse(e.Value.ToString(), out var v))
        {
            v = (v % 60 + 60) % 60;
            _minute = v;
            return Commit();
        }

        return Task.CompletedTask;
    }

    private Task HandleCalendarDateChanged(DateOnly? date) => date.HasValue ? SelectDate(date.Value) : Task.CompletedTask;

    private Task HandleCalendarMonthChanged(DateOnly? month)
    {
        if (month.HasValue) _displayMonth = month.Value;
        Refresh();
        return Task.CompletedTask;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AutoSave);
        hc.Add(AutoSaveDelay);
        hc.Add(ShowAutoSaveStatus);
        hc.Add(OnAutoSave);
        hc.Add(AutoSaveStateChanged);
        hc.Add(AutoSaveStatusClass);
        hc.Add(AutoSaveSavingClass);
        hc.Add(AutoSaveSavedClass);
        hc.Add(AutoSaveFailedClass);
        hc.Add(_autoSave.State);
        hc.Add(_autoSave.HasSaved);

        hc.Add(SelectedDateTime);
        hc.Add(_inputText);
        hc.Add(Placeholder);
        hc.Add(Disabled);
        hc.Add(ReadOnly);
        hc.Add(Required);
        hc.Add(Min);
        hc.Add(Max);
        hc.Add(_open);
        hc.Add(_panelId);
        hc.Add(_displayMonth);
        hc.Add(_pendingDate);
        hc.Add(_hour);
        hc.Add(_minute);
        hc.Add(_isAm);
        AddIf(ref hc, InputSize);
    }

}
