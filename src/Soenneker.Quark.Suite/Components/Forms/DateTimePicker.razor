                    <Input Type="number" Value="@DisplayHour.ToString(CultureInfo.InvariantCulture)" Width="_renderCss24" TextAlign="_renderCss25" Class="[appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" aria-label="Hour" step="1" min="1" max="12" OnInput="(_cachedOnHourInputDelegate ??= OnHourInput)" @onwheel="(_cachedOnHourWheelDelegate ??= OnHourWheel)" @onkeydown="(_cachedOnHourKeyDownDelegate ??= OnHourKeyDown)"/>
                    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss2" @onclick="(_cachedIncrementHourDelegate ??= IncrementHour)">+</Button>
                </Div>
                <Span TextSize="_renderCss11" TextColor="_renderCss19">:</Span>
                <Div Display="_renderCss8" ItemsAlign="_renderCss9" Gap="_renderCss14">
                    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss2" @onclick="(_cachedDecrementMinuteDelegate ??= DecrementMinute)">-</Button>
                    <Input Type="number" Value="@_minute.ToString(CultureInfo.InvariantCulture)" Width="_renderCss24" TextAlign="_renderCss25" Class="[appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" aria-label="Minute" step="@_minuteStep" min="0" max="59" OnInput="(_cachedOnMinuteInputDelegate ??= OnMinuteInput)" @onwheel="(_cachedOnMinuteWheelDelegate ??= OnMinuteWheel)" @onkeydown="(_cachedOnMinuteKeyDownDelegate ??= OnMinuteKeyDown)"/>
                    <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss2" @onclick="(_cachedIncrementMinuteDelegate ??= IncrementMinute)">+</Button>
                </Div>
                <Button Type="@ButtonType.Button" Variant="ButtonVariant.Outline" ButtonSize="_staticCss1" Title="Click to toggle" @onclick="(_cachedToggleAmPmDelegate ??= ToggleAmPm)">@(_isAm ? "AM" : "PM")</Button>
            </Div>
        </PopoverContent>
    </Div>
</Popover>

