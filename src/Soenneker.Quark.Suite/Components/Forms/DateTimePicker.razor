    {
        base.ApplyDefaultParameters();
        DataSlot ??= "date-time-picker-input";

        Height ??= _renderCss15;
        Width ??= _defaultWidth;
        MinWidth ??= _staticCss0;
        Rounded ??= _renderCss1;
