@using System.Threading
@using Soenneker.Blazor.SignaturePads.Configuration
@using Soenneker.Blazor.SignaturePads.Dtos

@namespace Soenneker.Quark
@inherits FormControlElementBase
@implements ISignaturePad

<Soenneker.Blazor.SignaturePads.SignaturePadCanvas @ref="_canvas"
                                                       @attributes="BuildAttributes()"
                                                       Options="BuildOptions()"
                                                       ObserveResize="@ObserveResize"
                                                       PreserveDrawingOnResize="@PreserveDrawingOnResize"
                                                       OnReady="(_cachedHandleReadyDelegate ??= HandleReady)" />

@code {
    private SignaturePadOptions? _options;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Token("64");
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Input.OnFocusVisible.Ring;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.White;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.OnFocusVisible.Ring50;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.NotAllowed.OnDisabled;
    private static readonly CssValue<OpacityBuilder> _defaultOpacity = Quark.Opacity.Is50.OnDisabled;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.None;
    private Func<Task>? _cachedHandleReadyDelegate;

    private string? _lastPrependedClass;

    private Blazor.SignaturePads.SignaturePadCanvas? _canvas;
    private bool? _lastInteractionDisabled;
    private bool _ready;

    [Parameter]
    public double? DotSize { get; set; }

    [Parameter]
    public double? MinStrokeWidth { get; set; }

    [Parameter]
    public double? MaxStrokeWidth { get; set; }

    [Parameter]
    public int? Throttle { get; set; }

    [Parameter]
    public int? MinDistance { get; set; }

    [Parameter]
    public string? CanvasBackgroundColor { get; set; } = "#ffffff";

    [Parameter]
    public string? PenColor { get; set; } = "#0f172a";

    [Parameter]
    public double? VelocityFilterWeight { get; set; }

    [Parameter]
    public string? CompositeOperation { get; set; }

    [Parameter]
    public bool ObserveResize { get; set; } = true;

    [Parameter]
    public bool PreserveDrawingOnResize { get; set; } = true;

    [Parameter]
    public EventCallback OnReady { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "signature-pad";
        Width ??= _defaultWidth;
        Height ??= _defaultHeight;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BorderColor ??= _defaultBorderColor;
        BackgroundColor ??= _defaultBackgroundColor;
        RingColor ??= _defaultRingColor;
        Cursor ??= _defaultCursor;
        Opacity ??= _defaultOpacity;
        OutlineStyle ??= _defaultOutlineStyle;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        ApplyFieldControlAttributes(attributes);
        attributes["aria-disabled"] = Disabled ? "true" : "false";
        attributes["aria-readonly"] = ReadOnly ? "true" : "false";

        PrependClassAttribute(attributes, "touch-none focus-visible:ring-3 aria-readonly:cursor-not-allowed aria-readonly:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40", ref _lastPrependedClass);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await ApplyInteractionState();
    }

    private async Task ApplyInteractionState()
    {
        var interactionDisabled = Disabled || ReadOnly;
        if (!_ready || _canvas is null || _lastInteractionDisabled == interactionDisabled)
            return;

        _lastInteractionDisabled = interactionDisabled;

        if (interactionDisabled)
            await _canvas.Disable();
        else
            await _canvas.Enable();
    }

    private async Task HandleReady()
    {
        _ready = true;
        _lastInteractionDisabled = null;
        await ApplyInteractionState();
        if (OnReady.HasDelegate)
            await OnReady.InvokeAsync();
    }

    private static bool SameNumber(double? left, double? right) =>
        left.HasValue == right.HasValue && BitConverter.DoubleToInt64Bits(left.GetValueOrDefault()) == BitConverter.DoubleToInt64Bits(right.GetValueOrDefault());

    private SignaturePadOptions BuildOptions()
    {
        if (_options is { } options && SameNumber(options.DotSize, DotSize) && SameNumber(options.MinWidth, MinStrokeWidth) &&
            SameNumber(options.MaxWidth, MaxStrokeWidth) && SameNumber(options.VelocityFilterWeight, VelocityFilterWeight) &&
            options.Throttle == Throttle && options.MinDistance == MinDistance && options.BackgroundColor == CanvasBackgroundColor &&
            options.PenColor == PenColor && options.CompositeOperation == CompositeOperation)
            return options;

        return _options = new SignaturePadOptions()
        {
            DotSize = DotSize,
            MinWidth = MinStrokeWidth,
            MaxWidth = MaxStrokeWidth,
            Throttle = Throttle,
            MinDistance = MinDistance,
            BackgroundColor = CanvasBackgroundColor,
            PenColor = PenColor,
            VelocityFilterWeight = VelocityFilterWeight,
            CompositeOperation = CompositeOperation
        };
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(DotSize);
        hc.Add(MinStrokeWidth);
        hc.Add(MaxStrokeWidth);
        hc.Add(Throttle);
        hc.Add(MinDistance);
        hc.Add(CanvasBackgroundColor);
        hc.Add(PenColor);
        hc.Add(VelocityFilterWeight);
        hc.Add(CompositeOperation);
        hc.Add(ObserveResize);
        hc.Add(PreserveDrawingOnResize);
        hc.Add(OnReady);
    }

    private Blazor.SignaturePads.SignaturePadCanvas EnsureReady() =>
        _canvas ?? throw new InvalidOperationException("The signature pad is not ready yet. Wait until the component has rendered.");

    public ValueTask Clear(CancellationToken cancellationToken = default) => EnsureReady().Clear(cancellationToken);

    public ValueTask<bool> IsEmpty(CancellationToken cancellationToken = default) => EnsureReady().IsEmpty(cancellationToken);

    public ValueTask<string> ToDataUrl(string type = "image/png", double? encoderOptions = null, CancellationToken cancellationToken = default) =>
        EnsureReady().ToDataUrl(type, encoderOptions, cancellationToken);

    public ValueTask<string> ToSvg(SignaturePadSvgOptions? options = null, CancellationToken cancellationToken = default) =>
        EnsureReady().ToSvg(options, cancellationToken);

    public ValueTask<IReadOnlyList<SignaturePadPointGroup>> ToData(CancellationToken cancellationToken = default) =>
        EnsureReady().ToData(cancellationToken);

    public ValueTask FromData(IReadOnlyList<SignaturePadPointGroup> data, bool clear = true, CancellationToken cancellationToken = default) =>
        EnsureReady().FromData(data, clear, cancellationToken);

    public ValueTask FromDataUrl(string dataUrl, SignaturePadDataUrlOptions? options = null, CancellationToken cancellationToken = default) =>
        EnsureReady().FromDataUrl(dataUrl, options, cancellationToken);

    public ValueTask Redraw(CancellationToken cancellationToken = default) => EnsureReady().Redraw(cancellationToken);

    public ValueTask Enable(CancellationToken cancellationToken = default) => EnsureReady().Enable(cancellationToken);

    public ValueTask Disable(CancellationToken cancellationToken = default) => EnsureReady().Disable(cancellationToken);
}
