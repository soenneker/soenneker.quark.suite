@inject Soenneker.Blazor.Utils.ResourceLoader.Abstract.IResourceLoader ResourceLoader
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element



<div @attributes="BuildAttributes()">
    <div data-slot="marquee-track"
         class="@GetTrackClass()"
         style="@GetTrackStyle()">
        @ChildContent
    </div>
    <div data-slot="marquee-track"
         aria-hidden="true"
         inert
         class="@GetTrackClass()"
         style="@GetTrackStyle()">
        @ChildContent
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
            await ResourceLoader.LoadStyle(QuarkAssetPath.Css("_content/Soenneker.Quark.Suite/css/marquee.css", QuarkOptions));
    }

    private (double Duration, string Gap, bool Fade, string Width, string? BaseStyle) _marqueeStyleKey;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;

    private const string _baseClass = "group/marquee relative flex w-full overflow-hidden";
    private const string _trackClass = "flex w-max min-w-full shrink-0 items-center justify-around";

    /// <summary>
    /// Gets or sets the animation duration in seconds.
    /// </summary>
    [Parameter]
    public double ScrollDuration { get; set; } = 40;

    /// <summary>
    /// Gets or sets the gap between repeated content groups.
    /// </summary>
    [Parameter]
    public string ItemGap { get; set; } = "1rem";

    /// <summary>
    /// Gets or sets whether scrolling runs in reverse.
    /// </summary>
    [Parameter]
    public bool Reverse { get; set; }

    /// <summary>
    /// Gets or sets whether the marquee pauses when hovered.
    /// </summary>
    [Parameter]
    public bool PauseOnHover { get; set; } = true;

    /// <summary>
    /// Gets or sets whether edge gradient fades are rendered.
    /// </summary>
    [Parameter]
    public bool ShowFade { get; set; } = true;

    /// <summary>
    /// Gets or sets the fade width at each edge.
    /// </summary>
    [Parameter]
    public string FadeWidth { get; set; } = "10%";

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "marquee";
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-reverse"] = Reverse ? "true" : "false";
        attributes["data-pause-on-hover"] = PauseOnHover ? "true" : "false";
        attributes["data-fade"] = ShowFade ? "true" : "false";

        PrependClassAttribute(attributes, _baseClass, ref _lastBuiltClass);

        attributes.TryGetValue("style", out var existingStyle);
        var baseStyle = existingStyle as string ?? existingStyle?.ToString();
        if (existingStyle is not null) attributes["style"] = baseStyle!;
        var styleKey = (ScrollDuration, ItemGap, ShowFade, FadeWidth, baseStyle);
        if (_lastBuiltStyle is null || !_marqueeStyleKey.Equals(styleKey))
        {
            _marqueeStyleKey = styleKey;
            var sty = new PooledStringBuilder(stackalloc char[64]);
            try
            {
                AppendStyleDecl(ref sty, string.Create(System.Globalization.CultureInfo.InvariantCulture, $"--marquee-duration:{Math.Max(ScrollDuration, 0.001):0.###}s"));
                AppendStyleDecl(ref sty, $"--marquee-gap:{ItemGap}");
                if (ShowFade)
                    AppendStyleDecl(ref sty, $"mask-image:linear-gradient(to right, transparent, black {FadeWidth}, black calc(100% - {FadeWidth}), transparent)");
                BuildStyleAttribute(attributes, ref sty, ref _lastBuiltStyle);
            }
            finally
            {
                sty.Dispose();
            }
        }
        else
            attributes["style"] = _lastBuiltStyle;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ScrollDuration);
        hc.Add(ItemGap);
        hc.Add(Reverse);
        hc.Add(PauseOnHover);
        hc.Add(ShowFade);
        hc.Add(FadeWidth);
    }

    private static string GetTrackClass() => _trackClass + " [&>*]:mx-[calc(var(--marquee-gap)/2)]";

    private string GetTrackStyle()
    {
        return Reverse
            ? "gap:var(--marquee-gap);animation:quark-marquee var(--marquee-duration) linear infinite;animation-direction:reverse;"
            : "gap:var(--marquee-gap);animation:quark-marquee var(--marquee-duration) linear infinite;animation-direction:normal;";
    }


}
