@using Soenneker.Blazor.Utils.Ids
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<CascadingValue Name="ParentMenubar" Value="@this" IsFixed="true">
    <BradixMenubar Value="@_openMenuValue"
                   ValueChanged="(_cachedHandleValueChangedDelegate ??= HandleValueChanged)"
                   AdditionalAttributes="@MenubarAttributes">
        @ChildContent
    </BradixMenubar>
</CascadingValue>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<MaxWidthBuilder> _staticCss1 = Quark.MaxWidth.IsFull;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is8;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is0_5;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Default;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Token("[3px]");
    private Func<string?, Task>? _cachedHandleValueChangedDelegate;

    private readonly string _menubarId = BlazorIdGenerator.New("quark-menubar");
    private string? _openMenuValue;
    private IReadOnlyDictionary<string, object> MenubarAttributes => BuildMenubarAttributes();


    [CascadingParameter(Name = "DirectionProviderDir")]
    private string? DirectionProviderDir { get; set; }

    private string GetResolvedDirection()
    {
        if (string.Equals(DirectionProviderDir, "rtl", StringComparison.OrdinalIgnoreCase))
            return "rtl";

        if (string.Equals(DirectionProviderDir, "ltr", StringComparison.OrdinalIgnoreCase))
            return "ltr";

        if (Attributes is not null &&
            Attributes.TryGetValue("dir", out var dirValue) &&
            string.Equals(dirValue?.ToString(), "rtl", StringComparison.OrdinalIgnoreCase))
        {
            return "rtl";
        }

        return "ltr";
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "menubar";

        Display ??= _defaultDisplay;
        Height ??= _defaultHeight;
        MaxWidth ??= _staticCss1;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        Padding ??= _defaultPadding;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["id"] = _menubarId;
        attributes["data-orientation"] = "horizontal";
        attributes["data-modal"] = "false";
        attributes["role"] = "menubar";
        attributes["aria-orientation"] = "horizontal";
        attributes["dir"] = GetResolvedDirection();
    }

    private IReadOnlyDictionary<string, object> BuildMenubarAttributes()
    {
        return BuildAttributes();
    }

    private Task HandleValueChanged(string? value)
    {
        _openMenuValue = value;
        return Task.CompletedTask;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(DirectionProviderDir);
        hc.Add(_openMenuValue);
    }
}