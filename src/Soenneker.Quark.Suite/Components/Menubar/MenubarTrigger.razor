@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.FormControlElement

<BradixMenubarTrigger Disabled="@Disabled"
                      OnElementReferenceCaptured="(_cachedHandleElementCapturedDelegate ??= HandleElementCaptured)"
                      AdditionalAttributes="@TriggerAttributes">
    @ChildContent
</BradixMenubarTrigger>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Sm;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is1_5.OnY.Token("[2px]");
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<FontWeightBuilder> _defaultFontWeight = Quark.FontWeight.Medium;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private Func<ElementReference, Task>? _cachedHandleElementCapturedDelegate;

    private string? _lastPrependedClass;

    private ElementReference _elementRef;

    [Parameter]
    public bool Open { get; set; }

    [CascadingParameter(Name = "ParentMenubarMenu")]
    private MenubarMenu? ParentMenubarMenu { get; set; }

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildTriggerAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "menubar-trigger";
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        FontWeight ??= _defaultFontWeight;
        OutlineStyle ??= _defaultOutlineStyle;
        UserSelect ??= _defaultUserSelect;

    }

    private Task HandleElementCaptured(ElementReference elementReference)
    {
        _elementRef = elementReference;

        ParentMenubarMenu?.RegisterTrigger(this);

        return Task.CompletedTask;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "hover:bg-muted aria-expanded:bg-muted", ref _lastPrependedClass);
    }

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        return BuildAttributes();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Open);
        hc.Add(Disabled);
    }

    internal Task Focus() => _elementRef.FocusAsync().AsTask();

    public override ValueTask DisposeAsync() => base.DisposeAsync();
}
