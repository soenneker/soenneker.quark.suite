        var start = SchedulerDates.ResolveEdit(_start, TimeZone, _originalEvent?.Start); var end = _end is { } localEnd ? SchedulerDates.ResolveEdit(localEnd, TimeZone, _originalEvent?.End) : null;
        if (string.IsNullOrWhiteSpace(_title)) { _error = "Required"; return; }
        if (start is null || (_end.HasValue && end is null) || end <= start) { _error = "InvalidDate"; return; }
        if (await Persist(new(_editId ?? Guid.NewGuid().ToString("N"), _title.Trim(), start.Value, end, string.IsNullOrEmpty(_resource) ? null : _resource))) _editing = false;
    }
    private async Task<bool> Persist(SchedulerEvent value)
    {
