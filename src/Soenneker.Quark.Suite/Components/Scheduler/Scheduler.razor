        var localStart = day.ToDateTime(TimeOnly.MinValue).AddMinutes(minute);
        if (SlotSelected.HasDelegate)
        {
            if (SchedulerDates.ToInstant(localStart, TimeZone) is not { } instant) { _error = "InvalidDate"; return; }
            _error = null;
            await SlotSelected.InvokeAsync(new SchedulerSlot(instant, string.IsNullOrEmpty(resource) ? null : resource));
            return;
        }
        if (ReadOnly) return;
        _originalEvent = null;
        _editId = null;
        _title = "";
        _resource = resource;
        _start = localStart;
        _end = _start.AddHours(1);
        _editing = true;
        _error = null;
    }

    private async Task Edit(SchedulerEvent e)
