@namespace Soenneker.Quark
@inherits LocalizedComponentBase
@using Microsoft.JSInterop
@inject IWorkflowInteractionInterop InteractionInterop
@implements IScheduler
@using System.Linq
@using System.Globalization
@using System.Threading
<div @ref="_interactionRoot" @attributes="@(WorkflowAttributes("scheduler", "@container min-w-0 overflow-hidden rounded-xl border bg-background text-foreground shadow-sm"))" aria-busy="@(_busy ? "true" : "false")">
    <div data-booking="@(BookingMode ? "true" : "false")" class="grid min-w-0 grid-cols-1 sm:data-[booking=true]:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,.85fr)] lg:data-[booking=false]:grid-cols-[280px_minmax(0,1fr)]">
        @if (BookingMode)
        {
            <section class="min-w-0 border-b p-4 sm:border-b-0 sm:border-e lg:p-5" aria-label="Meeting details">
                @if (CanEditTitle && !ReadOnly)
                {
                    @if (_editingTitle)
                    {
                        <input class="@ControlClass w-full min-w-0 max-w-full box-border" aria-label="@Text["Title"]" data-booking-title-editor
                               @bind="_titleDraft" @bind:event="oninput" @onkeydown="TitleKeyDown" @onblur="CommitTitle" />
                    }
                    else
                    {
                        <h2 class="text-xl font-semibold leading-tight tracking-tight">
                            <button type="button" @ref="_titleButton" class="inline-flex items-center gap-2 text-start"
                                    aria-label="@($"{Text["Edit"]} {DisplayBookingTitle}")" @onclick="BeginTitleEdit">
                                @DisplayBookingTitle <span class="text-sm text-muted-foreground" aria-hidden="true">&#9998;</span>
                            </button>
                        </h2>
                    }
                }
                else if (BookingTitle is not null || MeetingDetails is null)
                {
                    <h2 class="text-xl font-semibold leading-tight tracking-tight">@DisplayBookingTitle</h2>
                }
                @if (MeetingDetails is not null)
                {
                    <div class="mt-2 text-sm leading-relaxed text-muted-foreground">@MeetingDetails</div>
                }
                <div class="mt-4 flex items-center gap-2">
                    <svg aria-hidden="true" class="size-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9" /><path d="M12 6v6l4 2" /></svg>
                    <div class="inline-flex min-w-0 flex-wrap items-center rounded-lg bg-muted p-1" role="group" aria-label="Meeting duration">
                    @foreach (var duration in BookingDurations.Append(BookingDuration).Distinct().OrderBy(value => value))
                    {
                        <button type="button" class="shrink-0 rounded-md px-1.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm"
                                aria-pressed="@(duration == BookingDuration ? "true" : "false")" @onclick="() => SelectDuration(duration)">
                            @(duration == TimeSpan.FromHours(1) ? "1h" : $"{duration.TotalMinutes.ToString("0.##", Text.Culture)}m")
                        </button>
                    }
                </div>
                </div>
                <div class="mt-3 flex items-center gap-2 text-xs font-medium text-muted-foreground">
                    <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></svg>
                    <span>Time zone: @TimeZone.Id</span>
                </div>
                @if (BookingFields is not null)
                {
                    <div class="mt-4 grid min-w-0 gap-3">@BookingFields</div>
                }
            </section>
        }
        <aside class="min-w-0 space-y-3 border-b p-4 sm:border-b-0 sm:border-e lg:p-5">
            <div class="flex items-center justify-between gap-2">
                <span class="text-base font-semibold">@CalendarMonth.ToString("Y", Text.Culture)</span>
                <div class="flex items-center gap-1">
                    <button type="button" class="@IconButtonClass" aria-label="@Text["Previous"]" @onclick="() => BrowseMonth(-1)">‹</button>
                    <button type="button" class="@IconButtonClass" aria-label="@Text["Next"]" @onclick="() => BrowseMonth(1)">›</button>
                </div>
            </div>
            <div class="grid grid-cols-7 gap-1">
                @{ var today = LocalToday; }
                @foreach (var day in CalendarDays().Take(7))
                {
                    <span class="py-2 text-center text-[10px] font-medium uppercase tracking-wide text-muted-foreground">@day.ToString("ddd", Text.Culture)</span>
                }
                @foreach (var day in CalendarDays())
                {
                    @if (BookingMode && day.Month != CalendarMonth.Month) { <span></span> continue; }
                    <button type="button" disabled="@(BookingMode && (day < today || !AvailableStarts(day).Any()))" class="@CalendarDayClass(day, today) disabled:bg-transparent disabled:text-muted-foreground" aria-label="@day.ToString("D", Text.Culture)" aria-pressed="@(day == Date ? "true" : "false")" aria-current="@(day == today ? "date" : null)" @onclick="() => SelectDate(day)">
                        @day.Day
                        @if (!BookingMode && DayEvents(day).Any()) { <span class="absolute bottom-1 size-1 rounded-full bg-current" aria-hidden="true"></span> }
                    </button>
                }
            </div>
            @if (!BookingMode)
            {
            <button type="button" class="@($"{ControlClass} w-full justify-center")" @onclick="Today">@Text["Today"]</button>
            <div class="border-t pt-4 text-xs leading-relaxed text-muted-foreground">@TimeZone.DisplayName</div>
            }
        </aside>
        @if (BookingMode)
        {
            <section class="flex min-w-0 flex-col items-stretch gap-3 p-4 lg:p-5" aria-label="Available times">
                <strong class="flex min-h-9 items-center text-base font-semibold" aria-live="polite">@Date.ToString("ddd, MMM d", Text.Culture)</strong>
                @{
                    var available = AvailableStarts(Date).ToList();
                }
                <div @key="(Date, BookingDuration)" class="grid gap-2 overflow-y-auto" style="max-height:14.5rem;scrollbar-width:none" tabindex="0" role="group" aria-label="Available start times">
                    @foreach (var instant in available)
                    {
                        <button type="button" class="flex h-10 items-center justify-center gap-2 rounded-lg border text-sm font-semibold transition-colors hover:bg-muted aria-pressed:bg-primary aria-pressed:text-primary-foreground" aria-pressed="@(instant == SelectedStart ? "true" : "false")" disabled="@_busy" @onclick="() => SelectBookingSlot(instant)"><span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>@TimeZoneInfo.ConvertTime(instant, TimeZone).ToString("t", Text.Culture)</button>
                    }
                    @if (_error is not null) { <span role="alert" class="text-destructive">@Text[_error]</span> }
                    @if (available.Count == 0) { <span class="text-sm text-muted-foreground">No available times.</span> }
                </div>
            </section>
        }
        else
        {
        <div class="min-w-0 p-4 sm:p-5">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="flex items-center rounded-md border">
                        <button type="button" class="@IconButtonClass" aria-label="@Text["Previous"]" @onclick="() => Navigate(-1)">‹</button>
                        <button type="button" class="@IconButtonClass" aria-label="@Text["Next"]" @onclick="() => Navigate(1)">›</button>
                    </div>
                    <strong class="text-sm font-semibold" aria-live="polite">@PeriodLabel</strong>
                </div>
                <div class="flex items-center gap-2">
                    <select class="@ControlClass" aria-label="@Text["Select"]" value="@View" @onchange="ChangeView">
                        @foreach (var view in Views) { <option value="@view">@Text[view.ToString()]</option> }
                    </select>
                    @if (!ReadOnly || SlotSelected.HasDelegate) { <button type="button" class="inline-flex h-9 items-center gap-2 rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50" disabled="@_busy" @onclick="() => New(Date, 9 * 60, null)"><span aria-hidden="true">+</span>@Text["NewEvent"]</button> }
                </div>
            </div>
            @if (_error is not null) { <div role="alert" class="text-destructive">@Text[_error]</div> }
            @if (_editing)
            {
                <fieldset disabled="@_busy" class="mb-5 grid gap-4 rounded-lg border bg-muted/20 p-4 sm:grid-cols-2">
                    <legend class="px-1 text-sm font-semibold">@Text[_editId is null ? "NewEvent" : "Edit"]</legend>
                    <label class="grid gap-1.5 text-sm font-medium">@Text["Title"] <input class="h-10 w-full min-w-0 rounded-md border bg-background px-3 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" @bind="_title" /></label>
                    <label class="grid gap-1.5 text-sm font-medium">@Text["Start"] <input type="datetime-local" class="h-10 w-full min-w-0 rounded-md border bg-background px-3 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" @bind="_start" @bind:format="yyyy-MM-ddTHH:mm" /></label>
                    <label class="grid gap-1.5 text-sm font-medium">@Text["End"] <input type="datetime-local" class="h-10 w-full min-w-0 rounded-md border bg-background px-3 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" @bind="_end" @bind:format="yyyy-MM-ddTHH:mm" /></label>
                    @if (Resources.Count > 0) { <label class="grid gap-1.5 text-sm font-medium">@Text["Resource"] <select class="@ControlClass" @bind="_resource"><option value="">@Text["NoResource"]</option>@foreach (var resource in Resources) { <option value="@resource.Id">@resource.Label</option> }</select></label> }
                    <div class="flex flex-wrap gap-2 sm:col-span-2"><button type="button" class="@ControlClass" @onclick="SaveDraft">@Text["Save"]</button><button type="button" class="@ControlClass" @onclick="() => _editing = false">@Text["Cancel"]</button>
                        @if (_editId is not null) { <button type="button" class="@ControlClass" @onclick="DeleteDraft">@Text["Delete"]</button> }
                    </div>
                </fieldset>
            }
            @if (View == SchedulerView.Month)
            {
                <div class="grid grid-cols-7 overflow-auto rounded-lg border">
                    @foreach (var day in MonthDays())
                    {
                        <div class="min-h-28 min-w-24 border-b border-e p-2" @ondragover:preventDefault @ondrop="() => Drop(day, null, null)">
                            <button type="button" class="font-medium" disabled="@(ReadOnly && !SlotSelected.HasDelegate)" aria-label="@(Text["NewEvent"] + " " + day.ToString("D", Text.Culture))" @onclick="() => New(day, 9 * 60, null)">@day.ToString("ddd d", Text.Culture)</button>
                            @foreach (var appointment in DayEvents(day))
                            { <button @key="appointment.Id" type="button" class="mt-1 block w-full truncate rounded border-s-2 border-primary bg-primary/10 px-2 py-1.5 text-start text-xs font-medium hover:bg-primary/20" draggable="@(!ReadOnly)" @ondragstart="() => Drag(appointment, false)" @ondragend="ClearDrag" @onclick="() => Edit(appointment)">@TimeLabel(appointment) @appointment.Title</button> }
                        </div>
                    }
                </div>
            }
            else if (View == SchedulerView.Agenda)
            {
                <div class="max-h-[36rem] space-y-5 overflow-auto">
                    @{ var agendaStart = StartInstant(Date); var agendaEnd = StartInstant(Date.AddDays(31));
                       var agenda = Events.Where(e => e.Intersects(agendaStart, agendaEnd)).OrderBy(e => e.Start).ToArray(); }
                    @if (agenda.Length == 0)
                    {
                        <div class="rounded-lg border border-dashed px-6 py-16 text-center text-sm text-muted-foreground">@Text["NoResults"]</div>
                    }
                    @foreach (var group in agenda.GroupBy(e => SchedulerDates.LocalDate(e.Start, TimeZone)))
                    {
                        <section class="space-y-2">
                            <h3 class="text-xs font-medium text-muted-foreground">@group.Key.ToString("D", Text.Culture)</h3>
                            @foreach (var appointment in group)
                            {
                                <button @key="appointment.Id" type="button" class="group flex w-full items-center gap-4 rounded-lg border bg-background p-4 text-start shadow-sm transition-colors hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" @onclick="() => Edit(appointment)">
                                    <span class="h-10 w-1 shrink-0 rounded-full bg-primary/60" aria-hidden="true"></span>
                                    <span class="min-w-0 flex-1 space-y-1.5">
                                        <strong class="block truncate text-sm font-semibold">@appointment.Title</strong>
                                        <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                            <span>@TimeLabel(appointment)@if (appointment.End is { } end) {<text> � @TimeZoneInfo.ConvertTime(end, TimeZone).ToString("t", Text.Culture)</text>}</span>
                                            @if (Resources.Count > 0) { <span class="rounded-md bg-muted px-2 py-0.5">@ResourceLabel(appointment.ResourceId)</span> }
                                        </span>
                                    </span>
                                    <span class="text-muted-foreground" aria-hidden="true">›</span>
                                </button>
                            }
                        </section>
                    }
                </div>
            }

            else
            {
                var slotTimes = new string[48];
                for (int index = 0; index < slotTimes.Length; index++)
                    slotTimes[index] = TimeOnly.MinValue.AddMinutes(index * 30).ToString("t", Text.Culture);
                @if (Resources.Count + 1 > ResourcePageSize)
                {
                    <nav aria-label="Scheduler resources">
                        <button type="button" disabled="@(_resourcePage == 0)" @onclick="() => _resourcePage--">Previous resources</button>
                        <span>Resources @(_resourcePage * ResourcePageSize + 1)–@Math.Min(Resources.Count + 1, (_resourcePage + 1) * ResourcePageSize) of @(Resources.Count + 1)</span>
                        <button type="button" disabled="@((_resourcePage + 1) * ResourcePageSize >= Resources.Count + 1)" @onclick="() => _resourcePage++">Next resources</button>
                    </nav>
                }
                <div class="max-h-[36rem] overflow-auto rounded-lg border">
                    <div class="flex" style="min-width:max-content">
                        @foreach (var day in VisibleDays())
                        {
                            var newEventLabel = Text["NewEvent"] + " " + day.ToString("d", Text.Culture) + " ";
                            @foreach (var resource in Lanes())
                            {
                                var appointments = LaneEvents(day, resource);
                                <div class="relative border-e" style="width:180px;flex:1 0 180px">
                                    <div class="sticky top-0 z-10 border-b bg-background px-3 py-3 text-xs font-semibold">@day.ToString("ddd d", Text.Culture) @resource?.Label</div>
                                    <div class="relative" style="height:960px" data-scheduler-lane="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-resource="@resource?.Id">
                                        @for (var minute = 0; minute < 1440; minute += 30)
                                        {
                                            var slot = minute;
                                            <button type="button" class="absolute w-full border-b text-start text-xs text-muted-foreground" style="@SlotStyles[slot / 30]" aria-label="@(newEventLabel + slotTimes[slot / 30] + " " + resource?.Label)" @ondragover:preventDefault @ondrop="() => Drop(day, slot, resource?.Id)" @onclick="() => New(day, slot, resource?.Id)">@(slot % 60 == 0 ? slotTimes[slot / 30] : "")</button>
                                        }
                                        @for (var i = 0; i < appointments.Count; i++)
                                        {
                                            var placement = appointments[i];
                                            var appointment = placement.Event;
                                            <div @key="appointment.Id" class="absolute overflow-hidden rounded-md border border-primary/20 border-s-2 border-s-primary bg-accent p-1.5 text-xs shadow-sm" style="@EventStyle(placement)">
                                                <button type="button" data-touch-event="@(ReadOnly ? null : appointment.Id)" style="touch-action:none" class="w-full text-start" draggable="@(!ReadOnly)" @ondragstart="() => Drag(appointment, false)" @ondragend="ClearDrag" @onclick="() => Edit(appointment)">@TimeLabel(appointment) @appointment.Title</button>
                                                @if (!ReadOnly && appointment.End.HasValue) { <button type="button" data-touch-event="@appointment.Id" data-touch-resize="true" style="touch-action:none" class="absolute bottom-0 start-0 h-2 w-full cursor-ns-resize border-t" aria-label="@(Text["End"] + " " + appointment.Title)" draggable="true" @ondragstart="() => Drag(appointment, true)" @ondragend="ClearDrag" @onclick="() => Edit(appointment)"></button> }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
        }
    </div>
</div>
@code {
    private static readonly SchedulerView[] Views = Enum.GetValues<SchedulerView>();
    private const string ControlClass = "inline-flex h-9 items-center rounded-md border bg-background px-3 text-sm font-medium shadow-sm transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50";
    private const string IconButtonClass = "inline-flex size-8 items-center justify-center rounded-md text-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
    private DateOnly? _calendarMonth;
    private DateOnly CalendarMonth => _calendarMonth ?? new DateOnly(Date.Year, Date.Month, 1);
    private DateOnly LocalToday => SchedulerDates.LocalDate(DateTimeOffset.UtcNow, TimeZone);
    private string PeriodLabel => View == SchedulerView.Month ? Date.ToString("Y", Text.Culture)
        : View == SchedulerView.Week ? $"{WeekStart.ToString("m", Text.Culture)} – {WeekStart.AddDays(6).ToString("m", Text.Culture)}"
        : Date.ToString("D", Text.Culture);
    private IEnumerable<DateOnly> CalendarDays()
    {
        var first = SchedulerDates.WeekStart(CalendarMonth, Text.Culture.DateTimeFormat.FirstDayOfWeek);
        return Enumerable.Range(0, 42).Select(first.AddDays);
    }
    private string CalendarDayClass(DateOnly day, DateOnly today) => "relative flex h-9 items-center justify-center rounded-md text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring " +
        (day == Date ? "bg-primary font-semibold text-primary-foreground shadow-sm" :
            day == today ? "bg-accent font-semibold text-accent-foreground hover:bg-muted" :
            day.Month != CalendarMonth.Month ? "text-muted-foreground/50 hover:bg-muted" : "bg-muted/40 hover:bg-muted");
    private void BrowseMonth(int direction) => _calendarMonth = CalendarMonth.AddMonths(direction);
    private async Task SelectDate(DateOnly day) { Date = day; _calendarMonth = null; await DateChanged.InvokeAsync(day); }
    private ElementReference _interactionRoot;
    private DotNetObjectReference<Scheduler>? _interactionReference;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (IsDisposed) return;
        if (_focusTitleButton)
        {
            _focusTitleButton = false;
            if (BookingMode && CanEditTitle && !ReadOnly && !_editingTitle)
                await _titleButton.FocusAsync();
        }
        if (_interactionReference is null) { _interactionReference = DotNetObjectReference.Create(this); await InteractionInterop.Mount(_interactionRoot, _interactionReference); }
        if (IsDisposed) await InteractionInterop.Unmount(_interactionRoot);
        else await InteractionInterop.Update(_interactionRoot);
    }
    public override async ValueTask DisposeAsync()
    {
        Dispose();
        try { if (_interactionReference is not null) await InteractionInterop.Unmount(_interactionRoot); }
        catch (JSDisconnectedException) { }
        finally { _interactionReference?.Dispose(); await base.DisposeAsync(); }
    }

    [Parameter] public IReadOnlyList<SchedulerEvent> Events { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<SchedulerEvent>> EventsChanged { get; set; }
    [Parameter] public IReadOnlyList<SchedulerResource> Resources { get; set; } = [];
    [Parameter] public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Utc;
    [Parameter] public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
    [Parameter] public EventCallback<DateOnly> DateChanged { get; set; }
    [Parameter] public SchedulerView View { get; set; } = SchedulerView.Week;
    [Parameter] public EventCallback<SchedulerView> ViewChanged { get; set; }
    [Parameter] public Func<SchedulerEvent, CancellationToken, ValueTask>? Save { get; set; }
    [Parameter] public Func<SchedulerEvent, CancellationToken, ValueTask>? Delete { get; set; }
    [Parameter] public EventCallback<SchedulerSlot> SlotSelected { get; set; }
    [Parameter] public EventCallback<SchedulerEvent> EventSelected { get; set; }
    [Parameter] public bool BookingMode { get; set; } = true;
    [Parameter] public string? BookingTitle { get; set; }
    [Parameter] public EventCallback<string?> BookingTitleChanged { get; set; }
    [Parameter] public bool CanEditTitle { get; set; }
    private string DisplayBookingTitle => string.IsNullOrWhiteSpace(BookingTitle) ? "Book an appointment" : BookingTitle;
    private bool _editingTitle;
    private bool _focusTitleButton;
    private ElementReference _titleButton;
    private string _titleDraft = "";

    private void BeginTitleEdit()
    {
        _titleDraft = DisplayBookingTitle;
        _editingTitle = true;
    }

    private async Task TitleKeyDown(KeyboardEventArgs args)
    {
        if (!_editingTitle) return;
        if (args.Key == "Escape")
        {
            _editingTitle = false;
            _focusTitleButton = true;
        }
        else if (args.Key == "Enter")
        {
            _focusTitleButton = true;
            await CommitTitle();
        }
    }

    private async Task CommitTitle()
    {
        if (!_editingTitle) return;
        _editingTitle = false;
        var title = string.IsNullOrWhiteSpace(_titleDraft) ? "Book an appointment" : _titleDraft.Trim();
        if (!CanEditTitle || ReadOnly || title == DisplayBookingTitle) return;
        BookingTitle = title;
        await BookingTitleChanged.InvokeAsync(title);
    }

    [Parameter] public RenderFragment? BookingFields { get; set; }
    [Parameter] public RenderFragment? MeetingDetails { get; set; }
    [Parameter] public TimeSpan BookingDuration { get; set; } = TimeSpan.FromMinutes(15);
    [Parameter] public EventCallback<TimeSpan> BookingDurationChanged { get; set; }
    private static readonly TimeSpan[] BookingDurations = [TimeSpan.FromMinutes(15), TimeSpan.FromMinutes(30), TimeSpan.FromMinutes(45), TimeSpan.FromHours(1)];

    private async Task SelectDuration(TimeSpan duration)
    {
        if (duration == BookingDuration) return;
        BookingDuration = duration;
        await BookingDurationChanged.InvokeAsync(duration);
    }

    [Parameter] public DateTimeOffset? SelectedStart { get; set; }
    private async Task SelectBookingSlot(DateTimeOffset start)
    {
        if (_busy || !SlotSelected.HasDelegate || !AvailableStarts(Date).Contains(start)) return;
        _busy = true;
        _error = null;
        try
        {
            await SlotSelected.InvokeAsync(new SchedulerSlot(start, null) { End = start.Add(BookingDuration) });
        }
        catch (Exception exception)
        {
            ReportError(exception, "handle booking slot selection");
            _error = "SaveError";
        }
        finally
        {
            _busy = false;
        }
    }

    private IEnumerable<DateTimeOffset> AvailableStarts(DateOnly day)
    {
        var now = DateTimeOffset.UtcNow;
        const int first = 9 * 60;
        const int last = 17 * 60;
        for (int minute = first; minute < last && minute + BookingDuration.TotalMinutes <= last; minute += 15)
        {
            var local = day.ToDateTime(TimeOnly.MinValue).AddMinutes(minute);
            if (SchedulerDates.ToInstant(local, TimeZone) is { } start && start > now &&
                !Events.Any(item => item.Intersects(start, start.Add(BookingDuration))))
                yield return start;
        }
    }

    [Parameter] public bool ReadOnly { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private bool _editing, _busy, _resize;
    private string? _editId, _resource, _error;
    private string _title = "";
    private DateTime _start;
    private DateTime? _end;
    private SchedulerEvent? _drag, _originalEvent;
    private DateOnly WeekStart => SchedulerDates.WeekStart(Date, Text.Culture.DateTimeFormat.FirstDayOfWeek);
    private IEnumerable<DateOnly> VisibleDays() => View == SchedulerView.Day ? [Date] : Enumerable.Range(0, 7).Select(WeekStart.AddDays);
    private IEnumerable<DateOnly> MonthDays() { var first = SchedulerDates.WeekStart(new(Date.Year, Date.Month, 1), Text.Culture.DateTimeFormat.FirstDayOfWeek); return Enumerable.Range(0, 42).Select(first.AddDays); }
    [Parameter] public int MaximumVisibleResources { get; set; } = 8;
    private int _resourcePage;
    private int ResourcePageSize => Math.Max(1, MaximumVisibleResources);
    private IReadOnlyList<SchedulerEvent>? _cachedEvents;
    private readonly Dictionary<DateOnly, SchedulerEvent[]> _dayEvents = [];
    private readonly HashSet<DateOnly> _preparedLaneDays = [];
    private readonly Dictionary<(DateOnly, string), IReadOnlyList<SchedulerEventPlacement>> _laneEvents = [];
    private readonly HashSet<string> _resourceIds = new(StringComparer.Ordinal);
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _dayEvents.Clear(); _laneEvents.Clear(); _preparedLaneDays.Clear();
        _resourceIds.Clear();
