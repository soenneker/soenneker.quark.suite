        {
            await EventSelected.InvokeAsync(e);
            return;
        }
        if (ReadOnly) return;
        _originalEvent = e;
        _editId = e.Id;
        _title = e.Title;
        _resource = e.ResourceId;
        _start = TimeZoneInfo.ConvertTime(e.Start, TimeZone).DateTime;
        _end = e.End is { } end ? TimeZoneInfo.ConvertTime(end, TimeZone).DateTime : null;
