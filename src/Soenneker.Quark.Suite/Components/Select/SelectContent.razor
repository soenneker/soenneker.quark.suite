@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixSelectPortal>
    <BradixSelectContent Position="@ContentPosition"
                         ForceMount="@ForceMount"
                         Side="@Side"
                         SideOffset="@SideOffset"
                         Align="@Align"
                         AlignOffset="@AlignOffset"
                         ArrowPadding="@ArrowPadding"
                         AvoidCollisions="@AvoidCollisions"
                         CollisionPadding="@CollisionPadding"
                         CollisionBoundarySelector="@CollisionBoundarySelector"
                         CollisionBoundarySelectors="@CollisionBoundarySelectors"
                         Sticky="@Sticky"
                         HideWhenDetached="@HideWhenDetached"
                         AdditionalAttributes="@ContentAttributes">
        <SelectScrollUpButton />
        <BradixSelectViewport AdditionalAttributes="@ViewportAttributes">
            @ChildContent
        </BradixSelectViewport>
        <SelectScrollDownButton />
    </BradixSelectContent>
</BradixSelectPortal>

@code {
    private static readonly CssValue<MinWidthBuilder> _staticCss0 = Quark.MinWidth.Is36;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is50;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowX = Quark.Overflow.X.Hidden;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowY = Quark.Overflow.Y.Auto;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.PopoverForeground;
    private static readonly CssValue<ShadowBuilder> _defaultShadow = Quark.Shadow.Md;
    private static readonly CssValue<RingBuilder> _defaultRing = Quark.Ring.Is1;
    private static readonly CssValue<RingColorBuilder> _defaultRingColor = Quark.RingColor.Utility("ring-foreground/10");
    private string? _lastBuiltClass;

    [Parameter]
    public Side Side { get; set; } = Side.Bottom;

    [Parameter]
    public bool ForceMount { get; set; }

    [Parameter]
    public int SideOffset { get; set; }

    [Parameter]
    public double AlignOffset { get; set; }

    [Parameter]
    public double ArrowPadding { get; set; }

    [Parameter]
    public bool AvoidCollisions { get; set; } = true;

    [Parameter]
    public double CollisionPadding { get; set; }

    [Parameter]
    public string? CollisionBoundarySelector { get; set; }

    [Parameter]
    public IReadOnlyList<string>? CollisionBoundarySelectors { get; set; }

    [Parameter]
    public string Sticky { get; set; } = "partial";

    [Parameter]
    public bool HideWhenDetached { get; set; }

    [Parameter]
    public Alignment Align { get; set; } = Alignment.Center;

    [Parameter]
    public SelectPosition ContentPosition { get; set; } = SelectPosition.ItemAligned;

    [Parameter]
    public bool UseDefaultMotion { get; set; } = true;

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildAttributes();

    private IReadOnlyDictionary<string, object> ViewportAttributes => BuildViewportAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "select-content";

        Position ??= _defaultPosition;
        ZIndex ??= _defaultZIndex;
        MaxHeight ??= "max-h-(--radix-select-content-available-height)";
        MinWidth ??= _staticCss0;
        OverflowX ??= _defaultOverflowX;
        OverflowY ??= _defaultOverflowY;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;
        Shadow ??= _defaultShadow;
        Ring ??= _defaultRing;
        RingColor ??= _defaultRingColor;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-align-trigger"] = ContentPosition == SelectPosition.ItemAligned ? "true" : "false";

        const string origin = "origin-(--radix-select-content-transform-origin)";
        const string motion = "origin-(--radix-select-content-transform-origin) duration-[50ms] data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95";
        const string popper = motion + " data-[side=bottom]:translate-y-1 data-[side=left]:-translate-x-1 data-[side=right]:translate-x-1 data-[side=top]:-translate-y-1";
        PrependClassAttribute(attributes, !UseDefaultMotion ? origin : ContentPosition == SelectPosition.Popper ? popper : motion, ref _lastBuiltClass);
    }

    private static readonly IReadOnlyDictionary<string, object> PopperViewportAttributes = CreatePopperViewportAttributes();

    private static IReadOnlyDictionary<string, object> CreatePopperViewportAttributes()
    {
        var attributes = new Dictionary<string, object> { ["data-position"] = "popper" };
        // Keep the utility declaration visible to the Tailwind manifest generator.
        {
            const string @class = "data-[position=popper]:w-full data-[position=popper]:min-w-(--radix-select-trigger-width)";
            PrependClassAttribute(attributes, @class);
        }
        return new System.Collections.ObjectModel.ReadOnlyDictionary<string, object>(attributes);
    }

    private static readonly IReadOnlyDictionary<string, object> ItemAlignedViewportAttributes =
        new System.Collections.ObjectModel.ReadOnlyDictionary<string, object>(new Dictionary<string, object>
        {
            ["data-position"] = "item-aligned"
        });

    private IReadOnlyDictionary<string, object> BuildViewportAttributes() =>
        ContentPosition == SelectPosition.Popper ? PopperViewportAttributes : ItemAlignedViewportAttributes;

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Side);
        hc.Add(SideOffset);
        hc.Add(AlignOffset);
        hc.Add(ArrowPadding);
        hc.Add(AvoidCollisions);
        hc.Add(CollisionPadding);
        hc.Add(CollisionBoundarySelector);
        if (CollisionBoundarySelectors is not null)
        {
            foreach (var selector in CollisionBoundarySelectors)
                hc.Add(selector);
        }
        hc.Add(Sticky);
        hc.Add(HideWhenDetached);
        hc.Add(Align);
        hc.Add(ContentPosition);
        hc.Add(UseDefaultMotion);
        hc.Add(ForceMount);
    }
}
