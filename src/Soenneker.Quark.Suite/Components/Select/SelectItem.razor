@using Soenneker.Bradix

@namespace Soenneker.Quark
@typeparam TValue
@inherits Soenneker.Quark.FormControlElement
@implements ISelectItem<TValue>

<BradixSelectItem Value="@ResolvedValue"
                  Disabled="@Disabled"
                  TextValue="@Text"
                  AdditionalAttributes="@ItemAttributes">
    <Span DataSlot="select-item-indicator" Position="_renderCss0" Right="_renderCss1" Display="_renderCss2" Size="_renderCss3" ItemsAlign="_staticCss0" Justify="_renderCss4">
        <BradixSelectItemIndicator>
            <Svg Size="_renderCss3" aria-hidden="true" NativeWidth="24" NativeHeight="24" ViewBox="0 0 24 24" Fill="_renderCss5" Stroke="_renderCss6" StrokeWidth="_renderCss7" StrokeLineCap="_renderCss8" StrokeLineJoin="_renderCss9">
                <path d="M20 6 9 17l-5-5"></path>
            </Svg>
        </BradixSelectItemIndicator>
    </Span>
    <BradixSelectItemText>
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else if (Text.HasContent())
        {
            @Text
        }
    </BradixSelectItemText>
</BradixSelectItem>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Quark.Items.Center;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1_5;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.FromRight.Is8.FromLeft.Token("1.5").OnY.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Sm;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.OnFocus.Accent;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.OnFocus.AccentForeground;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Default;
    private static readonly CssValue<PositionBuilder> _renderCss0 = Quark.Position.Absolute;
    private static readonly CssValue<RightBuilder> _renderCss1 = Quark.Right.Is2;
    private static readonly CssValue<DisplayBuilder> _renderCss2 = Quark.Display.Flex;
    private static readonly CssValue<SizeBuilder> _renderCss3 = Quark.Size.Is4;
    private static readonly CssValue<JustifyBuilder> _renderCss4 = Quark.Justify.Center;
    private static readonly CssValue<FillBuilder> _renderCss5 = Quark.Fill.None;
    private static readonly CssValue<StrokeBuilder> _renderCss6 = Quark.Stroke.Current;
    private static readonly CssValue<StrokeWidthBuilder> _renderCss7 = Quark.StrokeWidth.Is2;
    private static readonly CssValue<StrokeLineCapBuilder> _renderCss8 = Quark.StrokeLineCap.Round;
    private static readonly CssValue<StrokeLineJoinBuilder> _renderCss9 = Quark.StrokeLineJoin.Round;
    private string? _lastPrependedClass;

    private string? _registeredValue;

    /// <summary>
    /// Gets or sets the value of the select item.
    /// </summary>
    [Parameter]
    public TValue? ItemValue { get; set; }

    /// <summary>
    /// Gets or sets the display text for the select item.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    [CascadingParameter(Name = "ParentSelect")]
    private Select<TValue>? ParentSelect { get; set; }

    private string ResolvedValue => ItemValue?.ToString() ?? string.Empty;

    private IReadOnlyDictionary<string, object> ItemAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "select-item";
        Position ??= _defaultPosition;
        Display ??= _renderCss2;
        Width ??= _defaultWidth;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        BackgroundColor ??= _defaultBackgroundColor;
        TextColor ??= _defaultTextColor;
        OutlineStyle ??= _defaultOutlineStyle;
        UserSelect ??= _defaultUserSelect;
        Cursor ??= _defaultCursor;

    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var resolvedValue = ResolvedValue;
        if (_registeredValue.HasContent() && !string.Equals(_registeredValue, resolvedValue, StringComparison.Ordinal))
            ParentSelect?.UnregisterItemValue(_registeredValue!);

        if (resolvedValue.HasContent())
        {
            ParentSelect?.RegisterItemValue(resolvedValue, ItemValue);
            _registeredValue = resolvedValue;
        }
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        {
            const string @class = "not-data-[variant=destructive]:focus:**:text-accent-foreground data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 *:[span]:last:flex *:[span]:last:items-center *:[span]:last:gap-2";
            PrependClassAttribute(attributes, @class, ref _lastPrependedClass);
        }

        if (Hidden)
            attributes["hidden"] = QuarkAttributeValues.True;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ItemValue);
        hc.Add(Text);
        hc.Add(Disabled);
    }

    public override async ValueTask DisposeAsync()
    {
        if (_registeredValue.HasContent())
            ParentSelect?.UnregisterItemValue(_registeredValue!);

        await base.DisposeAsync();
    }
}
