@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement
@implements ISelectValue

@if (ChildContent is null)
{
    <BradixSelectValue ValueTemplate="@ValueTemplate" Placeholder="@PlaceholderContent" AdditionalAttributes="@ValueAttributes" />
}
else
{
    <BradixSelectValue ValueTemplate="@ValueTemplate" Placeholder="@PlaceholderContent" AdditionalAttributes="@ValueAttributes"
                       ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />
}

@code {
    [Parameter] public RenderFragment<string?>? ValueTemplate { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "select-value";
    }

    [Parameter]
    public string? Placeholder { get; set; }

    [CascadingParameter(Name = "ParentSelectContext")]
    private SelectContext? Context { get; set; }

    private string? ResolvedPlaceholder => Context?.DefaultItemText() ?? Placeholder;

    private RenderFragment? _placeholderContent;
    private RenderFragment? PlaceholderContent => ResolvedPlaceholder is null
        ? null
        : _placeholderContent ??= builder => builder.AddContent(0, ResolvedPlaceholder);

    private IReadOnlyDictionary<string, object> ValueAttributes => BuildAttributes();

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Placeholder);
        hc.Add(ValueTemplate);
        hc.Add(Context?.DefaultItemText());
    }
}