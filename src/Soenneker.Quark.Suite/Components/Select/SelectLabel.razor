@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.TypographyElement

<BradixSelectLabel AdditionalAttributes="@LabelAttributes">@ChildContent</BradixSelectLabel>

@code {
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is1_5.OnY.Is1;
    private static readonly CssValue<TextSizeBuilder> _defaultTextSize = Quark.TextSize.Xs;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private IReadOnlyDictionary<string, object> LabelAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "select-label";

        Padding ??= _defaultPadding;
        TextSize ??= _defaultTextSize;
        TextColor ??= _defaultTextColor;
    }
}
