@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IContainer

<div @attributes="BuildAttributes()">
	@ChildContent
</div>

@code {
    private static readonly CssValue<MaxWidthBuilder> _staticCss0 = Quark.MaxWidth.Is7xl;
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.OnX.Auto;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.OnX.Is4.OnMd.OnX.Is6.OnLg.OnX.Is8;
    private string? _lastBuiltClass;

	[Parameter]
	public string? ContainerType { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "container";

        Margin ??= _defaultMargin;
        Width ??= _defaultWidth;
        MaxWidth ??= _staticCss0;
        Padding ??= _defaultPadding;
    }

    // Default to the common shadcn-style centered content wrapper.
    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (ContainerType.HasContent())
            PrependClassAttribute(attributes, ContainerType!, ref _lastBuiltClass);
    }

	protected override void ComputeRenderKeyCore(ref HashCode hc)
	{
		base.ComputeRenderKeyCore(ref hc);
		hc.Add(ContainerType);
	}
}
