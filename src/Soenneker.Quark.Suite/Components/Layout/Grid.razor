@namespace Soenneker.Quark
@inherits Soenneker.Quark.InteractiveElement
@implements IGrid

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private string? _gridPrefix;
    private static readonly CssValue<DisplayBuilder> _inlineGridDisplay = Quark.Display.InlineGrid;
    private static readonly CssValue<DisplayBuilder> _gridDisplay = Quark.Display.Grid;
    private string? _lastBuiltClass;

    [Parameter]
    public CssValue<GridColsBuilder>? Columns { get; set; }

    [Parameter]
    public CssValue<GridRowsBuilder>? Rows { get; set; }

    [Parameter]
    public bool Inline { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "grid";

        Display ??= Inline ? _inlineGridDisplay : _gridDisplay;
    }

    protected override void BuildOwnedAttributes(Dictionary<string, object> attrs)
    {
        base.BuildOwnedAttributes(attrs);

        if (OnClick.HasDelegate)
            SetEventAttribute(attrs, "onclick", OnClick);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        var columns = Columns is { IsEmpty: false } ? Columns.Value.ToString() : null;
        var rows = Rows is { IsEmpty: false } ? Rows.Value.ToString() : string.Empty;
        PrependClassAttribute(attributes, AppendToClass(columns, rows, ref _gridPrefix), ref _lastBuiltClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);

        AddIf(ref hc, Columns);
        AddIf(ref hc, Rows);
        hc.Add(Inline);
    }
}
