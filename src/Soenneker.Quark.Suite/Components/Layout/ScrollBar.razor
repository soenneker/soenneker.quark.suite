@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixScrollAreaScrollbar Orientation="@Orientation"
                          ForceMount="@ForceMount"
                          AdditionalAttributes="@ScrollbarAttributes">
    <BradixScrollAreaThumb ForceMount="@ForceMount" AdditionalAttributes="@ThumbAttributes" />
</BradixScrollAreaScrollbar>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.IsPx;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private string? _lastPrependedClass;

    private static readonly IReadOnlyDictionary<string, object> ThumbAttributes = new Dictionary<string, object>
    {
        ["data-slot"] = "scroll-area-thumb",
        ["class"] = "relative flex-1 rounded-full bg-border"
    };

    /// <summary>
    /// Gets or sets the orientation: vertical or horizontal.
    /// </summary>
    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;

    /// <summary>
    /// Forces the scrollbar and thumb to remain mounted, matching Radix ScrollAreaScrollbar forceMount.
    /// </summary>
    [Parameter]
    public bool ForceMount { get; set; }

    private IReadOnlyDictionary<string, object> ScrollbarAttributes => BuildScrollbarAttributes();
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "scroll-area-scrollbar";

        Display ??= _defaultDisplay;
        Padding ??= _defaultPadding;
        UserSelect ??= _defaultUserSelect;
        Transition ??= _defaultTransition;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependClassAttribute(attributes, "touch-none data-[orientation=horizontal]:h-2.5 data-[orientation=horizontal]:flex-col data-[orientation=horizontal]:border-t data-[orientation=horizontal]:border-t-transparent data-[orientation=vertical]:h-full data-[orientation=vertical]:w-2.5 data-[orientation=vertical]:border-l data-[orientation=vertical]:border-l-transparent", ref _lastPrependedClass);
    }

    private IReadOnlyDictionary<string, object> BuildScrollbarAttributes()
    {
        return BuildAttributes();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Orientation);
        hc.Add(ForceMount);
    }
}
