@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IStack

<div @attributes="BuildAttributes()">
    @ChildContent
</div>

@code {
    private static readonly CssValue<DisplayBuilder> InlineFlexDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<DisplayBuilder> FlexDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> RowDirection = Quark.FlexDirection.Row;
    private static readonly CssValue<FlexDirectionBuilder> ColumnDirection = Quark.FlexDirection.Col;
    [Parameter]
    public StackOrientation Orientation { get; set; } = StackOrientation.Vertical;

    [Parameter]
    public bool Inline { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "stack";

    }

    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        var preset = AppliedPresetContext;
        if (ResolvePresetValue(Display, preset?.Display, nameof(Display)) is null)
            AddCss<DisplayBuilder>(ref cls, Inline ? InlineFlexDisplay : FlexDisplay);
        if (ResolvePresetValue(FlexDirection, preset?.FlexDirection, nameof(FlexDirection)) is null)
            AddCss<FlexDirectionBuilder>(ref cls, Orientation == StackOrientation.Horizontal ? RowDirection : ColumnDirection);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);

        hc.Add(Orientation);
        hc.Add(Inline);
    }
}
