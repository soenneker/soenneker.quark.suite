@using System.Globalization
@namespace Soenneker.Quark

@inherits Soenneker.Quark.Element
@implements IProgress
@using Soenneker.Bradix

<BradixProgress Value="@ResolvedBradixValue"
                Max="@Max"
                AdditionalAttributes="@BuildAttributes()">
    <BradixProgressIndicator AdditionalAttributes="@IndicatorAttributes" />
</BradixProgress>

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.Is1;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowX = Quark.Overflow.X.Hidden;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Muted;
    private QuarkAttributeDictionary _indicatorAttributesBuffer;
    /// <summary>
    /// Gets or sets the current progress value (0–100).
    /// </summary>
    [Parameter]
    public int ProgressValue { get; set; }

    /// <summary>
    /// Gets or sets whether the progress should render as an indeterminate loading state.
    /// </summary>
    [Parameter]
    public bool Indeterminate { get; set; }

    /// <summary>
    /// Gets or sets the ARIA value text announced for indeterminate progress.
    /// </summary>
    [Parameter]
    public string? AriaValueText { get; set; }

    /// <summary>
    /// Gets or sets the maximum value for ARIA semantics.
    /// </summary>
    [Parameter]
    public int Max { get; set; } = 100;

    private int EffectiveMax => Max > 0 ? Max : 100;

    private double? ResolvedBradixValue => null;
    private const string IndicatorClass = "size-full flex-1 bg-primary transition-transform duration-700 ease-in-out";

    private IReadOnlyDictionary<string, object> IndicatorAttributes => BuildIndicatorAttributes();

    private int GetClampedValue()
    {
        var val = ProgressValue;
        if (val < 0) val = 0;
        if (val > EffectiveMax) val = EffectiveMax;
        return val;
    }

    private string? _indicatorStyle;
    private int _indicatorValue;
    private int _indicatorMax;
    private CultureInfo? _indicatorCulture;

    private string GetIndicatorStyle()
    {
        if (Indeterminate)
            return "transform: translateX(-50%);";

        var value = GetClampedValue();
        var max = EffectiveMax;
        var culture = CultureInfo.CurrentCulture;
        if (_indicatorStyle is not null && value == _indicatorValue && max == _indicatorMax &&
            culture.IsReadOnly && ReferenceEquals(culture, _indicatorCulture))
            return _indicatorStyle;

        var pct = value * 100.0 / max;
        _indicatorStyle = $"transform: translateX(-{100 - pct:F0}%);";
        _indicatorValue = value;
        _indicatorMax = max;
        _indicatorCulture = culture;
        return _indicatorStyle;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "progress";
        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        ItemsAlign ??= _staticCss0;
        Height ??= _defaultHeight;
        Width ??= _defaultWidth;
        OverflowX ??= _defaultOverflowX;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        if (Indeterminate && AriaValueText.HasContent() && !attributes.ContainsKey("aria-valuetext"))
            attributes["aria-valuetext"] = AriaValueText!;


    }
    private IReadOnlyDictionary<string, object> BuildIndicatorAttributes()
    {
        var attributes = _indicatorAttributesBuffer.Create(3);
        attributes["data-slot"] = "progress-indicator";
        attributes["class"] = IndicatorClass;
        attributes["style"] = GetIndicatorStyle();

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ProgressValue);
        hc.Add(Max);
        hc.Add(Indeterminate);
        hc.Add(AriaValueText);
    }
}
