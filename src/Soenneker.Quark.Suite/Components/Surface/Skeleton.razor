@* Tailwind @source: skeleton size classes for library build — h-4 h-8 h-12 h-[125px] w-[100px] w-[150px] w-[200px] w-[250px] w-20 w-24 w-2/3 w-1/2 w-3/4 w-full flex-1 size-10 rounded-full rounded-xl aspect-video *@
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ISkeleton

<div @attributes="BuildAttributes()"></div>

@code {
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Md;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Muted;
    private static readonly CssValue<AnimationBuilder> _defaultAnimation = Quark.Animation.Pulse;
    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "skeleton";

        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        Animation ??= _defaultAnimation;
    }
}