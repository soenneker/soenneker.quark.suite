@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements ISpinner
@inject ISpinnerInterop SpinnerInterop

<span @attributes="BuildAttributes()">
    @if (Name.HasValue)
    {
        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 24 24"
             width="100%"
             height="100%"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             focusable="false">
            @if (Name == LucideIcon.Loader)
            {
                <path d="M12 2v4" />
                <path d="m16.2 7.8 2.9-2.9" />
                <path d="M18 12h4" />
                <path d="m16.2 16.2 2.9 2.9" />
                <path d="M12 18v4" />
                <path d="m4.9 19.1 2.9-2.9" />
                <path d="M2 12h4" />
                <path d="m4.9 4.9 2.9 2.9" />
            }
            else
            {
                <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            }
        </svg>
    }
    else
    {
        @if (ShowTrack)
        {
            <svg class="quark-spinner-track-graphic" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                <circle data-slot="spinner-track" class="quark-spinner-track" cx="50" cy="50" />
            </svg>
        }

        <span data-slot="spinner-motion" class="quark-spinner-indeterminate" aria-hidden="true">
            <span class="quark-spinner-layer">
                <span class="quark-spinner-clipper quark-spinner-left">
                    <svg class="quark-spinner-circle-graphic" viewBox="0 0 100 100" focusable="false">
                        <circle class="quark-spinner-circle" cx="50" cy="50" pathLength="100" stroke-dasharray="100" stroke-dashoffset="50" />
                    </svg>
                </span>
                <span class="quark-spinner-gap-patch">
                    <svg class="quark-spinner-circle-graphic" viewBox="0 0 100 100" focusable="false">
                        <circle class="quark-spinner-circle" cx="50" cy="50" pathLength="100" stroke-dasharray="100" stroke-dashoffset="50" />
                    </svg>
                </span>
                <span class="quark-spinner-clipper quark-spinner-right">
                    <svg class="quark-spinner-circle-graphic" viewBox="0 0 100 100" focusable="false">
                        <circle class="quark-spinner-circle" cx="50" cy="50" pathLength="100" stroke-dasharray="100" stroke-dashoffset="50" />
                    </svg>
                </span>
            </span>
        </span>
    }
</span>

@code {
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is4;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineBlock;
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<PointerEventsBuilder> _defaultPointerEvents = Quark.PointerEvents.None;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<LeadingBuilder> _defaultLeading = Quark.Leading.Is0;
    private static readonly CssValue<VerticalAlignBuilder> _defaultVerticalAlign = Quark.VerticalAlign.Middle;
    private string? _lastBuiltClass;
    private string? _lastBuiltStyle;

    private bool _styleInitialized;

    [Parameter]
    public string? ForegroundColor { get; set; }

    [Parameter]
    public IReadOnlyList<string>? ForegroundColors { get; set; }

    [Parameter]
    public string TrackColor { get; set; } = "currentColor";

    [Parameter]
    public bool ShowTrack { get; set; }

    [Parameter]
    public double TrackOpacity { get; set; } = 0.15;

    [Parameter]
    public double StrokeWidth { get; set; } = 4;

    [Parameter]
    public double? TrackStrokeWidth { get; set; }

    [Parameter]
    public double MinimumArcLength { get; set; } = 2.778;

    [Parameter]
    public double MaximumArcLength { get; set; } = 77.778;

    [Parameter]
    public double ArcTravel { get; set; } = 100;

    [Parameter]
    public double Speed { get; set; } = 1;

    [Parameter]
    public double? RotationDuration { get; set; }

    [Parameter]
    public double ArcDuration { get; set; } = 1.333;

    [Parameter]
    public double? ColorDuration { get; set; }

    [Parameter]
    public string ArcEasing { get; set; } = "cubic-bezier(0.4, 0, 0.2, 1)";

    [Parameter]
    public bool Reverse { get; set; }

    [Parameter]
    public bool Decorative { get; set; }

    [Parameter]
    public LucideIcon? Name { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "spinner";

        if (!HasExplicitSizeClass())
            Size ??= _defaultSize;

        Display ??= _defaultDisplay;
        Position ??= _defaultPosition;
        Shrink ??= _defaultShrink;
        PointerEvents ??= _defaultPointerEvents;
        Overflow ??= _defaultOverflow;
        Leading ??= _defaultLeading;
        VerticalAlign ??= _defaultVerticalAlign;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["dir"] = "ltr";
        attributes["data-reverse"] = Reverse ? "true" : "false";
        attributes["data-decorative"] = Decorative ? "true" : "false";

        var classes = Name.HasValue
            ? Name == LucideIcon.Loader
                ? HasColorAnimation ? "quark-spinner quark-spinner-multicolor lucide lucide-loader animate-spin" : "quark-spinner lucide lucide-loader animate-spin"
                : HasColorAnimation ? "quark-spinner quark-spinner-multicolor lucide lucide-loader-circle animate-spin" : "quark-spinner lucide lucide-loader-circle animate-spin"
            : HasColorAnimation ? "quark-spinner quark-spinner-multicolor" : "quark-spinner";
        PrependClassAttribute(attributes, classes, ref _lastBuiltClass);
        PrependStyleAttribute(attributes, GetSpinnerStyle(), ref _lastBuiltStyle);

        if (Decorative)
        {
            attributes["aria-hidden"] = "true";
            attributes.Remove("role");
            attributes.Remove("aria-label");
        }
        else
        {
            attributes.TryAdd("role", "status");
            attributes.TryAdd("aria-label", "Loading");
        }
    }

    private SpinnerStyleKey _styleKey;
    private string? _spinnerStyle;

    private string GetSpinnerStyle()
    {
        if (Name.HasValue)
            return "contain:strict";
        var key = new SpinnerStyleKey(
            Name.HasValue,
            BitConverter.DoubleToInt64Bits(ResolvedTrackOpacity),
            BitConverter.DoubleToInt64Bits(ResolvedStrokeWidth),
            BitConverter.DoubleToInt64Bits(ResolvedTrackStrokeWidth),
            BitConverter.DoubleToInt64Bits(ResolvedMinimumArcLength),
            BitConverter.DoubleToInt64Bits(ResolvedMaximumArcLength),
            BitConverter.DoubleToInt64Bits(ResolvedArcTravel),
            BitConverter.DoubleToInt64Bits(ResolvedSpeed),
            BitConverter.DoubleToInt64Bits(RotationDuration ?? ArcDuration * MaterialLinearRotationRatio),
            BitConverter.DoubleToInt64Bits(ArcDuration),
            BitConverter.DoubleToInt64Bits(ColorDuration ?? ArcDuration * 4),
            ResolvedForegroundColor,
            TrackColor,
            ResolvedArcEasing,
            GetPaletteColor(0),
            GetPaletteColor(1),
            GetPaletteColor(2),
            GetPaletteColor(3));
        if (_spinnerStyle is not null && _styleKey == key)
            return _spinnerStyle;
        var sty = new PooledStringBuilder(stackalloc char[128]);
        try
        {
                AppendStyleDecl(ref sty, "contain:strict");
                if (!Name.HasValue)
                {
                    AppendStyleDecl(ref sty, "--spinner-foreground:", ResolvedForegroundColor);
                    AppendStyleDecl(ref sty, "--spinner-track-color:", TrackColor);
                    sty.Append("; --spinner-track-opacity:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedTrackOpacity);
                    sty.Append("; --spinner-stroke-width:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedStrokeWidth * 2);
                    sty.Append("; --spinner-track-stroke-width:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedTrackStrokeWidth * 2);
                    sty.Append("; --spinner-radius:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, 50 - ResolvedStrokeWidth);
                    sty.Append("; --spinner-track-radius:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, 50 - ResolvedTrackStrokeWidth);
                    sty.Append("; --spinner-minimum-arc:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedMinimumArcLength);
                    sty.Append("; --spinner-maximum-arc:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedMaximumArcLength);
                    sty.Append("; --spinner-left-start:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, 270 - ResolvedMinimumArcLength * 1.8);
                    sty.Append("deg");
                    sty.Append("; --spinner-left-middle:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, 270 - ResolvedMaximumArcLength * 1.8);
                    sty.Append("deg");
                    sty.Append("; --spinner-right-start:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, (270 - ResolvedMinimumArcLength * 1.8) * -1);
                    sty.Append("deg");
                    sty.Append("; --spinner-right-middle:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, (270 - ResolvedMaximumArcLength * 1.8) * -1);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-1:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 1.35);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-2:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 2.7);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-3:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 4.05);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-4:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 5.4);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-5:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 6.75);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-6:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 8.1);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-7:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 9.45);
                    sty.Append("deg");
                    sty.Append("; --spinner-layer-8:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel * 10.8);
                    sty.Append("deg");
                    sty.Append("; --spinner-rotation-duration:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, Math.Max(RotationDuration ?? ArcDuration * MaterialLinearRotationRatio, 0.001) / ResolvedSpeed);
                    sty.Append("s");
                    sty.Append("; --spinner-arc-duration:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, Math.Max(ArcDuration, 0.001) / ResolvedSpeed);
                    sty.Append("s");
                    sty.Append("; --spinner-cycle-duration:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, Math.Max(ArcDuration * 4, 0.001) / ResolvedSpeed);
                    sty.Append("s");
                    sty.Append("; --spinner-color-duration:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, Math.Max(ColorDuration ?? ArcDuration * 4, 0.001) / ResolvedSpeed);
                    sty.Append("s");
                    AppendStyleDecl(ref sty, "--spinner-easing:", ResolvedArcEasing);
                    sty.Append("; --spinner-arc-travel:");
                    InvariantNumberFormatting.AppendInvariant(ref sty, ResolvedArcTravel);
                    AppendStyleDecl(ref sty, "--spinner-color-1:", GetPaletteColor(0));
                    AppendStyleDecl(ref sty, "--spinner-color-2:", GetPaletteColor(1));
                    AppendStyleDecl(ref sty, "--spinner-color-3:", GetPaletteColor(2));
                    AppendStyleDecl(ref sty, "--spinner-color-4:", GetPaletteColor(3));
                }

            _spinnerStyle = sty.ToString();
            _styleKey = key;
            return _spinnerStyle;
        }
        finally
        {
            sty.Dispose();
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ForegroundColor);

        if (ForegroundColors is not null)
        {
            for (var i = 0; i < ForegroundColors.Count; i++)
                hc.Add(ForegroundColors[i]);
        }

        hc.Add(TrackColor);
        hc.Add(ShowTrack);
        hc.Add(TrackOpacity);
        hc.Add(StrokeWidth);
        hc.Add(TrackStrokeWidth);
        hc.Add(MinimumArcLength);
        hc.Add(MaximumArcLength);
        hc.Add(ArcTravel);
        hc.Add(Speed);
        hc.Add(RotationDuration);
        hc.Add(ArcDuration);
        hc.Add(ColorDuration);
        hc.Add(ArcEasing);
        hc.Add(Reverse);
        hc.Add(Decorative);
        hc.Add(Name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!_styleInitialized && !Name.HasValue)
        {
            await SpinnerInterop.Initialize();
            _styleInitialized = true;
        }
    }

    private double ResolvedStrokeWidth => Math.Clamp(StrokeWidth, 0.1, 20);
    private double ResolvedTrackStrokeWidth => Math.Clamp(TrackStrokeWidth ?? StrokeWidth, 0.1, 20);
    private double ResolvedTrackOpacity => Math.Clamp(TrackOpacity, 0, 1);
    private double ResolvedMinimumArcLength => Math.Clamp(MinimumArcLength, 0.1, 99.9);
    private double ResolvedMaximumArcLength => Math.Clamp(MaximumArcLength, ResolvedMinimumArcLength, 99.9);
    private double ResolvedArcTravel => Math.Clamp(ArcTravel, 0, 200);
    private double ResolvedSpeed => Math.Max(Speed, 0.001);
    private string ResolvedArcEasing => string.IsNullOrWhiteSpace(ArcEasing) ? "cubic-bezier(0.4, 0, 0.2, 1)" : ArcEasing;
    private string ResolvedForegroundColor => ForegroundColor ?? (ForegroundColors is { Count: > 0 } ? ForegroundColors[0] : "currentColor");
    private bool HasColorAnimation => ForegroundColor is null && ForegroundColors is { Count: > 1 };
    private const double MaterialLinearRotationRatio = 1568.2352941176d / 1333d;


    private string GetPaletteColor(int index)
    {
        if (ForegroundColor is not null || ForegroundColors is not { Count: > 0 })
            return ResolvedForegroundColor;

        return ForegroundColors[index % Math.Min(ForegroundColors.Count, 4)];
    }


    private bool HasExplicitSizeClass()
    {
        if (ClassHasExplicitSize(Class))
            return true;

        if (Attributes is null)
            return false;

        if (Attributes is Dictionary<string, object> dictionary)
        {
            foreach (var attribute in dictionary)
                if (attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) && ClassHasExplicitSize(attribute.Value?.ToString()))
                    return true;
            return false;
        }

        if (Attributes is System.Collections.Generic.OrderedDictionary<string, object> ordered)
        {
            foreach (var attribute in ordered)
                if (attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) && ClassHasExplicitSize(attribute.Value?.ToString()))
                    return true;
            return false;
        }

        foreach (var attribute in Attributes)
        {
            if (attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) && ClassHasExplicitSize(attribute.Value?.ToString()))
                return true;
        }

        return false;
    }

    private static bool ClassHasExplicitSize(string? className)
    {
        if (string.IsNullOrWhiteSpace(className))
            return false;

        var remaining = className.AsSpan();

        while (!remaining.IsEmpty)
        {
            remaining = remaining.TrimStart();
            var separator = remaining.IndexOfAny(" \t\r\n".AsSpan());
            var token = separator < 0 ? remaining : remaining[..separator];

            if (IsExplicitSizeToken(token))
                return true;

            if (separator < 0)
                break;

            remaining = remaining[(separator + 1)..];
        }

        return false;
    }

    private static bool IsExplicitSizeToken(ReadOnlySpan<char> token)
    {
        var separator = token.LastIndexOf(':');
        var utility = separator >= 0 ? token[(separator + 1)..] : token;

        return utility.StartsWith("size-", StringComparison.Ordinal) ||
               utility.StartsWith("w-", StringComparison.Ordinal) ||
               utility.StartsWith("h-", StringComparison.Ordinal);
    }
}
