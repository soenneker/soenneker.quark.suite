@using System.Globalization

@namespace Soenneker.Quark
@inherits Soenneker.Quark.CancellableElement
@implements IScore

<div @attributes="BuildAttributes()" role="progressbar" aria-valuenow="@_valueAttribute.Get(_normalizedValue)" aria-valuemin="0" aria-valuemax="100">
    <Div DataSlot="score-circle" Shrink="_renderCss0" Position="_renderCss1" Rounded="_renderCss2"
         Style="width: var(--score-size, 88px); height: var(--score-size, 88px); background: var(--score-center-color, transparent);">
        <svg data-slot="score-ring" class="block size-full fill-none" viewBox="@_viewBox" aria-hidden="true" focusable="false">
            <circle data-slot="score-track" style="stroke: var(--score-track-color, var(--muted));" cx="@_center" cy="@_center" r="@_radius" stroke-width="@_thicknessAttribute.Get(_thicknessPx)" />
            <circle data-slot="score-indicator" cx="@_center" cy="@_center" r="@_radius" stroke-width="@_thicknessAttribute.Get(_thicknessPx)"
                    class="transition-[stroke-dashoffset,stroke]" stroke-linecap="butt"
                    pathLength="100" stroke-dasharray="100 100" style="@_indicatorStyle" transform="@_rotation" />
        </svg>
        <Div DataSlot="score-center" Position="_renderCss3" Inset="_renderCss4" Display="_renderCss5" ItemsAlign="_staticCss0" Justify="_renderCss6">
            <Div DataSlot="score-value" FontWeight="_renderCss7" Leading="_renderCss8" FontVariantNumeric="_renderCss9" Tracking="_renderCss10"
                 Style="font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif); font-size: var(--score-font-size, max(10px, calc(var(--score-size, 88px) * 0.32))); color: var(--score-value-color, var(--foreground));">@_valueText</Div>
        </Div>
    </Div>
    @if (ChildContent != null)
    {
        <Div DataSlot="score-text" TextAlign="_renderCss11" Style="font-size: 0.9rem; line-height: 1.2; color: var(--score-text-color, var(--muted-foreground));">@ChildContent</Div>
    }
    else if (Text.HasContent())
    {
        <Div DataSlot="score-text" TextAlign="_renderCss11" Style="font-size: 0.9rem; line-height: 1.2; color: var(--score-text-color, var(--muted-foreground));">@Text</Div>
    }
</div>

@code
{
    private string? _lastBuiltStyle;

    private static readonly CultureInfo _inv = CultureInfo.InvariantCulture;
    private const string NeutralScoreColor = "var(--score-neutral-color, var(--foreground))";

    private bool _parametersChanged;
    private bool _initialized;
    private string _viewBox = "";
    private string _center = "";
    private string _radius = "";
    private string _rotation = "";
    private string _indicatorStyle = "";
    private string _scoreStyle = "";
    private string _valueText = "";
    private QuarkInt32Attribute _valueAttribute;
    private QuarkInt32Attribute _thicknessAttribute;

    private int _normalizedValue;
    private int _lastValue;
    private string? _lastText;
    private int _lastSize;
    private int _lastThickness;
    private bool _lastColored;

    // Cached computed values (only recomputed When params actually change)
    private int _sizePx;
    private int _thicknessPx;
    private string _angleCss = "0deg";
    private string _colorCss = "hsl(0 75% 45%)";
    private string _sizeCss = "88px";
    private string _thicknessCss = "8px";

    [Parameter] public int Value { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public int ScoreSize { get; set; } = 88;
    [Parameter] public int Thickness { get; set; } = 8;
    [Parameter] public bool Colored { get; set; } = true;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "score";

        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        ItemsAlign ??= _staticCss0;
        Gap ??= _defaultGap;
    }

    protected override void OnParametersSet()
    {
        _normalizedValue = NormalizeValue(Value);

        _parametersChanged =
            !_initialized ||
            _normalizedValue != _lastValue ||
            ScoreSize != _lastSize ||
            Thickness != _lastThickness ||
            Colored != _lastColored ||
            !string.Equals(Text, _lastText, StringComparison.Ordinal);

        var size = ScoreSize <= 0 ? 88 : ScoreSize;
        var thickness = Math.Clamp(Thickness <= 0 ? 8 : Thickness, 1, Math.Max(1, size / 2));
        var geometryChanged = !_initialized || size != _sizePx || thickness != _thicknessPx;
        var valueChanged = !_initialized || _normalizedValue != _lastValue;
        var colorChanged = !_initialized || valueChanged || Colored != _lastColored;
        if (geometryChanged)
        {
            _sizePx = size;
            _thicknessPx = thickness;
            _sizeCss = string.Create(_inv, $"{size}px");
            _thicknessCss = string.Create(_inv, $"{thickness}px");
            _center = (size / 2d).ToString(_inv);
            _radius = ((size - thickness) / 2d).ToString(_inv);
            _viewBox = string.Create(_inv, $"0 0 {size} {size}");
            _rotation = $"rotate(-90 {_center} {_center})";
        }
        if (valueChanged)
        {
            _angleCss = string.Create(_inv, $"{_normalizedValue * 3.6d:0.##}deg");
            _valueText = _normalizedValue.ToString(_inv);
            _indicatorStyle = string.Create(_inv, $"stroke-dashoffset: {100 - _normalizedValue}; stroke: var(--score-color, var(--primary)); transition-duration: 1000ms; transition-timing-function: cubic-bezier(0, 0, 0.2, 1);");
        }
        if (colorChanged)
            _colorCss = Colored ? GetColoredScoreColor(_normalizedValue) : NeutralScoreColor;
        if (geometryChanged || valueChanged || colorChanged)
            _scoreStyle = $"--score-angle: {_angleCss}; --score-color: {_colorCss}; --score-size: {_sizeCss}; --score-thickness: {_thicknessCss}";
        _initialized = true;

        _lastValue = _normalizedValue;
        _lastSize = ScoreSize;
        _lastThickness = Thickness;
        _lastColored = Colored;
        _lastText = Text;

        base.OnParametersSet();
    }

    protected override bool ShouldRender() => _parametersChanged || base.ShouldRender();

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        _parametersChanged = false;
        return base.OnAfterRenderAsync(firstRender);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        PrependStyleAttribute(attributes, _scoreStyle, ref _lastBuiltStyle);
    }

    private static int NormalizeValue(int value) => Math.Clamp(value, 0, 100);

    private static string GetColoredScoreColor(int value)
    {
        // hue: 0..120, split ramp around 50
        var hue = value <= 50
            ? (value / 50d) * 60d
            : 60d + ((value - 50d) / 50d) * 60d;

        // hsl(<hue> 75% 45%)
        return string.Create(_inv, $"hsl({hue:0.##} 75% 45%)");
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(Text);
        hc.Add(ScoreSize);
        hc.Add(Thickness);
        hc.Add(Colored);
    }
}

@code {
    private static readonly CssValue<ItemsBuilder> _staticCss0 = Items.Center;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.InlineFlex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.Col;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private static readonly CssValue<ShrinkBuilder> _renderCss0 = Quark.Shrink.Is0;
    private static readonly CssValue<PositionBuilder> _renderCss1 = Quark.Position.Relative;
    private static readonly CssValue<RoundedBuilder> _renderCss2 = Quark.Rounded.Full;
    private static readonly CssValue<PositionBuilder> _renderCss3 = Quark.Position.Absolute;
    private static readonly CssValue<InsetBuilder> _renderCss4 = Quark.Inset.Is0;
    private static readonly CssValue<DisplayBuilder> _renderCss5 = Quark.Display.Flex;
    private static readonly CssValue<JustifyBuilder> _renderCss6 = Quark.Justify.Center;
    private static readonly CssValue<FontWeightBuilder> _renderCss7 = Quark.FontWeight.Semibold;
    private static readonly CssValue<LeadingBuilder> _renderCss8 = Quark.Leading.None;
    private static readonly CssValue<FontVariantNumericBuilder> _renderCss9 = Quark.FontVariantNumeric.TabularNums;
    private static readonly CssValue<TrackingBuilder> _renderCss10 = Quark.Tracking.Normal;
    private static readonly CssValue<TextAlignBuilder> _renderCss11 = Quark.TextAlign.Center;
}
