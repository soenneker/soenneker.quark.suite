@using System.Globalization

@namespace Soenneker.Quark
@inherits Soenneker.Quark.CancellableElement
@implements IScore

<div @attributes="BuildAttributes()" role="progressbar" aria-valuenow="@_normalizedValue" aria-valuemin="0" aria-valuemax="100">
    <Div DataSlot="score-circle" Shrink="Quark.Shrink.Is0" Position="Quark.Position.Relative" Rounded="Quark.Rounded.Full"
         Style="width: var(--score-size, 88px); height: var(--score-size, 88px); background: var(--score-center-color, transparent);">
        <svg data-slot="score-ring" class="block size-full fill-none" viewBox="@($"0 0 {_sizePx} {_sizePx}")" aria-hidden="true" focusable="false">
            <circle data-slot="score-track" style="stroke: var(--score-track-color, var(--muted));" cx="@((_sizePx / 2d).ToString(_inv))" cy="@((_sizePx / 2d).ToString(_inv))" r="@(((_sizePx - _thicknessPx) / 2d).ToString(_inv))" stroke-width="@_thicknessPx" />
            <circle data-slot="score-indicator" cx="@((_sizePx / 2d).ToString(_inv))" cy="@((_sizePx / 2d).ToString(_inv))" r="@(((_sizePx - _thicknessPx) / 2d).ToString(_inv))" stroke-width="@_thicknessPx"
                    class="transition-[stroke-dashoffset,stroke] duration-700 ease-in-out motion-reduce:transition-none" stroke-linecap="butt"
                    pathLength="100" stroke-dasharray="100 100" style="@($"stroke-dashoffset: {100 - _normalizedValue}; stroke: var(--score-color, var(--primary));")" transform="@(FormattableString.Invariant($"rotate(-90 {_sizePx / 2d} {_sizePx / 2d})"))" />
        </svg>
        <Div DataSlot="score-center" Position="Quark.Position.Absolute" Inset="Quark.Inset.Is0" Display="Quark.Display.Flex" ItemsAlign="Items.Center" Justify="Quark.Justify.Center">
            <Div DataSlot="score-value" FontWeight="Quark.FontWeight.Semibold" Leading="Quark.Leading.None" FontVariantNumeric="Quark.FontVariantNumeric.TabularNums" Tracking="Quark.Tracking.Normal"
                 Style="font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif); font-size: var(--score-font-size, max(10px, calc(var(--score-size, 88px) * 0.32))); color: var(--score-value-color, var(--foreground));">@_normalizedValue</Div>
        </Div>
    </Div>
    @if (ChildContent != null)
    {
        <Div DataSlot="score-text" TextAlign="Quark.TextAlign.Center" Style="font-size: 0.9rem; line-height: 1.2; color: var(--score-text-color, var(--muted-foreground));">@ChildContent</Div>
    }
    else if (Text.HasContent())
    {
        <Div DataSlot="score-text" TextAlign="Quark.TextAlign.Center" Style="font-size: 0.9rem; line-height: 1.2; color: var(--score-text-color, var(--muted-foreground));">@Text</Div>
    }
</div>

@code
{
    private static readonly CultureInfo _inv = CultureInfo.InvariantCulture;
    private const string NeutralScoreColor = "var(--score-neutral-color, var(--foreground))";

    private bool _parametersChanged;

    private int _normalizedValue;
    private int _lastValue;
    private string? _lastText;
    private int _lastSize;
    private int _lastThickness;
    private bool _lastColored;

    // Cached computed values (only recomputed When params actually change)
    private int _sizePx;
    private int _thicknessPx;
    private string _angleCss = "0deg";
    private string _colorCss = "hsl(0 75% 45%)";
    private string _sizeCss = "88px";
    private string _thicknessCss = "8px";

    [Parameter] public int Value { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public int ScoreSize { get; set; } = 88;
    [Parameter] public int Thickness { get; set; } = 8;
    [Parameter] public bool Colored { get; set; } = true;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "score";

        Display ??= Quark.Display.InlineFlex;
        FlexDirection ??= Quark.FlexDirection.Col;
        ItemsAlign ??= Items.Center;
        Gap ??= Quark.Gap.Is2;
    }

    protected override void OnParametersSet()
    {
        _normalizedValue = NormalizeValue(Value);

        _parametersChanged =
            _normalizedValue != _lastValue ||
            ScoreSize != _lastSize ||
            Thickness != _lastThickness ||
            Colored != _lastColored ||
            !string.Equals(Text, _lastText, StringComparison.Ordinal);

        if (_parametersChanged)
        {
            _sizePx = ScoreSize <= 0 ? 88 : ScoreSize;
            _thicknessPx = Math.Clamp(Thickness <= 0 ? 8 : Thickness, 1, Math.Max(1, _sizePx / 2));

            _sizeCss = string.Create(_inv, $"{_sizePx}px");
            _thicknessCss = string.Create(_inv, $"{_thicknessPx}px");

            // angle = value * 3.6
            _angleCss = string.Create(_inv, $"{_normalizedValue * 3.6d:0.##}deg");

            _colorCss = Colored ? GetColoredScoreColor(_normalizedValue) : NeutralScoreColor;
        }

        _lastValue = _normalizedValue;
        _lastSize = ScoreSize;
        _lastThickness = Thickness;
        _lastColored = Colored;
        _lastText = Text;

        base.OnParametersSet();
    }

    protected override bool ShouldRender() => _parametersChanged || base.ShouldRender();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _parametersChanged = false;
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);


        BuildClassAndStyleAttributes(attributes, (ref cls, ref sty) =>
        {
            // Use cached strings so this method stays cheap.
            AppendStyleDecl(ref sty, "--score-angle: ", _angleCss);
            AppendStyleDecl(ref sty, "--score-color: ", _colorCss);
            AppendStyleDecl(ref sty, "--score-size: ", _sizeCss);
            AppendStyleDecl(ref sty, "--score-thickness: ", _thicknessCss);
        });
    }

    private static int NormalizeValue(int value) => Math.Clamp(value, 0, 100);

    private static string GetColoredScoreColor(int value)
    {
        // hue: 0..120, split ramp around 50
        var hue = value <= 50
            ? (value / 50d) * 60d
            : 60d + ((value - 50d) / 50d) * 60d;

        // hsl(<hue> 75% 45%)
        return string.Create(_inv, $"hsl({hue:0.##} 75% 45%)");
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Value);
        hc.Add(Text);
        hc.Add(ScoreSize);
        hc.Add(Thickness);
        hc.Add(Colored);
    }
}
