@namespace Soenneker.Quark

<nav @attributes="AdditionalAttributes" aria-label="@Label" data-slot="bottom-navigation"
     class="fixed inset-x-0 bottom-0 z-40 flex items-stretch justify-around border-t bg-background pb-[env(safe-area-inset-bottom)]">
    @ChildContent
</nav>

@code {
    [Parameter] public string Label { get; set; } = "Primary navigation";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
