@namespace Soenneker.Quark
@implements IDetailsItem

@if (FullWidth)
{
    <GridItem Preset="Appearance.InfoItemPreset" ColumnSpan="_staticCss0">
        @ItemContent
    </GridItem>
}
else
{
    <GridItem Preset="Appearance.InfoItemPreset">
        @ItemContent
    </GridItem>
}

@code {
    private static readonly CssValue<ColumnSpanBuilder> _staticCss0 = ColumnSpan.Is1.OnSm.Is2;
    [Parameter]
    public DetailsItemAppearance Appearance { get; set; } = new();

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Content { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Copyable { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool IsCode { get; set; }

    [Parameter]
    public bool IsMuted { get; set; }

    [Parameter]
    public bool IsLink { get; set; }

    [Parameter]
    public string? LinkUrl { get; set; }

    private RenderFragment? _itemContent;

    private RenderFragment ItemContent => _itemContent ??= @<text>
        <Label Preset="Appearance.InfoItemLabelPreset">@Label</Label>
        <Div Presets="@ValuePresets">
            @if (IsLink && !LinkUrl.IsNullOrEmpty())
            {
                <Anchor Href="@LinkUrl" Target="Target.Blank" Preset="Appearance.DetailLinkPreset">@Content</Anchor>
            }
            else
            {
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else if (Copyable)
                {
                    <CopyableText Text="@Content" ShowFullTextOnHover="false" />
                }
                else
                {
                    @Content
                }
            }
        </Div>
    </text>;

    private QuarkPresetToken[]? _valuePresets;
    private IReadOnlyList<QuarkPresetToken> ValuePresets
    {
        get
        {
            int count = 1 + (IsCode ? 1 : 0) + (IsMuted ? 1 : 0);
            if (_valuePresets?.Length != count)
                _valuePresets = new QuarkPresetToken[count];
            var presets = _valuePresets;
            int index = 0;
            presets[index++] = Appearance.InfoItemValuePreset;

            if (IsCode)
                presets[index++] = Appearance.InfoItemCodeValuePreset;

            if (IsMuted)
                presets[index] = Appearance.InfoItemMutedValuePreset;

            return presets;
        }
    }
}
