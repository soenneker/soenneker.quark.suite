@using Soenneker.Bradix
@namespace Soenneker.Quark
@inherits Soenneker.Quark.TriggerElement
@implements IDialogTrigger

<BradixDialogTrigger Id="@(AsChild ? _childTriggerId ?? Id : Id)" Disabled="@Disabled" OnClick="@OnClick" OnActivate="@OnActivate"
    TriggerTemplate="@(AsChild ? SlottedTrigger : TriggerTemplate)"
    AdditionalAttributes="@TriggerAttributes" ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />

@code {
    [Parameter] public bool AsChild { get; set; }
    [Parameter] public RenderFragment<BradixTriggerContext>? TriggerTemplate { get; set; }
    [Parameter] public EventCallback<BradixActivationEventArgs> OnActivate { get; set; }
    [CascadingParameter(Name = nameof(ParentDialog))] public Dialog? ParentDialog { get; set; }
    [CascadingParameter] private OverlayLabelContext? Context { get; set; }
    [CascadingParameter(Name = SlotAttributes.Name)] private IReadOnlyDictionary<string, object>? SlotAttributeOverrides { get; set; }
    private QuarkAttributeDictionary _attributes;
    private string? _slotClass;
    private string? _slotStyle;
    private string? _childTriggerId;
    private void CaptureTriggerId(string? id) => _childTriggerId = id;
    private RenderFragment<BradixTriggerContext>? _slottedTrigger;
    private RenderFragment<BradixTriggerContext> SlottedTrigger => _slottedTrigger ??= trigger =>
        @<PrimitiveTriggerSlot Context="trigger" OnTriggerIdCaptured="CaptureTriggerId" ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dialog-trigger";
    }

    private IReadOnlyDictionary<string, object> TriggerAttributes
    {
        get
        {
            var attributes = _attributes.Create(BuildAttributes());
            SlotAttributes.MergeInto(attributes, SlotAttributeOverrides, ref _slotClass, ref _slotStyle);
            attributes.Remove("onclick");
            attributes.Remove("id");
            if (Context is not null) attributes["aria-controls"] = Context.ContentId;
            return attributes;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AsChild);
        hc.Add(_childTriggerId);
        hc.Add(Disabled);
        hc.Add(TriggerTemplate);
        hc.Add(OnActivate);
        hc.Add(SlotAttributeOverrides);
        hc.Add(Context?.ContentId);
    }
}
