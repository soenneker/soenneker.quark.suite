@using Soenneker.Blazor.Utils.Ids
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.TriggerElement

@if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <BradixDialogTrigger Disabled="@Disabled"
                         OnClick="@OnClick"
                         AdditionalAttributes="@TriggerAttributes">
        @ChildContent
    </BradixDialogTrigger>
}

@code {
    [CascadingParameter(Name = nameof(ParentDialog))]
    public Dialog? ParentDialog { get; set; }

    [CascadingParameter]
    private BradixDialog? BradixDialog { get; set; }

    [CascadingParameter]
    private OverlayLabelContext? Context { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    private QuarkAttributeDictionary _triggerAttributesBuffer;

    private IReadOnlyDictionary<string, object> TriggerAttributes => BuildTriggerAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dialog-trigger";

    }

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        Dictionary<string, object> attributes = _triggerAttributesBuffer.Create(BuildAttributes());

        attributes.Remove("type");
        attributes.Remove("id");
        attributes.Remove("onclick");

        return attributes;
    }

    private string? _triggerContentId;
    private string? _overlayTriggerId;
    private string? GetOverlayTriggerId(OverlayLabelContext? context)
    {
        string? contentId = context?.ContentId;
        if (_triggerContentId != contentId)
        {
            _triggerContentId = contentId;
            _overlayTriggerId = contentId is null ? null : BlazorIdGenerator.Child(contentId, "trigger");
        }
        return _overlayTriggerId;
    }

    private (bool, Dialog?, bool, BradixDialog?, string?)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<PointerEventArgs, Task>? _contextOnPointerDownEventCallback;
    private Action<ElementReference>? _contextRegisterElementCallback;
    private Func<Task>? _contextToggleCallback;
    private Func<Task>? _contextOpenCallback;
    private Func<Task>? _contextCloseCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (Disabled, ParentDialog, ParentDialog?.Visible == true, BradixDialog, Context?.ContentId);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = null,
            TriggerId = GetOverlayTriggerId(Context),
            ParentDisabled = Disabled,
            IsOpen = ParentDialog?.Visible == true,
            DataState = ParentDialog?.Visible == true ? "open" : "closed",
            AriaHasPopup = "dialog",
            AriaControls = Context?.ContentId,
            OnPointerDownEvent = ParentDialog is null || Disabled ? null : (_contextOnPointerDownEventCallback ??= HandleTriggerPointerDown),
            SuppressClickAfterPointerDown = true,
            RegisterElement = (_contextRegisterElementCallback ??= elementReference =>
            {
                if (BradixDialog is not null)
                    BradixDialog.RegisterTrigger(elementReference, GetOverlayTriggerId(Context));
            }),
            Toggle = ParentDialog is null
                ? null
                : (_contextToggleCallback ??= async () =>
                {
                    if (ParentDialog.Visible)
                    {
                        await ParentDialog.Hide();
                    }
                    else
                    {
                        await ParentDialog.Show();
                    }
                }),
            Open = ParentDialog is null ? null : (_contextOpenCallback ??= () => ParentDialog.Show()),
            Close = ParentDialog is null ? null : (_contextCloseCallback ??= () => ParentDialog.Hide())
        };
    }

    private Task HandleTriggerPointerDown(PointerEventArgs args)
    {
        if (ParentDialog is null || Disabled || args.Button != 0 || args.CtrlKey)
            return Task.CompletedTask;

        return ParentDialog.Visible ? ParentDialog.Hide() : ParentDialog.Show();
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AsChild);
        hc.Add(Disabled);
        hc.Add(ParentDialog);
        hc.Add(BradixDialog);
        hc.Add(Context);
        hc.Add(ParentDialog?.Visible ?? false);
        hc.Add(Context?.ContentId);
    }
}
