@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IDialogFooter

<div @attributes="BuildAttributes()">
    @ChildContent
    @if (ShowCloseButton)
    {
        <DialogClose AsChild="true">
            <Button Variant="ButtonVariant.Outline">Close</Button>
        </DialogClose>
    }
</div>

@code {
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<FlexDirectionBuilder> _defaultFlexDirection = Quark.FlexDirection.ColReverse;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is2;
    private string? _lastPrependedClass;

    /// <inheritdoc />
    [Parameter]
    public bool ShowCloseButton { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dialog-footer";
        Display ??= _defaultDisplay;
        FlexDirection ??= _defaultFlexDirection;
        Gap ??= _defaultGap;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        // shadcn DialogFooter - base ui/dialog.tsx
        PrependClassAttribute(attributes, "-mx-4 -mb-4 rounded-b-xl border-t bg-muted/50 p-4 sm:flex-row sm:justify-end", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShowCloseButton);
    }
}