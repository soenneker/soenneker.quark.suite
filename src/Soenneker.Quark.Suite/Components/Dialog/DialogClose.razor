@using Soenneker.Blazor.Extensions.EventCallback

@namespace Soenneker.Quark
@using Soenneker.Bradix
@using ButtonSizeType = Soenneker.Quark.ButtonSize
@inherits Soenneker.Quark.Element

@if (AsChild && AutoClose)
{
    <BradixDialogClose AsChild="true" AriaLabel="@((string?) null)" Disabled="@Disabled" OnClick="(_cachedHandleBradixCloseClickDelegate ??= HandleBradixCloseClick)">
        <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </BradixDialogClose>
}
else if (AsChild)
{
    <CascadingValue Name="TriggerContext" Value="GetTriggerContext()" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else if (AutoClose)
{
    <BradixDialogClose AsChild="true" AriaLabel="@((string?) null)" Disabled="@Disabled" OnClick="(_cachedHandleBradixCloseClickDelegate ??= HandleBradixCloseClick)">
        <Button Type="@ButtonType.Button"
                Variant="@Variant"
                ButtonSize="@ButtonSize"
                @attributes="BuildAttributes()">
            @ChildContent
        </Button>
    </BradixDialogClose>
}
else
{
    <Button Type="@ButtonType.Button"
            Variant="@Variant"
            ButtonSize="@ButtonSize"
            Disabled="@Disabled"
            OnClick="(_cachedHandleNonAutoCloseClickDelegate ??= HandleNonAutoCloseClick)"
            @attributes="BuildAttributes()">
        @ChildContent
    </Button>
}

@code {
    private static readonly CssValue<ButtonSizeBuilder> _staticCss0 = ButtonSizeType.Default;
    private System.Func<MouseEventArgs, Task>? _cachedHandleBradixCloseClickDelegate;
    private System.Func<MouseEventArgs, Task>? _cachedHandleNonAutoCloseClickDelegate;

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dialog-close";
    }

    [CascadingParameter(Name = nameof(ParentDialog))]
    public Dialog? ParentDialog { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    [Parameter]
    public bool AutoClose { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;

    [Parameter]
    public CssValue<ButtonSizeBuilder> ButtonSize { get; set; } = _staticCss0;

    private async Task HandleBradixCloseClick(MouseEventArgs _)
    {
        await OnClose.InvokeIfHasDelegate();
    }

    private async Task HandleNonAutoCloseClick(MouseEventArgs _)
    {
        await OnClose.InvokeIfHasDelegate();
    }

    private (bool, bool)? _contextSnapshotKey;
    private TriggerContext? _contextSnapshot;
    private Func<Task>? _contextOnClickCallback;

    private TriggerContext GetTriggerContext()
    {
        var key = (Disabled, AutoClose);
        if (_contextSnapshot is not null && _contextSnapshotKey == key)
            return _contextSnapshot;
        _contextSnapshotKey = key;
        return _contextSnapshot = new TriggerContext
        {
            DataSlot = null,
            ParentDisabled = Disabled,
            OnClick = AutoClose ? null : (_contextOnClickCallback ??= () => OnClose.InvokeIfHasDelegate())
        };
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AsChild);
        hc.Add(AutoClose);
        hc.Add(Disabled);
        hc.Add(Variant);
        hc.Add(ButtonSize);
    }
}
