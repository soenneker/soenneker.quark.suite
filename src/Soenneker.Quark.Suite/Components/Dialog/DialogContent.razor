@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.InteractiveElement
@implements IDialogContent

<BradixDialogPortal>
    @if (ParentDialog?.ShowBackdrop == true)
    {
        <BradixDialogOverlay AdditionalAttributes="@OverlayAttributes" />
    }

    <BradixDialogContent Id="@Context?.ContentId"
                         CloseOnEscapeKeyDown="@(ParentDialog?.CloseOnEscape ?? true)"
                         CloseOnPointerDownOutside="@ShouldCloseOnOutsideInteraction"
                         CloseOnFocusOutside="@ShouldCloseOnOutsideInteraction"
                         OnPointerDownOutside="(_cachedHandleBackdropPointerDownOutsideDelegate ??= HandleBackdropPointerDownOutside)"
                         AdditionalAttributes="@ContentAttributes">
        @ChildContent
        @if (ShowCloseButton)
        {
            <DialogCloseButton />
        }
    </BradixDialogContent>
</BradixDialogPortal>

@code {
    protected override void BuildDefaultClasses(ref PooledStringBuilder cls)
    {
        base.BuildDefaultClasses(ref cls);
        AppendClass(ref cls, "left-1/2 -translate-x-1/2 text-sm text-popover-foreground ring-1 ring-foreground/10 duration-100 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95");
        AppendClass(ref cls, Centered && (ParentDialog?.Centered ?? true) ? "top-1/2 -translate-y-1/2" : "top-4");
        if (ParentDialog?.Scrollable == true)
            AppendClass(ref cls, "max-h-[90dvh] overflow-y-auto overscroll-contain [scrollbar-gutter:stable] [scrollbar-width:thin] [scrollbar-color:color-mix(in_oklab,var(--muted-foreground)_38%,transparent)_transparent]");
        AppendClass(ref cls, ParentDialog?.DialogSize?.Value switch
        {
            "lg" => "sm:max-w-2xl",
            "xl" => "sm:max-w-4xl",
            _ => "sm:max-w-sm"
        });
        AppendClass(ref cls, ParentDialog?.DialogSize?.Value switch
        {
            "fullscreen" => "top-0! left-0! translate-none! h-dvh! max-h-dvh! w-full! max-w-none! rounded-none! content-start overflow-y-auto",
            "fullscreen-sm-down" => "max-sm:top-0! max-sm:left-0! max-sm:translate-none! max-sm:h-dvh! max-sm:max-h-dvh! max-sm:w-full! max-sm:max-w-none! max-sm:rounded-none! max-sm:content-start max-sm:overflow-y-auto",
            "fullscreen-md-down" => "max-md:top-0! max-md:left-0! max-md:translate-none! max-md:h-dvh! max-md:max-h-dvh! max-md:w-full! max-md:max-w-none! max-md:rounded-none! max-md:content-start max-md:overflow-y-auto",
            "fullscreen-lg-down" => "max-lg:top-0! max-lg:left-0! max-lg:translate-none! max-lg:h-dvh! max-lg:max-h-dvh! max-lg:w-full! max-lg:max-w-none! max-lg:rounded-none! max-lg:content-start max-lg:overflow-y-auto",
            "fullscreen-xl-down" => "max-xl:top-0! max-xl:left-0! max-xl:translate-none! max-xl:h-dvh! max-xl:max-h-dvh! max-xl:w-full! max-xl:max-w-none! max-xl:rounded-none! max-xl:content-start max-xl:overflow-y-auto",
            "fullscreen-xxl-down" => "max-2xl:top-0! max-2xl:left-0! max-2xl:translate-none! max-2xl:h-dvh! max-2xl:max-h-dvh! max-2xl:w-full! max-2xl:max-w-none! max-2xl:rounded-none! max-2xl:content-start max-2xl:overflow-y-auto",
            _ => string.Empty
        });
    }

    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Fixed;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Grid;
    private static readonly CssValue<ZIndexBuilder> _defaultZIndex = Quark.ZIndex.Is50;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is4;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Xl;
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Popover;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is4;
    private static readonly CssValue<OutlineStyleBuilder> _defaultOutlineStyle = Quark.OutlineStyle.Hidden;
    private Func<Task>? _cachedHandleBackdropPointerDownOutsideDelegate;

    private string? _lastBuiltClass2;

    private QuarkAttributeDictionary _overlayAttributesBuffer;
    [CascadingParameter(Name = nameof(ParentDialog))]
    public Dialog? ParentDialog { get; set; }

    [CascadingParameter]
    private OverlayLabelContext? Context { get; set; }

    [Parameter]
    public bool Centered { get; set; } = true;

    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    private bool ShouldCloseOnOutsideInteraction => ParentDialog?.DismissOnOutside == true;

    private IReadOnlyDictionary<string, object> ContentAttributes => BuildAttributes();

    private IReadOnlyDictionary<string, object> OverlayAttributes => BuildOverlayAttributes();

    private Task HandleBackdropPointerDownOutside()
    {
        return ParentDialog?.NotifyBackdropClick() ?? Task.CompletedTask;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "dialog-content";

        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        ZIndex ??= _defaultZIndex;
        MaxWidth ??= "max-w-[calc(100%-2rem)]";
        Width ??= _defaultWidth;
        Gap ??= _defaultGap;
        Rounded ??= _defaultRounded;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        OutlineStyle ??= _defaultOutlineStyle;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);



    }

    private Dictionary<string, object> BuildOverlayAttributes()
    {
        var attributes = _overlayAttributesBuffer.Create(4);

        {
            const string @class = "fixed inset-0 isolate z-50 bg-black/10 duration-100 supports-backdrop-filter:backdrop-blur-xs data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0";
            const string variant = @class + " " + "backdrop-blur";
            PrependClassAttribute(attributes, ParentDialog?.BlurBackdrop == true ? variant : @class, ref _lastBuiltClass2);
        }

        attributes["data-slot"] = "dialog-overlay";
        attributes["data-state"] = ParentDialog?.Visible == true ? "open" : "closed";
        attributes["aria-hidden"] = "true";
        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShowCloseButton);
        hc.Add(Centered);
        hc.Add(ParentDialog?.Visible ?? false);
        hc.Add(ParentDialog?.ShowBackdrop ?? true);
        hc.Add(ParentDialog?.BlurBackdrop ?? false);
        hc.Add(ParentDialog?.Centered ?? false);
        hc.Add(ParentDialog?.Scrollable ?? false);
        hc.Add(ParentDialog?.DialogSize);
        hc.Add(ParentDialog?.Static ?? false);
        hc.Add(ParentDialog?.TrapFocus ?? true);
        hc.Add(ParentDialog?.CloseOnEscape ?? true);
        hc.Add(ParentDialog?.CloseOnBackdropClick ?? true);
        hc.Add(Context?.ContentId);
    }
}
