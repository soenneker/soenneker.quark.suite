@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.DialogOverlayElement
@implements IDialog

<BradixDialog Open="@Visible"
              OpenChanged="(_cachedHandleOpenChangedDelegate ??= HandleOpenChanged)"
              Modal="@TrapFocus">
    <CascadingValue Name="ParentDialog" Value="@this">
        <CascadingValue Value="_context" IsFixed="true"
                        ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />
    </CascadingValue>
</BradixDialog>

@code {
    private Func<bool, Task>? _cachedHandleOpenChangedDelegate;

    public Dialog() : base("dialog") { }

    [Parameter]
    public bool Centered { get; set; } = true;

    [Parameter]
    public bool Scrollable { get; set; } = true;

    [Parameter]
    public DialogSize? DialogSize { get; set; }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Centered);
        hc.Add(Scrollable);
        hc.Add(DialogSize);
    }

}
