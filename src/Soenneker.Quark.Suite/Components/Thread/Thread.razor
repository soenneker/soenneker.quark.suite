@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IThreadsInterop ThreadsInterop

<CascadingValue Value="this" IsFixed="false">
    <div @ref="ElementRef" @attributes="BuildAttributes()">@ChildContent</div>
</CascadingValue>

@code {
    private DotNetObjectReference<Thread>? _dotNetRef;
    private bool _initialized;
    private ValueAtomicBool _disposed;

    internal bool IsAtBottom { get; private set; } = true;

    [Parameter]
    public string Initial { get; set; } = "smooth";

    [Parameter]
    public string ResizeBehavior { get; set; } = "smooth";

    [Parameter]
    public bool StickToBottom { get; set; } = true;

    internal async Task ScrollToBottom()
    {
        await ThreadsInterop.ScrollToBottom(ElementRef, Initial);
    }

    [JSInvokable]
    public void SetIsAtBottom(bool isAtBottom)
    {
        if (_disposed.Read() || IsAtBottom == isAtBottom)
            return;

        IsAtBottom = isAtBottom;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "thread";
        Position ??= Quark.Position.Relative;
        Width ??= Quark.Width.IsFull;
        Height ??= Quark.Height.IsFull;
        OverflowY ??= Quark.Overflow.Y.Auto;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-at-bottom"] = IsAtBottom ? "true" : "false";
        attributes["data-stick-to-bottom"] = StickToBottom ? "true" : "false";

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_disposed.Read() || !firstRender || _initialized)
            return;

        _initialized = true;
        _dotNetRef = DotNetObjectReference.Create(this);
        await ThreadsInterop.InitializeThread(ElementRef, _dotNetRef, Initial, ResizeBehavior, StickToBottom);
        if (_disposed.Read())
            await ThreadsInterop.Destroy(ElementRef);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Initial);
        hc.Add(ResizeBehavior);
        hc.Add(StickToBottom);
        hc.Add(IsAtBottom);
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_initialized)
                await ThreadsInterop.Destroy(ElementRef);
        }
        finally
        {
            _dotNetRef?.Dispose();
            _dotNetRef = null;
            await base.DisposeAsync();
        }
    }
}
