@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element
@implements IAsyncDisposable
@implements IThread
@using Microsoft.JSInterop
@using Soenneker.Asyncs.Locks
@inject IThreadsInterop ThreadsInterop

<CascadingValue Value="this" IsFixed="false">
    <div @ref="ElementRef" @attributes="BuildAttributes()">
        @if (Virtualize)
        {
            <VirtualItems @ref="_virtualItems" ParentScroll="true" ItemKeys="@ItemKeys" ItemTemplate="@ItemTemplate"
                          FollowEnd="@StickToBottom" HasBefore="@HasOlderItems" LoadBefore="@LoadOlder" AtEndChanged="SetIsAtBottom" />
        }
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public bool Virtualize { get; set; }
    [Parameter] public IReadOnlyList<string> ItemKeys { get; set; } = [];
    [Parameter] public RenderFragment<int>? ItemTemplate { get; set; }
    [Parameter] public bool HasOlderItems { get; set; }
    [Parameter] public EventCallback LoadOlder { get; set; }
    private VirtualItems? _virtualItems;

    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<HeightBuilder> _defaultHeight = Quark.Height.IsFull;
    private static readonly CssValue<OverflowBuilder> _defaultOverflowY = Quark.Overflow.Y.Auto;
    private DotNetObjectReference<Thread>? _dotNetRef;
    private ValueAtomicBool _initialized;
    private readonly AsyncLock _interopLock = new();
    private (string Initial, string Resize, bool Stick)? _configuration;
    private ValueAtomicBool _disposed;

    internal bool IsAtBottom { get; private set; } = true;

    [Parameter]
    public string Initial { get; set; } = "smooth";

    [Parameter]
    public string ResizeBehavior { get; set; } = "smooth";

    [Parameter]
    public bool StickToBottom { get; set; } = true;

    internal Task ScrollToBottom() => Virtualize && _virtualItems is not null ? _virtualItems.JumpToEnd().AsTask() : ThreadsInterop.ScrollToBottom(ElementRef, Initial).AsTask();

    [JSInvokable]
    public void SetIsAtBottom(bool isAtBottom)
    {
        if (_disposed.Read() || IsAtBottom == isAtBottom)
            return;

        IsAtBottom = isAtBottom;
        _ = RequestRender();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "thread";
        Position ??= _defaultPosition;
        Width ??= _defaultWidth;
        Height ??= _defaultHeight;
        OverflowY ??= _defaultOverflowY;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        attributes["data-at-bottom"] = IsAtBottom ? "true" : "false";
        attributes["data-stick-to-bottom"] = StickToBottom ? "true" : "false";

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (Virtualize)
        {
            if (_initialized.Value) { await ThreadsInterop.Destroy(ElementRef); _initialized.Value = false; _configuration = null; }
            return;
        }
        var configuration = (Initial, ResizeBehavior, StickToBottom);
        if (_disposed.Read() || _configuration == configuration)
            return;

        using (await _interopLock.Lock())
        {
            if (_disposed.Read() || _configuration == configuration)
                return;

            _dotNetRef ??= DotNetObjectReference.Create(this);
            await ThreadsInterop.InitializeThread(ElementRef, _dotNetRef, configuration.Initial, configuration.ResizeBehavior, configuration.StickToBottom);
            _configuration = configuration;
            _initialized.Value = true;
        }
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Virtualize); hc.Add(ItemKeys); hc.Add(ItemTemplate); hc.Add(HasOlderItems);
        hc.Add(Initial);
        hc.Add(ResizeBehavior);
        hc.Add(StickToBottom);
        hc.Add(IsAtBottom);
    }

    public override async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            using (await _interopLock.Lock())
            {
                if (_initialized.Value)
                    await ThreadsInterop.Destroy(ElementRef);
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
        finally
        {
            _dotNetRef?.Dispose();
            _dotNetRef = null;
            await base.DisposeAsync();
        }
    }
}
