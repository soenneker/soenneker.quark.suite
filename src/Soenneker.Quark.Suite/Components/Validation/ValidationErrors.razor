@namespace Soenneker.Quark
@inherits Element

@if (ShowErrorMessages && _visible && _status == ValidationStatus.Error && (_messages?.Count > 0))
{
    <div @attributes="BuildAttributes()" >
        @foreach (var message in _messages!)
        {
            <div>@message</div>
        }
    </div>
}

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<WidthBuilder> _defaultWidth = Quark.Width.IsFull;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Lg;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.Is1;
    private static readonly CssValue<BorderColorBuilder> _defaultBorderColor = Quark.BorderColor.Token("destructive/30");
    private static readonly CssValue<BackgroundColorBuilder> _defaultBackgroundColor = Quark.BackgroundColor.Token("destructive/10");
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.Is4;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.Destructive;
    [CascadingParameter(Name = nameof(ParentValidations))]
    public Validations? ParentValidations { get; set; }

    /// <summary>
    /// Gets or sets whether to show validation error messages.
    /// </summary>
    [Parameter]
    public bool ShowErrorMessages { get; set; } = true;

    private bool _visible;
    private ValidationStatus _status = ValidationStatus.None;
    private IReadOnlyCollection<string>? _messages;

    protected override void OnInitialized()
    {
        if (ParentValidations is not null)
        {
            ParentValidations._statusChanged += OnStatusChanged;
            ParentValidations.ClearingAll += OnClearingAll;
        }
    }

    private void OnStatusChanged(ValidationsStatusChangedEventArgs args)
    {
        _status = args.Status;
        _messages = args.Messages;
        _visible = args.Status != ValidationStatus.None;
        _ = RefreshOffThread();
    }

    private void OnClearingAll()
    {
        _visible = false;
        _status = ValidationStatus.None;
        _messages = null;
        _ = RefreshOffThread();
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "validation-errors";

        Position ??= _defaultPosition;
        Width ??= _defaultWidth;
        Rounded ??= _defaultRounded;
        Border ??= _defaultBorder;
        BorderColor ??= _defaultBorderColor;
        BackgroundColor ??= _defaultBackgroundColor;
        Padding ??= _defaultPadding;
        TextColor ??= _defaultTextColor;
    }

    // shadcn alert destructive variant - new-york-v4 ui/alert.tsx + form error block
    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes.TryAdd("role", "alert");
    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();

        if (ParentValidations is not null)
        {
            ParentValidations._statusChanged -= OnStatusChanged;
            ParentValidations.ClearingAll -= OnClearingAll;
        }
        }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(ShowErrorMessages);
        hc.Add(_visible);
        hc.Add(_status);
        if (_messages is not null)
            hc.Add(_messages.Count);
    }
}
