@using Soenneker.Atomics.ValueBools
@using System.Text.RegularExpressions
@using System.Linq.Expressions
@using System.Threading
@using Microsoft.AspNetCore.Components.Forms

@namespace Soenneker.Quark

<CascadingValue Name="ParentValidation" Value="@this" IsFixed>
    @ChildContent
</CascadingValue>

@implements IValidation

@code {
    private Func<Task>? _noneStatusCallback;
    private Func<Task>? _successStatusCallback;
    private Func<Task>? _errorStatusCallback;
    private Action? _refreshCallback;
    private Task NotifyNoneStatus() => StatusChanged.InvokeAsync(ValidationStatus.None);
    private Task NotifySuccessStatus() => StatusChanged.InvokeAsync(ValidationStatus.Success);
    private Task NotifyErrorStatus() => StatusChanged.InvokeAsync(ValidationStatus.Error);
    private Func<Task> GetStatusCallback(ValidationStatus status)
    {
        if (ReferenceEquals(status, ValidationStatus.None)) return _noneStatusCallback ??= NotifyNoneStatus;
        if (ReferenceEquals(status, ValidationStatus.Success)) return _successStatusCallback ??= NotifySuccessStatus;
        if (ReferenceEquals(status, ValidationStatus.Error)) return _errorStatusCallback ??= NotifyErrorStatus;
        return () => StatusChanged.InvokeAsync(status);
    }

    private IValidationInput? _input;
    private object? _lastKnownValue;
    private string? _patternString;
    private bool _hasPattern;
    private bool _hasInputPattern;
    private ValueAtomicBool _initialized;
    private FieldIdentifier _fieldIdentifier;
    private bool _hasFieldIdentifier;
    private CancellationTokenSource? _cts;
    private ValueAtomicBool _disposed;
    private EditContext? _messageEditContext;
    private ValidationMessageStore? _messageStore;
    private Validations? _registeredValidations;

    /// <summary>
    /// Gets or sets the parent validations context.
    /// </summary>
    [CascadingParameter(Name = nameof(ParentValidations))]
    public Validations? ParentValidations { get; set; }

    /// <summary>
    /// Gets or sets the edit context for form validation.
    /// </summary>
    [CascadingParameter(Name = nameof(EditContext))]
    public EditContext? EditContext { get; set; }

    [CascadingParameter]
    private FieldContext? CurrentFieldContext { get; set; }

    /// <summary>
    /// Gets or sets the current validation status.
    /// </summary>
    [Parameter]
    public ValidationStatus Status { get; set; } = ValidationStatus.None;

    /// <summary>
    /// Gets or sets the callback invoked When the validation status changes.
    /// </summary>
    [Parameter]
    public EventCallback<ValidationStatus> StatusChanged { get; set; }

    /// <summary>
    /// Gets or sets the validator to use for validation.
    /// </summary>
    [Parameter]
    public IQuarkValidator? Validator { get; set; }

    /// <summary>
    /// Gets or sets the action to execute for validation.
    /// </summary>
    [Parameter]
    public Action<ValidatorEventArgs>? Action { get; set; }

    /// <summary>
    /// Gets or sets the async function to execute for validation.
    /// </summary>
    [Parameter]
    public Func<ValidatorEventArgs, CancellationToken, Task>? AsyncFunc { get; set; }

    /// <summary>
    /// Gets or sets the message localizer function.
    /// </summary>
    [Parameter]
    public Func<string, IEnumerable<string>, string>? MessageLocalizer { get; set; }

    /// <summary>
    /// Gets or sets whether to use pattern-based validation.
    /// </summary>
    [Parameter]
    public bool UsePattern { get; set; }

    /// <summary>
    /// Gets or sets the regex pattern string for validation.
    /// </summary>
    [Parameter]
    public string? PatternString { get; set; }

    /// <summary>
    /// Gets or sets the error message to display When pattern validation fails.
    /// </summary>
    [Parameter]
    public string? PatternMessage { get; set; }

    /// <summary>
    /// Gets or sets the handler type for validation.
    /// </summary>
    [Parameter]
    public Type? HandlerType { get; set; }

    /// <summary>
    /// Gets or sets the child content to be validated.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets the collection of validation error messages.
    /// </summary>
    public IEnumerable<string>? Messages { get; private set; }

    /// <summary>
    /// Gets the field identifier for form validation.
    /// </summary>
    public FieldIdentifier FieldIdentifier => _fieldIdentifier;

    /// <summary>
    /// Gets the compiled regex pattern for validation.
    /// </summary>
    public Regex? Pattern { get; private set; }

    /// <summary>
    /// Gets or sets whether to show validation errors immediately on input.
    /// </summary>
    [Parameter]
    public bool ShowErrorsOnInput { get; set; }

    private bool _explicitlyValidated;
    private bool _touched;

    public bool ShouldShowInvalid => Status == ValidationStatus.Error && (ShowErrorsOnInput || _explicitlyValidated || _touched);

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (!ReferenceEquals(_registeredValidations, ParentValidations))
        {
            if (_registeredValidations is not null)
            {
                _registeredValidations.ClearingAll -= OnClearingAll;
                _registeredValidations.NotifyValidationRemoved(this);
            }
            _registeredValidations = ParentValidations;
            if (_registeredValidations is not null)
            {
                _registeredValidations.ClearingAll += OnClearingAll;
                _registeredValidations.NotifyValidationInitialized(this);
            }
        }

        if (PatternString.HasContent())
        {
            await InitializeInputPattern(PatternString, string.Empty);
        }
    }

    public void Dispose()
    {
        if (!_disposed.TrySetTrue())
            return;
        ClearDataAnnotationMessages();
        CurrentFieldContext?.SetValidationInvalid(false);

        if (_registeredValidations is not null)
        {
            _registeredValidations.ClearingAll -= OnClearingAll;
            _registeredValidations.NotifyValidationRemoved(this);
        }

        var pending = _cts;
        _cts = null;
        pending?.Cancel();
        pending?.Dispose();
    }

    public async Task InitializeInput(IValidationInput input)
    {
        _input = input;
        _lastKnownValue = input.ValidationValue;

        if ((ParentValidations?.Mode ?? ValidationMode.Auto) == ValidationMode.Auto && (ParentValidations?.ValidateOnLoad ?? false))
        {
            await ValidateValue(input.ValidationValue!);
        }

        if (ReferenceEquals(_input, input))
            _initialized.Value = true;
    }

    internal void UnregisterInput(IValidationInput input)
    {
        if (!ReferenceEquals(_input, input))
            return;
        _input = null;
        _lastKnownValue = null;
        _initialized.Value = false;
        _hasFieldIdentifier = false;
        ClearInputPattern();
        Clear();
    }

    public async Task InitializeInputPattern<T>(string pattern, T value, bool enablePatternValidation = false)
    {
        _lastKnownValue = value;

        if (pattern.HasContent())
        {
            _hasInputPattern = _hasInputPattern || enablePatternValidation;

            if (!_hasPattern || _patternString != pattern)
            {
                _patternString = pattern;
                Pattern = new Regex(pattern);

                if (_hasPattern && (ParentValidations?.Mode ?? ValidationMode.Auto) == ValidationMode.Auto && (ParentValidations?.ValidateOnLoad ?? false) &&
                    _initialized.Value)
                {
                    await NotifyInputChanged(value, true);
                }
            }

            _hasPattern = true;
        }
    }

    public void ClearInputPattern()
    {
        _hasInputPattern = false;

        if (PatternString.HasContent())
        {
            if (Pattern is null || _patternString != PatternString)
                Pattern = new Regex(PatternString);
            _patternString = PatternString;
            _hasPattern = true;
        }
        else
        {
            _hasPattern = false;
            _patternString = null;
            Pattern = null;
        }
    }

    public async Task InitializeInputExpression<T>(Expression<Func<T>> expression)
    {
        if ((ParentValidations is not null || EditContext is not null) && expression is not null)
        {
            var fieldIdentifier = FieldIdentifier.Create(expression);
            if (!_hasFieldIdentifier || !fieldIdentifier.Equals(_fieldIdentifier))
            {
                ClearDataAnnotationMessages();
                _fieldIdentifier = fieldIdentifier;
                _lastKnownValue = expression.Compile(preferInterpretation: true)
                    .Invoke();

                if (_hasFieldIdentifier && (ParentValidations?.Mode ?? ValidationMode.Auto) == ValidationMode.Auto &&
                    (ParentValidations?.ValidateOnLoad ?? false) && _initialized.Value)
                {
                    await NotifyInputChanged(_lastKnownValue, true);
                }

                _hasFieldIdentifier = true;
            }
        }
        else
        {
            ClearDataAnnotationMessages();
            _hasFieldIdentifier = false;
        }
    }

    public Task NotifyInputChanged<T>(T newValue, bool overrideNewValue = false)
    {
        var newValidationValue = overrideNewValue || _input is null ? newValue : _input.ValidationValue;
        _lastKnownValue = newValidationValue;

        if (EditContext is not null && _hasFieldIdentifier)
        {
            EditContext.NotifyFieldChanged(_fieldIdentifier);
        }

        var mode = ParentValidations?.Mode ?? ValidationMode.Auto;

        if (mode == ValidationMode.Auto || _explicitlyValidated)
        {
            return ValidateValueCore(newValidationValue!, explicitlyValidated: false);
        }

        return Task.CompletedTask;
    }

    private void OnClearingAll()
    {
        Clear();
    }

    public ValidationStatus Validate()
    {
        var value = _input?.ValidationValue ?? _lastKnownValue ?? string.Empty;
        MarkExplicitlyValidated();
        return Validate(value);
    }

    public ValidationStatus Validate(object newValidationValue)
    {
        MarkExplicitlyValidated();
        _cts?.Cancel();
        if (!_disposed.Read() && _input is not null && !_input.Disabled)
        {
            GetValidationHandler()?.Validate(this, newValidationValue);
        }

        return Status;
    }

    public Task<ValidationStatus> ValidateCurrent()
    {
        var value = _input?.ValidationValue ?? _lastKnownValue ?? string.Empty;
        return ValidateValue(value);
    }

    public Task<ValidationStatus> ValidateValue(object newValidationValue) => ValidateValueCore(newValidationValue, explicitlyValidated: true);

    private async Task<ValidationStatus> ValidateValueCore(object newValidationValue, bool explicitlyValidated)
    {
        if (_disposed.Read() || _input is null || _input.Disabled)
            return Status;

        if (explicitlyValidated)
            MarkExplicitlyValidated();
        var handler = GetValidationHandler();
        // Arbitrary IValidator implementations may override async behavior. Only known
        // synchronous handlers/actions or explicitly synchronous validators bypass cancellation infrastructure.
        if (_cts is null && (handler is PatternValidationHandler or DataAnnotationValidationHandler ||
                             handler is ValidatorHandler && (Validator?.IsSynchronous == true || Validator is null && AsyncFunc is null)))
        {
            handler.Validate(this, newValidationValue);
            return Status;
        }
        var source = new CancellationTokenSource();
        var token = source.Token;
        var previous = _cts;
        _cts = source;
        try
        {
            if (previous is not null)
                await previous.CancelAsync();

            token.ThrowIfCancellationRequested();
            if (handler is not null)
                await handler.Validate(this, newValidationValue, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_cts, source))
                _cts = null;
            source.Dispose();
        }

        return Status;
    }

    private List<System.ComponentModel.DataAnnotations.ValidationResult>? _annotationResults;
    internal List<System.ComponentModel.DataAnnotations.ValidationResult> GetAnnotationResults()
    {
        _annotationResults ??= [];
        _annotationResults.Clear();
        return _annotationResults;
    }

    internal ValidationMessageStore GetDataAnnotationMessageStore()
    {
        if (!ReferenceEquals(_messageEditContext, EditContext))
        {
            ClearDataAnnotationMessages();
            _messageEditContext = EditContext;
            _messageStore = EditContext is null ? null : new ValidationMessageStore(EditContext);
        }

        _messageStore!.Clear();
        return _messageStore;
    }

    private void ClearDataAnnotationMessages()
    {
        if (_messageStore is null)
            return;

        _messageStore.Clear();
        _messageEditContext?.NotifyValidationStateChanged();
    }

    private IValidationHandler? GetValidationHandler()
    {
        var type = DetermineHandlerType();
        return type is not null ? ValidationHandlerFactory.Create(type) : null;
    }

    private Type? DetermineHandlerType()
    {
        if (HandlerType is null)
        {
            if (Validator is not null || Action is not null || AsyncFunc is not null)
                return ValidationHandlerType.Validator;

            if ((UsePattern || _hasInputPattern) && _hasPattern)
                return ValidationHandlerType.Pattern;

            if (EditContext is not null && _hasFieldIdentifier)
                return ParentValidations?.HandlerType ?? ValidationHandlerType.DataAnnotation;

            throw new InvalidOperationException("Unable to determine the validator type.");
        }

        return HandlerType;
    }

    public void Clear()
    {
        _cts?.Cancel();
        _explicitlyValidated = false;
        _touched = false;
        ClearDataAnnotationMessages();
        NotifyValidationStatusChanged(ValidationStatus.None);
    }

    public void NotifyValidationStarted()
    {
        ValidationStarted?.Invoke();
    }

    public void NotifyValidationStatusChanged(ValidationStatus status, IEnumerable<string>? messages = null)
    {
        if (_disposed.Read())
            return;

        var shouldShowInvalidBefore = ShouldShowInvalid;

        if (Status != status || !(Messages ?? []).SequenceEqual(messages ?? []))
        {
            Status = status;
            Messages = messages;
            SyncFieldInvalidState();

            ValidationStatusChanged?.Invoke(this, new ValidationStatusChangedEventArgs(status, messages));
            InvokeAsync(_refreshCallback ??= StateHasChanged);
            InvokeAsync(GetStatusCallback(status));
            ParentValidations?.NotifyValidationStatusChanged(this);
        }
        else
        {
            // If visual gating changed (e.g., became touched), still notify listeners to refresh UI
            var shouldShowInvalidAfter = ShouldShowInvalid;

            if (shouldShowInvalidBefore != shouldShowInvalidAfter)
            {
                SyncFieldInvalidState();
                ValidationStatusChanged?.Invoke(this, new ValidationStatusChangedEventArgs(status, messages));
                InvokeAsync(_refreshCallback ??= StateHasChanged);
                ParentValidations?.NotifyValidationStatusChanged(this);
            }
        }
    }

    public void MarkTouched()
    {
        if ((ParentValidations?.GateErrorsUntilValidate ?? false) && !_explicitlyValidated)
        {
            return;
        }

        if (!_touched)
        {
            _touched = true;
            SyncFieldInvalidState();
            // Broadcast to update UI with same status but new gating
            ValidationStatusChanged?.Invoke(this, new ValidationStatusChangedEventArgs(Status, Messages));
            InvokeAsync(_refreshCallback ??= StateHasChanged);
        }
    }

    private void MarkExplicitlyValidated()
    {
        if (_explicitlyValidated)
            return;
        var wasVisible = ShouldShowInvalid;
        _explicitlyValidated = true;
        if (wasVisible != ShouldShowInvalid)
        {
            SyncFieldInvalidState();
            ValidationStatusChanged?.Invoke(this, new ValidationStatusChangedEventArgs(Status, Messages));
            InvokeAsync(_refreshCallback ??= StateHasChanged);
        }
    }

    private void SyncFieldInvalidState()
    {
        CurrentFieldContext?.SetValidationInvalid(ShouldShowInvalid);
    }

    public event Action? ValidationStarted;
    public event EventHandler<ValidationStatusChangedEventArgs>? ValidationStatusChanged;
}
