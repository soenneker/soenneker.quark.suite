@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

@if (AsChild)
{
    <CascadingValue Name="@SlotAttributes.Name" Value="BuildLinkAttributes()" IsFixed="false"
                    ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />
}
else if (Href.HasContent())
{
    <Anchor Href="@Href" @attributes="BuildLinkAttributes()"
            ChildContent="@(ChildContent ?? QuarkRenderFragments.Empty)" />
}
else
{
    <a @attributes="BuildLinkAttributes()">
        @ChildContent
    </a>
}

@code {
    private string? _lastPrependedClass;

    private QuarkAttributeDictionary _linkAttributesBuffer;
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    private Dictionary<string, object> BuildLinkAttributes()
    {
        var attributes = _linkAttributesBuffer.Create(BuildAttributes(), 1);
        attributes.TryAdd("data-slot", "breadcrumb-link");

        PrependClassAttribute(attributes, "transition-colors hover:text-foreground", ref _lastPrependedClass);

        return attributes;
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Href);
        hc.Add(AsChild);
    }
}
