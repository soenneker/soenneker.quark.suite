@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<CollapsibleContent Attributes="@BuildAttributes()">
    <Div Class="@MarkdownClass">@ChildContent</Div>
</CollapsibleContent>

@code {
    private static readonly CssValue<MarginBuilder> _defaultMargin = Quark.Margin.FromTop.Is2.FromLeft.Is2;
    private static readonly CssValue<OverflowBuilder> _defaultOverflow = Quark.Overflow.Hidden;
    private static readonly CssValue<BorderBuilder> _defaultBorder = Quark.Border.FromLeft.Default;
    private static readonly CssValue<PaddingBuilder> _defaultPadding = Quark.Padding.FromLeft.Is3;
    private string? _lastBuiltClass;

    private string MarkdownClass => "prose max-w-none text-sm leading-6 font-normal text-muted-foreground [&_p]:mb-2.5 prose-strong:font-medium prose-strong:text-foreground prose-ol:my-0 prose-ol:pl-3 prose-ul:my-0 prose-li:my-[-0.5px] [&>*:first-child]:mt-0 [&>*:last-child]:mb-0";

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "reasoning-content";

        Margin ??= _defaultMargin;
        Overflow ??= _defaultOverflow;
        Border ??= _defaultBorder;
        Padding ??= _defaultPadding;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        {
            const string @class = "data-[state=closed]:animate-collapsible-up data-[state=open]:animate-collapsible-down";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }
}
