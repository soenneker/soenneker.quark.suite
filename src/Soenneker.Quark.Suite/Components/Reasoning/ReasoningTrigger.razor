@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<CollapsibleTrigger Attributes="@BuildTriggerAttributes()">
    <Icon Name="LucideIcon.Brain" Size="_renderCss0" aria-hidden="true" />
    <Span TextSize="_renderCss1" Leading="_renderCss2" Class="@LabelClass">@(ChildContent ?? DefaultLabel)</Span>
    <Icon Name="LucideIcon.ChevronDown"
          Margin="_renderCss3"
          Size="_renderCss0"
          Opacity='_staticCss0'
          Class="group-data-[state=open]:rotate-180"
          Rotate="_chevronRotate"
          Transition="_renderCss4"
          aria-hidden="true" />
</CollapsibleTrigger>

@code {
    private static readonly CssValue<RotateBuilder> _chevronRotate = Rotate.Is180.Modifier("group-data-[state=open]");
    private static readonly CssValue<OpacityBuilder> _staticCss0 = CssValue<OpacityBuilder>.For(Quark.Opacity.Is0, Quark.Opacity.Is100.OnGroupHover, Quark.Opacity.Is100.Modifier("group-data-[state=open]").Modifier("group-data-[streaming=false]"));
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<CursorBuilder> _defaultCursor = Quark.Cursor.Pointer;
    private static readonly CssValue<ItemsBuilder> _defaultItemsAlign = Items.Center;
    private static readonly CssValue<GapBuilder> _defaultGap = Quark.Gap.Is1_25;
    private static readonly CssValue<TextColorBuilder> _defaultTextColor = Quark.TextColor.MutedForeground;
    private static readonly CssValue<TransitionBuilder> _defaultTransition = Quark.Transition.Colors;
    private static readonly CssValue<SizeBuilder> _renderCss0 = Quark.Size.Is4;
    private static readonly CssValue<TextSizeBuilder> _renderCss1 = Quark.TextSize.Sm;
    private static readonly CssValue<LeadingBuilder> _renderCss2 = Quark.Leading.Is6;
    private static readonly CssValue<MarginBuilder> _renderCss3 = Quark.Margin.FromLeft.Is0_5;
    private static readonly CssValue<TransitionBuilder> _renderCss4 = Quark.Transition.All;
    private string? _lastBuiltClass;

    [CascadingParameter]
    private ReasoningContext? ReasoningContext { get; set; }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "reasoning-trigger";

        Display ??= _defaultDisplay;
        Cursor ??= _defaultCursor;
        ItemsAlign ??= _defaultItemsAlign;
        Gap ??= _defaultGap;
        TextColor ??= _defaultTextColor;
        Transition ??= _defaultTransition;
    }

    private string LabelClass => "group-data-[streaming=true]:shimmer group-data-[streaming=true]:shimmer-repeat-delay-0 group-data-[streaming=true]:shimmer-spread-50 group-data-[streaming=true]:not-dark:shimmer-invert";

    private RenderFragment? _defaultLabel;

    private RenderFragment DefaultLabel => _defaultLabel ??= builder => builder.AddContent(0, ReasoningContext?.Label ?? "Thinking...");

    private IReadOnlyDictionary<string, object> BuildTriggerAttributes()
    {
        var attributes = BuildAttributes();
        attributes["data-streaming"] = ReasoningContext?.IsStreaming == true ? "true" : "false";
        return attributes;
    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);
        {
            const string @class = "group hover:text-foreground";
            PrependClassAttribute(attributes, @class, ref _lastBuiltClass);
        }
    }
}
