@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.Element

<BradixAvatar AdditionalAttributes="@AvatarAttributes">
    @ChildContent
</BradixAvatar>

@code {
    private static readonly CssValue<PositionBuilder> _defaultPosition = Quark.Position.Relative;
    private static readonly CssValue<DisplayBuilder> _defaultDisplay = Quark.Display.Flex;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.Is8;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<ShrinkBuilder> _defaultShrink = Quark.Shrink.Is0;
    private static readonly CssValue<UserSelectBuilder> _defaultUserSelect = Quark.UserSelect.None;
    private string? _lastPrependedClass;


    /// <summary>
    /// Size token aligned with shadcn avatar sizing.
    /// Supported values: default, sm, lg.
    /// </summary>
    [Parameter]
    public string AvatarSize { get; set; } = "default";

    private IReadOnlyDictionary<string, object> AvatarAttributes => BuildAttributes();

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "avatar";
        Position ??= _defaultPosition;
        Display ??= _defaultDisplay;
        Size ??= _defaultSize;
        Rounded ??= _defaultRounded;
        Shrink ??= _defaultShrink;
        UserSelect ??= _defaultUserSelect;

    }

    protected override void BuildAttributesCore(Dictionary<string, object> attributes)
    {
        base.BuildAttributesCore(attributes);

        attributes["data-size"] = AvatarSize;

        PrependClassAttribute(attributes, "group/avatar data-[size=lg]:size-10 data-[size=sm]:size-6 after:absolute after:inset-0 after:rounded-full after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten", ref _lastPrependedClass);
    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(AvatarSize);
    }

}