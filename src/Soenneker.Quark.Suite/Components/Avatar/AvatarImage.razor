@using Soenneker.Bradix

@namespace Soenneker.Quark
@inherits Soenneker.Quark.MediaElement

<BradixAvatarImage Src="@Src"
                   Alt="@ResolvedAlt"
                   AdditionalAttributes="@ImageAttributes" />

@code {
    private static readonly CssValue<AspectRatioBuilder> _defaultAspectRatio = Quark.AspectRatio.R1X1;
    private static readonly CssValue<SizeBuilder> _defaultSize = Quark.Size.IsFull;
    private static readonly CssValue<RoundedBuilder> _defaultRounded = Quark.Rounded.Full;
    private static readonly CssValue<ObjectFitBuilder> _defaultObjectFit = Quark.ObjectFit.Cover;
    [Parameter]
    public string? Src { get; set; }

    private QuarkAttributeDictionary _imageAttributesBuffer;

    private string ResolvedAlt => Alt ?? string.Empty;
    private IReadOnlyDictionary<string, object> ImageAttributes => BuildImageAttributes();

    private IReadOnlyDictionary<string, object> BuildImageAttributes()
    {
        Dictionary<string, object> attributes = _imageAttributesBuffer.Create(BuildAttributes());
        attributes.Remove("src");
        attributes.Remove("alt");
        attributes.Remove("onload");
        attributes.Remove("onerror");
        return attributes;
    }

    protected override void ApplyDefaultParameters()
    {
        base.ApplyDefaultParameters();
        DataSlot ??= "avatar-image";
        AspectRatio ??= _defaultAspectRatio;
        Size ??= _defaultSize;
        Rounded ??= _defaultRounded;
        ObjectFit ??= _defaultObjectFit;

    }

    protected override void ComputeRenderKeyCore(ref HashCode hc)
    {
        base.ComputeRenderKeyCore(ref hc);
        hc.Add(Src);
    }
}
