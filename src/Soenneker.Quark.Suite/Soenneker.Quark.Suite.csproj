<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <QuarkValidationGeneratorVersion Condition="'$(QuarkValidationGeneratorVersion)' == ''">4.0.1</QuarkValidationGeneratorVersion>
        <EnumValuesInlining>NoInlining</EnumValuesInlining>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <RootNamespace>Soenneker.Quark</RootNamespace>
        <GenerateDefaultNamespace>false</GenerateDefaultNamespace>
        <NoWarn>$(NoWarn);1591;IDE0130</NoWarn>
        <LangVersion>latest</LangVersion>
        <LucideIncludeSvgProvider>false</LucideIncludeSvgProvider>
        <LucideIncludeServiceCollectionExtensions>false</LucideIncludeServiceCollectionExtensions>
        <SimpleIconsIncludeSvgProvider>false</SimpleIconsIncludeSvgProvider>
        <SimpleIconsIncludeServiceCollectionExtensions>false</SimpleIconsIncludeServiceCollectionExtensions>
        <Configurations>Debug;Release</Configurations>
        <WebMinifierFolders>wwwroot/js;wwwroot/css</WebMinifierFolders>
        <WebMinifierExcludeFolders>wwwroot/js/vendor;wwwroot/js/monaco-editor</WebMinifierExcludeFolders>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>Soenneker.Quark.Suite</AssemblyName>
        <PackageId>Soenneker.Quark.Suite</PackageId>
        <Description>Shadcn-powered Blazor UI, refined and modular.</Description>

        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <Copyright>Copyright © 2025-2026 Jake Soenneker</Copyright>
        <PackageTags>shadcn radix bradix tailwind quark suite html elements blazor ui wrapper css quarksuite blazorlibrary csharp dotnet c# .net</PackageTags>

        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>

        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.suite</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.suite</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Gen.Web.Minifier" Version="11.0.37" PrivateAssets="all" />
    </ItemGroup>

    <!-- Local project control -->
    <PropertyGroup>
        <UseLocalProjects Condition="'$(UseLocalProjects)' == ''">false</UseLocalProjects>
        <UseLocalBradixProject Condition="'$(UseLocalBradixProject)' == ''">false</UseLocalBradixProject>
        <UseLocalCloudflareAiSearchProject Condition="'$(UseLocalCloudflareAiSearchProject)' == ''">false</UseLocalCloudflareAiSearchProject>

        <LocalRrwebReplayProject Condition="'$(LocalRrwebReplayProject)' == ''">..\..\..\..\Blazor\soenneker.blazor.rrweb.replay\src\Soenneker.Blazor.Rrweb.Replay\Soenneker.Blazor.Rrweb.Replay.csproj</LocalRrwebReplayProject>
        <UseLocalRrwebReplayProject Condition="'$(UseLocalRrwebReplayProject)' == ''">false</UseLocalRrwebReplayProject>
        <RrwebReplayVersion Condition="'$(RrwebReplayVersion)' == ''">4.0.4</RrwebReplayVersion>

        <LocalBradixProject Condition="'$(LocalBradixProject)' == ''">
            ..\..\..\..\Bradix\soenneker.bradix.suite\src\Soenneker.Bradix.Suite\Soenneker.Bradix.Suite.csproj
        </LocalBradixProject>

        <LocalQuarkBuildersProject Condition="'$(LocalQuarkBuildersProject)' == ''">
            ..\..\..\soenneker.quark.builders\src\Soenneker.Quark.Builders\Soenneker.Quark.Builders.csproj
        </LocalQuarkBuildersProject>

        <LocalQuarkGenPresetsProject Condition="'$(LocalQuarkGenPresetsProject)' == ''">
            ..\..\..\soenneker.quark.gen.presets\src\Soenneker.Quark.Gen.Presets\Soenneker.Quark.Gen.Presets.csproj
        </LocalQuarkGenPresetsProject>

        <LocalQuarkGenSimpleIconsProject Condition="'$(LocalQuarkGenSimpleIconsProject)' == ''">
            ..\..\..\soenneker.quark.gen.simpleicons\src\Soenneker.Quark.Gen.SimpleIcons\Soenneker.Quark.Gen.SimpleIcons.csproj
        </LocalQuarkGenSimpleIconsProject>

        <LocalQuarkGenSimpleIconsAbstractionsProject Condition="'$(LocalQuarkGenSimpleIconsAbstractionsProject)' == ''">
            ..\..\..\soenneker.quark.gen.simpleicons.abstractions\src\Soenneker.Quark.Gen.SimpleIcons.Abstractions\Soenneker.Quark.Gen.SimpleIcons.Abstractions.csproj
        </LocalQuarkGenSimpleIconsAbstractionsProject>

        <LocalClipboardProject Condition="'$(LocalClipboardProject)' == ''">
            ..\..\..\..\Blazor\soenneker.blazor.utils.clipboard\src\Soenneker.Blazor.Utils.Clipboard\Soenneker.Blazor.Utils.Clipboard.csproj
        </LocalClipboardProject>

        <LocalCreditCardsProject Condition="'$(LocalCreditCardsProject)' == ''">
            ..\..\..\..\Blazor\soenneker.blazor.creditcards\src\Soenneker.Blazor.CreditCards\Soenneker.Blazor.CreditCards.csproj
        </LocalCreditCardsProject>

        <LocalSignaturePadsProject Condition="'$(LocalSignaturePadsProject)' == ''">
            ..\..\..\..\Blazor\soenneker.blazor.signaturepads\src\Soenneker.Blazor.SignaturePads\Soenneker.Blazor.SignaturePads.csproj
        </LocalSignaturePadsProject>

        <LocalCloudflareAiSearchProject Condition="'$(LocalCloudflareAiSearchProject)' == ''">
            ..\..\..\..\Blazor\soenneker.blazor.cloudflare.aisearch\src\Soenneker.Blazor.Cloudflare.AiSearch\Soenneker.Blazor.Cloudflare.AiSearch.csproj
        </LocalCloudflareAiSearchProject>


    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="artifacts\**" />
        <Content Remove="artifacts\**" />
        <EmbeddedResource Remove="artifacts\**" />
        <None Remove="artifacts\**" />
    </ItemGroup>

    <!-- Tailwind manifest packaging -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackGeneratedTailwindManifest
        </TargetsForTfmSpecificContentInPackage>

        <_GeneratedTailwindManifestPath>
            $([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'tailwind', 'quark-suite-tailwind-manifest.txt'))
        </_GeneratedTailwindManifestPath>
    </PropertyGroup>

    <!-- Package assets -->
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjects)' == 'true' Or '$(UseLocalQuarkBuildersProject)' == 'true'">
        <ProjectReference Include="$(LocalQuarkBuildersProject)" />
    </ItemGroup>

    <!-- Always-on dependencies -->
    <ItemGroup Condition="'$(UseLocalRrwebReplayProject)' == 'true'">
        <ProjectReference Include="$(LocalRrwebReplayProject)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Atomics.ValueResources" Version="11.0.2" />
        <PackageReference Include="Soenneker.Blazor.Rrweb.Replay" Version="11.0.29" Condition="'$(UseLocalRrwebReplayProject)' != 'true'" />
        <PackageReference Include="Soenneker.Quark.Gen.Validation" Version="11.0.59" PrivateAssets="none" IncludeAssets="build; buildtransitive" />
        <PackageReference Include="Soenneker.Blazor.C15t" Version="11.0.117" />
        <PackageReference Include="Soenneker.Blazor.Cloudflare.AiSearch" Version="11.0.104" Condition="'$(UseLocalProjects)' != 'true' And '$(UseLocalCloudflareAiSearchProject)' != 'true'" />
        <PackageReference Include="Soenneker.Blazor.CreditCards" Version="11.0.680" Condition="'$(UseLocalProjects)' != 'true'" />
        <PackageReference Include="Soenneker.Blazor.SignaturePads" Version="11.0.204" Condition="'$(UseLocalProjects)' != 'true'" />
        <PackageReference Include="Soenneker.Blazor.Utils.Clipboard" Version="11.0.132" Condition="'$(UseLocalProjects)' != 'true'" />
        <PackageReference Include="Soenneker.DataTables.Dtos.ServerSideRequest" Version="11.0.40" />
        <PackageReference Include="Soenneker.Lucide.Enums.Icons" Version="11.0.87" />
        <PackageReference Include="Soenneker.Lucide.Icons" Version="5.0.104" />
        <PackageReference Include="Soenneker.Quark.Gen.Lucide.Abstractions" Version="11.0.34" />
        <PackageReference Include="Soenneker.SimpleIcons.Enums.Icons" Version="11.0.73" />
        <PackageReference Include="Soenneker.SimpleIcons.Icons" Version="11.0.74" />
        <PackageReference Include="Soenneker.Utils.Debounce" Version="11.0.96" />
        <PackageReference Include="Soenneker.Utils.Json" Version="11.0.2769" />
        <PackageReference Include="Soenneker.Asyncs.Locks" Version="11.0.119" />
        <PackageReference Include="Soenneker.Blazor.Extensions.EventCallback" Version="11.0.474" />
        <PackageReference Include="Soenneker.DataTables.Dtos.Column" Version="11.0.39" />
        <PackageReference Include="Soenneker.DataTables.Dtos.ServerResponse" Version="11.0.36" />
        <PackageReference Include="Soenneker.Librarian.LocalStorage" Version="11.0.125" />
    </ItemGroup>

    <!-- Switch: NuGet -->
    <ItemGroup Condition="'$(UseLocalProjects)' != 'true'">
        <PackageReference Include="Soenneker.Bradix.Suite" Version="11.0.371" Condition="'$(UseLocalBradixProject)' != 'true'" />
        <PackageReference Include="Soenneker.Quark.Builders" Version="11.0.345" Condition="'$(UseLocalQuarkBuildersProject)' != 'true'" />

        <PackageReference Include="Soenneker.Quark.Gen.Presets" Version="11.0.32" Condition="'$(UseLocalQuarkGenPresetsProject)' != 'true'">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Soenneker.Quark.Gen.SimpleIcons.Abstractions" Version="11.0.31" />
        <PackageReference Include="Soenneker.Quark.Gen.SimpleIcons" Version="11.0.107">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Quark.Gen.Lucide" Version="11.0.308">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Soenneker.Quark.Gen.Tailwind.Manifest.Suite" Version="11.0.287">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjects)' == 'true' Or '$(UseLocalQuarkGenPresetsProject)' == 'true'">
        <ProjectReference Include="$(LocalQuarkGenPresetsProject)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <!-- Switch: Local -->
    <ItemGroup Condition="'$(UseLocalProjects)' == 'true' Or '$(UseLocalBradixProject)' == 'true'">
        <ProjectReference Include="$(LocalBradixProject)" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjects)' == 'true'">
        <ProjectReference Include="$(LocalClipboardProject)" />
        <ProjectReference Include="$(LocalCreditCardsProject)" />
        <ProjectReference Include="$(LocalSignaturePadsProject)" />
        <ProjectReference Include="$(LocalQuarkGenSimpleIconsAbstractionsProject)" />
        <ProjectReference Include="$(LocalQuarkGenSimpleIconsProject)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjects)' == 'true' Or '$(UseLocalCloudflareAiSearchProject)' == 'true'">
        <ProjectReference Include="$(LocalCloudflareAiSearchProject)" />
    </ItemGroup>

    <!-- Tailwind manifest pack -->
    <Target Name="PackGeneratedTailwindManifest">
        <Error Condition="!Exists('$(_GeneratedTailwindManifestPath)')" Text="Generated Tailwind manifest not found. Build before packing." />

        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_GeneratedTailwindManifestPath)">
                <PackagePath>tailwind/</PackagePath>
                <BuildAction>None</BuildAction>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>
</Project>
