{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "soenneker-quark-suite",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./artifacts/cloudflare-workers/wwwroot",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "quark.soenneker.com",
      "custom_domain": true
    }
  ]
}
