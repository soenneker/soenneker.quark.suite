@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Soenneker.Quark
@namespace Soenneker.Quark.Suite.Tests

<Validations Model="Model">
    <Validation Field="ExplicitField">
        <TextInput @bind-Value="Model.Child.Name" />
        <ValidationError />
    </Validation>
</Validations>

@code {
    [Parameter] public GeneratedBindingContainer Model { get; set; } = new();
    [Parameter] public FieldIdentifier? ExplicitField { get; set; }
}
