<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="bunit" Version="2.11.3" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="4.0.285" />
        <PackageReference Include="Soenneker.Utils.Test" Version="4.0.330" />
        <PackageReference Include="Soenneker.Blazor.MockJsRuntime" Version="4.0.351" />
        <PackageReference Include="TUnit" Version="1.69.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Quark.Suite\Soenneker.Quark.Suite.csproj" />
        <ProjectReference Include="..\Soenneker.Quark.Suite.Demo\Soenneker.Quark.Suite.Demo.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>
</Project>
