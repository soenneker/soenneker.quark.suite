@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@if (_searchConfiguration is not null)
{
    <div class="demo-header-search w-32 sm:w-52 shrink-0 focus-within:z-60 focus-within:w-auto sm:focus-within:z-auto sm:focus-within:w-52 focus-within:fixed sm:focus-within:static focus-within:inset-x-4 focus-within:top-4">
        <CloudflareAiSearch Configuration="_searchConfiguration" />
    </div>
}

@code {
    private CloudflareAiSearchBarConfiguration? _searchConfiguration;

    protected override void OnInitialized()
    {
        string? apiUrl = Configuration["CloudflareAiSearch:ApiUrl"];

        if (string.IsNullOrWhiteSpace(apiUrl))
            return;

        _searchConfiguration = new CloudflareAiSearchBarConfiguration
        {
            ApiUrl = apiUrl,
            Placeholder = "Search",
            MaxResults = 50,
            MaxRenderResults = 10,
            DebounceMilliseconds = 250,
            ShowUrl = true
        };
    }
}
