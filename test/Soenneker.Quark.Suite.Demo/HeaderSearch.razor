@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@if (_searchConfiguration is not null)
{
    <Div Width="Width.Is32.OnSm.Is52" Class="focus-within:z-60 focus-within:w-auto sm:focus-within:z-auto sm:focus-within:w-52" Position="CssValue<PositionBuilder>.For(Position.OnFocusWithin.Fixed, Position.OnSm.OnFocusWithin.Static)" Inset="CssValue<InsetBuilder>.For(Inset.OnFocusWithin.OnX.Is4, Inset.OnFocusWithin.FromTop.Is4)" Shrink="Shrink.Is0">
        <CloudflareAiSearch Configuration="_searchConfiguration" />
    </Div>
}

@code {
    private CloudflareAiSearchBarConfiguration? _searchConfiguration;

    protected override void OnInitialized()
    {
        string? apiUrl = Configuration["CloudflareAiSearch:ApiUrl"];

        if (string.IsNullOrWhiteSpace(apiUrl))
            return;

        _searchConfiguration = new CloudflareAiSearchBarConfiguration
        {
            ApiUrl = apiUrl,
            Placeholder = "Search",
            MaxResults = 50,
            MaxRenderResults = 10,
            DebounceMilliseconds = 250,
            ShowUrl = true
        };
    }
}
