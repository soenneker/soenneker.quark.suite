@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@if (_searchConfiguration is not null)
{
    <Div Width="Width.Is32.OnSm.Is52" Class="focus-within:fixed focus-within:inset-x-4 focus-within:top-4 focus-within:z-60 focus-within:w-auto sm:focus-within:static sm:focus-within:z-auto sm:focus-within:w-52" Shrink="Shrink.Is0">
        <CloudflareAiSearch Configuration="_searchConfiguration" />
    </Div>
}

@code {
    private CloudflareAiSearchBarConfiguration? _searchConfiguration;

    protected override void OnInitialized()
    {
        string? apiUrl = Configuration["CloudflareAiSearch:ApiUrl"];

        if (string.IsNullOrWhiteSpace(apiUrl))
            return;

        _searchConfiguration = new CloudflareAiSearchBarConfiguration
        {
            ApiUrl = apiUrl,
            Placeholder = "Search",
            MaxResults = 50,
            MaxRenderResults = 10,
            DebounceMilliseconds = 250,
            ShowUrl = true
        };
    }
}
