@namespace Soenneker.Quark.Suite.Demo

<Card Class="rounded-lg">
    <CardHeader Padding="Padding.FromBottom.Is2">
        <CardTitle TextSize="TextSize.Sm">@Label</CardTitle>
    </CardHeader>
    <CardBody Class="pt-0">
        @ChildContent
    </CardBody>
</Card>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
