@namespace Soenneker.Quark.Suite.Demo

<Card Rounded="Rounded.Lg">
    <CardHeader Padding="Padding.FromBottom.Is2">
        <CardTitle TextSize="TextSize.Sm">@Label</CardTitle>
    </CardHeader>
    <CardBody Padding="Padding.FromTop.Is0">
        @ChildContent
    </CardBody>
</Card>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
