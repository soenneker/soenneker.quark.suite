@switch (Category)
{
    case "ScatterDetail":
        <H3>Sensor readings before and after calibration</H3>
        <Chart Type="ChartType.Scatter" AriaLabel="Sensor readings before and after calibration" Series="@(new[] { ChartSeries.FromPoints("Before", [new(10, 13), new(20, 25), new(30, 36)]), ChartSeries.FromPoints("After", [new(10, 10), new(20, 21), new(30, 30)]) })" />
        break;
    case "Scatter":
        <H3>Calibration observations</H3>
        <Chart Type="ChartType.Scatter" AriaLabel="Calibration observations" Series="@(new[] { ChartSeries.FromPoints("Sensor", [new(1, 8), new(2.5, 14), new(4, 11), new(6, 22)]) })" />
        break;
    case "BubbleDetail":
        <H3>Campaign reach, conversions, and spend</H3>
        <Chart Type="ChartType.Bubble" AriaLabel="Campaign reach, conversions, and spend" Series="@(new[] { ChartSeries.FromPoints("Campaigns", [new(10, 4, 12), new(18, 12, 8), new(28, 15, 22), new(40, 14, 36)]) })" />
        break;
    case "Bubble":
        <H3>Warehouse shipments by distance, time, and load</H3>
        <Chart Type="ChartType.Bubble" AriaLabel="Warehouse shipments by distance, time, and load" Series="@(new[] { ChartSeries.FromPoints("Shipments", [new(12, 3, 8), new(27, 4, 25), new(35, 8, 14), new(48, 7, 42)]) })" />
        break;
    case "HeatmapDetail":
        <H3>Support requests by weekday and shift</H3>
        <Chart Type="ChartType.Heatmap" AriaLabel="Support requests by weekday and shift" Labels="@(new[] { "Mon", "Tue", "Wed", "Thu", "Fri" })" Series="@(new[] { new ChartSeries("Day", new double[] { 28, 32, 20, 21, 18 }), new ChartSeries("Evening", new double[] { 16, 10, 12, 19, 24 }), new ChartSeries("Night", new double[] { 4, 2, 8, 3, 5 }) })" />
        break;
    case "Heatmap":
        <H3>Machine load by shift</H3>
        <Chart Type="ChartType.Heatmap" AriaLabel="Machine load by shift" Labels="@(new[] { "Morning", "Afternoon", "Night" })" Series="@(new[] { new ChartSeries("Press", new double[] { 82, 65, 20 }), new ChartSeries("Lathe", new double[] { 45, 88, 62 }) })" />
        break;
    case "TreemapDetail":
        <H3>Monthly household budget</H3>
        <Chart Type="ChartType.Treemap" AriaLabel="Monthly household budget" Labels="@(new[] { "Rent", "Food", "Travel", "Utilities" })" Series="@(new[] { new ChartSeries("Dollars", new double[] { 1500, 520, 280, 190 }) })" />
        break;
    case "Treemap":
        <H3>Storage usage by asset type</H3>
        <Chart Type="ChartType.Treemap" AriaLabel="Storage usage by asset type" Labels="@(new[] { "Footage", "Audio", "Photos", "Documents" })" Series="@(new[] { new ChartSeries("GB", new double[] { 60, 22, 13, 5 }) })" />
        break;
    case "SankeyDetail":
        <H3>Returns routed to resale or recycling</H3>
        <Chart Type="ChartType.Sankey" AriaLabel="Returns routed to resale or recycling" Flows="@(new ChartFlow[] { new("Online", "Inspect", 60), new("Store", "Inspect", 40), new("Inspect", "Resale", 82), new("Inspect", "Recycle", 18) })" />
        break;
    case "Sankey":
        <H3>Power distribution by source and destination</H3>
        <Chart Type="ChartType.Sankey" AriaLabel="Power distribution by source and destination" Flows="@(new ChartFlow[] { new("Solar", "Battery", 30), new("Solar", "Workshop", 20), new("Grid", "Battery", 15), new("Battery", "Workshop", 35), new("Battery", "Office", 10) })" />
        break;
    case "FunnelDetail":
        <H3>Orders from basket to payment</H3>
        <Chart Type="ChartType.Funnel" AriaLabel="Orders from basket to payment" Labels="@(new[] { "Basket", "Checkout", "Payment" })" Series="@(new[] { new ChartSeries("Orders", new double[] { 780, 510, 482 }) })" />
        break;
    case "Funnel":
        <H3>Workshop registration stages</H3>
        <Chart Type="ChartType.Funnel" AriaLabel="Workshop registration stages" Labels="@(new[] { "Invited", "Registered", "Confirmed", "Attended" })" Series="@(new[] { new ChartSeries("People", new double[] { 250, 180, 144, 120 }) })" />
        break;
    case "CandlestickDetail":
        <H3>Weekly trading ranges through a reversal</H3>
        <Chart Type="ChartType.Candlestick" AriaLabel="Weekly trading ranges through a reversal" Candles="@(new ChartCandle[] { new("Week 1", 50, 58, 48, 56), new("Week 2", 56, 65, 54, 63), new("Week 3", 63, 64, 51, 52), new("Week 4", 52, 55, 45, 48) })" />
        break;
    case "Candlestick":
        <H3>Daily opening, high, low, and closing prices</H3>
        <Chart Type="ChartType.Candlestick" AriaLabel="Daily opening, high, low, and closing prices" Candles="@(new ChartCandle[] { new("Mon", 35, 42, 32, 40), new("Tue", 41, 44, 36, 38), new("Wed", 38, 46, 37, 45), new("Thu", 45, 47, 41, 45) })" />
        break;
    case "BoxPlotDetail":
        <H3>Response times by service tier (ms)</H3>
        <Chart Type="ChartType.BoxPlot" AriaLabel="Response times by service tier (ms)" Boxes="@(new ChartBox[] { new("Standard", 15, 40, 70, 110, 210), new("Priority", 12, 24, 30, 38, 65) })" />
        break;
    case "BoxPlot":
        <H3>Distribution of turnaround times</H3>
        <Chart Type="ChartType.BoxPlot" AriaLabel="Distribution of turnaround times" Boxes="@(new ChartBox[] { new("Intake", 1, 3, 5, 7, 12), new("Review", 4, 8, 12, 16, 22), new("Dispatch", 2, 4, 5, 8, 11) })" />
        break;
    case "WaterfallDetail":
        <H3>Cash balance after income and expenses</H3>
        <Chart Type="ChartType.Waterfall" AriaLabel="Cash balance after income and expenses" Labels="@(new[] { "Opening", "Sales", "Payroll", "Rent", "Refunds" })" Series="@(new[] { new ChartSeries("Dollars", new double[] { 8000, 3400, -2200, -1200, -350 }) })" />
        break;
    case "Waterfall":
        <H3>Monthly inventory movements</H3>
        <Chart Type="ChartType.Waterfall" AriaLabel="Monthly inventory movements" Labels="@(new[] { "Opening", "Received", "Shipped", "Returns" })" Series="@(new[] { new ChartSeries("Units", new double[] { 120, 45, -80, 12 }) })" />
        break;
}

