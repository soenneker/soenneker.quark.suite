        "Sankey" => """<Chart Type="ChartType.Sankey" AriaLabel="Power distribution by source and destination" Flows="@(new ChartFlow[] { new("Solar", "Battery", 30), new("Solar", "Workshop", 20), new("Grid", "Battery", 15), new("Battery", "Workshop", 35), new("Battery", "Office", 10) })" />""",
        "Funnel" => """<Chart Type="ChartType.Funnel" AriaLabel="Workshop registration stages" Labels="@(new[] { "Invited", "Registered", "Confirmed", "Attended" })" Series="@(new[] { new ChartSeries("People", new double[] { 250, 180, 144, 120 }) })" />""",
