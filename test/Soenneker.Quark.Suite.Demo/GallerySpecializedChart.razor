        "Waterfall" => """<Chart Type="ChartType.Waterfall" AriaLabel="Monthly inventory movements" Labels="@(new[] { "Opening", "Received", "Shipped", "Returns" })" Series="@(new[] { new ChartSeries("Units", new double[] { 120, 45, -80, 12 }) })" />""",
        _ => ""
    };
}
