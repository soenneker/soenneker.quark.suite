<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
        <!-- Demo pages do not need Lepton parameter generation; keep modern Razor parsing enabled. -->
        <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <WasmEnableHotReload>false</WasmEnableHotReload>
        <AttachWeakETagToCompressedAssetsDuringDevelopment>true</AttachWeakETagToCompressedAssetsDuringDevelopment>
        <TailwindGeneratorBuildEnabled>true</TailwindGeneratorBuildEnabled>
        <TailwindManifestPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..', '..', 'src', 'Soenneker.Quark.Suite', 'tailwind', 'quark-suite-tailwind-manifest.txt'))))</TailwindManifestPath>
        <RazorSitemapBaseUrl>https://quark.soenneker.com/</RazorSitemapBaseUrl>
        <RazorSitemapOutputPath>wwwroot/sitemap.xml</RazorSitemapOutputPath>
        <RazorSitemapIncludeUnannotatedPages>true</RazorSitemapIncludeUnannotatedPages>
        <RazorSitemapEnabled>true</RazorSitemapEnabled>
        <SimpleIconsIncludeSvgProvider>true</SimpleIconsIncludeSvgProvider>
        <SimpleIconsIncludeServiceCollectionExtensions>true</SimpleIconsIncludeServiceCollectionExtensions>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <BlazorCacheBootResources>false</BlazorCacheBootResources>
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="artifacts\**" />
      <Content Remove="artifacts\**" />
      <EmbeddedResource Remove="artifacts\**" />
      <None Remove="artifacts\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
        <PackageReference Include="Soenneker.DataTables.Extensions.ServerSideRequest" Version="11.0.271" />
        <PackageReference Include="Soenneker.Dtos.Results.Paged" Version="11.0.69" />
        <PackageReference Include="Soenneker.Extensions.Configuration.Logging" Version="11.0.257" />
        <PackageReference Include="Soenneker.Extensions.Serilog.LogEventLevels" Version="11.0.260" />
        <PackageReference Include="Soenneker.Lucide.Icons" Version="5.0.104" />
        <PackageReference Include="Soenneker.SimpleIcons.Icons" Version="11.0.74" />
        <PackageReference Include="Soenneker.Gen.Razor.Sitemaps" Version="11.0.169">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.Lucide" Version="11.0.306">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.SimpleIcons" Version="11.0.106">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind" Version="11.0.320">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind.Manifest" Version="11.0.300">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.Themes" Version="11.0.297">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Serilog.Sinks.Browser.Blazor" Version="11.0.440" />
        <PackageReference Include="Soenneker.Utils.AutoBogus" Version="11.0.996" />
        <PackageReference Include="Soenneker.Utils.Delay" Version="11.0.107" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Quark.Suite\Soenneker.Quark.Suite.csproj" />
        <_TailwindGeneratorInputs Include="$(TailwindManifestPath)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.DataTables.Dtos.ServerResponse" Version="11.0.36" />
    </ItemGroup>
</Project>
