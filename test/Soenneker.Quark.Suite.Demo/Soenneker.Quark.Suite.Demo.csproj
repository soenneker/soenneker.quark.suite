<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
        <!-- Demo pages do not need Lepton parameter generation; keep modern Razor parsing enabled. -->
        <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <WasmEnableHotReload>false</WasmEnableHotReload>
        <AttachWeakETagToCompressedAssetsDuringDevelopment>true</AttachWeakETagToCompressedAssetsDuringDevelopment>
        <TailwindGeneratorBuildEnabled>true</TailwindGeneratorBuildEnabled>
        <TailwindManifestPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..', '..', 'src', 'Soenneker.Quark.Suite', 'tailwind', 'quark-suite-tailwind-manifest.txt'))))</TailwindManifestPath>
        <RazorSitemapBaseUrl>https://quark.soenneker.com/</RazorSitemapBaseUrl>
        <RazorSitemapOutputPath>wwwroot/sitemap.xml</RazorSitemapOutputPath>
        <RazorSitemapIncludeUnannotatedPages>true</RazorSitemapIncludeUnannotatedPages>
        <RazorSitemapEnabled>true</RazorSitemapEnabled>
        <SimpleIconsIncludeSvgProvider>true</SimpleIconsIncludeSvgProvider>
        <SimpleIconsIncludeServiceCollectionExtensions>true</SimpleIconsIncludeServiceCollectionExtensions>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <BlazorCacheBootResources>false</BlazorCacheBootResources>
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="artifacts\**" />
      <Content Remove="artifacts\**" />
      <EmbeddedResource Remove="artifacts\**" />
      <None Remove="artifacts\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
        <PackageReference Include="Soenneker.DataTables.Extensions.ServerSideRequest" Version="11.0.287" />
        <PackageReference Include="Soenneker.Dtos.Results.Paged" Version="11.0.71" />
        <PackageReference Include="Soenneker.Extensions.Configuration.Logging" Version="11.0.262" />
        <PackageReference Include="Soenneker.Extensions.Serilog.LogEventLevels" Version="11.0.262" />
        <PackageReference Include="Soenneker.Gen.Razor.Sitemaps" Version="11.0.186">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Icon generators resolve SVG resources from direct package references. -->
        <PackageReference Include="Soenneker.Lucide.Icons" Version="11.0.120" />
        <PackageReference Include="Soenneker.SimpleIcons.Icons" Version="11.0.78" />
        <PackageReference Include="Soenneker.Quark.Gen.Lucide" Version="11.0.324">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.SimpleIcons" Version="11.0.124">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind" Version="11.0.345">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind.Manifest" Version="11.0.326">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Gen.Themes" Version="11.0.319">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Serilog.Sinks.Browser.Blazor" Version="11.0.451" />
        <PackageReference Include="Soenneker.Utils.AutoBogus" Version="11.0.1011" />
        <PackageReference Include="Soenneker.Utils.Delay" Version="11.0.110" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Quark.Suite\Soenneker.Quark.Suite.csproj" />
        <_TailwindGeneratorInputs Include="$(TailwindManifestPath)" />
    </ItemGroup>
    <ItemGroup>
    </ItemGroup>
</Project>
