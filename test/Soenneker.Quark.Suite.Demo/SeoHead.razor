@using System.Text.Json
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta data-quark-seo name="description" content="@Description" />
    <meta data-quark-seo name="robots" content="@(NoIndex ? "noindex, follow" : "index, follow, max-image-preview:large")" />
    @if (!NoIndex)
    {
        <link data-quark-seo rel="canonical" href="@CanonicalUrl" />
        <meta data-quark-seo property="og:type" content="website" />
        <meta data-quark-seo property="og:site_name" content="Quark Suite" />
        <meta data-quark-seo property="og:locale" content="en_US" />
        <meta data-quark-seo property="og:title" content="@Title" />
        <meta data-quark-seo property="og:description" content="@Description" />
        <meta data-quark-seo property="og:url" content="@CanonicalUrl" />
        <meta data-quark-seo property="og:image" content="https://quark.soenneker.com/social-card.png" />
        <meta data-quark-seo property="og:image:width" content="1200" />
        <meta data-quark-seo property="og:image:height" content="630" />
        <meta data-quark-seo property="og:image:alt" content="Quark Suite — Blazor components inspired by shadcn/ui" />
        <meta data-quark-seo name="twitter:card" content="summary_large_image" />
        <meta data-quark-seo name="twitter:title" content="@Title" />
        <meta data-quark-seo name="twitter:description" content="@Description" />
        <meta data-quark-seo name="twitter:image" content="https://quark.soenneker.com/social-card.png" />
        <meta data-quark-seo name="twitter:image:alt" content="Quark Suite — Blazor components inspired by shadcn/ui" />
        <script data-quark-seo type="application/ld+json">@((MarkupString)StructuredData)</script>
    }
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter] public bool NoIndex { get; set; }
    [Parameter] public string? CanonicalPath { get; set; }

    private string Path => (CanonicalPath ?? new Uri(Navigation.Uri).AbsolutePath).TrimEnd('/');
    private string CanonicalUrl => "https://quark.soenneker.com" + (Path.Length == 0 ? "/" : Path);

    private string StructuredData => JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "WebSite",
                ["@id"] = "https://quark.soenneker.com/#website",
                ["name"] = "Quark Suite",
                ["url"] = "https://quark.soenneker.com/",
                ["inLanguage"] = "en"
            },
            new Dictionary<string, object>
            {
                ["@type"] = Path.Length == 0 ? "WebPage" : "TechArticle",
                ["@id"] = CanonicalUrl + "#webpage",
                ["url"] = CanonicalUrl,
                ["name"] = Title,
                ["description"] = Description,
                ["inLanguage"] = "en",
                ["isPartOf"] = new Dictionary<string, string> { ["@id"] = "https://quark.soenneker.com/#website" },
                ["about"] = new Dictionary<string, object>
                {
                    ["@type"] = "SoftwareSourceCode",
                    ["name"] = "Soenneker.Quark.Suite",
                    ["programmingLanguage"] = "C#",
                    ["codeRepository"] = "https://github.com/soenneker/soenneker.quark.suite"
                }
            }
        }
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The static snapshot remains readable until Blazor has rendered fresh head content.
        await JS.InvokeVoidAsync("quarkDemo.clearPrerenderedMetadata");
    }
}
