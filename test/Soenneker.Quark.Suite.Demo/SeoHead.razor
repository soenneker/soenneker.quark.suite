@using System.Text.Json
@using System
@using System.Collections.Generic
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <meta name="robots" content="@(NoIndex ? "noindex, follow" : "index, follow, max-image-preview:large")" />
    @if (!NoIndex)
    {
        <link rel="canonical" href="@CanonicalUrl" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Quark Suite" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content="@Title" />
        <meta property="og:description" content="@Description" />
        <meta property="og:url" content="@CanonicalUrl" />
        <meta property="og:image" content="https://quark.soenneker.com/social-card.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Quark Suite — Blazor components inspired by shadcn/ui" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@Title" />
        <meta name="twitter:description" content="@Description" />
        <meta name="twitter:image" content="https://quark.soenneker.com/social-card.png" />
        <meta name="twitter:image:alt" content="Quark Suite — Blazor components inspired by shadcn/ui" />
        <script type="application/ld+json">@((MarkupString)StructuredData)</script>
    }
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter] public bool NoIndex { get; set; }
    [Parameter] public string? CanonicalPath { get; set; }

    private string Path => "/" + (CanonicalPath ?? new Uri(Navigation.Uri).AbsolutePath)
        .Split('?', '#')[0].Trim('/');
    private string CanonicalUrl => "https://quark.soenneker.com" + (Path == "/" ? "/" : Path);

    private string StructuredData => JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "WebSite",
                ["@id"] = "https://quark.soenneker.com/#website",
                ["name"] = "Quark Suite",
                ["url"] = "https://quark.soenneker.com/",
                ["inLanguage"] = "en"
            },
            PageData
        }
    });

    private Dictionary<string, object> PageData
    {
        get
        {
            var page = new Dictionary<string, object>
            {
                ["@type"] = "WebPage",
                ["@id"] = CanonicalUrl + "#webpage",
                ["url"] = CanonicalUrl,
                ["name"] = Title,
                ["description"] = Description,
                ["inLanguage"] = "en",
                ["isPartOf"] = new Dictionary<string, string> { ["@id"] = "https://quark.soenneker.com/#website" },
                ["about"] = new Dictionary<string, object>
                {
                    ["@type"] = "SoftwareSourceCode",
                    ["name"] = "Soenneker.Quark.Suite",
                    ["programmingLanguage"] = "C#",
                    ["codeRepository"] = "https://github.com/soenneker/soenneker.quark.suite"
                }
            };
            if (Path != "/")
                page["breadcrumb"] = Breadcrumbs;
            return page;
        }
    }

    private object Breadcrumbs => new Dictionary<string, object>
    {
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
            {
                Breadcrumb(1, "Quark Suite", "https://quark.soenneker.com/"),
                Breadcrumb(2, Title.Split('|')[0].Trim(), CanonicalUrl)
            }
    };

    private static object Breadcrumb(int position, string name, string url) => new Dictionary<string, object>
    {
        ["@type"] = "ListItem",
        ["position"] = position,
        ["name"] = name,
        ["item"] = url
    };

}
