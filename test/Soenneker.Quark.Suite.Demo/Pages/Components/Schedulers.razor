@page "/components/scheduler"
<QuarkSeoHead Title="Blazor Appointment Scheduler | Quark Suite" Description="Choose a date and an available appointment time." />
<Div Class="space-y-6">
    <Scheduler @bind-BookingDuration="_duration" CanEditTitle="true" @bind-BookingTitle="_bookingTitle" SelectedStart="_start" SlotSelected="SelectSlot">
        <MeetingDetails>Choose a time to meet with our team.</MeetingDetails>
    </Scheduler>
    <PreCode Language="razor">@Example</PreCode>
</Div>
@code {
    private TimeSpan _duration = TimeSpan.FromMinutes(15);
    private string? _bookingTitle = "Discovery call";
    private DateTimeOffset? _start;
    private void SelectSlot(SchedulerSlot slot) => _start = slot.Start;

    private const string Example = """
<Scheduler @bind-BookingDuration="_duration" CanEditTitle="true" @bind-BookingTitle="_bookingTitle" SelectedStart="_start" SlotSelected="SelectSlot">
    <MeetingDetails>Choose a time to meet with our team.</MeetingDetails>
</Scheduler>

@code {
    private TimeSpan _duration = TimeSpan.FromMinutes(15);
    private string? _bookingTitle = "Discovery call";
    private DateTimeOffset? _start;
    private void SelectSlot(SchedulerSlot slot) => _start = slot.Start;
}
""";
}
