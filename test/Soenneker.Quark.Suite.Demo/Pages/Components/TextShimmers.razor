@page "/components/text-shimmer"

<QuarkSeoHead Title="Blazor Text Shimmer: Animated Highlights | Quark Suite" Description="Animate text in Blazor with Quark TextShimmer. Explore repeat delays, angled and inverted sweeps, custom elements, highlight colors, and animation speed." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <DemoSection Code="@DefaultCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" MinHeight='MinHeight.Token("24")'>
            <TextShimmer TextSize="TextSize.Sm" Leading="Leading.Is6" TextColor="TextColor.MutedForeground">
                Thinking through your request...
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Repeat delay" Code="@RepeatDelayCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" MinHeight='MinHeight.Token("24")'>
            <TextShimmer ShimmerDuration="1.2" RepeatDelay="0.8" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                Generating response...
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Angled" Code="@AngledCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" MinHeight='MinHeight.Token("24")'>
            <TextShimmer Angle="24" Spread="32" ShimmerDuration="1.5" TextSize="TextSize.Sm" FontWeight="FontWeight.Medium" TextColor="TextColor.MutedForeground">
                Re-ranking search results
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Inverted" Code="@InvertedCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" MinHeight='MinHeight.Token("24")' Rounded="Rounded.Md" BackgroundColor="BackgroundColor.Foreground">
            <TextShimmer InvertColor="true" Class="text-background" TextSize="TextSize.Sm">
                Processing tool output...
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="As Custom Element" Code="@CustomElementCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" MinHeight='MinHeight.Token("24")'>
            <TextShimmer Tag="p" Margin="Margin.Is0" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                Compiling component registry
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Custom Highlight Color" Code="@CustomColorCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" MinHeight='MinHeight.Token("24")'>
            <TextShimmer Color="hsl(var(--primary))" ShimmerDuration="1.4" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                Syncing vector index
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Slow Sweep" Code="@SlowSweepCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" MinHeight='MinHeight.Token("24")'>
            <TextShimmer ShimmerDuration="2.5" Spread="18" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                Analyzing conversation context
            </TextShimmer>
        </Div>
    </DemoSection>
</Div>

