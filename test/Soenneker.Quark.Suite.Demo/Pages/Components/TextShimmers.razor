@page "/components/text-shimmer"

<QuarkSeoHead Title="Blazor Text Shimmer Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Text Shimmer component. See live demos and Razor code examples for your application." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <DemoSection Code="@DefaultCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-24">
            <TextShimmer Class="text-sm leading-6 text-muted-foreground">
                Thinking through your request...
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Repeat delay" Code="@RepeatDelayCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-24">
            <TextShimmer ShimmerDuration="1.2" RepeatDelay="0.8" Class="text-sm text-muted-foreground">
                Generating response...
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Angled" Code="@AngledCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-24">
            <TextShimmer Angle="24" Spread="32" ShimmerDuration="1.5" Class="text-sm font-medium text-muted-foreground">
                Re-ranking search results
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Inverted" Code="@InvertedCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-24 rounded-md" BackgroundColor="BackgroundColor.Foreground">
            <TextShimmer InvertColor="true" Class="text-sm text-background">
                Processing tool output...
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="As Custom Element" Code="@CustomElementCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-24">
            <TextShimmer Tag="p" Class="m-0 text-sm text-muted-foreground">
                Compiling component registry
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Custom Highlight Color" Code="@CustomColorCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-24">
            <TextShimmer Color="hsl(var(--primary))" ShimmerDuration="1.4" Class="text-sm text-muted-foreground">
                Syncing vector index
            </TextShimmer>
        </Div>
    </DemoSection>

    <DemoSection Title="Slow Sweep" Code="@SlowSweepCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-24">
            <TextShimmer ShimmerDuration="2.5" Spread="18" Class="text-sm text-muted-foreground">
                Analyzing conversation context
            </TextShimmer>
        </Div>
    </DemoSection>
</Div>

