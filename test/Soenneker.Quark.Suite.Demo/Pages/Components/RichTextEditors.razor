@page "/components/rich-text-editor"
<QuarkSeoHead Title="Blazor Rich Text Editor | Quark Suite" Description="Edit formatted text, links and mentions with controlled HTML and read-only previews." />

<Div Space="Space.Y.Is8">
<DemoSection Title="Compose an update" Description="Select a phrase to format it, add a link, or mention a teammate."
             Code="@Example" CodeLanguage="razor"
             PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 gap-4">
    <RichTextEditor @bind-Value="_html" Mentions="_mentions" Label="Project update" />
</DemoSection>

<DemoSection Title="Reader preview" Description="Changes to the draft appear here as you type."
             Code="@PreviewCode" CodeLanguage="razor"
             PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 gap-4">
    <RichTextEditor Value="_html" ReadOnly="true" Label="Published update" />
</DemoSection>
</Div>

@code {
    private string _html = "<p><strong>Launch handoff</strong></p><p>The release candidate is ready for review. Before Friday:</p><ul><li>Confirm the onboarding copy.</li><li>Share the final screenshots with support.</li></ul>";
    private readonly IReadOnlyList<SelectOption> _mentions = [new("alex", "Alex"), new("sam", "Sam")];
    private const string Example = """
<RichTextEditor @bind-Value="_html" Mentions="_mentions" Label="Project update" />
""";
    private const string PreviewCode = """
<RichTextEditor Value="_html" ReadOnly="true" Label="Published update" />
""";
}
