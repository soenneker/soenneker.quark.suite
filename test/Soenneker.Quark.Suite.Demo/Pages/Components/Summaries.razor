@page "/components/summary"

<QuarkSeoHead Title="Blazor Summary: Disclosure Headings | Quark Suite" Description="Use Quark Summary to label expandable Details content. Explore text headings, icons, styling, and native keyboard interaction." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Paragraph>Summary provides the clickable heading for a <Anchor Href="components/details" DecorationLine="DecorationLine.Underline">Details</Anchor> disclosure. Place it first inside Details. Focus the heading and press Enter or Space to expand or collapse the content.</Paragraph>

    <DemoSection Title="Basic Summary" Description="A text heading with the browser's disclosure marker." Code="@BasicCode" CodeLanguage="razor">
        <Details Border="Border.Is1" Padding="Padding.Is3" Rounded="Rounded.Lg">
            <Summary FontWeight="FontWeight.Bold" Cursor="Cursor.Pointer">Shipping information</Summary>
            <Paragraph Margin="Margin.FromTop.Is2.FromBottom.Is0">Orders ship within two business days.</Paragraph>
        </Details>
    </DemoSection>

    <DemoSection Title="Styled Summary" Description="Add an icon and style the heading while preserving native disclosure behavior." Code="@StyledCode" CodeLanguage="razor">
        <Details Open="true" Border="Border.Is1" Padding="Padding.Is3" Rounded="Rounded.Lg">
            <Summary FontWeight="FontWeight.Semibold" TextColor="TextColor.Primary" Cursor="Cursor.Pointer">
                <Icon Name="LucideIcon.Info" Margin="Margin.FromEnd.Is2" />
                Account settings
            </Summary>
            <Paragraph Margin="Margin.FromTop.Is2.FromBottom.Is0">Update your profile and notification preferences here.</Paragraph>
        </Details>
    </DemoSection>
</Div>

@code {
    private const string BasicCode = """
<Details Border="Border.Is1" Padding="Padding.Is3" Rounded="Rounded.Lg">
    <Summary FontWeight="FontWeight.Bold" Cursor="Cursor.Pointer">Shipping information</Summary>
    <Paragraph Margin="Margin.FromTop.Is2.FromBottom.Is0">Orders ship within two business days.</Paragraph>
</Details>
""";

    private const string StyledCode = """
<Details Open="true" Border="Border.Is1" Padding="Padding.Is3" Rounded="Rounded.Lg">
    <Summary FontWeight="FontWeight.Semibold" TextColor="TextColor.Primary" Cursor="Cursor.Pointer">
        <Icon Name="LucideIcon.Info" Margin="Margin.FromEnd.Is2" />
        Account settings
    </Summary>
    <Paragraph Margin="Margin.FromTop.Is2.FromBottom.Is0">Update your profile and notification preferences here.</Paragraph>
</Details>
""";
}
