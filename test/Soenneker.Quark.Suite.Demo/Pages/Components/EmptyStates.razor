@page "/components/empty-state"

<SeoHead Title="Blazor Empty State Examples | Quark Suite" Description="Present empty, error, and disabled application states." />

<Grid Columns="GridCols.Is1" Gap="Gap.Is6" MinWidth="MinWidth.Is0" Width="Width.IsFull">
    <DemoSection Title="No results" Description="Explain why content is absent." Code="@Example0" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <EmptyState Title="No projects yet" Description="Projects will appear here when you create one." />
    </DemoSection>
    <DemoSection Title="Error with action" Description="Supply a contextual recovery link." Code="@Example1" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <EmptyState Kind="EmptyStateKind.Error" Title="Unable to load projects" Description="Check the troubleshooting guide for help.">
            <Actions><Anchor Href="/troubleshooting">Troubleshooting guide</Anchor></Actions>
        </EmptyState>
    </DemoSection>
    <DemoSection Title="Disabled state" Description="Explain an unavailable feature." Code="@Example2" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <EmptyState Kind="EmptyStateKind.Disabled" Title="Reporting is disabled" Description="Enable reporting in your workspace settings." />
    </DemoSection>
</Grid>

@code {

    private const string Example0 = """
        <EmptyState Title="No projects yet" Description="Projects will appear here when you create one." />
        """;
    private const string Example1 = """
        <EmptyState Kind="EmptyStateKind.Error" Title="Unable to load projects" Description="Check the troubleshooting guide for help.">
            <Actions><Anchor Href="/troubleshooting">Troubleshooting guide</Anchor></Actions>
        </EmptyState>
        """;
    private const string Example2 = """
        <EmptyState Kind="EmptyStateKind.Disabled" Title="Reporting is disabled" Description="Enable reporting in your workspace settings." />
        """;
}
