@page "/components/details-section"

<SeoHead Title="Blazor Details Section Examples | Quark Suite" Description="Group related read-only fields in a responsive layout." />

<Grid Columns="GridCols.Is1" Gap="Gap.Is6" MinWidth="MinWidth.Is0" Width="Width.IsFull">
    <DemoSection Title="Grouped details" Description="Fields stack on narrow screens." Code="@Example0" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <DetailsSection Title="Project">
            <DetailsItem Label="Name" Content="Website refresh" />
            <DetailsItem Label="Owner" Content="Design team" />
            <DetailsItem Label="Description" Content="Update the public website and documentation." FullWidth="true" />
        </DetailsSection>
    </DemoSection>
    <DemoSection Title="Flat section" Description="Use a flat section inside an existing container." Code="@Example1" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <DetailsSection Title="Identifiers" Flat="true">
            <DetailsItem Label="Reference" Content="project-42" Copyable="true" IsCode="true" />
        </DetailsSection>
    </DemoSection>
</Grid>

@code {

    private const string Example0 = """
        <DetailsSection Title="Project">
            <DetailsItem Label="Name" Content="Website refresh" />
            <DetailsItem Label="Owner" Content="Design team" />
            <DetailsItem Label="Description" Content="Update the public website and documentation." FullWidth="true" />
        </DetailsSection>
        """;
    private const string Example1 = """
        <DetailsSection Title="Identifiers" Flat="true">
            <DetailsItem Label="Reference" Content="project-42" Copyable="true" IsCode="true" />
        </DetailsSection>
        """;
}
