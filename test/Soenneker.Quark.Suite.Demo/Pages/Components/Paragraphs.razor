@page "/components/paragraphs"

<QuarkSeoHead Title="Blazor Paragraph Typography &amp; Razor Example | Quark Suite" Description="Style body copy in Blazor with Quark Paragraph. View the rendered text and its Razor markup for adding consistent paragraph typography to your application." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Section Space="Space.Y.Is4">
        <DemoSection Code="@ParagraphCode"
                     CodeLanguage="razor">
            <Paragraph>
                The king, seeing how much happier his subjects were, realized the error of his ways and repealed the joke tax.
            </Paragraph>
        </DemoSection>
    </Section>
</Div>

@code {
    private const string ParagraphCode =
@"<Paragraph>
    The king, seeing how much happier his subjects were, realized the error of his ways and repealed the joke tax.
</Paragraph>";
}
