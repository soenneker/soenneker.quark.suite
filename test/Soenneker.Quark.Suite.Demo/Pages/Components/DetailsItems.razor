@page "/components/details-item"

<QuarkSeoHead Title="Blazor Details Item Examples | Quark Suite" Description="Display labeled values, links, code, or custom content." />

<Grid Columns="GridCols.Is1" Gap="Gap.Is6" MinWidth="MinWidth.Is0" Width="Width.IsFull">
    <DemoSection Title="Values and links" Description="Copying is explicitly enabled for the reference." Code="@Example0" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <DetailsSection Title="Record">
            <DetailsItem Label="Owner" Content="Operations" />
            <DetailsItem Label="Reference" Content="record-42" Copyable="true" IsCode="true" />
            <DetailsItem Label="Documentation" Content="Installation guide" IsLink="true" LinkUrl="/installation" />
        </DetailsSection>
    </DemoSection>
    <DemoSection Title="Custom content" Description="Use a slot for richer values." Code="@Example1" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <DetailsItem Label="Status"><Badge Tone="SemanticTone.Warning">Pending review</Badge></DetailsItem>
    </DemoSection>
</Grid>

