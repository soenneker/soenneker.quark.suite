@page "/components/page-header"

<QuarkSeoHead Title="Blazor Page Header: Titles, Actions &amp; Menus | Quark Suite" Description="Build consistent Blazor page headers with Quark PageHeader. Compose titles, descriptions, inline actions, and overflow menus using the live Razor examples." />

<Grid Columns="GridCols.Is1" Gap="Gap.Is6" MinWidth="MinWidth.Is0" Width="Width.IsFull">
    <DemoSection Title="Title and description" Description="Introduce an application page." Code="@Example0" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <PageHeader Title="Projects" Description="Manage the projects in your workspace." />
    </DemoSection>
    <DemoSection Title="Actions" Description="Combine status with an overflow menu." Code="@Example1" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <PageHeader Title="Project overview" Description="Activity and settings for your project.">
            <InlineActions><Badge Tone="SemanticTone.Success">Active</Badge></InlineActions>
            <Actions><DropdownItem Disabled="true">Archive project</DropdownItem></Actions>
        </PageHeader>
    </DemoSection>
</Grid>

@code {

    private const string Example0 = """
        <PageHeader Title="Projects" Description="Manage the projects in your workspace." />
        """;
    private const string Example1 = """
        <PageHeader Title="Project overview" Description="Activity and settings for your project.">
            <InlineActions><Badge Tone="SemanticTone.Success">Active</Badge></InlineActions>
            <Actions><DropdownItem Disabled="true">Archive project</DropdownItem></Actions>
        </PageHeader>
        """;
}
