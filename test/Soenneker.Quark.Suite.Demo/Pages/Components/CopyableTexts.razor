@page "/components/copyable-text"

<QuarkSeoHead Title="Blazor Copyable Text with Hover &amp; Focus Actions | Quark Suite" Description="Offer text copying in Blazor with Quark CopyableText. Reveal a copy action on hover or keyboard focus while preserving truncation in compact interfaces." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <DemoSection
        Description="Reveal a copy action on hover or keyboard focus without sacrificing text truncation."
        Code="@BasicCode"
        CodeLanguage="razor"
        PreviewClass="preview flex min-h-[14rem] w-full items-center justify-center p-10"
        PreviewInnerClass="demo-section-preview-inner flex w-full items-center justify-center">
        <Div Width="Width.Is64" Padding="Padding.Is4" Class="rounded-lg" Border="Border.Default">
            <CopyableText Text="@SampleText" Class="w-full" />
        </Div>
    </DemoSection>
</Div>

@code {
    private const string SampleText = "a-very-long-resource-identifier-that-will-be-truncated-but-copied-in-full";

    private const string BasicCode =
@"<Div Width=""Width.Is64"">
    <CopyableText Text=""@SampleText"" Class=""w-full"" />
</Div>";
}
