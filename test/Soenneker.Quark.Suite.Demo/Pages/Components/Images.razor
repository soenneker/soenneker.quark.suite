@page "/components/images"

<QuarkSeoHead Title="Blazor Image Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Image component. See live demos and Razor code examples for your application." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <DemoSection Code="@DefaultCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-96">
            <Image Source="@BallImage" Alt="Picture of a ball" Class="size-[297px]">
                <ImagePreview />
            </Image>
        </Div>
    </DemoSection>

    <DemoSection Title="Extension Override" Description="Replace the source filename extension while preserving its query string and fragment. The resulting URL must point to an existing image." Code="@ExtensionCode" CodeLanguage="razor">
        <Image Source="/icon.jpg" Extension="png" Alt="Quark Suite icon" Class="size-24" />
    </DemoSection>

    <DemoSection Title="With Overlay Actions" Code="@OverlayActionsCode" CodeLanguage="razor">
        <Div Display="Display.Flex" FlexWrap="FlexWrap.Wrap" ItemsAlign="Items.Center" Justify="Justify.Center" Gap="Gap.Is6" Class="min-h-96">
            <Image Source="@BallImage" Alt="Picture of a ball" Class="size-72">
                <ImagePreview />
                <ImageActions Align="block-start">
                    <ImageActionGroup>
                        <ImageAction>
                            <Icon Name="LucideIcon.Download" />
                            <Span Class="sr-only">Download</Span>
                        </ImageAction>
                        <ImageAction>
                            <Icon Name="LucideIcon.Copy" />
                            <Span Class="sr-only">Copy</Span>
                        </ImageAction>
                    </ImageActionGroup>
                    <ImageActionGroup>
                        <ImageAction ButtonSize="ButtonSize.Sm">
                            Edit
                        </ImageAction>
                    </ImageActionGroup>
                </ImageActions>
            </Image>

            <Image Source="@BallImage" Alt="Picture of a ball" Class="size-72">
                <ImagePreview />
                <ImageActions Align="block-end">
                    <ImageActionGroup>
                        <ImageAction>
                            <Icon Name="LucideIcon.Download" />
                            <Span Class="sr-only">Download</Span>
                        </ImageAction>
                        <ImageAction>
                            <Icon Name="LucideIcon.Copy" />
                            <Span Class="sr-only">Copy</Span>
                        </ImageAction>
                    </ImageActionGroup>
                    <ImageActionGroup>
                        <ImageAction ButtonSize="ButtonSize.Sm">
                            Edit
                        </ImageAction>
                    </ImageActionGroup>
                </ImageActions>
            </Image>
        </Div>
    </DemoSection>

    <DemoSection Title="External URL" Code="@ExternalUrlCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-96">
            <Image Source="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=512&amp;h=512&amp;fit=crop" Alt="Image loaded from external URL" Class="size-72">
                <ImagePreview />
            </Image>
        </Div>
    </DemoSection>

    <DemoSection Title="No Source Placeholder" Code="@PlaceholderCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-96">
            <Image Alt="Generated image placeholder" Class="size-72">
                <ImagePreview />
            </Image>
        </Div>
    </DemoSection>

    <DemoSection Title="Lightbox Preview" Code="@LightboxCode" CodeLanguage="razor">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Center" Class="min-h-96">
            <Image Source="@BallImage" Alt="Preview that opens in a lightbox" Class="size-72">
                <ImagePreview TriggerLightbox="true" />
                <ImageLightbox>
                    <ImageLightboxPreview />
                    <Div Position="Position.Absolute" Top="Top.Is4" Right="Right.Is4">
                        <ImageLightboxClose />
                    </Div>
                </ImageLightbox>
            </Image>
        </Div>
    </DemoSection>
</Div>

@code {
    private const string ExtensionCode = """
        <Image Source="/icon.jpg" Extension="png" Alt="Quark Suite icon" Class="size-24" />
        """;

    private const string BallImage = "data:image/png;base64,";

    private const string DefaultCode =
@"<Div Display=""Display.Flex"" ItemsAlign=""Items.Center"" Justify=""Justify.Center"" Class=""min-h-96"">
    <Image Source=""@BallImage"" Alt=""Picture of a ball"" Class=""size-[297px]"">
        <ImagePreview />
    </Image>
</Div>";

    private const string OverlayActionsCode =
@"<Div Display=""Display.Flex"" FlexWrap=""FlexWrap.Wrap"" ItemsAlign=""Items.Center"" Justify=""Justify.Center"" Gap=""Gap.Is6"" Class=""min-h-96"">
