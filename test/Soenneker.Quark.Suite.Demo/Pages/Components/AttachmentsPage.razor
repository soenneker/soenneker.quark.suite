@page "/components/attachments"

<SeoHead Title="Blazor Attachments Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Attachments component. Composable attachment UI for chat and messaging." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Section Space="Space.Y.Is4">
        <DemoSection
                     Description="Composable attachment UI for chat and messaging."
                     Code="@BasicCode"
                     CodeLanguage="razor">
            <Div Margin="Margin.OnX.Auto" Display="Display.Flex" Width="Width.IsFit" FlexDirection="FlexDirection.Col" ItemsAlign="Items.Center" Justify="Justify.Center" Gap="Gap.Is4">
                <Attachments>
                    <Attachment Name="photo.jpg" Variant="compact" />
                    <Attachment Name="notes.txt" Variant="compact" />
                    <Attachment Name="clip.mp4" Variant="compact" />
                    <Attachment Name="song.mp3" Variant="compact" />
                </Attachments>
            </Div>
        </DemoSection>
    </Section>
</Div>

@code {
    private const string BasicCode =
@"<Div Margin=""Margin.OnX.Auto"" Display=""Display.Flex"" Width=""Width.IsFit"" FlexDirection=""FlexDirection.Col"" ItemsAlign=""Items.Center"" Justify=""Justify.Center"" Gap=""Gap.Is4"">
    <Attachments>
        <Attachment Name=""photo.jpg"" Variant=""compact"" />
        <Attachment Name=""notes.txt"" Variant=""compact"" />
        <Attachment Name=""clip.mp4"" Variant=""compact"" />
        <Attachment Name=""song.mp3"" Variant=""compact"" />
    </Attachments>
</Div>";
}
