@page "/components/scores"

<SeoHead Title="Blazor Score Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Score component. Score component with gradient coloring and partial circle fill." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Div Space="Space.Y.Is6">
        <Section Space="Space.Y.Is4">
            <DemoSection Title="Live Progress" Description="Change the score to preview a larger progress update." Code="@(@"<Score Value=""@_progress"" Colored=""false"" />
<Button OnClick=""@(() => _progress = _progress == 5 ? 40 : 5)"">Toggle 5% / 40%</Button>

@code {
    private int _progress = 5;
}")" CodeLanguage="razor">
                <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is4">
                    <Score Value="@_progress" Colored="false" />
                    <Score Value="@_progress" ScoreSize="28" Thickness="3" Colored="false" />
                    <Button OnClick="@(() => _progress = _progress == 5 ? 40 : 5)">Toggle 5% / 40%</Button>
                </Div>
            </DemoSection>
        </Section>
        <Section Space="Space.Y.Is4">
            <DemoSection Title="Basic Scores" Description="Score component with gradient coloring and partial circle fill." Code="@(@"<Div Margin=""Margin.Is3.FromEnd"">
    <Div Display=""Display.Flex"" FlexWrap=""FlexWrap.Wrap"" Justify=""Justify.Center"" Style=""gap: 1.5rem;"">
        <Score Value=""15"" Text=""Risk""/>
        <Score Value=""35"" Text=""Stability""/>
        <Score Value=""50"" Text=""Completion""/>
        <Score Value=""70"" Text=""Quality""/>
        <Score Value=""88"" Text=""Health""/>
        <Score Value=""100"" Text=""Perfect""/>
    </Div>
</Div>")"
CodeLanguage="razor">
                <Div Margin="Margin.Is3.FromEnd">
                    <Div Display="Display.Flex" FlexWrap="FlexWrap.Wrap" Justify="Justify.Center" Style="gap: 1.5rem;">
                        <Score Value="15" Text="Risk"/>
                        <Score Value="35" Text="Stability"/>
                        <Score Value="50" Text="Completion"/>
                        <Score Value="70" Text="Quality"/>
                        <Score Value="88" Text="Health"/>
                        <Score Value="100" Text="Perfect"/>
                    </Div>
                </Div>
            </DemoSection>
        </Section>

        <Section Space="Space.Y.Is4">
            <DemoSection Title="Neutral Scores" Description="Disable value-based coloring with Colored=&quot;false&quot;." Code="@(@"<Div Margin=""Margin.Is3.FromEnd"">
    <Div Display=""Display.Flex"" FlexWrap=""FlexWrap.Wrap"" Justify=""Justify.Center"" Style=""gap: 1.5rem;"">
        <Score Value=""25"" Text=""Low"" Colored=""false"" />
        <Score Value=""58"" Text=""Medium"" Colored=""false"" />
        <Score Value=""92"" Text=""High"" Colored=""false"" />
    </Div>
</Div>")"
CodeLanguage="razor">
                <Div Margin="Margin.Is3.FromEnd">
                    <Div Display="Display.Flex" FlexWrap="FlexWrap.Wrap" Justify="Justify.Center" Style="gap: 1.5rem;">
                        <Score Value="25" Text="Low" Colored="false" />
                        <Score Value="58" Text="Medium" Colored="false" />
                        <Score Value="92" Text="High" Colored="false" />
                    </Div>
                </Div>
            </DemoSection>
        </Section>

        <Section Space="Space.Y.Is4">
            <DemoSection Title="Size + Thickness" Description="Custom Size and Thickness for the score circle." Code="@(@"<Div Margin=""Margin.Is3.FromEnd"">
    <Div Display=""Display.Flex"" FlexWrap=""FlexWrap.Wrap"" Justify=""Justify.Center"" Style=""gap: 2rem;"">
        <Score Value=""42"" Text=""Compact"" ScoreSize=""72"" Thickness=""6"" />
        <Score Value=""64"" Text=""Default"" />
        <Score Value=""82"" Text=""Large"" ScoreSize=""120"" Thickness=""12"" />
    </Div>
</Div>")"
CodeLanguage="razor">
                <Div Margin="Margin.Is3.FromEnd">
                    <Div Display="Display.Flex" FlexWrap="FlexWrap.Wrap" Justify="Justify.Center" Style="gap: 2rem;">
                        <Score Value="42" Text="Compact" ScoreSize="72" Thickness="6" />
                        <Score Value="64" Text="Default" />
                        <Score Value="82" Text="Large" ScoreSize="120" Thickness="12" />
                    </Div>
                </Div>
            </DemoSection>
        </Section>
    </Div>
</Div>

@code {
    private int _progress = 5;
}
