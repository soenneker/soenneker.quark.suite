@page "/components/realtime-charts"

<PageTitle>Realtime Charts - Quark Suite</PageTitle>

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is6xl">
    <DemoSection Title="Realtime donut chart"
                 Description="Update current slice totals with RealtimeRadialChartData, bind Version to DataVersion, and request a render on the Blazor dispatcher. The same data supports ChartType.Pie.">
        <div class="w-full max-w-4xl rounded-xl border bg-card p-4 sm:p-6">
            <RealtimeRadialChartExample />
        </div>
    </DemoSection>

    <DemoSection Title="Realtime line chart"
                 Description="A bounded timestamp buffer keeps the latest 60 samples, preserves legend selections, and updates proportional time spacing. Append samples on the Blazor dispatcher, bind Version to DataVersion, and request a render. Disable entrance animation for live updates.">
        <div class="w-full max-w-4xl rounded-xl border bg-card p-4 sm:p-6">
            <RealtimeChartExample />
        </div>
    </DemoSection>
</Div>
