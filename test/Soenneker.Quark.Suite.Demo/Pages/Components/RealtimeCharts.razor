@page "/components/realtime-charts"

<PageTitle>Realtime Charts - Quark Suite</PageTitle>

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is6xl">
    <DemoSection Title="Realtime donut chart"
                 Description="Update current slice totals with RealtimeRadialChartData, bind Version to DataVersion, and request a render on the Blazor dispatcher. The same data supports ChartType.Pie.">
        <div class="w-full max-w-4xl rounded-xl border bg-card p-4 sm:p-6">
            <RealtimeRadialChartExample />
        </div>
    </DemoSection>

    <DemoSection Title="Realtime line chart"
                 Code="@ScrollingCode"
                 Description="The line chart updates every 500 ms. Press and drag to pause the feed and select a time range, with dots kept visible. Enable expansion to fill the chart with your selected range, then reset the zoom or resume live updates.">
        <div class="w-full max-w-4xl rounded-xl border bg-card p-4 sm:p-6">
            <RealtimeChartExample />
        </div>
    </DemoSection>
</Div>

@code {
    private const string ScrollingCode = """
<Chart Series="@data.Series" Labels="@data.Labels" XValues="@data.XValues"
       DataVersion="@data.Version" Options="@options" @bind-ScrollPaused="paused" />

@code {
    private readonly ChartOptions options = new()
    {
        Animate = false,
        EnableRealtimeScrolling = true,
        EnableRangeSelection = true,
        PauseOnRangeSelection = true,
        ShowPoints = true,
        ZoomOnRangeSelection = true,
        RealtimeScrollDuration = TimeSpan.FromMilliseconds(500),
        Minimum = 60,
        Maximum = 140,
        Curve = ChartCurve.Monotone
    };
}
// Keep the visible X span and Y bounds stable so retained samples can translate.
// Bind paused to your feed's pause state to stop collecting samples when dragging starts.
// ZoomOnRangeSelection expands the selected range; call chart.ResetZoom() to restore it.
// The library loads and disposes its scrolling module automatically.
""";
}
