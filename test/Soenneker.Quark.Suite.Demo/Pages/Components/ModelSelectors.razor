@page "/components/model-selectors"

<SeoHead Title="Blazor Model Selector Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Model Selector component. Dropdown for selecting AI models." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Section Space="Space.Y.Is4">
        <DemoSection
                     Description="Dropdown for selecting AI models."
                     Code="@BasicCode"
                     CodeLanguage="razor">
            <Div Display="Display.Flex" Justify="Justify.Center">
                <ModelSelector @bind-Value="_model" />
            </Div>
        </DemoSection>
    </Section>
</Div>

@code {
    private string? _model = "gpt-4";

    private const string BasicCode =
@"<Div Display=""Display.Flex"" Justify=""Justify.Center"">
    <ModelSelector @bind-Value=""_model"" />
</Div>";
}
