@page "/components/popover-smoke"
@using Soenneker.Razor.Sitemap
@attribute [Sitemap(Exclude = true)]

<SeoHead Title="Blazor Popover Smoke Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Popover Smoke component. See live demos and Razor code examples for your application." NoIndex="true" />

<Div Padding="Padding.Is6">
    <Span Id="playwright-ready" ScreenReader="ScreenReader.Only">ready</Span>

    <Popover DefaultOpen="true">
        <PopoverTrigger AsChild="true">
            <Button Variant="ButtonVariant.Outline">Open popover</Button>
        </PopoverTrigger>
        <PopoverContent Width='Width.Token("40")'>
            Smoke content
        </PopoverContent>
    </Popover>
</Div>
