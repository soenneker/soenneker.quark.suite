@page "/components/main"

<QuarkSeoHead Title="Blazor Main: Primary Content Landmark | Quark Suite" Description="Use Quark Main for a page's primary content landmark. Explore layout usage, styling, and its relationship to Section and Aside." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Paragraph>Main renders a native main element for the page's primary content and supports Quark styling parameters and child content.</Paragraph>

    <Section Space="Space.Y.Is4">
        <H2>Live example</H2>
        <Paragraph>This page is already inside the demo layout's Main component. The navigation sidebar sits outside it. Inspect the page to find the main element with data-slot="main" surrounding this content.</Paragraph>
        <Paragraph>Place Main in your layout so each page shares one primary content landmark. Keep site navigation outside Main and avoid nesting Main components.</Paragraph>
    </Section>

    <Section Space="Space.Y.Is4">
        <H2>Layout usage</H2>
        <Paragraph>Use this in a Razor layout to wrap its page body with a centered, padded content area.</Paragraph>
        <CodeViewer Text="@LayoutCode" FormatJson="false" MinLines="9" MaxLines="14" AriaLabel="Main component Razor layout example" />
    </Section>

    <Section Space="Space.Y.Is4">
        <H2>Related components</H2>
        <Paragraph>Use <Anchor Href="components/sections" DecorationLine="DecorationLine.Underline">Section</Anchor> to group content within Main, and <Anchor Href="components/asides" DecorationLine="DecorationLine.Underline">Aside</Anchor> for complementary content.</Paragraph>
    </Section>
</Div>

@code {
    private const string LayoutCode = """
@inherits LayoutComponentBase

<Main Margin="Margin.OnX.Auto"
      MaxWidth="MaxWidth.Is4xl"
      Width="Width.IsFull"
      Padding="Padding.Is6">
    @Body
</Main>
""";
}
