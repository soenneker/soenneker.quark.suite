@page "/components/compositions"

<QuarkSeoHead Title="Blazor UI Patterns &amp; Component Compositions | Quark Suite" Description="Browse Quark&#x27;s Blazor composition examples for page headers, detail views, form groups, empty states, and data displays built from reusable UI components." />

<Grid Columns="GridCols.Is1" Gap="Gap.Is6" Width="Width.IsFull">
    <Paragraph TextColor="TextColor.MutedForeground">Compositions combine components into common application patterns: page headers, detail views, form groups, state displays, and data presentation. This category describes how components are assembled, regardless of whether a similar pattern exists in shadcn.</Paragraph>
    <Grid Columns="GridCols.Is1.OnSm.Is2" Gap="Gap.Is4">
        @foreach (var item in DocsNavigation.CompositionLinks.Where(item => item.Href != "components/compositions"))
        {
            <Anchor Href="@item.Href">@item.Title</Anchor>
        }
    </Grid>
</Grid>
