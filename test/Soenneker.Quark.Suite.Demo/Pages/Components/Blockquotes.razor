@page "/components/blockquotes"

<QuarkSeoHead Title="Blazor Blockquote &amp; Quotation Styling | Quark Suite" Description="Style quotations in Blazor with Quark Blockquote. View the rendered quotation and its Razor markup to add a consistent blockquote to your application." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Section Space="Space.Y.Is4">
        <DemoSection Code="@BlockquoteCode"
                     CodeLanguage="razor">
            <Blockquote>
                "After all," he said, "everyone enjoys a good joke, so it's only fair that they should pay for the privilege."
            </Blockquote>
        </DemoSection>
    </Section>
</Div>

@code {
    private const string BlockquoteCode =
@"<Blockquote>
    ""After all,"" he said, ""everyone enjoys a good joke, so it's only fair that they should pay for the privilege.""
</Blockquote>";
}
