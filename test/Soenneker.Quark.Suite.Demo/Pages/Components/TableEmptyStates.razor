@page "/components/table-empty-state"

<SeoHead Title="Blazor Table Empty State Examples | Quark Suite" Description="Show empty or error messages spanning table columns." />

<Grid Columns="GridCols.Is1" Gap="Gap.Is6" MinWidth="MinWidth.Is0" Width="Width.IsFull">
    <DemoSection Title="Empty table" Description="Match ColSpan to the number of table columns." Code="@Example0" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <Table>
            <Thead><Tr><Th>Name</Th><Th>Status</Th></Tr></Thead>
            <Tbody><TableEmptyState ColSpan="2" Title="No projects" Description="There are no projects to display." /></Tbody>
        </Table>
    </DemoSection>
    <DemoSection Title="Error state" Description="Keep recovery guidance inside the table." Code="@Example1" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <Table>
            <Thead><Tr><Th>Name</Th><Th>Status</Th></Tr></Thead>
            <Tbody><TableEmptyState ColSpan="2" Kind="EmptyStateKind.Error" Title="Could not load projects">
                <Actions><Anchor Href="/troubleshooting">Get help</Anchor></Actions>
            </TableEmptyState></Tbody>
        </Table>
    </DemoSection>
</Grid>

@code {

    private const string Example0 = """
        <Table>
            <Thead><Tr><Th>Name</Th><Th>Status</Th></Tr></Thead>
            <Tbody><TableEmptyState ColSpan="2" Title="No projects" Description="There are no projects to display." /></Tbody>
        </Table>
        """;
    private const string Example1 = """
        <Table>
            <Thead><Tr><Th>Name</Th><Th>Status</Th></Tr></Thead>
            <Tbody><TableEmptyState ColSpan="2" Kind="EmptyStateKind.Error" Title="Could not load projects">
                <Actions><Anchor Href="/troubleshooting">Get help</Anchor></Actions>
            </TableEmptyState></Tbody>
        </Table>
        """;
}
