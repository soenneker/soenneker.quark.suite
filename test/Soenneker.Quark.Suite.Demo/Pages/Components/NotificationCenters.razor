        new("handoff", "Design handoff", "Sam assigned you the release checklist.", DateTimeOffset.UtcNow.AddHours(-1), Group: "Assignments", ActionLabel: "View checklist"),
        new("release", "Release published", "Version 2.4 is available to the team.", DateTimeOffset.UtcNow.AddHours(-3), Group: "Activity"),
        new("invite", "Invitation accepted", "Morgan joined the design workspace.", DateTimeOffset.UtcNow.AddDays(-1), true, "Activity"),
        new("sync", "Import complete", "The account directory is up to date.", DateTimeOffset.UtcNow.AddDays(-2), true, "Activity")
    ];
