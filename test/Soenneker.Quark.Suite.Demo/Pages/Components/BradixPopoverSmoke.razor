@page "/components/bradix-popover-smoke"
@using Soenneker.Razor.Sitemap
@attribute [Sitemap(Exclude = true)]

<SeoHead Title="Blazor Bradix Popover Smoke Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Bradix Popover Smoke component. See live demos and Razor code examples for your application." NoIndex="true" />

<Div Padding="Padding.Is6">
    <Span Id="playwright-ready" ScreenReader="ScreenReader.Only">ready</Span>

    <BradixPopover DefaultOpen="true">
        <BradixPopoverTrigger>
            Open popover
        </BradixPopoverTrigger>
        <BradixPopoverPortal>
            <BradixPopoverContent Width='Width.Token("40")'>
                Smoke content
            </BradixPopoverContent>
        </BradixPopoverPortal>
    </BradixPopover>
</Div>
