@page "/components/headers"
@inject Services.ThemeService ThemeService

<QuarkSeoHead Title="Blazor Header Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Header component. A basic application header built from the suite components." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is5xl">
    <Section Space="Space.Y.Is3">
        <Div Space="Space.Y.Is2">
            <Paragraph MaxWidth="MaxWidth.Is3xl" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                `Header` gives you a reusable top shell with consistent layout, while `HeaderBrand`, `NavigationLinks`, `HeaderActionLink`, and
                `ThemeToggleButton` keep the common styling out of app layouts.
            </Paragraph>
        </Div>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Composed header"
                     Description="A basic application header built from the suite components."
                     Code="@ComposedHeaderCode"
                     CodeLanguage="razor">
            <Div Class="rounded-2xl shadow-sm" Overflow="Overflow.Hidden" Border="Border.Default" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                <Header Position="Position.Relative">
                    <BrandContent>
                        <HeaderBrand Href=""
                                     AriaLabel="Quark Suite home"
                                     ImageSource="https://user-images.githubusercontent.com/4441470/224455560-91ed3ee7-f510-4041-a8d2-3fc093025112.png"
                                     ImageAlt="Soenneker Quark Suite"
                                     Title="Soenneker Quark Suite"
                                     Subtitle="Reusable app shell pieces" />
                    </BrandContent>
                    <NavigationContent>
                        <NavigationLinks Items="_headerLinks"
                                         Mode="NavigationLinksMode.Header"
                                         IsActive="IsHeaderLinkActive" />
                    </NavigationContent>
                    <ActionsContent>
                        <HeaderActionLink Href="https://github.com/soenneker/soenneker.quark.suite"
                                          Target="Target.Blank"
                                          Rel="noreferrer"
                                          Label="GitHub"
                                          AriaLabel="View Soenneker Quark Suite on GitHub">
                            <IconContent>
                                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M12 .5C5.65.5.5 5.65.5 12A11.5 11.5 0 0 0 8.36 22.9c.57.1.78-.25.78-.56 0-.28-.01-1.2-.02-2.18-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.53-2.55-.29-5.23-1.27-5.23-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a10.97 10.97 0 0 1 5.77 0c2.2-1.5 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.82 1.18 3.08 0 4.42-2.69 5.39-5.25 5.67.41.35.78 1.04.78 2.1 0 1.52-.01 2.75-.01 3.12 0 .31.21.67.79.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
                                </svg>
                            </IconContent>
                        </HeaderActionLink>
                        <Separator Orientation="SeparatorOrientation.Vertical" />
                        <ThemeToggleButton Mode="ThemeService.Mode"
                                           AriaLabel="Toggle theme"
                                           ModeChanged="ThemeService.SetMode" />
                    </ActionsContent>
                </Header>
            </Div>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Header with sidebar shell"
                     Description="The header can sit above a sidebar provider and expose the standard sidebar trigger without each layout restyling it."
                     Code="@ShellHeaderCode"
                     CodeLanguage="razor">
            <Div Class="rounded-2xl shadow-sm" Overflow="Overflow.Hidden" Border="Border.Default" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                <SidebarProvider Class="flex h-[360px] flex-col overflow-hidden bg-background text-foreground"
                                 SidebarWidth="calc(var(--spacing) * 64)"
                                 style="--header-height: 3.5rem;">
                    <Header ShowSidebarTrigger="true" Position="Position.Relative">
                        <BrandContent>
                            <HeaderBrand Href=""
                                         AriaLabel="Acme home"
                                         Title="Acme Control"
                                         Subtitle="Workspace shell" />
                        </BrandContent>
                        <NavigationContent>
                            <NavigationLinks Items="_workspaceLinks"
                                             Mode="NavigationLinksMode.Header"
                                             IsActive="IsWorkspaceLinkActive" />
                        </NavigationContent>
                        <ActionsContent>
                            <Button Type="ButtonType.Button"
                                    data-slot="button"
                                    Class="outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 has-[>svg]:px-3 rounded-lg shadow-none" Variant="ButtonVariant.Outline" ButtonSize="ButtonSize.Default" Display="Display.InlineFlex" Shrink="Shrink.Is0" ItemsAlign="Items.Center" Gap="Gap.Is2" TextSize="TextSize.Sm" Whitespace="Whitespace.Nowrap" Transition="Transition.All" BorderColor="BorderColor.OnFocusVisible.Ring.OnDark.Input" PointerEvents="PointerEvents.OnDisabled.None" Opacity="Opacity.OnDisabled.Is50" Border="Border.Default" BackgroundColor='BackgroundColor.Background.OnDark.OnHover.Token("input/50")' TextColor="TextColor.OnHover.AccentForeground" Padding="Padding.OnX.Is4.OnY.Is2" Height="Height.Is8">
                                Share
                            </Button>
                            <Button Type="ButtonType.Button"
                                    data-slot="button"
                                    Class="group/button bg-clip-padding outline-none select-none focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [a]:hover:bg-primary/80 in-data-[slot=button-group]:rounded-lg has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3.5 rounded-lg" Variant="ButtonVariant.Default" ButtonSize="ButtonSize.Sm" Display="Display.InlineFlex" Shrink="Shrink.Is0" ItemsAlign="Items.Center" Justify="Justify.Center" Border="Border.Default" BorderColor="BorderColor.Transparent.OnFocusVisible.Ring" FontWeight="FontWeight.Medium" Whitespace="Whitespace.Nowrap" Transition="Transition.All" PointerEvents="PointerEvents.OnDisabled.None" Opacity="Opacity.OnDisabled.Is50" BackgroundColor="BackgroundColor.Primary" TextColor="TextColor.PrimaryForeground" Gap="Gap.Is1" Padding="Padding.OnX.Is2_5" TextSize='TextSize.Token("[0.8rem]")' Height='Height.Token("[31px]")'>
                                Deploy
                            </Button>
                        </ActionsContent>
                    </Header>

                    <Div Display="Display.Flex" MinHeight="MinHeight.Is0" Flex="Flex.Is1">
                        <Sidebar Contained="true">
                            <SidebarHeader>
                                <SidebarInput Placeholder="Search..." Type="search" />
                            </SidebarHeader>
                            <SidebarContent>
                                <NavigationLinks Items="_workspaceSidebarLinks"
                                                 Mode="NavigationLinksMode.Sidebar"
                                                 Title="Workspace"
                                                 GroupClass="pt-2"
                                                 IsActive="IsWorkspaceLinkActive" />
                            </SidebarContent>
                        </Sidebar>

                        <SidebarInset>
                            <Div Display="Display.Flex" Height="Height.IsFull" ItemsAlign="Items.Center" Justify="Justify.Center" Padding="Padding.Is6" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                                Use the trigger in the header to toggle the sidebar.
                            </Div>
                        </SidebarInset>
                    </Div>
                </SidebarProvider>
            </Div>
        </DemoSection>
    </Section>
</Div>

@code {
