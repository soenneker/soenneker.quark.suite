@implements IAsyncDisposable
@using System.Threading

<Chart Series="@_data.Series" Labels="@_data.Labels" Type="ChartType.Donut" DataVersion="@_data.Version"
       Options="@Options" AriaLabel="Live request status">
    <HeaderContent>
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Between" Gap="Gap.Is4" Margin="Margin.FromBottom.Is4">
            <Div>
                <Div TextSize="TextSize.Sm" FontWeight="FontWeight.Medium">Live request status</Div>
                <Div TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Current totals · updates every second</Div>
            </Div>
            <Button Type="ButtonType.Button" Class="rounded-md" OnClick="TogglePaused" Variant="ButtonVariant.Outline" Border="Border.Default" Padding="Padding.OnX.Is3.OnY.Is1" TextSize="TextSize.Sm">@(_paused ? "Resume" : "Pause")</Button>
        </Div>
    </HeaderContent>
</Chart>

@code {
    private readonly RealtimeRadialChartData _data = new("Requests", "Completed", "Processing", "Failed");
    private readonly CancellationTokenSource _cancellation = new();
    private Task? _updates;
    private bool _paused;
    private static readonly ChartOptions Options = new()
    {
        Animate = false
    };

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _updates = UpdateAsync();
    }

    private void TogglePaused() => _paused = !_paused;

    private async Task UpdateAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_cancellation.Token))
            {
                await InvokeAsync(() =>
                {
                    if (_paused || _cancellation.IsCancellationRequested)
                        return;
                    _data.Update(Random.Shared.Next(50, 100), Random.Shared.Next(10, 40), Random.Shared.Next(1, 10));
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cancellation.CancelAsync();
        if (_updates is not null)
            await _updates;
        _cancellation.Dispose();
    }
}

