@page "/components/sidebar"

<SeoHead Title="Blazor Sidebar Component &amp; Examples | Quark Suite" Description="Explore the Quark Suite Blazor Sidebar component. This page exercises the core menu composition: button-as-child links, group action, menu action, badge, submenu, footer, and rail." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is5xl">
    <Section Space="Space.Y.Is3">
        <Paragraph MaxWidth="MaxWidth.Is3xl" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
            A composable, themeable and customizable sidebar component.
        </Paragraph>
    </Section>

    <Section Space="Space.Y.Is4">
        <Figure Class="flex flex-col gap-4">
            <Div Width="Width.IsFull" Class="rounded-xl" Height='Height.Token("[25rem]")' Overflow="Overflow.Hidden" Border="Border.Default" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                <SidebarProvider DefaultOpen="true" Class="h-full">
                    <Sidebar Collapsible="SidebarCollapsible.Icon" Contained="true" Resizable="true"
                             MinResizeWidth="192" MaxResizeWidth="400" ResizeStorageKey="quark-demo-sidebar-width" @bind-ExpandedWidth="_resizableWidth">
                        <SidebarHeader>
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Variant="SidebarMenuButtonVariant.Outline" ButtonSize="SidebarMenuButtonSize.Lg" Tooltip="Acme Inc">
                                        <Span Class="aspect-square rounded-lg group-data-[collapsible=icon]:size-4 group-data-[collapsible=icon]:group-hover:opacity-0" Display="Display.Flex" Size="Size.Is8" ItemsAlign="Items.Center" Justify="Justify.Center" BackgroundColor='BackgroundColor.Token("blue-600")' TextColor="TextColor.White" Transition="Transition.Opacity">
                                            <Icon Name="LucideIcon.BriefcaseBusiness" Class="size-4" />
                                        </Span>
                                        <Div Class="group-data-[collapsible=icon]:hidden" Display="Display.Grid" Flex="Flex.Is1" TextAlign="TextAlign.Left" TextSize="TextSize.Sm" Leading="Leading.Tight">
                                            <Span Class="truncate" FontWeight="FontWeight.Semibold">Acme Inc</Span>
                                            <Span Class="truncate" TextSize="TextSize.Xs">Enterprise</Span>
                                        </Div>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarHeader>

                        <SidebarContent>
                            <SidebarGroup>
                                <SidebarGroupLabel>Platform</SidebarGroupLabel>
                                <SidebarGroupContent>
                                    <SidebarMenu>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton Open="true">
                                                <Icon Name="LucideIcon.SquareTerminal" Class="size-4" />
                                                <Span>Playground</Span>
                                                <Icon Name="LucideIcon.ChevronDown" Class="ml-auto size-4" />
                                            </SidebarMenuButton>
                                            <SidebarMenuSub>
                                                <SidebarMenuSubItem>
                                                    <SidebarMenuSubButton>History</SidebarMenuSubButton>
                                                </SidebarMenuSubItem>
                                                <SidebarMenuSubItem>
                                                    <SidebarMenuSubButton>Starred</SidebarMenuSubButton>
                                                </SidebarMenuSubItem>
                                                <SidebarMenuSubItem>
                                                    <SidebarMenuSubButton>Settings</SidebarMenuSubButton>
                                                </SidebarMenuSubItem>
                                            </SidebarMenuSub>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton>
                                                <Icon Name="LucideIcon.Bot" Class="size-4" />
                                                <Span>Models</Span>
                                                <Icon Name="LucideIcon.ChevronRight" Class="ml-auto size-4" />
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton>
                                                <Icon Name="LucideIcon.BookOpen" Class="size-4" />
                                                <Span>Documentation</Span>
                                                <Icon Name="LucideIcon.ChevronRight" Class="ml-auto size-4" />
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton>
                                                <Icon Name="LucideIcon.Settings2" Class="size-4" />
                                                <Span>Settings</Span>
                                                <Icon Name="LucideIcon.ChevronRight" Class="ml-auto size-4" />
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                    </SidebarMenu>
                                </SidebarGroupContent>
                            </SidebarGroup>
                        </SidebarContent>

                        <SidebarFooter>
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton ButtonSize="SidebarMenuButtonSize.Lg">
                                        <Span Class="aspect-square rounded-full bg-sidebar-accent" Display="Display.Flex" Size="Size.Is8" ItemsAlign="Items.Center" Justify="Justify.Center" TextSize="TextSize.Xs" FontWeight="FontWeight.Semibold">sh</Span>
                                        <Div Display="Display.Grid" Flex="Flex.Is1" TextAlign="TextAlign.Left" TextSize="TextSize.Sm" Leading="Leading.Tight">
                                            <Span Class="truncate" FontWeight="FontWeight.Semibold">shadcn</Span>
                                            <Span Class="truncate" TextSize="TextSize.Xs">m@example.com</Span>
                                        </Div>
                                        <Icon Name="LucideIcon.ChevronsUpDown" Class="ml-auto size-4" />
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarFooter>

                        <SidebarRail ShowTrigger="true" />
                    </Sidebar>

                    <SidebarInset>
                    </SidebarInset>
                </SidebarProvider>
            </Div>
            <Figcaption Class="text-center text-sm text-gray-500">
                Drag the sidebar�s inner edge to resize, or focus it and use the arrow keys. The chosen width is retained when collapsing to icons.
            </Figcaption>
        </Figure>
    </Section>

    <Section Space="Space.Y.Is3">
        <H2 TextSize="TextSize.Xl" FontWeight="FontWeight.Semibold">Resizable sidebar</H2>
        <Paragraph TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
            Set Resizable to enable desktop resizing. MinResizeWidth and MaxResizeWidth are pixel limits.
            Bind ExpandedWidth to track the chosen width; null starts with the provider�s SidebarWidth.
            Set ResizeStorageKey to a unique localStorage key to restore the width after refreshing.
            A saved width takes precedence over the initial width and is clamped to the current limits.
            Arrow keys move the edge by 8 pixels, Shift accelerates to 32 pixels, and Home/End select the limits.
            Mobile drawers and collapsed sidebars do not show the resize handle.
        </Paragraph>
        <CodeEditor ReadOnly="true" Language="text" AutoHeight="true" MinLines="5" Text="@ResizableSidebarCode" />
    </Section>

    <Section Space="Space.Y.Is4">
        <Paragraph TextSize="TextSize.Lg">
            Sidebars are one of the most complex components to build. They are central to any application and often contain a lot of moving parts.
        </Paragraph>

        <Paragraph TextSize="TextSize.Lg">
            We now have a solid foundation to build on top of. Composable. Themeable. Customizable.
        </Paragraph>
    </Section>

    <Section Space="Space.Y.Is4">
        <Div Space="Space.Y.Is2">
            <H2 TextSize="TextSize.Xl" FontWeight="FontWeight.Semibold">Composition</H2>
            <Paragraph TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                Use the following structure to build a sidebar layout.
            </Paragraph>
        </Div>

        <CodeEditor ReadOnly="true"
                    Language="text"
                    AutoHeight="true"
                    MinLines="12"
                    Text="@SidebarCompositionCode"
                    Class="w-full rounded-xl border border-border bg-muted/20 text-sm" />

        <UnorderedList Space="Space.Y.Is2" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
            <UnorderedListItem>`SidebarProvider` owns the shared open, mobile, and keyboard-shortcut state.</UnorderedListItem>
            <UnorderedListItem>`Sidebar`, `SidebarHeader`, `SidebarContent`, and `SidebarFooter` form the actual shell.</UnorderedListItem>
            <UnorderedListItem>`SidebarMenuButton`, `SidebarMenuAction`, `SidebarMenuBadge`, and `SidebarMenuSub` cover the menu composition.</UnorderedListItem>
            <UnorderedListItem>`SidebarInset` and `SidebarTrigger` keep the main content area wired to the same provider.</UnorderedListItem>
        </UnorderedList>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection
                     Description="This page exercises the core menu composition: button-as-child links, group action, menu action, badge, submenu, footer, and rail."
                     Code="@ComposedMenuCode"
                     CodeLanguage="razor">
            <Div id="sidebar-composed-demo" Width="Width.IsFull" Overflow="Overflow.Hidden" Rounded="Rounded.Xl" Border="Border.Is1" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                <SidebarProvider Open="_composedSidebarOpen" OpenChanged="OnComposedSidebarOpenChanged" Class="h-[31rem]">
                    <Sidebar Collapsible="SidebarCollapsible.None">
                        <SidebarHeader>
                            <Paragraph Padding="Padding.Is2.OnX" TextSize="TextSize.Sm" FontWeight="FontWeight.Semibold">Workspace</Paragraph>
                            <SidebarInput Placeholder="Search..." Type="search" />
                        </SidebarHeader>

                        <SidebarContent>
                            <SidebarGroup>
                                <SidebarGroupLabel>Platform</SidebarGroupLabel>
                                <SidebarGroupAction AsChild="true">
                                    <Button Variant="ButtonVariant.Ghost" ButtonSize="ButtonSize.IconXs">
                                        <Icon Name="LucideIcon.Plus" Size="Quark.Size.Is4" />
                                        <Span class="sr-only">Add project</Span>
                                    </Button>
                                </SidebarGroupAction>
                                <SidebarGroupContent>
                                    <SidebarMenu>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton AsChild="true" Active="true" Tooltip="Dashboard">
                                                <Anchor Href="">
                                                    <Icon Name="LucideIcon.House" Size="Quark.Size.Is4" />
                                                    <Span>Dashboard</Span>
                                                </Anchor>
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton Open="_workspaceMenuOpen" OnClick="ToggleWorkspaceMenu" Tooltip="Projects">
                                                <Icon Name="LucideIcon.Folder" Size="Quark.Size.Is4" />
                                                <Span>Projects</Span>
                                                <Icon Name="LucideIcon.ChevronRight" Class="@($"ml-auto size-4 transition-transform {(_workspaceMenuOpen ? "rotate-90" : string.Empty)}")" />
                                            </SidebarMenuButton>
                                            <SidebarMenuAction AsChild="true" ShowOnHover="true">
                                                <Button Variant="ButtonVariant.Ghost" ButtonSize="ButtonSize.IconXs">
                                                    <Icon Name="LucideIcon.Plus" Size="Quark.Size.Is4" />
                                                    <Span class="sr-only">Create project</Span>
                                                </Button>
                                            </SidebarMenuAction>
                                            @if (_workspaceMenuOpen)
                                            {
                                                <SidebarMenuSub>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton AsChild="true">
                                                            <Anchor Href="card">
                                                                <Span>Design System</Span>
                                                            </Anchor>
                                                        </SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                    <SidebarMenuSubItem>
                                                        <SidebarMenuSubButton AsChild="true" Active="true">
                                                            <Anchor Href="sidebar">
                                                                <Span>Sidebar Refresh</Span>
                                                            </Anchor>
                                                        </SidebarMenuSubButton>
                                                    </SidebarMenuSubItem>
                                                </SidebarMenuSub>
                                            }
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton AsChild="true" Tooltip="Inbox">
                                                <Anchor Href="input">
                                                    <Icon Name="LucideIcon.Mail" Size="Quark.Size.Is4" />
                                                    <Span>Inbox</Span>
                                                </Anchor>
                                            </SidebarMenuButton>
                                            <SidebarMenuBadge>12</SidebarMenuBadge>
                                        </SidebarMenuItem>
                                    </SidebarMenu>
                                </SidebarGroupContent>
                            </SidebarGroup>

                            <SidebarSeparator />

                            <SidebarGroup>
                                <SidebarGroupLabel>Team</SidebarGroupLabel>
                                <SidebarGroupContent>
                                    <SidebarMenu>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton AsChild="true" Tooltip="Members">
                                                <Anchor Href="/components/avatar">
                                                    <Icon Name="LucideIcon.User" Size="Quark.Size.Is4" />
                                                    <Span>Members</Span>
                                                </Anchor>
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                    </SidebarMenu>
                                </SidebarGroupContent>
                            </SidebarGroup>
                        </SidebarContent>

                        <SidebarFooter>
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Variant="SidebarMenuButtonVariant.Outline" ButtonSize="SidebarMenuButtonSize.Lg" Tooltip="Jake Stevenson">
                                        <Span Class="rounded-lg bg-sidebar-accent text-sidebar-accent-foreground" Display="Display.Flex" Size="Size.Is7" ItemsAlign="Items.Center" Justify="Justify.Center" TextSize="TextSize.Xs" FontWeight="FontWeight.Semibold">JS</Span>
                                        <Div Class="group-data-[collapsible=icon]:hidden" Display="Display.Grid" Flex="Flex.Is1" TextAlign="TextAlign.Left" TextSize="TextSize.Sm" Leading="Leading.Tight">
                                            <Span Class="truncate" FontWeight="FontWeight.Medium">Jake Stevenson</Span>
                                            <Span Class="truncate text-sidebar-foreground/70" TextSize="TextSize.Xs">Product Engineering</Span>
                                        </Div>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarFooter>

                        <SidebarRail ShowTrigger="true" />
                    </Sidebar>

                    <SidebarInset>
                        <Div Display="Display.Flex" Height='Height.Token("14")' ItemsAlign="Items.Center" Gap="Gap.Is3" Border="Border.Is1.FromBottom" BackgroundColor="BackgroundColor.Background" Padding="Padding.Is4.OnX">
                            <Paragraph TextSize="TextSize.Sm" FontWeight="FontWeight.Medium">Icon collapse, nested submenu, and hover action are all active here.</Paragraph>
                        </Div>
                        <Div Padding="Padding.Is6">
                            <Div Class="rounded-xl" Border="Border.Default" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Card" Padding="Padding.Is6" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                                Use one composed shell to exercise the sidebar primitives together instead of scattering them across unrelated demos.
                            </Div>
                        </Div>
                    </SidebarInset>
                </SidebarProvider>
            </Div>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="RTL Support"
                     Description="Sidebar supports right-to-left shells by pairing RTL direction with the right side."
                     Code="@RtlSupportCode"
                     CodeLanguage="razor">
            <DirectionProvider Dir="rtl">
                <Div Width="Width.IsFull" Overflow="Overflow.Hidden" Rounded="Rounded.Xl" Border="Border.Is1" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                    <SidebarProvider DefaultOpen="true" Class="h-[16rem]">
                        <Sidebar Side="SidebarSide.Right" Collapsible="SidebarCollapsible.None">
                            <SidebarHeader>
                                <Paragraph Padding="Padding.Is2.OnX" TextSize="TextSize.Sm" FontWeight="FontWeight.Semibold">مساحة العمل</Paragraph>
                            </SidebarHeader>
                            <SidebarContent>
                                <SidebarGroup>
                                    <SidebarGroupLabel>التنقل</SidebarGroupLabel>
                                    <SidebarGroupContent>
                                        <SidebarMenu>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton Active="true">
                                                    <Icon Name="LucideIcon.House" Size="Quark.Size.Is4" />
                                                    <Span>الرئيسية</Span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton>
                                                    <Icon Name="LucideIcon.Settings" Size="Quark.Size.Is4" />
                                                    <Span>الإعدادات</Span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                        </SidebarMenu>
                                    </SidebarGroupContent>
                                </SidebarGroup>
                            </SidebarContent>
                        </Sidebar>
                        <SidebarInset>
                            <Div Display="Display.Flex" Height='Height.Token("14")' ItemsAlign="Items.Center" Gap="Gap.Is3" Border="Border.Is1.FromBottom" BackgroundColor="BackgroundColor.Background" Padding="Padding.Is4.OnX">
                                <SidebarTrigger />
                                <Paragraph TextSize="TextSize.Sm" FontWeight="FontWeight.Medium">واجهة من اليمين إلى اليسار</Paragraph>
                            </Div>
                        </SidebarInset>
                    </SidebarProvider>
                </Div>
            </DirectionProvider>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Collapsible Group Label"
                     Description="`SidebarGroupLabel AsChild` works with `CollapsibleTrigger` for collapsible group labels."
                     Code="@CollapsibleGroupCode"
                     CodeLanguage="razor">
            <Div Width="Width.IsFull" Overflow="Overflow.Hidden" Rounded="Rounded.Xl" Border="Border.Is1" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                <SidebarProvider DefaultOpen="true" Class="h-[20rem]">
                    <Sidebar Collapsible="SidebarCollapsible.None">
                        <SidebarContent>
                            <Collapsible Open="_resourcesOpen" OpenChanged="OnResourcesOpenChanged" Class="group/collapsible">
                                <SidebarGroup>
                                    <SidebarGroupLabel AsChild="true">
                                        <CollapsibleTrigger>
                                            <Span>Resources</Span>
                                            <Icon Name="LucideIcon.ChevronDown" Class="ml-auto size-4 transition-transform group-data-[state=open]/collapsible:rotate-180" />
                                        </CollapsibleTrigger>
                                    </SidebarGroupLabel>
                                    <CollapsibleContent>
                                        <SidebarGroupContent>
                                            <SidebarMenu>
                                                <SidebarMenuItem>
                                                    <SidebarMenuButton AsChild="true">
                                                        <Anchor Href="card">
                                                            <Icon Name="LucideIcon.File" Size="Quark.Size.Is4" />
                                                            <Span>Component inventory</Span>
                                                        </Anchor>
                                                    </SidebarMenuButton>
                                                </SidebarMenuItem>
                                                <SidebarMenuItem>
                                                    <SidebarMenuButton AsChild="true">
                                                        <Anchor Href="validation-summary">
                                                            <Icon Name="LucideIcon.Shield" Size="Quark.Size.Is4" />
                                                            <Span>Accessibility audit</Span>
                                                        </Anchor>
                                                    </SidebarMenuButton>
                                                </SidebarMenuItem>
                                            </SidebarMenu>
                                        </SidebarGroupContent>
                                    </CollapsibleContent>
                                </SidebarGroup>
                            </Collapsible>
                        </SidebarContent>
                    </Sidebar>
                </SidebarProvider>
            </Div>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Skeleton"
                     Description="`SidebarMenuSkeleton` matches the documented placeholder pattern for loading navigation."
                     Code="@SkeletonCode"
                     CodeLanguage="razor">
            <Div Width="Width.IsFull" Overflow="Overflow.Hidden" Rounded="Rounded.Xl" Border="Border.Is1" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                <SidebarProvider DefaultOpen="true" Class="h-[15rem]">
                    <Sidebar Collapsible="SidebarCollapsible.None">
                        <SidebarContent>
                            <SidebarGroup>
                                <SidebarGroupLabel>Loading</SidebarGroupLabel>
                                <SidebarGroupContent>
                                    <SidebarMenu>
                                        <SidebarMenuItem>
                                            <SidebarMenuSkeleton ShowIcon="true" />
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuSkeleton ShowIcon="true" />
                                        </SidebarMenuItem>
                                        <SidebarMenuItem>
                                            <SidebarMenuSkeleton />
                                        </SidebarMenuItem>
                                    </SidebarMenu>
                                </SidebarGroupContent>
                            </SidebarGroup>
                        </SidebarContent>
                    </Sidebar>
                </SidebarProvider>
            </Div>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Mobile"
                     Description="Mobile sidebars can render as full-screen navigation sheets and close after navigation."
                     Code="@FullScreenMobileCode"
                     CodeLanguage="razor">
            <Div id="sidebar-mobile-demo" Width="Width.IsFull" Space="Space.Y.Is4">
                <SidebarProvider IsMobile="true"
                                 OpenMobile="_mobileSidebarOpen"
                                 OpenMobileChanged="OnMobileSidebarOpenChanged"
                                 SidebarWidthMobile="100vw">
                    <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is3">
                        <SidebarTrigger id="sidebar-mobile-open-trigger" />
                        <Paragraph id="sidebar-mobile-state" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                            Mobile menu is @(_mobileSidebarOpen ? "open" : "closed")
                        </Paragraph>
                    </Div>

                    <Sidebar Collapsible="SidebarCollapsible.None"
                             MobileMode="SidebarMobileMode.FullScreen"
                             MobileShowCloseButton="false"
                             MobileClass="bg-background">
                        <MobileContent>
                            <Div id="sidebar-mobile-sheet-content" Display="Display.Flex" MinHeight="MinHeight.Is0" Flex="Flex.Is1.Col">
                                <Div Class="border-b" BackgroundColor="BackgroundColor.Background" Padding="Padding.OnX.Is6.OnY.Is4">
                                    <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is3">
                                        <SidebarTrigger id="sidebar-mobile-close-trigger" Class="size-8 rounded-md p-0 hover:bg-accent">
                                            <Icon Name="LucideIcon.X" Size="Quark.Size.Is5" />
                                            <Span class="sr-only">Close menu</Span>
                                        </SidebarTrigger>
                                        <Paragraph TextSize="TextSize.Base" FontWeight="FontWeight.Semibold">Menu</Paragraph>
                                    </Div>
                                </Div>
                                <Div Display="Display.Flex" Flex="Flex.Col" Gap="Gap.Is1" Padding="Padding.Is6">
                                    <Anchor Href="" Class="rounded-md" Padding="Padding.OnX.Is3.OnY.Is2" TextSize="TextSize.Sm" BackgroundColor="BackgroundColor.OnHover.Accent">Introduction</Anchor>
                                    <Anchor Href="components" Class="rounded-md" Padding="Padding.OnX.Is3.OnY.Is2" TextSize="TextSize.Sm" BackgroundColor="BackgroundColor.OnHover.Accent">Components</Anchor>
                                    <Anchor Href="validation-summary" Class="rounded-md" Padding="Padding.OnX.Is3.OnY.Is2" TextSize="TextSize.Sm" BackgroundColor="BackgroundColor.OnHover.Accent">Validation</Anchor>
                                </Div>
                            </Div>
                        </MobileContent>
                    </Sidebar>
                </SidebarProvider>
            </Div>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Controlled Sidebar"
                     Description="Use `Open` and `OpenChanged` on `SidebarProvider` when the parent owns the expanded state."
                     Code="@ControlledCode"
                     CodeLanguage="razor">
            <Div id="sidebar-controlled-demo" Width="Width.IsFull" Space="Space.Y.Is4">
                <Div Overflow="Overflow.Hidden" Rounded="Rounded.Xl" Border="Border.Is1" BorderColor="BorderColor.Border" BackgroundColor="BackgroundColor.Background">
                    <SidebarProvider Open="_controlledSidebarOpen" OpenChanged="OnControlledSidebarOpenChanged" Class="h-[20rem]">
                        <Sidebar Collapsible="SidebarCollapsible.None">
                            <SidebarContent>
                                <SidebarGroup>
                                    <SidebarGroupLabel>State</SidebarGroupLabel>
                                    <SidebarGroupContent>
                                        <SidebarMenu>
                                            <SidebarMenuItem>
                                                <SidebarMenuButton Tooltip="Dashboard state">
                                                    <Icon Name="LucideIcon.House" Size="Quark.Size.Is4" />
                                                    <Span>@(_controlledSidebarOpen ? "Expanded" : "Collapsed")</Span>
                                                </SidebarMenuButton>
                                            </SidebarMenuItem>
                                        </SidebarMenu>
                                    </SidebarGroupContent>
                                </SidebarGroup>
                            </SidebarContent>
                            <SidebarRail />
                        </Sidebar>

                        <SidebarInset>
                            <Div Display="Display.Flex" Height='Height.Token("14")' ItemsAlign="Items.Center" Gap="Gap.Is3" Border="Border.Is1.FromBottom" BackgroundColor="BackgroundColor.Background" Padding="Padding.Is4.OnX">
                                <SidebarTrigger id="sidebar-controlled-trigger" Class="relative z-50" />
                                <Paragraph id="sidebar-controlled-state" TextSize="TextSize.Sm" FontWeight="FontWeight.Medium">Current state: @(_controlledSidebarOpen ? "open" : "closed")</Paragraph>
                                <Div Margin="Margin.Auto.FromStart" Display="Display.Flex" Flex="Flex.Wrap" Gap="Gap.Is2">
                                    <Button id="sidebar-controlled-open"
                                            Type="@ButtonType.Button"
                                            ButtonSize="ButtonSize.Sm"
                                            OnClick="OpenControlledSidebar">
                                        Open
                                    </Button>
                                    <Button id="sidebar-controlled-close"
                                            Type="@ButtonType.Button"
                                            Variant="ButtonVariant.Outline"
                                            ButtonSize="ButtonSize.Sm"
                                            OnClick="CloseControlledSidebar">
                                        Close
                                    </Button>
                                </Div>
                            </Div>
                            <Div Padding="Padding.Is6" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                                This example is controlled entirely by the parent page and mirrors the standard `open` plus `onOpenChange` pattern.
                            </Div>
                        </SidebarInset>
                    </SidebarProvider>
                </Div>
            </Div>
        </DemoSection>
    </Section>
</Div>

@code {
    private double? _resizableWidth;
    private const string ResizableSidebarCode = """
        <SidebarProvider>
            <Sidebar Resizable="true" Contained="true" Collapsible="SidebarCollapsible.Icon"
                     MinResizeWidth="192" MaxResizeWidth="400" ResizeStorageKey="quark-demo-sidebar-width" @bind-ExpandedWidth="_resizableWidth">
                <!-- Sidebar content -->
            </Sidebar>
            <SidebarInset />
        </SidebarProvider>

        @code {
            private double? _resizableWidth;
        }
        """;

    private bool _usageSidebarOpen = true;
    private bool _composedSidebarOpen = true;
    private bool _workspaceMenuOpen = true;
    private bool _resourcesOpen = true;
    private bool _controlledSidebarOpen;
    private bool _mobileSidebarOpen;

    private const string SidebarCompositionCode =
        """
        SidebarProvider
        ├── Sidebar
        │   ├── SidebarHeader
        │   ├── SidebarContent
        │   │   └── SidebarGroup
        │   │       ├── SidebarGroupLabel
        │   │       ├── SidebarGroupAction
        │   │       └── SidebarGroupContent
        │   │           └── SidebarMenu
