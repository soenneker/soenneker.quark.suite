@page "/components/tag-input"

<QuarkSeoHead Title="Blazor Tag Input: Values &amp; Autocomplete | Quark Suite" Description="Collect multiple text values in Blazor with Quark TagInput. Explore editable tags, autocomplete suggestions, and a list layout using live demos and Razor code." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Section Space="Space.Y.Is4">
        <DemoSection
            Description="A shadcn-style tag input for collecting multiple short text values."
            Code="@BasicCode"
            PreviewClass="preview relative flex min-h-72 w-full justify-center p-10 data-[align=center]:items-center data-[align=end]:items-end data-[align=start]:items-start data-[chromeless=true]:min-h-0 data-[chromeless=true]:p-0">
            <Field Width="Width.IsFull" MaxWidth="MaxWidth.IsMd">
                <FieldLabel For="tag-input-basic">Topics</FieldLabel>
                <TagInput Id="tag-input-basic"
                          Placeholder="Enter a topic"
                          Values="_basicTags"
                          ValuesChanged="OnBasicTagsChanged"
                          ShowCounter="true"
                          MaxTags="5" />
                <FieldDescription>Add a tag with Enter or comma.</FieldDescription>
            </Field>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Tag colors" Description="Select a typed preset for each tag. Return null to retain the shared variant colors." Code="@TagColorsCode">
            <Field Width="Width.IsFull" MaxWidth="MaxWidth.IsMd">
                <FieldLabel For="tag-input-colors">Topics</FieldLabel>
                <TagInput Id="tag-input-colors" @bind-Values="_coloredTags" TagPresetSelector="SelectTagPreset" />
            </Field>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="Autocomplete"
                     Description="Autocomplete suggestions can be used as hints or as a strict tag source."
                     Code="@AutocompleteCode"
                     PreviewClass="preview relative flex min-h-72 w-full justify-center p-10 data-[align=center]:items-center data-[align=end]:items-end data-[align=start]:items-start data-[chromeless=true]:min-h-0 data-[chromeless=true]:p-0">
            <Field Width="Width.IsFull" MaxWidth="MaxWidth.IsMd">
                <FieldLabel For="tag-input-autocomplete">Interests</FieldLabel>
                <TagInput Id="tag-input-autocomplete"
                          Placeholder="Add interest"
                          Values="_autocompleteTags"
                          ValuesChanged="OnAutocompleteTagsChanged"
                          EnableAutocomplete="true"
                          AutocompleteOptions="_autocompleteOptions"
                          ClearAll="true" />
            </Field>
        </DemoSection>
    </Section>

    <Section Space="Space.Y.Is4">
        <DemoSection Title="List Layout"
                     Description="Render tags outside the field when a stacked layout reads better."
                     Code="@ListCode"
                     PreviewClass="preview relative flex min-h-72 w-full justify-center p-10 data-[align=center]:items-center data-[align=end]:items-end data-[align=start]:items-start data-[chromeless=true]:min-h-0 data-[chromeless=true]:p-0">
            <Field Width="Width.IsFull" MaxWidth="MaxWidth.IsMd">
                <FieldLabel For="tag-input-list">Skills</FieldLabel>
                <TagInput Id="tag-input-list"
                          Placeholder="Add skill"
                          Values="_listTags"
                          ValuesChanged="OnListTagsChanged"
                          InlineTags="false"
                          Direction="TagInputDirection.Column"
                          InputFieldPosition="TagInputFieldPosition.Top"
                          Variant="TagInputVariant.Outline"
                          AddTagsOnBlur="true" />
            </Field>
        </DemoSection>
    </Section>
</Div>

@code {
    private string[] _coloredTags = ["Design", "Photography", "Other"];
    private static readonly QuarkPresetToken DesignTagPreset = new("demo-tag-design", context =>
    {
        context.BackgroundColor = BackgroundColor.Token("violet-100").OnDark.Token("violet-950");
        context.TextColor = TextColor.Token("violet-900").OnDark.Token("violet-100");
    });
    private static readonly QuarkPresetToken PhotographyTagPreset = new("demo-tag-photography", context =>
    {
        context.BackgroundColor = BackgroundColor.Token("amber-100").OnDark.Token("amber-950");
        context.TextColor = TextColor.Token("amber-900").OnDark.Token("amber-100");
    });
    private static QuarkPresetToken? SelectTagPreset(string tag) => tag switch
    {
        "Design" => DesignTagPreset,
        "Photography" => PhotographyTagPreset,
        _ => null
    };

    private const string TagColorsCode = """
        <TagInput @bind-Values="_tags" TagPresetSelector="SelectTagPreset" />

        @code {
            private string[] _tags = ["Design", "Photography", "Other"];
            private static readonly QuarkPresetToken DesignPreset = new("tag-design", context =>
            {
                context.BackgroundColor = BackgroundColor.Token("violet-100").OnDark.Token("violet-950");
                context.TextColor = TextColor.Token("violet-900").OnDark.Token("violet-100");
            });
            private static readonly QuarkPresetToken PhotographyPreset = new("tag-photography", context =>
            {
                context.BackgroundColor = BackgroundColor.Token("amber-100").OnDark.Token("amber-950");
                context.TextColor = TextColor.Token("amber-900").OnDark.Token("amber-100");
            });
            private static QuarkPresetToken? SelectTagPreset(string tag) => tag switch
            {
                "Design" => DesignPreset,
                "Photography" => PhotographyPreset,
                _ => null
            };
        }
        """;

    private string[] _basicTags = ["Sports", "Programming", "Travel"];
    private string[] _autocompleteTags = ["Sports", "Programming", "Travel"];
    private string[] _listTags = ["Blazor", "Accessibility", "Design systems"];

    private readonly string[] _autocompleteOptions =
    [
        "Sports",
        "Programming",
        "Travel",
        "Music",
        "Cooking",
        "Reading",
        "Design",
        "Photography"
    ];

    private Task OnBasicTagsChanged(string[] values)
    {
        _basicTags = values;
        return Task.CompletedTask;
    }

    private Task OnAutocompleteTagsChanged(string[] values)
    {
        _autocompleteTags = values;
        return Task.CompletedTask;
    }

    private Task OnListTagsChanged(string[] values)
    {
        _listTags = values;
        return Task.CompletedTask;
    }

    private const string BasicCode ="""
        <Field Width="Width.IsFull" MaxWidth="MaxWidth.IsMd">
            <FieldLabel For="tag-input-basic">Topics</FieldLabel>
            <TagInput Id="tag-input-basic"
                      Placeholder="Enter a topic"
                      Values="_basicTags"
                      ValuesChanged="OnBasicTagsChanged"
                      ShowCounter="true"
                      MaxTags="5" />
            <FieldDescription>Add a tag with Enter or comma.</FieldDescription>
        </Field>
        """;

    private const string AutocompleteCode ="""
        <Field Width="Width.IsFull" MaxWidth="MaxWidth.IsMd">
            <FieldLabel For="tag-input-autocomplete">Interests</FieldLabel>
            <TagInput Id="tag-input-autocomplete"
                      Placeholder="Add interest"
                      Values="_autocompleteTags"
                      ValuesChanged="OnAutocompleteTagsChanged"
                      EnableAutocomplete="true"
                      AutocompleteOptions="_autocompleteOptions"
                      ClearAll="true" />
        </Field>
        """;

    private const string ListCode ="""
        <Field Width="Width.IsFull" MaxWidth="MaxWidth.IsMd">
            <FieldLabel For="tag-input-list">Skills</FieldLabel>
            <TagInput Id="tag-input-list"
                      Placeholder="Add skill"
                      Values="_listTags"
                      ValuesChanged="OnListTagsChanged"
                      InlineTags="false"
                      Direction="TagInputDirection.Column"
                      InputFieldPosition="TagInputFieldPosition.Top"
                      Variant="TagInputVariant.Outline"
                      AddTagsOnBlur="true" />
        </Field>
        """;
}
