            <div>
                <Anchor Href="/usage">Total tokens ›</Anchor>
                <div class="text-2xl font-semibold">607,262</div>
            </div>
            <Tooltip>
                <TooltipTrigger AsChild="true">
                    <Button Variant="ButtonVariant.Ghost" ButtonSize="ButtonSize.IconSm"
