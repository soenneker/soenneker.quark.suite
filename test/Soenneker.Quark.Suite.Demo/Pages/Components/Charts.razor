    private const string BarCode = """
<Chart Type="ChartType.Bar" Labels="@quarters" Series="@revenue" />
<Chart Type="ChartType.Bar" Labels="@quarters" Series="@revenue"
       Options="@(new ChartOptions { Stacked = true })" />

@code {
    string[] quarters = ["Q1", "Q2", "Q3", "Q4"];
    ChartSeries[] revenue =
