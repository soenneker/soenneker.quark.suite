    private const string MixedCode = """
<Chart Type="ChartType.Bar" Labels="@labels" Series="@mixed">
    <TooltipTemplate Context="point">
        <strong>@point.Label</strong>
        @foreach (var row in point.Rows)
        {
            <span>@row.Series: @row.Value</span>
