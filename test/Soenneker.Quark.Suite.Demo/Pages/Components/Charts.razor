                </TooltipTrigger>
                <TooltipContent>Includes input and cached tokens.</TooltipContent>
            </Tooltip>
        </div>
    </HeaderContent>
    <OverlayContent Context="overlay">
        <a class="pointer-events-auto" style="@overlay.Style(3, 410)" href="/details">Details</a>
    </OverlayContent>
</Chart>

@code {
