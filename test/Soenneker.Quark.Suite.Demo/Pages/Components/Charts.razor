    private const string NeutralCode = """
<Grid Columns="GridCols.Is1.OnXl.Is3" Gap="Gap.Is4">
    <Div Rounded="Rounded.Xl" Border="Border.Is1" BackgroundColor="BackgroundColor.Card"
         Padding="Padding.Is4" Shadow="Shadow.Sm">
