""";

    private const string AreaCode = """
<Chart Type="ChartType.Area" Labels="@labels" XValues="@unixMilliseconds" Series="@series" />

@code {
    string[] labels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    double[] unixMilliseconds = [0, 1, 2, 4, 5, 8, 9];
    ChartSeries[] series =
    [
        new("Responses", new double[] { 18, 32, 27, 46, 61, 57, 74 })
