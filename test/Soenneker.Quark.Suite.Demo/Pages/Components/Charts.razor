        <Chart Type="ChartType.Area" Labels="@labels" Series="@areas" Options="@areaOptions" />
    </Div>
</Grid>

@code {
    const string strong = "color-mix(in oklab, var(--foreground) 88%, var(--background))";
    const string medium = "color-mix(in oklab, var(--foreground) 62%, var(--background))";
    const string soft = "color-mix(in oklab, var(--foreground) 36%, var(--background))";
    string[] labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];

    ChartSeries[] bars =
    [
        new("Desktop", new double[] { 186, 305, 237, 273, 209, 214 }) { Color = strong },
        new("Mobile", new double[] { 80, 200, 120, 190, 130, 140 }) { Color = soft }
    ];

    ChartSeries[] lines =
    [
        new("Returning", new double[] { 142, 168, 155, 201, 224, 248 }) { Color = strong },
        new("New", new double[] { 92, 118, 109, 146, 162, 181 }) { Color = medium }
    ];

    ChartSeries[] areas =
    [
        new("Recurring", new double[] { 42, 48, 46, 57, 63, 71 })
        {
            Color = strong,
            Gradient = new(strong, strong) { StartOpacity = .45, EndOpacity = .03 }
        },
        new("Services", new double[] { 24, 31, 28, 36, 34, 41 })
        {
            Color = medium,
            Gradient = new(medium, medium) { StartOpacity = .3, EndOpacity = .02 }
        }
    ];

    ChartOptions barOptions = new() { Height = 230, ShowPoints = false };
    ChartOptions lineOptions = new() { Height = 230, ShowPoints = false, Curve = ChartCurve.Monotone };
    ChartOptions areaOptions = new() { Height = 230, ShowPoints = false, Curve = ChartCurve.Monotone, Unit = "k" };
}
""";
}
