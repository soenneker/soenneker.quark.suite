@page "/components/chart-card"

<QuarkSeoHead Title="Blazor Chart Card Examples | Quark Suite" Description="Wrap chart content with consistent headers and loading, error, and empty states." />

<Grid Columns="GridCols.Is1" Gap="Gap.Is6" MinWidth="MinWidth.Is0" Width="Width.IsFull">
    <DemoSection Title="Content and metric" Description="The content slot accepts your chart or other visualization." Code="@Example0" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <ChartCard Title="Completed tasks" Subtitle="This week" MetricValue="24">
            <ChildContent><Paragraph>24 of 30 planned tasks are complete.</Paragraph></ChildContent>
        </ChartCard>
    </DemoSection>
    <DemoSection Title="Loading" Description="Customize the loading slot." Code="@Example1" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <ChartCard Title="Activity" IsLoading="true"><LoadingContent><Paragraph>Loading activity…</Paragraph></LoadingContent></ChartCard>
    </DemoSection>
    <DemoSection Title="Empty results" Description="Use an explicit empty state when there is no data." Code="@Example2" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <ChartCard Title="Activity" IsEmpty="true" EmptyTitle="No activity yet" EmptyMessage="Activity will appear after the first event." />
    </DemoSection>
    <DemoSection Title="Error" Description="Errors take precedence over the empty state." Code="@Example3" CodeLanguage="razor" PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 grid-cols-1">
        <ChartCard Title="Activity" ErrorMessage="Activity could not be loaded." IsEmpty="true" />
    </DemoSection>
</Grid>

@code {

    private const string Example0 = """
        <ChartCard Title="Completed tasks" Subtitle="This week" MetricValue="24">
            <ChildContent><Paragraph>24 of 30 planned tasks are complete.</Paragraph></ChildContent>
        </ChartCard>
        """;
    private const string Example1 = """
        <ChartCard Title="Activity" IsLoading="true"><LoadingContent><Paragraph>Loading activity…</Paragraph></LoadingContent></ChartCard>
        """;
    private const string Example2 = """
        <ChartCard Title="Activity" IsEmpty="true" EmptyTitle="No activity yet" EmptyMessage="Activity will appear after the first event." />
        """;
    private const string Example3 = """
        <ChartCard Title="Activity" ErrorMessage="Activity could not be loaded." IsEmpty="true" />
        """;
}
