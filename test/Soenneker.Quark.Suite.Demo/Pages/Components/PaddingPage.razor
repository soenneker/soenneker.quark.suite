@page "/components/padding"

<QuarkSeoHead Title="Padding Utilities &amp; Responsive Spacing | Quark Suite" Description="Control inner spacing in Blazor with Quark Padding builders. Explore directional and axis padding, chained rules, responsive values, and custom styling." />

<H1>Padding</H1>

<Paragraph>This page demonstrates the padding functionality in Quark.Divs.</Paragraph>

<H2>Basic Padding</H2>

<Div Class="demo-section">
    <H3>Size 0 Padding (No Padding)</H3>
    <Div Padding="Padding.Is0" Border="Border.Default" BorderColor="BorderColor.Primary">
        No padding content
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Size 1 Padding</H3>
    <Div Padding="Padding.Is1" Border="Border.Default" BorderColor="BorderColor.Primary">
        Small padding content
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Size 2 Padding</H3>
    <Div Padding="Padding.Is2" Border="Border.Default" BorderColor="BorderColor.Primary">
        Medium padding content
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Size 3 Padding</H3>
    <Div Padding="Padding.Is3" Border="Border.Default" BorderColor="BorderColor.Primary">
        Large padding content
    </Div>
</Div>

<CodeEditor ReadOnly="true"
            Language="@("html")"
            AutoHeight="true" Margin="Margin.Is3.FromTop.Is3.FromBottom"
            Text="@(@"<Div Padding=""@Padding.Is0"">No padding</Div>
<Div Padding=""@Padding.Is1"">Small padding</Div>
<Div Padding=""@Padding.Is3"">Medium padding</Div>
<Div Padding=""@Padding.Is2.FromTop"">Top padding</Div>
<Div Padding=""@Padding.Is3.OnX.Is1.OnY"">Horizontal and vertical padding</Div>")" />

<H2>Directional Padding</H2>

<Div Class="demo-section">
    <H3>Top Padding</H3>
    <Div Padding="Padding.Is2.FromTop" Border="Border.Default" BorderColor="BorderColor.Primary">
        Top padding only
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Right Padding</H3>
    <Div Padding="Padding.Is2.FromRight" Border="Border.Default" BorderColor="BorderColor.Primary">
        Right padding only
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Horizontal Padding (X-axis)</H3>
    <Div Padding="Padding.Is3.OnX" Border="Border.Default" BorderColor="BorderColor.Primary">
        Horizontal padding
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Vertical Padding (Y-axis)</H3>
    <Div Padding="Padding.Is3.OnY" Border="Border.Default" BorderColor="BorderColor.Primary">
        Vertical padding
    </Div>
</Div>

<H2>Chained Padding</H2>

<Div Class="demo-section">
    <H3>Multiple Padding Rules</H3>
    <Div Padding="Padding.Is1.FromTop.Is2.FromRight" Border="Border.Default" BorderColor="BorderColor.Primary">
        Different padding on top and right
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Complex Padding</H3>
    <Div Padding="Padding.Is2.OnY.Is1.FromLeft.Is3.FromRight" Border="Border.Default" BorderColor="BorderColor.Primary">
        Complex padding combination
    </Div>
</Div>

<H2>Responsive Padding</H2>

<Div Class="demo-section">
    <H3>Responsive Padding</H3>
    <Div Padding="Padding.Is1.OnMd.Is2.OnXl.Is3" Border="Border.Default" BorderColor="BorderColor.Primary">
        Responsive padding: Is1 on mobile, Is2 on tablet, Is3 on desktop
    </Div>
</Div>

<H2>Custom Padding</H2>

<Div Class="demo-section">
    <H3>Custom CSS Class</H3>
    <Div Padding="@("custom-padding")" Border="Border.Default" BorderColor="BorderColor.Primary">
        Custom padding class
    </Div>
</Div>

<Div Class="demo-section">
    <H3>Custom CSS Style</H3>
    <Div Padding="@("padding: 20px 30px;")" Border="Border.Default" BorderColor="BorderColor.Primary">
        Custom padding style
    </Div>
</Div>

<style>
    .demo-section {
        margin-bottom: 2rem;
    }

    .demo-section h3 {
        margin-bottom: 0.5rem;
        color: #6c757d;
    }
</style>
