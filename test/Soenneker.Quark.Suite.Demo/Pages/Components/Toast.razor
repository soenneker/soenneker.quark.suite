@page "/components/toast"

<QuarkSeoHead Title="Toast Migration: Switch to Sonner | Quark Suite" Description="Quark&#x27;s legacy Toast component is deprecated. Find the replacement Sonner component for toast notifications in Blazor and follow the link to its examples." />

<Div Space="Space.Y.Is8" MaxWidth="MaxWidth.Is4xl">
    <Section Space="Space.Y.Is4">
        <Paragraph TextColor="TextColor.MutedForeground" Margin="Margin.Is0">
            A succinct message that is displayed temporarily.
        </Paragraph>

        <Paragraph Margin="Margin.Is0">
            The toast component has been deprecated. Use the <Anchor Href="sonner" Class="underline underline-offset-4" FontWeight="FontWeight.Medium">sonner</Anchor> component instead.
        </Paragraph>
    </Section>
</Div>
