@page "/components/query-input"

<QuarkSeoHead Title="Blazor Query Input | Quark Suite" Description="Build search queries with field and value suggestions, quoted values, and exclusions." />

<Div Space="Space.Y.Is8">
<DemoSection Title="Search issues" Description="Type a field name to see suggestions. Use Enter to select, quotes for multi-word values, and a minus sign to exclude a match."
             Code="@Example" CodeLanguage="razor"
             PreviewInnerClass="demo-section-preview-inner grid w-full min-w-0 gap-4">
    <QueryInput AllowOr="true" Fields="_fields" @bind-Value="_query" ParsedChanged="OnParsed" />
    <Div Class="rounded-lg border bg-muted/20 p-4" aria-live="polite">
        <Div Class="mb-2 text-sm font-medium">Search criteria</Div>
        <Div Class="flex flex-wrap gap-2">
            @if (!string.IsNullOrWhiteSpace(_parsed.Text)) { <Badge>@_parsed.Text</Badge> }
            @foreach (var filter in _parsed.Filters)
            {
                <Badge>@(filter.Excluded ? "Exclude" : "Include") @filter.Field · @filter.Value</Badge>
            }
            @if (_parsed.Filters.Count == 0 && string.IsNullOrWhiteSpace(_parsed.Text))
            {
                <Paragraph Class="text-sm text-muted-foreground">Enter text or choose a field to narrow the search.</Paragraph>
            }
        </Div>
        @foreach (var error in _parsed.Errors)
        {
            <Paragraph Class="text-sm text-destructive">@error</Paragraph>
        }
    </Div>
</DemoSection>
</Div>

@code {
    private string _query = "state:open OR state:closed AND -assignee:me";
    private QueryInputResult _parsed = QueryInputParser.Parse("state:open OR state:closed AND -assignee:me");
    private readonly IReadOnlyList<QueryInputField> _fields =
    [
        new("state", "State", [new("open", "Open"), new("closed", "Closed")]),
        new("assignee", "Assignee", [new("me", "Me"), new("soenneker", "Jake Soenneker")]),
        new("label", "Label", [new("bug", "Bug"), new("needs review", "Needs review")]),
        new("no", "Missing", [new("assignee", "No assignee"), new("project", "No project")])
    ];
    private void OnParsed(QueryInputResult value) => _parsed = value;
    private const string Example = """
<QueryInput AllowOr="true" Fields="_fields" @bind-Value="_query" ParsedChanged="OnParsed" />
<Div Class="rounded-lg border bg-muted/20 p-4" aria-live="polite">
    <Div Class="mb-2 text-sm font-medium">Search criteria</Div>
    <Div Class="flex flex-wrap gap-2">
        @if (!string.IsNullOrWhiteSpace(_parsed.Text)) { <Badge>@_parsed.Text</Badge> }
        @foreach (var filter in _parsed.Filters)
        {
            <Badge>@(filter.Excluded ? "Exclude" : "Include") @filter.Field · @filter.Value</Badge>
        }
        @if (_parsed.Filters.Count == 0 && string.IsNullOrWhiteSpace(_parsed.Text))
        {
            <Paragraph Class="text-sm text-muted-foreground">Enter text or choose a field to narrow the search.</Paragraph>
        }
    </Div>
    @foreach (var error in _parsed.Errors)
    {
        <Paragraph Class="text-sm text-destructive">@error</Paragraph>
    }
</Div>

@code {
