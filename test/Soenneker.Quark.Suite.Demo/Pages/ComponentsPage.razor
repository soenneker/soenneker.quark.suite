@page "/components"
@using System.Linq

<QuarkSeoHead Title="Blazor UI Components: Live Demos &amp; Examples | Quark Suite" Description="Explore Quark Suite Blazor components with live demos and Razor examples for forms, tables, dialogs, navigation, charts, layouts, and AI chat interfaces."/>

<Div data-slot="docs" Display="Display.Flex" ItemsAlign="Items.Stretch" ScrollMargin="ScrollMargin.Is24.FromTop" Width="Width.IsFull" Padding="Padding.FromBottom.Is8" TextSize='TextSize.Token("[1.05rem]").OnSm.Token("[15px]")'>
    <Div Display="Display.Flex" Flex="Flex.Is1" FlexDirection="FlexDirection.Col" MinWidth="MinWidth.Is0">
        <Div Height='Height.Token("(--top-spacing)")' Shrink="Shrink.Is0"></Div>

        <Div Margin="Margin.OnX.Auto" Width="Width.IsFull" MinWidth="MinWidth.Is0" MaxWidth="MaxWidth.IsNone" Display="Display.Flex" Flex="Flex.Is1" FlexDirection="FlexDirection.Col" Gap="Gap.Is6" Padding="Padding.OnX.Is0.OnY.Is6.OnLg.OnY.Is8" TextColor='TextColor.Token("neutral-800").OnDark.Token("neutral-300")' Class="sm:max-w-[40rem]">
            <Div Display="Display.Flex" FlexDirection="FlexDirection.Col" Gap="Gap.Is2">
                <H1 Margin="Margin.Is0" ScrollMargin="ScrollMargin.Is24.FromTop" TextSize="TextSize.ThreeXl" FontWeight="FontWeight.Semibold" Tracking="Tracking.Tight" TextAlign="TextAlign.Start">Components</H1>

                <Paragraph Margin="Margin.Is0" TextColor="TextColor.MutedForeground" TextSize="TextSize.Base">
                    Live Blazor components with ready-to-copy Razor examples.
                </Paragraph>

                <Div Display="Display.Flex" FlexWrap="FlexWrap.Wrap" ItemsAlign="Items.Center" Class="gap-x-4 gap-y-2" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                    <Anchor Href="installation" Class="underline-offset-4" DecorationLine="DecorationLine.Underline">Installation</Anchor>
                    <Anchor Href="first-component" Class="underline-offset-4" DecorationLine="DecorationLine.Underline">First component</Anchor>
                    <Anchor Href="generators" Class="underline-offset-4" DecorationLine="DecorationLine.Underline">Generators</Anchor>
                    <Anchor Href="troubleshooting" Class="underline-offset-4" DecorationLine="DecorationLine.Underline">Troubleshooting</Anchor>
                </Div>
            </Div>

            <Div Width="Width.IsFull" Flex="Flex.Is1" Padding="Padding.FromBottom.Is16.OnSm.FromBottom.Is0" class="*:data-[slot=alert]:first:mt-0">

                <Grid Columns="GridCols.Is2.OnMd.Is3" Gap='Gap.Is4.OnMd.Column.Token("8").OnLg.Column.Token("16").OnLg.Row.Token("6").OnXl.Column.Token("20")'>
                    @foreach (var item in DocsNavigation.ComponentLinks.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase))
                    {
                        @if (item.Href is not null)
                        {
                            <Anchor Href="@item.Href" Display="Display.InlineFlex" Gap="Gap.Is2" TextSize="TextSize.Lg.OnMd.Base" FontWeight="FontWeight.Medium" DecorationLine="DecorationLine.OnHover.Underline" ItemsAlign="Items.Center">
                                @item.Title
                                @if (item.IsNew)
                                {
                                    <Span Size="Size.Is2" Rounded="Rounded.Full" BackgroundColor='BackgroundColor.Token("blue-500")'></Span>
                                }
                            </Anchor>
                        }
                        else
                        {
                            <Span Display="Display.InlineFlex" Gap="Gap.Is2" TextSize="TextSize.Lg.OnMd.Base" FontWeight="FontWeight.Medium" TextColor="TextColor.MutedForeground" ItemsAlign="Items.Center">
                                @item.Title
                                @if (item.IsNew)
                                {
                                    <Span Size="Size.Is2" Rounded="Rounded.Full" BackgroundColor='BackgroundColor.Token("blue-500")'></Span>
                                }
                            </Span>
                        }
                    }
                </Grid>

                <H2 TextSize="TextSize.Xl" FontWeight="FontWeight.Semibold" Class="md:mt-16" Margin="Margin.FromTop.Is8.FromBottom.Is4">
                    Compositions
                </H2>

                <Grid Columns="GridCols.Is2.OnMd.Is3" Gap='Gap.Is4.OnMd.Column.Token("8").OnLg.Column.Token("16").OnLg.Row.Token("6")'>
                    @foreach (var item in DocsNavigation.CompositionLinks)
                    {
                        @if (item.Href is not null)
                        {
                            <Anchor Href="@item.Href" Display="Display.InlineFlex" Gap="Gap.Is2" TextSize="TextSize.Lg.OnMd.Base" FontWeight="FontWeight.Medium" DecorationLine="DecorationLine.OnHover.Underline" ItemsAlign="Items.Center">
                                @item.Title
                                @if (item.IsNew)
                                {
                                    <Span Size="Size.Is2" Rounded="Rounded.Full" BackgroundColor='BackgroundColor.Token("blue-500")'></Span>
                                }
                            </Anchor>
                        }
                        else
                        {
                            <Span Display="Display.InlineFlex" Gap="Gap.Is2" TextSize="TextSize.Lg.OnMd.Base" FontWeight="FontWeight.Medium" TextColor="TextColor.MutedForeground" ItemsAlign="Items.Center">
                                @item.Title
                                @if (item.IsNew)
                                {
                                    <Span Size="Size.Is2" Rounded="Rounded.Full" BackgroundColor='BackgroundColor.Token("blue-500")'></Span>
                                }
                            </Span>
                        }
                    }
                </Grid>

                <H2 TextSize="TextSize.Xl" FontWeight="FontWeight.Semibold" Class="md:mt-16" Margin="Margin.FromTop.Is8.FromBottom.Is4">
                    Primitives
                </H2>

                <Grid Columns="GridCols.Is2.OnMd.Is3" Gap='Gap.Is4.OnMd.Column.Token("8").OnLg.Column.Token("16").OnLg.Row.Token("6")'>
                    @foreach (var item in DocsNavigation.PrimitiveLinks)
                    {
                        @if (item.Href is not null)
                        {
                            <Anchor Href="@item.Href" Display="Display.InlineFlex" Gap="Gap.Is2" TextSize="TextSize.Lg.OnMd.Base" FontWeight="FontWeight.Medium" DecorationLine="DecorationLine.OnHover.Underline" ItemsAlign="Items.Center">
                                @item.Title
                                @if (item.IsNew)
                                {
                                    <Span Size="Size.Is2" Rounded="Rounded.Full" BackgroundColor='BackgroundColor.Token("blue-500")'></Span>
                                }
                            </Anchor>
                        }
                        else
                        {
                            <Span Display="Display.InlineFlex" Gap="Gap.Is2" TextSize="TextSize.Lg.OnMd.Base" FontWeight="FontWeight.Medium" TextColor="TextColor.MutedForeground" ItemsAlign="Items.Center">
                                @item.Title
                                @if (item.IsNew)
                                {
                                    <Span Size="Size.Is2" Rounded="Rounded.Full" BackgroundColor='BackgroundColor.Token("blue-500")'></Span>
                                }
                            </Span>
                        }
                    }
                </Grid>

                <Hr Margin="Margin.OnY.Is4.OnMd.OnY.Is8"/>

            </Div>

            <Div Display="Display.None.OnSm.Flex" Height="Height.Is16" Width="Width.IsFull" ItemsAlign="Items.Center" Gap="Gap.Is2" Padding="Padding.OnX.Is4.OnSm.OnX.Is0">
                <Anchor Href="components/accordion" Display="Display.InlineFlex" Height="Height.Is8" Gap='Gap.Token("1.5")' Padding="Padding.OnX.Is3" TextSize="TextSize.Sm" FontWeight="FontWeight.Medium" TextColor="TextColor.SecondaryForeground" BackgroundColor='BackgroundColor.Secondary.OnHover.Token("secondary/80")' Rounded="Rounded.Md" Shadow="Shadow.None" Transition="Transition.All" Margin="Margin.FromLeft.Auto" ItemsAlign="Items.Center" Justify="Justify.Center">
                    Accordion
                    <Icon Name="LucideIcon.ArrowRight" Size="Size.Is4" aria-hidden="true"/>
                </Anchor>
            </Div>
        </Div>
    </Div>
</Div>
